<Item class="ModuleScript" referent="RBX0000001D"><Properties><string name="Name">MeshKit</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Fits sculpted meshes (from tools/build_assets.py) onto a live skeleton.
--
-- Each segment mesh was sculpted around canonical joints (MeshMeta: top / bottom anchors).
-- At runtime we read the real joint positions from the rig's Motor6Ds, scale the segment
-- uniformly so its anchor-to-anchor length matches, and weld it so its top anchor sits
-- exactly on the real joint. Proportions stay realistic whatever the skeleton's sizes are.
local MeshKit = {}

local CHILD = {
	r15 = {
		LowerTorso = "UpperTorso", UpperTorso = "Head",
		RightUpperArm = "RightLowerArm", RightLowerArm = "RightHand",
		LeftUpperArm = "LeftLowerArm", LeftLowerArm = "LeftHand",
		RightUpperLeg = "RightLowerLeg", RightLowerLeg = "RightFoot",
		LeftUpperLeg = "LeftLowerLeg", LeftLowerLeg = "LeftFoot",
	},
	enemy = {
		Torso = "Head",
		RightUpperArm = "RightLowerArm", LeftUpperArm = "LeftLowerArm",
		RightUpperLeg = "RightLowerLeg", LeftUpperLeg = "LeftLowerLeg",
	},
}

-- Segments without their own child joint borrow the scale of this segment.
local SCALE_FROM = {
	r15 = { Head = "UpperTorso", RightHand = "RightLowerArm", LeftHand = "LeftLowerArm", RightFoot = "RightLowerLeg", LeftFoot = "LeftLowerLeg" },
	enemy = { Head = "Torso", Pelvis = "Torso" },
}

-- Order matters: scale donors first.
local ORDER = {
	r15 = { "UpperTorso", "LowerTorso", "Head", "RightUpperArm", "LeftUpperArm", "RightLowerArm", "LeftLowerArm", "RightHand", "LeftHand", "RightUpperLeg", "LeftUpperLeg", "RightLowerLeg", "LeftLowerLeg", "RightFoot", "LeftFoot" },
	enemy = { "Torso", "Pelvis", "Head", "RightUpperArm", "LeftUpperArm", "RightLowerArm", "LeftLowerArm", "RightUpperLeg", "LeftUpperLeg", "RightLowerLeg", "LeftLowerLeg" },
}

local function material(name)
	local ok, m = pcall(function()
		return Enum.Material[name]
	end)
	return ok and m or Enum.Material.SmoothPlastic
end

-- How to orient and size an imported piece: the importer correction solved by AssetService
-- (FitRot / FitScale attributes) when present, otherwise our own size and the YawFix turn.
local function fit(mp, layerSize, scale, fallbackRot, sourceName)
	mp:SetAttribute("SourceName", sourceName)
	local rot = mp:GetAttribute("FitRot")
	local k = mp:GetAttribute("FitScale")
	if typeof(rot) == "CFrame" and type(k) == "number" then
		mp.Size = mp.Size * (k * scale)
		return rot
	end
	mp.Size = layerSize * scale
	return fallbackRot
end

local function v3(t)
	return Vector3.new(t[1], t[2], t[3])
end

local function jointsOf(model)
	local own, byParent = {}, {}
	for _, m in model:GetDescendants() do
		if m:IsA("Motor6D") and m.Part0 and m.Part1 then
			own[m.Part1] = m
			byParent[m.Part0] = byParent[m.Part0] or {}
			byParent[m.Part0][m.Part1.Name] = m
		end
	end
	return own, byParent
end

-- Canonical joint positions (sculpt space) from the kit's segment anchors.
local function canonicalJoints(meta, format)
	local seg = meta.segments
	local function top(name)
		return seg[name] and seg[name].top and v3(seg[name].top)
	end
	local function bottom(name)
		return seg[name] and seg[name].bottom and v3(seg[name].bottom)
	end
	local J = {}
	if format == "r15" then
		J.root, J.waist, J.neck = top("LowerTorso"), top("UpperTorso"), bottom("UpperTorso")
		for _, side in { "Left", "Right" } do
			J[side .. "Shoulder"] = top(side .. "UpperArm")
			J[side .. "Elbow"] = top(side .. "LowerArm")
			J[side .. "Wrist"] = top(side .. "Hand")
			J[side .. "Hip"] = top(side .. "UpperLeg")
			J[side .. "Knee"] = top(side .. "LowerLeg")
			J[side .. "Ankle"] = top(side .. "Foot")
		end
	else
		J.root, J.waist, J.neck = top("Pelvis"), top("Torso"), bottom("Torso")
		for _, side in { "Left", "Right" } do
			J[side .. "Shoulder"] = top(side .. "UpperArm")
			J[side .. "Elbow"] = top(side .. "LowerArm")
			J[side .. "HandEnd"] = bottom(side .. "LowerArm")
			J[side .. "Hip"] = top(side .. "UpperLeg")
			J[side .. "Knee"] = top(side .. "LowerLeg")
			J[side .. "Ground"] = bottom(side .. "LowerLeg")
		end
	end
	for _, v in J do
		if not v then
			return nil
		end
	end
	return J
end

-- Roblox now builds R15 characters with AnimationConstraint joints (+ BallSocketConstraints)
-- instead of Motor6D. Everything here (skeleton fit, procedural animation, ragdolls) works on
-- Motor6D, so convert: same parts, same frames (C0/C1 = the constraint's attachment frames).
-- Server-side; the new joints replicate. Returns how many joints were converted.
function MeshKit.ensureMotors(model)
	local converted = 0
	for _, d in model:GetDescendants() do
		if d:IsA("AnimationConstraint") and d.Attachment0 and d.Attachment1 then
			local a0, a1 = d.Attachment0, d.Attachment1
			local part0, part1 = a0.Parent, a1.Parent
			if part0 and part1 and part0:IsA("BasePart") and part1:IsA("BasePart") then
				local motor = Instance.new("Motor6D")
				motor.Name = d.Name
				motor.Part0 = part0
				motor.Part1 = part1
				motor.C0 = a0.CFrame
				motor.C1 = a1.CFrame
				motor.Parent = d.Parent
				converted += 1
			end
			d:Destroy()
		end
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BallSocketConstraint") and d.Name:match("BallSocket$") then
			d:Destroy() -- the upgraded rig's ragdoll sockets; we ragdoll our own way
		end
	end
	return converted
end

local function setJoint(model, partName, motorName, parentCenter, childCenter, joint)
	local part = model:FindFirstChild(partName)
	local motor
	for _, d in model:GetDescendants() do
		if d:IsA("Motor6D") and d.Name == motorName and d.Part1 == part then
			motor = d
			break
		end
	end
	if not motor then
		return
	end
	motor.C0 = CFrame.new(joint - parentCenter)
	motor.C1 = CFrame.new(joint - childCenter)
	-- keep R15 rig attachments in step (Roblox uses them for accessories and rebuilds)
	local att0 = motor.Part0 and motor.Part0:FindFirstChild(motorName .. "RigAttachment")
	local att1 = part and part:FindFirstChild(motorName .. "RigAttachment")
	if att0 then
		att0.CFrame = motor.C0
	end
	if att1 then
		att1.CFrame = motor.C1
	end
end

-- Rebuilds a character's skeleton to the sculpt's own proportions (uniformly scaled by `s`),
-- so every mesh segment fits its bone exactly: no gaps, no stretched pieces.
-- Returns the HipHeight the Humanoid needs, or nil if the kit has no usable anchors.
function MeshKit.conformSkeleton(model, meta, format, s)
	MeshKit.ensureMotors(model)
	local J0 = canonicalJoints(meta, format)
	if not J0 then
		return nil
	end
	local J = {}
	for k, v in J0 do
		J[k] = v * s
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		pcall(function()
			humanoid.AutomaticScalingEnabled = false
		end)
	end
	local root = model:FindFirstChild("HumanoidRootPart")
	local C = {} -- part centres in rig space (root joint at the origin's height)
	local function size(name, v)
		local p = model:FindFirstChild(name)
		if p then
			p.Size = v
		end
	end
	C.HumanoidRootPart = J.root
	if format == "r15" then
		C.LowerTorso = (J.root + J.waist) / 2
		C.UpperTorso = (J.waist + J.neck) / 2
		C.Head = J.neck + Vector3.new(0, 0.55 * s, 0)
		size("LowerTorso", Vector3.new(1.1 * s, (J.waist - J.root).Magnitude + 0.2 * s, 0.7 * s))
		size("UpperTorso", Vector3.new(1.3 * s, (J.neck - J.waist).Magnitude, 0.75 * s))
		size("Head", Vector3.new(0.85 * s, 1.05 * s, 0.95 * s))
		setJoint(model, "LowerTorso", "Root", C.HumanoidRootPart, C.LowerTorso, J.root)
		setJoint(model, "UpperTorso", "Waist", C.LowerTorso, C.UpperTorso, J.waist)
		setJoint(model, "Head", "Neck", C.UpperTorso, C.Head, J.neck)
		for _, side in { "Left", "Right" } do
			local sh, el, wr = J[side .. "Shoulder"], J[side .. "Elbow"], J[side .. "Wrist"]
			local hip, kn, an = J[side .. "Hip"], J[side .. "Knee"], J[side .. "Ankle"]
			C[side .. "UpperArm"] = (sh + el) / 2
			C[side .. "LowerArm"] = (el + wr) / 2
			C[side .. "Hand"] = wr - Vector3.new(0, 0.22 * s, 0)
			C[side .. "UpperLeg"] = (hip + kn) / 2
			C[side .. "LowerLeg"] = (kn + an) / 2
			C[side .. "Foot"] = an - Vector3.new(0, 0.18 * s, 0.2 * s)
			size(side .. "UpperArm", Vector3.new(0.34 * s, (el - sh).Magnitude, 0.34 * s))
			size(side .. "LowerArm", Vector3.new(0.28 * s, (wr - el).Magnitude, 0.28 * s))
			size(side .. "Hand", Vector3.new(0.2 * s, 0.44 * s, 0.3 * s))
			size(side .. "UpperLeg", Vector3.new(0.45 * s, (kn - hip).Magnitude, 0.45 * s))
			size(side .. "LowerLeg", Vector3.new(0.34 * s, (an - kn).Magnitude, 0.34 * s))
			size(side .. "Foot", Vector3.new(0.32 * s, 0.36 * s, 0.8 * s))
			setJoint(model, side .. "UpperArm", side .. "Shoulder", C.UpperTorso, C[side .. "UpperArm"], sh)
			setJoint(model, side .. "LowerArm", side .. "Elbow", C[side .. "UpperArm"], C[side .. "LowerArm"], el)
			setJoint(model, side .. "Hand", side .. "Wrist", C[side .. "LowerArm"], C[side .. "Hand"], wr)
			setJoint(model, side .. "UpperLeg", side .. "Hip", C.LowerTorso, C[side .. "UpperLeg"], hip)
			setJoint(model, side .. "LowerLeg", side .. "Knee", C[side .. "UpperLeg"], C[side .. "LowerLeg"], kn)
			setJoint(model, side .. "Foot", side .. "Ankle", C[side .. "LowerLeg"], C[side .. "Foot"], an)
		end
	else
		C.Torso = (J.waist + J.neck) / 2
		C.Head = J.neck + Vector3.new(0, 0.55 * s, 0)
		size("Torso", Vector3.new(1.2 * s, (J.neck - J.waist).Magnitude, 0.7 * s))
		size("Head", Vector3.new(0.85 * s, 1.05 * s, 0.95 * s))
		setJoint(model, "Torso", "Waist", C.HumanoidRootPart, C.Torso, J.waist)
		setJoint(model, "Head", "Neck", C.Torso, C.Head, J.neck)
		for _, side in { "Left", "Right" } do
			local sh, el, he = J[side .. "Shoulder"], J[side .. "Elbow"], J[side .. "HandEnd"]
			local hip, kn, gr = J[side .. "Hip"], J[side .. "Knee"], J[side .. "Ground"]
			C[side .. "UpperArm"] = (sh + el) / 2
			C[side .. "LowerArm"] = (el + he) / 2
			C[side .. "UpperLeg"] = (hip + kn) / 2
			C[side .. "LowerLeg"] = (kn + gr) / 2
			size(side .. "UpperArm", Vector3.new(0.34 * s, (el - sh).Magnitude, 0.34 * s))
			size(side .. "LowerArm", Vector3.new(0.3 * s, (he - el).Magnitude, 0.3 * s))
			size(side .. "UpperLeg", Vector3.new(0.45 * s, (kn - hip).Magnitude, 0.45 * s))
			size(side .. "LowerLeg", Vector3.new(0.36 * s, (gr - kn).Magnitude, 0.36 * s))
			setJoint(model, side .. "UpperArm", side .. "Shoulder", C.Torso, C[side .. "UpperArm"], sh)
			setJoint(model, side .. "LowerArm", side .. "Elbow", C[side .. "UpperArm"], C[side .. "LowerArm"], el)
			setJoint(model, side .. "UpperLeg", side .. "Hip", C.HumanoidRootPart, C[side .. "UpperLeg"], hip)
			setJoint(model, side .. "LowerLeg", side .. "Knee", C[side .. "UpperLeg"], C[side .. "LowerLeg"], kn)
		end
	end
	-- the rest of the body follows the root: place every bone around it
	if root then
		local rootCF = root.CFrame
		for name, centre in C do
			local part = model:FindFirstChild(name)
			if part and part ~= root then
				part.CFrame = rootCF * CFrame.new(centre - C.HumanoidRootPart)
			end
		end
		return J.root.Y - root.Size.Y / 2
	end
	return nil
end

-- getPart(name) -> MeshPart clone or nil. Returns true if every segment was fitted.
-- colorOverrides (optional): { [layerName] = Color3 } for outfits.
function MeshKit.applyRig(model, meta, getPart, format, yawFix, colorOverrides)
	local own, byParent = jointsOf(model)
	local scales = {}
	local fitted = {}
	local yaw = yawFix and CFrame.Angles(0, math.rad(yawFix), 0) or MeshKit.yaw
	for _, segName in ORDER[format] do
		local seg = meta.segments[segName]
		local bone = segName == "Pelvis" and model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild(segName)
		if seg and bone then
			-- actual anchor positions in the bone's local space
			local ownJoint = own[bone]
			local A = ownJoint and ownJoint.C1.Position or Vector3.zero
			local B
			local childName = CHILD[format][segName]
			local childJoint = childName and byParent[bone] and byParent[bone][childName]
			if childJoint then
				B = childJoint.C0.Position
			elseif seg.bottom and ownJoint then
				B = Vector3.new(A.X, A.Y - bone.Size.Y, A.Z) -- limb ends at the bottom of the part
			end
			local s
			if B and seg.top and seg.bottom then
				local canon = (v3(seg.bottom) - v3(seg.top)).Magnitude
				s = canon > 0.01 and (B - A).Magnitude / canon or 1
			else
				s = scales[SCALE_FROM[format][segName] or ""] or 1
			end
			scales[segName] = s
			local top = seg.top and v3(seg.top) or Vector3.zero
			for layerName, layer in seg.layers do
				local mp = getPart(layer.part)
				if mp then
					mp.Name = "Mesh_" .. segName .. "_" .. layerName
					local rot = fit(mp, v3(layer.size), s, yaw, layer.part)
					mp.Material = material(layer.material)
					mp.Color = (colorOverrides and colorOverrides[layerName]) or Color3.new(layer.color[1], layer.color[2], layer.color[3])
					mp.Anchored = false
					mp.CanCollide = false
					mp.CanQuery = false
					mp.CanTouch = false
					mp.Massless = true
					mp.CastShadow = true
					local offset = A + (v3(layer.center) - top) * s
					mp.CFrame = bone.CFrame * CFrame.new(offset) * rot
					local weld = Instance.new("Weld")
					weld.Part0 = bone
					weld.Part1 = mp
					weld.C0 = CFrame.new(offset) * rot
					weld.Parent = mp
					mp.Parent = model
				end
			end
			fitted[bone] = true
		end
	end
	-- hide the original body parts (keep them for joints, physics and hit detection)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and not d.Name:match("^Mesh_") and d.Parent == model then
			d.Transparency = 1
		elseif d:IsA("Decal") then
			d.Transparency = 1
		elseif d:IsA("BasePart") and d.Parent ~= model and not d:FindFirstAncestorWhichIsA("Model").Name:match("^Weapon_") then
			d.Transparency = 1
		end
	end
	return true
end

-- Rotation applied to every imported mesh in place (set from AssetIds.YawFix at start-up).
MeshKit.yaw = CFrame.new()
function MeshKit.setYawFix(degrees)
	MeshKit.yaw = CFrame.Angles(0, math.rad(degrees or 0), 0)
end

-- Builds a static prop model (anchored) at `cframe` with uniform `scale`.
-- Props are generated with their base at y = 0, so cframe is the ground point.
function MeshKit.buildProp(meta, getPart, cframe, scale, parent, name)
	local model = Instance.new("Model")
	model.Name = name or "Prop"
	local any = false
	for layerName, layer in meta.layers do
		local mp = getPart(layer.part)
		if mp then
			mp.Name = layerName
			local rot = fit(mp, v3(layer.size), scale, MeshKit.yaw, layer.part)
			mp.Material = material(layer.material)
			mp.Color = Color3.new(layer.color[1], layer.color[2], layer.color[3])
			mp.Anchored = true
			mp.CFrame = cframe * CFrame.new(v3(layer.center) * scale) * rot
			mp.Parent = model
			any = true
		end
	end
	if not any then
		model:Destroy()
		return nil
	end
	model.Parent = parent
	return model
end

-- Welds weapon / tool layers onto a grip part (grip = origin, barrel along -Z).
function MeshKit.attachToGrip(meta, getPart, grip, skip)
	local any = false
	for layerName, layer in meta.layers do
		if not (skip and skip[layerName]) then
			local mp = getPart(layer.part)
			if mp then
				mp.Name = "Mesh_" .. layerName
				local rot = fit(mp, v3(layer.size), 1, MeshKit.yaw, layer.part)
				mp.Material = material(layer.material)
				mp.Color = Color3.new(layer.color[1], layer.color[2], layer.color[3])
				mp.Anchored = false
				mp.CanCollide = false
				mp.CanQuery = false
				mp.CanTouch = false
				mp.Massless = true
				mp.CFrame = grip.CFrame * CFrame.new(v3(layer.center)) * rot
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = grip
				weld.Part1 = mp
				weld.Parent = mp
				mp.Parent = grip.Parent
				any = true
			end
		end
	end
	return any
end

return MeshKit
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000001E"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Every client<->server message goes through these RemoteEvents. The server creates them;
-- clients wait for them. Server handlers are rate-limited and wrapped in pcall so a bad
-- payload can never crash a service. Validate EVERY argument in the handler.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

local EVENTS = {
	"SelectCharacter", -- client -> server (charId, perkId)
	"SetMoveState", -- client -> server (stance, sprinting, aiming)
	"Action", -- client -> server (actionName, payload)
	"ReturnToFerry", -- client -> server ()
	"Request", -- client -> server (kind, a, b): ferry menus (chart, workbench, repairs, settings)
	"Look", -- client -> server (pitch): aim pitch for other players' upper-body pose
	"Notify", -- server -> client (kind, data)
}

local folder
if RunService:IsServer() then
	folder = ReplicatedStorage:FindFirstChild("Net")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Net"
	end
	for _, name in EVENTS do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
	folder.Parent = ReplicatedStorage
else
	folder = ReplicatedStorage:WaitForChild("Net")
end

function Net.event(name)
	return folder:WaitForChild(name)
end

local buckets = {}

-- Server only. `rate` = max messages per second per player (token bucket).
function Net.onServer(name, rate, handler)
	local remote = Net.event(name)
	remote.OnServerEvent:Connect(function(player, ...)
		local key = player.UserId
		local perPlayer = buckets[key]
		if not perPlayer then
			perPlayer = {}
			buckets[key] = perPlayer
		end
		local now = os.clock()
		local bucket = perPlayer[name]
		if not bucket then
			bucket = { tokens = rate, t = now }
			perPlayer[name] = bucket
		end
		bucket.tokens = math.min(rate, bucket.tokens + (now - bucket.t) * rate)
		bucket.t = now
		if bucket.tokens < 1 then
			return -- dropped: flooding
		end
		bucket.tokens -= 1
		local ok, err = pcall(handler, player, ...)
		if not ok then
			warn(("[Net] %s handler error for %s: %s"):format(name, player.Name, tostring(err)))
		end
	end)
end

function Net.notify(player, kind, data)
	Net.event("Notify"):FireClient(player, kind, data)
end

function Net.notifyAll(kind, data)
	Net.event("Notify"):FireAllClients(kind, data)
end

if RunService:IsServer() then
	Players.PlayerRemoving:Connect(function(player)
		buckets[player.UserId] = nil
	end)
end

return Net
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000001F"><Properties><string name="Name">Stats</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Combines a character's innate perk and chosen perk into one modifier table.
local Characters = require(script.Parent.Config.Characters)

local Stats = {}

local DEFAULTS = {
	noiseMult = 1,
	crouchNoiseMult = 1,
	waterNoiseMult = 1,
	takedownTimeMult = 1,
	shoveCooldownMult = 1,
	healMult = 1,
	throwCapBonus = 0,
	damageTakenMult = 1,
	abilityCooldownMult = 1,
	abilityRadiusMult = 1,
	abilityDurationMult = 1,
	sprintSpeedMult = 1,
	reviveHPBonus = 0,
	bleedOutBonus = 0,
	throwNoiseMult = 1,
	craftTimeMult = 1,
	craftYieldBonus = 0,
	ammoBonus = 0,
	aimSpreadMult = 1,
}

local ADDITIVE = {
	throwCapBonus = true,
	reviveHPBonus = true,
	bleedOutBonus = true,
	craftYieldBonus = true,
	ammoBonus = true,
}

local function apply(result, mods)
	for key, value in mods do
		if DEFAULTS[key] == nil then
			warn("[Stats] unknown perk modifier: " .. tostring(key))
		elseif ADDITIVE[key] then
			result[key] += value
		else
			result[key] *= value
		end
	end
end

function Stats.findPerk(charId, perkId)
	local def = Characters.List[charId]
	if not def then
		return nil
	end
	for _, perk in def.perks do
		if perk.id == perkId then
			return perk
		end
	end
	return nil
end

-- extraPerks: optional set { [perkId] = true } of perks bought at the workbench this run.
function Stats.compute(charId, perkId, extraPerks)
	local result = table.clone(DEFAULTS)
	local def = Characters.List[charId]
	if not def then
		return result
	end
	apply(result, def.innate.mods)
	local perk = Stats.findPerk(charId, perkId)
	if perk then
		apply(result, perk.mods)
	end
	if extraPerks then
		for _, p in def.perks do
			if extraPerks[p.id] and p.id ~= perkId then
				apply(result, p.mods)
			end
		end
	end
	return result
end

return Stats
]]></ProtectedString></Properties></Item>
<Item class="Folder" referent="RBX00000023"><Properties><string name="Name">Util</string></Properties><Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">Geometry</string><ProtectedString name="Source"><![CDATA[--!nonstrict
local CollectionService = game:GetService("CollectionService")

local Geometry = {}

function Geometry.pointInPart(point, part)
	local rel = part.CFrame:PointToObjectSpace(point)
	local half = part.Size * 0.5
	return math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y and math.abs(rel.Z) <= half.Z
end

-- True if `point` lies inside any part tagged `tag` (volumes such as TallGrass, LitZone, Shallows).
function Geometry.inTagged(point, tag)
	for _, part in CollectionService:GetTagged(tag) do
		if part:IsA("BasePart") and Geometry.pointInPart(point, part) then
			return true
		end
	end
	return false
end

function Geometry.flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

function Geometry.flatDistance(a, b)
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

-- Rejects NaN, infinities and absurd values sent by clients.
function Geometry.isSaneVector(v, maxMagnitude)
	if typeof(v) ~= "Vector3" then
		return false
	end
	if v.X ~= v.X or v.Y ~= v.Y or v.Z ~= v.Z then
		return false
	end
	return v.Magnitude <= (maxMagnitude or 1e5)
end

return Geometry
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000021"><Properties><string name="Name">Sfx</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- One-shot 3D sounds and attached loops, mixed through four SoundGroups (SFX, Ambience,
-- Music, UI).
--
-- Server: Sfx.at() does NOT play the sound on the server. It tells every client to play it
-- locally (Notify "Sfx"). Server-played one-shots replicate late: a 0.3 s gunshot or step can
-- be over before the client has even loaded it, which is why effects went silent.
local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local Sounds = require(script.Parent.Parent.Config.Sounds)

local Sfx = {}
local IS_SERVER = RunService:IsServer()

-- Mix levels per group (players can scale the master volume in Roblox's own menu).
local GROUPS = { SFX = 1.0, Ambience = 0.32, Music = 0.55, UI = 0.7 }
local GROUP_OF = {
	Amb_Wind = "Ambience", Amb_Sea = "Ambience", Amb_Drone = "Ambience", FireLoop = "SFX",
	Music_Tension = "Music", Stinger_Spotted = "Music", Stinger_Clear = "Music",
	Ui_Tick = "UI", Ui_Confirm = "UI",
	Listen_On = "UI", Listen_Off = "UI", Listen_Loop = "UI", Listen_Ping = "UI",
	Amb_Birds = "Ambience", Amb_Gulls = "Ambience",
}

local groups = {}
local function group(name)
	if groups[name] then
		return groups[name]
	end
	local g = SoundService:FindFirstChild("Mix_" .. name)
	if not g then
		g = Instance.new("SoundGroup")
		g.Name = "Mix_" .. name
		g.Volume = GROUPS[name] or 1
		g.Parent = SoundService
	end
	groups[name] = g
	return g
end

local function make(soundKey, volume, maxDistance, pitchJitter)
	local id = Sounds[soundKey]
	if type(id) ~= "string" or id == "" then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = (volume or 0.6) * ((Sounds.Volume and Sounds.Volume[soundKey]) or 1)
	sound.RollOffMaxDistance = maxDistance or 120
	sound.RollOffMinDistance = 8
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.SoundGroup = group(GROUP_OF[soundKey] or "SFX")
	if pitchJitter and pitchJitter > 0 then
		sound.PlaybackSpeed = 1 + (math.random() * 2 - 1) * pitchJitter
	end
	return sound
end

function Sfx.has(soundKey)
	local id = Sounds[soundKey]
	return type(id) == "string" and id ~= ""
end

-- Every sound instance, for ContentProvider:PreloadAsync on the client.
function Sfx.preloadList()
	local list = {}
	for key, id in Sounds do
		if type(id) == "string" and id:find("rbxassetid://") then
			local s = Instance.new("Sound")
			s.SoundId = id
			s.Name = key
			table.insert(list, s)
		end
	end
	return list
end

local function playLocal(position, soundKey, volume, maxDistance, pitchJitter)
	local sound = make(soundKey, volume, maxDistance, pitchJitter or 0.06)
	if not sound then
		return
	end
	local holder = Instance.new("Attachment")
	holder.Parent = Workspace.Terrain
	holder.WorldPosition = position
	sound.Parent = holder
	sound:Play()
	Debris:AddItem(holder, math.max(4, sound.TimeLength + 2))
end

function Sfx.at(position, soundKey, volume, maxDistance, pitchJitter)
	if typeof(position) ~= "Vector3" then
		return
	end
	if IS_SERVER then
		-- clients play it themselves (instant, and loaded ahead of time)
		local Net = require(script.Parent.Parent.Net)
		Net.notifyAll("Sfx", { p = position, k = soundKey, v = volume, d = maxDistance, j = pitchJitter })
		return
	end
	playLocal(position, soundKey, volume, maxDistance, pitchJitter)
end

-- Client: play a server request.
function Sfx.fromServer(data)
	if type(data) == "table" and type(data.k) == "string" then
		playLocal(data.p, data.k, tonumber(data.v), tonumber(data.d), tonumber(data.j))
	end
end

-- Attach a sound to a part (looping or one-shot). Returns the Sound or nil.
function Sfx.attach(part, soundKey, volume, maxDistance, looped)
	local sound = make(soundKey, volume, maxDistance, 0)
	if not sound then
		return nil
	end
	sound.Looped = looped == true
	sound.Parent = part
	sound:Play()
	if not looped then
		Debris:AddItem(sound, 10)
	end
	return sound
end

-- Non-positional (UI, music, ambience) on the client.
function Sfx.ui(soundKey, volume, looped)
	local sound = make(soundKey, volume, nil, 0)
	if not sound then
		return nil
	end
	sound.Looped = looped == true
	sound.Parent = SoundService
	sound:Play()
	if not looped then
		Debris:AddItem(sound, 12)
	end
	return sound
end

return Sfx
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000022"><Properties><string name="Name">Spring</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Critically damped spring. Works for numbers and Vector3s.
-- frequency = how quickly it settles (higher = snappier).
local Spring = {}
Spring.__index = Spring

function Spring.new(initial, frequency)
	return setmetatable({
		position = initial,
		velocity = initial * 0,
		target = initial,
		frequency = frequency or 8,
	}, Spring)
end

function Spring:reset(value)
	self.position = value
	self.velocity = value * 0
	self.target = value
end

function Spring:update(dt)
	local w = self.frequency * 2 * math.pi
	local disp = self.position - self.target
	local decay = math.exp(-w * dt)
	local k = self.velocity + disp * w
	self.position = self.target + (disp + k * dt) * decay
	self.velocity = (self.velocity - k * w * dt) * decay
	return self.position
end

return Spring
]]></ProtectedString></Properties></Item>
</Item>
<Item class="ModuleScript" referent="RBX00000024"><Properties><string name="Name">WeaponModels</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Builds stylised weapon models from parts (placeholders until Stage 5 meshes).
-- Each model: PrimaryPart "Grip" (held in the right hand), barrel along -Z, and an
-- Attachment "Muzzle" at the barrel tip. Parts are massless and ignored by raycasts.
local WeaponModels = {}

local METAL = Color3.fromRGB(44, 46, 50)
local STEEL = Color3.fromRGB(88, 90, 94)
local WOOD = Color3.fromRGB(96, 64, 42)
local DARKWOOD = Color3.fromRGB(70, 46, 32)
local BONE = Color3.fromRGB(214, 206, 188)

-- { size, offset CFrame from grip, color, material, shape? }
local SPECS = {
	revolver = {
		muzzle = Vector3.new(0, 0.38, -1.25),
		support = Vector3.new(-0.04, -0.15, 0),
		parts = {
			{ Vector3.new(0.24, 0.55, 0.34), CFrame.new(0, 0, 0.05) * CFrame.Angles(math.rad(-12), 0, 0), DARKWOOD, Enum.Material.Wood },
			{ Vector3.new(0.22, 0.34, 0.7), CFrame.new(0, 0.3, -0.25), METAL, Enum.Material.Metal },
			{ Vector3.new(0.36, 0.32, 0.32), CFrame.new(0, 0.3, -0.2) * CFrame.Angles(0, math.rad(90), 0), STEEL, Enum.Material.Metal, Enum.PartType.Cylinder },
			{ Vector3.new(0.14, 0.14, 0.82), CFrame.new(0, 0.38, -0.85), METAL, Enum.Material.Metal },
		},
	},
	rifle = {
		muzzle = Vector3.new(0, 0.18, -2.85),
		support = Vector3.new(0, 0.08, -1.1),
		parts = {
			{ Vector3.new(0.24, 0.45, 1.2), CFrame.new(0, -0.02, 0.75), WOOD, Enum.Material.Wood },
			{ Vector3.new(0.22, 0.28, 1.1), CFrame.new(0, 0.15, -0.4), WOOD, Enum.Material.Wood },
			{ Vector3.new(0.18, 0.2, 0.9), CFrame.new(0, 0.3, -0.25), METAL, Enum.Material.Metal },
			{ Vector3.new(0.12, 0.12, 1.9), CFrame.new(0, 0.18, -1.9), METAL, Enum.Material.Metal },
			{ Vector3.new(0.06, 0.06, 0.3), CFrame.new(0.16, 0.32, 0.05), STEEL, Enum.Material.Metal }, -- bolt
		},
	},
	carbine = {
		muzzle = Vector3.new(0, 0.2, -2.2),
		support = Vector3.new(0, 0.06, -1.0),
		parts = {
			{ Vector3.new(0.24, 0.42, 1.0), CFrame.new(0, -0.02, 0.65), WOOD, Enum.Material.Wood },
			{ Vector3.new(0.22, 0.3, 0.9), CFrame.new(0, 0.15, -0.3), METAL, Enum.Material.Metal },
			{ Vector3.new(0.13, 0.13, 1.5), CFrame.new(0, 0.22, -1.45), METAL, Enum.Material.Metal },
			{ Vector3.new(0.15, 0.15, 1.2), CFrame.new(0, 0.06, -1.3), WOOD, Enum.Material.Wood }, -- fore-end
			{ Vector3.new(0.08, 0.26, 0.36), CFrame.new(0, -0.17, -0.1), STEEL, Enum.Material.Metal }, -- lever
		},
	},
	shotgun = {
		muzzle = Vector3.new(0, 0.22, -2.3),
		support = Vector3.new(0, 0.06, -1.25),
		parts = {
			{ Vector3.new(0.26, 0.45, 1.0), CFrame.new(0, -0.02, 0.6), DARKWOOD, Enum.Material.Wood },
			{ Vector3.new(0.26, 0.32, 0.9), CFrame.new(0, 0.15, -0.35), METAL, Enum.Material.Metal },
			{ Vector3.new(0.18, 0.18, 1.6), CFrame.new(0, 0.24, -1.5), METAL, Enum.Material.Metal },
			{ Vector3.new(0.16, 0.16, 1.4), CFrame.new(0, 0.06, -1.4), STEEL, Enum.Material.Metal }, -- magazine tube
			{ Vector3.new(0.26, 0.24, 0.6), CFrame.new(0, 0.06, -1.25), DARKWOOD, Enum.Material.Wood }, -- pump
		},
	},
	bow = {
		muzzle = Vector3.new(0, 0.1, -0.5),
		support = Vector3.new(0, 0.1, 0.5),
		parts = {
			{ Vector3.new(0.2, 0.6, 0.26), CFrame.new(0, 0, 0), DARKWOOD, Enum.Material.Wood },
			{ Vector3.new(0.12, 1.8, 0.18), CFrame.new(0, 1.15, 0.12) * CFrame.Angles(math.rad(-14), 0, 0), WOOD, Enum.Material.Wood },
			{ Vector3.new(0.12, 1.8, 0.18), CFrame.new(0, -1.15, 0.12) * CFrame.Angles(math.rad(14), 0, 0), WOOD, Enum.Material.Wood },
			{ Vector3.new(0.03, 4.1, 0.03), CFrame.new(0, 0, 0.5), BONE, Enum.Material.Fabric },
			{ Vector3.new(0.05, 0.05, 1.6), CFrame.new(0, 0.1, -0.2), BONE, Enum.Material.Wood }, -- nocked arrow
		},
	},
}

local function prep(part)
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
end

-- getPart / meta are optional: when the sculpted weapon meshes are loaded they replace the
-- part-built placeholder (grip + muzzle attachment stay the same).
function WeaponModels.build(weaponId, getPart, meta, skipLayers)
	local spec = SPECS[weaponId]
	if not spec then
		return nil
	end
	if getPart and meta then
		local model = Instance.new("Model")
		model.Name = "Weapon_" .. weaponId
		local grip = Instance.new("Part")
		grip.Name = "Grip"
		grip.Size = Vector3.new(0.2, 0.2, 0.2)
		grip.Transparency = 1
		grip.CFrame = CFrame.new()
		prep(grip)
		grip.Parent = model
		model.PrimaryPart = grip
		local MeshKit = require(script.Parent.MeshKit)
		if MeshKit.attachToGrip(meta, getPart, grip, skipLayers) then
			local muzzle = Instance.new("Attachment")
			muzzle.Name = "Muzzle"
			local m = meta.muzzle
			muzzle.Position = m and Vector3.new(m[1], m[2], m[3]) or spec.muzzle -- the sculpted barrel tip
			muzzle.Parent = grip
			local sp = meta.support
			local support = Instance.new("Attachment")
			support.Name = "Support" -- where the left hand holds it (PlayerAnimator IK)
			support.Position = sp and Vector3.new(sp[1], sp[2], sp[3]) or spec.support or Vector3.zero
			support.Parent = grip
			return model
		end
		model:Destroy()
	end
	local model = Instance.new("Model")
	model.Name = "Weapon_" .. weaponId

	local grip = Instance.new("Part")
	grip.Name = "Grip"
	grip.Size = Vector3.new(0.2, 0.2, 0.2)
	grip.Transparency = 1
	grip.CFrame = CFrame.new()
	prep(grip)
	grip.Parent = model
	model.PrimaryPart = grip

	for i, p in spec.parts do
		local part = Instance.new("Part")
		part.Name = "Piece" .. i
		part.Size = p[1]
		part.CFrame = p[2]
		part.Color = p[3]
		part.Material = p[4]
		if p[5] then
			part.Shape = p[5]
		end
		prep(part)
		part.Parent = model
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = grip
		weld.Part1 = part
		weld.Parent = part
	end

	local muzzle = Instance.new("Attachment")
	muzzle.Name = "Muzzle"
	muzzle.Position = spec.muzzle
	muzzle.Parent = grip
	local support = Instance.new("Attachment")
	support.Name = "Support"
	support.Position = spec.support or Vector3.zero
	support.Parent = grip
	return model
end

-- Where each weapon sits relative to its parent part.
WeaponModels.HandOffset = CFrame.new(0, -0.15, 0) * CFrame.Angles(-math.pi / 2, 0, 0)
-- slung diagonally across the back, behind the pack (barrel up over the left shoulder)
WeaponModels.BackOffset = CFrame.new(0.1, 0.15, 1.02) * CFrame.Angles(0, 0, math.rad(38)) * CFrame.Angles(math.rad(90), 0, 0) * CFrame.new(0, 0, -0.5)
WeaponModels.HipOffset = CFrame.new(0.72, -0.2, 0.05) * CFrame.Angles(math.rad(-90), 0, 0)

return WeaponModels
]]></ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX00000044"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX00000043"><Properties><string name="Name">Server</string></Properties><Item class="Script" referent="RBX00000027"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- AFTERTIDE server bootstrap. Every service exposes optional init(registry) and start().
-- init wires dependencies (no yielding); start begins loops and connections.
local Players = game:GetService("Players")

Players.CharacterAutoLoads = false -- CharacterService spawns the crew rigs itself

local Services = script.Parent:WaitForChild("Services")

local ORDER = {
	"PlayerDataService",
	"AnalyticsHelper",
	"CosmeticsService",
	"AssetService",
	"MapService",
	"PerceptionService",
	"InventoryService",
	"CharacterService",
	"WeaponService",
	"EnemyService",
	"LootService",
	"ActionService",
	"WorkbenchService",
	"HomebaseService",
	"CommerceService",
	"SpinService",
	"RewardsService",
	"QuestService",
	"LeaderboardService",
	"MatchService",
	"AntiCheatService",
}

local registry = {}
for _, name in ORDER do
	registry[name] = require(Services:WaitForChild(name))
end
for _, name in ORDER do
	local service = registry[name]
	if service.init then
		service.init(registry)
	end
end
for _, name in ORDER do
	local service = registry[name]
	if service.start then
		task.spawn(service.start)
	end
end

-- Forward server warnings / errors (and our own [Tagged] prints) to players' F2 diagnostics.
local LogService = game:GetService("LogService")
local Net = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared").Net)
local sentThisMinute, minuteStart = 0, os.clock()
LogService.MessageOut:Connect(function(message, messageType)
	local kind = (messageType == Enum.MessageType.MessageError and "error") or (messageType == Enum.MessageType.MessageWarning and "warning") or nil
	if not kind and message:sub(1, 1) ~= "[" then
		return
	end
	if os.clock() - minuteStart > 60 then
		sentThisMinute, minuteStart = 0, os.clock()
	end
	if sentThisMinute < 80 then
		sentThisMinute += 1
		pcall(Net.notifyAll, "Diag", { k = kind or "info", m = message:sub(1, 400) })
	end
end)

print("[BRINEWAKE] server ready")
]]></ProtectedString></Properties></Item>
<Item class="Folder" referent="RBX0000002C"><Properties><string name="Name">Maps</string></Properties><Item class="ModuleScript" referent="RBX00000028"><Properties><string name="Name">CanneryRow</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- CANNERY ROW: a coastal fish cannery, container yard, net shed and tidal shallows.
-- Bright overcast midday. Terrain ground (asphalt yard, concrete, grass verges, mud),
-- real terrain water in the shallows, reeds and tall grass to hide in.
local MapKit = require(script.Parent.MapKit)
local C = MapKit.C
local block, volume = MapKit.block, MapKit.volume

local Map = {
	id = "CanneryRow",
	name = "Cannery Row",
	lighting = { sky = "cannery", clouds = 0.45, cloudDensity = 0.5, cloudColor = { 255, 255, 255 }, wind = { 12, 0, 5 }, clock = 12.8, brightness = 3.2, ambient = { 106, 110, 114 }, outdoor = { 152, 158, 162 }, fog = 0.22, haze = 0.6, fogColor = { 206, 224, 238 }, tint = { 255, 252, 246 }, saturation = 0.12, contrast = 0.1, shift = { 255, 242, 226 } },
}

local OFFICE = { 26, 90, 72, 114 } -- the harbour office block (rooms, corridors, offices)

function Map.build(parent, rng)
	local M = Enum.Material
	MapKit.outskirts("coast")
	MapKit.floodWall(parent, nil, { height = 16 })
	-- terrain base: concrete yard, asphalt lanes, grass verges, mud by the water
	MapKit.slab(-118, -118, 118, 118, M.Concrete, 0)
	MapKit.slab(-12, 14, 118, 30, M.Asphalt, 0.02)
	MapKit.slab(66, -118, 118, 118, M.Asphalt, 0.02)
	MapKit.slab(-70, 30, -10, 118, M.Grass, 0.05)
	MapKit.slab(-70, -118, -30, -40, M.Grass, 0.05)
	MapKit.slab(-75, -118, -64, 118, M.Mud, 0.0)
	-- the shallows: ground dips, terrain water on top
	MapKit.clearAbove(-118, -92, -70, 72, -1.6)
	MapKit.slab(-118, -92, -70, 72, M.Mud, -1.6)
	MapKit.water(-118, -92, -70, 72, 0.3, 1.9)
	volume(parent, Vector3.new(48, 6, 164), Vector3.new(-94, 2, -10), "Shallows")

	-- perimeter wall
	block(parent, Vector3.new(236, 16, 2), Vector3.new(0, 8, -118), C.wallDark, M.Concrete)
	block(parent, Vector3.new(236, 16, 2), Vector3.new(0, 8, 118), C.wallDark, M.Concrete)
	block(parent, Vector3.new(2, 16, 236), Vector3.new(118, 8, 0), C.wallDark, M.Concrete)
	block(parent, Vector3.new(2, 16, 236), Vector3.new(-118, 8, 0), C.wallDark, M.Concrete)

	-- the cannery
	local h = 16
	MapKit.wallX(parent, -50, -10, 60, h, { { 20, 28 } }, C.wall, M.Brick)
	MapKit.wallX(parent, 10, -10, 60, h, { { 5, 13 }, { 40, 48 } }, C.wall, M.Brick)
	MapKit.wallZ(parent, -10, -50, 10, h, { { -24, -16 } }, C.wall, M.Brick)
	MapKit.wallZ(parent, 60, -50, 10, h, { { -30, -22 } }, C.wall, M.Brick)
	block(parent, Vector3.new(72, 1, 62), Vector3.new(25, h + 0.5, -20), C.roof, M.CorrodedMetal)
	for i = 0, 4 do -- skylights let daylight in
		block(parent, Vector3.new(8, 0.3, 10), Vector3.new(4 + i * 15, h + 1.05, -20), Color3.fromRGB(180, 190, 196), M.Glass, { Transparency = 0.5 })
	end
	block(parent, Vector3.new(70, 0.2, 60), Vector3.new(25, 0.1, -20), Color3.fromRGB(80, 80, 78), M.Concrete)
	for _, x in { 5, 14, 34, 46 } do
		block(parent, Vector3.new(6, 4, 16), Vector3.new(x, 2, -20), C.machine, M.Metal)
		block(parent, Vector3.new(2, 2.5, 2), Vector3.new(x, 5.25, -24), C.metal, M.Metal)
	end
	block(parent, Vector3.new(50, 2.5, 2), Vector3.new(25, 1.25, -40), C.machine, M.DiamondPlate)
	for i = 0, 5 do
		block(parent, Vector3.new(70, 0.8, 0.8), CFrame.new(25, 12 + (i % 2) * 1.2, -48 + i * 10), C.metal, M.CorrodedMetal, { Shape = Enum.PartType.Cylinder })
	end
	MapKit.bulb(parent, Vector3.new(24, 13, -20))
	MapKit.bulb(parent, Vector3.new(3, 13, -2))

	-- container yard
	for i, c in {
		{ Vector3.new(78, 0, -85), Vector3.new(8, 8.6, 20) }, { Vector3.new(96, 0, -60), Vector3.new(20, 8.6, 8) },
		{ Vector3.new(78, 0, -35), Vector3.new(8, 8.6, 20) }, { Vector3.new(100, 0, -15), Vector3.new(8, 8.6, 20) },
		{ Vector3.new(80, 0, 10), Vector3.new(20, 8.6, 8) }, { Vector3.new(100, 0, 40), Vector3.new(8, 8.6, 20) },
		{ Vector3.new(78, 0, 60), Vector3.new(8, 8.6, 20) }, { Vector3.new(96, 0, 85), Vector3.new(20, 8.6, 8) },
	} do
		local box = block(parent, c[2], c[1] + Vector3.new(0, 4.3, 0), C.containers[(i - 1) % #C.containers + 1], M.CorrodedMetal)
		-- ribbed sides
		local long = c[2].Z > c[2].X
		for r = -4, 4 do
			local offset = long and Vector3.new(c[2].X / 2 + 0.1, 0, r * 2.1) or Vector3.new(r * 2.1, 0, c[2].Z / 2 + 0.1)
			for _, sgn in { 1, -1 } do
				block(parent, long and Vector3.new(0.2, 8.2, 0.4) or Vector3.new(0.4, 8.2, 0.2), box.Position + Vector3.new(offset.X * (long and sgn or 1), 0, offset.Z * (long and 1 or sgn)), box.Color, M.CorrodedMetal)
			end
		end
	end
	block(parent, Vector3.new(8, 8.6, 20), Vector3.new(78, 12.9, -35), C.containers[4], M.CorrodedMetal)

	-- net shed
	MapKit.wallX(parent, -84, -60, -30, 10, {}, C.wall, M.WoodPlanks)
	MapKit.wallZ(parent, -60, -112, -84, 10, {}, C.wall, M.WoodPlanks)
	MapKit.wallZ(parent, -30, -112, -84, 10, { { -100, -94 } }, C.wall, M.WoodPlanks)
	block(parent, Vector3.new(32, 1, 30), Vector3.new(-45, 10.5, -98), C.roof, M.CorrodedMetal)

	-- tall grass and reeds to hide in
	MapKit.tallGrass(parent, Vector3.new(-66, 0, -60), Vector3.new(10, 0, 30), rng)
	MapKit.tallGrass(parent, Vector3.new(-66, 0, 30), Vector3.new(10, 0, 30), rng)
	MapKit.tallGrass(parent, Vector3.new(-40, 0, 72), Vector3.new(34, 0, 18), rng)
	MapKit.tallGrass(parent, Vector3.new(62, 0, 40), Vector3.new(10, 0, 20), rng)
	MapKit.tallGrass(parent, Vector3.new(-48, 0, -60), Vector3.new(26, 0, 18), rng)
	MapKit.shortGrass(parent, Vector3.new(-40, 0, 74), Vector3.new(60, 0, 80), 90, rng)

	-- cover: crates, low walls, wrecks, barrels, rubble
	for _, pos in {
		Vector3.new(-18, 0, 40), Vector3.new(-20, 0, 55), Vector3.new(10, 0, 42), Vector3.new(25, 0, 60),
		Vector3.new(40, 0, 32), Vector3.new(-45, 0, 8), Vector3.new(-35, 0, -32), Vector3.new(-50, 0, -70),
		Vector3.new(-20, 0, -80), Vector3.new(10, 0, -72), Vector3.new(30, 0, -90), Vector3.new(50, 0, -68),
	} do
		block(parent, Vector3.new(4, 4, 4), pos + Vector3.new(0, 2, 0), C.crate, M.WoodPlanks)
		if rng:NextNumber() < 0.4 then
			block(parent, Vector3.new(3, 3, 3), pos + Vector3.new(0.4, 5.5, -0.3), C.crate, M.WoodPlanks)
		end
	end
	block(parent, Vector3.new(24, 3.5, 1.5), Vector3.new(-20, 1.75, 25), C.wall, M.Concrete)
	block(parent, Vector3.new(1.5, 3.5, 18), Vector3.new(20, 1.75, 30), C.wall, M.Concrete)
	block(parent, Vector3.new(18, 3.5, 1.5), Vector3.new(-40, 1.75, -45), C.wall, M.Concrete)
	MapKit.prop(parent, "CarVan_1", CFrame.new(20, 0, 95) * CFrame.Angles(0, 1.4, 0))
	MapKit.prop(parent, "CarSedan_1", CFrame.new(-10, 0, 22) * CFrame.Angles(0, 0.3, 0))
	MapKit.prop(parent, "CarSedan_2", CFrame.new(88, 0, -100) * CFrame.Angles(0, 2.2, 0))
	for _ = 1, 14 do
		local x, z = rng:NextNumber(-60, 105), rng:NextNumber(-105, 105)
		if not (x > -12 and x < 62 and z > -52 and z < 12) and not MapKit.inside(OFFICE, Vector3.new(x, 0, z), 3) then
			MapKit.prop(parent, "Barrel_1", CFrame.new(x, 0, z) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0), 0.9)
		end
	end
	MapKit.prop(parent, "Rubble_1", CFrame.new(-25, 0, -60), 1.4)
	MapKit.prop(parent, "Rubble_1", CFrame.new(90, 0, 104) * CFrame.Angles(0, 2, 0), 1.1)
	local office = MapKit.building(parent, OFFICE, 0, rng, { color = Color3.fromRGB(70, 130, 160), inner = Color3.fromRGB(226, 228, 220) })
	MapKit.prop(parent, "Rock_1", CFrame.new(-72, -1.6, -20), 1.2)
	MapKit.prop(parent, "Rock_2", CFrame.new(-100, -1.6, 40) * CFrame.Angles(0, 1, 0), 1)
	MapKit.prop(parent, "DeadTree_1", CFrame.new(-55, 0, 95), 0.8)
	MapKit.prop(parent, "Bush_1", CFrame.new(-30, 0, 100), 1.1)

	-- lamp posts (light pools make you easier to see)
	MapKit.lamp(parent, Vector3.new(0, 0, 70))
	MapKit.lamp(parent, Vector3.new(65, 0, -50))
	MapKit.lamp(parent, Vector3.new(-50, 0, -20))
	MapKit.lamp(parent, Vector3.new(40, 0, 18))
	for _, f in { { Vector3.new(-60, 1, 40), Vector3.new(60, 0, 60) }, { Vector3.new(-90, 1, -10), Vector3.new(40, 0, 160) }, { Vector3.new(85, 1, 0), Vector3.new(40, 0, 200) } } do
		MapKit.fog(parent, f[1], f[2])
	end

	local data = {
		StartSpawns = { Vector3.new(-6, 3, 100), Vector3.new(-2, 3, 102), Vector3.new(2, 3, 102), Vector3.new(6, 3, 100) },
		ExtractionPos = Vector3.new(-92, 0, -102),
		LanternPos = Vector3.new(5, 0, 55),
		SupplyCandidates = {
			Vector3.new(24, 0, -45), Vector3.new(5, 0, -5), Vector3.new(52, 0, -10), Vector3.new(88, 0, -38), Vector3.new(90, 0, 62),
			Vector3.new(-80, 0, 20), Vector3.new(-45, 0, -100), Vector3.new(-40, 0, 75), Vector3.new(30, 0, 75), Vector3.new(-30, 0, -50),
		},
		LootSpots = {
			Vector3.new(-25, 0, 45), Vector3.new(-15, 0, 60), Vector3.new(15, 0, 50), Vector3.new(35, 0, 65), Vector3.new(45, 0, 25), Vector3.new(-40, 0, 15),
			Vector3.new(-30, 0, -25), Vector3.new(-45, 0, -75), Vector3.new(-15, 0, -85), Vector3.new(15, 0, -80), Vector3.new(35, 0, -95), Vector3.new(55, 0, -75),
			Vector3.new(70, 0, 30), Vector3.new(88, 0, 0), Vector3.new(108, 0, -40), Vector3.new(88, 0, 78), Vector3.new(0, 0, -30), Vector3.new(30, 0, -5),
			Vector3.new(45, 0, -45), Vector3.new(10, 0, -45), Vector3.new(-55, 0, -30), Vector3.new(-60, 0, 50), Vector3.new(-60, 0, 80), Vector3.new(60, 0, 90),
		},
		ContainerSpots = {
			{ pos = Vector3.new(-6, 0, -46), type = "Locker", yaw = 0 }, { pos = Vector3.new(-4, 0, -46), type = "Locker", yaw = 0 },
			{ pos = Vector3.new(56, 0, -46), type = "Toolbox", yaw = 0 }, { pos = Vector3.new(56, 0, 5), type = "Drawer", yaw = 180 },
			{ pos = Vector3.new(-6, 0, 5), type = "Drawer", yaw = 180 }, { pos = Vector3.new(30, 0, -12), type = "AmmoCrate", yaw = 90 },
			{ pos = Vector3.new(90, 0, -50), type = "AmmoCrate", yaw = 0 }, { pos = Vector3.new(108, 0, 20), type = "Toolbox", yaw = -90 },
			{ pos = Vector3.new(86, 0, 70), type = "Locker", yaw = 90 }, { pos = Vector3.new(-56, 0, -88), type = "Drawer", yaw = 0 },
			{ pos = Vector3.new(-34, 0, -108), type = "Toolbox", yaw = 180 }, { pos = Vector3.new(-56, 0, -108), type = "AmmoCrate", yaw = 90 },
			{ pos = Vector3.new(-10, 0, 85), type = "Drawer", yaw = 180 }, { pos = Vector3.new(45, 0, 95), type = "Toolbox", yaw = 180 },
			{ pos = Vector3.new(-40, 0, -40), type = "Locker", yaw = 180 }, { pos = Vector3.new(70, 0, -100), type = "Drawer", yaw = 0 },
		},
		EdgeSpawns = {
			Vector3.new(-60, 0, 108), Vector3.new(100, 0, 100), Vector3.new(105, 0, -100), Vector3.new(0, 0, -105),
			Vector3.new(105, 0, 0), Vector3.new(-50, 0, 108), Vector3.new(60, 0, -105), Vector3.new(-62, 0, -40),
		},
		PatrolRoutes = {
			{ Vector3.new(24, 0, -30), Vector3.new(24, 0, -2), Vector3.new(52, 0, -30), Vector3.new(5, 0, -35) },
			{ Vector3.new(88, 0, -80), Vector3.new(88, 0, -38), Vector3.new(88, 0, 20), Vector3.new(88, 0, 62) },
			{ Vector3.new(-30, 0, 50), Vector3.new(30, 0, 55), Vector3.new(40, 0, 25), Vector3.new(-20, 0, 35) },
			{ Vector3.new(-90, 0, -60), Vector3.new(-90, 0, 40), Vector3.new(-80, 0, 60), Vector3.new(-80, 0, -20) },
			{ Vector3.new(-40, 0, -60), Vector3.new(0, 0, -85), Vector3.new(50, 0, -85), Vector3.new(-20, 0, -70) },
			{ Vector3.new(-45, 0, -10), Vector3.new(-45, 0, 30), Vector3.new(-25, 0, 0) },
		},
		Doorways = {
			{ hinge = Vector3.new(20, 0, -50), width = 8, dir = Vector3.new(1, 0, 0) },
			{ hinge = Vector3.new(5, 0, 10), width = 8, dir = Vector3.new(1, 0, 0) },
			{ hinge = Vector3.new(40, 0, 10), width = 8, dir = Vector3.new(1, 0, 0) },
			{ hinge = Vector3.new(-10, 0, -24), width = 8, dir = Vector3.new(0, 0, 1) },
			{ hinge = Vector3.new(60, 0, -30), width = 8, dir = Vector3.new(0, 0, 1) },
			{ hinge = Vector3.new(-30, 0, -100), width = 6, dir = Vector3.new(0, 0, 1) },
		},
	}
	local function keep(list)
		local out = {}
		for _, v in list do
			local pos = typeof(v) == "Vector3" and v or v.pos
			if not MapKit.inside(OFFICE, pos, 1) then
				table.insert(out, v)
			end
		end
		return out
	end
	data.LootSpots = keep(data.LootSpots)
	data.ContainerSpots = keep(data.ContainerSpots)
	data.SupplyCandidates = keep(data.SupplyCandidates)
	for _, l in office.loot do
		table.insert(data.LootSpots, l)
	end
	for _, c in office.containers do
		table.insert(data.ContainerSpots, c)
	end
	table.insert(data.SupplyCandidates, office.loot[1])
	for _, d in office.doorways do
		table.insert(data.Doorways, d)
	end
	-- a harbour-side shop and a mechanic's garage, so the yard has more than warehouses
	for _, spec in { { origin = Vector3.new(52, 0, 66), style = { kind = "shop", w = 24, d = 20 } }, { origin = Vector3.new(-45, 0, 38), style = { kind = "garage", w = 28, d = 22 } } } do
		local b = MapKit.house(parent, spec.origin, 0, rng, spec.style)
		for _, d in b.doorways do
			table.insert(data.Doorways, d)
		end
		for _, c in b.containers do
			table.insert(data.ContainerSpots, c)
		end
		for _, l in b.loot do
			table.insert(data.LootSpots, l)
		end
	end
	return data
end

return Map
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000029"><Properties><string name="Name">HollowPines</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- HOLLOW PINES: a lakeside logging valley above the coast. A creek with a plank bridge, a lake with
-- a dock and rowboat, a campground round a fire, a gas station and shop on the logging road, a
-- sawmill, a ranger station and lookout, cabins, wrecks along the road, dense pine forest, flowers
-- and meadows of tall grass to hide in. Bright morning.
local MapKit = require(script.Parent.MapKit)
local C = MapKit.C
local block = MapKit.block

local Map = {
	id = "HollowPines",
	name = "Hollow Pines",
	hilly = true,
	lighting = { sky = "pines", clouds = 0.35, cloudDensity = 0.55, cloudColor = { 255, 255, 255 }, wind = { 4, 0, -3 }, clock = 8.6, brightness = 3.0, ambient = { 100, 108, 106 }, outdoor = { 146, 156, 150 }, fog = 0.3, haze = 1.0, fogColor = { 214, 230, 236 }, tint = { 250, 252, 244 }, saturation = 0.14, contrast = 0.08, shift = { 255, 230, 200 } },
}

local function creekX(z)
	return -15 + 26 * math.sin(z / 46)
end

local function baseHeight(x, z)
	local h = math.noise(x / 70, z / 70, 3.1) * 9 + math.noise(x / 28, z / 28, 7.7) * 3.5
	h += math.max(0, (math.abs(x) - 70) / 50) * 8 + math.max(0, (math.abs(z) - 80) / 40) * 6 -- rising edges
	local dc = x - creekX(z)
	h -= 3.2 * math.exp(-(dc / 7) ^ 2)
	return h + 6
end

local STATION = { -106, 18, -70, 46 }

-- Scenery helpers ----------------------------------------------------------------------------

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

-- A cylinder log between two points.
local function log(parent, a, b, radius, color, material)
	local mid = (a + b) / 2
	local len = (b - a).Magnitude
	return block(parent, Vector3.new(len, radius * 2, radius * 2), CFrame.lookAt(mid, b) * CFrame.Angles(0, math.pi / 2, 0), color or rgb(120, 84, 56), material or Enum.Material.Wood, { Shape = Enum.PartType.Cylinder })
end

local function tent(parent, pos, yaw, color)
	local M = Enum.Material
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
	MapKit.wedge(parent, Vector3.new(5.4, 3.4, 2.6), cf * CFrame.new(0, 1.7, -1.3), color, M.Fabric)
	MapKit.wedge(parent, Vector3.new(5.4, 3.4, 2.6), cf * CFrame.new(0, 1.7, 1.3) * CFrame.Angles(0, math.pi, 0), color, M.Fabric)
	block(parent, Vector3.new(2, 2.4, 0.15), cf * CFrame.new(0, 1.2, -2.62), rgb(30, 34, 38), M.Fabric, { CanCollide = false }) -- the doorway
	block(parent, Vector3.new(5.6, 0.2, 0.2), cf * CFrame.new(0, 3.45, 0), rgb(240, 240, 236), M.Fabric, { CanCollide = false })
	block(parent, Vector3.new(1.4, 0.5, 3), cf * CFrame.new(1.2, 0.35, 0), rgb(214, 90, 70), M.Fabric, { CanCollide = false }) -- sleeping bag
end

local function campfire(parent, pos)
	local M = Enum.Material
	for i = 0, 9 do
		local a = i / 10 * math.pi * 2
		block(parent, Vector3.new(0.9, 0.7, 0.9), CFrame.new(pos + Vector3.new(math.cos(a) * 1.7, 0.35, math.sin(a) * 1.7)) * CFrame.Angles(0, a, 0), rgb(120, 118, 112), M.Rock)
	end
	for i = 0, 2 do
		local a = i / 3 * math.pi
		log(parent, pos + Vector3.new(math.cos(a) * 1.1, 0.5, math.sin(a) * 1.1), pos + Vector3.new(-math.cos(a) * 1.1, 0.7, -math.sin(a) * 1.1), 0.22, rgb(70, 50, 36))
	end
	local core = block(parent, Vector3.new(1.4, 0.4, 1.4), pos + Vector3.new(0, 0.4, 0), rgb(255, 120, 40), M.Neon, { CanCollide = false })
	local fire = Instance.new("Fire")
	fire.Size = 6
	fire.Heat = 8
	fire.Color = rgb(255, 150, 50)
	fire.SecondaryColor = rgb(255, 60, 20)
	fire.Parent = core
	local light = Instance.new("PointLight")
	light.Range = 26
	light.Brightness = 1.6
	light.Color = rgb(255, 170, 90)
	light.Shadows = true
	light.Parent = core
	MapKit.volume(parent, Vector3.new(16, 8, 16), pos + Vector3.new(0, 3, 0), "LitZone")
end

local function bench(parent, pos, yaw)
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
	block(parent, Vector3.new(4.4, 0.35, 1.1), cf * CFrame.new(0, 1.4, 0), rgb(150, 104, 66), Enum.Material.WoodPlanks)
	for _, x in { -1.8, 1.8 } do
		block(parent, Vector3.new(0.3, 1.4, 0.9), cf * CFrame.new(x, 0.7, 0), rgb(110, 76, 50), Enum.Material.Wood)
	end
end

local function picnic(parent, pos, yaw)
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
	block(parent, Vector3.new(5, 0.3, 2.6), cf * CFrame.new(0, 2.4, 0), rgb(176, 130, 86), Enum.Material.WoodPlanks)
	for _, z in { -2, 2 } do
		block(parent, Vector3.new(5, 0.3, 1), cf * CFrame.new(0, 1.4, z), rgb(150, 104, 66), Enum.Material.WoodPlanks)
	end
	for _, x in { -2, 2 } do
		block(parent, Vector3.new(0.3, 2.4, 4.6), cf * CFrame.new(x, 1.2, 0), rgb(110, 76, 50), Enum.Material.Wood, { CanCollide = false })
	end
end

local function sign(parent, pos, yaw, text, color)
	local cf = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
	block(parent, Vector3.new(0.4, 7, 0.4), cf * CFrame.new(0, 3.5, 0), rgb(96, 70, 48), Enum.Material.Wood)
	local board = block(parent, Vector3.new(6, 2, 0.3), cf * CFrame.new(0, 6.2, 0), color or rgb(46, 96, 62), Enum.Material.WoodPlanks)
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 40
		gui.Parent = board
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.Oswald
		label.TextScaled = true
		label.Text = text
		label.TextColor3 = rgb(250, 244, 220)
		label.Parent = gui
	end
end

local function flowerPatch(parent, center, radius, rng, groundFn)
	local colors = { rgb(240, 90, 110), rgb(255, 208, 60), rgb(250, 250, 250), rgb(180, 110, 230), rgb(255, 140, 60), rgb(110, 170, 250) }
	local color = colors[rng:NextInteger(1, #colors)]
	for _ = 1, 14 do
		local a, r = rng:NextNumber(0, 6.28), rng:NextNumber(0, radius)
		local x, z = center.X + math.cos(a) * r, center.Z + math.sin(a) * r
		local y = groundFn(x, z)
		block(parent, Vector3.new(0.18, 0.9, 0.18), Vector3.new(x, y + 0.45, z), rgb(70, 130, 60), Enum.Material.Grass, { CanCollide = false, CanQuery = false })
		block(parent, Vector3.new(0.55, 0.55, 0.55), Vector3.new(x, y + 1, z), color, Enum.Material.SmoothPlastic, { Shape = Enum.PartType.Ball, CanCollide = false, CanQuery = false })
	end
end

function Map.build(parent, rng)
	local M = Enum.Material
	MapKit.outskirts("forest")
	MapKit.heightfield(-120, -120, 120, 120, 6, baseHeight, function(x, z, h)
		local slope = math.abs(baseHeight(x + 6, z) - h) + math.abs(baseHeight(x, z + 6) - h)
		if slope > 5 then
			return M.Rock
		elseif math.abs(x - creekX(z)) < 6 then
			return M.Mud
		end
		return (math.noise(x / 30, z / 30, 1) > 0.25) and M.LeafyGrass or M.Grass
	end)
	-- creek water
	for z = -120, 114, 6 do
		local cx = creekX(z + 3)
		local surface = baseHeight(cx, z + 3) + 0.9
		MapKit.water(cx - 6, z, cx + 6, z + 6, surface, 2.2)
	end
	local function g(x, z)
		return MapKit.ground(x, z)
	end

	-- flatten pads and build cabins
	local doorways, containers, loot = {}, {}, {}
	for _, spot in { Vector3.new(55, 0, 40), Vector3.new(-70, 0, -30), Vector3.new(40, 0, -70) } do
		local y = baseHeight(spot.X, spot.Z + 9)
		-- every cabin faces -Z so it sits on the pad flattened for it
		MapKit.clearAbove(spot.X - 16, spot.Z - 12, spot.X + 16, spot.Z + 26, y)
		MapKit.slab(spot.X - 16, spot.Z - 12, spot.X + 16, spot.Z + 26, M.Ground, y, 16)
		local h = MapKit.house(parent, Vector3.new(spot.X, y, spot.Z), 0, rng, { cabin = true })
		for _, d in h.doorways do
			table.insert(doorways, d)
		end
		for _, c in h.containers do
			table.insert(containers, c)
		end
		for _, l in h.loot do
			table.insert(loot, l)
		end
	end

	-- the ranger station: a flattened pad and a building with rooms
	local sy = baseHeight(-88, 32)
	MapKit.clearAbove(STATION[1] - 6, STATION[2] - 8, STATION[3] + 6, STATION[4] + 8, sy)
	MapKit.slab(STATION[1] - 6, STATION[2] - 8, STATION[3] + 6, STATION[4] + 8, M.Ground, sy, 16)
	local station = MapKit.building(parent, STATION, sy, rng, { color = Color3.fromRGB(150, 104, 66), inner = Color3.fromRGB(226, 214, 190), material = Enum.Material.WoodPlanks, h = 10 })
	for _, d in station.doorways do
		table.insert(doorways, d)
	end
	for _, c in station.containers do
		table.insert(containers, c)
	end

	-- the ranger lookout
	local ly = g(0, 10)
	for _, o in { Vector3.new(-4, 0, -4), Vector3.new(4, 0, -4), Vector3.new(-4, 0, 4), Vector3.new(4, 0, 4) } do
		block(parent, Vector3.new(0.8, 24, 0.8), Vector3.new(o.X, ly + 12, o.Z + 10), Color3.fromRGB(92, 74, 56), M.Wood)
	end
	block(parent, Vector3.new(12, 0.8, 12), Vector3.new(0, ly + 24, 10), Color3.fromRGB(100, 82, 62), M.WoodPlanks)
	block(parent, Vector3.new(12, 7, 12), Vector3.new(0, ly + 28, 10), Color3.fromRGB(110, 90, 70), M.WoodPlanks, { Transparency = 0 })
	MapKit.wedge(parent, Vector3.new(13, 3, 6.5), CFrame.new(0, ly + 33, 6.75), C.roof, M.RoofShingles)
	MapKit.wedge(parent, Vector3.new(13, 3, 6.5), CFrame.new(0, ly + 33, 13.25) * CFrame.Angles(0, math.pi, 0), C.roof, M.RoofShingles)

	local extraLoot, extraContainers, extraDoors = {}, {}, {}
	local function pad(cx, cz, w, d, material)
		local y = baseHeight(cx, cz)
		MapKit.clearAbove(cx - w / 2, cz - d / 2, cx + w / 2, cz + d / 2, y)
		MapKit.slab(cx - w / 2, cz - d / 2, cx + w / 2, cz + d / 2, material or M.Ground, y, 16)
		return y
	end

	-- the campground: tents round a fire, log benches, a cooler, a lantern line
	do
		local cx, cz = -18, -62
		local y = pad(cx, cz, 34, 30, M.Mud)
		campfire(parent, Vector3.new(cx, y, cz))
		for i, color in { rgb(236, 120, 60), rgb(70, 140, 200), rgb(120, 190, 100), rgb(220, 70, 90) } do
			local a = i / 4 * math.pi * 2 + 0.4
			local p = Vector3.new(cx + math.cos(a) * 11, y, cz + math.sin(a) * 9)
			tent(parent, p, a + math.pi / 2 + math.pi, color)
			table.insert(extraLoot, p + Vector3.new(math.cos(a) * -3.5, 0, math.sin(a) * -3))
		end
		for i = 0, 3 do
			local a = i / 4 * math.pi * 2
			bench(parent, Vector3.new(cx + math.cos(a) * 4.6, y, cz + math.sin(a) * 4.6), a + math.pi / 2)
		end
		block(parent, Vector3.new(2.4, 1.6, 1.4), Vector3.new(cx + 6, y + 0.8, cz - 6), rgb(70, 130, 200), Enum.Material.SmoothPlastic) -- cooler
		block(parent, Vector3.new(2.5, 0.3, 1.5), Vector3.new(cx + 6, y + 1.7, cz - 6), rgb(240, 240, 236), Enum.Material.SmoothPlastic)
		table.insert(extraContainers, { pos = Vector3.new(cx + 8, y, cz + 4), type = "AmmoCrate", yaw = 0 })
		table.insert(extraContainers, { pos = Vector3.new(cx - 10, y, cz + 8), type = "Toolbox", yaw = 90 })
		picnic(parent, Vector3.new(cx - 2, y, cz + 11), 0)
		-- a string of lanterns between two poles
		for _, px in { cx - 13, cx + 13 } do
			block(parent, Vector3.new(0.4, 9, 0.4), Vector3.new(px, y + 4.5, cz - 12), rgb(96, 70, 48), M.Wood)
		end
		for i = 0, 8 do
			local k = i / 8
			local bulb = block(parent, Vector3.new(0.7, 0.7, 0.7), Vector3.new(cx - 13 + 26 * k, y + 8.6 - math.sin(k * math.pi) * 1.5, cz - 12), rgb(255, 214, 140), M.Neon, { Shape = Enum.PartType.Ball, CanCollide = false })
			if i % 3 == 1 then
				local l = Instance.new("PointLight")
				l.Range = 14
				l.Color = rgb(255, 200, 120)
				l.Parent = bulb
			end
		end
		sign(parent, Vector3.new(cx + 18, y, cz + 16), -0.6, "CAMP BRINEWAKE", rgb(46, 96, 62))
	end

	-- the gas station and shop on the logging road
	local store
	do
		local cx, cz = 25, 82
		local y = pad(cx, cz, 46, 50, M.Ground)
		store = MapKit.house(parent, Vector3.new(cx, y, cz + 6), 0, rng, { kind = "shop", w = 26, d = 18 })
		-- canopy over two pumps, on four posts, with a lit sign
		local canopyZ = cz - 12
		for _, px in { cx - 10, cx + 10 } do
			for _, pz in { canopyZ - 4, canopyZ + 4 } do
				block(parent, Vector3.new(0.9, 11, 0.9), Vector3.new(px, y + 5.5, pz), rgb(236, 236, 232), M.Metal)
			end
		end
		block(parent, Vector3.new(24, 0.8, 12), Vector3.new(cx, y + 11.4, canopyZ), rgb(214, 60, 52), M.SmoothPlastic)
		block(parent, Vector3.new(24.4, 0.5, 12.4), Vector3.new(cx, y + 10.9, canopyZ), rgb(250, 250, 246), M.SmoothPlastic)
		for _, px in { cx - 5, cx + 5 } do
			block(parent, Vector3.new(1.6, 4, 1.2), Vector3.new(px, y + 2, canopyZ), rgb(226, 60, 52), M.Metal)
			block(parent, Vector3.new(1.2, 1, 0.1), Vector3.new(px, y + 3.2, canopyZ - 0.62), rgb(120, 240, 150), M.Neon, { CanCollide = false })
			MapKit.bulb(parent, Vector3.new(px, y + 10, canopyZ), 18)
		end
		sign(parent, Vector3.new(cx - 22, y, cz - 18), 0.4, "GAS · SHOP", rgb(196, 60, 48))
		MapKit.prop(parent, "CarSedan_1", CFrame.new(cx + 2, y, canopyZ - 1) * CFrame.Angles(0, math.pi / 2, 0))
		MapKit.prop(parent, "CarVan_1", CFrame.new(cx - 18, y, cz + 8) * CFrame.Angles(0, 0.3, 0), 1.1)
		for _, d in store.doorways do
			table.insert(extraDoors, d)
		end
		for _, c in store.containers do
			table.insert(extraContainers, c)
		end
		for _, l in store.loot do
			table.insert(extraLoot, l)
		end
		table.insert(extraContainers, { pos = Vector3.new(cx + 16, y, canopyZ + 6), type = "Toolbox", yaw = 180 })
	end

	-- the lake: sandy beach, a dock, a rowboat, picnic tables
	do
		local cx, cz = 82, 88
		local gy = baseHeight(cx, cz)
		local terrain = workspace.Terrain
		terrain:FillCylinder(CFrame.new(cx, gy + 1, cz), 12, 20, M.Air) -- carve the basin
		terrain:FillCylinder(CFrame.new(cx, gy - 1.6, cz), 1.2, 20, M.Sand) -- the beach
		terrain:FillCylinder(CFrame.new(cx, gy - 2, cz), 4.2, 14.5, M.Air) -- clear the middle
		terrain:FillCylinder(CFrame.new(cx, gy - 4.4, cz), 1.2, 15, M.Mud) -- the lake bed
		terrain:FillCylinder(CFrame.new(cx, gy - 2.6, cz), 2.4, 14.5, M.Water) -- the water, just under the beach
		-- the dock
		for i = 0, 5 do
			block(parent, Vector3.new(3.4, 0.35, 2.6), Vector3.new(cx - 18 + i * 2.7, gy - 0.5, cz), rgb(150, 112, 76), M.WoodPlanks)
		end
		for i = 0, 3 do
			for _, dz in { -1.4, 1.4 } do
				block(parent, Vector3.new(0.4, 3.4, 0.4), Vector3.new(cx - 17 + i * 4.4, gy - 2, cz + dz), rgb(90, 66, 46), M.Wood)
			end
		end
		-- the rowboat
		local boat = Vector3.new(cx - 9, gy - 1.2, cz + 8)
		block(parent, Vector3.new(7, 1.2, 2.8), CFrame.new(boat) * CFrame.Angles(0, 0.35, 0), rgb(214, 80, 60), M.WoodPlanks)
		block(parent, Vector3.new(2, 1.2, 2.2), CFrame.new(boat + Vector3.new(4, 0.2, 1.4)) * CFrame.Angles(0, 0.35, 0), rgb(214, 80, 60), M.WoodPlanks)
		block(parent, Vector3.new(6, 0.3, 2.2), CFrame.new(boat + Vector3.new(0, 0.7, 0)) * CFrame.Angles(0, 0.35, 0), rgb(240, 226, 190), M.WoodPlanks, { CanCollide = false })
		picnic(parent, Vector3.new(cx - 24, gy + 0.5, cz - 8), 1.2)
		picnic(parent, Vector3.new(cx - 26, gy + 0.5, cz + 12), 1.8)
		sign(parent, Vector3.new(cx - 30, gy + 0.5, cz), 1.57, "LAKE · NO SWIMMING", rgb(40, 110, 150))
		table.insert(extraLoot, Vector3.new(cx - 14, gy, cz))
		table.insert(extraLoot, Vector3.new(cx - 26, gy + 0.5, cz + 2))
		table.insert(extraContainers, { pos = Vector3.new(cx - 28, gy + 0.5, cz - 14), type = "Locker", yaw = 90 })
	end

	-- the sawmill: an open shed over a saw table, log stacks, a crane arm
	do
		local cx, cz = 94, -50
		local y = pad(cx, cz, 30, 26, M.Ground)
		for _, px in { cx - 11, cx, cx + 11 } do
			for _, pz in { cz - 7, cz + 7 } do
				block(parent, Vector3.new(1, 11, 1), Vector3.new(px, y + 5.5, pz), rgb(104, 76, 52), M.Wood)
			end
		end
		MapKit.wedge(parent, Vector3.new(26, 4, 8.5), CFrame.new(cx, y + 13, cz - 4.2), rgb(150, 70, 56), M.CorrodedMetal)
		MapKit.wedge(parent, Vector3.new(26, 4, 8.5), CFrame.new(cx, y + 13, cz + 4.2) * CFrame.Angles(0, math.pi, 0), rgb(150, 70, 56), M.CorrodedMetal)
		block(parent, Vector3.new(9, 2.2, 3), Vector3.new(cx - 2, y + 1.1, cz), rgb(226, 170, 50), M.Metal) -- the saw table
		local blade = block(parent, Vector3.new(0.2, 3.4, 3.4), Vector3.new(cx - 2, y + 3.2, cz), rgb(196, 200, 204), M.Metal, { Shape = Enum.PartType.Cylinder, CanCollide = false })
		blade.CFrame = CFrame.new(cx - 2, y + 3.2, cz) * CFrame.Angles(0, 0, 0)
		for i = 0, 3 do -- log pile
			for j = 0, 3 - i do
				log(parent, Vector3.new(cx + 6 - 6, y + 0.9 + i * 1.5, cz - 10.5 + j * 1.5 + i * 0.75), Vector3.new(cx + 6 + 6, y + 0.9 + i * 1.5, cz - 10.5 + j * 1.5 + i * 0.75), 0.8, rgb(150, 100, 66))
			end
		end
		for i = 0, 5 do -- sawdust and cut planks
			block(parent, Vector3.new(3, 0.25, 0.7), Vector3.new(cx - 9, y + 0.15 + i * 0.28, cz + 11), rgb(220, 186, 130), M.WoodPlanks)
		end
		sign(parent, Vector3.new(cx - 18, y, cz - 16), 0.2, "RIDGE SAWMILL", rgb(120, 74, 40))
		table.insert(extraLoot, Vector3.new(cx - 8, y, cz + 4))
		table.insert(extraLoot, Vector3.new(cx + 8, y, cz + 9))
		table.insert(extraContainers, { pos = Vector3.new(cx + 12, y, cz + 10), type = "Toolbox", yaw = 180 })
		table.insert(extraContainers, { pos = Vector3.new(cx - 13, y, cz + 9), type = "Drawer", yaw = 90 })
	end

	-- a plank bridge over the creek
	do
		local bz = -6
		local x0, x1 = creekX(bz) - 14, creekX(bz) + 14
		local y0, y1 = baseHeight(x0, bz), baseHeight(x1, bz)
		local deckY = math.max(y0, y1) + 0.5
		for x = x0, x1, 2 do
			block(parent, Vector3.new(2.05, 0.4, 7), Vector3.new(x + 1, deckY, bz), rgb(150, 108, 72), M.WoodPlanks)
		end
		for _, dz in { -3.4, 3.4 } do
			block(parent, Vector3.new(x1 - x0, 0.3, 0.3), Vector3.new((x0 + x1) / 2, deckY + 2.8, bz + dz), rgb(110, 76, 50), M.Wood)
			block(parent, Vector3.new(x1 - x0, 0.3, 0.3), Vector3.new((x0 + x1) / 2, deckY + 1.4, bz + dz), rgb(110, 76, 50), M.Wood)
			for x = x0, x1, 7 do
				block(parent, Vector3.new(0.4, 3.2, 0.4), Vector3.new(x + 1, deckY + 1.4, bz + dz), rgb(96, 70, 48), M.Wood)
			end
		end
		for _, x in { creekX(bz) - 4, creekX(bz) + 4 } do
			block(parent, Vector3.new(1.2, deckY - baseHeight(x, bz) + 2, 1.2), Vector3.new(x, (deckY + baseHeight(x, bz) - 2) / 2, bz - 2.8), rgb(90, 66, 46), M.Wood)
			block(parent, Vector3.new(1.2, deckY - baseHeight(x, bz) + 2, 1.2), Vector3.new(x, (deckY + baseHeight(x, bz) - 2) / 2, bz + 2.8), rgb(90, 66, 46), M.Wood)
		end
	end

	-- a radio mast on the north ridge, wrecks and signposts along the logging road
	do
		local mx, mz = -100, -92
		local my = baseHeight(mx, mz)
		for _, o in { { -1.2, -1.2 }, { 1.2, -1.2 }, { -1.2, 1.2 }, { 1.2, 1.2 } } do
			block(parent, Vector3.new(0.3, 34, 0.3), Vector3.new(mx + o[1], my + 17, mz + o[2]), rgb(196, 60, 52), M.Metal)
		end
		for i = 1, 7 do
			block(parent, Vector3.new(3, 0.2, 0.2), Vector3.new(mx, my + i * 4.6, mz - 1.2), rgb(236, 236, 232), M.Metal, { CanCollide = false })
		end
		local beacon = block(parent, Vector3.new(1, 1, 1), Vector3.new(mx, my + 34.5, mz), rgb(255, 60, 50), M.Neon, { Shape = Enum.PartType.Ball, CanCollide = false })
		local bl = Instance.new("PointLight")
		bl.Color = rgb(255, 60, 50)
		bl.Range = 30
		bl.Parent = beacon
		local road = {
			{ Vector3.new(-48, 0, 92), "CarSedan_2", 0.5 }, { Vector3.new(-10, 0, 66), "CarSedan_1", 2.7 }, { Vector3.new(14, 0, 40), "CarVan_1", 1.0 },
			{ Vector3.new(50, 0, 6), "CarSedan_2", 0.2 }, { Vector3.new(66, 0, -22), "CarSedan_1", 3.0 }, { Vector3.new(-58, 0, 70), "CarVan_1", 2.2 },
		}
		for _, v in road do
			MapKit.prop(parent, v[2], CFrame.new(v[1].X, g(v[1].X, v[1].Z), v[1].Z) * CFrame.Angles(0, v[3], 0))
		end
		sign(parent, Vector3.new(-38, g(-38, 88), 88), 0.4, "NORTH: CAMP · SAWMILL", rgb(46, 96, 62))
		sign(parent, Vector3.new(36, g(36, 12), 12), -0.5, "LAKE 2 MI", rgb(40, 110, 150))
	end

	-- wildflowers in the meadows
	for _ = 1, 26 do
		local x, z = rng:NextNumber(-105, 105), rng:NextNumber(-105, 105)
		if math.abs(x - creekX(z)) > 10 then
			flowerPatch(parent, Vector3.new(x, 0, z), rng:NextNumber(2.5, 5), rng, g)
		end
	end

	-- forest
	local function clear(x, z)
		if math.abs(x - creekX(z)) < 9 then
			return false
		end
		for _, spot in { Vector3.new(55, 0, 48), Vector3.new(-70, 0, -22), Vector3.new(40, 0, -62), Vector3.new(0, 0, 10), Vector3.new(-88, 0, 32) } do
			if (Vector3.new(x, 0, z) - spot).Magnitude < 24 then
				return false
			end
		end
		-- the camp, gas station, lake, sawmill and bridge keep their space
		for _, area in { { -18, -62, 24 }, { 25, 82, 32 }, { 82, 88, 30 }, { 94, -50, 24 }, { creekX(-6), -6, 20 }, { -100, -92, 6 } } do
			if (Vector3.new(x, 0, z) - Vector3.new(area[1], 0, area[2])).Magnitude < area[3] then
				return false
			end
		end
		return true
	end
	local placed = 0
	while placed < 150 do
		local x, z = rng:NextNumber(-115, 115), rng:NextNumber(-115, 115)
		if clear(x, z) and not (z > 70 and x < -20) then -- keep the south-west meadow open
			MapKit.prop(parent, rng:NextNumber() < 0.85 and ("Pine_" .. rng:NextInteger(1, 2)) or "DeadTree_1", CFrame.new(x, g(x, z) - 0.5, z) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0), rng:NextNumber(0.75, 1.15))
			placed += 1
		end
	end
	for _ = 1, 34 do
		local x, z = rng:NextNumber(-115, 115), rng:NextNumber(-115, 115)
		if clear(x, z) then
			MapKit.prop(parent, rng:NextNumber() < 0.2 and "Boulder_1" or ("Rock_" .. rng:NextInteger(1, 2)), CFrame.new(x, g(x, z) - 0.6, z) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0), rng:NextNumber(0.7, 1.2))
		end
	end
	for _ = 1, 60 do
		local x, z = rng:NextNumber(-115, 115), rng:NextNumber(-115, 115)
		if clear(x, z) then
			MapKit.prop(parent, "Bush_" .. rng:NextInteger(1, 2), CFrame.new(x, g(x, z), z) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0), rng:NextNumber(0.8, 1.4))
		end
	end
	-- fallen logs
	for _ = 1, 14 do
		local x, z = rng:NextNumber(-100, 100), rng:NextNumber(-100, 100)
		if clear(x, z) then
			MapKit.prop(parent, "DeadTree_1", CFrame.new(x, g(x, z) + 0.6, z) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0) * CFrame.Angles(0, 0, math.rad(88)), 0.55)
		end
	end
	MapKit.tallGrass(parent, Vector3.new(-60, 0, 90), Vector3.new(60, 0, 40), rng, g)
	MapKit.tallGrass(parent, Vector3.new(80, 0, -20), Vector3.new(26, 0, 40), rng, g)
	MapKit.tallGrass(parent, Vector3.new(-30, 0, 20), Vector3.new(24, 0, 30), rng, g)
	MapKit.tallGrass(parent, Vector3.new(10, 0, -100), Vector3.new(50, 0, 20), rng, g)
	MapKit.shortGrass(parent, Vector3.new(0, 0, 0), Vector3.new(230, 0, 230), 260, rng, g, true)
	-- the edge of the valley is a wooded rock ridge, not a wall: a cliff of rock with a tree line
	MapKit.ridge(baseHeight, 5)
	for i = 1, 90 do
		local edge = rng:NextInteger(1, 4)
		local t = rng:NextNumber(-114, 114)
		local x = edge == 1 and 114 or (edge == 2 and -114 or t)
		local z = edge == 3 and 114 or (edge == 4 and -114 or t)
		if edge <= 2 then
			x += rng:NextNumber(-5, 5)
		else
			z += rng:NextNumber(-5, 5)
		end
		MapKit.prop(parent, "Pine_" .. rng:NextInteger(1, 2), CFrame.new(x, g(x, z) - 0.5, z) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0), rng:NextNumber(1.0, 1.5))
		assert(i)
	end
	for _, f in { { Vector3.new(-15, 6, 0), Vector3.new(40, 0, 220) }, { Vector3.new(60, 8, 60), Vector3.new(80, 0, 80) }, { Vector3.new(-60, 8, -60), Vector3.new(80, 0, 80) } } do
		MapKit.fog(parent, f[1], f[2])
	end

	local data = {
		StartSpawns = { Vector3.new(-62, 0, 100), Vector3.new(-58, 0, 102), Vector3.new(-54, 0, 100), Vector3.new(-66, 0, 102) },
		ExtractionPos = Vector3.new(70, 0, -104),
		LanternPos = Vector3.new(0, 0, 32),
		SupplyCandidates = { loot[1], loot[2], loot[4], loot[5], loot[7], loot[8], Vector3.new(-20, 0, -40), Vector3.new(90, 0, 10), Vector3.new(-95, 0, 40), Vector3.new(20, 0, 80) },
		LootSpots = {
			loot[3], loot[6], loot[9], station.loot[1], station.loot[2] or loot[1], station.loot[3] or loot[2], station.loot[4] or loot[4], Vector3.new(-40, 0, 60), Vector3.new(-10, 0, 40), Vector3.new(30, 0, 20), Vector3.new(70, 0, 0),
			Vector3.new(-80, 0, 0), Vector3.new(-50, 0, -70), Vector3.new(0, 0, -60), Vector3.new(60, 0, -90), Vector3.new(90, 0, 60),
			Vector3.new(-90, 0, 70), Vector3.new(20, 0, 100), Vector3.new(-30, 0, -100), Vector3.new(100, 0, -40),
		},
		ContainerSpots = (function()
			for _, c in extraContainers do
				table.insert(containers, c)
			end
			return containers
		end)(),
		EdgeSpawns = {
			Vector3.new(-105, 0, -105), Vector3.new(105, 0, -105), Vector3.new(105, 0, 105), Vector3.new(-20, 0, -110),
			Vector3.new(110, 0, 0), Vector3.new(-110, 0, 0), Vector3.new(40, 0, 110), Vector3.new(-110, 0, -60),
		},
		PatrolRoutes = {
			{ Vector3.new(-60, 0, 60), Vector3.new(-20, 0, 30), Vector3.new(20, 0, 60) },
			{ Vector3.new(40, 0, 20), Vector3.new(80, 0, 20), Vector3.new(60, 0, -30) },
			{ Vector3.new(-80, 0, -60), Vector3.new(-40, 0, -20), Vector3.new(-90, 0, 10) },
			{ Vector3.new(0, 0, -40), Vector3.new(40, 0, -90), Vector3.new(-30, 0, -80) },
			{ Vector3.new(creekX(-60), 0, -60), Vector3.new(creekX(0), 0, 0), Vector3.new(creekX(60), 0, 60) },
			{ Vector3.new(80, 0, -80), Vector3.new(100, 0, 40) },
		},
		Doorways = (function()
			for _, d in extraDoors do
				table.insert(doorways, d)
			end
			return doorways
		end)(),
	}
	for _, l in extraLoot do
		table.insert(data.LootSpots, l)
	end
	for _, spot in { Vector3.new(-18, 0, -62), Vector3.new(25, 0, 72), Vector3.new(80, 0, 80), Vector3.new(94, 0, -50) } do
		table.insert(data.SupplyCandidates, spot)
	end
	table.insert(data.PatrolRoutes, { Vector3.new(-18, 0, -48), Vector3.new(-5, 0, -20), Vector3.new(20, 0, 30), Vector3.new(25, 0, 62) })
	table.insert(data.PatrolRoutes, { Vector3.new(60, 0, 80), Vector3.new(80, 0, 70), Vector3.new(95, 0, 60) })
	table.insert(data.PatrolRoutes, { Vector3.new(94, 0, -34), Vector3.new(80, 0, -70), Vector3.new(60, 0, -95) })
	return data
end

return Map
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002A"><Properties><string name="Name">LarkspurStreet</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- LARKSPUR STREET: an overgrown suburban street. Weatherboard houses you can enter, yards
-- gone to tall grass, wrecked cars, power poles, a corner store. Warm golden afternoon.
local MapKit = require(script.Parent.MapKit)
local C = MapKit.C
local block, volume = MapKit.block, MapKit.volume

local Map = {
	id = "LarkspurStreet",
	name = "Larkspur Street",
	lighting = { sky = "larkspur", clouds = 0.35, cloudDensity = 0.45, cloudColor = { 255, 236, 214 }, wind = { 5, 0, 2 }, clock = 16.6, brightness = 3.2, ambient = { 112, 102, 94 }, outdoor = { 168, 156, 140 }, fog = 0.2, haze = 0.8, fogColor = { 240, 210, 176 }, tint = { 255, 242, 226 }, saturation = 0.18, contrast = 0.1, shift = { 255, 222, 182 } },
}

local PHARMACY = { 62, 66, 106, 100 }

function Map.build(parent, rng)
	local M = Enum.Material
	MapKit.outskirts("suburb")
	MapKit.floodWall(parent, nil, { height = 16, color = Color3.fromRGB(124, 120, 112) })
	MapKit.barricade(parent, rng, 13)
	MapKit.slab(-120, -120, 120, 120, M.Grass, 0)
	MapKit.slab(-120, -9, 120, 9, M.Asphalt, 0.05)
	MapKit.slab(-120, 9, 120, 13, M.Pavement, 0.15)
	MapKit.slab(-120, -13, 120, -9, M.Pavement, 0.15)
	-- painted road line (faded)
	for x = -115, 115, 12 do
		block(parent, Vector3.new(5, 0.05, 0.4), Vector3.new(x, 0.1, 0), Color3.fromRGB(250, 220, 120), M.SmoothPlastic, { CanCollide = false, Transparency = 0.15 })
	end

	local doorways, containers, loot = {}, {}, {}
	-- a mixed street: mostly homes, plus shops, flats and a garage
	local MIX = { "house", "house", "house", "house", "shop", "apartment", "garage" }
	local function addHouse(origin, yaw, style)
		style = style or { kinds = MIX }
		local h = MapKit.house(parent, origin, yaw, rng, style)
		for _, d in h.doorways do
			table.insert(doorways, d)
		end
		for _, c in h.containers do
			table.insert(containers, c)
		end
		for _, l in h.loot do
			table.insert(loot, l)
		end
		-- driveway
		local side = origin.Z > 0 and 1 or -1
		MapKit.slab(origin.X + 8, side > 0 and 13 or origin.Z, origin.X + 14, side > 0 and origin.Z or -13, M.Concrete, 0.12)
	end
	for _, x in { -82, -32, 18, 68 } do
		addHouse(Vector3.new(x, 0, 24), 0)
		addHouse(Vector3.new(x + 6, 0, -24), math.pi)
	end
	-- corner store at the west end
	addHouse(Vector3.new(-100, 0, 64), 0, { kind = "shop", w = 30, d = 26 })
	-- the chapel at the end of the back lane
	addHouse(Vector3.new(-5, 0, 66), 0, { kind = "chapel" })

	-- back fences and yards gone wild
	for _, z in { 58, -58 } do
		for x = -115, 115, 8 do
			if rng:NextNumber() > 0.15 and not (z > 0 and x > 64 and x < 84) then -- gap to the pharmacy
				local paint = ({ Color3.fromRGB(240, 238, 228), Color3.fromRGB(176, 136, 96), Color3.fromRGB(150, 190, 200), Color3.fromRGB(196, 214, 170) })[math.floor((x + 200) / 40) % 4 + 1]
				block(parent, Vector3.new(7.6, 5, 0.3), CFrame.new(x, 2.5, z) * CFrame.Angles(0, 0, rng:NextNumber(-0.06, 0.06)), paint, M.WoodPlanks)
			end
		end
	end
	for _, z in { 80, -80 } do
		MapKit.tallGrass(parent, Vector3.new(-60, 0, z), Vector3.new(60, 0, 30), rng, nil, 0.8)
		MapKit.tallGrass(parent, Vector3.new(z > 0 and 25 or 55, 0, z), Vector3.new(z > 0 and 50 or 70, 0, 30), rng, nil, 0.8)
	end
	for _, x in { -57, -7, 43, 93 } do
		MapKit.tallGrass(parent, Vector3.new(x, 0, 36), Vector3.new(10, 0, 18), rng)
		MapKit.tallGrass(parent, Vector3.new(x + 4, 0, -36), Vector3.new(10, 0, 18), rng)
	end
	MapKit.shortGrass(parent, Vector3.new(0, 0, 30), Vector3.new(230, 0, 30), 120, rng)
	MapKit.shortGrass(parent, Vector3.new(0, 0, -30), Vector3.new(230, 0, 30), 120, rng)

	-- trees and bushes
	for _ = 1, 22 do
		local x, z = rng:NextNumber(-115, 115), (rng:NextNumber() < 0.5 and 1 or -1) * rng:NextNumber(62, 112)
		if MapKit.inside(PHARMACY, Vector3.new(x, 0, z), 6) then
			continue
		end
		MapKit.prop(parent, rng:NextNumber() < 0.6 and "Pine_1" or "DeadTree_1", CFrame.new(x, 0, z) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0), rng:NextNumber(0.55, 0.85))
	end
	for _ = 1, 26 do
		local x, z = rng:NextNumber(-115, 115), (rng:NextNumber() < 0.5 and 1 or -1) * rng:NextNumber(14, 56)
		MapKit.prop(parent, "Bush_" .. rng:NextInteger(1, 2), CFrame.new(x, 0, z) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0), rng:NextNumber(0.8, 1.3))
	end

	-- the street: wrecks, barricade, power poles with sagging wires
	for i, spec in { { -70, 3, 0.2 }, { -40, -4, 2.9 }, { -5, 2, 1.4 }, { 30, -3, 0.1 }, { 58, 5, 2.3 }, { 92, -2, 1.0 } } do
		MapKit.prop(parent, ({ "CarSedan_1", "CarSedan_2", "CarVan_1" })[(i - 1) % 3 + 1], CFrame.new(spec[1], 0, spec[2]) * CFrame.Angles(0, spec[3], 0))
	end
	MapKit.prop(parent, "Rubble_1", CFrame.new(-100, 0, -2) * CFrame.Angles(0, 0.5, 0), 1.2)
	for x = -110, 110, 36 do
		block(parent, Vector3.new(0.8, 18, 0.8), Vector3.new(x, 9, 15), Color3.fromRGB(86, 70, 54), M.Wood)
		block(parent, Vector3.new(6, 0.4, 0.4), Vector3.new(x, 16.5, 15), Color3.fromRGB(86, 70, 54), M.Wood)
		if x + 36 <= 110 then
			for _, dz in { -2.5, 2.5 } do
				block(parent, Vector3.new(36, 0.08, 0.08), CFrame.new(x + 18, 15.4, 15 + dz * 0.2) * CFrame.Angles(0, 0, 0), Color3.fromRGB(20, 20, 20), M.SmoothPlastic, { CanCollide = false, CanQuery = false })
			end
		end
	end
	for _ = 1, 10 do
		MapKit.prop(parent, "Barrel_1", CFrame.new(rng:NextNumber(-110, 110), 0, rng:NextNumber(-12, 12)), 0.85)
	end
	MapKit.lamp(parent, Vector3.new(-60, 0, 12), false)
	MapKit.lamp(parent, Vector3.new(40, 0, -12), false)
	local pharmacy = MapKit.building(parent, PHARMACY, 0.1, rng, { color = Color3.fromRGB(186, 92, 70), inner = Color3.fromRGB(230, 236, 230), material = Enum.Material.Brick })
	for _, d in pharmacy.doorways do
		table.insert(doorways, d)
	end
	for _, c in pharmacy.containers do
		table.insert(containers, c)
	end
	for _, l in pharmacy.loot do
		table.insert(loot, l)
	end

	return {
		StartSpawns = { Vector3.new(108, 3, -3), Vector3.new(108, 3, 3), Vector3.new(104, 3, -6), Vector3.new(104, 3, 6) },
		ExtractionPos = Vector3.new(-108, 0, 0),
		LanternPos = Vector3.new(0, 0, 0),
		SupplyCandidates = { loot[1], loot[4], loot[7], loot[10], loot[13], loot[16], loot[19], loot[22], Vector3.new(-40, 0, 85), Vector3.new(60, 0, -85) },
		LootSpots = loot,
		ContainerSpots = containers,
		EdgeSpawns = {
			Vector3.new(-110, 0, 100), Vector3.new(110, 0, 100), Vector3.new(110, 0, -100), Vector3.new(-110, 0, -100),
			Vector3.new(0, 0, 110), Vector3.new(0, 0, -110), Vector3.new(-60, 0, 108), Vector3.new(60, 0, -108),
		},
		PatrolRoutes = {
			{ Vector3.new(-90, 0, 0), Vector3.new(90, 0, 0) },
			{ Vector3.new(-90, 0, 75), Vector3.new(0, 0, 70), Vector3.new(84, 0, 60), Vector3.new(84, 0, 84) },
			{ Vector3.new(-90, 0, -75), Vector3.new(0, 0, -70), Vector3.new(90, 0, -80) },
			{ Vector3.new(-30, 0, 34), Vector3.new(20, 0, 34), Vector3.new(70, 0, 34) },
			{ Vector3.new(-26, 0, -34), Vector3.new(24, 0, -34), Vector3.new(74, 0, -34) },
			{ Vector3.new(-100, 0, 76), Vector3.new(-100, 0, 30) },
		},
		Doorways = doorways,
	}
end

return Map
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002B"><Properties><string name="Name">MapKit</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Shared building blocks for the encounter maps: parts, volumes, walls, lights, terrain,
-- grass, props (sculpted meshes when loaded, part fallbacks otherwise) and houses.
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local MeshKit = require(Shared.MeshKit)

local MapKit = {}
local Assets -- AssetService, set by MapService

local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

MapKit.C = {
	ground = Color3.fromRGB(96, 98, 92),
	wall = Color3.fromRGB(176, 166, 148),
	wallDark = Color3.fromRGB(120, 112, 100),
	roof = Color3.fromRGB(150, 70, 56),
	metal = Color3.fromRGB(46, 48, 50),
	crate = Color3.fromRGB(92, 72, 52),
	machine = Color3.fromRGB(70, 78, 80),
	bone = Color3.fromRGB(226, 220, 206),
	water = Color3.fromRGB(52, 70, 74),
	reed = Color3.fromRGB(110, 112, 76),
	warm = Color3.fromRGB(255, 196, 130),
	containers = { Color3.fromRGB(196, 74, 54), Color3.fromRGB(40, 140, 150), Color3.fromRGB(60, 100, 170), Color3.fromRGB(226, 170, 60), Color3.fromRGB(90, 150, 90) },
}
local C = MapKit.C

function MapKit.setAssets(assetService)
	Assets = assetService
end

function MapKit.block(parent, size, position, color, material, props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = typeof(position) == "CFrame" and position or CFrame.new(position)
	p.Color = color
	p.Material = material or Enum.Material.Concrete
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props then
		for key, value in props do
			p[key] = value
		end
	end
	p.Parent = parent
	return p
end
local block = MapKit.block

function MapKit.wedge(parent, size, cframe, color, material)
	local w = Instance.new("WedgePart")
	w.Anchored = true
	w.Size = size
	w.CFrame = cframe
	w.Color = color
	w.Material = material
	w.Parent = parent
	return w
end

function MapKit.volume(parent, size, position, tag)
	local p = block(parent, size, position, Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, {
		Name = tag,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
	})
	CollectionService:AddTag(p, tag)
	return p
end

local function splitGaps(a, b, gaps)
	local segments, cursor = {}, a
	table.sort(gaps, function(x, y)
		return x[1] < y[1]
	end)
	for _, gap in gaps do
		if gap[1] > cursor then
			table.insert(segments, { cursor, gap[1] })
		end
		cursor = math.max(cursor, gap[2])
	end
	if b > cursor then
		table.insert(segments, { cursor, b })
	end
	return segments
end

-- Wall along X at depth z (y0 = base height), door gaps {{x1,x2}} with lintels.
function MapKit.wallX(parent, z, x1, x2, height, gaps, color, material, y0)
	y0 = y0 or 0
	for _, s in splitGaps(x1, x2, gaps or {}) do
		block(parent, Vector3.new(s[2] - s[1], height, 1.2), Vector3.new((s[1] + s[2]) / 2, y0 + height / 2, z), color, material)
	end
	for _, g in gaps or {} do
		if height > 9 then
			block(parent, Vector3.new(g[2] - g[1], height - 9, 1.2), Vector3.new((g[1] + g[2]) / 2, y0 + 9 + (height - 9) / 2, z), color, material)
		end
	end
end

function MapKit.wallZ(parent, x, z1, z2, height, gaps, color, material, y0)
	y0 = y0 or 0
	for _, s in splitGaps(z1, z2, gaps or {}) do
		block(parent, Vector3.new(1.2, height, s[2] - s[1]), Vector3.new(x, y0 + height / 2, (s[1] + s[2]) / 2), color, material)
	end
	for _, g in gaps or {} do
		if height > 9 then
			block(parent, Vector3.new(1.2, height - 9, g[2] - g[1]), Vector3.new(x, y0 + 9 + (height - 9) / 2, (g[1] + g[2]) / 2), color, material)
		end
	end
end

function MapKit.lamp(parent, base, lit)
	block(parent, Vector3.new(0.6, 12, 0.6), base + Vector3.new(0, 6, 0), C.metal, Enum.Material.Metal)
	block(parent, Vector3.new(0.3, 0.3, 2.4), base + Vector3.new(0, 11.9, -1.1), C.metal, Enum.Material.Metal)
	local head = block(parent, Vector3.new(1.4, 0.5, 1.0), base + Vector3.new(0, 11.7, -2.2), lit == false and C.metal or C.warm, lit == false and Enum.Material.Metal or Enum.Material.Neon)
	if lit ~= false then
		local light = Instance.new("SpotLight")
		light.Face = Enum.NormalId.Bottom
		light.Range = 28
		light.Angle = 100
		light.Brightness = 2
		light.Color = C.warm
		light.Shadows = true
		light.Parent = head
		MapKit.volume(parent, Vector3.new(20, 10, 20), base + Vector3.new(0, 5, -2), "LitZone")
	end
end

function MapKit.bulb(parent, position, range)
	local bulb = block(parent, Vector3.new(0.7, 0.7, 0.7), position, C.warm, Enum.Material.Neon, { Shape = Enum.PartType.Ball, CanCollide = false })
	local light = Instance.new("PointLight")
	light.Range = range or 18
	light.Brightness = 1.3
	light.Color = C.warm
	light.Shadows = true
	light.Parent = bulb
	MapKit.volume(parent, Vector3.new(14, 10, 14), Vector3.new(position.X, position.Y - 6, position.Z), "LitZone")
end

function MapKit.fog(parent, position, size)
	local p = block(parent, Vector3.new(size.X, 1, size.Z), position, Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, {
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
	})
	local e = Instance.new("ParticleEmitter")
	e.Texture = SMOKE
	e.Rate = 1.2
	e.Lifetime = NumberRange.new(14, 20)
	e.Speed = NumberRange.new(0.3, 1)
	e.SpreadAngle = Vector2.new(60, 60)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-4, 4)
	e.LightInfluence = 1
	e.Color = ColorSequence.new(Color3.fromRGB(215, 220, 220))
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 16), NumberSequenceKeypoint.new(1, 28) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.9), NumberSequenceKeypoint.new(0.7, 0.92), NumberSequenceKeypoint.new(1, 1) })
	e.Drag = 0.4
	e.WindAffectsDrag = true -- fog drifts with the map's wind
	e.Parent = p
end

-- Terrain --------------------------------------------------------------------------------------

local terrain = Workspace.Terrain

function MapKit.clearTerrain()
	terrain:Clear()
	pcall(function()
		terrain.Decoration = true -- animated grass blades on Grass terrain
	end)
	terrain.WaterColor = Color3.fromRGB(38, 56, 60)
	terrain.WaterTransparency = 0.55
	terrain.WaterReflectance = 0.6
	terrain.WaterWaveSize = 0.08
	terrain.WaterWaveSpeed = 6
end

-- A flat slab of terrain material whose top surface is at y = top.
function MapKit.slab(x0, z0, x1, z1, material, top, depth)
	depth = depth or 8
	local cx, cz = (x0 + x1) / 2, (z0 + z1) / 2
	terrain:FillBlock(CFrame.new(cx, top - depth / 2, cz), Vector3.new(math.abs(x1 - x0), depth, math.abs(z1 - z0)), material)
end

-- Removes terrain above height y in a rectangle (carving dips, clearing for water).
function MapKit.clearAbove(x0, z0, x1, z1, y)
	local top = 60
	terrain:FillBlock(CFrame.new((x0 + x1) / 2, (y + top) / 2, (z0 + z1) / 2), Vector3.new(math.abs(x1 - x0), top - y, math.abs(z1 - z0)), Enum.Material.Air)
end

function MapKit.water(x0, z0, x1, z1, surface, depth)
	local cx, cz = (x0 + x1) / 2, (z0 + z1) / 2
	terrain:FillBlock(CFrame.new(cx, surface - depth / 2, cz), Vector3.new(math.abs(x1 - x0), depth, math.abs(z1 - z0)), Enum.Material.Water)
end

-- Rolling ground: columns of terrain following heightFn(x, z), material by materialFn.
function MapKit.heightfield(x0, z0, x1, z1, step, heightFn, materialFn)
	for x = x0, x1 - step, step do
		for z = z0, z1 - step, step do
			local h = heightFn(x + step / 2, z + step / 2)
			terrain:FillBlock(CFrame.new(x + step / 2, (h - 12) / 2, z + step / 2), Vector3.new(step, h + 12, step), materialFn(x, z, h))
		end
	end
end

-- Surface height at (x, z) (terrain or parts), for placing things on hills.
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Include
groundParams.IgnoreWater = true
function MapKit.ground(x, z, include)
	groundParams.FilterDescendantsInstances = include or { terrain }
	-- walk down through every surface (roofs, ceilings, floors, props) to the terrain, then
	-- pick the lowest non-prop surface that sits close to the terrain (a floor), else terrain
	local origin = Vector3.new(x, 300, z)
	local surfaces = {}
	local terrainY = nil
	for _ = 1, 48 do -- buildings stack many surfaces (roof, ceiling, shelves, lamps) above the floor
		local hit = Workspace:Raycast(origin, Vector3.new(0, -600, 0), groundParams)
		if not hit then
			break
		end
		if hit.Instance == terrain then
			terrainY = hit.Position.Y
			break
		end
		local inProp = hit.Instance.Parent and hit.Instance.Parent:IsA("Model")
		if not inProp and hit.Normal.Y > 0.7 then
			table.insert(surfaces, hit.Position.Y)
		end
		origin = hit.Position - Vector3.new(0, 0.05, 0)
	end
	local base = terrainY or 0
	local best = base
	for _, y in surfaces do
		if y - base < 2.5 and y > best then
			best = y
		end
	end
	return best
end

function MapKit.onGround(v, include)
	return Vector3.new(v.X, MapKit.ground(v.X, v.Z, include), v.Z)
end

-- Props ------------------------------------------------------------------------------------------

local FALLBACK = {}
function FALLBACK.rock(parent, cf, scale)
	block(parent, Vector3.new(4, 2.6, 3.4) * scale, cf * CFrame.new(0, 1.1 * scale, 0) * CFrame.Angles(0.2, 0.7, 0.1), Color3.fromRGB(104, 102, 98), Enum.Material.Rock)
end
function FALLBACK.tree(parent, cf, scale)
	block(parent, Vector3.new(1.2, 14, 1.2) * scale, cf * CFrame.new(0, 7 * scale, 0), Color3.fromRGB(70, 54, 42), Enum.Material.Wood)
	block(parent, Vector3.new(9, 12, 9) * scale, cf * CFrame.new(0, 15 * scale, 0), Color3.fromRGB(40, 56, 36), Enum.Material.LeafyGrass, { Shape = Enum.PartType.Ball })
end
function FALLBACK.car(parent, cf, scale)
	block(parent, Vector3.new(4, 1.4, 9) * scale, cf * CFrame.new(0, 1.3 * scale, 0), Color3.fromRGB(90, 96, 98), Enum.Material.Metal)
	block(parent, Vector3.new(3.6, 1.2, 4.6) * scale, cf * CFrame.new(0, 2.6 * scale, 0.4), Color3.fromRGB(40, 44, 46), Enum.Material.Glass)
end
function FALLBACK.bush(parent, cf, scale)
	block(parent, Vector3.new(3, 2.4, 3) * scale, cf * CFrame.new(0, 1.2 * scale, 0), Color3.fromRGB(46, 62, 40), Enum.Material.LeafyGrass, { Shape = Enum.PartType.Ball, CanCollide = false })
end

local KIND = {
	Rock_1 = "rock", Rock_2 = "rock", Boulder_1 = "rock",
	Pine_1 = "tree", Pine_2 = "tree", DeadTree_1 = "tree",
	CarSedan_1 = "car", CarSedan_2 = "car", CarVan_1 = "car",
	Bush_1 = "bush", Bush_2 = "bush",
}

-- Place a sculpted prop (or a simple stand-in). cf = ground point + facing.
function MapKit.prop(parent, name, cf, scale)
	scale = scale or 1
	if Assets and Assets.hasKit(name) then
		local m = MeshKit.buildProp(Assets.meta(name), Assets.part, cf, scale, parent, name)
		if m then
			m:SetAttribute("Prop", KIND[name] or "decor")
			if KIND[name] == "car" or KIND[name] == "rock" then
				for _, p in m:GetChildren() do
					if p:IsA("BasePart") then
						p.CanCollide = true
					end
				end
			else
				for _, p in m:GetChildren() do
					if p:IsA("BasePart") then
						p.CanCollide = KIND[name] == "tree" and p.Name == "Trunk"
					end
				end
			end
			return m
		end
	end
	local fb = FALLBACK[KIND[name] or ""]
	if fb then
		fb(parent, cf, scale)
	end
	return nil
end

-- Grass ------------------------------------------------------------------------------------------

local function grassMesh(parent, name, cf, scale)
	if Assets and Assets.hasKit(name) then
		local m = MeshKit.buildProp(Assets.meta(name), Assets.part, cf, scale, parent, name)
		if m then
			for _, p in m:GetChildren() do
				if p:IsA("BasePart") then
					p.CanCollide = false
					p.CanQuery = false
					p.CanTouch = false
					p.CastShadow = false
				end
			end
			return true
		end
	end
	return false
end

-- A patch of tall grass you can hide in (stealth volume + clumps).
-- groundFn(x, z) gives the height (default flat 0).
function MapKit.tallGrass(parent, center, size, rng, groundFn, density)
	-- on hills the hiding volume follows the ground at the patch centre and is taller
	local gy = groundFn and groundFn(center.X, center.Z) or center.Y
	local vh = groundFn and 22 or 7
	MapKit.volume(parent, Vector3.new(size.X, vh, size.Z), Vector3.new(center.X, gy + (groundFn and 4 or 3.5), center.Z), "TallGrass")
	local count = math.floor(size.X * size.Z / 7 * (density or 1))
	for _ = 1, count do
		local x = center.X + rng:NextNumber(-size.X / 2, size.X / 2)
		local z = center.Z + rng:NextNumber(-size.Z / 2, size.Z / 2)
		local y = groundFn and groundFn(x, z) or center.Y
		local cf = CFrame.new(x, y, z) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0)
		if not grassMesh(parent, "GrassTall_" .. rng:NextInteger(1, 3), cf, rng:NextNumber(0.85, 1.2)) then
			local h = rng:NextNumber(3.6, 5.6)
			block(parent, Vector3.new(0.22, h, 0.22), CFrame.new(x, y + h / 2, z) * CFrame.Angles(rng:NextNumber(-0.18, 0.18), rng:NextNumber(0, 6.28), rng:NextNumber(-0.18, 0.18)), C.reed, Enum.Material.Grass, {
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
				CastShadow = false,
			})
		end
	end
end

-- Short grass and ferns sprinkled over an area (decorative only).
function MapKit.shortGrass(parent, center, size, count, rng, groundFn, ferns)
	if not (Assets and Assets.hasKit("GrassShort_1")) then
		return
	end
	for _ = 1, count do
		local x = center.X + rng:NextNumber(-size.X / 2, size.X / 2)
		local z = center.Z + rng:NextNumber(-size.Z / 2, size.Z / 2)
		local y = groundFn and groundFn(x, z) or center.Y
		local name = (ferns and rng:NextNumber() < 0.3) and "Fern_1" or ("GrassShort_" .. rng:NextInteger(1, 2))
		grassMesh(parent, name, CFrame.new(x, y, z) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0), rng:NextNumber(0.8, 1.3))
	end
end

-- Houses -------------------------------------------------------------------------------------------

-- A house. origin = front-door ground point, facing = yaw (radians,
-- front faces -Z when 0). Every house is generated from the rng, so no two match:
--   size, roof (gable / side gable / hip / flat / saltbox), a painted upper storey, porch
--   (small / veranda / steps), door position, paint + trim + shutter colours, siding material,
--   flower boxes, chimney, picket fence, and one of three interior layouts with furniture.
-- style: { w, d, h, color, cabin = true (log cabin palette, smaller), roof = kind,
--          kind = "house" | "shop" | "apartment" | "garage" | "chapel" | "cabin", kinds = { weighted list } }
-- Returns { doorways = {...}, containers = {...}, loot = {...} }.
local PAINT = {
	{ 142, 186, 220 }, { 150, 206, 170 }, { 240, 214, 130 }, { 232, 140, 120 }, { 184, 164, 216 },
	{ 238, 228, 202 }, { 164, 188, 140 }, { 120, 172, 196 }, { 244, 184, 152 }, { 226, 232, 236 },
}
local CABIN = { { 150, 104, 66 }, { 128, 88, 58 }, { 170, 120, 76 }, { 116, 82, 60 } }
local ROOFS = { { 58, 62, 70 }, { 184, 92, 64 }, { 70, 92, 124 }, { 62, 104, 74 }, { 112, 78, 58 }, { 150, 60, 54 } }
local TRIMS = { { 250, 248, 242 }, { 242, 238, 228 }, { 64, 76, 94 } }
local ACCENTS = { { 40, 92, 146 }, { 176, 52, 52 }, { 50, 112, 80 }, { 236, 196, 76 }, { 96, 64, 128 }, { 40, 40, 44 } }
local FLOWERS = { { 240, 90, 110 }, { 255, 200, 60 }, { 250, 250, 250 }, { 180, 110, 230 }, { 255, 140, 60 } }

local function rgbOf(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

function MapKit.house(parent, origin, yaw, rng, style)
	style = style or {}
	local M = Enum.Material
	local function pick(list)
		return list[rng:NextInteger(1, #list)]
	end
	local kind = style.kind or (style.cabin and "cabin") or (style.kinds and pick(style.kinds)) or "house"
	local cabin = kind == "cabin"
	local W = style.w or (cabin and rng:NextInteger(16, 20) or rng:NextInteger(20, 30))
	local D = style.d or (cabin and rng:NextInteger(14, 18) or rng:NextInteger(18, 24))
	local H = style.h or (cabin and 9 or rng:NextInteger(10, 12))
	if kind == "shop" then
		W, D, H = style.w or rng:NextInteger(24, 30), style.d or rng:NextInteger(18, 22), style.h or 11
	elseif kind == "apartment" then
		W, D, H = style.w or rng:NextInteger(26, 32), style.d or rng:NextInteger(20, 24), style.h or 10
	elseif kind == "garage" then
		W, D, H = style.w or rng:NextInteger(26, 32), style.d or rng:NextInteger(22, 28), style.h or 12
	elseif kind == "chapel" then
		W, D, H = style.w or 22, style.d or 30, style.h or 14
	end
	local cf = CFrame.new(origin) * CFrame.Angles(0, yaw, 0)
	local function at(x, y, z)
		return cf * CFrame.new(x, y, z)
	end
	local siding = style.color or rgbOf(cabin and pick(CABIN) or pick(PAINT))
	local trim = rgbOf(cabin and { 236, 226, 200 } or pick(TRIMS))
	local accent = rgbOf(pick(ACCENTS))
	local roofColor = rgbOf(pick(ROOFS))
	local wallMat = cabin and M.Wood or (rng:NextNumber() < 0.7 and M.WoodPlanks or (rng:NextNumber() < 0.6 and M.Brick or M.SmoothPlastic))
	if wallMat == M.Brick and not style.color then
		siding = rgbOf(pick({ { 176, 82, 64 }, { 160, 100, 80 }, { 196, 150, 120 } }))
	end
	local roofKind = style.roof or (cabin and pick({ "gable", "sideGable" }) or pick({ "gable", "gable", "sideGable", "crossGable", "flat", "saltbox" }))
	local upper = not cabin and roofKind ~= "flat" and rng:NextNumber() < 0.35
	local porchKind = cabin and "wide" or pick({ "small", "wide", "wide", "steps" })
	local doorW = 5
	local doorX = pick({ 0, 0, -W * 0.22, W * 0.22 })
	local floors = 0 -- extra storeys above the ground floor (apartments)
	if kind == "shop" then
		roofKind, upper, porchKind, doorX = "flat", false, "steps", pick({ -W * 0.2, W * 0.2 })
		siding = rgbOf(pick({ { 236, 214, 170 }, { 170, 210, 196 }, { 240, 170, 150 }, { 190, 200, 236 }, { 250, 226, 140 } }))
	elseif kind == "apartment" then
		roofKind, upper, porchKind, doorX, floors = "flat", false, "steps", 0, rng:NextInteger(2, 3)
		wallMat = rng:NextNumber() < 0.6 and M.Brick or M.SmoothPlastic
		siding = wallMat == M.Brick and rgbOf(pick({ { 176, 82, 64 }, { 200, 132, 100 }, { 150, 96, 80 } })) or rgbOf(pick({ { 226, 214, 190 }, { 190, 206, 214 }, { 232, 196, 170 } }))
	elseif kind == "garage" then
		roofKind, upper, porchKind, doorX = pick({ "flat", "saltbox" }), false, "steps", W * 0.3
		wallMat = M.Concrete
		siding = rgbOf(pick({ { 190, 192, 196 }, { 120, 150, 176 }, { 220, 180, 90 }, { 150, 170, 150 } }))
	elseif kind == "chapel" then
		roofKind, upper, porchKind, doorX = "gable", false, "steps", 0
		doorW = 6
		wallMat = M.SmoothPlastic
		siding = rgbOf(pick({ { 244, 240, 232 }, { 236, 226, 206 }, { 214, 226, 236 } }))
	end
	local t = 1
	local function wall(size, pos, color, mat)
		return block(parent, size, at(pos.X, pos.Y, pos.Z), color or siding, mat or wallMat)
	end

	-- floor
	block(parent, Vector3.new(W, 1, D), at(0, 0.5, D / 2), Color3.fromRGB(150, 112, 76), M.WoodPlanks)

	-- walls: front with the door, back, sides; corner trim boards
	local leftEnd, rightStart = doorX - doorW / 2, doorX + doorW / 2
	wall(Vector3.new(leftEnd + W / 2, H, t), Vector3.new((-W / 2 + leftEnd) / 2, H / 2, 0))
	wall(Vector3.new(W / 2 - rightStart, H, t), Vector3.new((rightStart + W / 2) / 2, H / 2, 0))
	wall(Vector3.new(doorW, H - 8, t), Vector3.new(doorX, 8 + (H - 8) / 2, 0))
	block(parent, Vector3.new(doorW + 0.8, 0.5, 1.2), at(doorX, 8.1, -0.1), trim, M.Wood) -- door head
	wall(Vector3.new(W, H, t), Vector3.new(0, H / 2, D))
	wall(Vector3.new(t, H, D), Vector3.new(-W / 2, H / 2, D / 2))
	wall(Vector3.new(t, H, D), Vector3.new(W / 2, H / 2, D / 2))
	for _, sx in { -1, 1 } do
		for _, sz in { 0, D } do
			block(parent, Vector3.new(1.3, H, 1.3), at(sx * W / 2, H / 2, sz), trim, M.Wood)
		end
	end

	-- windows: glass, trim, shutters, flower boxes
	local boxes = not cabin and rng:NextNumber() < 0.55
	local function window(x, y, z, sideways)
		local glass = sideways and Vector3.new(0.3, 3.4, 3.6) or Vector3.new(3.6, 3.4, 0.3)
		block(parent, glass, at(x, y, z), Color3.fromRGB(70, 110, 140), M.Glass, { Transparency = 0.3, Reflectance = 0.15 })
		local frame = sideways and Vector3.new(0.5, 3.9, 4.2) or Vector3.new(4.2, 3.9, 0.5)
		block(parent, frame * Vector3.new(sideways and 1 or 1, 0.12, sideways and 1 or 1), at(x, y + 1.95, z), trim, M.Wood)
		block(parent, frame * Vector3.new(1, 0.12, 1), at(x, y - 1.95, z), trim, M.Wood)
		if not cabin then
			for _, s in { -1, 1 } do
				local off = s * 2.5
				block(parent, sideways and Vector3.new(0.25, 3.6, 1.2) or Vector3.new(1.2, 3.6, 0.25), at(x + (sideways and 0 or off), y, z + (sideways and off or 0)), accent, M.WoodPlanks)
			end
		end
		if boxes then
			local out = sideways and Vector3.new(x > 0 and 0.5 or -0.5, 0, 0) or Vector3.new(0, 0, -0.5)
			local base = Vector3.new(x, y - 2.3, z) + out
			block(parent, sideways and Vector3.new(0.9, 0.7, 3.6) or Vector3.new(3.6, 0.7, 0.9), at(base.X, base.Y, base.Z), Color3.fromRGB(120, 84, 56), M.Wood)
			for i = -1, 1 do
				local p = base + (sideways and Vector3.new(0, 0.55, i * 1.1) or Vector3.new(i * 1.1, 0.55, 0))
				block(parent, Vector3.new(0.75, 0.75, 0.75), at(p.X, p.Y, p.Z), rgbOf(pick(FLOWERS)), M.SmoothPlastic, { Shape = Enum.PartType.Ball, CanCollide = false })
			end
		end
	end
	for _, wx in { -W * 0.32, 0, W * 0.32 } do
		if kind ~= "garage" and math.abs(wx - doorX) > doorW / 2 + 2.6 and math.abs(wx) < W / 2 - 2.6 then
			window(wx, 5.2, -0.6, false)
		end
	end
	for _, sz in { D * 0.3, D * 0.72 } do
		for _, sx in { -1, 1 } do
			window(sx * (W / 2 + 0.6), 5.2, sz, true)
		end
	end
	for _, wx in { -W * 0.3, W * 0.3 } do
		window(wx, 5.2, D + 0.6, false)
	end

	-- porch
	if porchKind == "small" then
		block(parent, Vector3.new(10, 0.8, 5), at(doorX, 0.4, -2.5), Color3.fromRGB(160, 120, 84), M.WoodPlanks)
		for _, sx in { -4.5, 4.5 } do
			block(parent, Vector3.new(0.5, H - 1, 0.5), at(doorX + sx, H / 2, -4.6), trim, M.Wood)
		end
		block(parent, Vector3.new(11, 0.5, 6), at(doorX, H - 0.6, -2.4), roofColor, M.RoofShingles)
	elseif porchKind == "wide" then
		block(parent, Vector3.new(W, 0.8, 6), at(0, 0.4, -3), Color3.fromRGB(160, 120, 84), M.WoodPlanks)
		local n = math.max(2, math.floor(W / 6))
		for i = 0, n do
			local px = -W / 2 + 0.4 + (W - 0.8) * i / n
			block(parent, Vector3.new(0.5, H - 1, 0.5), at(px, H / 2, -5.7), trim, M.Wood)
			if i < n then
				local mid = px + (W - 0.8) / n / 2
				if math.abs(mid - doorX) > 3.5 then -- railing, open at the steps
					block(parent, Vector3.new((W - 0.8) / n, 0.25, 0.25), at(mid, 3.2, -5.7), trim, M.Wood)
					block(parent, Vector3.new((W - 0.8) / n, 0.25, 0.25), at(mid, 1.4, -5.7), trim, M.Wood)
				end
			end
		end
		block(parent, Vector3.new(W + 1, 0.4, 6.6), at(0, H - 0.5, -3), roofColor, M.RoofShingles)
	else
		block(parent, Vector3.new(6, 0.5, 2), at(doorX, 0.25, -1.2), Color3.fromRGB(170, 166, 156), M.Concrete)
	end

	-- upper storey (outside only; you live downstairs)
	block(parent, Vector3.new(W, 1, D), at(0, H + 0.5, D / 2), siding, wallMat) -- ceiling
	local topY = H + 1
	if upper then
		local H2 = 8
		wall(Vector3.new(W, H2, t), Vector3.new(0, topY + H2 / 2, 0))
		wall(Vector3.new(W, H2, t), Vector3.new(0, topY + H2 / 2, D))
		wall(Vector3.new(t, H2, D), Vector3.new(-W / 2, topY + H2 / 2, D / 2))
		wall(Vector3.new(t, H2, D), Vector3.new(W / 2, topY + H2 / 2, D / 2))
		block(parent, Vector3.new(W + 0.6, 0.6, 0.6), at(0, topY, -0.3), trim, M.Wood) -- belt course
		for _, wx in { -W * 0.3, 0, W * 0.3 } do
			window(wx, topY + 4, -0.6, false)
		end
		block(parent, Vector3.new(W, 1, D), at(0, topY + H2 + 0.5, D / 2), siding, wallMat)
		topY += H2 + 1
	end
	-- apartments: stacked floors with a window grid, balconies and an entrance canopy
	for fl = 1, floors do
		local H2 = 9
		wall(Vector3.new(W, H2, t), Vector3.new(0, topY + H2 / 2, 0))
		wall(Vector3.new(W, H2, t), Vector3.new(0, topY + H2 / 2, D))
		wall(Vector3.new(t, H2, D), Vector3.new(-W / 2, topY + H2 / 2, D / 2))
		wall(Vector3.new(t, H2, D), Vector3.new(W / 2, topY + H2 / 2, D / 2))
		block(parent, Vector3.new(W + 0.8, 0.7, 0.7), at(0, topY + 0.1, -0.35), trim, M.Concrete) -- floor line
		local n = math.max(3, math.floor(W / 7))
		for i = 0, n - 1 do
			local wx = -W / 2 + (i + 0.5) * W / n
			window(wx, topY + 4.8, -0.6, false)
			if i % 2 == 0 then -- balcony
				block(parent, Vector3.new(4.6, 0.4, 2.4), at(wx, topY + 1, -1.4), Color3.fromRGB(176, 172, 164), M.Concrete)
				block(parent, Vector3.new(4.6, 0.25, 0.2), at(wx, topY + 3.2, -2.5), accent, M.Metal)
				for _, bx in { -2.2, 2.2 } do
					block(parent, Vector3.new(0.2, 2.3, 0.2), at(wx + bx, topY + 2.1, -2.5), accent, M.Metal)
				end
			end
		end
		block(parent, Vector3.new(W, 1, D), at(0, topY + H2 + 0.5, D / 2), siding, wallMat)
		topY += H2 + 1
	end
	if kind == "apartment" then
		block(parent, Vector3.new(8, 0.5, 5), at(doorX, 9.2, -3), accent, M.Metal) -- entrance canopy
		for _, sx in { -3.6, 3.6 } do
			block(parent, Vector3.new(0.3, 9, 0.3), at(doorX + sx, 4.5, -5.3), accent, M.Metal)
		end
	elseif kind == "shop" then
		-- striped awning over the whole front, big signboard, window displays
		local stripe = { rgbOf(pick(ACCENTS)), Color3.fromRGB(250, 248, 242) }
		for i = 0, 9 do
			block(parent, Vector3.new(W / 10, 0.3, 4.4), at(-W / 2 + (i + 0.5) * W / 10, 8.6 - (i % 2) * 0.01, -2.4) * CFrame.Angles(0.18, 0, 0), stripe[i % 2 + 1], M.Fabric, { CanCollide = false })
		end
		local sign = block(parent, Vector3.new(math.min(W - 4, 16), 2.4, 0.4), at(0, H + 1.4, -0.4), Color3.fromRGB(34, 42, 54), M.SmoothPlastic)
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 40
		gui.Parent = sign
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.Oswald
		label.TextScaled = true
		label.Text = pick({ "BAKERY", "HARDWARE", "CORNER STORE", "CAFE", "BARBER", "GROCER", "BOOKS & TEA", "TACKLE SHOP" })
		label.TextColor3 = Color3.fromRGB(255, 214, 110)
		label.Parent = gui
		for _, bx in { -W * 0.3, W * 0.3 } do -- barrels / crates out front
			block(parent, Vector3.new(2, 2.4, 2), at(bx, 1.2, -6), Color3.fromRGB(150, 104, 66), M.WoodPlanks)
		end
	elseif kind == "garage" then
		-- a roll-up door beside the walk-in door, a car-lift pit, tyres, drums and a red tool chest
		local rx = -W * 0.2
		block(parent, Vector3.new(11, 9, 0.5), at(rx, 4.6, -0.6), Color3.fromRGB(196, 198, 202), M.Metal)
		for i = 1, 8 do
			block(parent, Vector3.new(11, 0.12, 0.2), at(rx, 0.6 + i * 1.0, -0.95), Color3.fromRGB(150, 152, 158), M.Metal, { CanCollide = false })
		end
		block(parent, Vector3.new(12, 0.7, 0.8), at(rx, 9.5, -0.6), accent, M.SmoothPlastic)
		for i = 0, 3 do
			block(parent, Vector3.new(2.2, 1, 2.2), at(W * 0.42 - (i % 2) * 0.2, 0.55 + math.floor(i / 2) * 1, D * 0.22), Color3.fromRGB(34, 34, 36), M.Rubber, { Shape = Enum.PartType.Cylinder, CFrame = at(W * 0.42 - (i % 2) * 0.2, 0.55 + math.floor(i / 2) * 1, D * 0.22) * CFrame.Angles(0, 0, math.pi / 2) })
		end
		block(parent, Vector3.new(2, 3, 2), at(-W * 0.4, 1.5, D * 0.8), Color3.fromRGB(200, 60, 40), M.Metal, { Shape = Enum.PartType.Cylinder, CFrame = at(-W * 0.4, 1.5, D * 0.8) * CFrame.Angles(0, 0, math.pi / 2) })
		block(parent, Vector3.new(3.4, 4, 1.8), at(W * 0.1, 2, D * 0.9), Color3.fromRGB(196, 50, 42), M.Metal)
	elseif kind == "chapel" then
		-- bell tower over the front: four walls, a pyramid roof, a cross, coloured glass
		local tw, th = 8, 12
		local ty = topY
		for _, sd in { { 0, -tw / 2, tw, 0.8 }, { 0, tw / 2, tw, 0.8 } } do
			block(parent, Vector3.new(sd[3], th, sd[4]), at(sd[1], ty + th / 2, 2 + sd[2]), siding, wallMat)
		end
		for _, sx in { -tw / 2, tw / 2 } do
			block(parent, Vector3.new(0.8, th, tw), at(sx, ty + th / 2, 2), siding, wallMat)
		end
		block(parent, Vector3.new(tw + 0.6, 0.6, tw + 0.6), at(0, ty + th + 0.3, 2), roofColor, M.Concrete)
		for i = 0, 3 do
			local sz = tw - i * 1.6
			block(parent, Vector3.new(sz, 1.5, sz), at(0, ty + th + 1.35 + i * 1.5, 2), roofColor, M.RoofShingles)
		end
		block(parent, Vector3.new(0.4, 3, 0.4), at(0, ty + th + 9, 2), Color3.fromRGB(236, 200, 90), M.Metal)
		block(parent, Vector3.new(1.8, 0.4, 0.4), at(0, ty + th + 9.8, 2), Color3.fromRGB(236, 200, 90), M.Metal)
		local bell = block(parent, Vector3.new(1.6, 1.8, 1.6), at(0, ty + 7, 2), Color3.fromRGB(196, 150, 70), M.Metal, { Shape = Enum.PartType.Ball })
		bell.CanCollide = false
		local glass = { Color3.fromRGB(220, 70, 70), Color3.fromRGB(70, 130, 220), Color3.fromRGB(240, 200, 70) }
		for i = -1, 1 do
			for _, sx in { -1, 1 } do
				block(parent, Vector3.new(0.3, 6, 2.6), at(sx * (W / 2 + 0.4), 7, D * 0.55 + i * 6), glass[i + 2], M.Glass, { Transparency = 0.25 })
			end
		end
		for i = 0, 3 do -- pews
			for _, px in { -W * 0.22, W * 0.22 } do
				block(parent, Vector3.new(W * 0.32, 1.6, 1.2), at(px, 1.8, D * 0.38 + i * 3.4), Color3.fromRGB(120, 84, 56), M.WoodPlanks)
			end
		end
		block(parent, Vector3.new(6, 1.2, 3), at(0, 1.6, D * 0.92), Color3.fromRGB(236, 230, 214), M.SmoothPlastic) -- altar
	end

	-- roof
	local rise = cabin and 6 or rng:NextInteger(5, 8)
	local function wedge(size, c, col, mat)
		return MapKit.wedge(parent, size, c, col or roofColor, mat or M.RoofShingles)
	end
	if roofKind == "gable" or roofKind == "crossGable" then
		-- WedgePart: tall edge at +Z, slope descending to -Z
		wedge(Vector3.new(W + 2, rise, D / 2 + 1), at(0, topY + rise / 2, D * 0.25 - 0.5))
		wedge(Vector3.new(W + 2, rise, D / 2 + 1), at(0, topY + rise / 2, D * 0.75 + 0.5) * CFrame.Angles(0, math.pi, 0))
		for _, s in { -1, 1 } do -- gable ends
			wedge(Vector3.new(t, rise, D / 2), at(s * (W / 2), topY + rise / 2, D * 0.25), siding, wallMat)
			wedge(Vector3.new(t, rise, D / 2), at(s * (W / 2), topY + rise / 2, D * 0.75) * CFrame.Angles(0, math.pi, 0), siding, wallMat)
		end
		if roofKind == "crossGable" then
			-- a front-facing gable wing over one side of the front, ridge running front to back
			local cw = math.floor(W * 0.42)
			local cx = (doorX <= 0 and 1 or -1) * (W / 2 - cw / 2)
			local len = D / 2 + 1
			for _, s in { -1, 1 } do
				local rot = CFrame.Angles(0, s < 0 and math.pi / 2 or -math.pi / 2, 0)
				wedge(Vector3.new(len, rise + 0.4, cw / 2 + 0.6), at(cx + s * (cw / 4 + 0.3), topY + (rise + 0.4) / 2, len / 2 - 1) * rot)
				wedge(Vector3.new(t, rise, cw / 2), at(cx + s * cw / 4, topY + rise / 2, -0.2) * rot, siding, wallMat)
			end
		end
	elseif roofKind == "sideGable" then
		for _, s in { -1, 1 } do
			wedge(Vector3.new(D + 2, rise, W / 2 + 1), at(s * (W / 4 + 0.5), topY + rise / 2, D / 2) * CFrame.Angles(0, s < 0 and math.pi / 2 or -math.pi / 2, 0))
			-- gable ends (front and back)
			wedge(Vector3.new(t, rise, W / 2), at(s * W / 4, topY + rise / 2, 0) * CFrame.Angles(0, s < 0 and math.pi / 2 or -math.pi / 2, 0), siding, wallMat)
			wedge(Vector3.new(t, rise, W / 2), at(s * W / 4, topY + rise / 2, D) * CFrame.Angles(0, s < 0 and math.pi / 2 or -math.pi / 2, 0), siding, wallMat)
		end
	elseif roofKind == "saltbox" then
		wedge(Vector3.new(W + 2, rise, D + 2), at(0, topY + rise / 2, D / 2))
		for _, s in { -1, 1 } do
			wedge(Vector3.new(t, rise, D), at(s * (W / 2), topY + rise / 2, D / 2), siding, wallMat)
		end
	else -- flat with a parapet and a rooftop tank
		for _, s in { -1, 1 } do
			block(parent, Vector3.new(W + 1, 1.4, 0.6), at(0, topY + 0.7, s < 0 and -0.2 or D + 0.2), trim, M.Concrete)
			block(parent, Vector3.new(0.6, 1.4, D + 1), at(s * (W / 2 + 0.2), topY + 0.7, D / 2), trim, M.Concrete)
		end
		block(parent, Vector3.new(3, 3, 3), at(W * 0.25, topY + 1.5, D * 0.65), Color3.fromRGB(150, 156, 160), M.Metal, { Shape = Enum.PartType.Cylinder, CFrame = at(W * 0.25, topY + 1.5, D * 0.65) * CFrame.Angles(0, 0, math.pi / 2) })
	end
	if roofKind ~= "flat" and rng:NextNumber() < 0.55 then
		block(parent, Vector3.new(2, rise + 3, 2), at(W * 0.3, topY + (rise + 3) / 2, D * 0.7), Color3.fromRGB(150, 70, 56), M.Brick)
	end

	-- front yard: picket fence with a gate, flowers by the steps
	if not cabin and rng:NextNumber() < 0.45 then
		local fz = -10
		local fenceColor = rgbOf(pick({ { 250, 250, 246 }, { 250, 250, 246 }, { 176, 140, 100 } }))
		for x = -W / 2, math.min(W / 2, 7), 1 do
			if math.abs(x - doorX) > 2.4 then
				block(parent, Vector3.new(0.3, 2.6, 0.2), at(x, 1.3, fz), fenceColor, M.Wood)
			end
		end
		for _, y in { 0.9, 2.0 } do
			local a, b = -W / 2, doorX - 2.4
			if b > a then
				block(parent, Vector3.new(b - a, 0.25, 0.15), at((a + b) / 2, y, fz + 0.18), fenceColor, M.Wood)
			end
			a, b = doorX + 2.4, math.min(W / 2, 7)
			if b > a then
				block(parent, Vector3.new(b - a, 0.25, 0.15), at((a + b) / 2, y, fz + 0.18), fenceColor, M.Wood)
			end
		end
	end
	for _, sx in { -1, 1 } do
		local bx = doorX + sx * 4
		if math.abs(bx) < W / 2 - 1 and porchKind ~= "wide" then
			for i = 1, 4 do
				block(parent, Vector3.new(0.7, 0.7, 0.7), at(bx + rng:NextNumber(-1, 1), 0.4, -1.6 - rng:NextNumber(0, 1)), rgbOf(pick(FLOWERS)), M.SmoothPlastic, { Shape = Enum.PartType.Ball, CanCollide = false })
				assert(i)
			end
		end
	end

	-- interior: one of three layouts, painted walls and furniture
	local inner = rgbOf(pick({ { 236, 230, 214 }, { 214, 226, 220 }, { 240, 224, 200 }, { 222, 214, 232 } }))
	local layout = rng:NextInteger(1, 3)
	if layout == 1 then -- living room in front, two back rooms
		wall(Vector3.new(W * 0.35, H, t), Vector3.new(-W * 0.325, H / 2, D * 0.55), inner, M.SmoothPlastic)
		wall(Vector3.new(W * 0.35, H, t), Vector3.new(W * 0.325, H / 2, D * 0.55), inner, M.SmoothPlastic)
	elseif layout == 2 then -- left / right rooms with a doorway between
		wall(Vector3.new(t, H, D * 0.38), Vector3.new(W * 0.1, H / 2, D * 0.19 + 0.5), inner, M.SmoothPlastic)
		wall(Vector3.new(t, H, D * 0.3), Vector3.new(W * 0.1, H / 2, D * 0.85 - 0.5), inner, M.SmoothPlastic)
	end -- layout 3: open plan
	block(parent, Vector3.new(W * 0.4, 0.06, D * 0.3), at(0, 1.03, D * 0.3), rgbOf(pick(ACCENTS)), M.Fabric, { CanCollide = false }) -- rug
	block(parent, Vector3.new(6, 2.4, 3), at(-W * 0.3, 1.7, D * 0.3), rgbOf(pick({ { 70, 110, 150 }, { 160, 70, 60 }, { 90, 130, 90 }, { 180, 150, 100 } })), M.Fabric) -- sofa
	block(parent, Vector3.new(5, 3, 2.5), at(W * 0.3, 2, D * 0.85), Color3.fromRGB(200, 196, 186), M.Wood) -- counter
	block(parent, Vector3.new(3, 2.2, 2), at(W * 0.25, 1.6, D * 0.72), Color3.fromRGB(150, 108, 72), M.Wood) -- table
	block(parent, Vector3.new(1, 5, 4), at(W / 2 - 1.1, 3.5, D * 0.75), Color3.fromRGB(120, 86, 60), M.Wood) -- bookshelf
	-- a lamp inside
	MapKit.bulb(parent, at(0, H - 1.5, D * 0.3).Position, 16)
	local function world(x, z)
		return at(x, 0, z).Position
	end
	return {
		doorways = { { hinge = world(doorX - doorW / 2, -0.1), width = doorW, dir = cf.RightVector } },
		-- one container per house, against a wall, of a random kind
		containers = {
			rng:NextNumber() < 0.5 and { pos = world(-W * 0.38, D * 0.85), type = pick({ "Drawer", "Drawer", "AmmoCrate" }), yaw = math.deg(yaw) + 180 }
				or { pos = world(W * 0.4, D * 0.4), type = pick({ "Locker", "Toolbox", "Drawer" }), yaw = math.deg(yaw) - 90 },
		},
		loot = { world(0, D * 0.3), world(-W * 0.25, D * 0.75), world(W * 0.2, D * 0.25) },
	}
end

-- World edge ------------------------------------------------------------------------------------

-- The sea beyond the flood walls: every map is a pocket of land held behind them.
-- style "forest" adds distant wooded islands and headlands rising out of the water.
function MapKit.outskirts(style)
	local M = Enum.Material
	local R, E = 460, 123
	for _, r in { { -R, -R, R, -E }, { -R, E, R, R }, { -R, -E, -E, E }, { E, -E, R, E } } do
		MapKit.clearAbove(r[1], r[2], r[3], r[4], -10)
		MapKit.slab(r[1], r[2], r[3], r[4], M.Sand, -10, 8)
		MapKit.water(r[1], r[2], r[3], r[4], 0.4, 10.4)
	end
	if style == "forest" or style == "suburb" then
		for i = 1, 18 do
			local a = i / 18 * math.pi * 2 + 0.3
			local d = 230 + (i % 3) * 55
			terrain:FillBall(Vector3.new(math.cos(a) * d, -26, math.sin(a) * d), 48 + (i % 4) * 14, style == "forest" and M.Grass or M.Rock)
		end
	end
end

-- Tall concrete flood walls around the whole map, standing in the sea, with buttresses, a
-- walkway cap and a few work lights. groundFn(x, z) gives the land height (hills).
function MapKit.floodWall(parent, groundFn, opts)
	opts = opts or {}
	local H = opts.height or 16
	local E = 120
	local concrete = opts.color or Color3.fromRGB(118, 116, 110)
	local stain = Color3.fromRGB(86, 84, 78)
	local M = Enum.Material
	local seg = 12
	for edge = 1, 4 do
		local i = 0
		for t = -E - seg / 2, E + seg / 2, seg do
			i += 1
			local x, z, along
			if edge == 1 then
				x, z, along = t, E + 2, "x"
			elseif edge == 2 then
				x, z, along = t, -E - 2, "x"
			elseif edge == 3 then
				x, z, along = E + 2, t, "z"
			else
				x, z, along = -E - 2, t, "z"
			end
			local inX, inZ = x * 0.94, z * 0.94 -- sample the land just inside, not the sea
			local g = groundFn and groundFn(inX, inZ) or 0
			local base = math.min(g, 0) - 12
			local top = g + H
			local size = along == "x" and Vector3.new(seg + 0.4, top - base, 4) or Vector3.new(4, top - base, seg + 0.4)
			block(parent, size, Vector3.new(x, (top + base) / 2, z), i % 3 == 0 and stain or concrete, M.Concrete)
			-- walkway cap
			local cap = along == "x" and Vector3.new(seg + 0.4, 1, 6) or Vector3.new(6, 1, seg + 0.4)
			block(parent, cap, Vector3.new(x, top + 0.5, z), Color3.fromRGB(96, 94, 90), M.Concrete)
			-- buttresses on the land side
			if i % 2 == 0 then
				local inward = along == "x" and Vector3.new(0, 0, -math.sign(z) * 3) or Vector3.new(-math.sign(x) * 3, 0, 0)
				local bsize = along == "x" and Vector3.new(2.4, top - g + 2, 3) or Vector3.new(3, top - g + 2, 2.4)
				block(parent, bsize, Vector3.new(x, g + (top - g) / 2 - 1, z) + inward, concrete, M.Concrete)
			end
			-- rust streaks below drainage pipes
			if i % 4 == 1 then
				local face = along == "x" and Vector3.new(0, 0, -math.sign(z) * 2.05) or Vector3.new(-math.sign(x) * 2.05, 0, 0)
				local ssize = along == "x" and Vector3.new(1.2, H * 0.6, 0.1) or Vector3.new(0.1, H * 0.6, 1.2)
				block(parent, ssize, Vector3.new(x, top - H * 0.32, z) + face, Color3.fromRGB(110, 72, 48), M.SmoothPlastic, { Transparency = 0.45, CanCollide = false, CanQuery = false })
			end
			-- a work light every few segments
			if i % 6 == 3 then
				local inward = along == "x" and Vector3.new(0, 0, -math.sign(z) * 3) or Vector3.new(-math.sign(x) * 3, 0, 0)
				local lamp = block(parent, Vector3.new(1, 0.6, 1), Vector3.new(x, top - 1, z) + inward, Color3.fromRGB(255, 214, 160), M.Neon, { CanCollide = false })
				local light = Instance.new("SpotLight")
				light.Face = Enum.NormalId.Bottom
				light.Range = 40
				light.Angle = 70
				light.Brightness = 1.6
				light.Color = Color3.fromRGB(255, 214, 160)
				light.Parent = lamp
			end
		end
	end
end

-- A wall of terrain rock along the map edge (forest ridges). groundFn gives the height.
function MapKit.ridge(groundFn, seed)
	local M = Enum.Material
	local E = 118
	for _, edge in { "N", "S", "E", "W" } do
		for t = -E, E, 6 do
			local x, z = t, t
			if edge == "N" then
				z = E
			elseif edge == "S" then
				z = -E
			elseif edge == "E" then
				x = E
			else
				x = -E
			end
			local g = groundFn and groundFn(x, z) or 0
			local h = 16 + math.noise(t / 23, seed or 1, edge == "N" and 1 or (edge == "S" and 2 or (edge == "E" and 3 or 4))) * 10
			terrain:FillBlock(CFrame.new(x, g + h / 2 - 2, z), Vector3.new(10, h + 4, 10), M.Rock)
		end
	end
end

-- A barricade around the map (suburb): plank walls, corrugated sheets and wrecks at the roads.
function MapKit.barricade(parent, rng, roadHalfWidth)
	local E = 117
	local wood = Color3.fromRGB(104, 86, 66)
	local tin = Color3.fromRGB(110, 104, 92)
	local function sheet(cf, len, h)
		block(parent, Vector3.new(len, h, 0.4), cf * CFrame.new(0, h / 2, 0) * CFrame.Angles(0, 0, math.rad(rng:NextNumber(-3, 3))), rng:NextNumber() < 0.55 and wood or tin, rng:NextNumber() < 0.55 and Enum.Material.WoodPlanks or Enum.Material.CorrodedMetal)
	end
	for _, edge in { 1, 2, 3, 4 } do
		for t = -E, E - 6, 6 do
			local mid = t + 3
			local onRoad = (edge == 3 or edge == 4) and math.abs(mid) < (roadHalfWidth or 13)
			local cf
			if edge == 1 then
				cf = CFrame.new(mid, 0, E)
			elseif edge == 2 then
				cf = CFrame.new(mid, 0, -E)
			elseif edge == 3 then
				cf = CFrame.new(E, 0, mid) * CFrame.Angles(0, math.pi / 2, 0)
			else
				cf = CFrame.new(-E, 0, mid) * CFrame.Angles(0, math.pi / 2, 0)
			end
			if onRoad then
				MapKit.prop(parent, (t % 12 == 0) and "CarVan_1" or "CarSedan_1", cf * CFrame.Angles(0, math.pi / 2 + rng:NextNumber(-0.3, 0.3), 0), 1)
				sheet(cf * CFrame.new(0, 0, 5.2), 6.4, 8)
			else
				sheet(cf, 6.4, rng:NextNumber(10, 13))
				if t % 18 == 0 then
					block(parent, Vector3.new(0.7, 14, 0.7), cf * CFrame.new(-3.2, 7, 0), wood, Enum.Material.Wood)
				end
			end
		end
	end
end

-- Tidy pass (runs after a map is built; the engine map scan found these):
--   * a decorative prop (bush, tree, rock, rubble) lodged in a wall, floor or barricade is removed
--   * a car lodged in geometry is removed too (they're cover, not structure)
--   * a prop hovering over the ground is lowered onto it; one buried deep in a hill is raised
-- Returns counts for the log.
function MapKit.tidy(folder)
	local props = {}
	for _, m in folder:GetDescendants() do
		if m:IsA("Model") and m:GetAttribute("Prop") then
			table.insert(props, m)
		end
	end
	local removed, lowered, raised = 0, 0, 0
	local op = OverlapParams.new()
	op.FilterType = Enum.RaycastFilterType.Exclude
	op.FilterDescendantsInstances = props
	local keep = {}
	for _, m in props do
		local cf, size = m:GetBoundingBox()
		-- its core (60% of its box) must be clear of walls, floors and barricades
		local probe, probeCF = size * 0.6, cf
		local clash = false
		for _, p in Workspace:GetPartBoundsInBox(probeCF, probe, op) do
			if p.CanCollide and p.Transparency < 1 and p.Size.Magnitude > 4 and not p:IsA("Terrain") then
				clash = true
				break
			end
		end
		if clash then
			m:Destroy()
			removed += 1
		else
			table.insert(keep, m)
		end
	end
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.IgnoreWater = true
	local exclude = table.clone(keep)
	for _, v in folder:GetDescendants() do
		if v:IsA("BasePart") and (v.Transparency >= 1 or not v.CanCollide) and not v.Parent:IsA("Model") then
			table.insert(exclude, v)
		end
	end
	rp.FilterDescendantsInstances = exclude
	local SINK = { tree = 0.6, rock = 0.35, car = 0.05, bush = 0.3 }
	for _, m in keep do
		local cf, size = m:GetBoundingBox()
		local bottom = cf.Position - Vector3.new(0, size.Y / 2, 0)
		local sink = SINK[m:GetAttribute("Prop")] or 0.15
		local target
		local down = Workspace:Raycast(bottom + Vector3.new(0, 0.5, 0), Vector3.new(0, -80, 0), rp)
		local up = Workspace:Raycast(bottom + Vector3.new(0, 7, 0), Vector3.new(0, -7, 0), rp)
		if up and up.Position.Y - bottom.Y > 2 then
			target = up.Position.Y - sink -- buried deep in a hill
			raised += 1
		elseif down and bottom.Y - down.Position.Y > 0.25 then
			target = down.Position.Y - sink -- hovering
			lowered += 1
		end
		if target then
			m:PivotTo(m:GetPivot() + Vector3.new(0, target - bottom.Y, 0))
		end
	end
	return removed, lowered, raised
end

-- Buildings with interiors ------------------------------------------------------------------------

-- A wall along X or Z with openings: { {a, b, bottom, top} } (doors bottom = 0, windows ~3.5..7).
local function wallWithOpenings(parent, axis, fixed, a0, a1, y0, h, openings, color, material, thick)
	thick = thick or 1
	table.sort(openings, function(p, q)
		return p[1] < q[1]
	end)
	local function piece(a, b, lo, hi)
		if b - a < 0.05 or hi - lo < 0.05 then
			return
		end
		local len, height = b - a, hi - lo
		local mid = (a + b) / 2
		local pos = axis == "x" and Vector3.new(mid, y0 + lo + height / 2, fixed) or Vector3.new(fixed, y0 + lo + height / 2, mid)
		local size = axis == "x" and Vector3.new(len, height, thick) or Vector3.new(thick, height, len)
		block(parent, size, pos, color, material)
	end
	local cursor = a0
	for _, o in openings do
		piece(cursor, o[1], 0, h)
		piece(o[1], o[2], 0, o[3])
		piece(o[1], o[2], o[4], h)
		if o[3] > 0.5 then -- a window: glass with a dusty tint
			local mid = (o[1] + o[2]) / 2
			local pos = axis == "x" and Vector3.new(mid, y0 + (o[3] + o[4]) / 2, fixed) or Vector3.new(fixed, y0 + (o[3] + o[4]) / 2, mid)
			local size = axis == "x" and Vector3.new(o[2] - o[1], o[4] - o[3], 0.15) or Vector3.new(0.15, o[4] - o[3], o[2] - o[1])
			block(parent, size, pos, Color3.fromRGB(150, 160, 160), Enum.Material.Glass, { Transparency = 0.6, CanCollide = true })
		end
		cursor = o[2]
	end
	piece(cursor, a1, 0, h)
end

-- A one-storey building with real rooms: BSP-split interior, doorways between rooms, two
-- entrances, windows, ceiling lights (some dead), furniture, containers and loot.
-- rect = {x0, z0, x1, z1}; y = floor height. Returns { doorways, containers, loot }.
function MapKit.building(parent, rect, y, rng, style)
	style = style or {}
	local x0, z0, x1, z1 = rect[1], rect[2], rect[3], rect[4]
	local H = style.h or 11
	local outer = style.color or Color3.fromRGB(128, 118, 104)
	local inner = style.inner or Color3.fromRGB(176, 170, 156)
	local outerMat = style.material or Enum.Material.Brick
	local M = Enum.Material
	local doorways, containers, loot = {}, {}, {}
	local floorY = y + 1

	-- floor, ceiling, roof with a parapet
	block(parent, Vector3.new(x1 - x0, 1, z1 - z0), Vector3.new((x0 + x1) / 2, y + 0.5, (z0 + z1) / 2), Color3.fromRGB(92, 88, 82), M.Concrete)
	block(parent, Vector3.new(x1 - x0, 1, z1 - z0), Vector3.new((x0 + x1) / 2, floorY + H + 0.5, (z0 + z1) / 2), Color3.fromRGB(80, 78, 74), M.Concrete)
	for _, e in { { "x", z0 }, { "x", z1 }, { "z", x0 }, { "z", x1 } } do
		if e[1] == "x" then
			block(parent, Vector3.new(x1 - x0, 1.6, 0.8), Vector3.new((x0 + x1) / 2, floorY + H + 1.8, e[2]), outer, outerMat)
		else
			block(parent, Vector3.new(0.8, 1.6, z1 - z0), Vector3.new(e[2], floorY + H + 1.8, (z0 + z1) / 2), outer, outerMat)
		end
	end

	-- exterior walls: front + back doors, windows every ~9 studs
	local function windows(a0, a1, door)
		local list = {}
		local a = a0 + 4
		while a + 4 < a1 - 2 do
			if not door or math.abs(a + 2 - door) > 5 then
				table.insert(list, { a, a + 4, 4, 7.5 })
			end
			a += 9
		end
		if door then
			table.insert(list, { door - 2.5, door + 2.5, 0, 8 })
		end
		return list
	end
	local frontDoor = (x0 + x1) / 2 + rng:NextNumber(-4, 4)
	local backDoor = (x0 + x1) / 2 + rng:NextNumber(-6, 6)
	wallWithOpenings(parent, "x", z0, x0, x1, floorY, H, windows(x0, x1, frontDoor), outer, outerMat)
	wallWithOpenings(parent, "x", z1, x0, x1, floorY, H, windows(x0, x1, backDoor), outer, outerMat)
	wallWithOpenings(parent, "z", x0, z0, z1, floorY, H, windows(z0, z1, nil), outer, outerMat)
	wallWithOpenings(parent, "z", x1, z0, z1, floorY, H, windows(z0, z1, nil), outer, outerMat)
	table.insert(doorways, { hinge = Vector3.new(frontDoor - 2.5, floorY, z0 - 0.1), width = 5, dir = Vector3.new(1, 0, 0) })
	table.insert(doorways, { hinge = Vector3.new(backDoor - 2.5, floorY, z1 + 0.1), width = 5, dir = Vector3.new(1, 0, 0) })

	-- interior: split into rooms
	local rooms = {}
	local function split(r, depth)
		local w, d = r[3] - r[1], r[4] - r[2]
		if depth >= 3 or (w < 20 and d < 20) then
			table.insert(rooms, r)
			return
		end
		if w >= d then
			local sx = r[1] + w * rng:NextNumber(0.38, 0.62)
			local door = rng:NextNumber(r[2] + 3, r[4] - 3)
			wallWithOpenings(parent, "z", sx, r[2] + 0.5, r[4] - 0.5, floorY, H, { { door - 2, door + 2, 0, 8 } }, inner, M.SmoothPlastic, 0.6)
			split({ r[1], r[2], sx, r[4] }, depth + 1)
			split({ sx, r[2], r[3], r[4] }, depth + 1)
		else
			local sz = r[2] + d * rng:NextNumber(0.38, 0.62)
			local door = rng:NextNumber(r[1] + 3, r[3] - 3)
			wallWithOpenings(parent, "x", sz, r[1] + 0.5, r[3] - 0.5, floorY, H, { { door - 2, door + 2, 0, 8 } }, inner, M.SmoothPlastic, 0.6)
			split({ r[1], r[2], r[3], sz }, depth + 1)
			split({ r[1], sz, r[3], r[4] }, depth + 1)
		end
	end
	split({ x0 + 0.5, z0 + 0.5, x1 - 0.5, z1 - 0.5 }, 0)

	local furniture = { Color3.fromRGB(84, 70, 56), Color3.fromRGB(70, 74, 76), Color3.fromRGB(96, 84, 70) }
	for i, r in rooms do
		local cx, cz = (r[1] + r[3]) / 2, (r[2] + r[4]) / 2
		local w, d = r[3] - r[1], r[4] - r[2]
		-- ceiling light (about a third are dead: interiors stay dark, bring a flashlight)
		if rng:NextNumber() < 0.65 then
			MapKit.bulb(parent, Vector3.new(cx, floorY + H - 1.2, cz), 15)
		else
			block(parent, Vector3.new(0.7, 0.7, 0.7), Vector3.new(cx, floorY + H - 1.2, cz), Color3.fromRGB(60, 60, 58), M.Glass, { Shape = Enum.PartType.Ball, CanCollide = false })
		end
		-- furniture against one wall: shelves, a desk, or crates
		local kind = rng:NextInteger(1, 3)
		local col = furniture[rng:NextInteger(1, #furniture)]
		if kind == 1 and w > 8 then
			for k = 0, math.floor((w - 4) / 4) - 1 do
				local sx = r[1] + 2.5 + k * 4
				block(parent, Vector3.new(3.6, 7, 1.6), Vector3.new(sx, floorY + 3.5, r[4] - 1.4), col, M.Wood)
				for shelf = 1, 3 do
					block(parent, Vector3.new(3.4, 0.2, 1.5), Vector3.new(sx, floorY + shelf * 2, r[4] - 1.5), Color3.fromRGB(60, 52, 44), M.Wood)
				end
			end
		elseif kind == 2 then
			block(parent, Vector3.new(5, 2.6, 2.6), Vector3.new(cx, floorY + 1.3, r[2] + 2.2), col, M.Wood) -- desk
			block(parent, Vector3.new(1.6, 2.4, 1.6), Vector3.new(cx + 0.5, floorY + 1.2, r[2] + 4.2), Color3.fromRGB(50, 50, 52), M.Fabric) -- chair
		else
			for k = 1, rng:NextInteger(2, 4) do
				local s3 = rng:NextNumber(2.2, 3.4)
				block(parent, Vector3.new(s3, s3, s3), Vector3.new(r[1] + 2 + rng:NextNumber(0, math.max(0.1, w - 4)), floorY + s3 / 2, r[2] + 2 + rng:NextNumber(0, math.max(0.1, d - 4))) , Color3.fromRGB(92, 72, 52), M.WoodPlanks)
			end
		end
		table.insert(containers, { pos = Vector3.new(r[3] - 1.6, floorY, cz), type = ({ "Locker", "Drawer", "Toolbox", "AmmoCrate" })[rng:NextInteger(1, 4)], yaw = -90 })
		table.insert(loot, Vector3.new(cx + rng:NextNumber(-w / 4, w / 4), floorY, cz + rng:NextNumber(-d / 4, d / 4)))
		assert(i)
	end
	return { doorways = doorways, containers = containers, loot = loot }
end

function MapKit.inside(rect, v, pad)
	pad = pad or 0
	return v.X > rect[1] - pad and v.X < rect[3] + pad and v.Z > rect[2] - pad and v.Z < rect[4] + pad
end

return MapKit
]]></ProtectedString></Properties></Item>
</Item>
<Item class="Folder" referent="RBX00000042"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX0000002D"><Properties><string name="Name">ActionService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Every non-gun player action, validated server-side. The client only sends intent:
--   Action("Quiet")                     Quieting from behind / with a Tide Spike, else shove
--   Action("Throw", {dir, item})        bottle / flare pot / fog pot / salt bomb
--   Action("Ability")                   character signature ability
--   Action("Heal") / ("Torch") / ("Craft", recipeId)
--   Action("Equip", slot) / ("Fire", {dir, aim}) / ("Reload")   -> WeaponService
--   Action("SecondWind") / ("Resupply") run aids (tokens; once per crossing)
local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Characters = require(Shared.Config.Characters)
local Game = require(Shared.Config.Game)
local Items = require(Shared.Config.Items)
local Weapons = require(Shared.Config.Weapons)
local Net = require(Shared.Net)
local Geometry = require(Shared.Util.Geometry)
local Sfx = require(Shared.Util.Sfx)

local ActionService = {}
local Services

local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local function serverTime()
	return Workspace:GetServerTimeNow()
end

local function toast(player, text)
	Net.notify(player, "Toast", { text = text })
end

local function setBusy(info, seconds)
	info.session.busyUntil = os.clock() + seconds
	info.char:SetAttribute("BusyUntil", serverTime() + seconds)
end

local function isBusy(info)
	return os.clock() < info.session.busyUntil
end

local function channel(info, seconds, fn)
	local session = info.session
	session.channelId += 1
	local id = session.channelId
	setBusy(info, seconds)
	task.delay(seconds, function()
		if session.channelId == id and not session.downed and not session.out then
			fn()
		end
	end)
end

local function rayParamsFor(char)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { char }
	return params
end

local function effectHolder(position, lifetime)
	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.new(0.2, 0.2, 0.2)
	holder.CFrame = CFrame.new(position)
	holder.Parent = Workspace
	Debris:AddItem(holder, lifetime)
	return holder
end

-- Quieting / spike / shove -------------------------------------------------------------------

local function cue(info, name)
	info.char:SetAttribute(name, serverTime())
end

local MELEE = { damage = { 24, 24, 40 }, range = 5.5, interval = 0.42, comboWindow = 0.95, noise = 10 }

local function melee(player, info)
	local session = info.session
	local now = os.clock()
	if now < (session.meleeReadyAt or 0) then
		return
	end
	session.meleeCombo = (now - (session.lastMeleeAt or 0) < MELEE.comboWindow) and ((session.meleeCombo or 0) % 3 + 1) or 1
	session.lastMeleeAt = now
	session.meleeReadyAt = now + MELEE.interval
	local combo = session.meleeCombo
	info.char:SetAttribute("MeleeCombo", combo)
	cue(info, "MeleeAt")
	setBusy(info, 0.3)
	Sfx.at(info.root.Position, "Swing", 0.5, 30, 0.1)
	local pos, look = info.root.Position, info.root.CFrame.LookVector
	task.delay(0.12, function() -- strike lands mid-swing
		for _, entry in Services.EnemyService.findNear(pos, MELEE.range) do
			local e = entry.enemy
			local to = Geometry.flat(e.root.Position - pos)
			if to.Magnitude > 0.01 and look:Dot(to.Unit) > 0.35 then
				-- sneak strike: an enemy that hasn't noticed you, hit from behind
				local unaware = e.state ~= "Chase" and e.state ~= "Grabbed" and e.root.CFrame.LookVector:Dot(to.Unit) > 0.2
				local damage = MELEE.damage[combo] * (e.cfg.shoveable and 1 or 0.5) * (unaware and 3 or 1)
				local killed = Services.EnemyService.damage(e, damage, unaware and nil or player, false, { zone = "torso", direction = to.Unit, force = unaware and 1.8 or 1 })
				if unaware and not killed then
					Services.EnemyService.stun(e, 1.2, player)
				end
				Sfx.at(e.root.Position, "MeleeHit", unaware and 0.4 or 0.7, unaware and 20 or 50, 0.1)
				Net.notify(player, "Hit", { kill = killed, melee = true, headshot = unaware })
				if killed and unaware then
					Services.MatchService.onEnemyKilled(player, e)
				end
				if not killed and combo == 3 and e.cfg.shoveable then
					Services.EnemyService.stun(e, Items.Shove.stun, player)
					e.root.AssemblyLinearVelocity = to.Unit * 34
				end
				break
			end
		end
		Services.MatchService.damageNestsNear(pos + look * 2.5, 3.5, MELEE.damage[combo], player)
	end)
	Services.PerceptionService.emitNoise(pos, MELEE.noise, "melee", player)
end


local function dodge(player, info, direction)
	local session = info.session
	local now = os.clock()
	if now < (session.dodgeReadyAt or 0) or isBusy(info) then
		return
	end
	if not Geometry.isSaneVector(direction, 2) then
		return
	end
	local dive = info.char:GetAttribute("Sprint") == true
	session.dodgeReadyAt = now + (dive and 1.3 or 0.85)
	session.dodgeUntil = now + (dive and 0.6 or 0.42) -- grabs miss during the dodge
	Services.CharacterService.setGrace(player, 1.2)
	info.char:SetAttribute("DodgeDive", dive)
	cue(info, "DodgeAt")
	Services.PerceptionService.emitNoise(info.root.Position, dive and 14 or 8, "dodge", player)
end

-- Moving over the world: hop, vault, land. The client does the movement (it owns its character);
-- here we only add the noise, a short anti-cheat grace for the displacement, and the pose cue.
local function jump(player, info)
	local session = info.session
	local now = os.clock()
	if now < (session.jumpAt or 0) + 0.5 then
		return
	end
	session.jumpAt = now
	Services.CharacterService.setGrace(player, 0.8)
	cue(info, "JumpAt")
	Services.PerceptionService.emitNoise(info.root.Position, 7, "jump", player)
end

local function vault(player, info, payload)
	local session = info.session
	local now = os.clock()
	if now < (session.vaultAt or 0) + 0.7 or type(payload) ~= "table" then
		return
	end
	local target = payload.target
	if typeof(target) ~= "Vector3" or not Geometry.isSaneVector(target - info.root.Position, 24) or (target - info.root.Position).Magnitude > 14 then
		return
	end
	session.vaultAt = now
	Services.CharacterService.setGrace(player, 1.6)
	cue(info, "VaultAt")
	Services.PerceptionService.emitNoise(info.root.Position, 9, "vault", player)
end

local function land(player, info, speed)
	if type(speed) ~= "number" or speed ~= speed then
		return
	end
	speed = math.clamp(speed, 0, 120)
	if speed > 16 then
		Services.PerceptionService.emitNoise(info.root.Position, math.min(8 + speed * 0.5, 34), "land", player)
	end
end

local function quietEnemy(player, info, e, duration)
	Services.EnemyService.stun(e, duration + 5, nil, "Quieted")
	setBusy(info, duration)
	cue(info, "TakedownAt")
	Net.notify(player, "Takedown", { duration = duration })
	task.delay(duration, function()
		Services.EnemyService.disperse(e, player)
		Services.PerceptionService.emitNoise(e.root.Position, Items.Quieting.noise, "quieting", nil)
	end)
	info.session.stats.takedowns += 1
	Services.InventoryService.add(player, "salvage", Items.Quieting.salvage)
end

-- Grab (human shield) -----------------------------------------------------------------------
-- Sneak up behind a human enemy and grab them: you move slowly and can still fire your
-- revolver; their friends hesitate to shoot through them; F again = silent takedown; after a
-- few seconds you shove them away, stunned. The Hushed don't care about hostages.
local GRAB_TIME = 8

local function releaseGrab(player, info, takedown)
	local session = info.session
	local e = session.grabbing
	session.grabbing = nil
	info.char:SetAttribute("Grabbing", false)
	if not e or e.dead then
		return
	end
	Services.EnemyService.release(e)
	if takedown then
		local duration = Items.Quieting.time * session.mods.takedownTimeMult
		quietEnemy(player, info, e, duration)
	else
		local away = info.root.CFrame.LookVector
		e.root.AssemblyLinearVelocity = away * 30
		Services.EnemyService.stun(e, 1.8, player)
	end
end
ActionService.releaseGrab = releaseGrab

local function grab(player, info, e)
	local session = info.session
	session.grabbing = e
	info.char:SetAttribute("Grabbing", true)
	cue(info, "GrabAt")
	Services.EnemyService.grab(e, player, info.root)
	Sfx.at(info.root.Position, "MeleeHit", 0.3, 20)
	local id = os.clock()
	session.grabId = id
	task.delay(GRAB_TIME, function()
		if session.grabbing == e and session.grabId == id then
			releaseGrab(player, info, false)
		end
	end)
	toast(player, "Grabbed! Their friends won't shoot through them. F: silent takedown")
end

local function quiet(player, info)
	if isBusy(info) then
		return
	end
	if info.session.grabbing then
		releaseGrab(player, info, true)
		return
	end
	local pos = info.root.Position
	local near = Services.EnemyService.findNear(pos, math.max(Items.Quieting.range, Items.Shove.range))
	local look = info.root.CFrame.LookVector
	local duration = Items.Quieting.time * info.session.mods.takedownTimeMult
	for _, entry in near do
		local e = entry.enemy
		if entry.distance <= Items.Quieting.range and Services.EnemyService.canQuiet(e, pos) then
			if e.cfg.human then
				grab(player, info, e)
			else
				quietEnemy(player, info, e, duration)
			end
			return
		end
	end
	-- a Tide Spike lets you Quiet from the front (not Tidewalkers)
	for _, entry in near do
		local e = entry.enemy
		local to = Geometry.flat(e.root.Position - pos)
		if entry.distance <= Items.Quieting.range and e.cfg.quietable and e.state ~= "Quieted" and to.Magnitude > 0.01 and look:Dot(to.Unit) > 0.3 then
			if Services.InventoryService.take(player, "spike", 1) then
				quietEnemy(player, info, e, duration * 0.8)
				toast(player, "Tide Spike used")
				return
			end
			break
		end
	end
	-- otherwise: melee combo (third hit knocks them back)
	melee(player, info)
end

-- Called by EnemyService when a Hushed grabs someone. Returns true if a spike saved them.
function ActionService.trySpikeCounter(player, e)
	if not e.cfg.quietable then
		return false
	end
	local info = Services.MatchService.getActiveInfo(player)
	if not info or not Services.InventoryService.take(player, "spike", 1) then
		return false
	end
	toast(player, "Spike! You broke free.")
	quietEnemy(player, info, e, 0.6)
	return true
end

-- Throwables ---------------------------------------------------------------------------------

local landing = {}

function landing.bottle(position, player, mods)
	local radius = Items.Throw.bottle.noise * mods.throwNoiseMult
	Services.PerceptionService.emitNoise(position, radius, "bottle", nil)
	Sfx.at(position, "BottleBreak", 0.8, 160)
	local shards = Instance.new("ParticleEmitter")
	shards.Rate = 0
	shards.Lifetime = NumberRange.new(0.4, 0.8)
	shards.Speed = NumberRange.new(8, 16)
	shards.SpreadAngle = Vector2.new(70, 70)
	shards.Acceleration = Vector3.new(0, -40, 0)
	shards.Color = ColorSequence.new(Color3.fromRGB(150, 200, 170))
	shards.Size = NumberSequence.new(0.15)
	shards.Parent = effectHolder(position, 2)
	shards:Emit(25)
end

function landing.flarePot(position, player, mods)
	local cfg = Items.Throw.flarePot
	Services.EnemyService.addFireZone(position, cfg.radius, cfg.duration, cfg.dps, player)
	Services.PerceptionService.emitNoise(position, cfg.noise * mods.throwNoiseMult, "flare", nil)
	local holder = effectHolder(position + Vector3.new(0, 0.3, 0), cfg.duration + 1)
	Sfx.attach(holder, "FireLoop", 0.8, 70, true)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 120, 60)
	light.Range = cfg.radius * 2.5
	light.Brightness = 3
	light.Shadows = true
	light.Parent = holder
	local sparks = Instance.new("ParticleEmitter")
	sparks.Rate = 60
	sparks.Lifetime = NumberRange.new(0.6, 1.2)
	sparks.Speed = NumberRange.new(2, 6)
	sparks.SpreadAngle = Vector2.new(60, 60)
	sparks.Color = ColorSequence.new(Color3.fromRGB(255, 160, 80), Color3.fromRGB(255, 70, 40))
	sparks.LightEmission = 1
	sparks.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 0) })
	sparks.Parent = holder
	local glow = Instance.new("ParticleEmitter")
	glow.Texture = SMOKE
	glow.Rate = 8
	glow.Lifetime = NumberRange.new(1.5, 2.5)
	glow.Speed = NumberRange.new(1, 3)
	glow.Color = ColorSequence.new(Color3.fromRGB(255, 120, 70))
	glow.LightEmission = 0.6
	glow.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, cfg.radius) })
	glow.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) })
	glow.Parent = holder
	task.delay(cfg.duration, function()
		sparks.Enabled = false
		glow.Enabled = false
		light.Enabled = false
	end)
end

function landing.fogPot(position, player, mods)
	local cfg = Items.Throw.fogPot
	Services.PerceptionService.addFogCloud(position + Vector3.new(0, 3, 0), cfg.radius, cfg.duration)
	Services.PerceptionService.emitNoise(position, cfg.noise * mods.throwNoiseMult, "fog", nil)
	for _, entry in Services.EnemyService.findNear(position, cfg.radius) do
		Services.EnemyService.stun(entry.enemy, cfg.stun, nil)
	end
	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = SMOKE
	smoke.Rate = 40
	smoke.Lifetime = NumberRange.new(3, 4)
	smoke.Speed = NumberRange.new(2, 5)
	smoke.SpreadAngle = Vector2.new(180, 30)
	smoke.Drag = 1.5
	smoke.Color = ColorSequence.new(Color3.fromRGB(200, 205, 205))
	smoke.LightInfluence = 1
	smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 4), NumberSequenceKeypoint.new(1, cfg.radius * 1.2) })
	smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(0.8, 0.4), NumberSequenceKeypoint.new(1, 1) })
	smoke.Parent = effectHolder(position + Vector3.new(0, 1, 0), cfg.duration + 5)
	Sfx.at(position, "FogHiss", 0.8, 60)
	task.delay(cfg.duration, function()
		smoke.Enabled = false
	end)
end

function landing.saltBomb(position, player, mods)
	local cfg = Items.Throw.saltBomb
	local mine = Instance.new("Part")
	mine.Name = "SaltBomb"
	mine.Anchored = true
	mine.CanCollide = false
	mine.CanQuery = false
	mine.Shape = Enum.PartType.Cylinder
	mine.Size = Vector3.new(0.35, 1.1, 1.1)
	mine.Color = Color3.fromRGB(60, 58, 54)
	mine.Material = Enum.Material.Metal
	mine.CFrame = CFrame.new(position + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.rad(90))
	mine.Parent = Workspace
	local blink = Instance.new("PointLight")
	blink.Color = Color3.fromRGB(255, 80, 60)
	blink.Range = 4
	blink.Brightness = 2
	blink.Parent = mine
	task.spawn(function()
		task.wait(cfg.armTime)
		local expires = os.clock() + cfg.lifetime
		while mine.Parent and os.clock() < expires and Services.MatchService.state == "Encounter" do
			blink.Enabled = not blink.Enabled
			if #Services.EnemyService.findNear(mine.Position, cfg.triggerRadius) > 0 then
				break
			end
			task.wait(0.25)
		end
		if not mine.Parent then
			return
		end
		local at = mine.Position
		mine:Destroy()
		Services.EnemyService.explode(at, cfg.radius, cfg.damage, player)
		Services.PerceptionService.emitNoise(at, cfg.noise, "explosion", nil)
		Sfx.at(at, "Explosion", 1, 250)
		Net.notifyAll("Explosion", { position = at, radius = cfg.radius })
		local burst = Instance.new("ParticleEmitter")
		burst.Texture = SMOKE
		burst.Rate = 0
		burst.Lifetime = NumberRange.new(1, 2)
		burst.Speed = NumberRange.new(10, 22)
		burst.SpreadAngle = Vector2.new(180, 180)
		burst.Drag = 4
		burst.Color = ColorSequence.new(Color3.fromRGB(230, 225, 210))
		burst.LightEmission = 0.3
		burst.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 8) })
		burst.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
		local holder = effectHolder(at, 3)
		burst.Parent = holder
		burst:Emit(60)
		local flash = Instance.new("PointLight")
		flash.Range = 30
		flash.Brightness = 6
		flash.Color = Color3.fromRGB(255, 220, 180)
		flash.Parent = holder
		task.delay(0.15, function()
			flash.Enabled = false
		end)
	end)
end

local THROW_COLORS = {
	bottle = Color3.fromRGB(70, 120, 90),
	flarePot = Color3.fromRGB(170, 90, 50),
	fogPot = Color3.fromRGB(150, 150, 140),
	saltBomb = Color3.fromRGB(60, 58, 54),
}

local function throw(player, info, payload)
	if type(payload) ~= "table" then
		return
	end
	local direction, itemId = payload.dir, payload.item
	if type(itemId) ~= "string" or not landing[itemId] then
		return
	end
	if not Geometry.isSaneVector(direction, 2) or direction.Magnitude < 0.5 then
		return
	end
	direction = direction.Unit
	if isBusy(info) then
		return
	end
	if not Services.InventoryService.take(player, itemId, 1) then
		toast(player, "No " .. Items.Items[itemId].name)
		return
	end
	setBusy(info, 0.35)
	cue(info, "ThrowAt")
	Sfx.at(info.root.Position, "Throw", 0.5, 30)
	local head = info.char:FindFirstChild("Head")
	local position = (head and head.Position or info.root.Position) + direction * 1.5
	local velocity = direction * Items.Throw.speed + Vector3.new(0, Items.Throw.lift, 0)
	local object = Instance.new("Part")
	object.Anchored = true
	object.CanCollide = false
	object.CanQuery = false
	object.Size = Vector3.new(0.5, 0.8, 0.5)
	object.Material = itemId == "bottle" and Enum.Material.Glass or Enum.Material.Metal
	object.Color = THROW_COLORS[itemId]
	object.Transparency = itemId == "bottle" and 0.2 or 0
	object.CFrame = CFrame.new(position)
	object.Parent = Workspace
	if itemId == "flarePot" then
		local spark = Instance.new("PointLight")
		spark.Color = Color3.fromRGB(255, 140, 70)
		spark.Range = 6
		spark.Parent = object
	end
	local params = rayParamsFor(info.char)
	local mods = info.session.mods
	local age = 0
	local conn
	conn = RunService.Heartbeat:Connect(function(dt)
		age += dt
		velocity += Vector3.new(0, -Workspace.Gravity * 0.5, 0) * dt
		local step = velocity * dt
		local result = Workspace:Raycast(position, step, params)
		if result or age > 4 then
			conn:Disconnect()
			object:Destroy()
			landing[itemId](result and result.Position or position, player, mods)
			return
		end
		position += step
		object.CFrame = CFrame.new(position) * CFrame.Angles(age * 9, age * 5, 0)
	end)
end

-- Abilities ----------------------------------------------------------------------------------

local abilities = {}

function abilities.TideSense(player, info, ability, mods)
	Net.notify(player, "TideSense", {
		radius = ability.radius * mods.abilityRadiusMult,
		duration = ability.duration * mods.abilityDurationMult,
	})
	return true
end

function abilities.RattleBox(player, info, ability, mods)
	local look = Geometry.flat(info.root.CFrame.LookVector)
	look = look.Magnitude > 0.01 and look.Unit or Vector3.new(0, 0, -1)
	local spot = info.root.Position + look * 3
	local down = Workspace:Raycast(spot + Vector3.new(0, 3, 0), Vector3.new(0, -12, 0), rayParamsFor(info.char))
	local ground = down and down.Position or Vector3.new(spot.X, 0, spot.Z)
	local box = Instance.new("Part")
	box.Name = "RattleBox"
	box.Anchored = true
	box.CanCollide = false
	box.Size = Vector3.new(1, 0.8, 1)
	box.Material = Enum.Material.Metal
	box.Color = Color3.fromRGB(150, 120, 60)
	box.CFrame = CFrame.new(ground + Vector3.new(0, 0.4, 0))
	box.Parent = Workspace
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 200, 120)
	light.Range = 6
	light.Parent = box
	local radius = ability.radius * mods.abilityRadiusMult
	local duration = ability.duration * mods.abilityDurationMult
	task.spawn(function()
		local elapsed = 0
		while elapsed < duration and box.Parent do
			light.Enabled = not light.Enabled
			Services.PerceptionService.emitNoise(box.Position, radius, "rattle", nil)
			Sfx.at(box.Position, "Rattle", 0.4, radius * 2)
			task.wait(1.5)
			elapsed += 1.5
		end
		box:Destroy()
	end)
	return true
end

function abilities.SteadyHands(player, info, ability, mods)
	Services.CharacterService.heal(player, 40 * mods.healMult)
	for _, other in Services.MatchService.getActivePlayers() do
		if other.player ~= player and (other.root.Position - info.root.Position).Magnitude <= ability.radius then
			Services.CharacterService.heal(other.player, 20 * mods.healMult)
			toast(other.player, player.DisplayName .. " patched you up")
		end
	end
	info.session.calmUntil = os.clock() + ability.duration * mods.abilityDurationMult
	return true
end

function abilities.ThrowNet(player, info, ability, mods)
	local look = info.root.CFrame.LookVector
	local params = rayParamsFor(info.char)
	for _, entry in Services.EnemyService.findNear(info.root.Position, ability.radius) do
		local e = entry.enemy
		local to = e.root.Position - info.root.Position
		if to.Magnitude > 0.01 and look:Dot(to.Unit) > 0.8 then
			local hit = Workspace:Raycast(info.root.Position, to, params)
			if not hit or Services.EnemyService.fromInstance(hit.Instance) == e then
				Services.EnemyService.pin(e, ability.duration * mods.abilityDurationMult)
				return true
			end
		end
	end
	toast(player, "No Hushed in front of you to net")
	return false
end

local function useAbility(player, info)
	local session = info.session
	if isBusy(info) or os.clock() < session.abilityReadyAt then
		return
	end
	local ability = Characters.List[session.charId].ability
	local handler = abilities[ability.id]
	if handler and handler(player, info, ability, session.mods) then
		local cooldown = ability.cooldown * session.mods.abilityCooldownMult
		session.abilityReadyAt = os.clock() + cooldown
		info.char:SetAttribute("AbilityReadyAt", serverTime() + cooldown)
	end
end

-- Healing, torch, crafting -----------------------------------------------------------------

local function heal(player, info)
	if isBusy(info) then
		return
	end
	if info.session.hp >= (info.session.maxHp or Game.MaxHP) then
		toast(player, "Already at full health")
		return
	end
	if Services.InventoryService.count(player, "dressing") < 1 then
		toast(player, "No Field Dressings: craft one from Cloth + Alcohol")
		return
	end
	Services.WeaponService.holster(player)
	cue(info, "HealAt")
	Sfx.at(info.root.Position, "Bandage", 0.6, 30)
	channel(info, Items.Dressing.channel, function()
		if Services.InventoryService.take(player, "dressing", 1) then
			Services.CharacterService.heal(player, Items.Dressing.heal * info.session.mods.healMult)
		end
	end)
end

local function toggleTorch(_player, char)
	Services.CharacterService.toggleFlashlight(char)
end

local function craft(player, info, recipeId)
	if type(recipeId) ~= "string" or not Items.Recipes[recipeId] or isBusy(info) then
		return
	end
	local ok, reason = Services.InventoryService.canCraft(player, recipeId)
	if not ok then
		toast(player, reason)
		return
	end
	local recipe = Items.Recipes[recipeId]
	Services.WeaponService.holster(player)
	channel(info, recipe.time * info.session.mods.craftTimeMult, function()
		local crafted, why = Services.InventoryService.craft(player, recipeId)
		toast(player, crafted and ("Crafted " .. recipe.name) or why)
	end)
end

-- Run aids ---------------------------------------------------------------------------------

function ActionService.useSecondWind(player)
	if not Game.RunAidsEnabled then
		return false
	end
	local session = Services.CharacterService.getSession(player)
	if not session or not session.downed or session.out or Services.MatchService.state ~= "Encounter" then
		return false
	end
	if session.usedSecondWind then
		toast(player, "Second Wind is limited to once per crossing")
		return false
	end
	if not Services.PlayerDataService.useToken(player, "secondWind") then
		Net.notify(player, "NeedProduct", { productKey = "SecondWind" })
		return false
	end
	session.usedSecondWind = true
	Services.CharacterService.revive(player, Game.SecondWindHP)
	return true
end

function ActionService.useResupply(player)
	if not Game.RunAidsEnabled then
		return false
	end
	local session = Services.CharacterService.getSession(player)
	if not session or not session.runId or session.downed then
		toast(player, "Resupply works during a crossing")
		return false
	end
	if session.usedResupply then
		toast(player, "Resupply is limited to once per crossing")
		return false
	end
	if not Services.PlayerDataService.useToken(player, "resupply") then
		Net.notify(player, "NeedProduct", { productKey = "Resupply" })
		return false
	end
	session.usedResupply = true
	for itemId, amount in Items.Resupply do
		Services.InventoryService.add(player, itemId, amount)
	end
	toast(player, "Resupplied")
	return true
end

-- Ammo Cache: tops up reserve ammo for the guns you carry. Once per encounter.
function ActionService.useAmmoCache(player)
	if not Game.RunAidsEnabled then
		return false
	end
	local session = Services.CharacterService.getSession(player)
	local info = Services.MatchService.getActiveInfo(player)
	if not session or not info then
		toast(player, "Ammo Cache works during an encounter")
		return false
	end
	local encounterId = Services.MatchService.getEncounterId()
	if session.ammoCacheEncounter == encounterId then
		toast(player, "Ammo Cache is limited to once per encounter")
		return false
	end
	if not Services.PlayerDataService.useToken(player, "ammo") then
		Net.notify(player, "NeedProduct", { productKey = "AmmoCache" })
		return false
	end
	session.ammoCacheEncounter = encounterId
	local given = {}
	for _, w in Services.InventoryService.weaponSlots(player) do
		local ammo = Weapons.List[w.id] and Weapons.List[w.id].ammo
		local amount = ammo and Game.AmmoCache[ammo]
		if amount and not given[ammo] then
			given[ammo] = true
			Services.InventoryService.add(player, ammo, amount)
		end
	end
	Sfx.at(info.root.Position, "Pickup", 0.7, 30)
	toast(player, "Ammo Cache opened: reserves topped up")
	return true
end

-- Holster system: get a gun out of the backpack (kneel and dig; can't shoot meanwhile).
local function swapPack(player, info, index)
	index = tonumber(index) or 1
	if isBusy(info) or info.session.grabbing then
		return
	end
	local pack = Services.InventoryService.packList(player)
	if not pack[math.floor(index)] then
		toast(player, "Nothing else in your backpack")
		return
	end
	Services.WeaponService.holster(player)
	cue(info, "PackAt")
	Sfx.at(info.root.Position, "Search", 0.5, 25)
	Services.PerceptionService.emitNoise(info.root.Position, 6, "pack", player)
	channel(info, Weapons.PackSwapTime, function()
		if Services.InventoryService.swapPack(player, math.floor(index)) then
			Services.WeaponService.onSpawn(player, info.char)
			Services.WeaponService.equip(player, "long")
		end
	end)
end

-- Dispatcher ---------------------------------------------------------------------------------

local HANDLERS = {
	Quiet = quiet,
	Throw = throw,
	Ability = useAbility,
	Heal = heal,
	Craft = craft,
	Equip = function(player, _info, slot)
		Services.WeaponService.equip(player, slot)
	end,
	Fire = function(player, info, payload)
		if type(payload) == "table" then
			Services.WeaponService.fire(player, info, payload.dir, payload.aim == true)
		end
	end,
	Reload = function(player, info)
		Services.WeaponService.reload(player, info)
	end,
	Dodge = function(player, info, direction)
		dodge(player, info, direction)
	end,
	SwapPack = swapPack,
	Jump = jump,
	Vault = vault,
	Land = land,
}

-- Actions allowed on the Meridian (no encounter running).
local FERRY_OK = { Craft = true, Equip = true, Reload = true, Dodge = true, SwapPack = true, Jump = true, Vault = true, Land = true }

function ActionService.init(registry)
	Services = registry
end

function ActionService.start()
	Net.onServer("Action", 25, function(player, action, payload)
		if type(action) ~= "string" then
			return
		end
		if action == "SecondWind" then
			ActionService.useSecondWind(player)
			return
		elseif action == "Resupply" then
			ActionService.useResupply(player)
			return
		elseif action == "AmmoCache" then
			ActionService.useAmmoCache(player)
			return
		elseif action == "Torch" then
			local char = player.Character
			local session = Services.CharacterService.getSession(player)
			if char and session and not session.downed then
				toggleTorch(player, char)
			end
			return
		end
		local handler = HANDLERS[action]
		if not handler then
			return
		end
		local info = Services.MatchService.getActiveInfo(player)
		if not info and FERRY_OK[action] then
			info = Services.MatchService.getFerryInfo(player)
		end
		if info then
			handler(player, info, payload)
		end
	end)
end

return ActionService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002E"><Properties><string name="Name">AnalyticsHelper</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Thin wrapper over AnalyticsService so we can see (Creator Hub > Analytics) where Scrip is
-- earned and spent and which products sell. Never throws: analytics must not break gameplay.
local AnalyticsService = game:GetService("AnalyticsService")

local AnalyticsHelper = {}

-- flow "source" (earned) or "sink" (spent) of Scrip.
function AnalyticsHelper.economy(player, flow, amount, transactionType, itemSku)
	pcall(function()
		local data = AnalyticsHelper.balance and AnalyticsHelper.balance(player) or 0
		AnalyticsService:LogEconomyEvent(
			player,
			flow == "sink" and Enum.AnalyticsEconomyFlowType.Sink or Enum.AnalyticsEconomyFlowType.Source,
			"Scrip",
			amount,
			data,
			transactionType,
			itemSku
		)
	end)
end

function AnalyticsHelper.purchase(player, key, robux)
	pcall(function()
		AnalyticsService:LogCustomEvent(player, "RobuxPurchase", robux or 0, { [Enum.AnalyticsCustomFieldKeys.CustomField01.Name] = key })
	end)
end

function AnalyticsHelper.funnel(player, step, name)
	pcall(function()
		AnalyticsService:LogOnboardingFunnelStepEvent(player, step, name)
	end)
end

function AnalyticsHelper.init(registry)
	AnalyticsHelper.balance = function(player)
		local data = registry.PlayerDataService.get(player)
		return data and data.scrip or 0
	end
end

return AnalyticsHelper
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002F"><Properties><string name="Name">AntiCheatService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Lightweight movement sanity checks. Roblox lets clients simulate their own character, so
-- speed hacks are possible; we detect impossible displacement and pull the player back.
-- PvE-only design keeps the stakes low (docs/02-technical-architecture.md section 2.4).
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Movement = require(Shared.Config.Movement)

local AntiCheatService = {}
local Services

local INTERVAL = 0.5
local track = {} -- [Player] = { pos, t, strikes, lastGood }

function AntiCheatService.init(registry)
	Services = registry
end

function AntiCheatService.start()
	Players.PlayerRemoving:Connect(function(player)
		track[player] = nil
	end)
	while true do
		task.wait(INTERVAL)
		local now = os.clock()
		for _, player in Players:GetPlayers() do
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local session = Services.CharacterService.getSession(player)
			if root and session then
				-- safety net: fell through the world or got pushed outside the walls (physics can
				-- squeeze a character through thin geometry): put them back where they last stood
				local t0 = track[player]
				local p = root.Position
				local onMap = math.abs(p.X) < 130 and math.abs(p.Z) < 130
				local onFerry = math.abs(p.X) < 90 and math.abs(p.Z - 700) < 90
				local lost = p.Y < -30 or not (onMap or onFerry)
				if lost and t0 and t0.lastSafe then
					char:PivotTo(t0.lastSafe)
					root.AssemblyLinearVelocity = Vector3.zero
					Services.CharacterService.setGrace(player, 1)
					t0.pos, t0.t = t0.lastSafe.Position, now
				end
				local humanoid = char:FindFirstChildOfClass("Humanoid")
				if t0 and not lost and humanoid and humanoid.FloorMaterial ~= Enum.Material.Air then
					t0.lastSafe = root.CFrame + Vector3.new(0, 0.5, 0)
				end
				local t = track[player]
				if not t or t.char ~= char or now < session.graceUntil then
					track[player] = { char = char, pos = root.Position, t = now, strikes = 0, lastGood = root.CFrame, lastSafe = t and t.char == char and t.lastSafe or root.CFrame }
				else
					local dt = now - t.t
					local moved = Vector3.new(root.Position.X - t.pos.X, 0, root.Position.Z - t.pos.Z).Magnitude
					local allowed = (Movement.Speeds.Sprint * session.mods.sprintSpeedMult * 1.5 + 6) * dt
					if moved > allowed then
						t.strikes += 1
						if t.strikes >= 2 then
							warn(("[AntiCheat] %s moved %.1f studs in %.2fs; resetting"):format(player.Name, moved, dt))
							char:PivotTo(t.lastGood)
							t.strikes = 0
						end
					else
						t.strikes = math.max(0, t.strikes - 1)
						t.lastGood = root.CFrame
					end
					t.pos = root.Position
					t.t = now
				end
			end
		end
	end
end

return AntiCheatService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000030"><Properties><string name="Name">AssetService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Loads the sculpted mesh packs (Config/AssetIds) once at server start and hands out clones.
-- Sources, in order: ServerStorage > Assets > <Pack> (imported in Studio), then
-- InsertService:LoadAsset(id) for uploaded packs. Missing packs => built-in fallbacks.
local InsertService = game:GetService("InsertService")
local ServerStorage = game:GetService("ServerStorage")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local AssetIds = require(Shared.Config.AssetIds)
local MeshMeta = require(Shared.Config.MeshMeta)
local MeshKit = require(Shared.MeshKit)

local AssetService = {}

local parts = {} -- [meshName] = MeshPart template
local fitReport = {} -- [pack] = { rotation, scale, error, pieces, mode } (engine tests / F2)

function AssetService.report()
	local count = 0
	for _ in parts do
		count += 1
	end
	return { meshes = count, packs = fitReport }
end
local loaded = false

-- Every mesh name the game asks for (from MeshMeta), longest first, so an importer that
-- renames parts (adds "_Mesh", ".001", wraps them in a Model) still maps back.
local known, knownList = {}, {}
local canonCentre = {} -- [meshName] = Vector3 (where the piece sits in sculpt space)
local canonSize = {} -- [meshName] = Vector3 (its bounding box in sculpt space)
for _, entry in MeshMeta do
	local groups = entry.type == "rig" and entry.segments or { entry }
	for _, group in groups do
		for _, layer in group.layers do
			if not known[layer.part] then
				known[layer.part] = true
				table.insert(knownList, layer.part)
				canonCentre[layer.part] = Vector3.new(layer.center[1], layer.center[2], layer.center[3])
				canonSize[layer.part] = Vector3.new(layer.size[1], layer.size[2], layer.size[3])
			end
		end
	end
end
table.sort(knownList, function(a, b)
	return #a > #b
end)

local function resolveName(meshPart)
	for _, candidate in { meshPart.Name, meshPart.Parent and meshPart.Parent.Name or "" } do
		if known[candidate] then
			return candidate
		end
		local trimmed = candidate:gsub("%.%d+$", ""):gsub("_[Mm]esh$", ""):gsub("_[Pp]rimitive%d*$", "")
		if known[trimmed] then
			return trimmed
		end
	end
	for _, name in knownList do
		if meshPart.Name:find(name, 1, true) == 1 then
			return name
		end
	end
	return nil
end

-- The 24 axis-aligned rotations (every way an importer can turn a scene).
local ROTATIONS = {}
do
	local seen = {}
	for _, rx in { 0, 90, 180, 270 } do
		for _, ry in { 0, 90, 180, 270 } do
			for _, rz in { 0, 90, 180, 270 } do
				local cf = CFrame.Angles(math.rad(rx), math.rad(ry), math.rad(rz))
				local key = ("%d%d%d%d%d%d"):format(
					math.round(cf.RightVector.X), math.round(cf.RightVector.Y), math.round(cf.RightVector.Z),
					math.round(cf.UpVector.X), math.round(cf.UpVector.Y), math.round(cf.UpVector.Z)
				)
				if not seen[key] then
					seen[key] = true
					table.insert(ROTATIONS, cf)
				end
			end
		end
	end
end

-- Roblox's importer may turn and scale the whole scene (glTF conventions vs Roblox's). We know
-- where every piece sits in sculpt space (MeshMeta) and where it landed in the imported
-- model, so we solve that transform (best of the 24 rotations, least-squares scale) and
-- store, on each template, the rotation and scale that undo it for that piece. MeshKit uses
-- them, so pieces come out the right way round and the right shape whatever the importer did.
local function solveImport(name, templates)
	local A, B = {}, {}
	for meshName, part in templates do
		local c = canonCentre[meshName]
		if c then
			table.insert(A, c)
			table.insert(B, part.Position)
		end
	end
	if #A < 3 then
		return
	end
	local ca, cb = Vector3.zero, Vector3.zero
	for i = 1, #A do
		ca += A[i]
		cb += B[i]
	end
	ca /= #A
	cb /= #B
	local best, bestK, bestErr = nil, 1, math.huge
	for _, G in ROTATIONS do
		local num, den = 0, 0
		for i = 1, #A do
			local a = G:VectorToWorldSpace(A[i] - ca)
			num += a:Dot(B[i] - cb)
			den += a:Dot(a)
		end
		local k = den > 1e-9 and num / den or 0
		if k > 0 then
			local err, norm = 0, 0
			for i = 1, #A do
				local b = B[i] - cb
				local d = b - G:VectorToWorldSpace(A[i] - ca) * k
				err += d:Dot(d)
				norm += b:Dot(b)
			end
			err /= math.max(norm, 1e-9)
			if err < bestErr then
				best, bestK, bestErr = G, k, err
			end
		end
	end
	if not best or bestErr > 0.02 then
		-- positions didn't survive the import: match each piece's box shape instead (recovers
		-- which axis is which; a 180 degree flip can't be told apart from shape alone)
		local fixed = 0
		for meshName, part in templates do
			local want = canonSize[meshName]
			if want and want.Magnitude > 1e-6 then
				local bestG, bestE, bestScale = nil, math.huge, 1
				for _, G in ROTATIONS do
					local r = G:VectorToWorldSpace(want)
					r = Vector3.new(math.abs(r.X), math.abs(r.Y), math.abs(r.Z))
					local k = part.Size.Magnitude / r.Magnitude
					local d = part.Size / k - r
					local e = d.Magnitude / r.Magnitude
					if e < bestE - 1e-4 then
						bestG, bestE, bestScale = G, e, k
					end
				end
				if bestG then
					part:SetAttribute("FitRot", bestG:Inverse())
					part:SetAttribute("FitScale", 1 / bestScale)
					fixed += 1
				end
			end
		end
		fitReport[name] = { mode = "shape", error = bestErr, pieces = fixed }
		warn(("[AssetService] %s: positions didn't survive import (fit error %.3f); matched %d pieces by shape"):format(name, bestErr, fixed))
		return
	end
	local inv = best:Inverse()
	for _, part in templates do
		part:SetAttribute("FitRot", inv * part.CFrame.Rotation)
		part:SetAttribute("FitScale", 1 / bestK)
	end
	local rx, ry, rz = best:ToEulerAnglesXYZ()
	fitReport[name] = { mode = "positions", rotation = { math.deg(rx), math.deg(ry), math.deg(rz) }, scale = bestK, error = bestErr, pieces = #A }
	print(("[AssetService] %s: importer turned the scene (%d, %d, %d) deg, scale %.3f, fit error %.4f, %d pieces"):format(
		name, math.round(math.deg(rx)), math.round(math.deg(ry)), math.round(math.deg(rz)), bestK, bestErr, #A))
end

local function index(container)
	local found, unknown = 0, 0
	local templates = {}
	for _, d in container:GetDescendants() do
		if d:IsA("MeshPart") then
			local name = resolveName(d)
			if name then
				-- our colours/materials come from MeshMeta, so drop imported surface looks
				-- keep imported surface detail (normal / roughness maps) but never a colour map:
				-- colours come from MeshMeta so outfits can recolour the part
				for _, child in d:GetChildren() do
					if child:IsA("SurfaceAppearance") then
						local okRead, colorMap = pcall(function()
							return child.ColorMap
						end)
						if okRead and colorMap ~= nil and tostring(colorMap) ~= "" then
							child:Destroy()
						end
					elseif child:IsA("Decal") or child:IsA("Texture") then
						child:Destroy()
					end
				end
				d.TextureID = ""
				parts[name] = d
				templates[name] = d
				found += 1
			else
				unknown += 1
			end
		end
	end
	if unknown > 0 then
		warn(("[AssetService] %s: %d meshes matched, %d unrecognised names (e.g. check the pack was imported unchanged)"):format(container.Name, found, unknown))
	end
	solveImport(container.Name, templates)
end

function AssetService.load()
	MeshKit.setYawFix(AssetIds.YawFix)
	local cache = Instance.new("Folder")
	cache.Name = "AftertideMeshCache"
	cache.Parent = ServerStorage
	local manual = ServerStorage:FindFirstChild("Assets")
	for pack, id in AssetIds.Packs do
		local source = manual and manual:FindFirstChild(pack)
		if source then
			index(source)
		elseif type(id) == "number" and id > 0 then
			local ok, result = pcall(function()
				return InsertService:LoadAsset(id)
			end)
			if ok and result then
				result.Name = pack
				result.Parent = cache
				index(result)
			else
				warn(("[AssetService] could not load pack %s (%s): %s"):format(pack, tostring(id), tostring(result)))
			end
		end
	end
	local count = 0
	for _ in parts do
		count += 1
	end
	print(("[AssetService] %d sculpted meshes available"):format(count))
	loaded = true
end

function AssetService.waitReady(timeout)
	local deadline = os.clock() + (timeout or 20)
	while not loaded and os.clock() < deadline do
		task.wait(0.1)
	end
	return loaded
end

-- A fresh clone of a mesh by its generated name (e.g. "Crew_mara_Head_Skin"), or nil.
function AssetService.part(name)
	local template = parts[name]
	return template and template:Clone() or nil
end

-- True when a kit (from MeshMeta) is loaded well enough to use: nearly every layer present.
-- A detail layer that's missing (e.g. an older revision of the pack still being served while
-- the new one is reviewed) is simply skipped by MeshKit instead of failing the whole body.
function AssetService.hasKit(kit)
	local entry = MeshMeta[kit]
	if not entry then
		return false
	end
	local groups = entry.type == "rig" and entry.segments or { entry }
	local total, present = 0, 0
	for _, group in groups do
		for _, layer in group.layers do
			total += 1
			if parts[layer.part] then
				present += 1
			end
		end
	end
	return total > 0 and present / total >= 0.85
end

function AssetService.meta(kit)
	return MeshMeta[kit]
end

function AssetService.start()
	AssetService.load()
end

return AssetService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000031"><Properties><string name="Name">CharacterService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Spawns crew characters (never the player's Roblox avatar), and owns health, downed state,
-- revives and bleed-out. Health is our own "HP" attribute: the Humanoid is never damaged.
--
-- Realistic characters: if ServerStorage > Rigs contains a custom R15-compatible model for
-- the crew member (Config/Rigs), it is used. Otherwise Marketplace body parts from
-- Config/Rigs.BodyParts, otherwise the faceless placeholder mannequin.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local StarterPlayer = game:GetService("StarterPlayer")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Characters = require(Shared.Config.Characters)
local Game = require(Shared.Config.Game)
local Stats = require(Shared.Stats)
local Net = require(Shared.Net)
local Geometry = require(Shared.Util.Geometry)
local Rigs = require(Shared.Config.Rigs)
local BodyBuilder = require(Shared.BodyBuilder)
local MeshKit = require(Shared.MeshKit)
local AssetIds = require(Shared.Config.AssetIds)
local Cosmetics = require(Shared.Config.Cosmetics)

local CharacterService = {}
local CREW_SCALE = 0.88 -- sculpt units -> studs (a 6-unit sculpt is ~5.3 studs, a 1.75 m person)
local Services

local sessions = {} -- [Player] = session

local function newSession()
	return {
		charId = nil,
		perkId = nil,
		mods = Stats.compute(nil, nil),
		hp = Game.MaxHP,
		downed = false,
		out = false,
		bleedOutAt = 0,
		busyUntil = 0,
		channelId = 0,
		abilityReadyAt = 0,
		fireReadyAt = 0,
		shoveReadyAt = 0,
		calmUntil = 0,
		graceUntil = 0,
		usedSecondWind = false,
		usedResupply = false,
		stats = { takedowns = 0, detections = 0, crates = 0, kills = 0 },
		runId = nil,
		run = { weapons = {}, general = {}, perks = {} }, -- workbench upgrades this run
	}
end

function CharacterService.getSession(player)
	local session = sessions[player]
	if not session and player.Parent then
		session = newSession()
		sessions[player] = session
	end
	return session
end

function CharacterService.setCharacter(player, charId, perkId)
	local session = sessions[player]
	if not session or not Characters.List[charId] then
		return false
	end
	if not Stats.findPerk(charId, perkId) then
		perkId = Characters.List[charId].perks[1].id
	end
	session.charId = charId
	session.perkId = perkId
	CharacterService.refreshMods(player)
	player:SetAttribute("CharId", charId)
	player:SetAttribute("PerkId", perkId)
	return true
end

function CharacterService.publishRun(player)
	local session = sessions[player]
	if session then
		player:SetAttribute("RunUpgrades", HttpService:JSONEncode(session.run))
	end
end

function CharacterService.refreshMods(player)
	local session = sessions[player]
	if not session then
		return
	end
	session.mods = Stats.compute(session.charId, session.perkId, session.run.perks)
	CharacterService.publishRun(player)
end

-- Starts a new crossing for this player: fresh loadout (+ homebase bonuses), no upgrades.
function CharacterService.beginRun(player, runId, bonus)
	local session = CharacterService.getSession(player)
	if not session or not session.charId then
		return false
	end
	session.runId = runId
	session.run = { weapons = {}, general = {}, perks = {} }
	session.usedSecondWind = false
	session.usedResupply = false
	session.stats = { takedowns = 0, detections = 0, crates = 0, kills = 0 }
	CharacterService.refreshMods(player)
	Services.InventoryService.reset(player, Characters.List[session.charId].loadout, session.mods, bonus)
	return true
end

function CharacterService.endRun(player)
	local session = sessions[player]
	if session then
		session.runId = nil
		session.run = { weapons = {}, general = {}, perks = {} }
		CharacterService.refreshMods(player)
	end
end

function CharacterService.setGrace(player, seconds)
	local session = sessions[player]
	if session then
		session.graceUntil = math.max(session.graceUntil, os.clock() + seconds)
	end
end

-- Removes Roblox's animation system from a rig so procedural Motor6D.Transform writes stick.
function CharacterService.stripAnimator(model)
	local animate = model:FindFirstChild("Animate")
	if animate then
		animate:Destroy()
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		for _, child in humanoid:GetChildren() do
			if child:IsA("Animator") then
				child:Destroy()
			end
		end
		humanoid.ChildAdded:Connect(function(child)
			if child:IsA("Animator") then
				task.defer(function()
					child:Destroy()
				end)
			end
		end)
	end
end

-- The crew member's definition with their equipped outfit's colours (for the part-built body).
function CharacterService.dressedDef(player, charId)
	local base = Characters.List[charId]
	local outfit = Cosmetics.Outfits[Services.CosmeticsService.equippedFor(player, charId)]
	if not outfit or next(outfit.colors) == nil then
		return base
	end
	local def = table.clone(base)
	def.colors = table.clone(base.colors)
	def.outfit = table.clone(base.outfit or {})
	local c = outfit.colors
	if c.top then
		def.colors.torso, def.colors.arms = c.top, c.top
	end
	if c.pants then
		def.colors.legs = c.pants
	end
	def.outfit.hatColor = c.hat or def.outfit.hatColor
	def.outfit.boots = c.boots or def.outfit.boots
	def.outfit.pack = c.pack or def.outfit.pack
	def.outfit.scarf = c.scarf or def.outfit.scarf
	def.outfit.mask = c.mask or def.outfit.mask
	return def
end

local function buildDescription(def, charId)
	local desc = Instance.new("HumanoidDescription")
	desc.HeightScale = def.height or 1
	desc.WidthScale = 0.82
	desc.DepthScale = 0.85
	desc.HeadScale = 0.88
	desc.ProportionScale = 0
	desc.BodyTypeScale = 0
	local c = def.colors
	desc.HeadColor = c.skin
	desc.TorsoColor = c.torso
	desc.LeftArmColor = c.arms
	desc.RightArmColor = c.arms
	desc.LeftLegColor = c.legs
	desc.RightLegColor = c.legs
	local parts = Rigs.BodyParts[charId]
	if parts then
		for slot, assetId in parts do
			if type(assetId) == "number" and assetId > 0 then
				pcall(function()
					desc[slot] = assetId
				end)
			end
		end
	end
	return desc
end

local function customRig(charId)
	local folder = ServerStorage:FindFirstChild("Rigs")
	local name = Rigs.Custom[charId]
	local template = folder and name and folder:FindFirstChild(name)
	if template and template:IsA("Model") and template:FindFirstChildOfClass("Humanoid") and template:FindFirstChild("HumanoidRootPart") then
		return template
	end
	return nil
end

-- Spawns a custom rig as the player's character (keeps Animate if the rig contains one).
local function spawnCustomRig(player, template)
	local rig = template:Clone()
	rig.Name = player.Name
	local old = player.Character
	for _, child in StarterPlayer:WaitForChild("StarterCharacterScripts"):GetChildren() do
		if not rig:FindFirstChild(child.Name) then
			child:Clone().Parent = rig
		end
	end
	player.Character = rig
	rig.Parent = Workspace
	if old and old ~= rig then
		old:Destroy()
	end
	pcall(function()
		rig.HumanoidRootPart:SetNetworkOwner(player)
	end)
	return rig
end

local function setupCharacter(player, char, session, isCustomRig)
	local humanoid = char:WaitForChild("Humanoid")
	local root = char:WaitForChild("HumanoidRootPart")
	local head = char:WaitForChild("Head")
	-- new-style rigs use AnimationConstraints; our animation and fitting need Motor6Ds
	local converted = MeshKit.ensureMotors(char)
	if converted > 0 then
		print(("[CharacterService] converted %d AnimationConstraint joints to Motor6D for %s"):format(converted, player.Name))
	end
	humanoid.RequiresNeck = false -- health is ours; a joint change must never kill the Humanoid
	humanoid.UseJumpPower = true
	humanoid.JumpPower = 34 -- a short hop (about 3 studs); taller obstacles are vaulted
	-- never fall over or ragdoll from physics: that is the "randomly tipped over" jank
	humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)
	humanoid.MaxSlopeAngle = 55
	humanoid.BreakJointsOnDeath = false
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.NameDisplayDistance = 60
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)

	if not isCustomRig then
		-- Replace the Roblox look and motion: sculpted, clothed body + our own animation
		-- (client PlayerAnimator) instead of the default Animate script.
		-- Our animation is procedural (client PlayerAnimator writes every Motor6D.Transform).
		-- While an Animator exists Roblox overwrites those writes every frame, so remove the
		-- default Animate script AND the Animator, and keep the Animator from coming back.
		CharacterService.stripAnimator(char)
		local kit = "Crew_" .. session.charId
		local ok, err
		if Services.AssetService.hasKit(kit) then
			-- sculpted, realistic crew model fitted onto the skeleton
			local colors = Services.CosmeticsService.layerColors(player, session.charId)
			local meta = Services.AssetService.meta(kit)
			-- rebuild the skeleton to the sculpt's proportions first, so every piece fits its bone
			local okFit, hip = pcall(MeshKit.conformSkeleton, char, meta, "r15", CREW_SCALE)
			if okFit and hip then
				humanoid.HipHeight = hip
				char:SetAttribute("BaseHipHeight", hip)
			elseif not okFit then
				warn("[CharacterService] skeleton fit failed: " .. tostring(hip))
			end
			ok, err = pcall(MeshKit.applyRig, char, meta, Services.AssetService.part, "r15", AssetIds.YawFix, colors)
		else
			ok, err = pcall(BodyBuilder.build, char, CharacterService.dressedDef(player, session.charId))
		end
		if not ok then
			warn("[CharacterService] body build failed: " .. tostring(err))
		end
		char:SetAttribute("Procedural", true)
	end

	CharacterService.addFlashlight(char)

	char:SetAttribute("HP", session.hp)
	char:SetAttribute("MaxHP", session.maxHp or Game.MaxHP)
	char:SetAttribute("Downed", false)
	char:SetAttribute("Out", false)
	char:SetAttribute("Torch", false)
	char:SetAttribute("Stance", "Stand")
	char:SetAttribute("Sprint", false)
	char:SetAttribute("Aim", false)
	char:SetAttribute("BusyUntil", 0)
	char:SetAttribute("Noise", 0)
	char:SetAttribute("AbilityReadyAt", 0)
	char:SetAttribute("CharId", session.charId)
	char:SetAttribute("Supporter", player:GetAttribute("Supporter") == true)
	if char:GetAttribute("BaseHipHeight") == nil then
		char:SetAttribute("BaseHipHeight", humanoid.HipHeight)
	end
	humanoid.DisplayName = (player:GetAttribute("Supporter") and "◆ " or "") .. player.DisplayName
	return root
end

-- (Re)spawns the player's chosen crew member at `cframe`.
-- resetInventory: give a fresh loadout (outside a run). During a run the satchel is kept.
function CharacterService.spawn(player, cframe, resetInventory)
	local session = sessions[player]
	if not session or not session.charId then
		return nil
	end
	local def = Characters.List[session.charId]

	session.maxHp = Game.MaxHP + (Services.PlayerDataService.hasRepair(player, "sickbay") and 15 or 0) -- Infirmary
	session.hp = session.maxHp
	session.downed = false
	session.out = false
	session.busyUntil = 0
	session.channelId += 1
	session.abilityReadyAt = 0
	session.calmUntil = 0

	local char
	local template = customRig(session.charId)
	if template then
		char = spawnCustomRig(player, template)
	else
		local spawned
		local conn = player.CharacterAdded:Connect(function(c)
			spawned = c
		end)
		local ok, err = pcall(function()
			player:LoadCharacterWithHumanoidDescription(buildDescription(def, session.charId))
		end)
		local deadline = os.clock() + 8
		while ok and not spawned and player.Parent and os.clock() < deadline do
			task.wait()
		end
		conn:Disconnect()
		if not ok then
			warn("[CharacterService] spawn failed: " .. tostring(err))
			return nil
		end
		char = spawned or player.Character
		-- wait until Roblox has applied the body scales: the sculpted body is fitted to the
		-- final joint positions, so fitting too early would leave it the wrong size
		local appearanceDeadline = os.clock() + 1.5
		while char and char.Parent and os.clock() < appearanceDeadline do
			local hum = char:FindFirstChildOfClass("Humanoid")
			if player:HasAppearanceLoaded() or (hum and hum:FindFirstChildOfClass("HumanoidDescription")) then
				break
			end
			task.wait()
		end
	end
	if not char then
		return nil
	end
	setupCharacter(player, char, session, template ~= nil)
	CharacterService.setGrace(player, 3)
	char:PivotTo(cframe)
	if resetInventory or not Services.InventoryService.has(player) then
		Services.InventoryService.reset(player, def.loadout, session.mods)
	else
		Services.InventoryService.publish(player)
	end
	Services.WeaponService.onSpawn(player, char)
	return char
end

-- A flashlight clipped to the left chest strap: a shadow-casting spotlight plus a soft
-- visible beam (light shaft) through the fog. Same rig is used by human enemies.
function CharacterService.addFlashlight(char, bodyName)
	local body = char:FindFirstChild(bodyName or "UpperTorso") or char:FindFirstChild("Torso")
	if not body or body:FindFirstChild("FlashlightMount") then
		return
	end
	local mount = Instance.new("Attachment")
	mount.Name = "FlashlightMount"
	mount.Position = Vector3.new(-body.Size.X * 0.22, body.Size.Y * 0.18, -body.Size.Z * 0.5 - 0.45) -- ahead of the chest so the body doesn't shadow it
	mount.Parent = body
	local light = Instance.new("SpotLight")
	light.Name = "Flashlight"
	light.Angle = 42
	light.Range = 75
	light.Brightness = 3.4
	light.Color = Color3.fromRGB(255, 244, 222)
	light.Shadows = true
	light.Face = Enum.NormalId.Front
	light.Enabled = false
	light.Parent = mount
	local far = Instance.new("Attachment")
	far.Name = "FlashlightFar"
	far.Position = mount.Position + Vector3.new(0, -0.6, -24)
	far.Parent = body
	local beam = Instance.new("Beam")
	beam.Name = "FlashlightBeam"
	beam.Attachment0 = mount
	beam.Attachment1 = far
	beam.Width0 = 0.5
	beam.Width1 = 9
	beam.FaceCamera = true
	beam.LightEmission = 0.6
	beam.LightInfluence = 0
	beam.Color = ColorSequence.new(Color3.fromRGB(255, 246, 228))
	beam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.82), NumberSequenceKeypoint.new(0.6, 0.94), NumberSequenceKeypoint.new(1, 1) })
	beam.Segments = 1
	beam.Enabled = false
	beam.Parent = body
end

function CharacterService.setFlashlight(char, on)
	local light = char:FindFirstChild("Flashlight", true)
	local beam = char:FindFirstChild("FlashlightBeam", true)
	if light then
		light.Enabled = on
	end
	if beam then
		beam.Enabled = on
	end
	char:SetAttribute("Torch", on)
end

function CharacterService.toggleFlashlight(char)
	local light = char:FindFirstChild("Flashlight", true)
	CharacterService.setFlashlight(char, not (light and light.Enabled))
end

function CharacterService.heal(player, amount)
	local session = sessions[player]
	local char = player.Character
	if not session or not char or session.downed or session.out then
		return
	end
	session.hp = math.min(session.maxHp or Game.MaxHP, session.hp + amount)
	char:SetAttribute("HP", session.hp)
end

local function removeRevivePrompt(char)
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local prompt = root and root:FindFirstChild("Revive")
	if prompt then
		prompt:Destroy()
	end
end

function CharacterService.revive(player, hp)
	local session = sessions[player]
	local char = player.Character
	if not session or not char or not session.downed or session.out then
		return false
	end
	session.downed = false
	session.hp = math.clamp(hp, 1, session.maxHp or Game.MaxHP)
	char:SetAttribute("Downed", false)
	char:SetAttribute("HP", session.hp)
	removeRevivePrompt(char)
	Net.notifyAll("Toast", { text = player.DisplayName .. " is back up" })
	return true
end

function CharacterService.markOut(player)
	local session = sessions[player]
	if not session or session.out then
		return
	end
	session.out = true
	local char = player.Character
	if char then
		char:SetAttribute("Out", true)
		removeRevivePrompt(char)
	end
	Net.notifyAll("Toast", { text = player.DisplayName .. " was lost to the Pall" })
	Services.MatchService.onPlayerDowned(player)
end

function CharacterService.down(player)
	local session = sessions[player]
	local char = player.Character
	if not session or not char or session.downed then
		return
	end
	if session.grabbing then
		local info = { session = session, char = char, root = char:FindFirstChild("HumanoidRootPart") }
		pcall(Services.ActionService.releaseGrab, player, info, false)
	end
	session.downed = true
	session.hp = 0
	session.channelId += 1
	Services.WeaponService.onDowned(player)
	local bleed = Game.BleedOutTime + session.mods.bleedOutBonus
	session.bleedOutAt = os.clock() + bleed
	char:SetAttribute("Downed", true)
	char:SetAttribute("HP", 0)
	char:SetAttribute("BleedOutAt", Workspace:GetServerTimeNow() + bleed)
	char:SetAttribute("Torch", false)
	CharacterService.setFlashlight(char, false)

	local root = char:FindFirstChild("HumanoidRootPart")
	if root then
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "Revive"
		prompt.ActionText = "Revive"
		prompt.ObjectText = player.DisplayName
		prompt.HoldDuration = Game.ReviveTime
		prompt.MaxActivationDistance = 8
		prompt.RequiresLineOfSight = false
		prompt.GamepadKeyCode = Enum.KeyCode.ButtonA
		prompt.Parent = root
		prompt.Triggered:Connect(function(reviver)
			if reviver == player then
				return
			end
			local info = Services.MatchService.getActiveInfo(reviver)
			if not info or (info.root.Position - root.Position).Magnitude > 12 then
				return
			end
			local reviverSession = sessions[reviver]
			CharacterService.revive(player, Game.ReviveHP + reviverSession.mods.reviveHPBonus)
		end)
	end

	Net.notifyAll("Toast", { text = player.DisplayName .. " is down!" })
	Services.MatchService.onPlayerDowned(player)
end

-- Damage from a Hushed grab. `fromPosition` drives the knockback direction.
function CharacterService.damage(player, amount, fromPosition)
	local session = sessions[player]
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not session or not root or session.downed or session.out then
		return
	end
	if os.clock() < (session.dodgeUntil or 0) then
		Net.notify(player, "Toast", { text = "Dodged!" })
		return
	end
	amount *= session.mods.damageTakenMult
	session.hp = math.max(0, session.hp - amount)
	session.channelId += 1 -- interrupts healing/crafting
	char:SetAttribute("HP", session.hp)
	char:SetAttribute("BusyUntil", 0)
	session.busyUntil = 0

	if fromPosition then
		local away = Geometry.flat(root.Position - fromPosition)
		if away.Magnitude > 0.01 then
			CharacterService.setGrace(player, 1.5)
			Net.notify(player, "Knockback", { velocity = away.Unit * 24 + Vector3.new(0, 8, 0) })
		end
	end
	Net.notify(player, "Hurt", { amount = amount })
	if player.Character then
		player.Character:SetAttribute("HurtAt", Workspace:GetServerTimeNow()) -- everyone sees the flinch
		player.Character:SetAttribute("HurtFrom", fromPosition)
	end

	if session.hp <= 0 then
		CharacterService.down(player)
	end
end

function CharacterService.init(registry)
	Services = registry
end

function CharacterService.start()
	Players.PlayerAdded:Connect(function(player)
		CharacterService.getSession(player)
	end)
	for _, player in Players:GetPlayers() do
		if not sessions[player] then
			sessions[player] = newSession()
		end
	end
	Players.PlayerRemoving:Connect(function(player)
		sessions[player] = nil
	end)

	-- Stance/sprint/aim replicate as character attributes (used by AI, noise and other clients).
	Net.onServer("SetMoveState", 15, function(player, stance, sprinting, aiming)
		if stance ~= "Stand" and stance ~= "Crouch" and stance ~= "Prone" then
			return
		end
		local char = player.Character
		local session = sessions[player]
		if not char or not session or session.downed then
			return
		end
		char:SetAttribute("Stance", stance)
		char:SetAttribute("Sprint", sprinting == true and stance == "Stand")
		char:SetAttribute("Aim", aiming == true)
	end)

	while true do
		task.wait(0.5)
		local now = os.clock()
		for player, session in sessions do
			if session.downed and not session.out and now >= session.bleedOutAt then
				CharacterService.markOut(player)
			end
		end
	end
end

return CharacterService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000032"><Properties><string name="Name">CommerceService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Developer product receipts. Rules that matter:
--   * Idempotent: a receipt (PurchaseId) is granted exactly once, even if Roblox retries.
--   * Only report PurchaseGranted once the grant is saved (or we're in memory-only Studio mode).
--   * Purchases grant TOKENS (persistent). Using a token is a separate, limited action
--     (Second Wind: once per crossing). If you're downed when a Second Wind purchase
--     completes, it is used straight away.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Commerce = require(Shared.Config.Commerce)
local Net = require(Shared.Net)

local CommerceService = {}
local Services

local byProductId = {}

local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = Services.PlayerDataService.waitFor(player, 10)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local entry = byProductId[receipt.ProductId]
	if not entry then
		warn("[Commerce] unknown product id " .. tostring(receipt.ProductId) .. ": add it to Config/Commerce.luau")
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if Services.PlayerDataService.hasReceipt(player, receipt.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	local grant = entry.product.grant
	local data_ = Services.PlayerDataService.get(player)
	if grant.oneTime and data_.oneTime[entry.key] then
		-- already bought (e.g. a second prompt slipped through): give the tokens anyway so
		-- nobody loses Robux, but the outfits are already owned
		warn("[Commerce] one-time product bought again by " .. player.Name .. ": " .. entry.key)
	end
	for kind, amount in grant.tokens or {} do
		Services.PlayerDataService.addTokens(player, kind, amount)
	end
	for kitId, amount in grant.kit or {} do
		data_.kit = data_.kit or {}
		data_.kit[kitId] = (data_.kit[kitId] or 0) + amount
		Services.PlayerDataService.publish(player)
	end
	if grant.scrip then
		Services.PlayerDataService.addScrip(player, grant.scrip)
	end
	if grant.outfit then
		Services.PlayerDataService.ownOutfit(player, grant.outfit)
	end
	for _, outfitId in grant.outfits or {} do
		Services.PlayerDataService.ownOutfit(player, outfitId)
	end
	if grant.oneTime then
		Services.PlayerDataService.markOneTime(player, entry.key)
	end
	data_.spent = (data_.spent or 0) + (receipt.CurrencySpent or entry.product.price or 0)
	Services.AnalyticsHelper.purchase(player, entry.key, receipt.CurrencySpent)
	Services.PlayerDataService.recordReceipt(player, receipt.PurchaseId)

	if not Services.PlayerDataService.save(player) and not Services.PlayerDataService.isMemoryOnly() then
		-- Granted in memory and receipt recorded, so a retry in this session won't double-grant.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	Net.notify(player, "Toast", { text = "Thank you! " .. entry.product.name .. " added." })
	if grant.outfit then
		task.defer(Services.CosmeticsService.equip, player, grant.outfit)
	end
	if grant.tokens and grant.tokens.spin then
		Net.notify(player, "OpenSpin", {})
	end
	if entry.key == "AmmoCache" or entry.key == "AmmoCache5" then
		task.defer(function()
			if Services.MatchService.getActiveInfo(player) then
				Services.ActionService.useAmmoCache(player)
			end
		end)
	end
	if entry.key == "SecondWind" or entry.key == "SecondWind3" then
		task.defer(function()
			local session = Services.CharacterService.getSession(player)
			if session and session.downed and not session.usedSecondWind then
				Services.ActionService.useSecondWind(player)
			end
		end)
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function CommerceService.init(registry)
	Services = registry
	for key, product in Commerce.Products do
		if product.productId and product.productId ~= 0 then
			byProductId[product.productId] = { key = key, product = product }
		end
	end
end

function CommerceService.start()
	MarketplaceService.ProcessReceipt = processReceipt
end

return CommerceService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000033"><Properties><string name="Name">CosmeticsService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The Wardrobe (server side): who owns which outfit, buying outfits with Scrip, equipping,
-- the Supporter game pass, and the colours a crew member should be dressed in.
-- Cosmetic only: nothing here touches stats.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Commerce = require(Shared.Config.Commerce)
local Cosmetics = require(Shared.Config.Cosmetics)
local Net = require(Shared.Net)

local CosmeticsService = {}
local Services

local supporter = {} -- [Player] = true

function CosmeticsService.isSupporter(player)
	return supporter[player] == true
end

local function setSupporter(player, on)
	supporter[player] = on or nil
	player:SetAttribute("Supporter", on == true)
end

function CosmeticsService.owns(player, outfitId)
	local outfit = Cosmetics.Outfits[outfitId]
	if not outfit then
		return false
	end
	if outfit.unlock == "default" then
		return true
	end
	if outfit.unlock == "supporter" then
		return supporter[player] == true
	end
	local data = Services.PlayerDataService.get(player)
	return data ~= nil and data.outfits[outfitId] == true
end

-- The outfit a player has on for a crew member (falls back to the default if not owned).
function CosmeticsService.equippedFor(player, charId)
	local data = Services.PlayerDataService.get(player)
	local id = data and data.equipped[charId]
	if id and Cosmetics.Outfits[id] and Cosmetics.Outfits[id].char == charId and CosmeticsService.owns(player, id) then
		return id
	end
	return Cosmetics.defaultFor(charId)
end

function CosmeticsService.layerColors(player, charId)
	return Cosmetics.layerColors(CosmeticsService.equippedFor(player, charId))
end

-- Scrip multiplier for crossing rewards (Supporter pass).
function CosmeticsService.scripMult(player)
	return supporter[player] and (1 + (Commerce.Passes.Supporter.scripBonus or 0)) or 1
end

local function respawnIfOnFerry(player)
	-- show the new look straight away when it's safe (not mid-encounter)
	local session = Services.CharacterService.getSession(player)
	if session and session.charId and not Services.MatchService.getActiveInfo(player) and player.Character then
		local root = player.Character:FindFirstChild("HumanoidRootPart")
		if root then
			Services.CharacterService.spawn(player, root.CFrame, false)
		end
	end
end

function CosmeticsService.equip(player, outfitId)
	local outfit = type(outfitId) == "string" and Cosmetics.Outfits[outfitId]
	if not outfit or not CosmeticsService.owns(player, outfitId) then
		return
	end
	Services.PlayerDataService.setEquipped(player, outfit.char, outfitId)
	if player:GetAttribute("CharId") == outfit.char then
		respawnIfOnFerry(player)
	end
end

function CosmeticsService.buyWithScrip(player, outfitId)
	local outfit = type(outfitId) == "string" and Cosmetics.Outfits[outfitId]
	if not outfit or not outfit.scrip or outfit.scrip <= 0 or CosmeticsService.owns(player, outfitId) then
		return
	end
	if not Services.PlayerDataService.spendScrip(player, outfit.scrip) then
		Net.notify(player, "Toast", { text = ("Not enough Scrip (%d needed). Earn it by finishing crossings."):format(outfit.scrip) })
		return
	end
	Services.PlayerDataService.ownOutfit(player, outfitId)
	Services.AnalyticsHelper.economy(player, "sink", outfit.scrip, Enum.AnalyticsEconomyTransactionType.Shop.Name, outfitId)
	Net.notify(player, "Toast", { text = outfit.name .. " added to your wardrobe" })
	CosmeticsService.equip(player, outfitId)
end

function CosmeticsService.init(registry)
	Services = registry
end

local function checkPass(player)
	local passId = Commerce.Passes.Supporter.passId
	if not passId or passId == 0 then
		return
	end
	local ok, owns = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, passId)
	end)
	if ok then
		setSupporter(player, owns)
	end
end

function CosmeticsService.start()
	Players.PlayerAdded:Connect(function(player)
		task.spawn(checkPass, player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(checkPass, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		supporter[player] = nil
	end)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if purchased and passId == Commerce.Passes.Supporter.passId then
			setSupporter(player, true)
			Services.AnalyticsHelper.purchase(player, "Pass_Supporter", Commerce.Passes.Supporter.price)
			Net.notify(player, "Toast", { text = "Welcome aboard, Supporter. Officer's colours are in your wardrobe." })
		end
	end)
end

return CosmeticsService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000034"><Properties><string name="Name">EnemyService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The Hushed. Server-simulated, one state machine per enemy:
--   Patrol -> (notice) -> Investigate -> Search -> Patrol
--   any    -> (suspicion >= 1 or shot) -> Chase -> (lost sight) -> Search
--   Stunned / Pinned / Quieted are timed overrides.
-- Types (Config/Enemies): Drifter, Bellwether (hums to alert others), Tidewalker (tank).
-- Encounter behaviours: `objective` (walk to and attack the signal lantern) and `hunt`
-- (periodically told roughly where the players are).
-- Replicated model attributes: State, Target (UserId), Sus_<UserId>, Type, HP (0..1).
local PathfindingService = game:GetService("PathfindingService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local EnemyConfig = require(Shared.Config.Enemies)
local AssetIds = require(Shared.Config.AssetIds)
local MeshKit = require(Shared.MeshKit)
local Geometry = require(Shared.Util.Geometry)
local Sfx = require(Shared.Util.Sfx)
local Net = require(Shared.Net)

local EnemyService = {}
local Services

local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local folder
local enemies = {}
local byModel = {}
local fireZones = {}
local rng = Random.new()
local occlusionParams = RaycastParams.new()
occlusionParams.FilterType = Enum.RaycastFilterType.Exclude

-- Model -----------------------------------------------------------------------------------

local RAG_COLORS = {
	Color3.fromRGB(70, 66, 58), Color3.fromRGB(58, 64, 70), Color3.fromRGB(86, 70, 52),
	Color3.fromRGB(64, 58, 66), Color3.fromRGB(92, 88, 78), Color3.fromRGB(54, 60, 52),
}

-- Builds a jointed body (Motor6D skeleton) so clients can animate it procedurally:
--   Root -> Torso (Waist) -> Head (Neck), UpperArms (Shoulders) -> LowerArms (Elbows)
--   Root -> UpperLegs (Hips) -> LowerLegs (Knees)
-- Each type gets its own proportions, head shape, salt-crust growths and clothing rags.
local function buildModel(position, typeName, cfg)
	local k = cfg.scale
	local body = cfg.body
	local model = Instance.new("Model")
	model.Name = "Hushed_" .. typeName

	local legLen = 1.6 * body.legs
	-- legs end 0.2 + 2*legLen below the root centre; the root's bottom is 1 below it
	local hipHeight = (legLen * 2 - 0.8) * k
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1) * k
	root.Transparency = 1
	root.CanCollide = true
	root.CFrame = CFrame.new(position + Vector3.new(0, hipHeight + 1 * k, 0))
	root.Name = "HumanoidRootPart"
	root.Parent = model
	model.PrimaryPart = root

	local base = cfg.color
	local function part(name, size, color, material, shape)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size * k
		p.Color = color or base
		p.Material = material or Enum.Material.SmoothPlastic
		if not material then
			p.Reflectance = 0.06 -- wet, charred skin
		end
		p.CanCollide = false
		p.CanTouch = false
		p.Massless = true
		if shape then
			p.Shape = shape
		end
		p.CFrame = root.CFrame
		p.Parent = model
		return p
	end
	local function joint(name, part0, part1, c0, c1)
		local m = Instance.new("Motor6D")
		m.Name = name
		m.Part0 = part0
		m.Part1 = part1
		m.C0 = CFrame.new(c0.Position * k) * c0.Rotation
		m.C1 = CFrame.new(c1.Position * k) * c1.Rotation
		m.Parent = part0
		return m
	end
	local function attach(name, target, size, offset, color, material, shape)
		local p = part(name, size, color, material, shape)
		local w = Instance.new("Weld")
		w.Part0 = target
		w.Part1 = p
		w.C0 = CFrame.new(offset.Position * k) * offset.Rotation
		w.Parent = p
		return p
	end

	local tw = body.torso
	local torso = part("Torso", Vector3.new(1.5 * tw, 2.0, 0.85 * tw))
	joint("Waist", root, torso, CFrame.new(0, 0.3, 0) * CFrame.Angles(math.rad(-body.hunch), 0, 0), CFrame.new(0, -1.0, 0))

	local CRUST = Color3.fromRGB(232, 228, 216)
	local headColor = body.head == "shell" and CRUST or Color3.new(math.min(1, base.R * 1.15), math.min(1, base.G * 1.15), math.min(1, base.B * 1.15))
	local headSize = ({
		round = Vector3.new(1.0, 1.25, 1.0),
		half = Vector3.new(0.95, 1.2, 0.95),
		shell = Vector3.new(1.55, 1.5, 1.55),
		disc = Vector3.new(1.5, 0.95, 1.5),
		sunk = Vector3.new(1.05, 1.05, 1.05),
	})[body.head] or Vector3.new(1, 1.25, 1)
	local head = part("Head", headSize, headColor, body.head == "shell" and Enum.Material.Sand or nil)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = head
	local neckY = body.head == "sunk" and 0.75 or 1.0
	joint("Neck", torso, head, CFrame.new(0, neckY, -0.1), CFrame.new(0, -headSize.Y * 0.5 + 0.1, 0.1))
	if body.head == "half" then
		-- salt has sealed half the face
		attach("FaceCrust", head, Vector3.new(0.55, 0.9, 0.5), CFrame.new(0.25, 0.05, -0.32), Color3.fromRGB(232, 228, 216), Enum.Material.Sand, Enum.PartType.Ball)
	end

	local armLen = 1.5 * body.arms
	for _, side in { -1, 1 } do
		local name = side < 0 and "Left" or "Right"
		local upper = part(name .. "UpperArm", Vector3.new(0.42 * tw, armLen, 0.42 * tw))
		local lower = part(name .. "LowerArm", Vector3.new(0.38 * tw, armLen * 1.07, 0.38 * tw))
		joint(name .. "Shoulder", torso, upper, CFrame.new(side * (0.75 * tw + 0.2), 0.85, 0) * CFrame.Angles(math.rad(8), 0, math.rad(side * 4)), CFrame.new(0, armLen * 0.5, 0))
		joint(name .. "Elbow", upper, lower, CFrame.new(0, -armLen * 0.5, 0), CFrame.new(0, armLen * 0.535, 0))
		local upperLeg = part(name .. "UpperLeg", Vector3.new(0.56 * tw, legLen, 0.56 * tw))
		local lowerLeg = part(name .. "LowerLeg", Vector3.new(0.5 * tw, legLen, 0.5 * tw))
		joint(name .. "Hip", root, upperLeg, CFrame.new(side * 0.42 * tw, -0.2, 0), CFrame.new(0, legLen * 0.5, 0))
		joint(name .. "Knee", upperLeg, lowerLeg, CFrame.new(0, -legLen * 0.5, 0), CFrame.new(0, legLen * 0.5, 0))
	end

	-- what's left of their clothes: rags over torso and thighs
	local rng = Random.new()
	local ragColor = RAG_COLORS[rng:NextInteger(1, #RAG_COLORS)]
	for i = 1, body.rags do
		local onLeg = i % 2 == 0
		local target = onLeg and model[(rng:NextNumber() < 0.5 and "Left" or "Right") .. "UpperLeg"] or torso
		local size = onLeg and Vector3.new(0.62 * tw, 0.9, 0.62 * tw) or Vector3.new(1.55 * tw, rng:NextNumber(0.5, 1.1), 0.9 * tw)
		local offset = onLeg and CFrame.new(0, rng:NextNumber(-0.2, 0.4), 0) or CFrame.new(0, rng:NextNumber(-0.6, 0.6), 0) * CFrame.Angles(0, 0, math.rad(rng:NextNumber(-10, 10)))
		attach("Rag" .. i, target, size, offset, ragColor, Enum.Material.Fabric)
	end

	-- the maw: a black, gaping hollow where the face was (clients open it when they hunt)
	if body.maw then
		local maw = attach("Maw", head, Vector3.new(headSize.X * 0.42, headSize.Y * 0.36, 0.3), CFrame.new(0, -headSize.Y * 0.12, -headSize.Z * 0.42), Color3.fromRGB(8, 6, 6), Enum.Material.SmoothPlastic)
		local mm = Instance.new("SpecialMesh")
		mm.MeshType = Enum.MeshType.Sphere
		mm.Parent = maw
	end
	-- jagged salt spines out of the back and shoulders
	for i = 1, body.spines or 0 do
		local w = Instance.new("WedgePart")
		w.Name = "Spine" .. i
		local len = rng:NextNumber(0.5, 1.3)
		w.Size = Vector3.new(0.18, len, rng:NextNumber(0.3, 0.6)) * k
		w.Color = CRUST
		w.Material = Enum.Material.Sand
		w.CanCollide = false
		w.CanTouch = false
		w.Massless = true
		w.CFrame = torso.CFrame
		w.Parent = model
		local weld = Instance.new("Weld")
		weld.Part0 = torso
		weld.Part1 = w
		weld.C0 = CFrame.new(rng:NextNumber(-0.6, 0.6) * torso.Size.X / 2, rng:NextNumber(-0.2, 0.9) * torso.Size.Y / 2, torso.Size.Z / 2 + len * 0.3 * k)
			* CFrame.Angles(math.rad(rng:NextNumber(20, 60)), math.rad(rng:NextNumber(-30, 30)), math.rad(rng:NextNumber(-25, 25)))
		weld.Parent = w
	end
	-- salt growths: lumpy crust on shoulders, back and head
	local spots = { torso, torso, head, model.LeftUpperArm, model.RightUpperArm }
	for i = 1, body.crust do
		local target = spots[(i - 1) % #spots + 1]
		local r = rng:NextNumber(0.25, 0.6) * (target == torso and 1.4 or 1)
		local offset = CFrame.new(rng:NextNumber(-0.5, 0.5) * target.Size.X / k, rng:NextNumber(-0.3, 0.5) * target.Size.Y / k, (target == head and -1 or 1) * rng:NextNumber(0.2, 0.5) * target.Size.Z / k)
		attach("Crust" .. i, target, Vector3.new(r, r * rng:NextNumber(0.7, 1.2), r), offset, CRUST, Enum.Material.Sand, Enum.PartType.Ball)
	end

	local drift = Instance.new("ParticleEmitter")
	drift.Rate = 3 + body.crust * 0.5
	drift.Lifetime = NumberRange.new(2, 3)
	drift.Speed = NumberRange.new(0.4, 1.2)
	drift.SpreadAngle = Vector2.new(180, 180)
	drift.Acceleration = Vector3.new(0, 0.8, 0)
	drift.Color = ColorSequence.new(base)
	drift.LightInfluence = 1
	drift.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.12 * k), NumberSequenceKeypoint.new(1, 0) })
	drift.Enabled = not cfg.human -- people don't shed salt
	drift.Parent = torso

	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15 -- R15 so HipHeight (not leg parts) sets floor height
	humanoid.HipHeight = hipHeight
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.WalkSpeed = 5
	humanoid.UseJumpPower = true
	humanoid.JumpPower = 0
	humanoid.AutoJumpEnabled = false
	humanoid.RequiresNeck = false
	humanoid.BreakJointsOnDeath = false
	humanoid.Parent = model
	for _, st in {
		Enum.HumanoidStateType.Climbing,
		Enum.HumanoidStateType.FallingDown,
		Enum.HumanoidStateType.Ragdoll,
		Enum.HumanoidStateType.Seated,
		Enum.HumanoidStateType.Jumping,
	} do
		humanoid:SetStateEnabled(st, false)
	end
	model:SetAttribute("Type", typeName)
	model:SetAttribute("Gait", cfg.gait or "shamble")
	model:SetAttribute("HP", 1)
	return model, humanoid, root, head
end

-- Callouts ----------------------------------------------------------------------------------
-- The Harbour Watch and the Tidebound talk to each other like people: they have names, call out
-- what they see, order a flank, react when a friend goes down. Clients show a bubble over the
-- speaker and a subtitle; the voice blip is played by the sound system.
local NAME_POOL = {
	Watch = { "Dale", "Rook", "Imogen", "Hobbs", "Wren", "Cutter", "Marlow", "Pike", "Okoye", "Lena", "Garrick", "Teague" },
	Tidebound = { "Ash", "Wake", "Tern", "Kelp", "Brine", "Gull", "Reed", "Marrow", "Silt", "Wrack" },
}
local LINES = {
	Watch = {
		spotted = { "Contact!", "I see them!", "There! Over there!", "Found one!", "Hostile! Hostile!" },
		lost = { "Where'd they go?", "Lost them. Spread out!", "Check the corners.", "They can't have gone far.", "Sweep left!" },
		flank = { "%s, flank them!", "%s, get round the side!", "%s, go wide!", "Push left, %s!", "%s, cut them off!" },
		ack = { "Moving!", "On it!", "Going round!", "Got it!" },
		down = { "%s is down!", "No! %s!", "Man down!", "They got %s!" },
		heard = { "What was that?", "Did you hear that?", "Check it out.", "Stay sharp.", "Something's out there." },
		hostage = { "Let them go!", "I can't get a clean shot!", "Hold your fire!" },
		idle = { "All quiet.", "I hate this fog.", "Keep your eyes open.", "My boots are killing me.", "Smell that? Salt." },
		hurt = { "I'm hit!", "Argh!", "Cover me!" },
	},
	Tidebound = {
		spotted = { "The Pall sees you!", "Unclean!", "Ring the bell!", "They walk the tide line!" },
		lost = { "The tide takes them.", "Be still... listen...", "They hide in the grass." },
		flank = { "Brother %s, circle them.", "%s, along the water!", "%s, cut them off!" },
		ack = { "The tide guides me.", "Yes, brother.", "Hush..." },
		down = { "%s has gone to the deep!", "Not %s!", "The tide takes %s." },
		heard = { "Something stirs...", "Quiet. Listen.", "The Pall whispers." },
		hostage = { "Spare them!", "Let go of my brother!" },
		idle = { "Be still.", "The tide turns.", "Hush, hush." },
		hurt = { "It burns!", "The deep calls..." },
	},
}
local usedNames = {}

local function assignIdentity(e)
	local faction = e.cfg.faction or "Watch"
	local pool = NAME_POOL[faction] or NAME_POOL.Watch
	local name
	for _ = 1, 8 do
		name = pool[rng:NextInteger(1, #pool)]
		if not usedNames[name] then
			break
		end
	end
	usedNames[name] = true
	e.name = name
	e.voice = ({ "A", "B", "C" })[rng:NextInteger(1, 3)]
	e.model:SetAttribute("CalloutName", name)
end

-- kind: spotted / lost / flank / ack / down / heard / hostage / idle / hurt
function EnemyService.say(e, kind, arg)
	if e.dead or not e.cfg.human or not e.name then
		return
	end
	local now = os.clock()
	if now < (e.sayAt or 0) and kind ~= "down" and kind ~= "flank" and kind ~= "ack" then
		return
	end
	local pool = (LINES[e.cfg.faction or "Watch"] or LINES.Watch)[kind]
	if not pool then
		return
	end
	local line = pool[rng:NextInteger(1, #pool)]
	if line:find("%%s") then
		line = line:format(arg or "friend")
	end
	e.sayAt = now + 2.4
	Net.notifyAll("Callout", { model = e.model, name = e.name, text = line, kind = kind, faction = e.cfg.faction or "Watch" })
	Sfx.at(e.root.Position, "Voice_" .. e.voice, 0.8, 90, 0.07)
end

-- Another person of this faction who is also after the same player (for flank orders).
local function chaseMate(e)
	local best, bestD
	for _, o in enemies do
		if o ~= e and not o.dead and o.cfg.human and o.state == "Chase" and o.target == e.target and not o.flankUntil then
			local d = (o.root.Position - e.root.Position).Magnitude
			if d < 70 and (not bestD or d < bestD) then
				best, bestD = o, d
			end
		end
	end
	return best
end

-- Helpers ---------------------------------------------------------------------------------

local function setState(e, newState)
	if e.state == newState then
		return
	end
	e.state = newState
	e.stateTime = os.clock()
	e.waypoints = nil
	e.pathGoal = nil
	e.searchPoint = nil
	e.model:SetAttribute("State", newState)
	if newState ~= "Chase" and e.model:GetAttribute("Aiming") then
		e.model:SetAttribute("Aiming", false)
	end
end

local function face(e, position)
	local pos = e.root.Position
	local flatTarget = Vector3.new(position.X, pos.Y, position.Z)
	if (flatTarget - pos).Magnitude < 0.1 then
		return
	end
	e.root.CFrame = e.root.CFrame:Lerp(CFrame.lookAt(pos, flatTarget), 0.3)
end

local function stop(e)
	e.humanoid.WalkSpeed = 0
	e.humanoid:MoveTo(e.root.Position)
end

local function computePath(e, goal)
	e.computing = true
	e.lastPathTime = os.clock()
	local start = e.root.Position
	task.spawn(function()
		local ok = pcall(function()
			e.path:ComputeAsync(start, goal)
		end)
		e.computing = false
		if e.dead then
			return
		end
		if ok and e.path.Status == Enum.PathStatus.Success then
			e.waypoints = e.path:GetWaypoints()
			e.wpIndex = math.min(2, #e.waypoints)
		else
			e.waypoints = nil
		end
		e.pathGoal = goal
	end)
end

local function moveTo(e, goal, speed)
	local now = os.clock()
	local pos = e.root.Position
	e.humanoid.WalkSpeed = speed
	if Geometry.flatDistance(pos, goal) < 2.5 then
		e.humanoid:MoveTo(pos)
		return true
	end
	local goalChanged = not e.pathGoal or Geometry.flatDistance(e.pathGoal, goal) > 4
	if not e.computing and (goalChanged or now - e.lastPathTime > 4) then
		computePath(e, goal)
	end
	local target = goal
	if e.waypoints and e.pathGoal and Geometry.flatDistance(e.pathGoal, goal) <= 4 then
		local wp = e.waypoints[e.wpIndex]
		while wp and e.wpIndex < #e.waypoints and Geometry.flatDistance(pos, wp.Position) < 2.2 do
			e.wpIndex += 1
			wp = e.waypoints[e.wpIndex]
		end
		if wp then
			target = wp.Position
		end
	end
	e.humanoid:MoveTo(target)
	if now - e.progressTime > 2 then
		if (pos - e.progressPos).Magnitude < 1 then
			e.pathGoal = nil
			e.lastPathTime = 0
		end
		e.progressPos = pos
		e.progressTime = now
	end
	return false
end

local function findInfo(list, player)
	for _, info in list do
		if info.player == player then
			return info
		end
	end
	return nil
end

local function publishSuspicion(e, active)
	for _, info in active do
		local value = math.floor((e.suspicion[info.player] or 0) * 20 + 0.5) / 20
		local key = "Sus_" .. info.player.UserId
		if e.model:GetAttribute(key) ~= value then
			e.model:SetAttribute(key, value)
		end
	end
	local targetId = e.target and e.target.UserId or 0
	if e.model:GetAttribute("Target") ~= targetId then
		e.model:SetAttribute("Target", targetId)
	end
end

local function alertTo(e, player)
	if e.dead or e.state == "Quieted" then
		return
	end
	e.suspicion[player] = math.max(e.suspicion[player] or 0, e.cfg.alertThreshold)
end

local function hum(e, now)
	local h = e.cfg.hum
	if not h or now < (e.nextHum or 0) or not e.target then
		return
	end
	e.nextHum = now + h.cooldown
	Sfx.at(e.root.Position, "Hum", 0.8, h.radius * 2)
	Net.notifyAll("Hum", { position = e.root.Position, radius = h.radius })
	Services.PerceptionService.emitNoise(e.root.Position, h.radius, "hum", e.target)
end

-- Human combat --------------------------------------------------------------------------------

local shotParams = RaycastParams.new()
shotParams.FilterType = Enum.RaycastFilterType.Exclude

local function humanAttack(e, info, dist, seen, now)
	local cfg, atk = e.cfg, e.cfg.attack
	if now - (e.lastSeen[e.target] or 0) > cfg.loseSightTime then
		e.suspicion[e.target] = 0.6
		e.target = nil
		e.searchOrigin = e.lastKnown
		e.flankUntil = nil
		setState(e, "Search")
		EnemyService.say(e, "lost")
		return
	end
	-- teamwork: with two of them on one player, the farther one is ordered round the side
	if atk.kind ~= "melee" and now > (e.nextOrder or 0) then
		e.nextOrder = now + 9 + rng:NextNumber() * 5
		local mate = e.target and chaseMate(e)
		if mate and not e.flankUntil and rng:NextNumber() < 0.75 then
			local mateD = (mate.root.Position - info.root.Position).Magnitude
			local flanker, leader = e, mate
			if mateD > dist then
				flanker, leader = mate, e
			end
			EnemyService.say(leader, "flank", flanker.name)
			flanker.flankUntil = now + 8
			flanker.flankSide = rng:NextNumber() < 0.5 and -1 or 1
			task.delay(1.1, function()
				EnemyService.say(flanker, "ack")
			end)
		end
	end
	if e.flankUntil and now < e.flankUntil and atk.kind ~= "melee" then
		-- circling to the side while the other keeps them busy
		local toT = Geometry.flat(info.root.Position - e.root.Position)
		if toT.Magnitude > 4 then
			local right = Vector3.new(-toT.Unit.Z, 0, toT.Unit.X)
			local point = info.root.Position - toT.Unit * math.min(dist * 0.4, atk.range * 0.45) + right * e.flankSide * 15
			e.model:SetAttribute("Aiming", false)
			if moveTo(e, point, cfg.chaseSpeed) then
				e.flankUntil = nil
			end
			return
		end
	elseif e.flankUntil then
		e.flankUntil = nil
	end
	if atk.kind == "melee" then
		if dist <= atk.range then
			stop(e)
			face(e, info.root.Position)
			if now >= (e.nextShotAt or 0) then
				e.nextShotAt = now + atk.fireDelay
				e.model:SetAttribute("AttackAt", workspace:GetServerTimeNow())
				task.delay(0.25, function()
					if not e.dead and info.root.Parent and (info.root.Position - e.root.Position).Magnitude <= atk.range + 1 then
						Services.CharacterService.damage(info.player, atk.damage, e.root.Position)
						Sfx.at(info.root.Position, "MeleeHit", 0.7, 50)
					end
				end)
				Sfx.at(e.root.Position, "Swing", 0.6, 40)
			end
		elseif seen then
			e.humanoid.WalkSpeed = cfg.chaseSpeed
			e.humanoid:MoveTo(info.root.Position)
		else
			moveTo(e, e.lastKnown, cfg.chaseSpeed)
		end
		return
	end
	-- ranged: hold position and fire while in sight and range, otherwise close in
	if seen and dist <= atk.range then
		stop(e)
		face(e, info.root.Position)
		e.model:SetAttribute("Aiming", true)
		if now >= (e.nextShotAt or 0) then
			e.nextShotAt = now + atk.fireDelay * (0.8 + rng:NextNumber() * 0.5)
			local muzzle = e.head.Position + e.root.CFrame.LookVector * 1.2 - Vector3.new(0, 0.4, 0)
			local char = info.char
			local chance = atk.accuracy * math.clamp(1.15 - dist / atk.range * 0.7, 0.2, 1)
			if char:GetAttribute("Stance") == "Crouch" then
				chance *= 0.75
			end
			if info.root.AssemblyLinearVelocity.Magnitude > 14 then
				chance *= 0.7
			end
			local aim = info.root.Position + Vector3.new(0, 0.8, 0)
			-- their friend is in the way: hold fire and flank instead of shooting through them
			local hostage = EnemyService.hostageOf(info.player)
			if hostage then
				local line = aim - muzzle
				local toH = hostage.root.Position - muzzle
				local t = toH:Dot(line.Unit)
				if t > 0 and t < line.Magnitude + 1 and (toH - line.Unit * t).Magnitude < 2.8 then
					e.nextShotAt = now + 0.7
					e.flank = e.flank or (rng:NextNumber() < 0.5 and -1 or 1)
					e.humanoid.WalkSpeed = cfg.investigateSpeed
					e.humanoid:MoveTo(e.root.Position + e.root.CFrame.RightVector * e.flank * 9)
					e.model:SetAttribute("Aiming", false)
					if now > (e.nextHoldFire or 0) then
						e.nextHoldFire = now + 6
						EnemyService.say(e, "hostage")
					end
					return
				end
			end
			local hit = rng:NextNumber() < chance
			if not hit then
				aim += Vector3.new(rng:NextNumber(-3, 3), rng:NextNumber(-1, 2), rng:NextNumber(-3, 3))
			end
			shotParams.FilterDescendantsInstances = { folder }
			local result = Workspace:Raycast(muzzle, (aim - muzzle).Unit * (atk.range + 10), shotParams)
			local hitPos = result and result.Position or aim
			local hitPlayer = result and result.Instance:IsDescendantOf(char)
			if hitPlayer then
				Services.CharacterService.damage(info.player, atk.damage, nil)
			end
			Net.notifyAll("Shot", { shooter = 0, weapon = atk.weapon, from = muzzle, hits = { { position = hitPos, kind = hitPlayer and "none" or "world" } }, quiet = atk.noise < 20 })
			Services.PerceptionService.emitNoise(e.root.Position, atk.noise, "gunshot", nil)
		end
	else
		e.model:SetAttribute("Aiming", false)
		if seen then
			e.humanoid.WalkSpeed = cfg.chaseSpeed
			e.humanoid:MoveTo(info.root.Position)
		else
			moveTo(e, e.lastKnown, cfg.chaseSpeed)
		end
	end
end

-- Brain -----------------------------------------------------------------------------------

local function update(e, dt, now, active)
	local cfg = e.cfg
	if e.state == "Grabbed" then
		publishSuspicion(e, active)
		return
	end

	if now < e.stunUntil then
		stop(e)
		publishSuspicion(e, active)
		return
	elseif e.state == "Stunned" or e.state == "Pinned" then
		if e.net then
			e.net:Destroy()
			e.net = nil
		end
		setState(e, e.investigatePos and "Investigate" or "Search")
		e.searchOrigin = e.root.Position
	end

	local bestPlayer, bestSus = nil, 0
	for _, info in active do
		local p = info.player
		local sus = e.suspicion[p] or 0
		local vis = Services.PerceptionService.sightFactor(e, info)
		if vis > 0 then
			sus += vis * cfg.suspicionGain * dt
			e.lastSeen[p] = now
			if sus >= cfg.investigateThreshold then
				e.investigatePos = info.root.Position
			end
		elseif not (e.state == "Chase" and e.target == p) then
			sus -= cfg.suspicionDecay * dt
		end
		sus = math.clamp(sus, 0, 1.2)
		e.suspicion[p] = sus
		if sus > bestSus then
			bestPlayer, bestSus = p, sus
		end
	end
	for p in e.suspicion do
		if not findInfo(active, p) then
			e.suspicion[p] = nil
		end
	end

	if e.state ~= "Chase" and bestPlayer and bestSus >= cfg.alertThreshold then
		e.target = bestPlayer
		e.lastKnown = findInfo(active, bestPlayer).root.Position
		e.lastSeen[bestPlayer] = e.lastSeen[bestPlayer] or now
		setState(e, "Chase")
		Services.MatchService.onSpotted(bestPlayer, e)
		EnemyService.say(e, "spotted")
		if cfg.callout and now > (e.nextCallout or 0) then
			-- radio / bell: everyone nearby converges on the spotted player
			e.nextCallout = now + 10
			Sfx.at(e.root.Position, cfg.callout, 0.9, 140)
			Services.PerceptionService.emitNoise(e.lastKnown, 70, "callout", bestPlayer)
		end
	end

	if e.state == "Chase" then
		hum(e, now)
		local info = e.target and findInfo(active, e.target)
		if not info then
			e.target = nil
			e.searchOrigin = e.lastKnown or e.root.Position
			setState(e, "Search")
		else
			local seenRecently = now - (e.lastSeen[e.target] or 0) < 0.35
			if seenRecently then
				e.lastKnown = info.root.Position
			end
			local dist = (info.root.Position - e.root.Position).Magnitude
			if cfg.attack then
				humanAttack(e, info, dist, seenRecently, now)
				publishSuspicion(e, active)
				return
			end
			if dist <= cfg.grabRange and now >= e.recoverUntil then
				e.recoverUntil = now + cfg.grabRecover
				if not Services.ActionService.trySpikeCounter(info.player, e) then
					Services.CharacterService.damage(info.player, cfg.grabDamage, e.root.Position)
				end
			end
			if e.dead then
				return
			end
			if now < e.recoverUntil - cfg.grabRecover + 0.9 then
				stop(e)
			elseif now - (e.lastSeen[e.target] or 0) > cfg.loseSightTime then
				e.suspicion[e.target] = 0.6
				e.target = nil
				e.searchOrigin = e.lastKnown
				setState(e, "Search")
			elseif seenRecently and dist < 35 then
				e.humanoid.WalkSpeed = cfg.chaseSpeed
				e.humanoid:MoveTo(info.root.Position)
			else
				moveTo(e, e.lastKnown, cfg.chaseSpeed)
			end
		end
		publishSuspicion(e, active)
		return
	end

	if e.investigatePos and e.state ~= "Investigate" then
		setState(e, "Investigate")
	end

	if e.state == "Investigate" then
		if not e.investigatePos then
			setState(e, "Search")
		elseif bestSus >= cfg.noticeThreshold and bestSus < cfg.investigateThreshold and bestPlayer then
			stop(e)
			face(e, findInfo(active, bestPlayer).root.Position)
		elseif moveTo(e, e.investigatePos, (cfg.rushToNoise and os.clock() - (e.heardAt or 0) < 3) and cfg.chaseSpeed or cfg.investigateSpeed) then
			e.searchOrigin = e.investigatePos
			e.investigatePos = nil
			setState(e, "Search")
		end
	elseif e.state == "Search" then
		if now - e.stateTime > cfg.searchTime then
			setState(e, "Patrol")
		elseif e.searchPoint then
			if moveTo(e, e.searchPoint, cfg.patrolSpeed + 1.5) then
				e.searchPoint = nil
				e.searchPause = now + 1.2
			end
		elseif now >= (e.searchPause or 0) then
			local origin = e.searchOrigin or e.root.Position
			e.searchPoint = origin + Vector3.new(rng:NextNumber(-14, 14), 0, rng:NextNumber(-14, 14))
		else
			stop(e)
			face(e, e.root.Position + e.root.CFrame.RightVector * (rng:NextNumber() < 0.5 and -4 or 4))
		end
	else -- Patrol (or objective)
		if cfg.human and now > (e.nextIdle or math.huge) then
			e.nextIdle = now + 22 + rng:NextNumber() * 30
			EnemyService.say(e, "idle")
		end
		if bestPlayer and bestSus >= cfg.noticeThreshold then
			stop(e)
			face(e, findInfo(active, bestPlayer).root.Position)
		elseif e.objective then
			if moveTo(e, e.objective, cfg.investigateSpeed) or (e.root.Position - e.objective).Magnitude < 6 then
				stop(e)
				face(e, e.objective)
				Services.MatchService.onObjectiveAttacked(e.objectiveDps * dt)
			end
		else
			local waypoint = e.route[e.routeIndex]
			if moveTo(e, waypoint, cfg.patrolSpeed) then
				e.routeIndex = e.routeIndex % #e.route + 1
			end
		end
	end

	publishSuspicion(e, active)
end

-- Public API ------------------------------------------------------------------------------

-- opts: { route = {Vector3...}, objective = Vector3, objectiveDps = n, hunt = bool, alertTo = Player }
function EnemyService.spawn(typeName, position, opts)
	opts = opts or {}
	local cfg = EnemyConfig.Types[typeName] or EnemyConfig.Types.Drifter
	local model, humanoid, root, head = buildModel(position, typeName, cfg)
	local kit = (cfg.human and "Faction_" or "Hushed_") .. typeName
	if Services.AssetService.hasKit(kit) then
		local meta = Services.AssetService.meta(kit)
		-- the sculpt replaces the part-built rags, crust and spines (and their hit boxes)
		for _, child in model:GetChildren() do
			if child:IsA("BasePart") and child:FindFirstChildOfClass("Weld") then
				child:Destroy()
			end
		end
		local okFit, hip = pcall(MeshKit.conformSkeleton, model, meta, "enemy", 0.88 * cfg.scale)
		if okFit and hip then
			humanoid.HipHeight = hip
			root.CFrame = CFrame.new(position + Vector3.new(0, hip + root.Size.Y / 2, 0))
			MeshKit.conformSkeleton(model, meta, "enemy", 0.88 * cfg.scale) -- re-place bones around the moved root
		elseif not okFit then
			warn("[EnemyService] skeleton fit failed: " .. tostring(hip))
		end
		local okRig, err = pcall(MeshKit.applyRig, model, meta, Services.AssetService.part, "enemy", AssetIds.YawFix)
		if not okRig then
			warn("[EnemyService] mesh fit failed: " .. tostring(err))
		end
	end
	if cfg.flashlight then
		Services.CharacterService.addFlashlight(model, "Torso")
		Services.CharacterService.setFlashlight(model, true)
	end
	model:SetAttribute("Human", cfg.human == true)
	Services.CharacterService.stripAnimator(model) -- EnemyAnimator drives the joints
	model.Parent = folder
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	local route = opts.route or { position }
	local e = {
		model = model,
		humanoid = humanoid,
		root = root,
		head = head,
		typeName = typeName,
		cfg = cfg,
		hp = cfg.hp,
		fovCos = math.cos(math.rad(cfg.fovDeg / 2)),
		route = route,
		routeIndex = rng:NextInteger(1, #route),
		objective = opts.objective,
		objectiveDps = opts.objectiveDps or 0,
		hunt = opts.hunt == true,
		path = PathfindingService:CreatePath({
			AgentRadius = 2 * cfg.scale,
			AgentHeight = 7 * cfg.scale,
			AgentCanJump = false,
			WaypointSpacing = 6,
		}),
		lastPathTime = 0,
		progressPos = root.Position,
		progressTime = os.clock(),
		stunUntil = 0,
		recoverUntil = 0,
		suspicion = {},
		lastSeen = {},
		state = "",
		stateTime = os.clock(),
	}
	if opts.elite then
		e.hp = cfg.hp * (opts.hpMult or 3)
		e.maxHp = e.hp
		e.isTarget = true
		model:SetAttribute("Elite", opts.elite)
	end
	setState(e, "Patrol")
	table.insert(enemies, e)
	byModel[model] = e
	if cfg.human then
		assignIdentity(e)
		e.nextIdle = os.clock() + 14 + rng:NextNumber() * 24
	end
	return e
end

-- Weighted pick from { Type = weight }.
function EnemyService.pickType(weights)
	local total = 0
	for _, w in weights do
		total += w
	end
	local roll = rng:NextNumber() * total
	for typeName, w in weights do
		roll -= w
		if roll <= 0 then
			return typeName
		end
	end
	return "Drifter"
end

function EnemyService.clear()
	for _, e in enemies do
		e.dead = true
		e.model:Destroy()
	end
	table.clear(enemies)
	table.clear(byModel)
	table.clear(fireZones)
	table.clear(usedNames)
end

function EnemyService.count()
	return #enemies
end

-- Which body zone a hit part belongs to: "head" | "torso" | "arm" | "leg" (+ side "L"/"R").
-- Bits welded onto a limb (rags, salt crust, nets) count as that limb.
function EnemyService.zoneOf(instance)
	local part = instance
	local weld = part and part:FindFirstChildOfClass("Weld")
	if weld and weld.Part1 == part and weld.Part0 then
		part = weld.Part0 -- a rag / crust / net welded onto a body part
	end
	local name = part and part.Name or ""
	local side = name:sub(1, 4) == "Left" and "L" or (name:sub(1, 5) == "Right" and "R" or "")
	if name == "Head" then
		return "head", side
	elseif name:find("Leg") then
		return "leg", side
	elseif name:find("Arm") then
		return "arm", side
	end
	return "torso", side
end

function EnemyService.fromInstance(instance)
	local model = instance and instance:FindFirstAncestorOfClass("Model")
	while model and not byModel[model] do
		model = model.Parent and model.Parent:FindFirstAncestorOfClass("Model")
	end
	return model and byModel[model] or nil
end

function EnemyService.getAll()
	return enemies
end

function EnemyService.findNear(position, radius)
	local found = {}
	for _, e in enemies do
		if not e.dead then
			local d = (e.root.Position - position).Magnitude
			if d <= radius then
				table.insert(found, { enemy = e, distance = d })
			end
		end
	end
	table.sort(found, function(a, b)
		return a.distance < b.distance
	end)
	return found
end

function EnemyService.stun(e, duration, byPlayer, newState)
	if e.dead then
		return
	end
	e.stunUntil = math.max(e.stunUntil, os.clock() + duration)
	if byPlayer then
		e.suspicion[byPlayer] = math.max(e.suspicion[byPlayer] or 0, 0.6)
		local char = byPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if root then
			e.investigatePos = root.Position
		end
	end
	if e.state == "Chase" then
		e.target = nil
	end
	setState(e, newState or "Stunned")
	stop(e)
end

-- Grabbed (human shield): held in front of the grabber until released.
local hostages = {} -- [Player] = enemy
function EnemyService.grab(e, player, grabberRoot)
	if e.dead then
		return
	end
	e.grabbedBy = grabberRoot
	hostages[player] = e
	e.stunUntil = math.huge
	e.target = nil
	setState(e, "Grabbed")
	stop(e)
	e.root.Anchored = true
	for _, p in e.model:GetDescendants() do
		if p:IsA("BasePart") then
			p.CanCollide = false
		end
	end
	Services.CharacterService.setFlashlight(e.model, false)
end

function EnemyService.release(e)
	for player, h in hostages do
		if h == e then
			hostages[player] = nil
		end
	end
	e.grabbedBy = nil
	if e.dead then
		return
	end
	e.root.Anchored = false
	e.root.CanCollide = true
	e.stunUntil = os.clock()
	pcall(function()
		e.root:SetNetworkOwner(nil)
	end)
end

function EnemyService.hostageOf(player)
	local e = hostages[player]
	return e and not e.dead and e or nil
end

function EnemyService.pin(e, duration)
	EnemyService.stun(e, duration, nil, "Pinned")
	local net = Instance.new("Part")
	net.Name = "Net"
	net.Size = Vector3.new(3.4, 7.4, 2.4) * e.cfg.scale
	net.CFrame = e.root.CFrame * CFrame.new(0, -0.6, 0)
	net.Material = Enum.Material.Fabric
	net.Color = Color3.fromRGB(150, 130, 90)
	net.Transparency = 0.55
	net.CanCollide = false
	net.CanQuery = false
	net.Massless = true
	net.Parent = e.model
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = e.root
	weld.Part1 = net
	weld.Parent = net
	e.net = net
end

function EnemyService.canQuiet(e, playerPosition)
	if e.dead or not e.cfg.quietable or e.state == "Chase" or e.state == "Quieted" then
		return false
	end
	if e.state == "Stunned" or e.state == "Pinned" then
		return true
	end
	local toPlayer = Geometry.flat(playerPosition - e.root.Position)
	if toPlayer.Magnitude < 0.01 then
		return true
	end
	return e.root.CFrame.LookVector:Dot(toPlayer.Unit) < -0.2
end

function EnemyService.disperse(e, byPlayer)
	if e.dead then
		return
	end
	e.dead = true
	byModel[e.model] = nil
	local index = table.find(enemies, e)
	if index then
		table.remove(enemies, index)
	end
	e.model:SetAttribute("HP", 0)
	if e.cfg.human then
		-- people fall as physics ragdolls, thrown by the shot that dropped them
		e.model:SetAttribute("State", "Ragdoll")
		Services.CharacterService.setFlashlight(e.model, false)
		Services.MatchService.onEnemyKilled(byPlayer, e)
		for _, w in enemies do
			if w ~= e and not w.dead and w.cfg.human and (w.root.Position - e.root.Position).Magnitude < 45 and rng:NextNumber() < 0.8 then
				EnemyService.say(w, "down", e.name)
				break
			end
		end
		-- sometimes they drop a few rounds of whatever they carried
		local drop = ({ rifle = "rifleAmmo", revolver = "pistolAmmo", bow = "arrows" })[e.cfg.attack and e.cfg.attack.weapon or ""]
		if drop and rng:NextNumber() < 0.55 then
			local folder = Services.MapService.getEncounterFolder()
			if folder then
				Services.LootService.dropPickup(folder, e.root.Position - Vector3.new(0, 2.5, 0), drop, rng:NextInteger(1, 2))
			end
		end
		local ok, err = pcall(EnemyService.ragdoll, e)
		if not ok then
			warn("[EnemyService] ragdoll failed: " .. tostring(err))
			e.model:SetAttribute("State", "Down")
			e.root.Anchored = true
		end
		local model = e.model
		task.delay(14, function()
			for _, part in model:GetDescendants() do
				if part:IsA("BasePart") then
					TweenService:Create(part, TweenInfo.new(1.5), { Transparency = 1 }):Play()
				end
			end
			task.wait(1.6)
			model:Destroy()
		end)
		return
	end
	e.model:SetAttribute("State", "Dispersed")
	e.root.Anchored = true

	local attachment = Instance.new("Attachment")
	attachment.Position = Vector3.new(0, 0.8, 0)
	attachment.Parent = e.root
	local burst = Instance.new("ParticleEmitter")
	burst.Texture = SMOKE
	burst.Rate = 0
	burst.Lifetime = NumberRange.new(1.4, 2.4)
	burst.Speed = NumberRange.new(3, 8)
	burst.SpreadAngle = Vector2.new(180, 180)
	burst.Drag = 3
	burst.Acceleration = Vector3.new(0, 2.5, 0)
	burst.Color = ColorSequence.new(e.cfg.color)
	burst.LightInfluence = 1
	burst.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1 * e.cfg.scale), NumberSequenceKeypoint.new(1, 4 * e.cfg.scale) })
	burst.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
	burst.Parent = attachment
	burst:Emit(70)

	for _, part in e.model:GetDescendants() do
		if part:IsA("BasePart") and part ~= e.root then
			TweenService:Create(part, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Transparency = 1 }):Play()
		elseif part:IsA("ParticleEmitter") and part ~= burst then
			part.Enabled = false
		end
	end
	Sfx.at(e.root.Position, "Quieting", 0.5, 60)
	Services.MatchService.onEnemyKilled(byPlayer, e)
	local model = e.model
	task.delay(2.6, function()
		model:Destroy()
	end)
end

-- Turns a dead human enemy into a ragdoll: every Motor6D becomes a limited ball socket,
-- the body parts collide with the world, and the killing shot pushes the body.
function EnemyService.ragdoll(e)
	local model, humanoid = e.model, e.humanoid
	humanoid:ChangeState(Enum.HumanoidStateType.Physics)
	humanoid.PlatformStand = true
	humanoid.AutoRotate = false
	local bones = {}
	for _, m in model:GetDescendants() do
		if m:IsA("Motor6D") and m.Part0 and m.Part1 then
			bones[m.Part0], bones[m.Part1] = true, true
			local a0 = Instance.new("Attachment")
			a0.CFrame = m.C0
			a0.Parent = m.Part0
			local a1 = Instance.new("Attachment")
			a1.CFrame = m.C1
			a1.Parent = m.Part1
			local socket = Instance.new("BallSocketConstraint")
			socket.Attachment0 = a0
			socket.Attachment1 = a1
			socket.LimitsEnabled = true
			socket.TwistLimitsEnabled = true
			local neck = m.Name == "Neck"
			local knee = m.Name:find("Knee") or m.Name:find("Elbow")
			socket.UpperAngle = neck and 35 or (knee and 70 or 55)
			socket.TwistLowerAngle = -25
			socket.TwistUpperAngle = 25
			socket.Parent = m.Part0
			m.Enabled = false
		end
	end
	for _, part in model:GetChildren() do
		if part:IsA("BasePart") then
			-- the skeleton's bones collide with the world; meshes, rags and crust just ride on them
			part.CanCollide = bones[part] == true and part ~= e.root
			part.Massless = not bones[part]
			part.Anchored = false
		end
	end
	e.root.CanCollide = false
	pcall(function()
		e.root:SetNetworkOwner(nil)
	end)
	local hit = e.lastHit
	local dir = hit and hit.direction or -e.root.CFrame.LookVector
	local push = Vector3.new(dir.X, 0, dir.Z)
	push = (push.Magnitude > 0.01 and push.Unit or Vector3.zero) * 22 * (hit and hit.force or 1) + Vector3.new(0, 6, 0)
	local hitPart = hit and hit.instance
	local target = (hitPart and hitPart:IsDescendantOf(model) and not hitPart.Name:match("^Mesh_")) and hitPart or model:FindFirstChild("Torso") or e.root
	target:ApplyImpulse(push * target.AssemblyMass)
end

-- Weapon / explosive / fire damage. Returns true if this killed it.
function EnemyService.damage(e, amount, byPlayer, headshot, hit)
	if e.dead or amount <= 0 then
		return false
	end
	e.hp -= amount
	e.model:SetAttribute("HP", math.max(0, e.hp / (e.maxHp or e.cfg.hp)))
	if hit then
		e.lastHit = hit
		local _, side = EnemyService.zoneOf(hit.instance or e.root)
		local dir = hit.direction or Vector3.zero
		-- clients play a directional flinch from this (EnemyAnimator)
		e.model:SetAttribute("HitReact", ("%s|%s|%.2f|%.2f|%.2f|%.3f"):format(hit.zone or "torso", side, dir.X, dir.Y, dir.Z, Workspace:GetServerTimeNow()))
	end
	if e.hp <= 0 then
		EnemyService.disperse(e, byPlayer)
		return true
	end
	if e.cfg.human and os.clock() > (e.nextHurtSay or 0) and rng:NextNumber() < 0.6 then
		e.nextHurtSay = os.clock() + 4
		EnemyService.say(e, "hurt")
	end
	-- stagger, and being shot always alerts it to the shooter
	local stagger = e.cfg.staggerTime * (headshot and 2 or 1)
	if hit then
		local force = hit.force or 1
		if hit.zone == "leg" and e.state ~= "Grabbed" then
			-- shot in the leg: down on one knee for a moment, then a limp
			stagger = math.max(stagger, 1.0 + 0.3 * force)
			e.limpUntil = os.clock() + 4.5
			e.model:SetAttribute("LegStunAt", Workspace:GetServerTimeNow())
			if e.state ~= "Quieted" then
				setState(e, "Stunned")
			end
		elseif hit.zone == "head" then
			stagger = math.max(stagger, 0.45 * force)
		elseif force >= 2 and e.cfg.shoveable ~= false then
			stagger = math.max(stagger, 0.35 * force) -- heavy rounds rock them back
		end
		if e.cfg.staggerTime < 0.1 then
			stagger = math.min(stagger, 0.15) -- Tidewalkers barely notice
		end
	end
	if stagger > 0.05 and e.state ~= "Quieted" then
		e.stunUntil = math.max(e.stunUntil, os.clock() + stagger)
	end
	if byPlayer then
		alertTo(e, byPlayer)
		local char = byPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if root then
			e.lastKnown = root.Position
			e.investigatePos = root.Position
		end
	end
	return false
end

function EnemyService.explode(position, radius, damage, byPlayer)
	Services.MatchService.damageNestsNear(position, radius, damage, byPlayer)
	for _, entry in EnemyService.findNear(position, radius) do
		local falloff = 1 - (entry.distance / radius) * 0.6
		local e = entry.enemy
		if not EnemyService.damage(e, damage * falloff, byPlayer, false) then
			EnemyService.stun(e, 2, byPlayer)
		end
	end
end

function EnemyService.addFireZone(position, radius, duration, dps, byPlayer)
	table.insert(fireZones, { position = position, radius = radius, untilTime = os.clock() + duration, dps = dps, player = byPlayer })
end

-- Tell hunters roughly where the players are.
function EnemyService.huntPulse(active)
	if #active == 0 then
		return
	end
	for _, e in enemies do
		if e.hunt and not e.dead and e.state ~= "Chase" then
			local info = active[rng:NextInteger(1, #active)]
			e.investigatePos = info.root.Position + Vector3.new(rng:NextNumber(-10, 10), 0, rng:NextNumber(-10, 10))
		end
	end
end

function EnemyService.onNoise(event)
	for _, e in enemies do
		if not e.dead and e.state ~= "Chase" and e.state ~= "Quieted" and os.clock() >= e.stunUntil then
			local eyes = e.head.Position
			local dist = (event.position - eyes).Magnitude
			local radius = event.radius * (e.cfg.hearingMult or 1)
			if dist <= radius then
				local hit = Workspace:Raycast(eyes, event.position - eyes, occlusionParams)
				if hit and (hit.Position - event.position).Magnitude > 3 then
					radius *= 0.5
				end
				if dist <= radius then
					local loud = 1 - dist / radius
					if event.player then
						local footstep = event.kind == "footstep"
						local add = (footstep and 0.08 or 0.3) + loud * (footstep and 0.3 or 0.6)
						if event.kind == "gunshot" or event.kind == "hum" then
							add += 0.5
						end
						e.suspicion[event.player] = math.min(1.2, (e.suspicion[event.player] or 0) + add)
					end
					e.investigatePos = event.position
					e.heardAt = os.clock()
					if e.cfg.human and event.kind ~= "footstep" and loud > 0.1 and os.clock() > (e.nextHeardSay or 0) then
						e.nextHeardSay = os.clock() + 9
						EnemyService.say(e, "heard")
					end
					if loud > 0.15 and event.kind ~= "footstep" then
						e.model:SetAttribute("Heard", Workspace:GetServerTimeNow()) -- clients show a "?" and turn the head
					end
				end
			end
		end
	end
end

local function tickFire(dt, now)
	for i = #fireZones, 1, -1 do
		local zone = fireZones[i]
		if now > zone.untilTime then
			table.remove(fireZones, i)
		else
			for _, entry in EnemyService.findNear(zone.position, zone.radius) do
				EnemyService.damage(entry.enemy, zone.dps * dt, zone.player, false)
			end
			-- fire is what nests fear most
			Services.MatchService.damageNestsNear(zone.position, zone.radius + 1, zone.dps * dt * 3, zone.player)
		end
	end
end

function EnemyService.init(registry)
	Services = registry
end

function EnemyService.start()
	folder = Instance.new("Folder")
	folder.Name = "Enemies"
	folder.Parent = Workspace
	occlusionParams.FilterDescendantsInstances = { folder }
	Services.PerceptionService.setEnemyFolder(folder)

	local step = 1 / EnemyConfig.TickRate
	local accumulator = 0
	RunService.Heartbeat:Connect(function()
		for _, e in enemies do
			if e.grabbedBy and not e.dead then
				if e.grabbedBy.Parent then
					e.root.CFrame = e.grabbedBy.CFrame * CFrame.new(0.25, 0, -1.7)
				else
					EnemyService.release(e)
				end
			end
		end
	end)
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < step then
			return
		end
		accumulator = 0
		if Services.MatchService.state ~= "Encounter" then
			return
		end
		local now = os.clock()
		local active = Services.MatchService.getActivePlayers()
		tickFire(step, now)
		for i = #enemies, 1, -1 do
			local e = enemies[i]
			if e and not e.dead then
				local ok, err = pcall(update, e, step, now, active)
				if ok and e.limpUntil and now < e.limpUntil and not e.dead then
					e.humanoid.WalkSpeed *= 0.6 -- shot in the leg
				end
				if not ok then
					warn("[EnemyService] brain error: " .. tostring(err))
				end
			end
		end
	end)
end

return EnemyService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000035"><Properties><string name="Name">HomebaseService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The Meridian as a homebase that persists between crossings:
--   * Repairs bought with Scrip (earned only by playing) unlock permanent bonuses and change
--     how the ferry looks (deck lights, generator, radio mast, sick bay, armory rack).
--   * Armory: pick your long gun before a crossing (once the rack is repaired).
--   * Settings (graphics mode, sensitivity) are saved with your profile.
-- Also routes every ferry menu Request from clients to the right service.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Upgrades = require(Shared.Config.Upgrades)
local Projects = require(Shared.Config.Projects)
local Quartermaster = require(Shared.Config.Quartermaster)
local Characters = require(Shared.Config.Characters)
local Weapons = require(Shared.Config.Weapons)
local Net = require(Shared.Net)

local HomebaseService = {}
local Services

local GRAPHICS = { Auto = true, Performance = true, Balanced = true, Cinematic = true }

local function toast(player, text)
	Net.notify(player, "Toast", { text = text })
end

-- Bonuses applied when this player starts a crossing.
function HomebaseService.bonusesFor(player)
	local has = function(id)
		return Services.PlayerDataService.hasRepair(player, id)
	end
	local bonus = { salvage = 0, items = {}, pack = {}, kit = {} }
	if has("generator") then
		bonus.salvage += 20
	end
	if has("sickbay") then
		bonus.items.dressing = 1
	end
	-- the loadout chosen at the Quartermaster (only guns you've unlocked)
	local data = Services.PlayerDataService.get(player)
	if data then
		local guns = data.guns or {}
		local loadout = data.loadout or {}
		if type(loadout.long) == "string" and guns[loadout.long] and Weapons.List[loadout.long] and Weapons.List[loadout.long].slot == "long" then
			bonus.longGun = loadout.long
		end
		local slots = Quartermaster.BackpackSlots + (has("armory") and 1 or 0)
		for _, id in loadout.pack or {} do
			if #bonus.pack < slots and guns[id] and id ~= bonus.longGun and Weapons.List[id] and Weapons.List[id].slot == "long" then
				table.insert(bonus.pack, id)
			end
		end
		-- your signature gun stays with you: in the backpack if you chose another long gun
		local session = Services.CharacterService.getSession(player)
		local def = session and Characters.List[session.charId]
		local sig = def and def.loadout.weapons.long
		if sig and bonus.longGun and sig ~= bonus.longGun and #bonus.pack < slots and not table.find(bonus.pack, sig) then
			table.insert(bonus.pack, 1, sig)
		end
		-- crossing kits (Quartermaster, Lucky Spin, Ammo Crates): delivered now, then used up.
		-- At most MaxKitsEach of each kind per crossing; extra Ammo Crates wait for the next one.
		local left = {}
		for kitId, count in data.kit or {} do
			for _, k in Quartermaster.Kits do
				if k.id == kitId then
					local use = math.min(count, Quartermaster.MaxKitsEach)
					for itemId, amount in k.items do
						bonus.kit[itemId] = (bonus.kit[itemId] or 0) + amount * use
					end
					if count > use then
						left[kitId] = count - use
					end
				end
			end
		end
		data.kit = left
		Services.PlayerDataService.publish(player)
	end
	return bonus
end

-- Quartermaster -------------------------------------------------------------------------------

local function qmPrice(player, price)
	return math.floor(price * (Services.PlayerDataService.hasRepair(player, "armory") and 0.85 or 1) + 0.5)
end

local function unlockGun(player, gunId)
	local data = Services.PlayerDataService.get(player)
	if not data or type(gunId) ~= "string" then
		return
	end
	for _, g in Quartermaster.Guns do
		if g.id == gunId then
			data.guns = data.guns or { revolver = true }
			if data.guns[gunId] then
				return
			end
			local price = qmPrice(player, g.price)
			if not Services.PlayerDataService.spendScrip(player, price) then
				toast(player, ("Need %d Scrip. Earn it by finishing missions."):format(price))
				return
			end
			data.guns[gunId] = true
			-- first long gun: put it straight in the holster
			data.loadout = data.loadout or { long = "", pack = {} }
			if data.loadout.long == "" or data.loadout.long == nil then
				data.loadout.long = gunId
			end
			Services.PlayerDataService.publish(player)
			Services.AnalyticsHelper.economy(player, "sink", price, Enum.AnalyticsEconomyTransactionType.Shop.Name, "Gun_" .. gunId)
			toast(player, ("Unlocked: %s. Set your loadout at the Quartermaster."):format(Weapons.List[gunId].name))
			task.spawn(Services.PlayerDataService.save, player)
			return
		end
	end
end

local function setLoadout(player, long, pack)
	local data = Services.PlayerDataService.get(player)
	if not data then
		return
	end
	local guns = data.guns or {}
	local clean = { long = "", pack = {} }
	if type(long) == "string" and guns[long] and Weapons.List[long] and Weapons.List[long].slot == "long" then
		clean.long = long
	end
	local slots = Quartermaster.BackpackSlots + (Services.PlayerDataService.hasRepair(player, "armory") and 1 or 0)
	if type(pack) == "table" then
		for _, id in pack do
			if #clean.pack < slots and type(id) == "string" and guns[id] and id ~= clean.long and Weapons.List[id] and Weapons.List[id].slot == "long" and not table.find(clean.pack, id) then
				table.insert(clean.pack, id)
			end
		end
	end
	data.loadout = clean
	Services.PlayerDataService.publish(player)
end

local function buyKit(player, kitId)
	local data = Services.PlayerDataService.get(player)
	if not data or type(kitId) ~= "string" then
		return
	end
	for _, k in Quartermaster.Kits do
		if k.id == kitId and not k.robux then
			data.kit = data.kit or {}
			if (data.kit[kitId] or 0) >= Quartermaster.MaxKitsEach then
				toast(player, "That's as many as the Quartermaster will pack for one crossing.")
				return
			end
			local price = qmPrice(player, k.price)
			if not Services.PlayerDataService.spendScrip(player, price) then
				toast(player, ("Need %d Scrip."):format(price))
				return
			end
			data.kit[kitId] = (data.kit[kitId] or 0) + 1
			Services.PlayerDataService.publish(player)
			toast(player, k.name .. " packed for your next crossing.")
			return
		end
	end
end

-- A repair is "visible" on the shared ferry if anyone in the server owns it.
function HomebaseService.anyoneHas(repairId)
	for _, p in Players:GetPlayers() do
		if Services.PlayerDataService.hasRepair(p, repairId) then
			return true
		end
	end
	return false
end

function HomebaseService.refreshVisuals()
	local owned = {}
	for _, r in Projects.List do
		owned[r.id] = HomebaseService.anyoneHas(r.id)
	end
	Services.MapService.setFerryRepairs(owned)
end

-- Builds a Meridian project: Scrip + Materials, or one Shipwright's Crew token (useToken).
local function repair(player, repairId, useToken)
	local p = type(repairId) == "string" and Projects.get(repairId)
	if not p then
		return
	end
	local data = Services.PlayerDataService
	if data.hasRepair(player, p.id) then
		return
	end
	if p.requires and not data.hasRepair(player, p.requires) then
		toast(player, ("Build the %s first."):format(Projects.get(p.requires).name))
		return
	end
	if useToken == true then
		if not data.useToken(player, "build") then
			Net.notify(player, "NeedProduct", { productKey = "ShipwrightCrew" })
			return
		end
	else
		local d = data.get(player)
		if not d or d.scrip < p.scrip or (d.materials or 0) < p.materials then
			toast(player, ("Need %d Scrip and %d Materials. Both come from missions."):format(p.scrip, p.materials))
			return
		end
		data.spendScrip(player, p.scrip)
		data.spendMaterials(player, p.materials)
		Services.AnalyticsHelper.economy(player, "sink", p.scrip, Enum.AnalyticsEconomyTransactionType.Shop.Name, "Project_" .. p.id)
	end
	data.addRepair(player, p.id)
	task.spawn(data.save, player)
	Net.notifyAll("Toast", { text = ("%s built the %s."):format(player.DisplayName, p.name) })
	HomebaseService.refreshVisuals()
end

local function setLongGun(player, weaponId)
	if type(weaponId) ~= "string" or not Weapons.List[weaponId] or Weapons.List[weaponId].slot ~= "long" then
		return
	end
	if not Services.PlayerDataService.hasRepair(player, "armory") then
		toast(player, "Repair the armory rack first")
		return
	end
	player:SetAttribute("LongGunChoice", weaponId)
	toast(player, "Next crossing you'll carry the " .. Weapons.List[weaponId].name)
end

local function saveSettings(player, settings)
	if type(settings) ~= "table" then
		return
	end
	local graphics = GRAPHICS[settings.graphics] and settings.graphics or "Auto"
	local sensitivity = tonumber(settings.sensitivity) or 1
	if sensitivity ~= sensitivity then
		sensitivity = 1
	end
	Services.PlayerDataService.setSettings(player, {
		graphics = graphics,
		sensitivity = math.clamp(sensitivity, 0.2, 3),
		reduceMotion = settings.reduceMotion == true,
		camera = settings.camera == "Third" and "Third" or "First",
		uiSize = ({ Normal = true, Large = true, Huge = true })[settings.uiSize] and settings.uiSize or "Large",
		fov = math.clamp(math.floor(tonumber(settings.fov) or 80), 60, 110),
	})
end

function HomebaseService.init(registry)
	Services = registry
end

function HomebaseService.start()
	local handlers = {
		ChooseRoute = function(player, a)
			Services.MatchService.chooseRoute(player, a)
		end,
		OpenChart = function(player)
			Services.MatchService.requestChart(player)
		end,
		BuyWeaponUpgrade = function(player, a, b)
			Services.WorkbenchService.buyWeapon(player, a, b)
		end,
		BuyGeneral = function(player, a)
			Services.WorkbenchService.buyGeneral(player, a)
		end,
		BuyPerk = function(player, a)
			Services.WorkbenchService.buyPerk(player, a)
		end,
		Repair = repair,
		UnlockGun = unlockGun,
		SetLoadout = setLoadout,
		BuyKit = buyKit,
		Spin = function(player)
			Services.SpinService.spin(player)
		end,
		OpenSpin = function(player)
			Net.notify(player, "OpenSpin", {})
		end,
		OpenProjects = function(player)
			Net.notify(player, "OpenRepairs", {})
		end,
		SetLongGun = setLongGun,
		SaveSettings = saveSettings,
		BuyOutfit = function(player, a)
			Services.CosmeticsService.buyWithScrip(player, a)
		end,
		EquipOutfit = function(player, a)
			Services.CosmeticsService.equip(player, a)
		end,
	}
	Net.onServer("Request", 8, function(player, kind, a, b)
		local handler = type(kind) == "string" and handlers[kind]
		if handler then
			handler(player, a, b)
		end
	end)
	Players.PlayerAdded:Connect(function(player)
		task.spawn(function()
			Services.PlayerDataService.waitFor(player, 20)
			HomebaseService.refreshVisuals()
		end)
	end)
	Players.PlayerRemoving:Connect(function()
		task.defer(HomebaseService.refreshVisuals)
	end)
	assert(HttpService)
end

return HomebaseService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000036"><Properties><string name="Name">InventoryService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The satchel: items, reserve ammo, two weapon slots (long gun + sidearm, with magazines)
-- and Salvage (run currency). Server-owned; replicated to the owner as player attributes:
--   Inv_<item>, Cap_<item>, W_long, W_longMag, W_sidearm, W_sidearmMag, Salvage
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Items = require(Shared.Config.Items)
local Weapons = require(Shared.Config.Weapons)
local Net = require(Shared.Net)
local Sfx = require(Shared.Util.Sfx)

local InventoryService = {}
local Services

local inventories = {} -- [Player] = { items = {}, weapons = { long = {id, mag}, sidearm = {id, mag} }, salvage = n }

local function runUpgrades(player)
	local session = Services.CharacterService.getSession(player)
	return session and session.run or nil
end

function InventoryService.cap(player, itemId)
	local def = Items.Items[itemId]
	if not def then
		return 0
	end
	local cap = def.cap
	local run = runUpgrades(player)
	local session = Services.CharacterService.getSession(player)
	if def.kind == "ammo" then
		if run and run.general.ammoPouch then
			cap = math.floor(cap * (1 + Items.CapBonus.ammoPouch))
		end
	elseif run and run.general.satchel then
		cap += Items.CapBonus.satchel
	end
	if def.kind == "throwable" and session and session.mods then
		cap += session.mods.throwCapBonus
	end
	return cap
end

function InventoryService.publish(player)
	local inv = inventories[player]
	if not inv then
		return
	end
	for _, itemId in Items.Order do
		player:SetAttribute("Inv_" .. itemId, inv.items[itemId] or 0)
		player:SetAttribute("Cap_" .. itemId, InventoryService.cap(player, itemId))
	end
	for _, slot in { "long", "sidearm" } do
		local w = inv.weapons[slot]
		player:SetAttribute("W_" .. slot, w and w.id or "")
		player:SetAttribute("W_" .. slot .. "Mag", w and w.mag or 0)
	end
	player:SetAttribute("Salvage", inv.salvage)
	local pack = {}
	for _, w in inv.pack or {} do
		table.insert(pack, w.id .. ":" .. w.mag)
	end
	player:SetAttribute("Pack", table.concat(pack, ","))
end

-- loadout = { weapons = {long, sidearm}, items = {...} }; bonus = { salvage, items, longGun }
function InventoryService.reset(player, loadout, mods, bonus)
	bonus = bonus or {}
	local inv = { items = {}, weapons = {}, salvage = bonus.salvage or 0, pack = {} }
	for _, itemId in Items.Order do
		inv.items[itemId] = 0
	end
	inventories[player] = inv
	local long = bonus.longGun or loadout.weapons.long
	for slot, weaponId in { long = long, sidearm = loadout.weapons.sidearm } do
		if Weapons.List[weaponId] then
			inv.weapons[slot] = { id = weaponId, mag = Weapons.List[weaponId].mag }
		end
	end
	-- backpack guns (holster system): carried, but slow to get out
	for _, weaponId in bonus.pack or {} do
		if Weapons.List[weaponId] and Weapons.List[weaponId].slot == "long" and weaponId ~= long then
			table.insert(inv.pack, { id = weaponId, mag = Weapons.List[weaponId].mag })
		end
	end
	for itemId, amount in loadout.items do
		InventoryService.add(player, itemId, amount)
	end
	-- a crossing kit bought at the Quartermaster
	for itemId, amount in bonus.kit or {} do
		InventoryService.add(player, itemId, amount)
	end
	if bonus.items then
		for itemId, amount in bonus.items do
			InventoryService.add(player, itemId, amount)
		end
	end
	if mods and mods.ammoBonus > 0 then
		InventoryService.add(player, "pistolAmmo", mods.ammoBonus)
	end
	InventoryService.publish(player)
end

-- Holster system: swap backpack gun #index into the long-gun holster (the holstered one goes
-- into the backpack). The timing (kneel and dig) is enforced by ActionService.
function InventoryService.packList(player)
	local inv = inventories[player]
	return inv and inv.pack or {}
end

function InventoryService.swapPack(player, index)
	local inv = inventories[player]
	local entry = inv and inv.pack[index]
	if not entry then
		return false
	end
	local current = inv.weapons.long
	inv.weapons.long = { id = entry.id, mag = entry.mag }
	if current then
		inv.pack[index] = current
	else
		table.remove(inv.pack, index)
	end
	InventoryService.publish(player)
	return true
end

function InventoryService.has(player)
	return inventories[player] ~= nil
end

function InventoryService.count(player, itemId)
	local inv = inventories[player]
	return inv and inv.items[itemId] or 0
end

function InventoryService.add(player, itemId, amount)
	local inv = inventories[player]
	if not inv then
		return 0
	end
	if itemId == "salvage" then
		inv.salvage += amount
		InventoryService.publish(player)
		return amount
	end
	if not Items.Items[itemId] then
		return 0
	end
	local space = InventoryService.cap(player, itemId) - inv.items[itemId]
	local added = math.clamp(amount, 0, math.max(space, 0))
	inv.items[itemId] += added
	InventoryService.publish(player)
	return added
end

function InventoryService.take(player, itemId, amount)
	local inv = inventories[player]
	if not inv or (inv.items[itemId] or 0) < amount then
		return false
	end
	inv.items[itemId] -= amount
	InventoryService.publish(player)
	return true
end

function InventoryService.salvage(player)
	local inv = inventories[player]
	return inv and inv.salvage or 0
end

function InventoryService.spendSalvage(player, amount)
	local inv = inventories[player]
	if not inv or inv.salvage < amount then
		return false
	end
	inv.salvage -= amount
	InventoryService.publish(player)
	return true
end

function InventoryService.weapon(player, slot)
	local inv = inventories[player]
	return inv and inv.weapons[slot] or nil
end

function InventoryService.weaponSlots(player)
	local inv = inventories[player]
	return inv and inv.weapons or {}
end

function InventoryService.setMag(player, slot, mag)
	local w = InventoryService.weapon(player, slot)
	if w then
		w.mag = mag
		InventoryService.publish(player)
	end
end

-- Crafting -------------------------------------------------------------------------------

function InventoryService.recipeYield(player, recipe)
	local session = Services.CharacterService.getSession(player)
	local bonus = (recipe.perkYield and session and session.mods) and session.mods.craftYieldBonus or 0
	if recipe.perkYield and Services.PlayerDataService.hasRepair(player, "workshop") then
		bonus += 1 -- the Workshop's proper tools
	end
	return recipe.amount + bonus
end

function InventoryService.canCraft(player, recipeId)
	local recipe = Items.Recipes[recipeId]
	local inv = inventories[player]
	if not recipe or not inv then
		return false, "Unknown recipe"
	end
	-- the whole batch must fit: never charge the full price for a partial yield
	local space = InventoryService.cap(player, recipe.output) - inv.items[recipe.output]
	local yield = InventoryService.recipeYield(player, recipe)
	if space < yield then
		return false, space <= 0 and (Items.Items[recipe.output].name .. ": satchel full")
			or ("Room for only %d %s: this makes %d. Use some first."):format(space, Items.Items[recipe.output].name, yield)
	end
	for itemId, amount in recipe.cost do
		if inv.items[itemId] < amount then
			return false, "Need " .. amount .. " " .. Items.Items[itemId].name
		end
	end
	return true
end

function InventoryService.craft(player, recipeId)
	local ok, reason = InventoryService.canCraft(player, recipeId)
	if not ok then
		return false, reason
	end
	local recipe = Items.Recipes[recipeId]
	for itemId, amount in recipe.cost do
		inventories[player].items[itemId] -= amount
	end
	InventoryService.add(player, recipe.output, InventoryService.recipeYield(player, recipe))
	return true
end

-- Pickups ----------------------------------------------------------------------------------

local function itemName(itemId)
	return itemId == "salvage" and "Salvage" or (Items.Items[itemId] and Items.Items[itemId].name or itemId)
end

-- Grants a list of { itemId, amount }; returns found-text list and leftovers that didn't fit.
function InventoryService.grantList(player, list)
	local found, leftovers = {}, {}
	for _, entry in list do
		local itemId, amount = entry[1], entry[2]
		local added = InventoryService.add(player, itemId, amount)
		if added > 0 then
			table.insert(found, added .. " " .. itemName(itemId))
		end
		if added < amount then
			table.insert(leftovers, { itemId, amount - added })
		end
	end
	return found, leftovers
end

-- Taking a loose item. It must vanish the instant it is taken: the prompt is switched off and the
-- item hidden before anything else, so a second press (or a controller button that fires the
-- prompt twice) can never take it again, and nothing is left floating behind.
local taking = setmetatable({}, { __mode = "k" })
local function vanish(pickupPart)
	for _, d in pickupPart:GetDescendants() do
		if d:IsA("ProximityPrompt") then
			d.Enabled = false
		elseif d:IsA("ParticleEmitter") then
			d.Enabled = false
		elseif d:IsA("Light") then
			d.Enabled = false
		end
	end
	pickupPart.Transparency = 1
	pickupPart.CanTouch = false
end

function InventoryService.pickup(player, pickupPart, itemId, amount)
	if not pickupPart.Parent or taking[pickupPart] then
		return
	end
	local info = Services.MatchService.getActiveInfo(player)
	if not info or (info.root.Position - pickupPart.Position).Magnitude > 12 then
		return
	end
	taking[pickupPart] = true
	amount = pickupPart:GetAttribute("Amount") or amount
	local added = InventoryService.add(player, itemId, amount)
	if added > 0 then
		Sfx.at(pickupPart.Position, "Pickup", 0.5, 25)
		local remaining = amount - added
		if remaining > 0 then
			pickupPart:SetAttribute("Amount", remaining)
			local prompt = pickupPart:FindFirstChildOfClass("ProximityPrompt")
			if prompt then
				prompt.ObjectText = ("%s (%d left: satchel full)"):format(itemName(itemId), remaining)
			end
			taking[pickupPart] = nil
		else
			vanish(pickupPart)
			pickupPart:Destroy()
		end
		Net.notify(player, "Toast", { text = "+" .. added .. " " .. itemName(itemId) })
	else
		taking[pickupPart] = nil
		Net.notify(player, "Toast", { text = itemName(itemId) .. ": satchel full" })
	end
end

InventoryService.itemName = itemName

function InventoryService.init(registry)
	Services = registry
end

function InventoryService.start()
	Players.PlayerRemoving:Connect(function(player)
		inventories[player] = nil
	end)
end

return InventoryService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000037"><Properties><string name="Name">LeaderboardService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Leaderboards:
--   * leaderstats (Roblox's player list): Wins and Best Pall for everyone in the server
--   * a global top 10 (most wins) on the Meridian's board, from an OrderedDataStore
-- In Studio without API access the board shows the players in this server instead.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local LeaderboardService = {}
local Services

local store = nil
local names = {} -- userId -> display name cache
local lastWritten = {} -- [userId] = wins written

local function stats(player)
	local data = Services.PlayerDataService.get(player)
	return data and data.stats or nil
end

local function ensureStats(player)
	local folder = player:FindFirstChild("leaderstats")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "leaderstats"
		local wins = Instance.new("IntValue")
		wins.Name = "Wins"
		wins.Parent = folder
		local pall = Instance.new("IntValue")
		pall.Name = "Best Pall"
		pall.Parent = folder
		folder.Parent = player
	end
	return folder
end

-- Updates this player's leaderstats and their global score (called after every encounter).
function LeaderboardService.refreshPlayer(player)
	local s = stats(player)
	if not s then
		return
	end
	local folder = ensureStats(player)
	folder.Wins.Value = s.wins or 0
	folder["Best Pall"].Value = s.bestPall or 0
	if store and lastWritten[player.UserId] ~= s.wins and (s.wins or 0) > 0 then
		lastWritten[player.UserId] = s.wins
		task.spawn(function()
			pcall(function()
				store:SetAsync(tostring(player.UserId), s.wins)
			end)
		end)
	end
end

local function nameOf(userId)
	if names[userId] then
		return names[userId]
	end
	local p = Players:GetPlayerByUserId(userId)
	local name = p and p.DisplayName
	if not name then
		local ok, result = pcall(function()
			return Players:GetNameFromUserIdAsync(userId)
		end)
		name = ok and result or ("#" .. userId)
	end
	names[userId] = name
	return name
end

local board -- { title, rows = {TextLabel} }
local function buildBoard()
	local part = Services.MapService.getLeaderboardPart()
	if not part or board then
		return
	end
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Right -- faces down the deck (+X)
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 60
	gui.LightInfluence = 0.4
	gui.Parent = part
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.fromRGB(28, 32, 34)
	bg.BorderSizePixel = 0
	bg.Parent = gui
	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0.14, 0)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.Oswald
	title.TextScaled = true
	title.TextColor3 = Color3.fromRGB(232, 168, 92)
	title.Text = "SURVIVORS · MOST TIDES TURNED"
	title.Parent = bg
	local rows = {}
	for i = 1, 10 do
		local row = Instance.new("TextLabel")
		row.Position = UDim2.new(0.05, 0, 0.14 + (i - 1) * 0.084, 0)
		row.Size = UDim2.new(0.9, 0, 0.08, 0)
		row.BackgroundTransparency = 1
		row.Font = Enum.Font.Merriweather
		row.TextScaled = true
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.TextColor3 = Color3.fromRGB(226, 220, 206)
		row.Text = ""
		row.Parent = bg
		rows[i] = row
	end
	board = { title = title, rows = rows }
end

local function refreshBoard()
	buildBoard()
	if not board then
		return
	end
	local entries = {}
	local ok = false
	if store then
		ok = pcall(function()
			local page = store:GetSortedAsync(false, 10):GetCurrentPage()
			for _, e in page do
				table.insert(entries, { name = nameOf(tonumber(e.key)), wins = e.value })
			end
		end)
	end
	if not ok then
		board.title.Text = "SURVIVORS ABOARD · TIDES TURNED"
		for _, p in Players:GetPlayers() do
			local s = stats(p)
			table.insert(entries, { name = p.DisplayName, wins = s and s.wins or 0 })
		end
		table.sort(entries, function(a, b)
			return a.wins > b.wins
		end)
	end
	for i, row in board.rows do
		local e = entries[i]
		row.Text = e and ("%d.  %s  ·  %d"):format(i, e.name, e.wins) or ""
	end
end

function LeaderboardService.init(registry)
	Services = registry
end

function LeaderboardService.start()
	local ok, result = pcall(function()
		return DataStoreService:GetOrderedDataStore("Aftertide_Wins_v1")
	end)
	if ok and not Services.PlayerDataService.isMemoryOnly() then
		store = result
	end
	local function onJoin(player)
		task.spawn(function()
			ensureStats(player)
			if Services.PlayerDataService.waitFor(player, 20) then
				LeaderboardService.refreshPlayer(player)
			end
		end)
	end
	Players.PlayerAdded:Connect(onJoin)
	for _, p in Players:GetPlayers() do
		onJoin(p)
	end
	while true do
		task.wait(3)
		pcall(refreshBoard)
		task.wait(87)
	end
end

return LeaderboardService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000038"><Properties><string name="Name">LootService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Scavenging: searchable containers (drawers, lockers, toolboxes, ammo crates) that open
-- with a short animation, and loose items that glint in the fog. Loot is rolled from
-- Config/Loot tables (free, never paid). What doesn't fit your satchel is dropped on the
-- floor for a crewmate.
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Loot = require(Shared.Config.Loot)
local Items = require(Shared.Config.Items)
local Net = require(Shared.Net)
local Sfx = require(Shared.Util.Sfx)

local LootService = {}
local Services

local ITEM_COLORS = {
	part = Color3.fromRGB(176, 166, 140),
	ammo = Color3.fromRGB(196, 160, 70),
	consumable = Color3.fromRGB(190, 70, 60),
	throwable = Color3.fromRGB(80, 130, 100),
	tool = Color3.fromRGB(150, 150, 150),
	salvage = Color3.fromRGB(120, 112, 100),
}

local function part(parent, size, cframe, color, material, props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props then
		for k, v in props do
			p[k] = v
		end
	end
	p.Parent = parent
	return p
end

function LootService.roll(tableName, rolls, rng, pall)
	local entries = Loot.Tables[tableName]
	local total = 0
	for _, e in entries do
		total += e[2]
	end
	local extra = rng:NextNumber() < (pall - 1) * Loot.PallBonusRolls and 1 or 0
	local merged = {}
	for _ = 1, rolls + extra do
		local r = rng:NextNumber() * total
		for _, e in entries do
			r -= e[2]
			if r <= 0 then
				local amount = rng:NextInteger(e[3], e[4])
				merged[e[1]] = (merged[e[1]] or 0) + amount
				break
			end
		end
	end
	local list = {}
	for itemId, amount in merged do
		table.insert(list, { itemId, amount })
	end
	return list
end

function LootService.dropPickup(parent, position, itemId, amount)
	local kind = itemId == "salvage" and "salvage" or (Items.Items[itemId] and Items.Items[itemId].kind or "part")
	local p = part(parent, Vector3.new(0.9, 0.5, 0.7), CFrame.new(position + Vector3.new(0, 0.25, 0)) * CFrame.Angles(0, math.random() * 6.28, 0), ITEM_COLORS[kind], Enum.Material.SmoothPlastic, {
		Name = "Pickup_" .. itemId,
		CanCollide = false,
	})
	p:SetAttribute("Amount", amount)
	local glint = Instance.new("PointLight")
	glint.Range = 4
	glint.Brightness = 0.5
	glint.Color = Color3.fromRGB(255, 230, 190)
	glint.Parent = p
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Rate = 1.2
	sparkle.Lifetime = NumberRange.new(0.5, 0.8)
	sparkle.Speed = NumberRange.new(0, 0)
	sparkle.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.35), NumberSequenceKeypoint.new(1, 0) })
	sparkle.LightEmission = 1
	sparkle.Parent = p
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Take"
	prompt.ObjectText = Services.InventoryService.itemName(itemId)
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 7
	prompt.RequiresLineOfSight = false
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonA
	prompt.Parent = p
	prompt.Triggered:Connect(function(player)
		Services.InventoryService.pickup(player, p, itemId, amount)
	end)
	return p
end

-- Puts a point on whatever is really beneath it (floor, terrain, a step), so nothing floats
-- or sinks however the spot was authored. Ignores encounter objects and characters.
local settleParams = RaycastParams.new()
settleParams.FilterType = Enum.RaycastFilterType.Exclude
local function settle(position, parent)
	local ignore = { parent }
	for _, p in game:GetService("Players"):GetPlayers() do
		if p.Character then
			table.insert(ignore, p.Character)
		end
	end
	local enemies = workspace:FindFirstChild("Enemies")
	if enemies then
		table.insert(ignore, enemies)
	end
	settleParams.FilterDescendantsInstances = ignore
	settleParams.IgnoreWater = true
	local hit = workspace:Raycast(position + Vector3.new(0, 3, 0), Vector3.new(0, -14, 0), settleParams)
	return hit and Vector3.new(position.X, hit.Position.Y, position.Z) or position
end
LootService.settle = settle

-- Container models: { body, moving part, open transform }
local BUILDERS = {}

-- Each builder returns: the body (holds the prompt), the parts that open (list), and the opening
-- offset. Painted, detailed furniture: drawers with knobs and legs, lockers with vents.
local WOODS = { Color3.fromRGB(150, 104, 66), Color3.fromRGB(120, 84, 56), Color3.fromRGB(176, 136, 96) }
local PAINTS = { Color3.fromRGB(236, 230, 214), Color3.fromRGB(150, 196, 214), Color3.fromRGB(196, 214, 170), Color3.fromRGB(230, 190, 120), Color3.fromRGB(210, 150, 140) }
local function pick(list)
	return list[math.random(1, #list)]
end

function BUILDERS.Drawer(parent, cf)
	local painted = math.random() < 0.5
	local bodyColor = painted and pick(PAINTS) or pick(WOODS)
	local front = bodyColor:Lerp(Color3.new(1, 1, 1), 0.12)
	local mat = painted and Enum.Material.SmoothPlastic or Enum.Material.WoodPlanks
	local body = part(parent, Vector3.new(2.8, 2.6, 1.5), cf * CFrame.new(0, 1.6, 0), bodyColor, mat)
	part(parent, Vector3.new(3.0, 0.15, 1.65), cf * CFrame.new(0, 2.97, 0), bodyColor:Lerp(Color3.new(0, 0, 0), 0.15), Enum.Material.WoodPlanks) -- top
	for _, x in { -1.25, 1.25 } do
		for _, z in { -0.6, 0.6 } do
			part(parent, Vector3.new(0.2, 0.3, 0.2), cf * CFrame.new(x, 0.15, z), bodyColor:Lerp(Color3.new(0, 0, 0), 0.3), Enum.Material.Wood)
		end
	end
	local moving = {}
	for i, y in { 2.45, 1.65, 0.85 } do
		local d = part(parent, Vector3.new(2.5, 0.65, 0.12), cf * CFrame.new(0, y, -0.78), front, mat)
		local knob = part(parent, Vector3.new(0.18, 0.18, 0.12), cf * CFrame.new(0, y, -0.88), Color3.fromRGB(196, 160, 80), Enum.Material.Metal, { Shape = Enum.PartType.Ball })
		if i == 1 then
			table.insert(moving, d)
			table.insert(moving, knob)
			-- the drawer box behind the front, seen when it slides out
			table.insert(moving, part(parent, Vector3.new(2.3, 0.5, 1.25), cf * CFrame.new(0, y - 0.02, -0.08), bodyColor:Lerp(Color3.new(0, 0, 0), 0.2), Enum.Material.WoodPlanks))
		end
	end
	return body, moving, CFrame.new(0, 0, -0.9)
end

function BUILDERS.Locker(parent, cf)
	local color = pick({ Color3.fromRGB(70, 130, 180), Color3.fromRGB(90, 150, 110), Color3.fromRGB(200, 80, 70), Color3.fromRGB(150, 156, 160) })
	local body = part(parent, Vector3.new(1.8, 6, 1.6), cf * CFrame.new(0, 3, 0), color, Enum.Material.Metal)
	local door = part(parent, Vector3.new(1.7, 5.8, 0.1), cf * CFrame.new(0, 3, -0.85), color:Lerp(Color3.new(1, 1, 1), 0.12), Enum.Material.Metal)
	local moving = { door }
	for i = 0, 2 do
		table.insert(moving, part(parent, Vector3.new(1.0, 0.08, 0.04), cf * CFrame.new(0, 5.2 - i * 0.25, -0.92), color:Lerp(Color3.new(0, 0, 0), 0.35), Enum.Material.Metal))
	end
	table.insert(moving, part(parent, Vector3.new(0.1, 0.5, 0.1), cf * CFrame.new(0.6, 3, -0.94), Color3.fromRGB(200, 200, 196), Enum.Material.Metal))
	return body, moving, CFrame.new(-0.85, 0, 0) * CFrame.Angles(0, math.rad(100), 0) * CFrame.new(0.85, 0, 0)
end

function BUILDERS.Toolbox(parent, cf)
	local color = pick({ Color3.fromRGB(200, 50, 40), Color3.fromRGB(40, 90, 170), Color3.fromRGB(230, 170, 40) })
	local body = part(parent, Vector3.new(2.2, 0.9, 1), cf * CFrame.new(0, 0.45, 0), color, Enum.Material.Metal)
	local lid = part(parent, Vector3.new(2.2, 0.15, 1), cf * CFrame.new(0, 0.97, 0), color:Lerp(Color3.new(1, 1, 1), 0.1), Enum.Material.Metal)
	local handle = part(parent, Vector3.new(1.0, 0.12, 0.12), cf * CFrame.new(0, 1.2, 0), Color3.fromRGB(40, 40, 44), Enum.Material.Metal)
	for _, x in { -0.8, 0.8 } do
		part(parent, Vector3.new(0.2, 0.25, 0.06), cf * CFrame.new(x, 0.75, -0.52), Color3.fromRGB(200, 200, 196), Enum.Material.Metal)
	end
	return body, { lid, handle }, CFrame.new(0, 0, 0.5) * CFrame.Angles(math.rad(100), 0, 0) * CFrame.new(0, 0, -0.5)
end

function BUILDERS.AmmoCrate(parent, cf)
	local body = part(parent, Vector3.new(2.6, 1.3, 1.6), cf * CFrame.new(0, 0.65, 0), Color3.fromRGB(96, 110, 66), Enum.Material.WoodPlanks)
	part(parent, Vector3.new(2.62, 0.3, 1.62), cf * CFrame.new(0, 0.65, 0), Color3.fromRGB(230, 200, 70), Enum.Material.SmoothPlastic) -- stencil band
	for _, x in { -1.35, 1.35 } do
		part(parent, Vector3.new(0.1, 0.25, 0.7), cf * CFrame.new(x, 0.9, 0), Color3.fromRGB(150, 120, 80), Enum.Material.Fabric) -- rope handles
	end
	local lid = part(parent, Vector3.new(2.6, 0.2, 1.6), cf * CFrame.new(0, 1.4, 0), Color3.fromRGB(106, 120, 74), Enum.Material.WoodPlanks)
	return body, { lid }, CFrame.new(0, 0, 0.8) * CFrame.Angles(math.rad(110), 0, 0) * CFrame.new(0, 0, -0.8)
end

local function container(parent, spot, rng, pall)
	local def = Loot.Containers[spot.type]
	local builder = BUILDERS[spot.type]
	if not def or not builder then
		return
	end
	local cf = CFrame.new(settle(spot.pos, parent)) * CFrame.Angles(0, math.rad(spot.yaw or 0), 0)
	local body, moving, openOffset = builder(parent, cf)
	body.Name = spot.type
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Search"
	prompt.ObjectText = spot.type == "AmmoCrate" and "Ammo crate" or spot.type
	prompt.HoldDuration = def.hold
	prompt.MaxActivationDistance = 7
	prompt.RequiresLineOfSight = false
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonA
	prompt.Parent = body
	local searched = false
	prompt.Triggered:Connect(function(player)
		if searched then
			return
		end
		local info = Services.MatchService.getActiveInfo(player)
		if not info or (info.root.Position - body.Position).Magnitude > 12 then
			return
		end
		searched = true
		prompt:Destroy()
		-- everything that opens pivots together around the first moving part
		local pivot = moving[1].CFrame
		for _, m in moving do
			local rel = pivot:ToObjectSpace(m.CFrame)
			TweenService:Create(m, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = pivot * openOffset * rel }):Play()
		end
		Sfx.at(body.Position, "Search", 0.3, 30)
		Services.PerceptionService.emitNoise(body.Position, 5, "search", player)
		local list = LootService.roll(def.table, def.rolls, rng, pall)
		local found, leftovers = Services.InventoryService.grantList(player, list)
		for i, entry in leftovers do
			LootService.dropPickup(parent, body.Position + Vector3.new(i * 0.9 - 1, -body.Position.Y + 0.1, -1.6), entry[1], entry[2])
		end
		local text = #found > 0 and ("Found: " .. table.concat(found, ", ")) or "Nothing useful."
		if #leftovers > 0 then
			text ..= " (no room for some: left on the floor)"
		end
		Net.notify(player, "Toast", { text = text })
	end)
end

-- Fills an encounter with containers and loose items.
function LootService.populate(parent, rng, pall, containerSpots, looseSpots)
	-- a handful of containers per map, picked at random (not one in every corner)
	local pool = table.clone(containerSpots)
	for i = #pool, 2, -1 do
		local j = rng:NextInteger(1, i)
		pool[i], pool[j] = pool[j], pool[i]
	end
	for i = 1, math.min(Loot.MaxContainers or 12, #pool) do
		container(parent, pool[i], rng, pall)
	end
	local spots = table.clone(looseSpots)
	for i = #spots, 2, -1 do
		local j = rng:NextInteger(1, i)
		spots[i], spots[j] = spots[j], spots[i]
	end
	for i = 1, math.min(Loot.LooseItems, #spots) do
		local entry = LootService.roll("loose", 1, rng, 1)[1]
		if entry then
			local jitter = Vector3.new(rng:NextNumber(-1.5, 1.5), 0, rng:NextNumber(-1.5, 1.5))
			LootService.dropPickup(parent, settle(spots[i] + jitter, parent), entry[1], entry[2])
		end
	end
end

function LootService.init(registry)
	Services = registry
end

return LootService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000039"><Properties><string name="Name">MapService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Builds the grey-box world in code so the project is fully self-contained:
--   * The Meridian (ferry hideout deck) far from the encounter
--   * the encounter maps (src/server/Maps/*), one loaded at a time
-- and resets per-encounter objects (supply crates, part pickups, extraction flare).
-- Stage 4+ replaces the grey-box with hand-built art (docs/05-roadmap-and-prototype.md).
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Game = require(Shared.Config.Game)
local Encounters = require(Shared.Config.Encounters)
local Sfx = require(Shared.Util.Sfx)

local MapService = {}
local Services

local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local C = {
	ground = Color3.fromRGB(58, 62, 64),
	wall = Color3.fromRGB(84, 86, 84),
	wallDark = Color3.fromRGB(62, 64, 64),
	roof = Color3.fromRGB(74, 70, 64),
	metal = Color3.fromRGB(46, 48, 50),
	crate = Color3.fromRGB(92, 72, 52),
	machine = Color3.fromRGB(70, 78, 80),
	supply = Color3.fromRGB(150, 92, 44),
	bone = Color3.fromRGB(226, 220, 206),
	water = Color3.fromRGB(52, 70, 74),
	reed = Color3.fromRGB(92, 94, 70),
	warm = Color3.fromRGB(255, 190, 120),
	flare = Color3.fromRGB(255, 70, 50),
	containers = {
		Color3.fromRGB(110, 54, 42),
		Color3.fromRGB(42, 78, 80),
		Color3.fromRGB(52, 62, 82),
		Color3.fromRGB(128, 104, 52),
	},
}


-- Encounter layout data -------------------------------------------------------------------

-- Filled from the active map module when a map loads (see MapService.loadMap).
MapService.StartSpawns = {}
MapService.ExtractionPos = Vector3.zero
MapService.LanternPos = Vector3.zero
MapService.SupplyCandidates = {}
MapService.LootSpots = {}
MapService.ContainerSpots = {}
MapService.EdgeSpawns = {}
MapService.PatrolRoutes = {}
MapService.Doorways = {}
MapService.MapIds = { "CanneryRow", "LarkspurStreet", "HollowPines" }

local MapsFolder = script.Parent.Parent:WaitForChild("Maps")
local MapKit = require(MapsFolder:WaitForChild("MapKit"))
local MAP_MODULES = {}
for _, id in MapService.MapIds do
	MAP_MODULES[id] = require(MapsFolder:WaitForChild(id))
end

-- Builders --------------------------------------------------------------------------------

local function block(parent, size, position, color, material, props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = typeof(position) == "CFrame" and position or CFrame.new(position)
	p.Color = color
	p.Material = material or Enum.Material.Concrete
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props then
		for key, value in props do
			p[key] = value
		end
	end
	p.Parent = parent
	return p
end

local function volume(parent, size, position, tag)
	local p = block(parent, size, position, Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, {
		Name = tag,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
	})
	CollectionService:AddTag(p, tag)
	return p
end

-- The Meridian (hideout) ------------------------------------------------------------------

-- Layout check: every solid fixture registers its box; overlaps are reported (Output / F2),
-- so nothing ends up lodged in the bridge or another fixture again.
local layoutBoxes = {}
local function register(name, cf, size)
	local half = size / 2
	local corners = {}
	for _, sx in { -1, 1 } do
		for _, sy in { -1, 1 } do
			for _, sz in { -1, 1 } do
				table.insert(corners, (typeof(cf) == "CFrame" and cf or CFrame.new(cf)) * Vector3.new(half.X * sx, half.Y * sy, half.Z * sz))
			end
		end
	end
	local lo, hi = corners[1], corners[1]
	for _, c in corners do
		lo = lo:Min(c)
		hi = hi:Max(c)
	end
	table.insert(layoutBoxes, { name = name, lo = lo, hi = hi })
end

function MapService.getLeaderboardPart()
	return MapService.leaderboardPart
end

function MapService.checkLayout(label)
	local problems = 0
	local EPS = 0.05
	for i = 1, #layoutBoxes do
		for j = i + 1, #layoutBoxes do
			local a, b = layoutBoxes[i], layoutBoxes[j]
			if a.lo.X < b.hi.X - EPS and b.lo.X < a.hi.X - EPS and a.lo.Y < b.hi.Y - EPS and b.lo.Y < a.hi.Y - EPS and a.lo.Z < b.hi.Z - EPS and b.lo.Z < a.hi.Z - EPS then
				problems += 1
				warn(("[Layout] %s: %s overlaps %s"):format(label, a.name, b.name))
			end
		end
	end
	print(("[Layout] %s: %d fixtures, %d overlaps"):format(label, #layoutBoxes, problems))
	return problems
end

local function fixture(parent, name, size, position, color, material, props)
	local cf = typeof(position) == "CFrame" and position or CFrame.new(position)
	register(name, cf, size)
	local part = block(parent, size, cf, color, material, props)
	part.Name = name
	return part
end

local function prompt(parent, action, object, onTriggered, hold)
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = object
	p.HoldDuration = hold or 0
	p.MaxActivationDistance = 9
	p.RequiresLineOfSight = false
	p.GamepadKeyCode = Enum.KeyCode.ButtonA
	p.Parent = parent
	p.Triggered:Connect(onTriggered)
	return p
end

-- Station signs: a floating name card above each station, readable from across the deck.
-- `hero` = the big gold "start here" card for the chart table.
local function stationSign(part, title, subtitle, color, offsetY, hero)
	local gui = Instance.new("BillboardGui")
	gui.Name = "StationSign"
	gui.Size = hero and UDim2.new(11, 0, 3.4, 0) or UDim2.new(7.5, 0, 2.2, 0)
	gui.StudsOffsetWorldSpace = Vector3.new(0, offsetY or 4, 0)
	gui.MaxDistance = hero and 220 or 70
	gui.LightInfluence = 0
	gui.Parent = part
	local card = Instance.new("Frame")
	card.Size = UDim2.fromScale(1, 1)
	card.BackgroundColor3 = hero and Color3.fromRGB(255, 196, 70) or Color3.fromRGB(20, 26, 30)
	card.BackgroundTransparency = hero and 0 or 0.15
	card.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.25, 0)
	corner.Parent = card
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = hero and 4 or 3
	stroke.Parent = card
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 0.62)
	t.Font = Enum.Font.Oswald
	t.TextScaled = true
	t.Text = title
	t.TextColor3 = hero and Color3.fromRGB(40, 24, 8) or color
	t.Parent = card
	local s = Instance.new("TextLabel")
	s.BackgroundTransparency = 1
	s.Position = UDim2.fromScale(0.05, 0.6)
	s.Size = UDim2.fromScale(0.9, 0.34)
	s.Font = Enum.Font.GothamMedium
	s.TextScaled = true
	s.Text = subtitle
	s.TextColor3 = hero and Color3.fromRGB(70, 44, 14) or Color3.fromRGB(230, 226, 214)
	s.Parent = card
	return gui
end

-- A striped canvas awning (market-stall style) over a station.
local function awning(parent, center, sizeX, sizeZ, height, colorA, colorB, alongX)
	local stripes = 6
	for i = 0, stripes - 1 do
		local col = i % 2 == 0 and colorA or colorB
		local w = (alongX and sizeX or sizeZ) / stripes
		local off = -((alongX and sizeX or sizeZ) / 2) + w * (i + 0.5)
		local size = alongX and Vector3.new(w, 0.25, sizeZ) or Vector3.new(sizeX, 0.25, w)
		local pos = center + (alongX and Vector3.new(off, height, 0) or Vector3.new(0, height, off))
		block(parent, size, CFrame.new(pos) * CFrame.Angles(alongX and 0.12 or 0, 0, alongX and 0 or 0.12), col, Enum.Material.Fabric, { CanCollide = false, CastShadow = true })
	end
end

local function potPlant(parent, at, scale)
	scale = scale or 1
	block(parent, Vector3.new(1.6, 1.4, 1.6) * scale, at + Vector3.new(0, 0.7 * scale, 0), Color3.fromRGB(196, 104, 64), Enum.Material.Slate, { Shape = Enum.PartType.Cylinder, CFrame = CFrame.new(at + Vector3.new(0, 0.7 * scale, 0)) * CFrame.Angles(0, 0, math.pi / 2) })
	for i, c in { { 0, 2.1, 0, 2.2 }, { 0.5, 2.6, 0.3, 1.5 }, { -0.4, 2.5, -0.3, 1.4 } } do
		local green = i == 1 and Color3.fromRGB(76, 150, 70) or Color3.fromRGB(96, 172, 80)
		block(parent, Vector3.new(c[4], c[4], c[4]) * scale, at + Vector3.new(c[1], c[2], c[3]) * scale, green, Enum.Material.LeafyGrass, { Shape = Enum.PartType.Ball, CanCollide = false })
	end
	if scale >= 1 then
		block(parent, Vector3.new(0.5, 0.5, 0.5), at + Vector3.new(0.4, 3.0, -0.2) * scale, Color3.fromRGB(240, 90, 110), Enum.Material.SmoothPlastic, { Shape = Enum.PartType.Ball, CanCollide = false })
	end
end

local function lifeRing(parent, cf)
	-- an orange ring of 8 short segments with white bands
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		local col = i % 2 == 0 and Color3.fromRGB(240, 110, 40) or Color3.fromRGB(245, 240, 230)
		block(parent, Vector3.new(0.5, 0.5, 0.95), cf * CFrame.Angles(0, 0, a) * CFrame.new(0, 1, 0) * CFrame.Angles(0, math.pi / 2, 0), col, Enum.Material.SmoothPlastic, { CanCollide = false })
	end
end

-- The Meridian: a car ferry turned home, moored at a sunny harbour pier.
-- 96 x 32 studs of deck, bridge at the stern (-X). Everything starts at the CHART TABLE in the
-- middle of the deck (gold light, "SET SAIL"); the other stations ring the deck with signs.
--   x -47..-31  bridge (crew cabin door, projects board, leaderboard on its front face)
--   x -28..-9   aft deck: crew lockers + quest board (starboard), workbench (port)
--   x  -9.. 9   midships plaza: chart table, Lucky Spin wheel (starboard), spawn line
--   x  26..34   Quartermaster (starboard), Purser's Office shop (port)
--   project rooms go where the scaffolding stands (see ROOMS)
local function buildFerry(parent)
	table.clear(layoutBoxes)
	local o = Game.FerryOrigin
	local M = Enum.Material
	local teak = Color3.fromRGB(164, 112, 70)
	local white = Color3.fromRGB(240, 236, 226)
	local teal = Color3.fromRGB(32, 150, 160)
	local red = Color3.fromRGB(196, 54, 46)
	local navy = Color3.fromRGB(30, 52, 84)

	-- harbour: clear turquoise water, a sandy shallows strip, the pier, a distant island
	block(parent, Vector3.new(1400, 1, 1400), o + Vector3.new(0, -6, 0), Color3.fromRGB(40, 150, 170), M.Glass, { Reflectance = 0.18, Transparency = 0.1, CanQuery = false })
	block(parent, Vector3.new(1400, 1, 1400), o + Vector3.new(0, -9, 0), Color3.fromRGB(196, 188, 140), M.Sand, { CanQuery = false })
