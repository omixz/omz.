<Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">MeshKit</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Fits sculpted meshes (from tools/build_assets.py) onto a live skeleton.
--
-- Each segment mesh was sculpted around canonical joints (MeshMeta: top / bottom anchors).
-- At runtime we read the real joint positions from the rig's Motor6Ds, scale the segment
-- uniformly so its anchor-to-anchor length matches, and weld it so its top anchor sits
-- exactly on the real joint. Proportions stay realistic whatever the skeleton's sizes are.
local MeshKit = {}

local CHILD = {
	r15 = {
		LowerTorso = "UpperTorso", UpperTorso = "Head",
		RightUpperArm = "RightLowerArm", RightLowerArm = "RightHand",
		LeftUpperArm = "LeftLowerArm", LeftLowerArm = "LeftHand",
		RightUpperLeg = "RightLowerLeg", RightLowerLeg = "RightFoot",
		LeftUpperLeg = "LeftLowerLeg", LeftLowerLeg = "LeftFoot",
	},
	enemy = {
		Torso = "Head",
		RightUpperArm = "RightLowerArm", LeftUpperArm = "LeftLowerArm",
		RightUpperLeg = "RightLowerLeg", LeftUpperLeg = "LeftLowerLeg",
	},
}

-- Segments without their own child joint borrow the scale of this segment.
local SCALE_FROM = {
	r15 = { Head = "UpperTorso", RightHand = "RightLowerArm", LeftHand = "LeftLowerArm", RightFoot = "RightLowerLeg", LeftFoot = "LeftLowerLeg" },
	enemy = { Head = "Torso", Pelvis = "Torso" },
}

-- Order matters: scale donors first.
local ORDER = {
	r15 = { "UpperTorso", "LowerTorso", "Head", "RightUpperArm", "LeftUpperArm", "RightLowerArm", "LeftLowerArm", "RightHand", "LeftHand", "RightUpperLeg", "LeftUpperLeg", "RightLowerLeg", "LeftLowerLeg", "RightFoot", "LeftFoot" },
	enemy = { "Torso", "Pelvis", "Head", "RightUpperArm", "LeftUpperArm", "RightLowerArm", "LeftLowerArm", "RightUpperLeg", "LeftUpperLeg", "RightLowerLeg", "LeftLowerLeg" },
}

local function v3(t)
	return Vector3.new(t[1], t[2], t[3])
end

local function jointsOf(model)
	local own, byParent = {}, {}
	for _, m in model:GetDescendants() do
		if m:IsA("Motor6D") and m.Part0 and m.Part1 then
			own[m.Part1] = m
			byParent[m.Part0] = byParent[m.Part0] or {}
			byParent[m.Part0][m.Part1.Name] = m
		end
	end
	return own, byParent
end

-- getPart(name) -> MeshPart clone or nil. Returns true if every segment was fitted.
function MeshKit.applyRig(model, meta, getPart, format, yawFix)
	local own, byParent = jointsOf(model)
	local scales = {}
	local fitted = {}
	local yaw = CFrame.Angles(0, math.rad(yawFix or 0), 0)
	for _, segName in ORDER[format] do
		local seg = meta.segments[segName]
		local bone = segName == "Pelvis" and model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild(segName)
		if seg and bone then
			-- actual anchor positions in the bone's local space
			local ownJoint = own[bone]
			local A = ownJoint and ownJoint.C1.Position or Vector3.zero
			local B
			local childName = CHILD[format][segName]
			local childJoint = childName and byParent[bone] and byParent[bone][childName]
			if childJoint then
				B = childJoint.C0.Position
			elseif seg.bottom and ownJoint then
				B = Vector3.new(A.X, A.Y - bone.Size.Y, A.Z) -- limb ends at the bottom of the part
			end
			local s
			if B and seg.top and seg.bottom then
				local canon = (v3(seg.bottom) - v3(seg.top)).Magnitude
				s = canon > 0.01 and (B - A).Magnitude / canon or 1
			else
				s = scales[SCALE_FROM[format][segName] or ""] or 1
			end
			scales[segName] = s
			local top = seg.top and v3(seg.top) or Vector3.zero
			for layerName, layer in seg.layers do
				local mp = getPart(layer.part)
				if mp then
					mp.Name = "Mesh_" .. segName .. "_" .. layerName
					mp.Size = v3(layer.size) * s
					mp.Material = Enum.Material[layer.material] or Enum.Material.SmoothPlastic
					mp.Color = Color3.new(layer.color[1], layer.color[2], layer.color[3])
					mp.Anchored = false
					mp.CanCollide = false
					mp.CanQuery = false
					mp.CanTouch = false
					mp.Massless = true
					mp.CastShadow = true
					local offset = A + (v3(layer.center) - top) * s
					mp.CFrame = bone.CFrame * CFrame.new(offset) * yaw
					local weld = Instance.new("Weld")
					weld.Part0 = bone
					weld.Part1 = mp
					weld.C0 = CFrame.new(offset) * yaw
					weld.Parent = mp
					mp.Parent = model
				end
			end
			fitted[bone] = true
		end
	end
	-- hide the original body parts (keep them for joints, physics and hit detection)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and not d.Name:match("^Mesh_") and d.Parent == model then
			d.Transparency = 1
		elseif d:IsA("Decal") then
			d.Transparency = 1
		elseif d:IsA("BasePart") and d.Parent ~= model and not d:FindFirstAncestorWhichIsA("Model").Name:match("^Weapon_") then
			d.Transparency = 1
		end
	end
	return true
end

-- Builds a static prop model (anchored) at `cframe` with uniform `scale`.
-- Props are generated with their base at y = 0, so cframe is the ground point.
function MeshKit.buildProp(meta, getPart, cframe, scale, parent)
	local model = Instance.new("Model")
	local any = false
	for layerName, layer in meta.layers do
		local mp = getPart(layer.part)
		if mp then
			mp.Name = layerName
			mp.Size = v3(layer.size) * scale
			mp.Material = Enum.Material[layer.material] or Enum.Material.SmoothPlastic
			mp.Color = Color3.new(layer.color[1], layer.color[2], layer.color[3])
			mp.Anchored = true
			mp.CFrame = cframe * CFrame.new(v3(layer.center) * scale)
			mp.Parent = model
			any = true
		end
	end
	if not any then
		model:Destroy()
		return nil
	end
	model.Parent = parent
	return model
end

-- Welds weapon / tool layers onto a grip part (grip = origin, barrel along -Z).
function MeshKit.attachToGrip(meta, getPart, grip, skip)
	local any = false
	for layerName, layer in meta.layers do
		if not (skip and skip[layerName]) then
			local mp = getPart(layer.part)
			if mp then
				mp.Name = "Mesh_" .. layerName
				mp.Size = v3(layer.size)
				mp.Material = Enum.Material[layer.material] or Enum.Material.SmoothPlastic
				mp.Color = Color3.new(layer.color[1], layer.color[2], layer.color[3])
				mp.Anchored = false
				mp.CanCollide = false
				mp.CanQuery = false
				mp.CanTouch = false
				mp.Massless = true
				mp.CFrame = grip.CFrame * CFrame.new(v3(layer.center))
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = grip
				weld.Part1 = mp
				weld.Parent = mp
				mp.Parent = grip.Parent
				any = true
			end
		end
	end
	return any
end

return MeshKit
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Every client<->server message goes through these RemoteEvents. The server creates them;
-- clients wait for them. Server handlers are rate-limited and wrapped in pcall so a bad
-- payload can never crash a service. Validate EVERY argument in the handler.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

local EVENTS = {
	"SelectCharacter", -- client -> server (charId, perkId)
	"SetMoveState", -- client -> server (stance, sprinting, aiming)
	"Action", -- client -> server (actionName, payload)
	"ReturnToFerry", -- client -> server ()
	"Request", -- client -> server (kind, a, b): ferry menus (chart, workbench, repairs, settings)
	"Look", -- client -> server (pitch): aim pitch for other players' upper-body pose
	"Notify", -- server -> client (kind, data)
}

local folder
if RunService:IsServer() then
	folder = ReplicatedStorage:FindFirstChild("Net")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Net"
	end
	for _, name in EVENTS do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
		end
	end
	folder.Parent = ReplicatedStorage
else
	folder = ReplicatedStorage:WaitForChild("Net")
end

function Net.event(name)
	return folder:WaitForChild(name)
end

local buckets = {}

-- Server only. `rate` = max messages per second per player (token bucket).
function Net.onServer(name, rate, handler)
	local remote = Net.event(name)
	remote.OnServerEvent:Connect(function(player, ...)
		local key = player.UserId
		local perPlayer = buckets[key]
		if not perPlayer then
			perPlayer = {}
			buckets[key] = perPlayer
		end
		local now = os.clock()
		local bucket = perPlayer[name]
		if not bucket then
			bucket = { tokens = rate, t = now }
			perPlayer[name] = bucket
		end
		bucket.tokens = math.min(rate, bucket.tokens + (now - bucket.t) * rate)
		bucket.t = now
		if bucket.tokens < 1 then
			return -- dropped: flooding
		end
		bucket.tokens -= 1
		local ok, err = pcall(handler, player, ...)
		if not ok then
			warn(("[Net] %s handler error for %s: %s"):format(name, player.Name, tostring(err)))
		end
	end)
end

function Net.notify(player, kind, data)
	Net.event("Notify"):FireClient(player, kind, data)
end

function Net.notifyAll(kind, data)
	Net.event("Notify"):FireAllClients(kind, data)
end

if RunService:IsServer() then
	Players.PlayerRemoving:Connect(function(player)
		buckets[player.UserId] = nil
	end)
end

return Net
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">Stats</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Combines a character's innate perk and chosen perk into one modifier table.
local Characters = require(script.Parent.Config.Characters)

local Stats = {}

local DEFAULTS = {
	noiseMult = 1,
	crouchNoiseMult = 1,
	waterNoiseMult = 1,
	takedownTimeMult = 1,
	shoveCooldownMult = 1,
	healMult = 1,
	throwCapBonus = 0,
	damageTakenMult = 1,
	abilityCooldownMult = 1,
	abilityRadiusMult = 1,
	abilityDurationMult = 1,
	sprintSpeedMult = 1,
	reviveHPBonus = 0,
	bleedOutBonus = 0,
	throwNoiseMult = 1,
	craftTimeMult = 1,
	craftYieldBonus = 0,
	ammoBonus = 0,
	aimSpreadMult = 1,
}

local ADDITIVE = {
	throwCapBonus = true,
	reviveHPBonus = true,
	bleedOutBonus = true,
	craftYieldBonus = true,
	ammoBonus = true,
}

local function apply(result, mods)
	for key, value in mods do
		if DEFAULTS[key] == nil then
			warn("[Stats] unknown perk modifier: " .. tostring(key))
		elseif ADDITIVE[key] then
			result[key] += value
		else
			result[key] *= value
		end
	end
end

function Stats.findPerk(charId, perkId)
	local def = Characters.List[charId]
	if not def then
		return nil
	end
	for _, perk in def.perks do
		if perk.id == perkId then
			return perk
		end
	end
	return nil
end

-- extraPerks: optional set { [perkId] = true } of perks bought at the workbench this run.
function Stats.compute(charId, perkId, extraPerks)
	local result = table.clone(DEFAULTS)
	local def = Characters.List[charId]
	if not def then
		return result
	end
	apply(result, def.innate.mods)
	local perk = Stats.findPerk(charId, perkId)
	if perk then
		apply(result, perk.mods)
	end
	if extraPerks then
		for _, p in def.perks do
			if extraPerks[p.id] and p.id ~= perkId then
				apply(result, p.mods)
			end
		end
	end
	return result
end

return Stats
]]></ProtectedString></Properties></Item>
<Item class="Folder" referent="RBX0000001B"><Properties><string name="Name">Util</string></Properties><Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">Geometry</string><ProtectedString name="Source"><![CDATA[--!nonstrict
local CollectionService = game:GetService("CollectionService")

local Geometry = {}

function Geometry.pointInPart(point, part)
	local rel = part.CFrame:PointToObjectSpace(point)
	local half = part.Size * 0.5
	return math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y and math.abs(rel.Z) <= half.Z
end

-- True if `point` lies inside any part tagged `tag` (volumes such as TallGrass, LitZone, Shallows).
function Geometry.inTagged(point, tag)
	for _, part in CollectionService:GetTagged(tag) do
		if part:IsA("BasePart") and Geometry.pointInPart(point, part) then
			return true
		end
	end
	return false
end

function Geometry.flat(v)
	return Vector3.new(v.X, 0, v.Z)
end

function Geometry.flatDistance(a, b)
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

-- Rejects NaN, infinities and absurd values sent by clients.
function Geometry.isSaneVector(v, maxMagnitude)
	if typeof(v) ~= "Vector3" then
		return false
	end
	if v.X ~= v.X or v.Y ~= v.Y or v.Z ~= v.Z then
		return false
	end
	return v.Magnitude <= (maxMagnitude or 1e5)
end

return Geometry
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000019"><Properties><string name="Name">Sfx</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- One-shot 3D sounds (server: everyone hears it; client: only you) and attached loops.
local Debris = game:GetService("Debris")
local Workspace = game:GetService("Workspace")

local Sounds = require(script.Parent.Parent.Config.Sounds)

local Sfx = {}

local function make(soundKey, volume, maxDistance, pitchJitter)
	local id = Sounds[soundKey]
	if type(id) ~= "string" or id == "" then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = (volume or 0.6) * ((Sounds.Volume and Sounds.Volume[soundKey]) or 1)
	sound.RollOffMaxDistance = maxDistance or 120
	sound.RollOffMinDistance = 6
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	if pitchJitter and pitchJitter > 0 then
		sound.PlaybackSpeed = 1 + (math.random() * 2 - 1) * pitchJitter
	end
	return sound
end

function Sfx.has(soundKey)
	local id = Sounds[soundKey]
	return type(id) == "string" and id ~= ""
end

function Sfx.at(position, soundKey, volume, maxDistance, pitchJitter)
	local sound = make(soundKey, volume, maxDistance, pitchJitter or 0.06)
	if not sound then
		return
	end
	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.new(0.2, 0.2, 0.2)
	holder.CFrame = CFrame.new(position)
	sound.Parent = holder
	holder.Parent = Workspace
	sound:Play()
	Debris:AddItem(holder, 8)
end

-- Attach a sound to a part (looping or one-shot). Returns the Sound or nil.
function Sfx.attach(part, soundKey, volume, maxDistance, looped)
	local sound = make(soundKey, volume, maxDistance, 0)
	if not sound then
		return nil
	end
	sound.Looped = looped == true
	sound.Parent = part
	sound:Play()
	if not looped then
		Debris:AddItem(sound, 10)
	end
	return sound
end

-- Non-positional (UI, music, ambience) on the client.
function Sfx.ui(soundKey, volume, looped)
	local sound = make(soundKey, volume, nil, 0)
	if not sound then
		return nil
	end
	sound.Looped = looped == true
	sound.Parent = game:GetService("SoundService")
	sound:Play()
	if not looped then
		Debris:AddItem(sound, 12)
	end
	return sound
end

return Sfx
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000001A"><Properties><string name="Name">Spring</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Critically damped spring. Works for numbers and Vector3s.
-- frequency = how quickly it settles (higher = snappier).
local Spring = {}
Spring.__index = Spring

function Spring.new(initial, frequency)
	return setmetatable({
		position = initial,
		velocity = initial * 0,
		target = initial,
		frequency = frequency or 8,
	}, Spring)
end

function Spring:reset(value)
	self.position = value
	self.velocity = value * 0
	self.target = value
end

function Spring:update(dt)
	local w = self.frequency * 2 * math.pi
	local disp = self.position - self.target
	local decay = math.exp(-w * dt)
	local k = self.velocity + disp * w
	self.position = self.target + (disp + k * dt) * decay
	self.velocity = (self.velocity - k * w * dt) * decay
	return self.position
end

return Spring
]]></ProtectedString></Properties></Item>
</Item>
<Item class="ModuleScript" referent="RBX0000001C"><Properties><string name="Name">WeaponModels</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Builds stylised weapon models from parts (placeholders until Stage 5 meshes).
-- Each model: PrimaryPart "Grip" (held in the right hand), barrel along -Z, and an
-- Attachment "Muzzle" at the barrel tip. Parts are massless and ignored by raycasts.
local WeaponModels = {}

local METAL = Color3.fromRGB(44, 46, 50)
local STEEL = Color3.fromRGB(88, 90, 94)
local WOOD = Color3.fromRGB(96, 64, 42)
local DARKWOOD = Color3.fromRGB(70, 46, 32)
local BONE = Color3.fromRGB(214, 206, 188)

-- { size, offset CFrame from grip, color, material, shape? }
local SPECS = {
	revolver = {
		muzzle = Vector3.new(0, 0.38, -1.25),
		parts = {
			{ Vector3.new(0.24, 0.55, 0.34), CFrame.new(0, 0, 0.05) * CFrame.Angles(math.rad(-12), 0, 0), DARKWOOD, Enum.Material.Wood },
			{ Vector3.new(0.22, 0.34, 0.7), CFrame.new(0, 0.3, -0.25), METAL, Enum.Material.Metal },
			{ Vector3.new(0.36, 0.32, 0.32), CFrame.new(0, 0.3, -0.2) * CFrame.Angles(0, math.rad(90), 0), STEEL, Enum.Material.Metal, Enum.PartType.Cylinder },
			{ Vector3.new(0.14, 0.14, 0.82), CFrame.new(0, 0.38, -0.85), METAL, Enum.Material.Metal },
		},
	},
	rifle = {
		muzzle = Vector3.new(0, 0.18, -2.85),
		parts = {
			{ Vector3.new(0.24, 0.45, 1.2), CFrame.new(0, -0.02, 0.75), WOOD, Enum.Material.Wood },
			{ Vector3.new(0.22, 0.28, 1.1), CFrame.new(0, 0.15, -0.4), WOOD, Enum.Material.Wood },
			{ Vector3.new(0.18, 0.2, 0.9), CFrame.new(0, 0.3, -0.25), METAL, Enum.Material.Metal },
			{ Vector3.new(0.12, 0.12, 1.9), CFrame.new(0, 0.18, -1.9), METAL, Enum.Material.Metal },
			{ Vector3.new(0.06, 0.06, 0.3), CFrame.new(0.16, 0.32, 0.05), STEEL, Enum.Material.Metal }, -- bolt
		},
	},
	carbine = {
		muzzle = Vector3.new(0, 0.2, -2.2),
		parts = {
			{ Vector3.new(0.24, 0.42, 1.0), CFrame.new(0, -0.02, 0.65), WOOD, Enum.Material.Wood },
			{ Vector3.new(0.22, 0.3, 0.9), CFrame.new(0, 0.15, -0.3), METAL, Enum.Material.Metal },
			{ Vector3.new(0.13, 0.13, 1.5), CFrame.new(0, 0.22, -1.45), METAL, Enum.Material.Metal },
			{ Vector3.new(0.15, 0.15, 1.2), CFrame.new(0, 0.06, -1.3), WOOD, Enum.Material.Wood }, -- fore-end
			{ Vector3.new(0.08, 0.26, 0.36), CFrame.new(0, -0.17, -0.1), STEEL, Enum.Material.Metal }, -- lever
		},
	},
	shotgun = {
		muzzle = Vector3.new(0, 0.22, -2.3),
		parts = {
			{ Vector3.new(0.26, 0.45, 1.0), CFrame.new(0, -0.02, 0.6), DARKWOOD, Enum.Material.Wood },
			{ Vector3.new(0.26, 0.32, 0.9), CFrame.new(0, 0.15, -0.35), METAL, Enum.Material.Metal },
			{ Vector3.new(0.18, 0.18, 1.6), CFrame.new(0, 0.24, -1.5), METAL, Enum.Material.Metal },
			{ Vector3.new(0.16, 0.16, 1.4), CFrame.new(0, 0.06, -1.4), STEEL, Enum.Material.Metal }, -- magazine tube
			{ Vector3.new(0.26, 0.24, 0.6), CFrame.new(0, 0.06, -1.25), DARKWOOD, Enum.Material.Wood }, -- pump
		},
	},
	bow = {
		muzzle = Vector3.new(0, 0.1, -0.5),
		parts = {
			{ Vector3.new(0.2, 0.6, 0.26), CFrame.new(0, 0, 0), DARKWOOD, Enum.Material.Wood },
			{ Vector3.new(0.12, 1.8, 0.18), CFrame.new(0, 1.15, 0.12) * CFrame.Angles(math.rad(-14), 0, 0), WOOD, Enum.Material.Wood },
			{ Vector3.new(0.12, 1.8, 0.18), CFrame.new(0, -1.15, 0.12) * CFrame.Angles(math.rad(14), 0, 0), WOOD, Enum.Material.Wood },
			{ Vector3.new(0.03, 4.1, 0.03), CFrame.new(0, 0, 0.5), BONE, Enum.Material.Fabric },
			{ Vector3.new(0.05, 0.05, 1.6), CFrame.new(0, 0.1, -0.2), BONE, Enum.Material.Wood }, -- nocked arrow
		},
	},
}

local function prep(part)
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
end

-- getPart / meta are optional: when the sculpted weapon meshes are loaded they replace the
-- part-built placeholder (grip + muzzle attachment stay the same).
function WeaponModels.build(weaponId, getPart, meta, skipLayers)
	local spec = SPECS[weaponId]
	if not spec then
		return nil
	end
	if getPart and meta then
		local model = Instance.new("Model")
		model.Name = "Weapon_" .. weaponId
		local grip = Instance.new("Part")
		grip.Name = "Grip"
		grip.Size = Vector3.new(0.2, 0.2, 0.2)
		grip.Transparency = 1
		grip.CFrame = CFrame.new()
		prep(grip)
		grip.Parent = model
		model.PrimaryPart = grip
		local MeshKit = require(script.Parent.MeshKit)
		if MeshKit.attachToGrip(meta, getPart, grip, skipLayers) then
			local muzzle = Instance.new("Attachment")
			muzzle.Name = "Muzzle"
			muzzle.Position = spec.muzzle
			muzzle.Parent = grip
			return model
		end
		model:Destroy()
	end
	local model = Instance.new("Model")
	model.Name = "Weapon_" .. weaponId

	local grip = Instance.new("Part")
	grip.Name = "Grip"
	grip.Size = Vector3.new(0.2, 0.2, 0.2)
	grip.Transparency = 1
	grip.CFrame = CFrame.new()
	prep(grip)
	grip.Parent = model
	model.PrimaryPart = grip

	for i, p in spec.parts do
		local part = Instance.new("Part")
		part.Name = "Piece" .. i
		part.Size = p[1]
		part.CFrame = p[2]
		part.Color = p[3]
		part.Material = p[4]
		if p[5] then
			part.Shape = p[5]
		end
		prep(part)
		part.Parent = model
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = grip
		weld.Part1 = part
		weld.Parent = part
	end

	local muzzle = Instance.new("Attachment")
	muzzle.Name = "Muzzle"
	muzzle.Position = spec.muzzle
	muzzle.Parent = grip
	return model
end

-- Where each weapon sits relative to its parent part.
WeaponModels.HandOffset = CFrame.new(0, -0.15, 0) * CFrame.Angles(-math.pi / 2, 0, 0)
WeaponModels.BackOffset = CFrame.new(0, 0, 0.62) * CFrame.Angles(0, 0, math.rad(35)) * CFrame.Angles(math.rad(90), 0, 0)
WeaponModels.HipOffset = CFrame.new(0.95, -0.2, 0) * CFrame.Angles(math.rad(-90), 0, 0)

return WeaponModels
]]></ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX00000036"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX00000035"><Properties><string name="Name">Server</string></Properties><Item class="Script" referent="RBX0000001F"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- AFTERTIDE server bootstrap. Every service exposes optional init(registry) and start().
-- init wires dependencies (no yielding); start begins loops and connections.
local Players = game:GetService("Players")

Players.CharacterAutoLoads = false -- CharacterService spawns the crew rigs itself

local Services = script.Parent:WaitForChild("Services")

local ORDER = {
	"PlayerDataService",
	"AssetService",
	"MapService",
	"PerceptionService",
	"InventoryService",
	"CharacterService",
	"WeaponService",
	"EnemyService",
	"LootService",
	"ActionService",
	"WorkbenchService",
	"HomebaseService",
	"CommerceService",
	"MatchService",
	"AntiCheatService",
}

local registry = {}
for _, name in ORDER do
	registry[name] = require(Services:WaitForChild(name))
end
for _, name in ORDER do
	local service = registry[name]
	if service.init then
		service.init(registry)
	end
end
for _, name in ORDER do
	local service = registry[name]
	if service.start then
		task.spawn(service.start)
	end
end

print("[AFTERTIDE] server ready")
]]></ProtectedString></Properties></Item>
<Item class="Folder" referent="RBX00000024"><Properties><string name="Name">Maps</string></Properties><Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">CanneryRow</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- CANNERY ROW: a coastal fish cannery, container yard, net shed and tidal shallows.
-- Bright overcast midday. Terrain ground (asphalt yard, concrete, grass verges, mud),
-- real terrain water in the shallows, reeds and tall grass to hide in.
local MapKit = require(script.Parent.MapKit)
local C = MapKit.C
local block, volume = MapKit.block, MapKit.volume

local Map = {
	id = "CanneryRow",
	name = "Cannery Row",
	lighting = { clock = 13.6, brightness = 2.7, ambient = { 92, 98, 104 }, outdoor = { 140, 146, 150 }, fog = 0.3, haze = 1.2, fogColor = { 200, 206, 208 }, tint = { 236, 240, 242 }, saturation = -0.12, contrast = 0.12, shift = { 255, 238, 220 } },
}

function Map.build(parent, rng)
	local M = Enum.Material
	-- terrain base: concrete yard, asphalt lanes, grass verges, mud by the water
	MapKit.slab(-118, -118, 118, 118, M.Concrete, 0)
	MapKit.slab(-12, 14, 118, 30, M.Asphalt, 0.02)
	MapKit.slab(66, -118, 118, 118, M.Asphalt, 0.02)
	MapKit.slab(-70, 30, -10, 118, M.Grass, 0.05)
	MapKit.slab(-70, -118, -30, -40, M.Grass, 0.05)
	MapKit.slab(-75, -118, -64, 118, M.Mud, 0.0)
	-- the shallows: ground dips, terrain water on top
	MapKit.clearAbove(-118, -92, -70, 72, -1.6)
	MapKit.slab(-118, -92, -70, 72, M.Mud, -1.6)
	MapKit.water(-118, -92, -70, 72, 0.3, 1.9)
	volume(parent, Vector3.new(48, 6, 164), Vector3.new(-94, 2, -10), "Shallows")

	-- perimeter wall
	block(parent, Vector3.new(236, 16, 2), Vector3.new(0, 8, -118), C.wallDark, M.Concrete)
	block(parent, Vector3.new(236, 16, 2), Vector3.new(0, 8, 118), C.wallDark, M.Concrete)
	block(parent, Vector3.new(2, 16, 236), Vector3.new(118, 8, 0), C.wallDark, M.Concrete)
	block(parent, Vector3.new(2, 16, 236), Vector3.new(-118, 8, 0), C.wallDark, M.Concrete)

	-- the cannery
	local h = 16
	MapKit.wallX(parent, -50, -10, 60, h, { { 20, 28 } }, C.wall, M.Brick)
	MapKit.wallX(parent, 10, -10, 60, h, { { 5, 13 }, { 40, 48 } }, C.wall, M.Brick)
	MapKit.wallZ(parent, -10, -50, 10, h, { { -24, -16 } }, C.wall, M.Brick)
	MapKit.wallZ(parent, 60, -50, 10, h, { { -30, -22 } }, C.wall, M.Brick)
	block(parent, Vector3.new(72, 1, 62), Vector3.new(25, h + 0.5, -20), C.roof, M.CorrodedMetal)
	for i = 0, 4 do -- skylights let daylight in
		block(parent, Vector3.new(8, 0.3, 10), Vector3.new(4 + i * 15, h + 1.05, -20), Color3.fromRGB(180, 190, 196), M.Glass, { Transparency = 0.5 })
	end
	block(parent, Vector3.new(70, 0.2, 60), Vector3.new(25, 0.1, -20), Color3.fromRGB(80, 80, 78), M.Concrete)
	for _, x in { 5, 14, 34, 46 } do
		block(parent, Vector3.new(6, 4, 16), Vector3.new(x, 2, -20), C.machine, M.Metal)
		block(parent, Vector3.new(2, 2.5, 2), Vector3.new(x, 5.25, -24), C.metal, M.Metal)
	end
	block(parent, Vector3.new(50, 2.5, 2), Vector3.new(25, 1.25, -40), C.machine, M.DiamondPlate)
	for i = 0, 5 do
		block(parent, Vector3.new(70, 0.8, 0.8), CFrame.new(25, 12 + (i % 2) * 1.2, -48 + i * 10), C.metal, M.CorrodedMetal, { Shape = Enum.PartType.Cylinder })
	end
	MapKit.bulb(parent, Vector3.new(24, 13, -20))
	MapKit.bulb(parent, Vector3.new(3, 13, -2))

	-- container yard
	for i, c in {
		{ Vector3.new(78, 0, -85), Vector3.new(8, 8.6, 20) }, { Vector3.new(96, 0, -60), Vector3.new(20, 8.6, 8) },
		{ Vector3.new(78, 0, -35), Vector3.new(8, 8.6, 20) }, { Vector3.new(100, 0, -15), Vector3.new(8, 8.6, 20) },
		{ Vector3.new(80, 0, 10), Vector3.new(20, 8.6, 8) }, { Vector3.new(100, 0, 40), Vector3.new(8, 8.6, 20) },
		{ Vector3.new(78, 0, 60), Vector3.new(8, 8.6, 20) }, { Vector3.new(96, 0, 85), Vector3.new(20, 8.6, 8) },
	} do
		local box = block(parent, c[2], c[1] + Vector3.new(0, 4.3, 0), C.containers[(i - 1) % #C.containers + 1], M.CorrodedMetal)
		-- ribbed sides
		local long = c[2].Z > c[2].X
		for r = -4, 4 do
			local offset = long and Vector3.new(c[2].X / 2 + 0.1, 0, r * 2.1) or Vector3.new(r * 2.1, 0, c[2].Z / 2 + 0.1)
			for _, sgn in { 1, -1 } do
				block(parent, long and Vector3.new(0.2, 8.2, 0.4) or Vector3.new(0.4, 8.2, 0.2), box.Position + Vector3.new(offset.X * (long and sgn or 1), 0, offset.Z * (long and 1 or sgn)), box.Color, M.CorrodedMetal)
			end
		end
	end
	block(parent, Vector3.new(8, 8.6, 20), Vector3.new(78, 12.9, -35), C.containers[4], M.CorrodedMetal)

	-- net shed
	MapKit.wallX(parent, -84, -60, -30, 10, {}, C.wall, M.WoodPlanks)
	MapKit.wallZ(parent, -60, -112, -84, 10, {}, C.wall, M.WoodPlanks)
	MapKit.wallZ(parent, -30, -112, -84, 10, { { -100, -94 } }, C.wall, M.WoodPlanks)
	block(parent, Vector3.new(32, 1, 30), Vector3.new(-45, 10.5, -98), C.roof, M.CorrodedMetal)

	-- tall grass and reeds to hide in
	MapKit.tallGrass(parent, Vector3.new(-66, 0, -60), Vector3.new(10, 0, 30), rng)
	MapKit.tallGrass(parent, Vector3.new(-66, 0, 30), Vector3.new(10, 0, 30), rng)
	MapKit.tallGrass(parent, Vector3.new(-40, 0, 72), Vector3.new(34, 0, 18), rng)
	MapKit.tallGrass(parent, Vector3.new(62, 0, 40), Vector3.new(10, 0, 20), rng)
	MapKit.tallGrass(parent, Vector3.new(-48, 0, -60), Vector3.new(26, 0, 18), rng)
	MapKit.shortGrass(parent, Vector3.new(-40, 0, 74), Vector3.new(60, 0, 80), 90, rng)

	-- cover: crates, low walls, wrecks, barrels, rubble
	for _, pos in {
		Vector3.new(-30, 0, 40), Vector3.new(-20, 0, 55), Vector3.new(10, 0, 42), Vector3.new(25, 0, 60),
		Vector3.new(40, 0, 32), Vector3.new(-45, 0, 8), Vector3.new(-35, 0, -32), Vector3.new(-50, 0, -70),
		Vector3.new(-20, 0, -80), Vector3.new(10, 0, -72), Vector3.new(30, 0, -90), Vector3.new(50, 0, -68),
	} do
		block(parent, Vector3.new(4, 4, 4), pos + Vector3.new(0, 2, 0), C.crate, M.WoodPlanks)
		if rng:NextNumber() < 0.4 then
			block(parent, Vector3.new(3, 3, 3), pos + Vector3.new(0.4, 5.5, -0.3), C.crate, M.WoodPlanks)
		end
	end
	block(parent, Vector3.new(24, 3.5, 1.5), Vector3.new(-20, 1.75, 25), C.wall, M.Concrete)
	block(parent, Vector3.new(1.5, 3.5, 18), Vector3.new(20, 1.75, 30), C.wall, M.Concrete)
	block(parent, Vector3.new(18, 3.5, 1.5), Vector3.new(-40, 1.75, -45), C.wall, M.Concrete)
	MapKit.prop(parent, "CarVan_1", CFrame.new(20, 0, 95) * CFrame.Angles(0, 1.4, 0))
	MapKit.prop(parent, "CarSedan_1", CFrame.new(-10, 0, 22) * CFrame.Angles(0, 0.3, 0))
	MapKit.prop(parent, "CarSedan_2", CFrame.new(88, 0, -100) * CFrame.Angles(0, 2.2, 0))
	for _ = 1, 14 do
		local x, z = rng:NextNumber(-60, 105), rng:NextNumber(-105, 105)
		if not (x > -12 and x < 62 and z > -52 and z < 12) then
			MapKit.prop(parent, "Barrel_1", CFrame.new(x, 0, z) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0), 0.9)
		end
	end
	MapKit.prop(parent, "Rubble_1", CFrame.new(-25, 0, -60), 1.4)
	MapKit.prop(parent, "Rubble_1", CFrame.new(55, 0, 100) * CFrame.Angles(0, 2, 0), 1.1)
	MapKit.prop(parent, "Rock_1", CFrame.new(-72, -1.6, -20), 1.2)
	MapKit.prop(parent, "Rock_2", CFrame.new(-100, -1.6, 40) * CFrame.Angles(0, 1, 0), 1)
	MapKit.prop(parent, "DeadTree_1", CFrame.new(-55, 0, 95), 0.8)
	MapKit.prop(parent, "Bush_1", CFrame.new(-30, 0, 100), 1.1)

	-- lamp posts (light pools make you easier to see)
	MapKit.lamp(parent, Vector3.new(0, 0, 70))
	MapKit.lamp(parent, Vector3.new(65, 0, -50))
	MapKit.lamp(parent, Vector3.new(-50, 0, -20))
	MapKit.lamp(parent, Vector3.new(40, 0, 18))
	for _, f in { { Vector3.new(-60, 1, 40), Vector3.new(60, 0, 60) }, { Vector3.new(-90, 1, -10), Vector3.new(40, 0, 160) }, { Vector3.new(85, 1, 0), Vector3.new(40, 0, 200) } } do
		MapKit.fog(parent, f[1], f[2])
	end

	return {
		StartSpawns = { Vector3.new(-6, 3, 100), Vector3.new(-2, 3, 102), Vector3.new(2, 3, 102), Vector3.new(6, 3, 100) },
		ExtractionPos = Vector3.new(-92, 0, -102),
		LanternPos = Vector3.new(5, 0, 55),
		SupplyCandidates = {
			Vector3.new(24, 0, -45), Vector3.new(5, 0, -5), Vector3.new(52, 0, -10), Vector3.new(88, 0, -38), Vector3.new(90, 0, 62),
			Vector3.new(-80, 0, 20), Vector3.new(-45, 0, -100), Vector3.new(-40, 0, 75), Vector3.new(30, 0, 75), Vector3.new(-30, 0, -50),
		},
		LootSpots = {
			Vector3.new(-25, 0, 45), Vector3.new(-15, 0, 60), Vector3.new(15, 0, 50), Vector3.new(35, 0, 65), Vector3.new(45, 0, 25), Vector3.new(-40, 0, 15),
			Vector3.new(-30, 0, -25), Vector3.new(-45, 0, -75), Vector3.new(-15, 0, -85), Vector3.new(15, 0, -80), Vector3.new(35, 0, -95), Vector3.new(55, 0, -75),
			Vector3.new(70, 0, 30), Vector3.new(88, 0, 0), Vector3.new(108, 0, -40), Vector3.new(88, 0, 78), Vector3.new(0, 0, -30), Vector3.new(30, 0, -5),
			Vector3.new(45, 0, -45), Vector3.new(10, 0, -45), Vector3.new(-55, 0, -30), Vector3.new(-60, 0, 50), Vector3.new(-60, 0, 80), Vector3.new(60, 0, 90),
		},
		ContainerSpots = {
			{ pos = Vector3.new(-6, 0, -46), type = "Locker", yaw = 0 }, { pos = Vector3.new(-4, 0, -46), type = "Locker", yaw = 0 },
			{ pos = Vector3.new(56, 0, -46), type = "Toolbox", yaw = 0 }, { pos = Vector3.new(56, 0, 5), type = "Drawer", yaw = 180 },
			{ pos = Vector3.new(-6, 0, 5), type = "Drawer", yaw = 180 }, { pos = Vector3.new(30, 0, -12), type = "AmmoCrate", yaw = 90 },
			{ pos = Vector3.new(90, 0, -50), type = "AmmoCrate", yaw = 0 }, { pos = Vector3.new(108, 0, 20), type = "Toolbox", yaw = -90 },
			{ pos = Vector3.new(86, 0, 70), type = "Locker", yaw = 90 }, { pos = Vector3.new(-56, 0, -88), type = "Drawer", yaw = 0 },
			{ pos = Vector3.new(-34, 0, -108), type = "Toolbox", yaw = 180 }, { pos = Vector3.new(-56, 0, -108), type = "AmmoCrate", yaw = 90 },
			{ pos = Vector3.new(-10, 0, 85), type = "Drawer", yaw = 180 }, { pos = Vector3.new(45, 0, 95), type = "Toolbox", yaw = 180 },
			{ pos = Vector3.new(-40, 0, -40), type = "Locker", yaw = 180 }, { pos = Vector3.new(70, 0, -100), type = "Drawer", yaw = 0 },
		},
		EdgeSpawns = {
			Vector3.new(-60, 0, 108), Vector3.new(100, 0, 100), Vector3.new(105, 0, -100), Vector3.new(0, 0, -105),
			Vector3.new(105, 0, 0), Vector3.new(-50, 0, 108), Vector3.new(60, 0, -105), Vector3.new(-62, 0, -40),
		},
		PatrolRoutes = {
			{ Vector3.new(24, 0, -30), Vector3.new(24, 0, -2), Vector3.new(52, 0, -30), Vector3.new(5, 0, -35) },
			{ Vector3.new(88, 0, -80), Vector3.new(88, 0, -38), Vector3.new(88, 0, 20), Vector3.new(88, 0, 62) },
			{ Vector3.new(-30, 0, 50), Vector3.new(30, 0, 55), Vector3.new(40, 0, 25), Vector3.new(-20, 0, 35) },
			{ Vector3.new(-90, 0, -60), Vector3.new(-90, 0, 40), Vector3.new(-80, 0, 60), Vector3.new(-80, 0, -20) },
			{ Vector3.new(-40, 0, -60), Vector3.new(0, 0, -85), Vector3.new(50, 0, -85), Vector3.new(-20, 0, -70) },
			{ Vector3.new(-45, 0, -10), Vector3.new(-45, 0, 30), Vector3.new(-25, 0, 0) },
		},
		Doorways = {
			{ hinge = Vector3.new(20, 0, -50), width = 8, dir = Vector3.new(1, 0, 0) },
			{ hinge = Vector3.new(5, 0, 10), width = 8, dir = Vector3.new(1, 0, 0) },
			{ hinge = Vector3.new(40, 0, 10), width = 8, dir = Vector3.new(1, 0, 0) },
			{ hinge = Vector3.new(-10, 0, -24), width = 8, dir = Vector3.new(0, 0, 1) },
			{ hinge = Vector3.new(60, 0, -30), width = 8, dir = Vector3.new(0, 0, 1) },
			{ hinge = Vector3.new(-30, 0, -100), width = 6, dir = Vector3.new(0, 0, 1) },
		},
	}
end

return Map
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000021"><Properties><string name="Name">HollowPines</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- HOLLOW PINES: forest hills above the coast. Pines, rocks, ferns, a creek, meadows of tall
-- grass, three cabins and an old ranger lookout. Misty morning.
local MapKit = require(script.Parent.MapKit)
local C = MapKit.C
local block = MapKit.block

local Map = {
	id = "HollowPines",
	name = "Hollow Pines",
	hilly = true,
	lighting = { clock = 7.9, brightness = 2.5, ambient = { 90, 98, 102 }, outdoor = { 132, 144, 150 }, fog = 0.4, haze = 1.9, fogColor = { 205, 214, 220 }, tint = { 234, 242, 246 }, saturation = -0.12, contrast = 0.1, shift = { 255, 222, 196 } },
}

local function creekX(z)
	return -15 + 26 * math.sin(z / 46)
end

local function baseHeight(x, z)
	local h = math.noise(x / 70, z / 70, 3.1) * 9 + math.noise(x / 28, z / 28, 7.7) * 3.5
	h += math.max(0, (math.abs(x) - 70) / 50) * 8 + math.max(0, (math.abs(z) - 80) / 40) * 6 -- rising edges
	local dc = x - creekX(z)
	h -= 3.2 * math.exp(-(dc / 7) ^ 2)
	return h + 6
end

function Map.build(parent, rng)
	local M = Enum.Material
	MapKit.heightfield(-120, -120, 120, 120, 6, baseHeight, function(x, z, h)
		local slope = math.abs(baseHeight(x + 6, z) - h) + math.abs(baseHeight(x, z + 6) - h)
		if slope > 5 then
			return M.Rock
		elseif math.abs(x - creekX(z)) < 6 then
			return M.Mud
		end
		return (math.noise(x / 30, z / 30, 1) > 0.25) and M.LeafyGrass or M.Grass
	end)
	-- creek water
	for z = -120, 114, 6 do
		local cx = creekX(z + 3)
		local surface = baseHeight(cx, z + 3) + 0.9
		MapKit.water(cx - 6, z, cx + 6, z + 6, surface, 2.2)
	end
	local function g(x, z)
		return MapKit.ground(x, z)
	end

	-- flatten pads and build cabins
	local doorways, containers, loot = {}, {}, {}
	for i, spot in { Vector3.new(55, 0, 40), Vector3.new(-70, 0, -30), Vector3.new(40, 0, -70) } do
		local y = baseHeight(spot.X, spot.Z + 9)
		MapKit.clearAbove(spot.X - 14, spot.Z - 6, spot.X + 14, spot.Z + 24, y)
		MapKit.slab(spot.X - 14, spot.Z - 6, spot.X + 14, spot.Z + 24, M.Ground, y, 14)
		local h = MapKit.house(parent, Vector3.new(spot.X, y, spot.Z), i == 2 and 0 or math.pi * 0.5 * (i - 1), rng, { w = 18, d = 16, h = 9, color = Color3.fromRGB(110, 84, 62) })
		for _, d in h.doorways do
			table.insert(doorways, d)
		end
		for _, c in h.containers do
			table.insert(containers, c)
		end
		for _, l in h.loot do
			table.insert(loot, l)
		end
	end

	-- the ranger lookout
	local ly = g(0, 10)
	for _, o in { Vector3.new(-4, 0, -4), Vector3.new(4, 0, -4), Vector3.new(-4, 0, 4), Vector3.new(4, 0, 4) } do
		block(parent, Vector3.new(0.8, 24, 0.8), Vector3.new(o.X, ly + 12, o.Z + 10), Color3.fromRGB(92, 74, 56), M.Wood)
	end
	block(parent, Vector3.new(12, 0.8, 12), Vector3.new(0, ly + 24, 10), Color3.fromRGB(100, 82, 62), M.WoodPlanks)
	block(parent, Vector3.new(12, 7, 12), Vector3.new(0, ly + 28, 10), Color3.fromRGB(110, 90, 70), M.WoodPlanks, { Transparency = 0 })
	MapKit.wedge(parent, Vector3.new(13, 3, 6.5), CFrame.new(0, ly + 33, 6.75), C.roof, M.RoofShingles)
	MapKit.wedge(parent, Vector3.new(13, 3, 6.5), CFrame.new(0, ly + 33, 13.25) * CFrame.Angles(0, math.pi, 0), C.roof, M.RoofShingles)

	-- forest
	local function clear(x, z)
		if math.abs(x - creekX(z)) < 9 then
			return false
		end
		for _, spot in { Vector3.new(55, 0, 48), Vector3.new(-70, 0, -22), Vector3.new(40, 0, -62), Vector3.new(0, 0, 10) } do
			if (Vector3.new(x, 0, z) - spot).Magnitude < 20 then
				return false
			end
		end
		return true
	end
	local placed = 0
	while placed < 70 do
		local x, z = rng:NextNumber(-115, 115), rng:NextNumber(-115, 115)
		if clear(x, z) and not (z > 70 and x < -20) then -- keep the south-west meadow open
			MapKit.prop(parent, rng:NextNumber() < 0.85 and ("Pine_" .. rng:NextInteger(1, 2)) or "DeadTree_1", CFrame.new(x, g(x, z) - 0.5, z) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0), rng:NextNumber(0.75, 1.15))
			placed += 1
		end
	end
	for _ = 1, 22 do
		local x, z = rng:NextNumber(-115, 115), rng:NextNumber(-115, 115)
		if clear(x, z) then
			MapKit.prop(parent, rng:NextNumber() < 0.2 and "Boulder_1" or ("Rock_" .. rng:NextInteger(1, 2)), CFrame.new(x, g(x, z) - 0.6, z) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0), rng:NextNumber(0.7, 1.2))
		end
	end
	for _ = 1, 30 do
		local x, z = rng:NextNumber(-115, 115), rng:NextNumber(-115, 115)
		if clear(x, z) then
			MapKit.prop(parent, "Bush_" .. rng:NextInteger(1, 2), CFrame.new(x, g(x, z), z) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0), rng:NextNumber(0.8, 1.4))
		end
	end
	-- fallen logs
	for _ = 1, 6 do
		local x, z = rng:NextNumber(-100, 100), rng:NextNumber(-100, 100)
		if clear(x, z) then
			MapKit.prop(parent, "DeadTree_1", CFrame.new(x, g(x, z) + 0.6, z) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0) * CFrame.Angles(0, 0, math.rad(88)), 0.55)
		end
	end
	MapKit.tallGrass(parent, Vector3.new(-60, 0, 90), Vector3.new(60, 0, 40), rng, g)
	MapKit.tallGrass(parent, Vector3.new(80, 0, -20), Vector3.new(26, 0, 40), rng, g)
	MapKit.tallGrass(parent, Vector3.new(-30, 0, 20), Vector3.new(24, 0, 30), rng, g)
	MapKit.tallGrass(parent, Vector3.new(10, 0, -100), Vector3.new(50, 0, 20), rng, g)
	MapKit.shortGrass(parent, Vector3.new(0, 0, 0), Vector3.new(230, 0, 230), 260, rng, g, true)
	for _, f in { { Vector3.new(-15, 6, 0), Vector3.new(40, 0, 220) }, { Vector3.new(60, 8, 60), Vector3.new(80, 0, 80) }, { Vector3.new(-60, 8, -60), Vector3.new(80, 0, 80) } } do
		MapKit.fog(parent, f[1], f[2])
	end

	return {
		StartSpawns = { Vector3.new(-62, 0, 100), Vector3.new(-58, 0, 102), Vector3.new(-54, 0, 100), Vector3.new(-66, 0, 102) },
		ExtractionPos = Vector3.new(70, 0, -104),
		LanternPos = Vector3.new(0, 0, 32),
		SupplyCandidates = { loot[1], loot[2], loot[4], loot[5], loot[7], loot[8], Vector3.new(-20, 0, -40), Vector3.new(90, 0, 10), Vector3.new(-95, 0, 40), Vector3.new(20, 0, 80) },
		LootSpots = {
			loot[3], loot[6], loot[9], Vector3.new(-40, 0, 60), Vector3.new(-10, 0, 40), Vector3.new(30, 0, 20), Vector3.new(70, 0, 0),
			Vector3.new(-80, 0, 0), Vector3.new(-50, 0, -70), Vector3.new(0, 0, -60), Vector3.new(60, 0, -90), Vector3.new(90, 0, 60),
			Vector3.new(-90, 0, 70), Vector3.new(20, 0, 100), Vector3.new(-30, 0, -100), Vector3.new(100, 0, -40),
		},
		ContainerSpots = containers,
		EdgeSpawns = {
			Vector3.new(-105, 0, -105), Vector3.new(105, 0, -105), Vector3.new(105, 0, 105), Vector3.new(-20, 0, -110),
			Vector3.new(110, 0, 0), Vector3.new(-110, 0, 0), Vector3.new(40, 0, 110), Vector3.new(-110, 0, -60),
		},
		PatrolRoutes = {
			{ Vector3.new(-60, 0, 60), Vector3.new(-20, 0, 30), Vector3.new(20, 0, 60) },
			{ Vector3.new(40, 0, 20), Vector3.new(80, 0, 20), Vector3.new(60, 0, -30) },
			{ Vector3.new(-80, 0, -60), Vector3.new(-40, 0, -20), Vector3.new(-90, 0, 10) },
			{ Vector3.new(0, 0, -40), Vector3.new(40, 0, -90), Vector3.new(-30, 0, -80) },
			{ Vector3.new(creekX(-60), 0, -60), Vector3.new(creekX(0), 0, 0), Vector3.new(creekX(60), 0, 60) },
			{ Vector3.new(80, 0, -80), Vector3.new(100, 0, 40) },
		},
		Doorways = doorways,
	}
end

return Map
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000022"><Properties><string name="Name">LarkspurStreet</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- LARKSPUR STREET: an overgrown suburban street. Weatherboard houses you can enter, yards
-- gone to tall grass, wrecked cars, power poles, a corner store. Warm golden afternoon.
local MapKit = require(script.Parent.MapKit)
local C = MapKit.C
local block, volume = MapKit.block, MapKit.volume

local Map = {
	id = "LarkspurStreet",
	name = "Larkspur Street",
	lighting = { clock = 16.3, brightness = 3.1, ambient = { 100, 94, 88 }, outdoor = { 160, 150, 136 }, fog = 0.22, haze = 0.9, fogColor = { 218, 208, 190 }, tint = { 255, 244, 230 }, saturation = -0.04, contrast = 0.1, shift = { 255, 226, 190 } },
}

function Map.build(parent, rng)
	local M = Enum.Material
	MapKit.slab(-120, -120, 120, 120, M.Grass, 0)
	MapKit.slab(-120, -9, 120, 9, M.Asphalt, 0.05)
	MapKit.slab(-120, 9, 120, 13, M.Pavement, 0.15)
	MapKit.slab(-120, -13, 120, -9, M.Pavement, 0.15)
	-- painted road line (faded)
	for x = -115, 115, 12 do
		block(parent, Vector3.new(5, 0.05, 0.4), Vector3.new(x, 0.1, 0), Color3.fromRGB(200, 190, 150), M.SmoothPlastic, { CanCollide = false, Transparency = 0.35 })
	end

	local doorways, containers, loot = {}, {}, {}
	local function addHouse(origin, yaw, style)
		local h = MapKit.house(parent, origin, yaw, rng, style)
		for _, d in h.doorways do
			table.insert(doorways, d)
		end
		for _, c in h.containers do
			table.insert(containers, c)
		end
		for _, l in h.loot do
			table.insert(loot, l)
		end
		-- driveway
		local side = origin.Z > 0 and 1 or -1
		MapKit.slab(origin.X + 8, side > 0 and 13 or origin.Z, origin.X + 14, side > 0 and origin.Z or -13, M.Concrete, 0.12)
	end
	for _, x in { -82, -32, 18, 68 } do
		addHouse(Vector3.new(x, 0, 24), 0)
		addHouse(Vector3.new(x + 6, 0, -24), math.pi)
	end
	-- corner store at the west end
	addHouse(Vector3.new(-100, 0, 64), 0, { w = 30, d = 26, h = 12, color = Color3.fromRGB(150, 120, 100) })

	-- back fences and yards gone wild
	for _, z in { 58, -58 } do
		for x = -115, 115, 8 do
			if rng:NextNumber() > 0.15 then
				block(parent, Vector3.new(7.6, 5, 0.3), CFrame.new(x, 2.5, z) * CFrame.Angles(0, 0, rng:NextNumber(-0.06, 0.06)), Color3.fromRGB(120, 100, 80), M.WoodPlanks)
			end
		end
	end
	for _, z in { 80, -80 } do
		MapKit.tallGrass(parent, Vector3.new(-60, 0, z), Vector3.new(60, 0, 30), rng, nil, 0.8)
		MapKit.tallGrass(parent, Vector3.new(55, 0, z), Vector3.new(70, 0, 30), rng, nil, 0.8)
	end
	for _, x in { -57, -7, 43, 93 } do
		MapKit.tallGrass(parent, Vector3.new(x, 0, 36), Vector3.new(10, 0, 18), rng)
		MapKit.tallGrass(parent, Vector3.new(x + 4, 0, -36), Vector3.new(10, 0, 18), rng)
	end
	MapKit.shortGrass(parent, Vector3.new(0, 0, 30), Vector3.new(230, 0, 30), 120, rng)
	MapKit.shortGrass(parent, Vector3.new(0, 0, -30), Vector3.new(230, 0, 30), 120, rng)

	-- trees and bushes
	for _ = 1, 22 do
		local x, z = rng:NextNumber(-115, 115), (rng:NextNumber() < 0.5 and 1 or -1) * rng:NextNumber(62, 112)
		MapKit.prop(parent, rng:NextNumber() < 0.6 and "Pine_1" or "DeadTree_1", CFrame.new(x, 0, z) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0), rng:NextNumber(0.55, 0.85))
	end
	for _ = 1, 26 do
		local x, z = rng:NextNumber(-115, 115), (rng:NextNumber() < 0.5 and 1 or -1) * rng:NextNumber(14, 56)
		MapKit.prop(parent, "Bush_" .. rng:NextInteger(1, 2), CFrame.new(x, 0, z) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0), rng:NextNumber(0.8, 1.3))
	end

	-- the street: wrecks, barricade, power poles with sagging wires
	for i, spec in { { -70, 3, 0.2 }, { -40, -4, 2.9 }, { -5, 2, 1.4 }, { 30, -3, 0.1 }, { 58, 5, 2.3 }, { 92, -2, 1.0 } } do
		MapKit.prop(parent, ({ "CarSedan_1", "CarSedan_2", "CarVan_1" })[(i - 1) % 3 + 1], CFrame.new(spec[1], 0, spec[2]) * CFrame.Angles(0, spec[3], 0))
	end
	MapKit.prop(parent, "Rubble_1", CFrame.new(-100, 0, -2) * CFrame.Angles(0, 0.5, 0), 1.2)
	for x = -110, 110, 36 do
		block(parent, Vector3.new(0.8, 18, 0.8), Vector3.new(x, 9, 15), Color3.fromRGB(86, 70, 54), M.Wood)
		block(parent, Vector3.new(6, 0.4, 0.4), Vector3.new(x, 16.5, 15), Color3.fromRGB(86, 70, 54), M.Wood)
		if x + 36 <= 110 then
			for _, dz in { -2.5, 2.5 } do
				block(parent, Vector3.new(36, 0.08, 0.08), CFrame.new(x + 18, 15.4, 15 + dz * 0.2) * CFrame.Angles(0, 0, 0), Color3.fromRGB(20, 20, 20), M.SmoothPlastic, { CanCollide = false, CanQuery = false })
			end
		end
	end
	for _ = 1, 10 do
		MapKit.prop(parent, "Barrel_1", CFrame.new(rng:NextNumber(-110, 110), 0, rng:NextNumber(-12, 12)), 0.85)
	end
	MapKit.lamp(parent, Vector3.new(-60, 0, 12), false)
	MapKit.lamp(parent, Vector3.new(40, 0, -12), false)

	return {
		StartSpawns = { Vector3.new(108, 3, -3), Vector3.new(108, 3, 3), Vector3.new(104, 3, -6), Vector3.new(104, 3, 6) },
		ExtractionPos = Vector3.new(-108, 0, 0),
		LanternPos = Vector3.new(0, 0, 0),
		SupplyCandidates = { loot[1], loot[4], loot[7], loot[10], loot[13], loot[16], loot[19], loot[22], Vector3.new(-40, 0, 85), Vector3.new(60, 0, -85) },
		LootSpots = loot,
		ContainerSpots = containers,
		EdgeSpawns = {
			Vector3.new(-110, 0, 100), Vector3.new(110, 0, 100), Vector3.new(110, 0, -100), Vector3.new(-110, 0, -100),
			Vector3.new(0, 0, 110), Vector3.new(0, 0, -110), Vector3.new(-60, 0, 108), Vector3.new(60, 0, -108),
		},
		PatrolRoutes = {
			{ Vector3.new(-90, 0, 0), Vector3.new(90, 0, 0) },
			{ Vector3.new(-90, 0, 75), Vector3.new(0, 0, 70), Vector3.new(90, 0, 80) },
			{ Vector3.new(-90, 0, -75), Vector3.new(0, 0, -70), Vector3.new(90, 0, -80) },
			{ Vector3.new(-30, 0, 34), Vector3.new(20, 0, 34), Vector3.new(70, 0, 34) },
			{ Vector3.new(-26, 0, -34), Vector3.new(24, 0, -34), Vector3.new(74, 0, -34) },
			{ Vector3.new(-100, 0, 76), Vector3.new(-100, 0, 30) },
		},
		Doorways = doorways,
	}
end

return Map
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000023"><Properties><string name="Name">MapKit</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Shared building blocks for the encounter maps: parts, volumes, walls, lights, terrain,
-- grass, props (sculpted meshes when loaded, part fallbacks otherwise) and houses.
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local MeshKit = require(Shared.MeshKit)

local MapKit = {}
local Assets -- AssetService, set by MapService

local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

MapKit.C = {
	ground = Color3.fromRGB(70, 72, 70),
	wall = Color3.fromRGB(96, 94, 88),
	wallDark = Color3.fromRGB(70, 70, 68),
	roof = Color3.fromRGB(74, 70, 64),
	metal = Color3.fromRGB(46, 48, 50),
	crate = Color3.fromRGB(92, 72, 52),
	machine = Color3.fromRGB(70, 78, 80),
	bone = Color3.fromRGB(226, 220, 206),
	water = Color3.fromRGB(52, 70, 74),
	reed = Color3.fromRGB(110, 112, 76),
	warm = Color3.fromRGB(255, 196, 130),
	containers = { Color3.fromRGB(120, 58, 44), Color3.fromRGB(44, 86, 88), Color3.fromRGB(58, 68, 90), Color3.fromRGB(140, 112, 56) },
}
local C = MapKit.C

function MapKit.setAssets(assetService)
	Assets = assetService
end

function MapKit.block(parent, size, position, color, material, props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = typeof(position) == "CFrame" and position or CFrame.new(position)
	p.Color = color
	p.Material = material or Enum.Material.Concrete
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props then
		for key, value in props do
			p[key] = value
		end
	end
	p.Parent = parent
	return p
end
local block = MapKit.block

function MapKit.wedge(parent, size, cframe, color, material)
	local w = Instance.new("WedgePart")
	w.Anchored = true
	w.Size = size
	w.CFrame = cframe
	w.Color = color
	w.Material = material
	w.Parent = parent
	return w
end

function MapKit.volume(parent, size, position, tag)
	local p = block(parent, size, position, Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, {
		Name = tag,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
	})
	CollectionService:AddTag(p, tag)
	return p
end

local function splitGaps(a, b, gaps)
	local segments, cursor = {}, a
	table.sort(gaps, function(x, y)
		return x[1] < y[1]
	end)
	for _, gap in gaps do
		if gap[1] > cursor then
			table.insert(segments, { cursor, gap[1] })
		end
		cursor = math.max(cursor, gap[2])
	end
	if b > cursor then
		table.insert(segments, { cursor, b })
	end
	return segments
end

-- Wall along X at depth z (y0 = base height), door gaps {{x1,x2}} with lintels.
function MapKit.wallX(parent, z, x1, x2, height, gaps, color, material, y0)
	y0 = y0 or 0
	for _, s in splitGaps(x1, x2, gaps or {}) do
		block(parent, Vector3.new(s[2] - s[1], height, 1.2), Vector3.new((s[1] + s[2]) / 2, y0 + height / 2, z), color, material)
	end
	for _, g in gaps or {} do
		if height > 9 then
			block(parent, Vector3.new(g[2] - g[1], height - 9, 1.2), Vector3.new((g[1] + g[2]) / 2, y0 + 9 + (height - 9) / 2, z), color, material)
		end
	end
end

function MapKit.wallZ(parent, x, z1, z2, height, gaps, color, material, y0)
	y0 = y0 or 0
	for _, s in splitGaps(z1, z2, gaps or {}) do
		block(parent, Vector3.new(1.2, height, s[2] - s[1]), Vector3.new(x, y0 + height / 2, (s[1] + s[2]) / 2), color, material)
	end
	for _, g in gaps or {} do
		if height > 9 then
			block(parent, Vector3.new(1.2, height - 9, g[2] - g[1]), Vector3.new(x, y0 + 9 + (height - 9) / 2, (g[1] + g[2]) / 2), color, material)
		end
	end
end

function MapKit.lamp(parent, base, lit)
	block(parent, Vector3.new(0.6, 12, 0.6), base + Vector3.new(0, 6, 0), C.metal, Enum.Material.Metal)
	block(parent, Vector3.new(0.3, 0.3, 2.4), base + Vector3.new(0, 11.9, -1.1), C.metal, Enum.Material.Metal)
	local head = block(parent, Vector3.new(1.4, 0.5, 1.0), base + Vector3.new(0, 11.7, -2.2), lit == false and C.metal or C.warm, lit == false and Enum.Material.Metal or Enum.Material.Neon)
	if lit ~= false then
		local light = Instance.new("SpotLight")
		light.Face = Enum.NormalId.Bottom
		light.Range = 28
		light.Angle = 100
		light.Brightness = 2
		light.Color = C.warm
		light.Shadows = true
		light.Parent = head
		MapKit.volume(parent, Vector3.new(20, 10, 20), base + Vector3.new(0, 5, -2), "LitZone")
	end
end

function MapKit.bulb(parent, position, range)
	local bulb = block(parent, Vector3.new(0.7, 0.7, 0.7), position, C.warm, Enum.Material.Neon, { Shape = Enum.PartType.Ball, CanCollide = false })
	local light = Instance.new("PointLight")
	light.Range = range or 18
	light.Brightness = 1.3
	light.Color = C.warm
	light.Shadows = true
	light.Parent = bulb
	MapKit.volume(parent, Vector3.new(14, 10, 14), Vector3.new(position.X, position.Y - 6, position.Z), "LitZone")
end

function MapKit.fog(parent, position, size)
	local p = block(parent, Vector3.new(size.X, 1, size.Z), position, Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, {
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
	})
	local e = Instance.new("ParticleEmitter")
	e.Texture = SMOKE
	e.Rate = 1.2
	e.Lifetime = NumberRange.new(14, 20)
	e.Speed = NumberRange.new(0.3, 1)
	e.SpreadAngle = Vector2.new(60, 60)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-4, 4)
	e.LightInfluence = 1
	e.Color = ColorSequence.new(Color3.fromRGB(215, 220, 220))
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 16), NumberSequenceKeypoint.new(1, 28) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.9), NumberSequenceKeypoint.new(0.7, 0.92), NumberSequenceKeypoint.new(1, 1) })
	e.Parent = p
end

-- Terrain --------------------------------------------------------------------------------------

local terrain = Workspace.Terrain

function MapKit.clearTerrain()
	terrain:Clear()
	pcall(function()
		terrain.Decoration = true -- animated grass blades on Grass terrain
	end)
	terrain.WaterColor = Color3.fromRGB(38, 56, 60)
	terrain.WaterTransparency = 0.55
	terrain.WaterReflectance = 0.6
	terrain.WaterWaveSize = 0.08
	terrain.WaterWaveSpeed = 6
end

-- A flat slab of terrain material whose top surface is at y = top.
function MapKit.slab(x0, z0, x1, z1, material, top, depth)
	depth = depth or 8
	local cx, cz = (x0 + x1) / 2, (z0 + z1) / 2
	terrain:FillBlock(CFrame.new(cx, top - depth / 2, cz), Vector3.new(math.abs(x1 - x0), depth, math.abs(z1 - z0)), material)
end

-- Removes terrain above height y in a rectangle (carving dips, clearing for water).
function MapKit.clearAbove(x0, z0, x1, z1, y)
	local top = 60
	terrain:FillBlock(CFrame.new((x0 + x1) / 2, (y + top) / 2, (z0 + z1) / 2), Vector3.new(math.abs(x1 - x0), top - y, math.abs(z1 - z0)), Enum.Material.Air)
end

function MapKit.water(x0, z0, x1, z1, surface, depth)
	local cx, cz = (x0 + x1) / 2, (z0 + z1) / 2
	terrain:FillBlock(CFrame.new(cx, surface - depth / 2, cz), Vector3.new(math.abs(x1 - x0), depth, math.abs(z1 - z0)), Enum.Material.Water)
end

-- Rolling ground: columns of terrain following heightFn(x, z), material by materialFn.
function MapKit.heightfield(x0, z0, x1, z1, step, heightFn, materialFn)
	for x = x0, x1 - step, step do
		for z = z0, z1 - step, step do
			local h = heightFn(x + step / 2, z + step / 2)
			terrain:FillBlock(CFrame.new(x + step / 2, (h - 12) / 2, z + step / 2), Vector3.new(step, h + 12, step), materialFn(x, z, h))
		end
	end
end

-- Surface height at (x, z) (terrain or parts), for placing things on hills.
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Include
function MapKit.ground(x, z, include)
	groundParams.FilterDescendantsInstances = include or { terrain }
	-- walk down through every surface (roofs, ceilings, floors, props) to the terrain, then
	-- pick the lowest non-prop surface that sits close to the terrain (a floor), else terrain
	local origin = Vector3.new(x, 300, z)
	local surfaces = {}
	local terrainY = nil
	for _ = 1, 10 do
		local hit = Workspace:Raycast(origin, Vector3.new(0, -600, 0), groundParams)
		if not hit then
			break
		end
		if hit.Instance == terrain then
			terrainY = hit.Position.Y
			break
		end
		local inProp = hit.Instance.Parent and hit.Instance.Parent:IsA("Model")
		if not inProp and hit.Normal.Y > 0.7 then
			table.insert(surfaces, hit.Position.Y)
		end
		origin = hit.Position - Vector3.new(0, 0.05, 0)
	end
	local base = terrainY or 0
	local best = base
	for _, y in surfaces do
		if y - base < 2.5 and y > best then
			best = y
		end
	end
	return best
end

function MapKit.onGround(v, include)
	return Vector3.new(v.X, MapKit.ground(v.X, v.Z, include), v.Z)
end

-- Props ------------------------------------------------------------------------------------------

local FALLBACK = {}
function FALLBACK.rock(parent, cf, scale)
	block(parent, Vector3.new(4, 2.6, 3.4) * scale, cf * CFrame.new(0, 1.1 * scale, 0) * CFrame.Angles(0.2, 0.7, 0.1), Color3.fromRGB(104, 102, 98), Enum.Material.Rock)
end
function FALLBACK.tree(parent, cf, scale)
	block(parent, Vector3.new(1.2, 14, 1.2) * scale, cf * CFrame.new(0, 7 * scale, 0), Color3.fromRGB(70, 54, 42), Enum.Material.Wood)
	block(parent, Vector3.new(9, 12, 9) * scale, cf * CFrame.new(0, 15 * scale, 0), Color3.fromRGB(40, 56, 36), Enum.Material.LeafyGrass, { Shape = Enum.PartType.Ball })
end
function FALLBACK.car(parent, cf, scale)
	block(parent, Vector3.new(4, 1.4, 9) * scale, cf * CFrame.new(0, 1.3 * scale, 0), Color3.fromRGB(90, 96, 98), Enum.Material.Metal)
	block(parent, Vector3.new(3.6, 1.2, 4.6) * scale, cf * CFrame.new(0, 2.6 * scale, 0.4), Color3.fromRGB(40, 44, 46), Enum.Material.Glass)
end
function FALLBACK.bush(parent, cf, scale)
	block(parent, Vector3.new(3, 2.4, 3) * scale, cf * CFrame.new(0, 1.2 * scale, 0), Color3.fromRGB(46, 62, 40), Enum.Material.LeafyGrass, { Shape = Enum.PartType.Ball })
end

local KIND = {
	Rock_1 = "rock", Rock_2 = "rock", Boulder_1 = "rock",
	Pine_1 = "tree", Pine_2 = "tree", DeadTree_1 = "tree",
	CarSedan_1 = "car", CarSedan_2 = "car", CarVan_1 = "car",
	Bush_1 = "bush", Bush_2 = "bush",
}

-- Place a sculpted prop (or a simple stand-in). cf = ground point + facing.
function MapKit.prop(parent, name, cf, scale)
	scale = scale or 1
	if Assets and Assets.hasKit(name) then
		local m = MeshKit.buildProp(Assets.meta(name), Assets.part, cf, scale, parent)
		if m then
			if KIND[name] == "car" or KIND[name] == "rock" then
				for _, p in m:GetChildren() do
					if p:IsA("BasePart") then
						p.CanCollide = true
					end
				end
			else
				for _, p in m:GetChildren() do
					if p:IsA("BasePart") then
						p.CanCollide = KIND[name] == "tree" and p.Name == "Trunk"
					end
				end
			end
			return m
		end
	end
	local fb = FALLBACK[KIND[name] or ""]
	if fb then
		fb(parent, cf, scale)
	end
	return nil
end

-- Grass ------------------------------------------------------------------------------------------

local function grassMesh(parent, name, cf, scale)
	if Assets and Assets.hasKit(name) then
		local m = MeshKit.buildProp(Assets.meta(name), Assets.part, cf, scale, parent)
		if m then
			for _, p in m:GetChildren() do
				if p:IsA("BasePart") then
					p.CanCollide = false
					p.CanQuery = false
					p.CanTouch = false
					p.CastShadow = false
				end
			end
			return true
		end
	end
	return false
end

-- A patch of tall grass you can hide in (stealth volume + clumps).
-- groundFn(x, z) gives the height (default flat 0).
function MapKit.tallGrass(parent, center, size, rng, groundFn, density)
	MapKit.volume(parent, Vector3.new(size.X, 7, size.Z), center + Vector3.new(0, 3.5, 0), "TallGrass")
	local count = math.floor(size.X * size.Z / 7 * (density or 1))
	for _ = 1, count do
		local x = center.X + rng:NextNumber(-size.X / 2, size.X / 2)
		local z = center.Z + rng:NextNumber(-size.Z / 2, size.Z / 2)
		local y = groundFn and groundFn(x, z) or center.Y
		local cf = CFrame.new(x, y, z) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0)
		if not grassMesh(parent, "GrassTall_" .. rng:NextInteger(1, 3), cf, rng:NextNumber(0.85, 1.2)) then
			local h = rng:NextNumber(3.6, 5.6)
			block(parent, Vector3.new(0.22, h, 0.22), CFrame.new(x, y + h / 2, z) * CFrame.Angles(rng:NextNumber(-0.18, 0.18), rng:NextNumber(0, 6.28), rng:NextNumber(-0.18, 0.18)), C.reed, Enum.Material.Grass, {
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
				CastShadow = false,
			})
		end
	end
end

-- Short grass and ferns sprinkled over an area (decorative only).
function MapKit.shortGrass(parent, center, size, count, rng, groundFn, ferns)
	if not (Assets and Assets.hasKit("GrassShort_1")) then
		return
	end
	for _ = 1, count do
		local x = center.X + rng:NextNumber(-size.X / 2, size.X / 2)
		local z = center.Z + rng:NextNumber(-size.Z / 2, size.Z / 2)
		local y = groundFn and groundFn(x, z) or center.Y
		local name = (ferns and rng:NextNumber() < 0.3) and "Fern_1" or ("GrassShort_" .. rng:NextInteger(1, 2))
		grassMesh(parent, name, CFrame.new(x, y, z) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0), rng:NextNumber(0.8, 1.3))
	end
end

-- Houses -------------------------------------------------------------------------------------------

-- A two-storey weatherboard house. origin = front-door ground point, facing = yaw (radians,
-- front faces -Z when 0). Returns { doorways = {...}, containers = {...}, loot = {...} }.
function MapKit.house(parent, origin, yaw, rng, style)
	style = style or {}
	local W, D, H = style.w or 26, style.d or 22, style.h or 11
	local cf = CFrame.new(origin) * CFrame.Angles(0, yaw, 0)
	local function at(x, y, z)
		return cf * CFrame.new(x, y, z)
	end
	local siding = style.color or ({ Color3.fromRGB(150, 156, 150), Color3.fromRGB(176, 160, 132), Color3.fromRGB(120, 132, 140), Color3.fromRGB(168, 150, 140) })[rng:NextInteger(1, 4)]
	local trim = Color3.fromRGB(200, 196, 186)
	local wallMat = Enum.Material.WoodPlanks
	local function wall(size, pos)
		return block(parent, size, at(pos.X, pos.Y, pos.Z), siding, wallMat)
	end
	-- floor + porch
	block(parent, Vector3.new(W, 1, D), at(0, 0.5, D / 2), Color3.fromRGB(96, 82, 66), Enum.Material.WoodPlanks)
	block(parent, Vector3.new(10, 0.8, 5), at(0, 0.4, -2.5), Color3.fromRGB(110, 96, 80), Enum.Material.WoodPlanks)
	for _, sx in { -4.5, 4.5 } do
		block(parent, Vector3.new(0.5, H - 1, 0.5), at(sx, H / 2, -4.6), trim, Enum.Material.Wood)
	end
	block(parent, Vector3.new(11, 0.5, 6), at(0, H - 0.6, -2.4), C.roof, Enum.Material.RoofShingles)
	-- walls: front (door gap + windows), back, sides
	local t = 1
	local doorW = 5
	wall(Vector3.new((W - doorW) / 2, H, t), Vector3.new(-(W + doorW) / 4, H / 2, 0))
	wall(Vector3.new((W - doorW) / 2, H, t), Vector3.new((W + doorW) / 4, H / 2, 0))
	wall(Vector3.new(doorW, H - 8, t), Vector3.new(0, 8 + (H - 8) / 2, 0))
	wall(Vector3.new(W, H, t), Vector3.new(0, H / 2, D))
	wall(Vector3.new(t, H, D), Vector3.new(-W / 2, H / 2, D / 2))
	wall(Vector3.new(t, H, D), Vector3.new(W / 2, H / 2, D / 2))
	-- windows (dark glass with trim) on front and sides
	for _, wx in { -W * 0.32, W * 0.32 } do
		block(parent, Vector3.new(4, 3.4, 0.3), at(wx, 5.2, -0.6), Color3.fromRGB(30, 34, 36), Enum.Material.Glass, { Transparency = 0.25 })
		block(parent, Vector3.new(4.6, 0.3, 0.6), at(wx, 3.4, -0.7), trim, Enum.Material.Wood)
	end
	for _, sz in { D * 0.3, D * 0.7 } do
		for _, sx in { -1, 1 } do
			block(parent, Vector3.new(0.3, 3.4, 4), at(sx * (W / 2 + 0.6), 5.2, sz), Color3.fromRGB(30, 34, 36), Enum.Material.Glass, { Transparency = 0.25 })
		end
	end
	-- interior: one partition with a doorway, a few furniture blocks
	wall(Vector3.new(W * 0.35, H, t), Vector3.new(-W * 0.325, H / 2, D * 0.55))
	wall(Vector3.new(W * 0.35, H, t), Vector3.new(W * 0.325, H / 2, D * 0.55))
	block(parent, Vector3.new(6, 2.4, 3), at(-W * 0.3, 1.7, D * 0.3), Color3.fromRGB(86, 70, 60), Enum.Material.Fabric) -- sofa
	block(parent, Vector3.new(5, 3, 2.5), at(W * 0.3, 2, D * 0.85), Color3.fromRGB(120, 110, 96), Enum.Material.Wood) -- counter
	-- roof: two sloped wedges
	local rise = 7
	-- WedgePart: tall edge at +Z, slope descending to -Z
	MapKit.wedge(parent, Vector3.new(W + 2, rise, D / 2 + 1), at(0, H + rise / 2, D * 0.25 - 0.5), C.roof, Enum.Material.RoofShingles)
	MapKit.wedge(parent, Vector3.new(W + 2, rise, D / 2 + 1), at(0, H + rise / 2, D * 0.75 + 0.5) * CFrame.Angles(0, math.pi, 0), C.roof, Enum.Material.RoofShingles)
	block(parent, Vector3.new(W, 1, D), at(0, H + 0.5, D / 2), siding, wallMat) -- ceiling
	-- a dim lamp inside
	MapKit.bulb(parent, at(0, H - 1.5, D * 0.3).Position, 16)
	local function world(x, z)
		return at(x, 0, z).Position
	end
	return {
		doorways = { { hinge = world(-doorW / 2, -0.1), width = doorW, dir = cf.RightVector } },
		containers = {
			{ pos = world(-W * 0.38, D * 0.85), type = "Drawer", yaw = math.deg(yaw) + 180 },
			{ pos = world(W * 0.4, D * 0.4), type = rng:NextNumber() < 0.5 and "Locker" or "Toolbox", yaw = math.deg(yaw) - 90 },
		},
		loot = { world(0, D * 0.3), world(-W * 0.25, D * 0.75), world(W * 0.2, D * 0.25) },
	}
end

return MapKit
]]></ProtectedString></Properties></Item>
</Item>
<Item class="Folder" referent="RBX00000034"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX00000025"><Properties><string name="Name">ActionService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Every non-gun player action, validated server-side. The client only sends intent:
--   Action("Quiet")                     Quieting from behind / with a Tide Spike, else shove
--   Action("Throw", {dir, item})        bottle / flare pot / fog pot / salt bomb
--   Action("Ability")                   character signature ability
--   Action("Heal") / ("Torch") / ("Craft", recipeId)
--   Action("Equip", slot) / ("Fire", {dir, aim}) / ("Reload")   -> WeaponService
--   Action("SecondWind") / ("Resupply") run aids (tokens; once per crossing)
local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Characters = require(Shared.Config.Characters)
local Game = require(Shared.Config.Game)
local Items = require(Shared.Config.Items)
local Net = require(Shared.Net)
local Geometry = require(Shared.Util.Geometry)
local Sfx = require(Shared.Util.Sfx)

local ActionService = {}
local Services

local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local function serverTime()
	return Workspace:GetServerTimeNow()
end

local function toast(player, text)
	Net.notify(player, "Toast", { text = text })
end

local function setBusy(info, seconds)
	info.session.busyUntil = os.clock() + seconds
	info.char:SetAttribute("BusyUntil", serverTime() + seconds)
end

local function isBusy(info)
	return os.clock() < info.session.busyUntil
end

local function channel(info, seconds, fn)
	local session = info.session
	session.channelId += 1
	local id = session.channelId
	setBusy(info, seconds)
	task.delay(seconds, function()
		if session.channelId == id and not session.downed and not session.out then
			fn()
		end
	end)
end

local function rayParamsFor(char)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { char }
	return params
end

local function effectHolder(position, lifetime)
	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.new(0.2, 0.2, 0.2)
	holder.CFrame = CFrame.new(position)
	holder.Parent = Workspace
	Debris:AddItem(holder, lifetime)
	return holder
end

-- Quieting / spike / shove -------------------------------------------------------------------

local function cue(info, name)
	info.char:SetAttribute(name, serverTime())
end

local MELEE = { damage = { 24, 24, 40 }, range = 5.5, interval = 0.42, comboWindow = 0.95, noise = 10 }

local function melee(player, info)
	local session = info.session
	local now = os.clock()
	if now < (session.meleeReadyAt or 0) then
		return
	end
	session.meleeCombo = (now - (session.lastMeleeAt or 0) < MELEE.comboWindow) and ((session.meleeCombo or 0) % 3 + 1) or 1
	session.lastMeleeAt = now
	session.meleeReadyAt = now + MELEE.interval
	local combo = session.meleeCombo
	info.char:SetAttribute("MeleeCombo", combo)
	cue(info, "MeleeAt")
	setBusy(info, 0.3)
	Sfx.at(info.root.Position, "Swing", 0.5, 30, 0.1)
	local pos, look = info.root.Position, info.root.CFrame.LookVector
	task.delay(0.12, function() -- strike lands mid-swing
		for _, entry in Services.EnemyService.findNear(pos, MELEE.range) do
			local e = entry.enemy
			local to = Geometry.flat(e.root.Position - pos)
			if to.Magnitude > 0.01 and look:Dot(to.Unit) > 0.35 then
				local damage = MELEE.damage[combo] * (e.cfg.shoveable and 1 or 0.5)
				local killed = Services.EnemyService.damage(e, damage, player, false)
				Sfx.at(e.root.Position, "MeleeHit", 0.7, 50, 0.1)
				Net.notify(player, "Hit", { kill = killed, melee = true })
				if not killed and combo == 3 and e.cfg.shoveable then
					Services.EnemyService.stun(e, Items.Shove.stun, player)
					e.root.AssemblyLinearVelocity = to.Unit * 34
				end
				break
			end
		end
	end)
	Services.PerceptionService.emitNoise(pos, MELEE.noise, "melee", player)
end

local function dodge(player, info, direction)
	local session = info.session
	local now = os.clock()
	if now < (session.dodgeReadyAt or 0) or isBusy(info) then
		return
	end
	if not Geometry.isSaneVector(direction, 2) then
		return
	end
	local dive = info.char:GetAttribute("Sprint") == true
	session.dodgeReadyAt = now + (dive and 1.3 or 0.85)
	session.dodgeUntil = now + (dive and 0.6 or 0.42) -- grabs miss during the dodge
	Services.CharacterService.setGrace(player, 1.2)
	info.char:SetAttribute("DodgeDive", dive)
	cue(info, "DodgeAt")
	Services.PerceptionService.emitNoise(info.root.Position, dive and 14 or 8, "dodge", player)
end

local function quietEnemy(player, info, e, duration)
	Services.EnemyService.stun(e, duration + 5, nil, "Quieted")
	setBusy(info, duration)
	cue(info, "TakedownAt")
	Net.notify(player, "Takedown", { duration = duration })
	task.delay(duration, function()
		Services.EnemyService.disperse(e, player)
		Services.PerceptionService.emitNoise(e.root.Position, Items.Quieting.noise, "quieting", nil)
	end)
	info.session.stats.takedowns += 1
	Services.InventoryService.add(player, "salvage", Items.Quieting.salvage)
end

local function quiet(player, info)
	if isBusy(info) then
		return
	end
	local pos = info.root.Position
	local near = Services.EnemyService.findNear(pos, math.max(Items.Quieting.range, Items.Shove.range))
	local look = info.root.CFrame.LookVector
	local duration = Items.Quieting.time * info.session.mods.takedownTimeMult
	for _, entry in near do
		local e = entry.enemy
		if entry.distance <= Items.Quieting.range and Services.EnemyService.canQuiet(e, pos) then
			quietEnemy(player, info, e, duration)
			return
		end
	end
	-- a Tide Spike lets you Quiet from the front (not Tidewalkers)
	for _, entry in near do
		local e = entry.enemy
		local to = Geometry.flat(e.root.Position - pos)
		if entry.distance <= Items.Quieting.range and e.cfg.quietable and e.state ~= "Quieted" and to.Magnitude > 0.01 and look:Dot(to.Unit) > 0.3 then
			if Services.InventoryService.take(player, "spike", 1) then
				quietEnemy(player, info, e, duration * 0.8)
				toast(player, "Tide Spike used")
				return
			end
			break
		end
	end
	-- otherwise: melee combo (third hit knocks them back)
	melee(player, info)
end

-- Called by EnemyService when a Hushed grabs someone. Returns true if a spike saved them.
function ActionService.trySpikeCounter(player, e)
	if not e.cfg.quietable then
		return false
	end
	local info = Services.MatchService.getActiveInfo(player)
	if not info or not Services.InventoryService.take(player, "spike", 1) then
		return false
	end
	toast(player, "Spike! You broke free.")
	quietEnemy(player, info, e, 0.6)
	return true
end

-- Throwables ---------------------------------------------------------------------------------

local landing = {}

function landing.bottle(position, player, mods)
	local radius = Items.Throw.bottle.noise * mods.throwNoiseMult
	Services.PerceptionService.emitNoise(position, radius, "bottle", nil)
	Sfx.at(position, "BottleBreak", 0.8, 160)
	local shards = Instance.new("ParticleEmitter")
	shards.Rate = 0
	shards.Lifetime = NumberRange.new(0.4, 0.8)
	shards.Speed = NumberRange.new(8, 16)
	shards.SpreadAngle = Vector2.new(70, 70)
	shards.Acceleration = Vector3.new(0, -40, 0)
	shards.Color = ColorSequence.new(Color3.fromRGB(150, 200, 170))
	shards.Size = NumberSequence.new(0.15)
	shards.Parent = effectHolder(position, 2)
	shards:Emit(25)
end

function landing.flarePot(position, player, mods)
	local cfg = Items.Throw.flarePot
	Services.EnemyService.addFireZone(position, cfg.radius, cfg.duration, cfg.dps, player)
	Services.PerceptionService.emitNoise(position, cfg.noise * mods.throwNoiseMult, "flare", nil)
	local holder = effectHolder(position + Vector3.new(0, 0.3, 0), cfg.duration + 1)
	Sfx.attach(holder, "FireLoop", 0.8, 70, true)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 120, 60)
	light.Range = cfg.radius * 2.5
	light.Brightness = 3
	light.Shadows = true
	light.Parent = holder
	local sparks = Instance.new("ParticleEmitter")
	sparks.Rate = 60
	sparks.Lifetime = NumberRange.new(0.6, 1.2)
	sparks.Speed = NumberRange.new(2, 6)
	sparks.SpreadAngle = Vector2.new(60, 60)
	sparks.Color = ColorSequence.new(Color3.fromRGB(255, 160, 80), Color3.fromRGB(255, 70, 40))
	sparks.LightEmission = 1
	sparks.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 0) })
	sparks.Parent = holder
	local glow = Instance.new("ParticleEmitter")
	glow.Texture = SMOKE
	glow.Rate = 8
	glow.Lifetime = NumberRange.new(1.5, 2.5)
	glow.Speed = NumberRange.new(1, 3)
	glow.Color = ColorSequence.new(Color3.fromRGB(255, 120, 70))
	glow.LightEmission = 0.6
	glow.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, cfg.radius) })
	glow.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) })
	glow.Parent = holder
	task.delay(cfg.duration, function()
		sparks.Enabled = false
		glow.Enabled = false
		light.Enabled = false
	end)
end

function landing.fogPot(position, player, mods)
	local cfg = Items.Throw.fogPot
	Services.PerceptionService.addFogCloud(position + Vector3.new(0, 3, 0), cfg.radius, cfg.duration)
	Services.PerceptionService.emitNoise(position, cfg.noise * mods.throwNoiseMult, "fog", nil)
	for _, entry in Services.EnemyService.findNear(position, cfg.radius) do
		Services.EnemyService.stun(entry.enemy, cfg.stun, nil)
	end
	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = SMOKE
	smoke.Rate = 40
	smoke.Lifetime = NumberRange.new(3, 4)
	smoke.Speed = NumberRange.new(2, 5)
	smoke.SpreadAngle = Vector2.new(180, 30)
	smoke.Drag = 1.5
	smoke.Color = ColorSequence.new(Color3.fromRGB(200, 205, 205))
	smoke.LightInfluence = 1
	smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 4), NumberSequenceKeypoint.new(1, cfg.radius * 1.2) })
	smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(0.8, 0.4), NumberSequenceKeypoint.new(1, 1) })
	smoke.Parent = effectHolder(position + Vector3.new(0, 1, 0), cfg.duration + 5)
	Sfx.at(position, "FogHiss", 0.8, 60)
	task.delay(cfg.duration, function()
		smoke.Enabled = false
	end)
end

function landing.saltBomb(position, player, mods)
	local cfg = Items.Throw.saltBomb
	local mine = Instance.new("Part")
	mine.Name = "SaltBomb"
	mine.Anchored = true
	mine.CanCollide = false
	mine.CanQuery = false
	mine.Shape = Enum.PartType.Cylinder
	mine.Size = Vector3.new(0.35, 1.1, 1.1)
	mine.Color = Color3.fromRGB(60, 58, 54)
	mine.Material = Enum.Material.Metal
	mine.CFrame = CFrame.new(position + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.rad(90))
	mine.Parent = Workspace
	local blink = Instance.new("PointLight")
	blink.Color = Color3.fromRGB(255, 80, 60)
	blink.Range = 4
	blink.Brightness = 2
	blink.Parent = mine
	task.spawn(function()
		task.wait(cfg.armTime)
		local expires = os.clock() + cfg.lifetime
		while mine.Parent and os.clock() < expires and Services.MatchService.state == "Encounter" do
			blink.Enabled = not blink.Enabled
			if #Services.EnemyService.findNear(mine.Position, cfg.triggerRadius) > 0 then
				break
			end
			task.wait(0.25)
		end
		if not mine.Parent then
			return
		end
		local at = mine.Position
		mine:Destroy()
		Services.EnemyService.explode(at, cfg.radius, cfg.damage, player)
		Services.PerceptionService.emitNoise(at, cfg.noise, "explosion", nil)
		Sfx.at(at, "Explosion", 1, 250)
		Net.notifyAll("Explosion", { position = at, radius = cfg.radius })
		local burst = Instance.new("ParticleEmitter")
		burst.Texture = SMOKE
		burst.Rate = 0
		burst.Lifetime = NumberRange.new(1, 2)
		burst.Speed = NumberRange.new(10, 22)
		burst.SpreadAngle = Vector2.new(180, 180)
		burst.Drag = 4
		burst.Color = ColorSequence.new(Color3.fromRGB(230, 225, 210))
		burst.LightEmission = 0.3
		burst.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 8) })
		burst.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
		local holder = effectHolder(at, 3)
		burst.Parent = holder
		burst:Emit(60)
		local flash = Instance.new("PointLight")
		flash.Range = 30
		flash.Brightness = 6
		flash.Color = Color3.fromRGB(255, 220, 180)
		flash.Parent = holder
		task.delay(0.15, function()
			flash.Enabled = false
		end)
	end)
end

local THROW_COLORS = {
	bottle = Color3.fromRGB(70, 120, 90),
	flarePot = Color3.fromRGB(170, 90, 50),
	fogPot = Color3.fromRGB(150, 150, 140),
	saltBomb = Color3.fromRGB(60, 58, 54),
}

local function throw(player, info, payload)
	if type(payload) ~= "table" then
		return
	end
	local direction, itemId = payload.dir, payload.item
	if type(itemId) ~= "string" or not landing[itemId] then
		return
	end
	if not Geometry.isSaneVector(direction, 2) or direction.Magnitude < 0.5 then
		return
	end
	direction = direction.Unit
	if isBusy(info) then
		return
	end
	if not Services.InventoryService.take(player, itemId, 1) then
		toast(player, "No " .. Items.Items[itemId].name)
		return
	end
	setBusy(info, 0.35)
	cue(info, "ThrowAt")
	Sfx.at(info.root.Position, "Throw", 0.5, 30)
	local head = info.char:FindFirstChild("Head")
	local position = (head and head.Position or info.root.Position) + direction * 1.5
	local velocity = direction * Items.Throw.speed + Vector3.new(0, Items.Throw.lift, 0)
	local object = Instance.new("Part")
	object.Anchored = true
	object.CanCollide = false
	object.CanQuery = false
	object.Size = Vector3.new(0.5, 0.8, 0.5)
	object.Material = itemId == "bottle" and Enum.Material.Glass or Enum.Material.Metal
	object.Color = THROW_COLORS[itemId]
	object.Transparency = itemId == "bottle" and 0.2 or 0
	object.CFrame = CFrame.new(position)
	object.Parent = Workspace
	if itemId == "flarePot" then
		local spark = Instance.new("PointLight")
		spark.Color = Color3.fromRGB(255, 140, 70)
		spark.Range = 6
		spark.Parent = object
	end
	local params = rayParamsFor(info.char)
	local mods = info.session.mods
	local age = 0
	local conn
	conn = RunService.Heartbeat:Connect(function(dt)
		age += dt
		velocity += Vector3.new(0, -Workspace.Gravity * 0.5, 0) * dt
		local step = velocity * dt
		local result = Workspace:Raycast(position, step, params)
		if result or age > 4 then
			conn:Disconnect()
			object:Destroy()
			landing[itemId](result and result.Position or position, player, mods)
			return
		end
		position += step
		object.CFrame = CFrame.new(position) * CFrame.Angles(age * 9, age * 5, 0)
	end)
end

-- Abilities ----------------------------------------------------------------------------------

local abilities = {}

function abilities.TideSense(player, info, ability, mods)
	Net.notify(player, "TideSense", {
		radius = ability.radius * mods.abilityRadiusMult,
		duration = ability.duration * mods.abilityDurationMult,
	})
	return true
end

function abilities.RattleBox(player, info, ability, mods)
	local look = Geometry.flat(info.root.CFrame.LookVector)
	look = look.Magnitude > 0.01 and look.Unit or Vector3.new(0, 0, -1)
	local spot = info.root.Position + look * 3
	local down = Workspace:Raycast(spot + Vector3.new(0, 3, 0), Vector3.new(0, -12, 0), rayParamsFor(info.char))
	local ground = down and down.Position or Vector3.new(spot.X, 0, spot.Z)
	local box = Instance.new("Part")
	box.Name = "RattleBox"
	box.Anchored = true
	box.CanCollide = false
	box.Size = Vector3.new(1, 0.8, 1)
	box.Material = Enum.Material.Metal
	box.Color = Color3.fromRGB(150, 120, 60)
	box.CFrame = CFrame.new(ground + Vector3.new(0, 0.4, 0))
	box.Parent = Workspace
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 200, 120)
	light.Range = 6
	light.Parent = box
	local radius = ability.radius * mods.abilityRadiusMult
	local duration = ability.duration * mods.abilityDurationMult
	task.spawn(function()
		local elapsed = 0
		while elapsed < duration and box.Parent do
			light.Enabled = not light.Enabled
			Services.PerceptionService.emitNoise(box.Position, radius, "rattle", nil)
			Sfx.at(box.Position, "Rattle", 0.4, radius * 2)
			task.wait(1.5)
			elapsed += 1.5
		end
		box:Destroy()
	end)
	return true
end

function abilities.SteadyHands(player, info, ability, mods)
	Services.CharacterService.heal(player, 40 * mods.healMult)
	for _, other in Services.MatchService.getActivePlayers() do
		if other.player ~= player and (other.root.Position - info.root.Position).Magnitude <= ability.radius then
			Services.CharacterService.heal(other.player, 20 * mods.healMult)
			toast(other.player, player.DisplayName .. " patched you up")
		end
	end
	info.session.calmUntil = os.clock() + ability.duration * mods.abilityDurationMult
	return true
end

function abilities.ThrowNet(player, info, ability, mods)
	local look = info.root.CFrame.LookVector
	local params = rayParamsFor(info.char)
	for _, entry in Services.EnemyService.findNear(info.root.Position, ability.radius) do
		local e = entry.enemy
		local to = e.root.Position - info.root.Position
		if to.Magnitude > 0.01 and look:Dot(to.Unit) > 0.8 then
			local hit = Workspace:Raycast(info.root.Position, to, params)
			if not hit or Services.EnemyService.fromInstance(hit.Instance) == e then
				Services.EnemyService.pin(e, ability.duration * mods.abilityDurationMult)
				return true
			end
		end
	end
	toast(player, "No Hushed in front of you to net")
	return false
end

local function useAbility(player, info)
	local session = info.session
	if isBusy(info) or os.clock() < session.abilityReadyAt then
		return
	end
	local ability = Characters.List[session.charId].ability
	local handler = abilities[ability.id]
	if handler and handler(player, info, ability, session.mods) then
		local cooldown = ability.cooldown * session.mods.abilityCooldownMult
		session.abilityReadyAt = os.clock() + cooldown
		info.char:SetAttribute("AbilityReadyAt", serverTime() + cooldown)
	end
end

-- Healing, torch, crafting -----------------------------------------------------------------

local function heal(player, info)
	if isBusy(info) then
		return
	end
	if info.session.hp >= Game.MaxHP then
		toast(player, "Already at full health")
		return
	end
	if Services.InventoryService.count(player, "dressing") < 1 then
		toast(player, "No Field Dressings: craft one from Cloth + Alcohol")
		return
	end
	Services.WeaponService.holster(player)
	cue(info, "HealAt")
	Sfx.at(info.root.Position, "Bandage", 0.6, 30)
	channel(info, Items.Dressing.channel, function()
		if Services.InventoryService.take(player, "dressing", 1) then
			Services.CharacterService.heal(player, Items.Dressing.heal * info.session.mods.healMult)
		end
	end)
end

local function toggleTorch(_player, char)
	Services.CharacterService.toggleFlashlight(char)
end

local function craft(player, info, recipeId)
	if type(recipeId) ~= "string" or not Items.Recipes[recipeId] or isBusy(info) then
		return
	end
	local ok, reason = Services.InventoryService.canCraft(player, recipeId)
	if not ok then
		toast(player, reason)
		return
	end
	local recipe = Items.Recipes[recipeId]
	Services.WeaponService.holster(player)
	channel(info, recipe.time * info.session.mods.craftTimeMult, function()
		local crafted, why = Services.InventoryService.craft(player, recipeId)
		toast(player, crafted and ("Crafted " .. recipe.name) or why)
	end)
end

-- Run aids ---------------------------------------------------------------------------------

function ActionService.useSecondWind(player)
	if not Game.RunAidsEnabled then
		return false
	end
	local session = Services.CharacterService.getSession(player)
	if not session or not session.downed or session.out or Services.MatchService.state ~= "Encounter" then
		return false
	end
	if session.usedSecondWind then
		toast(player, "Second Wind is limited to once per crossing")
		return false
	end
	if not Services.PlayerDataService.useToken(player, "secondWind") then
		Net.notify(player, "NeedProduct", { productKey = "SecondWind" })
		return false
	end
	session.usedSecondWind = true
	Services.CharacterService.revive(player, Game.SecondWindHP)
	return true
end

function ActionService.useResupply(player)
	if not Game.RunAidsEnabled then
		return false
	end
	local session = Services.CharacterService.getSession(player)
	if not session or not session.runId or session.downed then
		toast(player, "Resupply works during a crossing")
		return false
	end
	if session.usedResupply then
		toast(player, "Resupply is limited to once per crossing")
		return false
	end
	if not Services.PlayerDataService.useToken(player, "resupply") then
		Net.notify(player, "NeedProduct", { productKey = "Resupply" })
		return false
	end
	session.usedResupply = true
	for itemId, amount in Items.Resupply do
		Services.InventoryService.add(player, itemId, amount)
	end
	toast(player, "Resupplied")
	return true
end

-- Dispatcher ---------------------------------------------------------------------------------

local HANDLERS = {
	Quiet = quiet,
	Throw = throw,
	Ability = useAbility,
	Heal = heal,
	Craft = craft,
	Equip = function(player, _info, slot)
		Services.WeaponService.equip(player, slot)
	end,
	Fire = function(player, info, payload)
		if type(payload) == "table" then
			Services.WeaponService.fire(player, info, payload.dir, payload.aim == true)
		end
	end,
	Reload = function(player, info)
		Services.WeaponService.reload(player, info)
	end,
	Dodge = function(player, info, direction)
		dodge(player, info, direction)
	end,
}

-- Actions allowed on the Meridian (no encounter running).
local FERRY_OK = { Craft = true, Equip = true, Reload = true, Dodge = true }

function ActionService.init(registry)
	Services = registry
end

function ActionService.start()
	Net.onServer("Action", 25, function(player, action, payload)
		if type(action) ~= "string" then
			return
		end
		if action == "SecondWind" then
			ActionService.useSecondWind(player)
			return
		elseif action == "Resupply" then
			ActionService.useResupply(player)
			return
		elseif action == "Torch" then
			local char = player.Character
			local session = Services.CharacterService.getSession(player)
			if char and session and not session.downed then
				toggleTorch(player, char)
			end
			return
		end
		local handler = HANDLERS[action]
		if not handler then
			return
		end
		local info = Services.MatchService.getActiveInfo(player)
		if not info and FERRY_OK[action] then
			info = Services.MatchService.getFerryInfo(player)
		end
		if info then
			handler(player, info, payload)
		end
	end)
end

return ActionService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000026"><Properties><string name="Name">AntiCheatService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Lightweight movement sanity checks. Roblox lets clients simulate their own character, so
-- speed hacks are possible; we detect impossible displacement and pull the player back.
-- PvE-only design keeps the stakes low (docs/02-technical-architecture.md section 2.4).
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Movement = require(Shared.Config.Movement)

local AntiCheatService = {}
local Services

local INTERVAL = 0.5
local track = {} -- [Player] = { pos, t, strikes, lastGood }

function AntiCheatService.init(registry)
	Services = registry
end

function AntiCheatService.start()
	Players.PlayerRemoving:Connect(function(player)
		track[player] = nil
	end)
	while true do
		task.wait(INTERVAL)
		local now = os.clock()
		for _, player in Players:GetPlayers() do
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local session = Services.CharacterService.getSession(player)
			if root and session then
				local t = track[player]
				if not t or t.char ~= char or now < session.graceUntil then
					track[player] = { char = char, pos = root.Position, t = now, strikes = 0, lastGood = root.CFrame }
				else
					local dt = now - t.t
					local moved = Vector3.new(root.Position.X - t.pos.X, 0, root.Position.Z - t.pos.Z).Magnitude
					local allowed = (Movement.Speeds.Sprint * session.mods.sprintSpeedMult * 1.5 + 6) * dt
					if moved > allowed then
						t.strikes += 1
						if t.strikes >= 2 then
							warn(("[AntiCheat] %s moved %.1f studs in %.2fs; resetting"):format(player.Name, moved, dt))
							char:PivotTo(t.lastGood)
							t.strikes = 0
						end
					else
						t.strikes = math.max(0, t.strikes - 1)
						t.lastGood = root.CFrame
					end
					t.pos = root.Position
					t.t = now
				end
			end
		end
	end
end

return AntiCheatService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000027"><Properties><string name="Name">AssetService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Loads the sculpted mesh packs (Config/AssetIds) once at server start and hands out clones.
-- Sources, in order: ServerStorage > Assets > <Pack> (imported in Studio), then
-- InsertService:LoadAsset(id) for uploaded packs. Missing packs => built-in fallbacks.
local InsertService = game:GetService("InsertService")
local ServerStorage = game:GetService("ServerStorage")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local AssetIds = require(Shared.Config.AssetIds)
local MeshMeta = require(Shared.Config.MeshMeta)

local AssetService = {}

local parts = {} -- [meshName] = MeshPart template
local loaded = false

local function index(container)
	for _, d in container:GetDescendants() do
		if d:IsA("MeshPart") then
			parts[d.Name] = d
		end
	end
end

function AssetService.load()
	local cache = Instance.new("Folder")
	cache.Name = "AftertideMeshCache"
	cache.Parent = ServerStorage
	local manual = ServerStorage:FindFirstChild("Assets")
	for pack, id in AssetIds.Packs do
		local source = manual and manual:FindFirstChild(pack)
		if source then
			index(source)
		elseif type(id) == "number" and id > 0 then
			local ok, result = pcall(function()
				return InsertService:LoadAsset(id)
			end)
			if ok and result then
				result.Name = pack
				result.Parent = cache
				index(result)
			else
				warn(("[AssetService] could not load pack %s (%s): %s"):format(pack, tostring(id), tostring(result)))
			end
		end
	end
	local count = 0
	for _ in parts do
		count += 1
	end
	print(("[AssetService] %d sculpted meshes available"):format(count))
	loaded = true
end

function AssetService.waitReady(timeout)
	local deadline = os.clock() + (timeout or 20)
	while not loaded and os.clock() < deadline do
		task.wait(0.1)
	end
	return loaded
end

-- A fresh clone of a mesh by its generated name (e.g. "Crew_mara_Head_Skin"), or nil.
function AssetService.part(name)
	local template = parts[name]
	return template and template:Clone() or nil
end

-- True when every layer of a kit (from MeshMeta) is loaded.
function AssetService.hasKit(kit)
	local entry = MeshMeta[kit]
	if not entry then
		return false
	end
	local groups = entry.type == "rig" and entry.segments or { entry }
	for _, group in groups do
		for _, layer in group.layers do
			if not parts[layer.part] then
				return false
			end
		end
	end
	return true
end

function AssetService.meta(kit)
	return MeshMeta[kit]
end

function AssetService.start()
	AssetService.load()
end

return AssetService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000028"><Properties><string name="Name">CharacterService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Spawns crew characters (never the player's Roblox avatar), and owns health, downed state,
-- revives and bleed-out. Health is our own "HP" attribute: the Humanoid is never damaged.
--
-- Realistic characters: if ServerStorage > Rigs contains a custom R15-compatible model for
-- the crew member (Config/Rigs), it is used. Otherwise Marketplace body parts from
-- Config/Rigs.BodyParts, otherwise the faceless placeholder mannequin.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local StarterPlayer = game:GetService("StarterPlayer")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Characters = require(Shared.Config.Characters)
local Game = require(Shared.Config.Game)
local Stats = require(Shared.Stats)
local Net = require(Shared.Net)
local Geometry = require(Shared.Util.Geometry)
local Rigs = require(Shared.Config.Rigs)
local BodyBuilder = require(Shared.BodyBuilder)
local MeshKit = require(Shared.MeshKit)
local AssetIds = require(Shared.Config.AssetIds)

local CharacterService = {}
local Services

local sessions = {} -- [Player] = session

local function newSession()
	return {
		charId = nil,
		perkId = nil,
		mods = Stats.compute(nil, nil),
		hp = Game.MaxHP,
		downed = false,
		out = false,
		bleedOutAt = 0,
		busyUntil = 0,
		channelId = 0,
		abilityReadyAt = 0,
		fireReadyAt = 0,
		shoveReadyAt = 0,
		calmUntil = 0,
		graceUntil = 0,
		usedSecondWind = false,
		usedResupply = false,
		stats = { takedowns = 0, detections = 0, crates = 0, kills = 0 },
		runId = nil,
		run = { weapons = {}, general = {}, perks = {} }, -- workbench upgrades this run
	}
end

function CharacterService.getSession(player)
	local session = sessions[player]
	if not session and player.Parent then
		session = newSession()
		sessions[player] = session
	end
	return session
end

function CharacterService.setCharacter(player, charId, perkId)
	local session = sessions[player]
	if not session or not Characters.List[charId] then
		return false
	end
	if not Stats.findPerk(charId, perkId) then
		perkId = Characters.List[charId].perks[1].id
	end
	session.charId = charId
	session.perkId = perkId
	CharacterService.refreshMods(player)
	player:SetAttribute("CharId", charId)
	player:SetAttribute("PerkId", perkId)
	return true
end

function CharacterService.publishRun(player)
	local session = sessions[player]
	if session then
		player:SetAttribute("RunUpgrades", HttpService:JSONEncode(session.run))
	end
end

function CharacterService.refreshMods(player)
	local session = sessions[player]
	if not session then
		return
	end
	session.mods = Stats.compute(session.charId, session.perkId, session.run.perks)
	CharacterService.publishRun(player)
end

-- Starts a new crossing for this player: fresh loadout (+ homebase bonuses), no upgrades.
function CharacterService.beginRun(player, runId, bonus)
	local session = CharacterService.getSession(player)
	if not session or not session.charId then
		return false
	end
	session.runId = runId
	session.run = { weapons = {}, general = {}, perks = {} }
	session.usedSecondWind = false
	session.usedResupply = false
	session.stats = { takedowns = 0, detections = 0, crates = 0, kills = 0 }
	CharacterService.refreshMods(player)
	Services.InventoryService.reset(player, Characters.List[session.charId].loadout, session.mods, bonus)
	return true
end

function CharacterService.endRun(player)
	local session = sessions[player]
	if session then
		session.runId = nil
		session.run = { weapons = {}, general = {}, perks = {} }
		CharacterService.refreshMods(player)
	end
end

function CharacterService.setGrace(player, seconds)
	local session = sessions[player]
	if session then
		session.graceUntil = math.max(session.graceUntil, os.clock() + seconds)
	end
end

local function buildDescription(def, charId)
	local desc = Instance.new("HumanoidDescription")
	desc.HeightScale = def.height or 1
	desc.WidthScale = 0.82
	desc.DepthScale = 0.85
	desc.HeadScale = 0.88
	desc.ProportionScale = 0
	desc.BodyTypeScale = 0
	local c = def.colors
	desc.HeadColor = c.skin
	desc.TorsoColor = c.torso
	desc.LeftArmColor = c.arms
	desc.RightArmColor = c.arms
	desc.LeftLegColor = c.legs
	desc.RightLegColor = c.legs
	local parts = Rigs.BodyParts[charId]
	if parts then
		for slot, assetId in parts do
			if type(assetId) == "number" and assetId > 0 then
				pcall(function()
					desc[slot] = assetId
				end)
			end
		end
	end
	return desc
end

local function customRig(charId)
	local folder = ServerStorage:FindFirstChild("Rigs")
	local name = Rigs.Custom[charId]
	local template = folder and name and folder:FindFirstChild(name)
	if template and template:IsA("Model") and template:FindFirstChildOfClass("Humanoid") and template:FindFirstChild("HumanoidRootPart") then
		return template
	end
	return nil
end

-- Spawns a custom rig as the player's character (keeps Animate if the rig contains one).
local function spawnCustomRig(player, template)
	local rig = template:Clone()
	rig.Name = player.Name
	local old = player.Character
	for _, child in StarterPlayer:WaitForChild("StarterCharacterScripts"):GetChildren() do
		if not rig:FindFirstChild(child.Name) then
			child:Clone().Parent = rig
		end
	end
	player.Character = rig
	rig.Parent = Workspace
	if old and old ~= rig then
		old:Destroy()
	end
	pcall(function()
		rig.HumanoidRootPart:SetNetworkOwner(player)
	end)
	return rig
end

local function setupCharacter(player, char, session, isCustomRig)
	local humanoid = char:WaitForChild("Humanoid")
	local root = char:WaitForChild("HumanoidRootPart")
	local head = char:WaitForChild("Head")

	humanoid.UseJumpPower = true
	humanoid.JumpPower = 0 -- grounded movement; vaulting comes in Stage 5
	humanoid.BreakJointsOnDeath = false
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.NameDisplayDistance = 60
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)

	if not isCustomRig then
		-- Replace the Roblox look and motion: sculpted, clothed body + our own animation
		-- (client PlayerAnimator) instead of the default Animate script.
		local animate = char:FindFirstChild("Animate")
		if animate then
			animate:Destroy()
		end
		local kit = "Crew_" .. session.charId
		local ok, err
		if Services.AssetService.hasKit(kit) then
			-- sculpted, realistic crew model fitted onto the skeleton
			ok, err = pcall(MeshKit.applyRig, char, Services.AssetService.meta(kit), Services.AssetService.part, "r15", AssetIds.YawFix)
		else
			ok, err = pcall(BodyBuilder.build, char, Characters.List[session.charId])
		end
		if not ok then
			warn("[CharacterService] body build failed: " .. tostring(err))
		end
		char:SetAttribute("Procedural", true)
	end

	CharacterService.addFlashlight(char)

	char:SetAttribute("HP", session.hp)
	char:SetAttribute("MaxHP", Game.MaxHP)
	char:SetAttribute("Downed", false)
	char:SetAttribute("Out", false)
	char:SetAttribute("Torch", false)
	char:SetAttribute("Stance", "Stand")
	char:SetAttribute("Sprint", false)
	char:SetAttribute("Aim", false)
	char:SetAttribute("BusyUntil", 0)
	char:SetAttribute("Noise", 0)
	char:SetAttribute("AbilityReadyAt", 0)
	char:SetAttribute("CharId", session.charId)
	return root
end

-- (Re)spawns the player's chosen crew member at `cframe`.
-- resetInventory: give a fresh loadout (outside a run). During a run the satchel is kept.
function CharacterService.spawn(player, cframe, resetInventory)
	local session = sessions[player]
	if not session or not session.charId then
		return nil
	end
	local def = Characters.List[session.charId]

	session.hp = Game.MaxHP
	session.downed = false
	session.out = false
	session.busyUntil = 0
	session.channelId += 1
	session.abilityReadyAt = 0
	session.calmUntil = 0

	local char
	local template = customRig(session.charId)
	if template then
		char = spawnCustomRig(player, template)
	else
		local spawned
		local conn = player.CharacterAdded:Connect(function(c)
			spawned = c
		end)
		local ok, err = pcall(function()
			player:LoadCharacterWithHumanoidDescription(buildDescription(def, session.charId))
		end)
		local deadline = os.clock() + 8
		while ok and not spawned and player.Parent and os.clock() < deadline do
			task.wait()
		end
		conn:Disconnect()
		if not ok then
			warn("[CharacterService] spawn failed: " .. tostring(err))
			return nil
		end
		char = spawned or player.Character
	end
	if not char then
		return nil
	end
	setupCharacter(player, char, session, template ~= nil)
	CharacterService.setGrace(player, 3)
	char:PivotTo(cframe)
	if resetInventory or not Services.InventoryService.has(player) then
		Services.InventoryService.reset(player, def.loadout, session.mods)
	else
		Services.InventoryService.publish(player)
	end
	Services.WeaponService.onSpawn(player, char)
	return char
end

-- A flashlight clipped to the left chest strap: a shadow-casting spotlight plus a soft
-- visible beam (light shaft) through the fog. Same rig is used by human enemies.
function CharacterService.addFlashlight(char, bodyName)
	local body = char:FindFirstChild(bodyName or "UpperTorso") or char:FindFirstChild("Torso")
	if not body or body:FindFirstChild("FlashlightMount") then
		return
	end
	local mount = Instance.new("Attachment")
	mount.Name = "FlashlightMount"
	mount.Position = Vector3.new(-body.Size.X * 0.22, body.Size.Y * 0.18, -body.Size.Z * 0.5 - 0.15)
	mount.Parent = body
	local light = Instance.new("SpotLight")
	light.Name = "Flashlight"
	light.Angle = 42
	light.Range = 75
	light.Brightness = 3.4
	light.Color = Color3.fromRGB(255, 244, 222)
	light.Shadows = true
	light.Face = Enum.NormalId.Front
	light.Enabled = false
	light.Parent = mount
	local far = Instance.new("Attachment")
	far.Name = "FlashlightFar"
	far.Position = mount.Position + Vector3.new(0, -0.6, -24)
	far.Parent = body
	local beam = Instance.new("Beam")
	beam.Name = "FlashlightBeam"
	beam.Attachment0 = mount
	beam.Attachment1 = far
	beam.Width0 = 0.5
	beam.Width1 = 9
	beam.FaceCamera = true
	beam.LightEmission = 0.6
	beam.LightInfluence = 0
	beam.Color = ColorSequence.new(Color3.fromRGB(255, 246, 228))
	beam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.82), NumberSequenceKeypoint.new(0.6, 0.94), NumberSequenceKeypoint.new(1, 1) })
	beam.Segments = 1
	beam.Enabled = false
	beam.Parent = body
end

function CharacterService.setFlashlight(char, on)
	local light = char:FindFirstChild("Flashlight", true)
	local beam = char:FindFirstChild("FlashlightBeam", true)
	if light then
		light.Enabled = on
	end
	if beam then
		beam.Enabled = on
	end
	char:SetAttribute("Torch", on)
end

function CharacterService.toggleFlashlight(char)
	local light = char:FindFirstChild("Flashlight", true)
	CharacterService.setFlashlight(char, not (light and light.Enabled))
end

function CharacterService.heal(player, amount)
	local session = sessions[player]
	local char = player.Character
	if not session or not char or session.downed or session.out then
		return
	end
	session.hp = math.min(Game.MaxHP, session.hp + amount)
	char:SetAttribute("HP", session.hp)
end

local function removeRevivePrompt(char)
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local prompt = root and root:FindFirstChild("Revive")
	if prompt then
		prompt:Destroy()
	end
end

function CharacterService.revive(player, hp)
	local session = sessions[player]
	local char = player.Character
	if not session or not char or not session.downed or session.out then
		return false
	end
	session.downed = false
	session.hp = math.clamp(hp, 1, Game.MaxHP)
	char:SetAttribute("Downed", false)
	char:SetAttribute("HP", session.hp)
	removeRevivePrompt(char)
	Net.notifyAll("Toast", { text = player.DisplayName .. " is back up" })
	return true
end

function CharacterService.markOut(player)
	local session = sessions[player]
	if not session or session.out then
		return
	end
	session.out = true
	local char = player.Character
	if char then
		char:SetAttribute("Out", true)
		removeRevivePrompt(char)
	end
	Net.notifyAll("Toast", { text = player.DisplayName .. " was lost to the Pall" })
	Services.MatchService.onPlayerDowned(player)
end

function CharacterService.down(player)
	local session = sessions[player]
	local char = player.Character
	if not session or not char or session.downed then
		return
	end
	session.downed = true
	session.hp = 0
	session.channelId += 1
	Services.WeaponService.onDowned(player)
	local bleed = Game.BleedOutTime + session.mods.bleedOutBonus
	session.bleedOutAt = os.clock() + bleed
	char:SetAttribute("Downed", true)
	char:SetAttribute("HP", 0)
	char:SetAttribute("BleedOutAt", Workspace:GetServerTimeNow() + bleed)
	char:SetAttribute("Torch", false)
	CharacterService.setFlashlight(char, false)

	local root = char:FindFirstChild("HumanoidRootPart")
	if root then
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "Revive"
		prompt.ActionText = "Revive"
		prompt.ObjectText = player.DisplayName
		prompt.HoldDuration = Game.ReviveTime
		prompt.MaxActivationDistance = 8
		prompt.RequiresLineOfSight = false
		prompt.GamepadKeyCode = Enum.KeyCode.ButtonA
		prompt.Parent = root
		prompt.Triggered:Connect(function(reviver)
			if reviver == player then
				return
			end
			local info = Services.MatchService.getActiveInfo(reviver)
			if not info or (info.root.Position - root.Position).Magnitude > 12 then
				return
			end
			local reviverSession = sessions[reviver]
			CharacterService.revive(player, Game.ReviveHP + reviverSession.mods.reviveHPBonus)
		end)
	end

	Net.notifyAll("Toast", { text = player.DisplayName .. " is down!" })
	Services.MatchService.onPlayerDowned(player)
end

-- Damage from a Hushed grab. `fromPosition` drives the knockback direction.
function CharacterService.damage(player, amount, fromPosition)
	local session = sessions[player]
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not session or not root or session.downed or session.out then
		return
	end
	if os.clock() < (session.dodgeUntil or 0) then
		Net.notify(player, "Toast", { text = "Dodged!" })
		return
	end
	amount *= session.mods.damageTakenMult
	session.hp = math.max(0, session.hp - amount)
	session.channelId += 1 -- interrupts healing/crafting
	char:SetAttribute("HP", session.hp)
	char:SetAttribute("BusyUntil", 0)
	session.busyUntil = 0

	if fromPosition then
		local away = Geometry.flat(root.Position - fromPosition)
		if away.Magnitude > 0.01 then
			CharacterService.setGrace(player, 1.5)
			Net.notify(player, "Knockback", { velocity = away.Unit * 38 + Vector3.new(0, 14, 0) })
		end
	end
	Net.notify(player, "Hurt", { amount = amount })

	if session.hp <= 0 then
		CharacterService.down(player)
	end
end

function CharacterService.init(registry)
	Services = registry
end

function CharacterService.start()
	Players.PlayerAdded:Connect(function(player)
		CharacterService.getSession(player)
	end)
	for _, player in Players:GetPlayers() do
		if not sessions[player] then
			sessions[player] = newSession()
		end
	end
	Players.PlayerRemoving:Connect(function(player)
		sessions[player] = nil
	end)

	-- Stance/sprint/aim replicate as character attributes (used by AI, noise and other clients).
	Net.onServer("SetMoveState", 15, function(player, stance, sprinting, aiming)
		if stance ~= "Stand" and stance ~= "Crouch" then
			return
		end
		local char = player.Character
		local session = sessions[player]
		if not char or not session or session.downed then
			return
		end
		char:SetAttribute("Stance", stance)
		char:SetAttribute("Sprint", sprinting == true and stance == "Stand")
		char:SetAttribute("Aim", aiming == true)
	end)

	while true do
		task.wait(0.5)
		local now = os.clock()
		for player, session in sessions do
			if session.downed and not session.out and now >= session.bleedOutAt then
				CharacterService.markOut(player)
			end
		end
	end
end

return CharacterService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000029"><Properties><string name="Name">CommerceService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Developer product receipts. Rules that matter:
--   * Idempotent: a receipt (PurchaseId) is granted exactly once, even if Roblox retries.
--   * Only report PurchaseGranted once the grant is saved (or we're in memory-only Studio mode).
--   * Purchases grant TOKENS (persistent). Using a token is a separate, limited action
--     (Second Wind: once per crossing). If you're downed when a Second Wind purchase
--     completes, it is used straight away.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Commerce = require(Shared.Config.Commerce)
local Net = require(Shared.Net)

local CommerceService = {}
local Services

local byProductId = {}

local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = Services.PlayerDataService.waitFor(player, 10)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local entry = byProductId[receipt.ProductId]
	if not entry then
		warn("[Commerce] unknown product id " .. tostring(receipt.ProductId) .. ": add it to Config/Commerce.luau")
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if Services.PlayerDataService.hasReceipt(player, receipt.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	for kind, amount in entry.product.grant do
		Services.PlayerDataService.addTokens(player, kind, amount)
	end
	Services.PlayerDataService.recordReceipt(player, receipt.PurchaseId)

	if not Services.PlayerDataService.save(player) and not Services.PlayerDataService.isMemoryOnly() then
		-- Granted in memory and receipt recorded, so a retry in this session won't double-grant.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	Net.notify(player, "Toast", { text = "Thank you! " .. entry.product.name .. " added." })
	if entry.key == "SecondWind" or entry.key == "SecondWind3" then
		task.defer(function()
			local session = Services.CharacterService.getSession(player)
			if session and session.downed and not session.usedSecondWind then
				Services.ActionService.useSecondWind(player)
			end
		end)
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function CommerceService.init(registry)
	Services = registry
	for key, product in Commerce.Products do
		if product.productId and product.productId ~= 0 then
			byProductId[product.productId] = { key = key, product = product }
		end
	end
end

function CommerceService.start()
	MarketplaceService.ProcessReceipt = processReceipt
end

return CommerceService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002A"><Properties><string name="Name">EnemyService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The Hushed. Server-simulated, one state machine per enemy:
--   Patrol -> (notice) -> Investigate -> Search -> Patrol
--   any    -> (suspicion >= 1 or shot) -> Chase -> (lost sight) -> Search
--   Stunned / Pinned / Quieted are timed overrides.
-- Types (Config/Enemies): Drifter, Bellwether (hums to alert others), Tidewalker (tank).
-- Encounter behaviours: `objective` (walk to and attack the signal lantern) and `hunt`
-- (periodically told roughly where the players are).
-- Replicated model attributes: State, Target (UserId), Sus_<UserId>, Type, HP (0..1).
local PathfindingService = game:GetService("PathfindingService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local EnemyConfig = require(Shared.Config.Enemies)
local AssetIds = require(Shared.Config.AssetIds)
local MeshKit = require(Shared.MeshKit)
local Geometry = require(Shared.Util.Geometry)
local Sfx = require(Shared.Util.Sfx)
local Net = require(Shared.Net)

local EnemyService = {}
local Services

local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local folder
local enemies = {}
local byModel = {}
local fireZones = {}
local rng = Random.new()
local occlusionParams = RaycastParams.new()
occlusionParams.FilterType = Enum.RaycastFilterType.Exclude

-- Model -----------------------------------------------------------------------------------

local RAG_COLORS = {
	Color3.fromRGB(70, 66, 58), Color3.fromRGB(58, 64, 70), Color3.fromRGB(86, 70, 52),
	Color3.fromRGB(64, 58, 66), Color3.fromRGB(92, 88, 78), Color3.fromRGB(54, 60, 52),
}

-- Builds a jointed body (Motor6D skeleton) so clients can animate it procedurally:
--   Root -> Torso (Waist) -> Head (Neck), UpperArms (Shoulders) -> LowerArms (Elbows)
--   Root -> UpperLegs (Hips) -> LowerLegs (Knees)
-- Each type gets its own proportions, head shape, salt-crust growths and clothing rags.
local function buildModel(position, typeName, cfg)
	local k = cfg.scale
	local body = cfg.body
	local model = Instance.new("Model")
	model.Name = "Hushed_" .. typeName

	local legLen = 1.6 * body.legs
	-- legs end 0.2 + 2*legLen below the root centre; the root's bottom is 1 below it
	local hipHeight = (legLen * 2 - 0.8) * k
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1) * k
	root.Transparency = 1
	root.CanCollide = true
	root.CFrame = CFrame.new(position + Vector3.new(0, hipHeight + 1 * k, 0))
	root.Name = "HumanoidRootPart"
	root.Parent = model
	model.PrimaryPart = root

	local base = cfg.color
	local function part(name, size, color, material, shape)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size * k
		p.Color = color or base
		p.Material = material or Enum.Material.SmoothPlastic
		if not material then
			p.Reflectance = 0.06 -- wet, charred skin
		end
		p.CanCollide = false
		p.CanTouch = false
		p.Massless = true
		if shape then
			p.Shape = shape
		end
		p.CFrame = root.CFrame
		p.Parent = model
		return p
	end
	local function joint(name, part0, part1, c0, c1)
		local m = Instance.new("Motor6D")
		m.Name = name
		m.Part0 = part0
		m.Part1 = part1
		m.C0 = CFrame.new(c0.Position * k) * c0.Rotation
		m.C1 = CFrame.new(c1.Position * k) * c1.Rotation
		m.Parent = part0
		return m
	end
	local function attach(name, target, size, offset, color, material, shape)
		local p = part(name, size, color, material, shape)
		local w = Instance.new("Weld")
		w.Part0 = target
		w.Part1 = p
		w.C0 = CFrame.new(offset.Position * k) * offset.Rotation
		w.Parent = p
		return p
	end

	local tw = body.torso
	local torso = part("Torso", Vector3.new(1.5 * tw, 2.0, 0.85 * tw))
	joint("Waist", root, torso, CFrame.new(0, 0.3, 0) * CFrame.Angles(math.rad(-body.hunch), 0, 0), CFrame.new(0, -1.0, 0))

	local CRUST = Color3.fromRGB(232, 228, 216)
	local headColor = body.head == "shell" and CRUST or Color3.new(math.min(1, base.R * 1.15), math.min(1, base.G * 1.15), math.min(1, base.B * 1.15))
	local headSize = ({
		round = Vector3.new(1.0, 1.25, 1.0),
		half = Vector3.new(0.95, 1.2, 0.95),
		shell = Vector3.new(1.55, 1.5, 1.55),
		disc = Vector3.new(1.5, 0.95, 1.5),
		sunk = Vector3.new(1.05, 1.05, 1.05),
	})[body.head] or Vector3.new(1, 1.25, 1)
	local head = part("Head", headSize, headColor, body.head == "shell" and Enum.Material.Sand or nil)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = head
	local neckY = body.head == "sunk" and 0.75 or 1.0
	joint("Neck", torso, head, CFrame.new(0, neckY, -0.1), CFrame.new(0, -headSize.Y * 0.5 + 0.1, 0.1))
	if body.head == "half" then
		-- salt has sealed half the face
		attach("FaceCrust", head, Vector3.new(0.55, 0.9, 0.5), CFrame.new(0.25, 0.05, -0.32), Color3.fromRGB(232, 228, 216), Enum.Material.Sand, Enum.PartType.Ball)
	end

	local armLen = 1.5 * body.arms
	for _, side in { -1, 1 } do
		local name = side < 0 and "Left" or "Right"
		local upper = part(name .. "UpperArm", Vector3.new(0.42 * tw, armLen, 0.42 * tw))
		local lower = part(name .. "LowerArm", Vector3.new(0.38 * tw, armLen * 1.07, 0.38 * tw))
		joint(name .. "Shoulder", torso, upper, CFrame.new(side * (0.75 * tw + 0.2), 0.85, 0) * CFrame.Angles(math.rad(8), 0, math.rad(side * 4)), CFrame.new(0, armLen * 0.5, 0))
		joint(name .. "Elbow", upper, lower, CFrame.new(0, -armLen * 0.5, 0), CFrame.new(0, armLen * 0.535, 0))
		local upperLeg = part(name .. "UpperLeg", Vector3.new(0.56 * tw, legLen, 0.56 * tw))
		local lowerLeg = part(name .. "LowerLeg", Vector3.new(0.5 * tw, legLen, 0.5 * tw))
		joint(name .. "Hip", root, upperLeg, CFrame.new(side * 0.42 * tw, -0.2, 0), CFrame.new(0, legLen * 0.5, 0))
		joint(name .. "Knee", upperLeg, lowerLeg, CFrame.new(0, -legLen * 0.5, 0), CFrame.new(0, legLen * 0.5, 0))
	end

	-- what's left of their clothes: rags over torso and thighs
	local rng = Random.new()
	local ragColor = RAG_COLORS[rng:NextInteger(1, #RAG_COLORS)]
	for i = 1, body.rags do
		local onLeg = i % 2 == 0
		local target = onLeg and model[(rng:NextNumber() < 0.5 and "Left" or "Right") .. "UpperLeg"] or torso
		local size = onLeg and Vector3.new(0.62 * tw, 0.9, 0.62 * tw) or Vector3.new(1.55 * tw, rng:NextNumber(0.5, 1.1), 0.9 * tw)
		local offset = onLeg and CFrame.new(0, rng:NextNumber(-0.2, 0.4), 0) or CFrame.new(0, rng:NextNumber(-0.6, 0.6), 0) * CFrame.Angles(0, 0, math.rad(rng:NextNumber(-10, 10)))
		attach("Rag" .. i, target, size, offset, ragColor, Enum.Material.Fabric)
	end

	-- the maw: a black, gaping hollow where the face was (clients open it when they hunt)
	if body.maw then
		local maw = attach("Maw", head, Vector3.new(headSize.X * 0.42, headSize.Y * 0.36, 0.3), CFrame.new(0, -headSize.Y * 0.12, -headSize.Z * 0.42), Color3.fromRGB(8, 6, 6), Enum.Material.SmoothPlastic)
		local mm = Instance.new("SpecialMesh")
		mm.MeshType = Enum.MeshType.Sphere
		mm.Parent = maw
	end
	-- jagged salt spines out of the back and shoulders
	for i = 1, body.spines or 0 do
		local w = Instance.new("WedgePart")
		w.Name = "Spine" .. i
		local len = rng:NextNumber(0.5, 1.3)
		w.Size = Vector3.new(0.18, len, rng:NextNumber(0.3, 0.6)) * k
		w.Color = CRUST
		w.Material = Enum.Material.Sand
		w.CanCollide = false
		w.CanTouch = false
		w.Massless = true
		w.CFrame = torso.CFrame
		w.Parent = model
		local weld = Instance.new("Weld")
		weld.Part0 = torso
		weld.Part1 = w
		weld.C0 = CFrame.new(rng:NextNumber(-0.6, 0.6) * torso.Size.X / 2, rng:NextNumber(-0.2, 0.9) * torso.Size.Y / 2, torso.Size.Z / 2 + len * 0.3 * k)
			* CFrame.Angles(math.rad(rng:NextNumber(20, 60)), math.rad(rng:NextNumber(-30, 30)), math.rad(rng:NextNumber(-25, 25)))
		weld.Parent = w
	end
	-- salt growths: lumpy crust on shoulders, back and head
	local spots = { torso, torso, head, model.LeftUpperArm, model.RightUpperArm }
	for i = 1, body.crust do
		local target = spots[(i - 1) % #spots + 1]
		local r = rng:NextNumber(0.25, 0.6) * (target == torso and 1.4 or 1)
		local offset = CFrame.new(rng:NextNumber(-0.5, 0.5) * target.Size.X / k, rng:NextNumber(-0.3, 0.5) * target.Size.Y / k, (target == head and -1 or 1) * rng:NextNumber(0.2, 0.5) * target.Size.Z / k)
		attach("Crust" .. i, target, Vector3.new(r, r * rng:NextNumber(0.7, 1.2), r), offset, CRUST, Enum.Material.Sand, Enum.PartType.Ball)
	end

	local drift = Instance.new("ParticleEmitter")
	drift.Rate = 3 + body.crust * 0.5
	drift.Lifetime = NumberRange.new(2, 3)
	drift.Speed = NumberRange.new(0.4, 1.2)
	drift.SpreadAngle = Vector2.new(180, 180)
	drift.Acceleration = Vector3.new(0, 0.8, 0)
	drift.Color = ColorSequence.new(base)
	drift.LightInfluence = 1
	drift.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.12 * k), NumberSequenceKeypoint.new(1, 0) })
	drift.Parent = torso

	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15 -- R15 so HipHeight (not leg parts) sets floor height
	humanoid.HipHeight = hipHeight
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.WalkSpeed = 5
	humanoid.UseJumpPower = true
	humanoid.JumpPower = 0
	humanoid.AutoJumpEnabled = false
	humanoid.RequiresNeck = false
	humanoid.BreakJointsOnDeath = false
	humanoid.Parent = model
	for _, st in {
		Enum.HumanoidStateType.Climbing,
		Enum.HumanoidStateType.FallingDown,
		Enum.HumanoidStateType.Ragdoll,
		Enum.HumanoidStateType.Seated,
		Enum.HumanoidStateType.Jumping,
	} do
		humanoid:SetStateEnabled(st, false)
	end
	model:SetAttribute("Type", typeName)
	model:SetAttribute("Gait", cfg.gait or "shamble")
	model:SetAttribute("HP", 1)
	return model, humanoid, root, head
end

-- Helpers ---------------------------------------------------------------------------------

local function setState(e, newState)
	if e.state == newState then
		return
	end
	e.state = newState
	e.stateTime = os.clock()
	e.waypoints = nil
	e.pathGoal = nil
	e.searchPoint = nil
	e.model:SetAttribute("State", newState)
end

local function face(e, position)
	local pos = e.root.Position
	local flatTarget = Vector3.new(position.X, pos.Y, position.Z)
	if (flatTarget - pos).Magnitude < 0.1 then
		return
	end
	e.root.CFrame = e.root.CFrame:Lerp(CFrame.lookAt(pos, flatTarget), 0.3)
end

local function stop(e)
	e.humanoid.WalkSpeed = 0
	e.humanoid:MoveTo(e.root.Position)
end

local function computePath(e, goal)
	e.computing = true
	e.lastPathTime = os.clock()
	local start = e.root.Position
	task.spawn(function()
		local ok = pcall(function()
			e.path:ComputeAsync(start, goal)
		end)
		e.computing = false
		if e.dead then
			return
		end
		if ok and e.path.Status == Enum.PathStatus.Success then
			e.waypoints = e.path:GetWaypoints()
			e.wpIndex = math.min(2, #e.waypoints)
		else
			e.waypoints = nil
		end
		e.pathGoal = goal
	end)
end

local function moveTo(e, goal, speed)
	local now = os.clock()
	local pos = e.root.Position
	e.humanoid.WalkSpeed = speed
	if Geometry.flatDistance(pos, goal) < 2.5 then
		e.humanoid:MoveTo(pos)
		return true
	end
	local goalChanged = not e.pathGoal or Geometry.flatDistance(e.pathGoal, goal) > 4
	if not e.computing and (goalChanged or now - e.lastPathTime > 4) then
		computePath(e, goal)
	end
	local target = goal
	if e.waypoints and e.pathGoal and Geometry.flatDistance(e.pathGoal, goal) <= 4 then
		local wp = e.waypoints[e.wpIndex]
		while wp and e.wpIndex < #e.waypoints and Geometry.flatDistance(pos, wp.Position) < 2.2 do
			e.wpIndex += 1
			wp = e.waypoints[e.wpIndex]
		end
		if wp then
			target = wp.Position
		end
	end
	e.humanoid:MoveTo(target)
	if now - e.progressTime > 2 then
		if (pos - e.progressPos).Magnitude < 1 then
			e.pathGoal = nil
			e.lastPathTime = 0
		end
		e.progressPos = pos
		e.progressTime = now
	end
	return false
end

local function findInfo(list, player)
	for _, info in list do
		if info.player == player then
			return info
		end
	end
	return nil
end

local function publishSuspicion(e, active)
	for _, info in active do
		local value = math.floor((e.suspicion[info.player] or 0) * 20 + 0.5) / 20
		local key = "Sus_" .. info.player.UserId
		if e.model:GetAttribute(key) ~= value then
			e.model:SetAttribute(key, value)
		end
	end
	local targetId = e.target and e.target.UserId or 0
	if e.model:GetAttribute("Target") ~= targetId then
		e.model:SetAttribute("Target", targetId)
	end
end

local function alertTo(e, player)
	if e.dead or e.state == "Quieted" then
		return
	end
	e.suspicion[player] = math.max(e.suspicion[player] or 0, e.cfg.alertThreshold)
end

local function hum(e, now)
	local h = e.cfg.hum
	if not h or now < (e.nextHum or 0) or not e.target then
		return
	end
	e.nextHum = now + h.cooldown
	Sfx.at(e.root.Position, "Hum", 0.8, h.radius * 2)
	Net.notifyAll("Hum", { position = e.root.Position, radius = h.radius })
	Services.PerceptionService.emitNoise(e.root.Position, h.radius, "hum", e.target)
end

-- Human combat --------------------------------------------------------------------------------

local shotParams = RaycastParams.new()
shotParams.FilterType = Enum.RaycastFilterType.Exclude

local function humanAttack(e, info, dist, seen, now)
	local cfg, atk = e.cfg, e.cfg.attack
	if now - (e.lastSeen[e.target] or 0) > cfg.loseSightTime then
		e.suspicion[e.target] = 0.6
		e.target = nil
		e.searchOrigin = e.lastKnown
		setState(e, "Search")
		return
	end
	if atk.kind == "melee" then
		if dist <= atk.range then
			stop(e)
			face(e, info.root.Position)
			if now >= (e.nextShotAt or 0) then
				e.nextShotAt = now + atk.fireDelay
				e.model:SetAttribute("AttackAt", workspace:GetServerTimeNow())
				task.delay(0.25, function()
					if not e.dead and info.root.Parent and (info.root.Position - e.root.Position).Magnitude <= atk.range + 1 then
						Services.CharacterService.damage(info.player, atk.damage, e.root.Position)
						Sfx.at(info.root.Position, "MeleeHit", 0.7, 50)
					end
				end)
				Sfx.at(e.root.Position, "Swing", 0.6, 40)
			end
		elseif seen then
			e.humanoid.WalkSpeed = cfg.chaseSpeed
			e.humanoid:MoveTo(info.root.Position)
		else
			moveTo(e, e.lastKnown, cfg.chaseSpeed)
		end
		return
	end
	-- ranged: hold position and fire while in sight and range, otherwise close in
	if seen and dist <= atk.range then
		stop(e)
		face(e, info.root.Position)
		e.model:SetAttribute("Aiming", true)
		if now >= (e.nextShotAt or 0) then
			e.nextShotAt = now + atk.fireDelay * (0.8 + rng:NextNumber() * 0.5)
			local muzzle = e.head.Position + e.root.CFrame.LookVector * 1.2 - Vector3.new(0, 0.4, 0)
			local char = info.char
			local chance = atk.accuracy * math.clamp(1.15 - dist / atk.range * 0.7, 0.2, 1)
			if char:GetAttribute("Stance") == "Crouch" then
				chance *= 0.75
			end
			if info.root.AssemblyLinearVelocity.Magnitude > 14 then
				chance *= 0.7
			end
			local aim = info.root.Position + Vector3.new(0, 0.8, 0)
			local hit = rng:NextNumber() < chance
			if not hit then
				aim += Vector3.new(rng:NextNumber(-3, 3), rng:NextNumber(-1, 2), rng:NextNumber(-3, 3))
			end
			shotParams.FilterDescendantsInstances = { folder }
			local result = Workspace:Raycast(muzzle, (aim - muzzle).Unit * (atk.range + 10), shotParams)
			local hitPos = result and result.Position or aim
			local hitPlayer = result and result.Instance:IsDescendantOf(char)
			if hitPlayer then
				Services.CharacterService.damage(info.player, atk.damage, nil)
			end
			Net.notifyAll("Shot", { shooter = 0, weapon = atk.weapon, from = muzzle, hits = { { position = hitPos, kind = hitPlayer and "none" or "world" } }, quiet = atk.noise < 20 })
			Services.PerceptionService.emitNoise(e.root.Position, atk.noise, "gunshot", nil)
		end
	else
		e.model:SetAttribute("Aiming", false)
		if seen then
			e.humanoid.WalkSpeed = cfg.chaseSpeed
			e.humanoid:MoveTo(info.root.Position)
		else
			moveTo(e, e.lastKnown, cfg.chaseSpeed)
		end
	end
end

-- Brain -----------------------------------------------------------------------------------

local function update(e, dt, now, active)
	local cfg = e.cfg

	if now < e.stunUntil then
		stop(e)
		publishSuspicion(e, active)
		return
	elseif e.state == "Stunned" or e.state == "Pinned" then
		if e.net then
			e.net:Destroy()
			e.net = nil
		end
		setState(e, e.investigatePos and "Investigate" or "Search")
		e.searchOrigin = e.root.Position
	end

	local bestPlayer, bestSus = nil, 0
	for _, info in active do
		local p = info.player
		local sus = e.suspicion[p] or 0
		local vis = Services.PerceptionService.sightFactor(e, info)
		if vis > 0 then
			sus += vis * cfg.suspicionGain * dt
			e.lastSeen[p] = now
			if sus >= cfg.investigateThreshold then
				e.investigatePos = info.root.Position
			end
		elseif not (e.state == "Chase" and e.target == p) then
			sus -= cfg.suspicionDecay * dt
		end
		sus = math.clamp(sus, 0, 1.2)
		e.suspicion[p] = sus
		if sus > bestSus then
			bestPlayer, bestSus = p, sus
		end
	end
	for p in e.suspicion do
		if not findInfo(active, p) then
			e.suspicion[p] = nil
		end
	end

	if e.state ~= "Chase" and bestPlayer and bestSus >= cfg.alertThreshold then
		e.target = bestPlayer
		e.lastKnown = findInfo(active, bestPlayer).root.Position
		e.lastSeen[bestPlayer] = e.lastSeen[bestPlayer] or now
		setState(e, "Chase")
		Services.MatchService.onSpotted(bestPlayer, e)
		if cfg.callout and now > (e.nextCallout or 0) then
			-- radio / bell: everyone nearby converges on the spotted player
			e.nextCallout = now + 10
			Sfx.at(e.root.Position, cfg.callout, 0.9, 140)
			Services.PerceptionService.emitNoise(e.lastKnown, 70, "callout", bestPlayer)
		end
	end

	if e.state == "Chase" then
		hum(e, now)
		local info = e.target and findInfo(active, e.target)
		if not info then
			e.target = nil
			e.searchOrigin = e.lastKnown or e.root.Position
			setState(e, "Search")
		else
			local seenRecently = now - (e.lastSeen[e.target] or 0) < 0.35
			if seenRecently then
				e.lastKnown = info.root.Position
			end
			local dist = (info.root.Position - e.root.Position).Magnitude
			if cfg.attack then
				humanAttack(e, info, dist, seenRecently, now)
				publishSuspicion(e, active)
				return
			end
			if dist <= cfg.grabRange and now >= e.recoverUntil then
				e.recoverUntil = now + cfg.grabRecover
				if not Services.ActionService.trySpikeCounter(info.player, e) then
					Services.CharacterService.damage(info.player, cfg.grabDamage, e.root.Position)
				end
			end
			if e.dead then
				return
			end
			if now < e.recoverUntil - cfg.grabRecover + 0.9 then
				stop(e)
			elseif now - (e.lastSeen[e.target] or 0) > cfg.loseSightTime then
				e.suspicion[e.target] = 0.6
				e.target = nil
				e.searchOrigin = e.lastKnown
				setState(e, "Search")
			elseif seenRecently and dist < 35 then
				e.humanoid.WalkSpeed = cfg.chaseSpeed
				e.humanoid:MoveTo(info.root.Position)
			else
				moveTo(e, e.lastKnown, cfg.chaseSpeed)
			end
		end
		publishSuspicion(e, active)
		return
	end

	if e.investigatePos and e.state ~= "Investigate" then
		setState(e, "Investigate")
	end

	if e.state == "Investigate" then
		if not e.investigatePos then
			setState(e, "Search")
		elseif bestSus >= cfg.noticeThreshold and bestSus < cfg.investigateThreshold and bestPlayer then
			stop(e)
			face(e, findInfo(active, bestPlayer).root.Position)
		elseif moveTo(e, e.investigatePos, (cfg.rushToNoise and os.clock() - (e.heardAt or 0) < 3) and cfg.chaseSpeed or cfg.investigateSpeed) then
			e.searchOrigin = e.investigatePos
			e.investigatePos = nil
			setState(e, "Search")
		end
	elseif e.state == "Search" then
		if now - e.stateTime > cfg.searchTime then
			setState(e, "Patrol")
		elseif e.searchPoint then
			if moveTo(e, e.searchPoint, cfg.patrolSpeed + 1.5) then
				e.searchPoint = nil
				e.searchPause = now + 1.2
			end
		elseif now >= (e.searchPause or 0) then
			local origin = e.searchOrigin or e.root.Position
			e.searchPoint = origin + Vector3.new(rng:NextNumber(-14, 14), 0, rng:NextNumber(-14, 14))
		else
			stop(e)
			face(e, e.root.Position + e.root.CFrame.RightVector * (rng:NextNumber() < 0.5 and -4 or 4))
		end
	else -- Patrol (or objective)
		if bestPlayer and bestSus >= cfg.noticeThreshold then
			stop(e)
			face(e, findInfo(active, bestPlayer).root.Position)
		elseif e.objective then
			if moveTo(e, e.objective, cfg.investigateSpeed) or (e.root.Position - e.objective).Magnitude < 6 then
				stop(e)
				face(e, e.objective)
				Services.MatchService.onObjectiveAttacked(e.objectiveDps * dt)
			end
		else
			local waypoint = e.route[e.routeIndex]
			if moveTo(e, waypoint, cfg.patrolSpeed) then
				e.routeIndex = e.routeIndex % #e.route + 1
			end
		end
	end

	publishSuspicion(e, active)
end

-- Public API ------------------------------------------------------------------------------

-- opts: { route = {Vector3...}, objective = Vector3, objectiveDps = n, hunt = bool, alertTo = Player }
function EnemyService.spawn(typeName, position, opts)
	opts = opts or {}
	local cfg = EnemyConfig.Types[typeName] or EnemyConfig.Types.Drifter
	local model, humanoid, root, head = buildModel(position, typeName, cfg)
	local kit = (cfg.human and "Faction_" or "Hushed_") .. typeName
	if Services.AssetService.hasKit(kit) then
		pcall(MeshKit.applyRig, model, Services.AssetService.meta(kit), Services.AssetService.part, "enemy", AssetIds.YawFix)
	end
	if cfg.flashlight then
		Services.CharacterService.addFlashlight(model, "Torso")
		Services.CharacterService.setFlashlight(model, true)
	end
	model:SetAttribute("Human", cfg.human == true)
	model.Parent = folder
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	local route = opts.route or { position }
	local e = {
		model = model,
		humanoid = humanoid,
		root = root,
		head = head,
		typeName = typeName,
		cfg = cfg,
		hp = cfg.hp,
		fovCos = math.cos(math.rad(cfg.fovDeg / 2)),
		route = route,
		routeIndex = rng:NextInteger(1, #route),
		objective = opts.objective,
		objectiveDps = opts.objectiveDps or 0,
		hunt = opts.hunt == true,
		path = PathfindingService:CreatePath({
			AgentRadius = 2 * cfg.scale,
			AgentHeight = 7 * cfg.scale,
			AgentCanJump = false,
			WaypointSpacing = 6,
		}),
		lastPathTime = 0,
		progressPos = root.Position,
		progressTime = os.clock(),
		stunUntil = 0,
		recoverUntil = 0,
		suspicion = {},
		lastSeen = {},
		state = "",
		stateTime = os.clock(),
	}
	setState(e, "Patrol")
	table.insert(enemies, e)
	byModel[model] = e
	return e
end

-- Weighted pick from { Type = weight }.
function EnemyService.pickType(weights)
	local total = 0
	for _, w in weights do
		total += w
	end
	local roll = rng:NextNumber() * total
	for typeName, w in weights do
		roll -= w
		if roll <= 0 then
			return typeName
		end
	end
	return "Drifter"
end

function EnemyService.clear()
	for _, e in enemies do
		e.dead = true
		e.model:Destroy()
	end
	table.clear(enemies)
	table.clear(byModel)
	table.clear(fireZones)
end

function EnemyService.count()
	return #enemies
end

function EnemyService.fromInstance(instance)
	local model = instance and instance:FindFirstAncestorOfClass("Model")
	while model and not byModel[model] do
		model = model.Parent and model.Parent:FindFirstAncestorOfClass("Model")
	end
	return model and byModel[model] or nil
end

function EnemyService.getAll()
	return enemies
end

function EnemyService.findNear(position, radius)
	local found = {}
	for _, e in enemies do
		if not e.dead then
			local d = (e.root.Position - position).Magnitude
			if d <= radius then
				table.insert(found, { enemy = e, distance = d })
			end
		end
	end
	table.sort(found, function(a, b)
		return a.distance < b.distance
	end)
	return found
end

function EnemyService.stun(e, duration, byPlayer, newState)
	if e.dead then
		return
	end
	e.stunUntil = math.max(e.stunUntil, os.clock() + duration)
	if byPlayer then
		e.suspicion[byPlayer] = math.max(e.suspicion[byPlayer] or 0, 0.6)
		local char = byPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if root then
			e.investigatePos = root.Position
		end
	end
	if e.state == "Chase" then
		e.target = nil
	end
	setState(e, newState or "Stunned")
	stop(e)
end

function EnemyService.pin(e, duration)
	EnemyService.stun(e, duration, nil, "Pinned")
	local net = Instance.new("Part")
	net.Name = "Net"
	net.Size = Vector3.new(3.4, 7.4, 2.4) * e.cfg.scale
	net.CFrame = e.root.CFrame * CFrame.new(0, -0.6, 0)
	net.Material = Enum.Material.Fabric
	net.Color = Color3.fromRGB(150, 130, 90)
	net.Transparency = 0.55
	net.CanCollide = false
	net.CanQuery = false
	net.Massless = true
	net.Parent = e.model
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = e.root
	weld.Part1 = net
	weld.Parent = net
	e.net = net
end

function EnemyService.canQuiet(e, playerPosition)
	if e.dead or not e.cfg.quietable or e.state == "Chase" or e.state == "Quieted" then
		return false
	end
	if e.state == "Stunned" or e.state == "Pinned" then
		return true
	end
	local toPlayer = Geometry.flat(playerPosition - e.root.Position)
	if toPlayer.Magnitude < 0.01 then
		return true
	end
	return e.root.CFrame.LookVector:Dot(toPlayer.Unit) < -0.2
end

function EnemyService.disperse(e, byPlayer)
	if e.dead then
		return
	end
	e.dead = true
	byModel[e.model] = nil
	local index = table.find(enemies, e)
	if index then
		table.remove(enemies, index)
	end
	e.model:SetAttribute("State", "Dispersed")
	e.model:SetAttribute("HP", 0)
	e.root.Anchored = true
	if e.cfg.human then
		-- people are knocked down, not turned to salt
		e.model:SetAttribute("State", "Down")
		Services.CharacterService.setFlashlight(e.model, false)
		Services.MatchService.onEnemyKilled(byPlayer, e)
		local model = e.model
		task.delay(8, function()
			for _, part in model:GetDescendants() do
				if part:IsA("BasePart") then
					TweenService:Create(part, TweenInfo.new(1.5), { Transparency = 1 }):Play()
				end
			end
			task.wait(1.6)
			model:Destroy()
		end)
		return
	end

	local attachment = Instance.new("Attachment")
	attachment.Position = Vector3.new(0, 0.8, 0)
	attachment.Parent = e.root
	local burst = Instance.new("ParticleEmitter")
	burst.Texture = SMOKE
	burst.Rate = 0
	burst.Lifetime = NumberRange.new(1.4, 2.4)
	burst.Speed = NumberRange.new(3, 8)
	burst.SpreadAngle = Vector2.new(180, 180)
	burst.Drag = 3
	burst.Acceleration = Vector3.new(0, 2.5, 0)
	burst.Color = ColorSequence.new(e.cfg.color)
	burst.LightInfluence = 1
	burst.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1 * e.cfg.scale), NumberSequenceKeypoint.new(1, 4 * e.cfg.scale) })
	burst.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
	burst.Parent = attachment
	burst:Emit(70)

	for _, part in e.model:GetDescendants() do
		if part:IsA("BasePart") and part ~= e.root then
			TweenService:Create(part, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Transparency = 1 }):Play()
		elseif part:IsA("ParticleEmitter") and part ~= burst then
			part.Enabled = false
		end
	end
	Sfx.at(e.root.Position, "Quieting", 0.5, 60)
	Services.MatchService.onEnemyKilled(byPlayer, e)
	local model = e.model
	task.delay(2.6, function()
		model:Destroy()
	end)
end

-- Weapon / explosive / fire damage. Returns true if this killed it.
function EnemyService.damage(e, amount, byPlayer, headshot)
	if e.dead or amount <= 0 then
		return false
	end
	e.hp -= amount
	e.model:SetAttribute("HP", math.max(0, e.hp / e.cfg.hp))
	if e.hp <= 0 then
		EnemyService.disperse(e, byPlayer)
		return true
	end
	-- stagger, and being shot always alerts it to the shooter
	local stagger = e.cfg.staggerTime * (headshot and 2 or 1)
	if stagger > 0.05 and e.state ~= "Quieted" then
		e.stunUntil = math.max(e.stunUntil, os.clock() + stagger)
	end
	if byPlayer then
		alertTo(e, byPlayer)
		local char = byPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if root then
			e.lastKnown = root.Position
			e.investigatePos = root.Position
		end
	end
	return false
end

function EnemyService.explode(position, radius, damage, byPlayer)
	for _, entry in EnemyService.findNear(position, radius) do
		local falloff = 1 - (entry.distance / radius) * 0.6
		local e = entry.enemy
		if not EnemyService.damage(e, damage * falloff, byPlayer, false) then
			EnemyService.stun(e, 2, byPlayer)
		end
	end
end

function EnemyService.addFireZone(position, radius, duration, dps, byPlayer)
	table.insert(fireZones, { position = position, radius = radius, untilTime = os.clock() + duration, dps = dps, player = byPlayer })
end

-- Tell hunters roughly where the players are.
function EnemyService.huntPulse(active)
	if #active == 0 then
		return
	end
	for _, e in enemies do
		if e.hunt and not e.dead and e.state ~= "Chase" then
			local info = active[rng:NextInteger(1, #active)]
			e.investigatePos = info.root.Position + Vector3.new(rng:NextNumber(-10, 10), 0, rng:NextNumber(-10, 10))
		end
	end
end

function EnemyService.onNoise(event)
	for _, e in enemies do
		if not e.dead and e.state ~= "Chase" and e.state ~= "Quieted" and os.clock() >= e.stunUntil then
			local eyes = e.head.Position
			local dist = (event.position - eyes).Magnitude
			local radius = event.radius * (e.cfg.hearingMult or 1)
			if dist <= radius then
				local hit = Workspace:Raycast(eyes, event.position - eyes, occlusionParams)
				if hit and (hit.Position - event.position).Magnitude > 3 then
					radius *= 0.5
				end
				if dist <= radius then
					local loud = 1 - dist / radius
					if event.player then
						local footstep = event.kind == "footstep"
						local add = (footstep and 0.08 or 0.3) + loud * (footstep and 0.3 or 0.6)
						if event.kind == "gunshot" or event.kind == "hum" then
							add += 0.5
						end
						e.suspicion[event.player] = math.min(1.2, (e.suspicion[event.player] or 0) + add)
					end
					e.investigatePos = event.position
					e.heardAt = os.clock()
					if loud > 0.15 and event.kind ~= "footstep" then
						e.model:SetAttribute("Heard", os.clock()) -- clients show a "?" and turn the head
					end
				end
			end
		end
	end
end

local function tickFire(dt, now)
	for i = #fireZones, 1, -1 do
		local zone = fireZones[i]
		if now > zone.untilTime then
			table.remove(fireZones, i)
		else
			for _, entry in EnemyService.findNear(zone.position, zone.radius) do
				EnemyService.damage(entry.enemy, zone.dps * dt, zone.player, false)
			end
		end
	end
end

function EnemyService.init(registry)
	Services = registry
end

function EnemyService.start()
	folder = Instance.new("Folder")
	folder.Name = "Enemies"
	folder.Parent = Workspace
	occlusionParams.FilterDescendantsInstances = { folder }
	Services.PerceptionService.setEnemyFolder(folder)

	local step = 1 / EnemyConfig.TickRate
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < step then
			return
		end
		accumulator = 0
		if Services.MatchService.state ~= "Encounter" then
			return
		end
		local now = os.clock()
		local active = Services.MatchService.getActivePlayers()
		tickFire(step, now)
		for i = #enemies, 1, -1 do
			local e = enemies[i]
			if e and not e.dead then
				local ok, err = pcall(update, e, step, now, active)
				if not ok then
					warn("[EnemyService] brain error: " .. tostring(err))
				end
			end
		end
	end)
end

return EnemyService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002B"><Properties><string name="Name">HomebaseService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The Meridian as a homebase that persists between crossings:
--   * Repairs bought with Scrip (earned only by playing) unlock permanent bonuses and change
--     how the ferry looks (deck lights, generator, radio mast, sick bay, armory rack).
--   * Armory: pick your long gun before a crossing (once the rack is repaired).
--   * Settings (graphics mode, sensitivity) are saved with your profile.
-- Also routes every ferry menu Request from clients to the right service.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Upgrades = require(Shared.Config.Upgrades)
local Weapons = require(Shared.Config.Weapons)
local Net = require(Shared.Net)

local HomebaseService = {}
local Services

local GRAPHICS = { Auto = true, Performance = true, Balanced = true, Cinematic = true }

local function toast(player, text)
	Net.notify(player, "Toast", { text = text })
end

-- Bonuses applied when this player starts a crossing.
function HomebaseService.bonusesFor(player)
	local has = function(id)
		return Services.PlayerDataService.hasRepair(player, id)
	end
	local bonus = { salvage = 0, items = {} }
	if has("generator") then
		bonus.salvage += 15
	end
	if has("sickbay") then
		bonus.items.dressing = 1
	end
	local choice = player:GetAttribute("LongGunChoice")
	if has("armory") and type(choice) == "string" and Weapons.List[choice] and Weapons.List[choice].slot == "long" then
		bonus.longGun = choice
	end
	return bonus
end

-- A repair is "visible" on the shared ferry if anyone in the server owns it.
function HomebaseService.anyoneHas(repairId)
	for _, p in Players:GetPlayers() do
		if Services.PlayerDataService.hasRepair(p, repairId) then
			return true
		end
	end
	return false
end

function HomebaseService.refreshVisuals()
	local owned = {}
	for _, r in Upgrades.Repairs do
		owned[r.id] = HomebaseService.anyoneHas(r.id)
	end
	Services.MapService.setFerryRepairs(owned)
end

local function repair(player, repairId)
	if type(repairId) ~= "string" then
		return
	end
	for _, r in Upgrades.Repairs do
		if r.id == repairId then
			if Services.PlayerDataService.hasRepair(player, repairId) then
				return
			end
			if not Services.PlayerDataService.spendScrip(player, r.cost) then
				toast(player, ("Need %d Scrip. Earn it by clearing encounters."):format(r.cost))
				return
			end
			Services.PlayerDataService.addRepair(player, repairId)
			task.spawn(Services.PlayerDataService.save, player)
			toast(player, "Repaired: " .. r.name)
			HomebaseService.refreshVisuals()
			return
		end
	end
end

local function setLongGun(player, weaponId)
	if type(weaponId) ~= "string" or not Weapons.List[weaponId] or Weapons.List[weaponId].slot ~= "long" then
		return
	end
	if not Services.PlayerDataService.hasRepair(player, "armory") then
		toast(player, "Repair the armory rack first")
		return
	end
	player:SetAttribute("LongGunChoice", weaponId)
	toast(player, "Next crossing you'll carry the " .. Weapons.List[weaponId].name)
end

local function saveSettings(player, settings)
	if type(settings) ~= "table" then
		return
	end
	local graphics = GRAPHICS[settings.graphics] and settings.graphics or "Auto"
	local sensitivity = tonumber(settings.sensitivity) or 1
	if sensitivity ~= sensitivity then
		sensitivity = 1
	end
	Services.PlayerDataService.setSettings(player, {
		graphics = graphics,
		sensitivity = math.clamp(sensitivity, 0.2, 3),
		reduceMotion = settings.reduceMotion == true,
	})
end

function HomebaseService.init(registry)
	Services = registry
end

function HomebaseService.start()
	local handlers = {
		ChooseRoute = function(player, a)
			Services.MatchService.chooseRoute(player, a)
		end,
		OpenChart = function(player)
			Services.MatchService.requestChart(player)
		end,
		BuyWeaponUpgrade = function(player, a, b)
			Services.WorkbenchService.buyWeapon(player, a, b)
		end,
		BuyGeneral = function(player, a)
			Services.WorkbenchService.buyGeneral(player, a)
		end,
		BuyPerk = function(player, a)
			Services.WorkbenchService.buyPerk(player, a)
		end,
		Repair = repair,
		SetLongGun = setLongGun,
		SaveSettings = saveSettings,
	}
	Net.onServer("Request", 8, function(player, kind, a, b)
		local handler = type(kind) == "string" and handlers[kind]
		if handler then
			handler(player, a, b)
		end
	end)
	Players.PlayerAdded:Connect(function(player)
		task.spawn(function()
			Services.PlayerDataService.waitFor(player, 20)
			HomebaseService.refreshVisuals()
		end)
	end)
	Players.PlayerRemoving:Connect(function()
		task.defer(HomebaseService.refreshVisuals)
	end)
	assert(HttpService)
end

return HomebaseService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002C"><Properties><string name="Name">InventoryService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The satchel: items, reserve ammo, two weapon slots (long gun + sidearm, with magazines)
-- and Salvage (run currency). Server-owned; replicated to the owner as player attributes:
--   Inv_<item>, Cap_<item>, W_long, W_longMag, W_sidearm, W_sidearmMag, Salvage
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Items = require(Shared.Config.Items)
local Weapons = require(Shared.Config.Weapons)
local Net = require(Shared.Net)
local Sfx = require(Shared.Util.Sfx)

local InventoryService = {}
local Services

local inventories = {} -- [Player] = { items = {}, weapons = { long = {id, mag}, sidearm = {id, mag} }, salvage = n }

local function runUpgrades(player)
	local session = Services.CharacterService.getSession(player)
	return session and session.run or nil
end

function InventoryService.cap(player, itemId)
	local def = Items.Items[itemId]
	if not def then
		return 0
	end
	local cap = def.cap
	local run = runUpgrades(player)
	local session = Services.CharacterService.getSession(player)
	if def.kind == "ammo" then
		if run and run.general.ammoPouch then
			cap = math.floor(cap * (1 + Items.CapBonus.ammoPouch))
		end
	elseif run and run.general.satchel then
		cap += Items.CapBonus.satchel
	end
	if def.kind == "throwable" and session and session.mods then
		cap += session.mods.throwCapBonus
	end
	return cap
end

function InventoryService.publish(player)
	local inv = inventories[player]
	if not inv then
		return
	end
	for _, itemId in Items.Order do
		player:SetAttribute("Inv_" .. itemId, inv.items[itemId] or 0)
		player:SetAttribute("Cap_" .. itemId, InventoryService.cap(player, itemId))
	end
	for _, slot in { "long", "sidearm" } do
		local w = inv.weapons[slot]
		player:SetAttribute("W_" .. slot, w and w.id or "")
		player:SetAttribute("W_" .. slot .. "Mag", w and w.mag or 0)
	end
	player:SetAttribute("Salvage", inv.salvage)
end

-- loadout = { weapons = {long, sidearm}, items = {...} }; bonus = { salvage, items, longGun }
function InventoryService.reset(player, loadout, mods, bonus)
	bonus = bonus or {}
	local inv = { items = {}, weapons = {}, salvage = bonus.salvage or 0 }
	for _, itemId in Items.Order do
		inv.items[itemId] = 0
	end
	inventories[player] = inv
	local long = bonus.longGun or loadout.weapons.long
	for slot, weaponId in { long = long, sidearm = loadout.weapons.sidearm } do
		if Weapons.List[weaponId] then
			inv.weapons[slot] = { id = weaponId, mag = Weapons.List[weaponId].mag }
		end
	end
	for itemId, amount in loadout.items do
		InventoryService.add(player, itemId, amount)
	end
	if bonus.items then
		for itemId, amount in bonus.items do
			InventoryService.add(player, itemId, amount)
		end
	end
	if mods and mods.ammoBonus > 0 then
		InventoryService.add(player, "pistolAmmo", mods.ammoBonus)
	end
	InventoryService.publish(player)
end

function InventoryService.has(player)
	return inventories[player] ~= nil
end

function InventoryService.count(player, itemId)
	local inv = inventories[player]
	return inv and inv.items[itemId] or 0
end

function InventoryService.add(player, itemId, amount)
	local inv = inventories[player]
	if not inv then
		return 0
	end
	if itemId == "salvage" then
		inv.salvage += amount
		InventoryService.publish(player)
		return amount
	end
	if not Items.Items[itemId] then
		return 0
	end
	local space = InventoryService.cap(player, itemId) - inv.items[itemId]
	local added = math.clamp(amount, 0, math.max(space, 0))
	inv.items[itemId] += added
	InventoryService.publish(player)
	return added
end

function InventoryService.take(player, itemId, amount)
	local inv = inventories[player]
	if not inv or (inv.items[itemId] or 0) < amount then
		return false
	end
	inv.items[itemId] -= amount
	InventoryService.publish(player)
	return true
end

function InventoryService.salvage(player)
	local inv = inventories[player]
	return inv and inv.salvage or 0
end

function InventoryService.spendSalvage(player, amount)
	local inv = inventories[player]
	if not inv or inv.salvage < amount then
		return false
	end
	inv.salvage -= amount
	InventoryService.publish(player)
	return true
end

function InventoryService.weapon(player, slot)
	local inv = inventories[player]
	return inv and inv.weapons[slot] or nil
end

function InventoryService.weaponSlots(player)
	local inv = inventories[player]
	return inv and inv.weapons or {}
end

function InventoryService.setMag(player, slot, mag)
	local w = InventoryService.weapon(player, slot)
	if w then
		w.mag = mag
		InventoryService.publish(player)
	end
end

-- Crafting -------------------------------------------------------------------------------

function InventoryService.recipeYield(player, recipe)
	local session = Services.CharacterService.getSession(player)
	local bonus = (recipe.perkYield and session and session.mods) and session.mods.craftYieldBonus or 0
	return recipe.amount + bonus
end

function InventoryService.canCraft(player, recipeId)
	local recipe = Items.Recipes[recipeId]
	local inv = inventories[player]
	if not recipe or not inv then
		return false, "Unknown recipe"
	end
	if inv.items[recipe.output] >= InventoryService.cap(player, recipe.output) then
		return false, Items.Items[recipe.output].name .. ": satchel full"
	end
	for itemId, amount in recipe.cost do
		if inv.items[itemId] < amount then
			return false, "Need " .. amount .. " " .. Items.Items[itemId].name
		end
	end
	return true
end

function InventoryService.craft(player, recipeId)
	local ok, reason = InventoryService.canCraft(player, recipeId)
	if not ok then
		return false, reason
	end
	local recipe = Items.Recipes[recipeId]
	for itemId, amount in recipe.cost do
		inventories[player].items[itemId] -= amount
	end
	InventoryService.add(player, recipe.output, InventoryService.recipeYield(player, recipe))
	return true
end

-- Pickups ----------------------------------------------------------------------------------

local function itemName(itemId)
	return itemId == "salvage" and "Salvage" or (Items.Items[itemId] and Items.Items[itemId].name or itemId)
end

-- Grants a list of { itemId, amount }; returns found-text list and leftovers that didn't fit.
function InventoryService.grantList(player, list)
	local found, leftovers = {}, {}
	for _, entry in list do
		local itemId, amount = entry[1], entry[2]
		local added = InventoryService.add(player, itemId, amount)
		if added > 0 then
			table.insert(found, added .. " " .. itemName(itemId))
		end
		if added < amount then
			table.insert(leftovers, { itemId, amount - added })
		end
	end
	return found, leftovers
end

function InventoryService.pickup(player, pickupPart, itemId, amount)
	if not pickupPart.Parent then
		return
	end
	local info = Services.MatchService.getActiveInfo(player)
	if not info or (info.root.Position - pickupPart.Position).Magnitude > 12 then
		return
	end
	amount = pickupPart:GetAttribute("Amount") or amount
	local added = InventoryService.add(player, itemId, amount)
	if added > 0 then
		Sfx.at(pickupPart.Position, "Pickup", 0.5, 25)
		local remaining = amount - added
		if remaining > 0 then
			pickupPart:SetAttribute("Amount", remaining)
		else
			pickupPart:Destroy()
		end
		Net.notify(player, "Toast", { text = "+" .. added .. " " .. itemName(itemId) })
	else
		Net.notify(player, "Toast", { text = itemName(itemId) .. ": satchel full" })
	end
end

InventoryService.itemName = itemName

function InventoryService.init(registry)
	Services = registry
end

function InventoryService.start()
	Players.PlayerRemoving:Connect(function(player)
		inventories[player] = nil
	end)
end

return InventoryService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002D"><Properties><string name="Name">LootService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Scavenging: searchable containers (drawers, lockers, toolboxes, ammo crates) that open
-- with a short animation, and loose items that glint in the fog. Loot is rolled from
-- Config/Loot tables (free, never paid). What doesn't fit your satchel is dropped on the
-- floor for a crewmate.
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Loot = require(Shared.Config.Loot)
local Items = require(Shared.Config.Items)
local Net = require(Shared.Net)
local Sfx = require(Shared.Util.Sfx)

local LootService = {}
local Services

local ITEM_COLORS = {
	part = Color3.fromRGB(176, 166, 140),
	ammo = Color3.fromRGB(196, 160, 70),
	consumable = Color3.fromRGB(190, 70, 60),
	throwable = Color3.fromRGB(80, 130, 100),
	tool = Color3.fromRGB(150, 150, 150),
	salvage = Color3.fromRGB(120, 112, 100),
}

local function part(parent, size, cframe, color, material, props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props then
		for k, v in props do
			p[k] = v
		end
	end
	p.Parent = parent
	return p
end

function LootService.roll(tableName, rolls, rng, pall)
	local entries = Loot.Tables[tableName]
	local total = 0
	for _, e in entries do
		total += e[2]
	end
	local extra = rng:NextNumber() < (pall - 1) * Loot.PallBonusRolls and 1 or 0
	local merged = {}
	for _ = 1, rolls + extra do
		local r = rng:NextNumber() * total
		for _, e in entries do
			r -= e[2]
			if r <= 0 then
				local amount = rng:NextInteger(e[3], e[4])
				merged[e[1]] = (merged[e[1]] or 0) + amount
				break
			end
		end
	end
	local list = {}
	for itemId, amount in merged do
		table.insert(list, { itemId, amount })
	end
	return list
end

function LootService.dropPickup(parent, position, itemId, amount)
	local kind = itemId == "salvage" and "salvage" or (Items.Items[itemId] and Items.Items[itemId].kind or "part")
	local p = part(parent, Vector3.new(0.9, 0.5, 0.7), CFrame.new(position + Vector3.new(0, 0.25, 0)) * CFrame.Angles(0, math.random() * 6.28, 0), ITEM_COLORS[kind], Enum.Material.SmoothPlastic, {
		Name = "Pickup_" .. itemId,
		CanCollide = false,
	})
	p:SetAttribute("Amount", amount)
	local glint = Instance.new("PointLight")
	glint.Range = 4
	glint.Brightness = 0.5
	glint.Color = Color3.fromRGB(255, 230, 190)
	glint.Parent = p
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Rate = 1.2
	sparkle.Lifetime = NumberRange.new(0.5, 0.8)
	sparkle.Speed = NumberRange.new(0, 0)
	sparkle.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.35), NumberSequenceKeypoint.new(1, 0) })
	sparkle.LightEmission = 1
	sparkle.Parent = p
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Take"
	prompt.ObjectText = Services.InventoryService.itemName(itemId)
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 7
	prompt.RequiresLineOfSight = false
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonA
	prompt.Parent = p
	prompt.Triggered:Connect(function(player)
		Services.InventoryService.pickup(player, p, itemId, amount)
	end)
	return p
end

-- Container models: { body, moving part, open transform }
local BUILDERS = {}

function BUILDERS.Drawer(parent, cf)
	local body = part(parent, Vector3.new(2.6, 2.8, 1.6), cf * CFrame.new(0, 1.4, 0), Color3.fromRGB(96, 80, 62), Enum.Material.WoodPlanks)
	local drawer = part(parent, Vector3.new(2.3, 0.7, 1.4), cf * CFrame.new(0, 2.1, -0.15), Color3.fromRGB(110, 92, 70), Enum.Material.WoodPlanks)
	return body, drawer, CFrame.new(0, 0, -1)
end

function BUILDERS.Locker(parent, cf)
	local body = part(parent, Vector3.new(1.8, 6, 1.6), cf * CFrame.new(0, 3, 0), Color3.fromRGB(70, 84, 88), Enum.Material.Metal)
	local door = part(parent, Vector3.new(1.7, 5.8, 0.1), cf * CFrame.new(0, 3, -0.85), Color3.fromRGB(80, 96, 100), Enum.Material.DiamondPlate)
	return body, door, CFrame.new(-0.85, 0, 0) * CFrame.Angles(0, math.rad(100), 0) * CFrame.new(0.85, 0, 0)
end

function BUILDERS.Toolbox(parent, cf)
	local body = part(parent, Vector3.new(2.2, 0.9, 1), cf * CFrame.new(0, 0.45, 0), Color3.fromRGB(140, 50, 40), Enum.Material.Metal)
	local lid = part(parent, Vector3.new(2.2, 0.15, 1), cf * CFrame.new(0, 0.97, 0), Color3.fromRGB(150, 56, 44), Enum.Material.Metal)
	return body, lid, CFrame.new(0, 0, 0.5) * CFrame.Angles(math.rad(100), 0, 0) * CFrame.new(0, 0, -0.5)
end

function BUILDERS.AmmoCrate(parent, cf)
	local body = part(parent, Vector3.new(2.6, 1.3, 1.6), cf * CFrame.new(0, 0.65, 0), Color3.fromRGB(78, 86, 58), Enum.Material.WoodPlanks)
	local lid = part(parent, Vector3.new(2.6, 0.2, 1.6), cf * CFrame.new(0, 1.4, 0), Color3.fromRGB(86, 94, 64), Enum.Material.WoodPlanks)
	return body, lid, CFrame.new(0, 0, 0.8) * CFrame.Angles(math.rad(110), 0, 0) * CFrame.new(0, 0, -0.8)
end

local function container(parent, spot, rng, pall)
	local def = Loot.Containers[spot.type]
	local builder = BUILDERS[spot.type]
	if not def or not builder then
		return
	end
	local cf = CFrame.new(spot.pos) * CFrame.Angles(0, math.rad(spot.yaw or 0), 0)
	local body, moving, openOffset = builder(parent, cf)
	body.Name = spot.type
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Search"
	prompt.ObjectText = spot.type == "AmmoCrate" and "Ammo crate" or spot.type
	prompt.HoldDuration = def.hold
	prompt.MaxActivationDistance = 7
	prompt.RequiresLineOfSight = false
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonA
	prompt.Parent = body
	local searched = false
	prompt.Triggered:Connect(function(player)
		if searched then
			return
		end
		local info = Services.MatchService.getActiveInfo(player)
		if not info or (info.root.Position - body.Position).Magnitude > 12 then
			return
		end
		searched = true
		prompt:Destroy()
		TweenService:Create(moving, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = moving.CFrame * openOffset }):Play()
		Sfx.at(body.Position, "Search", 0.3, 30)
		Services.PerceptionService.emitNoise(body.Position, 5, "search", player)
		local list = LootService.roll(def.table, def.rolls, rng, pall)
		local found, leftovers = Services.InventoryService.grantList(player, list)
		for i, entry in leftovers do
			LootService.dropPickup(parent, body.Position + Vector3.new(i * 0.9 - 1, -body.Position.Y + 0.1, -1.6), entry[1], entry[2])
		end
		local text = #found > 0 and ("Found: " .. table.concat(found, ", ")) or "Nothing useful."
		if #leftovers > 0 then
			text ..= " (no room for some: left on the floor)"
		end
		Net.notify(player, "Toast", { text = text })
	end)
end

-- Fills an encounter with containers and loose items.
function LootService.populate(parent, rng, pall, containerSpots, looseSpots)
	for _, spot in containerSpots do
		container(parent, spot, rng, pall)
	end
	local spots = table.clone(looseSpots)
	for i = #spots, 2, -1 do
		local j = rng:NextInteger(1, i)
		spots[i], spots[j] = spots[j], spots[i]
	end
	for i = 1, math.min(Loot.LooseItems, #spots) do
		local entry = LootService.roll("loose", 1, rng, 1)[1]
		if entry then
			local jitter = Vector3.new(rng:NextNumber(-1.5, 1.5), 0, rng:NextNumber(-1.5, 1.5))
			LootService.dropPickup(parent, spots[i] + jitter, entry[1], entry[2])
		end
	end
end

function LootService.init(registry)
	Services = registry
end

return LootService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002E"><Properties><string name="Name">MapService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Builds the grey-box world in code so the project is fully self-contained:
--   * The Meridian (ferry hideout deck) far from the encounter
--   * "Cannery Row" encounter map (cannery, container yard, shallows, reed beds, net shed)
-- and resets per-encounter objects (supply crates, part pickups, extraction flare).
-- Stage 4+ replaces the grey-box with hand-built art (docs/05-roadmap-and-prototype.md).
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Game = require(Shared.Config.Game)
local Encounters = require(Shared.Config.Encounters)
local Sfx = require(Shared.Util.Sfx)

local MapService = {}
local Services

local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local C = {
	ground = Color3.fromRGB(58, 62, 64),
	wall = Color3.fromRGB(84, 86, 84),
	wallDark = Color3.fromRGB(62, 64, 64),
	roof = Color3.fromRGB(74, 70, 64),
	metal = Color3.fromRGB(46, 48, 50),
	crate = Color3.fromRGB(92, 72, 52),
	machine = Color3.fromRGB(70, 78, 80),
	supply = Color3.fromRGB(150, 92, 44),
	bone = Color3.fromRGB(226, 220, 206),
	water = Color3.fromRGB(52, 70, 74),
	reed = Color3.fromRGB(92, 94, 70),
	warm = Color3.fromRGB(255, 190, 120),
	flare = Color3.fromRGB(255, 70, 50),
	containers = {
		Color3.fromRGB(110, 54, 42),
		Color3.fromRGB(42, 78, 80),
		Color3.fromRGB(52, 62, 82),
		Color3.fromRGB(128, 104, 52),
	},
}


-- Encounter layout data -------------------------------------------------------------------

-- Filled from the active map module when a map loads (see MapService.loadMap).
MapService.StartSpawns = {}
MapService.ExtractionPos = Vector3.zero
MapService.LanternPos = Vector3.zero
MapService.SupplyCandidates = {}
MapService.LootSpots = {}
MapService.ContainerSpots = {}
MapService.EdgeSpawns = {}
MapService.PatrolRoutes = {}
MapService.Doorways = {}
MapService.MapIds = { "CanneryRow", "LarkspurStreet", "HollowPines" }

local MapsFolder = script.Parent.Parent:WaitForChild("Maps")
local MapKit = require(MapsFolder:WaitForChild("MapKit"))
local MAP_MODULES = {}
for _, id in MapService.MapIds do
	MAP_MODULES[id] = require(MapsFolder:WaitForChild(id))
end

-- Builders --------------------------------------------------------------------------------

local function block(parent, size, position, color, material, props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = typeof(position) == "CFrame" and position or CFrame.new(position)
	p.Color = color
	p.Material = material or Enum.Material.Concrete
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props then
		for key, value in props do
			p[key] = value
		end
	end
	p.Parent = parent
	return p
end

local function volume(parent, size, position, tag)
	local p = block(parent, size, position, Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, {
		Name = tag,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
	})
	CollectionService:AddTag(p, tag)
	return p
end

local function splitGaps(a, b, gaps)
	local segments, cursor = {}, a
	table.sort(gaps, function(x, y)
		return x[1] < y[1]
	end)
	for _, gap in gaps do
		if gap[1] > cursor then
			table.insert(segments, { cursor, gap[1] })
		end
		cursor = math.max(cursor, gap[2])
	end
	if b > cursor then
		table.insert(segments, { cursor, b })
	end
	return segments
end

-- Wall running along X at depth z, with door gaps {{x1, x2}, ...} and lintels above them.
local function wallX(parent, z, x1, x2, height, gaps, color, material)
	for _, s in splitGaps(x1, x2, gaps) do
		block(parent, Vector3.new(s[2] - s[1], height, 2), Vector3.new((s[1] + s[2]) / 2, height / 2, z), color, material)
	end
	for _, g in gaps do
		if height > 9 then
			block(parent, Vector3.new(g[2] - g[1], height - 9, 2), Vector3.new((g[1] + g[2]) / 2, 9 + (height - 9) / 2, z), color, material)
		end
	end
end

local function wallZ(parent, x, z1, z2, height, gaps, color, material)
	for _, s in splitGaps(z1, z2, gaps) do
		block(parent, Vector3.new(2, height, s[2] - s[1]), Vector3.new(x, height / 2, (s[1] + s[2]) / 2), color, material)
	end
	for _, g in gaps do
		if height > 9 then
			block(parent, Vector3.new(2, height - 9, g[2] - g[1]), Vector3.new(x, 9 + (height - 9) / 2, (g[1] + g[2]) / 2), color, material)
		end
	end
end

local function lamp(parent, base)
	block(parent, Vector3.new(0.6, 12, 0.6), base + Vector3.new(0, 6, 0), C.metal, Enum.Material.Metal)
	local head = block(parent, Vector3.new(1.6, 0.8, 1.6), base + Vector3.new(0, 12.2, 0), C.warm, Enum.Material.Neon)
	local light = Instance.new("PointLight")
	light.Range = 24
	light.Brightness = 1.8
	light.Color = C.warm
	light.Shadows = true
	light.Parent = head
	volume(parent, Vector3.new(20, 10, 20), base + Vector3.new(0, 5, 0), "LitZone")
end

local function hangingBulb(parent, position)
	local bulb = block(parent, Vector3.new(0.8, 0.8, 0.8), position, C.warm, Enum.Material.Neon, { Shape = Enum.PartType.Ball })
	local light = Instance.new("PointLight")
	light.Range = 18
	light.Brightness = 1.2
	light.Color = C.warm
	light.Shadows = true
	light.Parent = bulb
	volume(parent, Vector3.new(14, 10, 14), Vector3.new(position.X, 5, position.Z), "LitZone")
end

local function reeds(parent, center, size, rng)
	volume(parent, Vector3.new(size.X, 6, size.Z), center + Vector3.new(0, 3, 0), "TallGrass")
	local count = math.floor(size.X * size.Z * 0.3)
	for _ = 1, count do
		local h = rng:NextNumber(3.6, 5.6)
		local x = center.X + rng:NextNumber(-size.X / 2, size.X / 2)
		local z = center.Z + rng:NextNumber(-size.Z / 2, size.Z / 2)
		local tilt = CFrame.Angles(rng:NextNumber(-0.18, 0.18), rng:NextNumber(0, 6.28), rng:NextNumber(-0.18, 0.18))
		local shade = rng:NextNumber(0.8, 1.15)
		block(parent, Vector3.new(0.22, h, 0.22), CFrame.new(x, h / 2, z) * tilt, Color3.new(C.reed.R * shade, C.reed.G * shade, C.reed.B * shade), Enum.Material.Grass, {
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
		})
	end
end

local function fog(parent, position, size)
	local p = block(parent, Vector3.new(size.X, 1, size.Z), position, Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, {
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
	})
	local e = Instance.new("ParticleEmitter")
	e.Texture = SMOKE
	e.Rate = 1.4
	e.Lifetime = NumberRange.new(14, 20)
	e.Speed = NumberRange.new(0.3, 1)
	e.SpreadAngle = Vector2.new(60, 60)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-4, 4)
	e.LightInfluence = 1
	e.Color = ColorSequence.new(Color3.fromRGB(205, 212, 212))
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 16), NumberSequenceKeypoint.new(1, 28) })
	e.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.3, 0.86),
		NumberSequenceKeypoint.new(0.7, 0.9),
		NumberSequenceKeypoint.new(1, 1),
	})
	e.Parent = p
end

-- The Meridian (hideout) ------------------------------------------------------------------

local function buildFerry(parent)
	local o = Game.FerryOrigin
	local deckColor = Color3.fromRGB(70, 66, 60)
	local hull = Color3.fromRGB(176, 176, 166)
	-- sea + sandbar
	block(parent, Vector3.new(700, 1, 700), o + Vector3.new(0, -7, 0), Color3.fromRGB(30, 40, 44), Enum.Material.Glass, { Reflectance = 0.12, CanQuery = false })
	block(parent, Vector3.new(120, 4, 60), o + Vector3.new(0, -6, 0), Color3.fromRGB(120, 112, 96), Enum.Material.Sand)
	-- deck and railings
	block(parent, Vector3.new(64, 2, 28), o + Vector3.new(0, -1, 0), deckColor, Enum.Material.DiamondPlate)
	block(parent, Vector3.new(64, 3.5, 0.5), o + Vector3.new(0, 1.75, -14), C.metal, Enum.Material.Metal)
	block(parent, Vector3.new(64, 3.5, 0.5), o + Vector3.new(0, 1.75, 14), C.metal, Enum.Material.Metal)
	block(parent, Vector3.new(0.5, 3.5, 28), o + Vector3.new(32, 1.75, 0), C.metal, Enum.Material.Metal)
	block(parent, Vector3.new(0.5, 3.5, 28), o + Vector3.new(-32, 1.75, 0), C.metal, Enum.Material.Metal)
	-- bridge superstructure + hull flank
	block(parent, Vector3.new(14, 12, 20), o + Vector3.new(-23, 6, 0), hull, Enum.Material.CorrodedMetal)
	block(parent, Vector3.new(16, 1, 22), o + Vector3.new(-23, 12.5, 0), C.metal, Enum.Material.Metal)
	block(parent, Vector3.new(64, 8, 1), o + Vector3.new(0, -5, 14.5), hull, Enum.Material.CorrodedMetal)
	block(parent, Vector3.new(64, 8, 1), o + Vector3.new(0, -5, -14.5), hull, Enum.Material.CorrodedMetal)
	-- containers on deck
	block(parent, Vector3.new(16, 8.6, 7), o + Vector3.new(16, 4.3, -9), C.containers[2], Enum.Material.CorrodedMetal)
	block(parent, Vector3.new(7, 8.6, 7), o + Vector3.new(26, 4.3, 9), C.containers[1], Enum.Material.CorrodedMetal)
	-- string lights
	for i = 0, 7 do
		local x = -14 + i * 6
		local bulb = block(parent, Vector3.new(0.5, 0.5, 0.5), o + Vector3.new(x, 7.5 - math.abs(i - 3.5) * 0.25, 0), C.warm, Enum.Material.Neon, { Shape = Enum.PartType.Ball, CanCollide = false, Name = "DeckBulb" })
		local light = Instance.new("PointLight")
		light.Range = 12
		light.Brightness = 0.9
		light.Color = C.warm
		light.Parent = bulb
	end
	block(parent, Vector3.new(44, 0.15, 0.15), o + Vector3.new(7, 7.6, 0), C.metal, Enum.Material.Metal, { CanCollide = false })

	-- Chart table: starts the crossing
	local chart = block(parent, Vector3.new(5, 3, 3), o + Vector3.new(4, 1.5, -4), Color3.fromRGB(96, 70, 48), Enum.Material.WoodPlanks, { Name = "ChartTable" })
	block(parent, Vector3.new(4.4, 0.1, 2.4), o + Vector3.new(4, 3.05, -4), Color3.fromRGB(214, 204, 176), Enum.Material.SmoothPlastic)
	local chartPrompt = Instance.new("ProximityPrompt")
	chartPrompt.Name = "ChartPrompt"
	chartPrompt.ActionText = "Begin the Crossing"
	chartPrompt.ObjectText = "Tide chart"
	chartPrompt.HoldDuration = 0.8
	chartPrompt.MaxActivationDistance = 9
	chartPrompt.RequiresLineOfSight = false
	chartPrompt.GamepadKeyCode = Enum.KeyCode.ButtonA
	chartPrompt.Parent = chart
	chartPrompt.ActionText = "Read the tide chart"
	chartPrompt.Triggered:Connect(function(player)
		Services.MatchService.requestChart(player)
	end)

	-- Crew cabin door: change character
	local cabin = block(parent, Vector3.new(4, 8, 0.6), o + Vector3.new(-15.8, 4, 6), Color3.fromRGB(90, 96, 92), Enum.Material.Metal, { Name = "CabinDoor" })
	local cabinPrompt = Instance.new("ProximityPrompt")
	cabinPrompt.ActionText = "Change crew member"
	cabinPrompt.ObjectText = "Crew cabins"
	cabinPrompt.MaxActivationDistance = 9
	cabinPrompt.RequiresLineOfSight = false
	cabinPrompt.GamepadKeyCode = Enum.KeyCode.ButtonA
	cabinPrompt.Parent = cabin
	cabinPrompt.Triggered:Connect(function(player)
		Services.MatchService.openCharacterSelect(player)
	end)

	-- Workbench: per-crossing upgrades
	local bench = block(parent, Vector3.new(6, 3, 2.6), o + Vector3.new(-6, 1.5, -10.5), Color3.fromRGB(86, 66, 46), Enum.Material.WoodPlanks, { Name = "Workbench" })
	block(parent, Vector3.new(5, 0.2, 0.2), o + Vector3.new(-6, 5.5, -11.6), C.metal, Enum.Material.Metal)
	for i = -2, 2 do
		block(parent, Vector3.new(0.15, 0.9, 0.15), o + Vector3.new(-6 + i, 4.9, -11.6), C.metal, Enum.Material.Metal, { CanCollide = false }) -- hanging tools
	end
	block(parent, Vector3.new(0.6, 0.6, 0.6), o + Vector3.new(-4.2, 3.3, -10.5), Color3.fromRGB(110, 40, 30), Enum.Material.Metal) -- vice
	local benchLight = Instance.new("PointLight")
	benchLight.Range = 12
	benchLight.Brightness = 1.4
	benchLight.Color = C.warm
	benchLight.Shadows = true
	benchLight.Parent = block(parent, Vector3.new(0.6, 0.4, 0.6), o + Vector3.new(-6, 7, -10.5), C.warm, Enum.Material.Neon, { CanCollide = false })
	local benchPrompt = Instance.new("ProximityPrompt")
	benchPrompt.ActionText = "Use workbench"
	benchPrompt.ObjectText = "Workbench"
	benchPrompt.MaxActivationDistance = 9
	benchPrompt.RequiresLineOfSight = false
	benchPrompt.GamepadKeyCode = Enum.KeyCode.ButtonA
	benchPrompt.Parent = bench
	benchPrompt.Triggered:Connect(function(player)
		Services.MatchService.openMenu(player, "OpenWorkbench")
	end)

	-- Repairs board: permanent homebase upgrades
	local board = block(parent, Vector3.new(4, 3, 0.3), o + Vector3.new(-15.9, 4, -4), Color3.fromRGB(120, 100, 76), Enum.Material.WoodPlanks, { Name = "RepairsBoard" })
	local boardPrompt = Instance.new("ProximityPrompt")
	boardPrompt.ActionText = "Plan repairs"
	boardPrompt.ObjectText = "The Meridian"
	boardPrompt.MaxActivationDistance = 9
	boardPrompt.RequiresLineOfSight = false
	boardPrompt.GamepadKeyCode = Enum.KeyCode.ButtonA
	boardPrompt.Parent = board
	boardPrompt.Triggered:Connect(function(player)
		Services.MatchService.openMenu(player, "OpenRepairs")
	end)

	-- Repairable stations (visuals toggled by setFerryRepairs)
	local stations = Instance.new("Folder")
	stations.Name = "Stations"
	stations.Parent = parent
	local gen = block(stations, Vector3.new(3, 2.4, 2), o + Vector3.new(-26, 1.2, 9), Color3.fromRGB(90, 80, 40), Enum.Material.Metal, { Name = "generator" })
	local genLight = Instance.new("PointLight")
	genLight.Name = "On"
	genLight.Color = Color3.fromRGB(140, 255, 120)
	genLight.Range = 6
	genLight.Enabled = false
	genLight.Parent = gen
	local mast = block(stations, Vector3.new(0.4, 14, 0.4), o + Vector3.new(-23, 19.5, 0), C.metal, Enum.Material.Metal, { Name = "radio" })
	local mastLight = Instance.new("PointLight")
	mastLight.Name = "On"
	mastLight.Color = Color3.fromRGB(255, 60, 50)
	mastLight.Range = 10
	mastLight.Enabled = false
	mastLight.Parent = block(stations, Vector3.new(0.5, 0.5, 0.5), o + Vector3.new(-23, 26.7, 0), Color3.fromRGB(255, 60, 50), Enum.Material.Neon, { Name = "radioBeacon" })
	block(stations, Vector3.new(6, 1.2, 2.6), o + Vector3.new(10, 0.6, 11), Color3.fromRGB(200, 196, 186), Enum.Material.Fabric, { Name = "sickbay", Transparency = 0.7 })
	block(stations, Vector3.new(5, 5, 0.6), o + Vector3.new(29, 2.5, -9), Color3.fromRGB(80, 64, 48), Enum.Material.WoodPlanks, { Name = "armory", Transparency = 0.7 })

	-- The Purser's Office: the in-world shop
	local booth = block(parent, Vector3.new(7, 8, 5), o + Vector3.new(24, 4, -1), Color3.fromRGB(150, 146, 134), Enum.Material.CorrodedMetal, { Name = "PursersOffice" })
	for i = -2, 2 do
		block(parent, Vector3.new(0.15, 3, 0.15), o + Vector3.new(24 + i * 0.7, 4.5, 1.6), C.metal, Enum.Material.Metal, { CanCollide = false })
	end
	local boothLight = Instance.new("PointLight")
	boothLight.Range = 10
	boothLight.Brightness = 1
	boothLight.Color = C.warm
	boothLight.Parent = booth
	local shopPrompt = Instance.new("ProximityPrompt")
	shopPrompt.ActionText = "Open the ledger"
	shopPrompt.ObjectText = "The Purser's Office"
	shopPrompt.MaxActivationDistance = 9
	shopPrompt.RequiresLineOfSight = false
	shopPrompt.GamepadKeyCode = Enum.KeyCode.ButtonA
	shopPrompt.Parent = booth
	shopPrompt.Triggered:Connect(function(player)
		Services.MatchService.openShop(player)
	end)
end

-- Cannery Row (encounter) -----------------------------------------------------------------

-- Lighting --------------------------------------------------------------------------------

local atmosphere, colorCorrection

local function setupLighting()
	-- Overcast dusk: readable, cold and moody (night is a modifier, not the default)
	Lighting.ClockTime = 17.4
	Lighting.GeographicLatitude = 50
	Lighting.Brightness = 2.2
	Lighting.Ambient = Color3.fromRGB(62, 68, 74)
	Lighting.OutdoorAmbient = Color3.fromRGB(112, 120, 128)
	Lighting.ColorShift_Top = Color3.fromRGB(255, 224, 196)
	Lighting.EnvironmentDiffuseScale = 0.4
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.GlobalShadows = true
	Lighting.ExposureCompensation = 0.25

	atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Density = 0.34
	atmosphere.Offset = 0.3
	atmosphere.Color = Color3.fromRGB(196, 202, 204)
	atmosphere.Decay = Color3.fromRGB(118, 126, 128)
	atmosphere.Glare = 0.25
	atmosphere.Haze = 1.4
	atmosphere.Parent = Lighting

	colorCorrection = Instance.new("ColorCorrectionEffect")
	colorCorrection.Name = "AftertideGrade"
	colorCorrection.Saturation = -0.22
	colorCorrection.Contrast = 0.16
	colorCorrection.Brightness = 0.01
	colorCorrection.TintColor = Color3.fromRGB(230, 236, 240)
	colorCorrection.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.6
	bloom.Size = 24
	bloom.Threshold = 1.6
	bloom.Parent = Lighting
end

local FERRY_LIGHT = { clock = 17.6, brightness = 2.4, ambient = { 86, 84, 84 }, outdoor = { 140, 134, 128 }, fog = 0.3, haze = 1.4, fogColor = { 210, 204, 196 }, tint = { 248, 238, 228 }, saturation = -0.1, contrast = 0.12, shift = { 255, 220, 184 } }

local function rgb(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

-- Map lighting preset, adjusted by the route's modifier (Nightfall turns it to night).
local function applyPreset(L, modifier)
	modifier = modifier or {}
	local night = modifier.night == true
	Lighting.ClockTime = night and 0.6 or L.clock
	Lighting.Brightness = night and 1.4 or L.brightness
	Lighting.Ambient = night and Color3.fromRGB(32, 36, 42) or rgb(L.ambient)
	local boost = (modifier.ambientBoost or 0) * 50
	local o = night and { 48, 54, 64 } or L.outdoor
	Lighting.OutdoorAmbient = Color3.fromRGB(math.min(255, o[1] + boost), math.min(255, o[2] + boost), math.min(255, o[3] + boost))
	Lighting.ColorShift_Top = rgb(L.shift)
	if atmosphere then
		local density = L.fog + ((modifier.fogDensity or 0.34) - 0.34)
		TweenService:Create(atmosphere, TweenInfo.new(3), { Density = math.clamp(density, 0.12, 0.7) }):Play()
		atmosphere.Haze = L.haze
		atmosphere.Color = rgb(L.fogColor)
	end
	if colorCorrection then
		colorCorrection.TintColor = rgb(L.tint)
		colorCorrection.Saturation = L.saturation
		colorCorrection.Contrast = L.contrast
	end
end

function MapService.applyFerryLighting()
	applyPreset(FERRY_LIGHT, nil)
end

function MapService.applyModifier(modifier)
	applyPreset(MapService.currentMap and MapService.currentMap.lighting or FERRY_LIGHT, modifier)
end

-- Builds a map (terrain + geometry) and loads its data. Rebuilt only when it changes.
local mapFolder, currentMapId
function MapService.loadMap(mapId, rng)
	local def = MAP_MODULES[mapId] or MAP_MODULES.CanneryRow
	if currentMapId == def.id and mapFolder and mapFolder.Parent then
		return
	end
	if mapFolder then
		mapFolder:Destroy()
	end
	MapKit.clearTerrain()
	local world = Workspace:FindFirstChild("World")
	mapFolder = Instance.new("Folder")
	mapFolder.Name = "Map_" .. def.id
	mapFolder.Parent = world
	local data = def.build(mapFolder, Random.new(rng:NextInteger(1, 1e6)))
	-- snap every gameplay position onto the actual ground (hills, house floors)
	local function snap(v)
		return Vector3.new(v.X, MapKit.ground(v.X, v.Z, { Workspace.Terrain, mapFolder }), v.Z)
	end
	local function snapList(list)
		local out = {}
		for i, v in list do
			out[i] = snap(v)
		end
		return out
	end
	MapService.StartSpawns = snapList(data.StartSpawns)
	MapService.ExtractionPos = snap(data.ExtractionPos)
	MapService.LanternPos = snap(data.LanternPos)
	MapService.SupplyCandidates = snapList(data.SupplyCandidates)
	MapService.LootSpots = snapList(data.LootSpots)
	MapService.EdgeSpawns = snapList(data.EdgeSpawns)
	MapService.PatrolRoutes = {}
	for i, route in data.PatrolRoutes do
		MapService.PatrolRoutes[i] = snapList(route)
	end
	MapService.ContainerSpots = {}
	for i, c in data.ContainerSpots do
		MapService.ContainerSpots[i] = { pos = snap(c.pos), type = c.type, yaw = c.yaw }
	end
	MapService.Doorways = data.Doorways or {}
	MapService.currentMap = def
	currentMapId = def.id
	Workspace:SetAttribute("MapName", def.name)
end

function MapService.mapName(mapId)
	local def = MAP_MODULES[mapId]
	return def and def.name or mapId
end

-- Encounter objects -----------------------------------------------------------------------

local encounterFolder
local extraction

local function shuffled(list, rng)
	local copy = table.clone(list)
	for i = #copy, 2, -1 do
		local j = rng:NextInteger(1, i)
		copy[i], copy[j] = copy[j], copy[i]
	end
	return copy
end

local function makePrompt(parent, action, object, hold)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action
	prompt.ObjectText = object
	prompt.HoldDuration = hold or 0
	prompt.MaxActivationDistance = 8
	prompt.RequiresLineOfSight = false
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonA
	prompt.Parent = parent
	return prompt
end

local doors = {}

local function makeDoor(parent, hinge, width, along, closedNow)
	along = Vector3.new(along.X, 0, along.Z).Unit
	local size = Vector3.new(width, 8.6, 0.4)
	local closedCF = CFrame.fromMatrix(hinge + along * (width / 2) + Vector3.new(0, 4.3, 0), along, Vector3.new(0, 1, 0))
	local hingeCF = CFrame.new(hinge + Vector3.new(0, 4.3, 0))
	local openCF = hingeCF * CFrame.Angles(0, math.rad(95), 0) * hingeCF:ToObjectSpace(closedCF)
	local door = block(parent, size, closedNow and closedCF or openCF, Color3.fromRGB(92, 78, 62), Enum.Material.WoodPlanks, { Name = "Door" })
	local modifier = Instance.new("PathfindingModifier")
	modifier.PassThrough = true -- Hushed path through doors; they push them open
	modifier.Parent = door
	local record = { part = door, open = not closedNow, closedCF = closedCF, openCF = openCF }
	local prompt = makePrompt(door, closedNow and "Open" or "Close", "Door", 0)
	prompt.MaxActivationDistance = 7
	record.prompt = prompt
	function record.set(open, byPlayer)
		if record.open == open then
			return
		end
		record.open = open
		prompt.ActionText = open and "Close" or "Open"
		TweenService:Create(door, TweenInfo.new(0.5, Enum.EasingStyle.Quad), { CFrame = open and openCF or closedCF }):Play()
		Sfx.at(door.Position, "Door", 0.6, 60)
		if byPlayer then
			Services.PerceptionService.emitNoise(door.Position, 7, "door", byPlayer)
		end
	end
	prompt.Triggered:Connect(function(player)
		record.set(not record.open, player)
	end)
	table.insert(doors, record)
end

local lantern

function MapService.getLantern()
	return lantern
end

function MapService.resetEncounter(modifier, rng, encounterType, pall, mapId)
	MapService.loadMap(mapId or "CanneryRow", rng)
	encounterFolder:ClearAllChildren()
	table.clear(doors)
	lantern = nil

	-- supply crates (Salvage objective)
	if encounterType == "Salvage" then
		local picks = shuffled(MapService.SupplyCandidates, rng)
		for i = 1, Encounters.Types.Salvage.crates do
			local pos = picks[i]
			local crate = block(encounterFolder, Vector3.new(3, 2.4, 2.2), pos + Vector3.new(0, 1.2, 0), C.supply, Enum.Material.WoodPlanks, { Name = "SupplyCrate" })
			block(crate, Vector3.new(3.05, 0.35, 2.25), pos + Vector3.new(0, 1.7, 0), C.bone, Enum.Material.SmoothPlastic, { CanCollide = false, CanQuery = false })
			local glint = Instance.new("PointLight")
			glint.Range = 5
			glint.Brightness = 0.35
			glint.Color = C.warm
			glint.Parent = crate
			local prompt = makePrompt(crate, "Salvage", "Supply crate", 1.2)
			prompt.Triggered:Connect(function(player)
				Services.MatchService.onCrateSalvaged(player, crate)
			end)
		end
	end

	-- the signal lantern (Lantern Watch / finale)
	if encounterType == "LanternWatch" then
		local base = MapService.LanternPos
		block(encounterFolder, Vector3.new(3, 1, 3), base + Vector3.new(0, 0.5, 0), C.metal, Enum.Material.Metal)
		block(encounterFolder, Vector3.new(0.5, 6, 0.5), base + Vector3.new(0, 4, 0), C.metal, Enum.Material.Metal)
		lantern = block(encounterFolder, Vector3.new(1.6, 2, 1.6), base + Vector3.new(0, 8, 0), C.warm, Enum.Material.Neon, { Name = "SignalLantern" })
		local light = Instance.new("PointLight")
		light.Range = 40
		light.Brightness = 2.5
		light.Color = C.warm
		light.Shadows = true
		light.Parent = lantern
		volume(encounterFolder, Vector3.new(30, 10, 30), base + Vector3.new(0, 5, 0), "LitZone")
	end

	-- doors (some start closed)
	for _, d in MapService.Doorways do
		makeDoor(encounterFolder, d.hinge, d.width, d.dir, rng:NextNumber() < 0.5)
	end

	-- scavenging: containers + loose items
	Services.LootService.populate(encounterFolder, rng, pall or 1, MapService.ContainerSpots, MapService.LootSpots)
	encounterFolder:SetAttribute("Modifier", modifier.id)

	-- extraction: the Slipway flare (inactive until the quota is met)
	local base = MapService.ExtractionPos
	local ring = block(encounterFolder, Vector3.new(0.2, Game.ExtractionRadius * 2, Game.ExtractionRadius * 2), CFrame.new(base + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, 0, math.rad(90)), C.flare, Enum.Material.Neon, {
		Name = "ExtractionRing",
		Shape = Enum.PartType.Cylinder,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	})
	local flare = block(encounterFolder, Vector3.new(0.6, 1.4, 0.6), base + Vector3.new(0, 0.7, 0), C.flare, Enum.Material.Neon, {
		Name = "Flare",
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
	})
	local light = Instance.new("PointLight")
	light.Color = C.flare
	light.Range = 32
	light.Brightness = 3
	light.Shadows = true
	light.Enabled = false
	light.Parent = flare
	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = SMOKE
	smoke.Enabled = false
	smoke.Rate = 6
	smoke.Lifetime = NumberRange.new(5, 7)
	smoke.Speed = NumberRange.new(6, 9)
	smoke.SpreadAngle = Vector2.new(8, 8)
	smoke.Color = ColorSequence.new(Color3.fromRGB(255, 120, 100))
	smoke.LightEmission = 0.4
	smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 9) })
	smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) })
	smoke.Parent = flare
	extraction = { ring = ring, flare = flare, light = light, smoke = smoke }
end

function MapService.activateExtraction()
	if not extraction then
		return
	end
	extraction.ring.Transparency = 0.8
	extraction.flare.Transparency = 0
	extraction.light.Enabled = true
	extraction.smoke.Enabled = true
end

function MapService.cleanupEncounter()
	if encounterFolder then
		encounterFolder:ClearAllChildren()
	end
	extraction = nil
end

-- Shows which homebase repairs are done (any player in the server owns them).
function MapService.setFerryRepairs(owned)
	local ferry = Workspace:FindFirstChild("World") and Workspace.World:FindFirstChild("Meridian")
	if not ferry then
		return
	end
	local stations = ferry:FindFirstChild("Stations")
	for _, d in ferry:GetDescendants() do
		if d:IsA("BasePart") and d.Name == "DeckBulb" then
			local light = d:FindFirstChildOfClass("PointLight")
			if light then
				light.Enabled = owned.lights == true
			end
			d.Material = owned.lights and Enum.Material.Neon or Enum.Material.Glass
		end
	end
	if stations then
		for _, id in { "generator", "radio", "sickbay", "armory" } do
			local part = stations:FindFirstChild(id)
			if part then
				part.Transparency = owned[id] and 0 or 0.7
				for _, light in part:GetDescendants() do
					if light:IsA("PointLight") then
						light.Enabled = owned[id] == true
					end
				end
			end
		end
		local beacon = stations:FindFirstChild("radioBeacon")
		local beaconLight = beacon and beacon:FindFirstChild("On")
		if beaconLight then
			beaconLight.Enabled = owned.radio == true
		end
	end
end

function MapService.ferrySpawn(index)
	local o = Game.FerryOrigin
	local pos = o + Vector3.new(-4 + ((index - 1) % 4) * 3, 3, 6)
	return CFrame.lookAt(pos, pos + Vector3.new(1, 0, 0))
end

function MapService.encounterSpawn(index)
	local pos = MapService.StartSpawns[(index - 1) % #MapService.StartSpawns + 1] + Vector3.new(0, 3, 0)
	local toward = MapService.ExtractionPos - pos
	toward = Vector3.new(toward.X, 0, toward.Z)
	return CFrame.lookAt(pos, pos + (toward.Magnitude > 1 and toward.Unit or Vector3.new(0, 0, -1)))
end

function MapService.init(registry)
	Services = registry
end

function MapService.start()
	local world = Instance.new("Folder")
	world.Name = "World"
	world.Parent = Workspace

	local ferry = Instance.new("Folder")
	ferry.Name = "Meridian"
	ferry.Parent = world
	buildFerry(ferry)

	MapKit.setAssets(Services.AssetService)

	encounterFolder = Instance.new("Folder")
	encounterFolder.Name = "Encounter"
	encounterFolder.Parent = world

	setupLighting()
	MapService.applyFerryLighting()
	MapService.setFerryRepairs({})
	MapService.ready = true

	-- Hushed shove closed doors open when they reach them.
	while true do
		task.wait(0.4)
		for _, d in doors do
			if not d.open and d.part.Parent and #Services.EnemyService.findNear(d.part.Position, 5) > 0 then
				d.set(true, nil)
			end
		end
	end
end

return MapService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000002F"><Properties><string name="Name">MatchService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The Crossing director (the roguelike run):
--   Ferry      no crossing; pick crew, shop, repairs. Tide chart -> start a crossing.
--   Planning   at the Meridian mid-crossing: workbench, crafting, choose the next route.
--   Starting   short countdown, then the encounter.
--   Encounter  Salvage / Lantern Watch / Drift, or the finale (The Breakwater).
--   Results    debrief. Then back to Planning (next encounter) or Ferry (crossing over).
-- The satchel, weapons and workbench upgrades carry across a crossing; the Pall (difficulty)
-- rises after every encounter. Losing everyone ends the crossing; Scrip earned is kept.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Characters = require(Shared.Config.Characters)
local Encounters = require(Shared.Config.Encounters)
local Game = require(Shared.Config.Game)
local Modifiers = require(Shared.Config.Modifiers)
local Net = require(Shared.Net)
local Sfx = require(Shared.Util.Sfx)

local MatchService = {}
local Services

MatchService.state = "Ferry"
MatchService.modifier = Modifiers.None

local run = nil -- { id, index, pall, options, participants = { [Player] = true } }
local enc = nil -- current encounter state
local resultsAcknowledged = {}
local rng = Random.new()

local function now()
	return os.clock()
end

local function setState(newState)
	MatchService.state = newState
	ReplicatedStorage:SetAttribute("MatchState", newState)
end

local function publish()
	ReplicatedStorage:SetAttribute("RunActive", run ~= nil)
	ReplicatedStorage:SetAttribute("RunIndex", run and run.index or 0)
	ReplicatedStorage:SetAttribute("RunLength", Encounters.RunLength + 1)
	ReplicatedStorage:SetAttribute("Pall", run and run.pall or 0)
	ReplicatedStorage:SetAttribute("ModifierName", MatchService.modifier.name)
	ReplicatedStorage:SetAttribute("ModifierDesc", MatchService.modifier.desc)
	ReplicatedStorage:SetAttribute("ModifierId", MatchService.modifier.id)
	ReplicatedStorage:SetAttribute("EncounterType", enc and enc.type or "")
	ReplicatedStorage:SetAttribute("EncounterName", enc and enc.name or "")
	ReplicatedStorage:SetAttribute("Objective", enc and enc.objective or "")
	ReplicatedStorage:SetAttribute("Crates", enc and enc.crates or 0)
	ReplicatedStorage:SetAttribute("CratesRequired", enc and enc.cratesRequired or 0)
	ReplicatedStorage:SetAttribute("ExtractionOpen", enc and enc.extractionOpen or false)
	ReplicatedStorage:SetAttribute("LanternHP", enc and enc.lanternHP or 0)
	ReplicatedStorage:SetAttribute("LanternMax", enc and enc.lanternMax or 0)
	ReplicatedStorage:SetAttribute("Wave", enc and enc.wave or 0)
	ReplicatedStorage:SetAttribute("Waves", enc and enc.waves or 0)
	ReplicatedStorage:SetAttribute("EndsAt", enc and enc.endsAtServer or 0)
	ReplicatedStorage:SetAttribute("RouteOptions", run and HttpService:JSONEncode(run.options or {}) or "[]")
end

-- Queries --------------------------------------------------------------------------------

function MatchService.getActiveInfo(player)
	if MatchService.state ~= "Encounter" or not run or not run.participants[player] then
		return nil
	end
	local session = Services.CharacterService.getSession(player)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not session or not root or session.downed or session.out then
		return nil
	end
	return { player = player, char = char, root = root, session = session }
end

function MatchService.getActivePlayers()
	local list = {}
	if MatchService.state ~= "Encounter" or not run then
		return list
	end
	for player in run.participants do
		local info = MatchService.getActiveInfo(player)
		if info then
			table.insert(list, info)
		end
	end
	return list
end

-- For actions allowed on the Meridian (crafting, equipping).
function MatchService.getFerryInfo(player)
	if MatchService.state == "Encounter" and run and run.participants[player] then
		return nil
	end
	local session = Services.CharacterService.getSession(player)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not session or not session.charId or not root then
		return nil
	end
	return { player = player, char = char, root = root, session = session }
end

function MatchService.isParticipant(player)
	return run ~= nil and run.participants[player] == true
end

function MatchService.isPlanning()
	return MatchService.state == "Planning"
end

-- Ferry menus -----------------------------------------------------------------------------

function MatchService.openCharacterSelect(player)
	if MatchService.isParticipant(player) then
		Net.notify(player, "Toast", { text = "You can change crew once this crossing ends" })
		return
	end
	Net.notify(player, "OpenCharacterSelect", {})
end

function MatchService.openShop(player)
	Net.notify(player, "OpenShop", {})
end

function MatchService.openMenu(player, kind)
	Net.notify(player, kind, {})
end

local function ferrySpawnAll(resetInventory)
	local i = 0
	for _, player in Players:GetPlayers() do
		local session = Services.CharacterService.getSession(player)
		if session and session.charId then
			i += 1
			Services.CharacterService.spawn(player, Services.MapService.ferrySpawn(i), resetInventory and not MatchService.isParticipant(player))
		end
	end
end

local function rollModifier()
	if rng:NextNumber() < Modifiers.NoneChance then
		return Modifiers.None
	end
	return Modifiers.List[rng:NextInteger(1, #Modifiers.List)]
end

local function anyoneHas(repairId)
	for player in run and run.participants or {} do
		if Services.PlayerDataService.hasRepair(player, repairId) then
			return true
		end
	end
	return false
end

local function generateOptions()
	local options = {}
	if run.index > Encounters.RunLength then
		table.insert(options, { type = "Finale", name = Encounters.Finale.name, modifier = rollModifier().id, bonus = 0, map = "CanneryRow", mapName = "Cannery Row", factionName = "The Hushed" })
	else
		local types = { "Salvage", "LanternWatch", "Drift" }
		for i = #types, 2, -1 do
			local j = rng:NextInteger(1, i)
			types[i], types[j] = types[j], types[i]
		end
		local count = anyoneHas("radio") and 3 or 2
		local maps = table.clone(Services.MapService.MapIds)
		for i = #maps, 2, -1 do
			local j = rng:NextInteger(1, i)
			maps[i], maps[j] = maps[j], maps[i]
		end
		local factionIds = {}
		for id in Encounters.Factions do
			table.insert(factionIds, id)
		end
		table.sort(factionIds)
		for i = 1, count do
			local t = types[i]
			local faction = nil
			if run.index >= 2 and rng:NextNumber() < Encounters.FactionChance and t ~= "LanternWatch" then
				faction = factionIds[rng:NextInteger(1, #factionIds)]
			end
			table.insert(options, {
				type = t,
				name = Encounters.Types[t].name,
				modifier = rollModifier().id,
				bonus = ({ 0, 5, 10 })[rng:NextInteger(1, 3)],
				map = maps[(i - 1) % #maps + 1],
				mapName = Services.MapService.mapName(maps[(i - 1) % #maps + 1]),
				faction = faction,
				factionName = faction and Encounters.Factions[faction].name or "The Hushed",
			})
		end
	end
	run.options = options
	publish()
end

local function addToRun(player)
	if not run or run.participants[player] then
		return
	end
	local count = 0
	for _ in run.participants do
		count += 1
	end
	if count >= Game.MaxPartySize then
		Net.notify(player, "Toast", { text = "This crossing's crew is full. You'll join the next one." })
		return
	end
	if Services.CharacterService.beginRun(player, run.id, Services.HomebaseService.bonusesFor(player)) then
		run.participants[player] = true
		player:SetAttribute("InCrossing", true)
		if player.Character and MatchService.state == "Planning" then
			Services.WeaponService.onSpawn(player, player.Character) -- loadout may have changed
		end
	end
end

local function startRun()
	run = { id = HttpService:GenerateGUID(false), index = 1, pall = 1, participants = {} }
	for _, player in Players:GetPlayers() do
		local session = Services.CharacterService.getSession(player)
		if session and session.charId then
			addToRun(player)
		end
	end
	generateOptions()
	setState("Planning")
	ferrySpawnAll(false)
	Net.notifyAll("Toast", { text = "A crossing begins. Prepare at the workbench, then choose a route on the tide chart." })
end

function MatchService.requestChart(player)
	local session = Services.CharacterService.getSession(player)
	if not session or not session.charId then
		Net.notify(player, "OpenCharacterSelect", {})
		return
	end
	if MatchService.state == "Ferry" then
		startRun()
		Net.notifyAll("OpenChart", {})
	elseif MatchService.state == "Planning" then
		addToRun(player)
		Net.notify(player, "OpenChart", {})
	else
		Net.notify(player, "Toast", { text = "The crossing is already underway" })
	end
end

function MatchService.chooseRoute(player, index)
	if MatchService.state ~= "Planning" or not run or type(index) ~= "number" then
		return
	end
	addToRun(player)
	local option = run.options and run.options[math.floor(index)]
	if not option or not run.participants[player] then
		return
	end
	run.choice = option
	setState("Starting")
	ReplicatedStorage:SetAttribute("StartsAt", Workspace:GetServerTimeNow() + Game.StartCountdown)
	Net.notifyAll("CloseMenus", {})
	Net.notifyAll("Toast", { text = ("%s chose %s. Casting off…"):format(player.DisplayName, option.name) })
	task.delay(Game.StartCountdown, function()
		if MatchService.state == "Starting" then
			MatchService.beginEncounter(option)
		end
	end)
end

local function onSelectCharacter(player, charId, perkId)
	if type(charId) ~= "string" or (perkId ~= nil and type(perkId) ~= "string") or not Characters.List[charId] then
		return
	end
	if MatchService.isParticipant(player) then
		Net.notify(player, "Toast", { text = "You can change crew once this crossing ends" })
		return
	end
	if not Services.CharacterService.setCharacter(player, charId, perkId) then
		return
	end
	Services.CharacterService.spawn(player, Services.MapService.ferrySpawn(#Players:GetPlayers()), true)
	if MatchService.state == "Planning" then
		Net.notify(player, "Toast", { text = "A crossing is being planned: use the tide chart to join it." })
	elseif MatchService.state ~= "Ferry" then
		Net.notify(player, "Toast", { text = "A crossing is underway. You'll join at the next stop." })
	end
end

-- Encounters ------------------------------------------------------------------------------

local function participantsCount()
	local n = 0
	for p in run.participants do
		if p.Parent then
			n += 1
		end
	end
	return n
end

local function enemyBudget()
	local players = math.max(1, participantsCount())
	return math.min(Encounters.MaxEnemies, Encounters.BaseEnemies + (run.pall - 1) * Encounters.PerPall + (players - 1) * Encounters.PerExtraPlayer)
end

local function weightsForPall()
	local faction = enc and enc.option and enc.option.faction
	if faction and Encounters.Factions[faction] then
		return Encounters.Factions[faction].weights
	end
	local level = math.clamp(run.pall, 1, 4)
	return Encounters.TypeWeights[level]
end

local function farEdgeSpawn()
	local active = MatchService.getActivePlayers()
	local best, bestDist = nil, -1
	for _, pos in Services.MapService.EdgeSpawns do
		local nearest = math.huge
		for _, info in active do
			nearest = math.min(nearest, (info.root.Position - pos).Magnitude)
		end
		local score = nearest + rng:NextNumber() * 30
		if score > bestDist then
			best, bestDist = pos, score
		end
	end
	return best or Services.MapService.EdgeSpawns[1]
end

local function spawnPatrols(count)
	local routes = Services.MapService.PatrolRoutes
	for i = 1, count do
		local route = routes[(i - 1) % #routes + 1]
		local start = route[rng:NextInteger(1, #route)] + Vector3.new(rng:NextNumber(-3, 3), 0, rng:NextNumber(-3, 3))
		Services.EnemyService.spawn(Services.EnemyService.pickType(weightsForPall()), start, { route = route })
	end
end

function MatchService.beginEncounter(option)
	table.clear(resultsAcknowledged)
	local isFinale = option.type == "Finale"
	local def = isFinale and Encounters.Finale or Encounters.Types[option.type]
	local kind = isFinale and def.type or option.type
	MatchService.modifier = Modifiers.None
	for _, m in Modifiers.List do
		if m.id == option.modifier then
			MatchService.modifier = m
		end
	end

	enc = {
		type = kind,
		finale = isFinale,
		name = def.name,
		option = option,
		startedAt = now(),
		crates = 0,
		cratesRequired = kind == "Salvage" and def.crates or 0,
		extractionOpen = false,
		wave = 0,
		waves = def.waves or 0,
		lanternHP = def.lanternHP or 0,
		lanternMax = def.lanternHP or 0,
		endsAtServer = 0,
		nextHunt = 0,
		nextSpawn = 0,
	}
	if kind == "Salvage" then
		enc.objective = def.desc:format(def.crates)
	else
		enc.objective = def.desc
	end

	Services.EnemyService.clear()
	Services.PerceptionService.clearFog()
	Services.MapService.resetEncounter(MatchService.modifier, rng, kind, run.pall, option.map)
	Services.MapService.applyModifier(MatchService.modifier)

	local i = 0
	for player in run.participants do
		if player.Parent then
			i += 1
			Services.CharacterService.spawn(player, Services.MapService.encounterSpawn(i), false)
		end
	end

	local budget = enemyBudget()
	if kind == "Salvage" then
		spawnPatrols(budget)
	elseif kind == "LanternWatch" then
		spawnPatrols(math.ceil(budget * 0.4))
		enc.nextWaveAt = now() + 8
		enc.endsAt = now() + 8 + def.waves * def.waveTime
		enc.endsAtServer = Workspace:GetServerTimeNow() + 8 + def.waves * def.waveTime
	elseif kind == "Drift" then
		spawnPatrols(math.ceil(budget * 0.6))
		enc.endsAt = now() + def.duration
		enc.endsAtServer = Workspace:GetServerTimeNow() + def.duration
		enc.nextHunt = now() + 6
		enc.nextSpawn = now() + def.spawnInterval
	end

	setState("Encounter")
	publish()
	Net.notifyAll("EncounterStart", {
		name = def.name .. " · " .. (option.mapName or ""),
		faction = option.factionName,
		objective = enc.objective,
		modifierName = MatchService.modifier.name,
		modifierDesc = MatchService.modifier.desc,
		pall = run.pall,
	})
end

function MatchService.onCrateSalvaged(player, crate)
	if MatchService.state ~= "Encounter" or not enc or not crate.Parent then
		return
	end
	local info = MatchService.getActiveInfo(player)
	if not info or (info.root.Position - crate.Position).Magnitude > 12 then
		return
	end
	crate:Destroy()
	enc.crates += 1
	info.session.stats.crates += 1
	Services.InventoryService.add(player, "salvage", 4)
	Services.PerceptionService.emitNoise(info.root.Position, 7, "salvage", player)
	if enc.crates >= enc.cratesRequired and not enc.extractionOpen then
		enc.extractionOpen = true
		Services.MapService.activateExtraction()
		Net.notifyAll("Toast", { text = "Quota met. The Slipway flare is lit: get everyone there." })
	else
		Net.notifyAll("Toast", { text = ("Supply crate %d/%d"):format(enc.crates, enc.cratesRequired) })
	end
	publish()
end

function MatchService.onSpotted(player, enemy)
	local session = Services.CharacterService.getSession(player)
	if session then
		session.stats.detections += 1
	end
	Net.notify(player, "Spotted", {})
	Sfx.at(enemy.root.Position, "Spotted", 0.25, 40)
end

function MatchService.onEnemyKilled(player, e)
	if not player or not player.Parent then
		return
	end
	local session = Services.CharacterService.getSession(player)
	if session then
		session.stats.kills += 1
	end
	Services.InventoryService.add(player, "salvage", e.cfg.salvage or 2)
end

function MatchService.onObjectiveAttacked(amount)
	if not enc or enc.type ~= "LanternWatch" or MatchService.state ~= "Encounter" then
		return
	end
	enc.lanternHP = math.max(0, enc.lanternHP - amount)
	ReplicatedStorage:SetAttribute("LanternHP", enc.lanternHP)
end

function MatchService.onPlayerDowned(_player)
	-- the encounter loop checks for a wipe
end

-- Results -----------------------------------------------------------------------------------

local function today()
	return os.date("!%Y-%m-%d")
end

local function grantTokens(player, rewards, list)
	for kind, amount in rewards do
		if Services.PlayerDataService.addTokens(player, kind, amount) then
			table.insert(list, ("+%d %s"):format(amount, kind == "secondWind" and "Second Wind" or "Resupply"))
		end
	end
end

local function finishRun(win)
	for player in run.participants do
		if player.Parent then
			Services.CharacterService.endRun(player)
			player:SetAttribute("InCrossing", false)
			local data = Services.PlayerDataService.get(player)
			if data then
				data.stats.runs += 1
				if win then
					data.stats.wins += 1
				end
				data.stats.bestPall = math.max(data.stats.bestPall, run.pall)
			end
		end
	end
	run = nil
end

function MatchService.endEncounter(win)
	if MatchService.state ~= "Encounter" or not enc then
		return
	end
	setState("Results")
	MatchService.resultPlayers = {}
	for player in run.participants do
		MatchService.resultPlayers[player] = true
	end
	local elapsed = now() - enc.startedAt
	local runOver = (not win) or enc.finale
	local R = Encounters.Rewards
	for player in run.participants do
		if player.Parent then
			local session = Services.CharacterService.getSession(player)
			local data = Services.PlayerDataService.get(player)
			local rewards = {}
			if session and data then
				data.stats.takedowns += session.stats.takedowns
				if win then
					data.stats.encounters += 1
					local salvage = R.salvagePerEncounter + 5 * run.pall + (enc.option.bonus or 0)
					Services.InventoryService.add(player, "salvage", salvage)
					table.insert(rewards, ("+%d Salvage"):format(salvage))
					local scrip = R.scripPerEncounter + 5 * run.index + (enc.finale and R.scripRunComplete or 0)
					Services.PlayerDataService.addScrip(player, scrip)
					table.insert(rewards, ("+%d Scrip"):format(scrip))
					if enc.finale and Game.RunAidsEnabled then
						grantTokens(player, Game.WinReward, rewards)
						if data.lastDailyWin ~= today() then
							data.lastDailyWin = today()
							grantTokens(player, Game.DailyWinReward, rewards)
						end
					end
				end
				task.spawn(Services.PlayerDataService.save, player)
			end
			Net.notify(player, "Results", {
				win = win,
				runOver = runOver,
				runWon = win and enc.finale,
				name = enc.name,
				index = run.index,
				pall = run.pall,
				seconds = math.floor(elapsed),
				crates = enc.crates,
				takedowns = session and session.stats.takedowns or 0,
				kills = session and session.stats.kills or 0,
				detections = session and session.stats.detections or 0,
				rewards = rewards,
			})
		end
	end
	Services.EnemyService.clear()
	Services.PerceptionService.clearFog()

	if runOver then
		finishRun(win)
	else
		run.index += 1
		run.pall += 1
	end

	local token = {}
	MatchService.resultsToken = token
	task.delay(Game.ResultsDuration, function()
		if MatchService.resultsToken == token then
			MatchService.leaveResults()
		end
	end)
end

function MatchService.leaveResults()
	if MatchService.state ~= "Results" then
		return
	end
	MatchService.resultsToken = nil
	enc = nil
	Services.MapService.cleanupEncounter()
	MatchService.modifier = Modifiers.None
	Services.MapService.applyFerryLighting()
	if run then
		generateOptions()
		setState("Planning")
		publish()
		ferrySpawnAll(false)
		Net.notifyAll("Toast", { text = ("Back aboard. Pall level %d. Upgrade at the workbench, then read the tide chart."):format(run.pall) })
	else
		setState("Ferry")
		publish()
		ferrySpawnAll(true)
	end
end

-- Encounter loop ------------------------------------------------------------------------------

local function allStandingAtExtraction()
	local extraction = Services.MapService.ExtractionPos
	local anyStanding, allIn = false, true
	for player in run.participants do
		local info = MatchService.getActiveInfo(player)
		if info then
			anyStanding = true
			local flat = Vector3.new(info.root.Position.X - extraction.X, 0, info.root.Position.Z - extraction.Z)
			if flat.Magnitude > Game.ExtractionRadius then
				allIn = false
			end
		end
	end
	return anyStanding and allIn
end

local function tickEncounter()
	if MatchService.state ~= "Encounter" or not enc or not run then
		return
	end
	for player in run.participants do
		if not player.Parent then
			run.participants[player] = nil
		end
	end
	local active = MatchService.getActivePlayers()
	if #active == 0 then
		MatchService.endEncounter(false)
		return
	end
	local t = now()
	local def = enc.finale and Encounters.Finale or Encounters.Types[enc.type]

	if enc.type == "Salvage" then
		if enc.extractionOpen and allStandingAtExtraction() then
			MatchService.endEncounter(true)
		end
	elseif enc.type == "LanternWatch" then
		if enc.lanternHP <= 0 then
			Net.notifyAll("Toast", { text = "The lantern went dark." })
			MatchService.endEncounter(false)
			return
		end
		if enc.wave < enc.waves and t >= enc.nextWaveAt then
			enc.wave += 1
			enc.nextWaveAt = t + def.waveTime
			local count = def.perWave + (run.pall - 1) + (#active - 1)
			local lanternPos = Services.MapService.LanternPos
			for k = 1, count do
				local typeName = Services.EnemyService.pickType(weightsForPall())
				if enc.finale and enc.wave == enc.waves and k == 1 then
					typeName = def.boss
				end
				local origin = farEdgeSpawn() + Vector3.new(rng:NextNumber(-4, 4), 0, rng:NextNumber(-4, 4))
				Services.EnemyService.spawn(typeName, origin, { objective = lanternPos, objectiveDps = def.dps })
			end
			Net.notifyAll("Toast", { text = ("Wave %d of %d: they're coming for the light."):format(enc.wave, enc.waves) })
			publish()
		end
		if t >= enc.endsAt then
			Net.notifyAll("Toast", { text = "The tide turns. The lantern held." })
			MatchService.endEncounter(true)
		end
	elseif enc.type == "Drift" then
		if t >= enc.nextHunt and not enc.extractionOpen then
			enc.nextHunt = t + def.huntInterval
			Services.EnemyService.huntPulse(active)
		end
		if t >= enc.nextSpawn and not enc.extractionOpen and Services.EnemyService.count() < Encounters.MaxEnemies then
			enc.nextSpawn = t + def.spawnInterval
			for _ = 1, def.perSpawn + math.floor((run.pall - 1) / 2) do
				Services.EnemyService.spawn(Services.EnemyService.pickType(weightsForPall()), farEdgeSpawn(), { hunt = true, route = { farEdgeSpawn() } })
			end
		end
		if not enc.extractionOpen and t >= enc.endsAt then
			enc.extractionOpen = true
			Services.MapService.activateExtraction()
			Net.notifyAll("Toast", { text = "The tide turns. Get to the Slipway flare!" })
			publish()
		end
		if enc.extractionOpen and allStandingAtExtraction() then
			MatchService.endEncounter(true)
		end
	end
end

function MatchService.init(registry)
	Services = registry
end

function MatchService.start()
	setState("Ferry")
	publish()

	Net.onServer("SelectCharacter", 2, onSelectCharacter)
	Net.onServer("ReturnToFerry", 2, function(player)
		if MatchService.state ~= "Results" then
			return
		end
		resultsAcknowledged[player] = true
		for p in MatchService.resultPlayers or {} do
			if p.Parent and not resultsAcknowledged[p] then
				return
			end
		end
		MatchService.leaveResults()
	end)

	local function onJoin(player)
		task.defer(function()
			Net.notify(player, "OpenCharacterSelect", {})
		end)
	end
	Players.PlayerAdded:Connect(onJoin)
	for _, player in Players:GetPlayers() do
		onJoin(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		if run then
			run.participants[player] = nil
		end
		resultsAcknowledged[player] = nil
	end)

	while true do
		task.wait(0.5)
		local ok, err = pcall(tickEncounter)
		if not ok then
			warn("[MatchService] " .. tostring(err))
		end
	end
end

return MatchService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000030"><Properties><string name="Name">PerceptionService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- How the Hushed sense players.
--   Sight: range + field-of-view cone + line-of-sight raycasts, scaled by stance, cover (reeds),
--          light (lamp pools, your torch), movement and fog.
--   Hearing: every gameplay sound is a server "noise event" {position, radius, kind, player}.
--          Footsteps are generated here from real velocity + stance, 4 times a second.
-- The current footstep noise radius is published as the character attribute "Noise" for the HUD.
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Movement = require(Shared.Config.Movement)
local Geometry = require(Shared.Util.Geometry)
local Net = require(Shared.Net)

local PerceptionService = {}
local Services

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local fogClouds = {} -- { position, radius, untilTime }

function PerceptionService.setEnemyFolder(folder)
	rayParams.FilterDescendantsInstances = { folder }
end

-- Fog Pots: smoke that blocks sight lines through (or into) it.
function PerceptionService.addFogCloud(position, radius, duration)
	table.insert(fogClouds, { position = position, radius = radius, untilTime = os.clock() + duration })
end

function PerceptionService.clearFog()
	table.clear(fogClouds)
end

local function segmentBlocked(a, b)
	local now = os.clock()
	for i = #fogClouds, 1, -1 do
		local cloud = fogClouds[i]
		if now > cloud.untilTime then
			table.remove(fogClouds, i)
		else
			local ab = b - a
			local len = ab.Magnitude
			if len > 0.01 then
				local t = math.clamp((cloud.position - a):Dot(ab) / (len * len), 0, 1)
				local closest = a + ab * t
				if (closest - cloud.position).Magnitude < cloud.radius then
					return true
				end
			end
		end
	end
	return false
end
PerceptionService.segmentBlocked = segmentBlocked

-- Returns 0 (unseen) or a positive visibility factor (higher = noticed faster).
function PerceptionService.sightFactor(enemy, info)
	local cfg = enemy.cfg
	local char, root = info.char, info.root
	local head = char:FindFirstChild("Head")
	if not head then
		return 0
	end
	local modifier = Services.MatchService.modifier or {}
	local eyes = enemy.head.Position
	local toPlayer = root.Position - eyes
	local dist = toPlayer.Magnitude
	if cfg.sightRange <= 0 then
		-- blind (Seekers): only "feel" someone moving right next to them
		local close = (root.Position - enemy.root.Position).Magnitude
		local moving = Geometry.flat(root.AssemblyLinearVelocity).Magnitude > 1
		if close < cfg.closeRange and moving and char:GetAttribute("Stance") ~= "Crouch" then
			return 3
		end
		return 0
	end
	local range = cfg.sightRange * (modifier.sightMult or 1)
	local lit = char:GetAttribute("Torch") == true or Geometry.inTagged(root.Position, "LitZone")
	if lit then
		range *= 1.45
	end
	if dist > range or dist < 0.01 then
		return 0
	end
	if dist > 4.5 and enemy.root.CFrame.LookVector:Dot(toPlayer.Unit) < enemy.fovCos then
		return 0
	end

	if segmentBlocked(eyes, root.Position) then
		return 0
	end
	local visible = false
	for _, target in { head.Position, root.Position } do
		local result = Workspace:Raycast(eyes, target - eyes, rayParams)
		if not result or result.Instance:IsDescendantOf(char) then
			visible = true
			break
		end
	end
	if not visible then
		return 0
	end

	local f = 1 - (dist / range) * 0.75
	if char:GetAttribute("Stance") == "Crouch" then
		f *= 0.55
	end
	if Geometry.inTagged(root.Position, "TallGrass") then
		f *= 0.35
	end
	if lit then
		f *= 1.8
	end
	local speed = Geometry.flat(root.AssemblyLinearVelocity).Magnitude
	if speed < 1 then
		f *= 0.6
	elseif speed > 17 then
		f *= 1.3
	end
	if dist < cfg.closeRange then
		f *= 2.5
	end
	return f
end

-- Any sound in the world that Hushed may react to.
function PerceptionService.emitNoise(position, radius, kind, player)
	local modifier = Services.MatchService.modifier or {}
	radius *= modifier.noiseMult or 1
	if radius <= 0 then
		return
	end
	if kind ~= "footstep" and radius >= 18 then
		-- show everyone how far a loud noise carried (gunshots, bottles, explosions)
		Net.notifyAll("NoiseRing", { position = position, radius = radius, kind = kind })
	end
	Services.EnemyService.onNoise({ position = position, radius = radius, kind = kind, player = player })
end

local function footstepRadius(info, now)
	local char, root, session = info.char, info.root, info.session
	local mods = session.mods
	local speed = Geometry.flat(root.AssemblyLinearVelocity).Magnitude
	if speed < 1 or char:GetAttribute("Downed") then
		return 0
	end
	local radius
	if char:GetAttribute("Stance") == "Crouch" then
		radius = Movement.Noise.Crouch * mods.crouchNoiseMult
	elseif speed < 10.5 then
		radius = Movement.Noise.Walk
	elseif speed < 17 then
		radius = Movement.Noise.Jog
	else
		radius = Movement.Noise.Sprint
	end
	if Geometry.inTagged(root.Position, "Shallows") then
		radius *= 1 + (Movement.WaterNoiseMult - 1) * mods.waterNoiseMult
	end
	local modifier = Services.MatchService.modifier or {}
	radius *= mods.noiseMult * (modifier.footstepMult or 1)
	if (session.calmUntil or 0) > now then
		radius *= 0.5
	end
	return radius
end

function PerceptionService.init(registry)
	Services = registry
end

function PerceptionService.start()
	while true do
		task.wait(0.25)
		if Services.MatchService.state == "Encounter" then
			local now = os.clock()
			for _, info in Services.MatchService.getActivePlayers() do
				local radius = footstepRadius(info, now)
				info.char:SetAttribute("Noise", math.floor(radius + 0.5))
				if radius > 0 then
					PerceptionService.emitNoise(info.root.Position, radius, "footstep", info.player)
				end
			end
		end
	end
end

return PerceptionService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000031"><Properties><string name="Name">PlayerDataService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Persistent player data (tokens, stats, purchase receipts) in a DataStore.
-- Stage 9 replaces this with ProfileStore (session locking); the API stays the same.
-- In Studio without "Enable Studio Access to API Services", it falls back to memory only.
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Game = require(Shared.Config.Game)

local PlayerDataService = {}

local STORE_NAME = "Aftertide_Player_v1"
local AUTOSAVE_INTERVAL = 120
local MAX_RECEIPTS = 50

local store = nil
local memoryOnly = false
local profiles = {} -- [Player] = { data = table, noSave = bool, loaded = bool }

local function defaultData()
	return {
		version = 1,
		tokens = { secondWind = Game.StartingTokens.secondWind, resupply = Game.StartingTokens.resupply },
		stats = { runs = 0, wins = 0, takedowns = 0, encounters = 0, bestPall = 0 },
		receipts = {},
		receiptOrder = {},
		lastDailyWin = "",
		scrip = 0, -- homebase currency, earned only by playing
		repairs = {}, -- [repairId] = true
		settings = { graphics = "Auto", sensitivity = 1, reduceMotion = false },
	}
end

local function reconcile(data)
	local template = defaultData()
	for key, value in template do
		if data[key] == nil then
			data[key] = value
		elseif type(value) == "table" and type(data[key]) == "table" and key ~= "receipts" and key ~= "receiptOrder" and key ~= "repairs" then
			for k2, v2 in value do
				if data[key][k2] == nil then
					data[key][k2] = v2
				end
			end
		end
	end
	return data
end

local function keyFor(player)
	return "u_" .. player.UserId
end

local function publishTokens(player, data)
	for kind, amount in data.tokens do
		player:SetAttribute("Tokens_" .. kind, amount)
	end
	player:SetAttribute("Scrip", data.scrip)
	player:SetAttribute("Repairs", HttpService:JSONEncode(data.repairs))
	player:SetAttribute("Set_graphics", data.settings.graphics)
	player:SetAttribute("Set_sensitivity", data.settings.sensitivity)
	player:SetAttribute("Set_reduceMotion", data.settings.reduceMotion)
end

function PlayerDataService.publish(player)
	local data = PlayerDataService.get(player)
	if data then
		publishTokens(player, data)
	end
end

function PlayerDataService.addScrip(player, amount)
	local data = PlayerDataService.get(player)
	if not data then
		return false
	end
	data.scrip += amount
	publishTokens(player, data)
	return true
end

function PlayerDataService.spendScrip(player, amount)
	local data = PlayerDataService.get(player)
	if not data or data.scrip < amount then
		return false
	end
	data.scrip -= amount
	publishTokens(player, data)
	return true
end

function PlayerDataService.hasRepair(player, repairId)
	local data = PlayerDataService.get(player)
	return data ~= nil and data.repairs[repairId] == true
end

function PlayerDataService.addRepair(player, repairId)
	local data = PlayerDataService.get(player)
	if data then
		data.repairs[repairId] = true
		publishTokens(player, data)
	end
end

function PlayerDataService.setSettings(player, settings)
	local data = PlayerDataService.get(player)
	if data then
		data.settings = settings
		publishTokens(player, data)
	end
end

local function load(player)
	if memoryOnly then
		return defaultData(), false
	end
	for attempt = 1, 3 do
		local ok, result = pcall(function()
			return store:GetAsync(keyFor(player))
		end)
		if ok then
			return reconcile(result or defaultData()), false
		end
		warn(("[PlayerData] load attempt %d failed for %s: %s"):format(attempt, player.Name, tostring(result)))
		task.wait(attempt)
	end
	-- Don't overwrite real data with defaults if loading failed.
	return defaultData(), true
end

function PlayerDataService.save(player)
	local profile = profiles[player]
	if not profile or not profile.loaded then
		return false
	end
	if memoryOnly then
		return true
	end
	if profile.noSave then
		return false
	end
	local ok, err = pcall(function()
		store:UpdateAsync(keyFor(player), function()
			return profile.data
		end)
	end)
	if not ok then
		warn(("[PlayerData] save failed for %s: %s"):format(player.Name, tostring(err)))
	end
	return ok
end

function PlayerDataService.isMemoryOnly()
	return memoryOnly
end

function PlayerDataService.get(player)
	local profile = profiles[player]
	return profile and profile.loaded and profile.data or nil
end

function PlayerDataService.waitFor(player, timeout)
	local deadline = os.clock() + (timeout or 15)
	while player.Parent and os.clock() < deadline do
		local data = PlayerDataService.get(player)
		if data then
			return data
		end
		task.wait(0.2)
	end
	return nil
end

function PlayerDataService.addTokens(player, kind, amount)
	local data = PlayerDataService.get(player)
	if not data or data.tokens[kind] == nil then
		return false
	end
	data.tokens[kind] += amount
	publishTokens(player, data)
	return true
end

function PlayerDataService.useToken(player, kind)
	local data = PlayerDataService.get(player)
	if not data or (data.tokens[kind] or 0) < 1 then
		return false
	end
	data.tokens[kind] -= 1
	publishTokens(player, data)
	return true
end

function PlayerDataService.hasReceipt(player, purchaseId)
	local data = PlayerDataService.get(player)
	return data ~= nil and data.receipts[purchaseId] == true
end

function PlayerDataService.recordReceipt(player, purchaseId)
	local data = PlayerDataService.get(player)
	if not data then
		return
	end
	data.receipts[purchaseId] = true
	table.insert(data.receiptOrder, purchaseId)
	while #data.receiptOrder > MAX_RECEIPTS do
		local oldest = table.remove(data.receiptOrder, 1)
		data.receipts[oldest] = nil
	end
end

local function onPlayerAdded(player)
	profiles[player] = { loaded = false }
	local data, noSave = load(player)
	if not player.Parent then
		profiles[player] = nil
		return
	end
	profiles[player] = { data = data, noSave = noSave, loaded = true }
	publishTokens(player, data)
	if noSave then
		warn("[PlayerData] " .. player.Name .. " is in no-save mode (DataStore unavailable)")
	end
end

local function onPlayerRemoving(player)
	PlayerDataService.save(player)
	profiles[player] = nil
end

function PlayerDataService.init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
		if RunService:IsStudio() then
			-- Probe once: Studio without API access throws here.
			local probeOk = pcall(function()
				store:GetAsync("probe")
			end)
			if not probeOk then
				memoryOnly = true
			end
		end
	else
		memoryOnly = true
	end
	if memoryOnly then
		warn("[PlayerData] DataStores unavailable: using memory only (enable Studio API access to test saving)")
	end
end

function PlayerDataService.start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	game:BindToClose(function()
		local pending = 0
		for _, player in Players:GetPlayers() do
			pending += 1
			task.spawn(function()
				PlayerDataService.save(player)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)

	while true do
		task.wait(AUTOSAVE_INTERVAL)
		for _, player in Players:GetPlayers() do
			task.spawn(PlayerDataService.save, player)
		end
	end
end

return PlayerDataService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000032"><Properties><string name="Name">WeaponService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Guns and the bow, fully server-authoritative:
--   * equip/holster (long gun on the back, sidearm on the hip; models replicate to everyone)
--   * fire: client sends only aim direction + whether it's aiming; the server applies spread
--     (hip/aim/moving/crouched + upgrades), raycasts, scores headshots, deals damage,
--     emits gunshot NOISE (stealth trade-off) and broadcasts shot FX to all clients
--   * reload from reserve ammo (timed; cancelled by swapping or going down)
--   * bow arrows are simulated projectiles with drop
-- Character attributes: Equipped (weapon id or ""), EquippedSlot, ReloadUntil (server time).
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Weapons = require(Shared.Config.Weapons)
local Upgrades = require(Shared.Config.Upgrades)
local WeaponModels = require(Shared.WeaponModels)
local Net = require(Shared.Net)
local Geometry = require(Shared.Util.Geometry)
local Sfx = require(Shared.Util.Sfx)

local WeaponService = {}
local Services

local rng = Random.new()
local models = {} -- [Player] = { long = Model?, sidearm = Model? }
local state = {} -- [Player] = { nextFireAt, equipReadyAt, reloadId, reloadSlot }

local MOD_DEFAULTS = {
	damageMult = 1, reloadMult = 1, noiseMult = 1, recoilMult = 1, spreadMult = 1,
	aimSpreadMult = 1, fireDelayMult = 1, magBonus = 0, aimFovMult = 1,
}

local function st(player)
	local s = state[player]
	if not s then
		s = { nextFireAt = 0, equipReadyAt = 0, reloadId = 0 }
		state[player] = s
	end
	return s
end

-- Combined modifiers from workbench upgrades for one weapon.
function WeaponService.mods(player, weaponId)
	local result = table.clone(MOD_DEFAULTS)
	local session = Services.CharacterService.getSession(player)
	local owned = session and session.run and session.run.weapons[weaponId]
	if owned then
		for _, upg in Upgrades.Weapon[weaponId] or {} do
			if owned[upg.id] then
				for key, value in upg.mods do
					if key == "magBonus" then
						result[key] += value
					else
						result[key] *= value
					end
				end
			end
		end
	end
	if session and session.mods then
		result.aimSpreadMult *= session.mods.aimSpreadMult
	end
	return result
end

function WeaponService.magSize(player, weaponId)
	local def = Weapons.List[weaponId]
	return def and (def.mag + WeaponService.mods(player, weaponId).magBonus) or 0
end

-- Replicates per-weapon stats the client needs (mag size, fov, recoil) as JSON.
function WeaponService.publishStats(player)
	local out = {}
	for slot, w in Services.InventoryService.weaponSlots(player) do
		local mods = WeaponService.mods(player, w.id)
		local def = Weapons.List[w.id]
		out[slot] = {
			id = w.id,
			mag = WeaponService.magSize(player, w.id),
			fov = def.aimFov * mods.aimFovMult,
			recoil = def.recoil * mods.recoilMult,
			spreadHip = def.spreadHip * mods.spreadMult,
			spreadAim = def.spreadAim * mods.spreadMult * mods.aimSpreadMult,
			fireDelay = def.fireDelay * mods.fireDelayMult,
		}
	end
	player:SetAttribute("WeaponStats", HttpService:JSONEncode(out))
end

-- Models ------------------------------------------------------------------------------------

local function mount(model, part0, offset)
	local grip = model.PrimaryPart
	local weld = grip:FindFirstChild("Mount")
	if not weld then
		weld = Instance.new("Weld")
		weld.Name = "Mount"
		weld.Parent = grip
	end
	weld.Part0 = part0
	weld.Part1 = grip
	weld.C0 = offset
	weld.C1 = CFrame.new()
end

local function placeModels(player, char, equippedSlot)
	local set = models[player]
	if not set then
		return
	end
	local hand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
	local back = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
	local hip = char:FindFirstChild("LowerTorso") or char:FindFirstChild("Torso")
	for slot, model in set do
		if slot == equippedSlot and hand then
			mount(model, hand, WeaponModels.HandOffset)
		elseif slot == "long" and back then
			mount(model, back, WeaponModels.BackOffset)
		elseif hip then
			mount(model, hip, WeaponModels.HipOffset)
		end
	end
end

function WeaponService.onSpawn(player, char)
	if models[player] then
		for _, m in models[player] do
			m:Destroy()
		end
	end
	models[player] = {}
	for slot, w in Services.InventoryService.weaponSlots(player) do
		local kit = "Weapon_" .. w.id
		local run = Services.CharacterService.getSession(player).run
		local skip = (w.id == "rifle" and not (run.weapons.rifle and run.weapons.rifle.scope)) and { Scope = true } or nil
		local model = Services.AssetService.hasKit(kit) and WeaponModels.build(w.id, Services.AssetService.part, Services.AssetService.meta(kit), skip) or WeaponModels.build(w.id)
		if model then
			model.Name = "Weapon_" .. slot
			model:PivotTo(char:GetPivot())
			model.Parent = char
			models[player][slot] = model
		end
	end
	char:SetAttribute("Equipped", "")
	char:SetAttribute("EquippedSlot", "none")
	char:SetAttribute("ReloadUntil", 0)
	placeModels(player, char, "none")
	local s = st(player)
	s.reloadId += 1
	s.nextFireAt = 0
	WeaponService.publishStats(player)
end

function WeaponService.muzzlePosition(player)
	local char = player.Character
	local slot = char and char:GetAttribute("EquippedSlot")
	local model = models[player] and models[player][slot]
	local muzzle = model and model.PrimaryPart and model.PrimaryPart:FindFirstChild("Muzzle")
	return muzzle and muzzle.WorldPosition or nil
end

-- Actions -----------------------------------------------------------------------------------

local function swapTime(player)
	local session = Services.CharacterService.getSession(player)
	local fast = session and session.run and session.run.general.holster
	return Weapons.SwapTime * (fast and 0.5 or 1)
end

function WeaponService.equip(player, slot)
	if slot ~= "long" and slot ~= "sidearm" and slot ~= "none" then
		return
	end
	local char = player.Character
	if not char then
		return
	end
	local session = Services.CharacterService.getSession(player)
	if session and (session.downed or session.out) then
		return
	end
	local weaponId = ""
	if slot ~= "none" then
		local w = Services.InventoryService.weapon(player, slot)
		if not w then
			return
		end
		weaponId = w.id
	end
	if char:GetAttribute("EquippedSlot") == slot then
		return
	end
	local s = st(player)
	s.reloadId += 1 -- cancel reload
	char:SetAttribute("ReloadUntil", 0)
	s.equipReadyAt = os.clock() + swapTime(player)
	char:SetAttribute("Equipped", weaponId)
	char:SetAttribute("EquippedSlot", slot)
	placeModels(player, char, slot)
end

function WeaponService.holster(player)
	WeaponService.equip(player, "none")
end

local function spreadDirection(dir, degrees)
	if degrees <= 0 then
		return dir
	end
	local angle = math.rad(degrees) * math.sqrt(rng:NextNumber())
	local roll = rng:NextNumber() * math.pi * 2
	local up = math.abs(dir.Y) > 0.98 and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0)
	local basis = CFrame.lookAt(Vector3.zero, dir, up)
	return (basis * CFrame.Angles(0, 0, roll) * CFrame.Angles(angle, 0, 0)).LookVector
end

local function excludeList(char)
	local list = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	if not table.find(list, char) then
		table.insert(list, char)
	end
	return list
end

-- Applies damage for a hit. Returns "enemy" | "world" | nil plus hit flags.
local function applyHit(player, def, mods, result, distance)
	if not result then
		return nil
	end
	local e = Services.EnemyService.fromInstance(result.Instance)
	if not e then
		return "world"
	end
	local headshot = result.Instance.Name == "Head"
	local headMult = 1 + (def.headMult - 1) * (e.cfg.headMultScale or 1)
	local damage = def.damage * mods.damageMult * (headshot and headMult or 1)
	if def.falloff then
		damage *= math.clamp(1 - (distance / def.range) * 0.6, 0.35, 1)
	end
	local killed = Services.EnemyService.damage(e, damage, player, headshot)
	return "enemy", headshot, killed
end

local function simulateArrow(player, def, mods, origin, direction, params)
	local position = origin
	local velocity = direction * def.projectile.speed
	local gravity = Vector3.new(0, -Workspace.Gravity * def.projectile.gravityScale, 0)
	local arrow = Instance.new("Part")
	arrow.Name = "Arrow"
	arrow.Anchored = true
	arrow.CanCollide = false
	arrow.CanQuery = false
	arrow.CanTouch = false
	arrow.Size = Vector3.new(0.06, 0.06, 1.6)
	arrow.Color = Color3.fromRGB(214, 206, 188)
	arrow.Material = Enum.Material.Wood
	arrow.CFrame = CFrame.lookAt(position, position + velocity)
	arrow.Parent = Workspace
	local travelled, age = 0, 0
	local conn
	conn = RunService.Heartbeat:Connect(function(dt)
		age += dt
		velocity += gravity * dt
		local step = velocity * dt
		local result = Workspace:Raycast(position, step, params)
		if result or travelled > def.range or age > 3 then
			conn:Disconnect()
			if result then
				arrow.CFrame = CFrame.lookAt(result.Position - step.Unit * 0.6, result.Position)
				local kind, headshot, killed = applyHit(player, def, mods, result, travelled)
				if kind ~= "enemy" then
					Services.PerceptionService.emitNoise(result.Position, 12, "impact", nil) -- arrows make a good distraction
				end
				if kind == "enemy" then
					Net.notify(player, "Hit", { headshot = headshot, kill = killed })
					arrow:Destroy()
				else
					task.delay(8, function()
						arrow:Destroy()
					end)
				end
				Net.notifyAll("Impact", { position = result.Position, kind = kind or "world" })
			else
				arrow:Destroy()
			end
			return
		end
		position += step
		travelled += step.Magnitude
		arrow.CFrame = CFrame.lookAt(position, position + velocity)
	end)
end

function WeaponService.reload(player, info)
	local char = info.char
	local slot = char:GetAttribute("EquippedSlot")
	local w = Services.InventoryService.weapon(player, slot)
	if not w then
		return
	end
	local def = Weapons.List[w.id]
	local size = WeaponService.magSize(player, w.id)
	local s = st(player)
	if w.mag >= size or Services.InventoryService.count(player, def.ammo) < 1 then
		return
	end
	if (char:GetAttribute("ReloadUntil") or 0) > Workspace:GetServerTimeNow() then
		return
	end
	local mods = WeaponService.mods(player, w.id)
	local duration = def.reload * mods.reloadMult
	s.reloadId += 1
	local id = s.reloadId
	char:SetAttribute("ReloadUntil", Workspace:GetServerTimeNow() + duration)
	Sfx.at(info.root.Position, "Reload", 0.4, 30)
	task.delay(duration, function()
		if s.reloadId ~= id or not char.Parent then
			return
		end
		char:SetAttribute("ReloadUntil", 0)
		local session = Services.CharacterService.getSession(player)
		if not session or session.downed or session.out or char:GetAttribute("EquippedSlot") ~= slot then
			return
		end
		local need = size - w.mag
		local have = Services.InventoryService.count(player, def.ammo)
		local moved = math.min(need, have)
		if moved > 0 and Services.InventoryService.take(player, def.ammo, moved) then
			Services.InventoryService.setMag(player, slot, w.mag + moved)
		end
	end)
end

function WeaponService.fire(player, info, direction, aiming)
	if not Geometry.isSaneVector(direction, 2) or direction.Magnitude < 0.5 then
		return
	end
	direction = direction.Unit
	local char = info.char
	local slot = char:GetAttribute("EquippedSlot")
	local w = Services.InventoryService.weapon(player, slot)
	if not w then
		return
	end
	local s = st(player)
	local now = os.clock()
	if now < s.nextFireAt or now < s.equipReadyAt then
		return
	end
	if (char:GetAttribute("ReloadUntil") or 0) > Workspace:GetServerTimeNow() then
		return
	end
	if os.clock() < info.session.busyUntil then
		return
	end
	local def = Weapons.List[w.id]
	local mods = WeaponService.mods(player, w.id)
	if w.mag < 1 then
		Sfx.at(info.root.Position, "DryFire", 0.4, 20)
		WeaponService.reload(player, info)
		return
	end
	s.nextFireAt = now + def.fireDelay * mods.fireDelayMult * 0.9 -- small latency allowance
	Services.InventoryService.setMag(player, slot, w.mag - 1)

	-- spread
	local spread = (aiming == true) and def.spreadAim * mods.spreadMult * mods.aimSpreadMult or def.spreadHip * mods.spreadMult
	local speed = Geometry.flat(info.root.AssemblyLinearVelocity).Magnitude
	if speed > 2 then
		spread += def.moveSpread * math.clamp(speed / 14, 0, 1.5)
	end
	if char:GetAttribute("Stance") == "Crouch" then
		spread *= 0.8
	end

	local head = char:FindFirstChild("Head")
	local origin = head and head.Position or info.root.Position + Vector3.new(0, 1.5, 0)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = excludeList(char)
	local muzzle = WeaponService.muzzlePosition(player) or origin

	Services.PerceptionService.emitNoise(origin, def.noise * mods.noiseMult, "gunshot", player)
	-- the gunshot sound is played by every client (instantly for the shooter) from the Shot event

	if def.projectile then
		simulateArrow(player, def, mods, origin + direction * 0.8, spreadDirection(direction, spread), params)
		Net.notifyAll("Shot", { shooter = player.UserId, weapon = w.id, from = muzzle, hits = {}, quiet = mods.noiseMult < 1 })
	else
		local hits, anyHead, anyKill, anyEnemy = {}, false, false, false
		local impactNoise = nil
		for _ = 1, def.pellets do
			local dir = spreadDirection(direction, spread)
			local result = Workspace:Raycast(origin, dir * def.range, params)
			local hitPos = result and result.Position or origin + dir * def.range
			local kind, headshot, killed = applyHit(player, def, mods, result, (hitPos - origin).Magnitude)
			table.insert(hits, { position = hitPos, kind = kind or "none" })
			if kind == "world" then
				impactNoise = hitPos -- stray rounds clatter: Hushed near the impact come to look
			end
			if kind == "enemy" then
				anyEnemy = true
				anyHead = anyHead or headshot
				anyKill = anyKill or killed
			end
		end
		if anyEnemy then
			Net.notify(player, "Hit", { headshot = anyHead, kill = anyKill })
		end
		if impactNoise then
			Services.PerceptionService.emitNoise(impactNoise, 14, "impact", nil)
		end
		Net.notifyAll("Shot", { shooter = player.UserId, weapon = w.id, from = muzzle, hits = hits, quiet = mods.noiseMult < 1 })
	end

	if def.autoReload and w.mag <= 0 then
		task.delay(def.fireDelay * mods.fireDelayMult * 0.5, function()
			local liveInfo = Services.MatchService.getActiveInfo(player)
			if liveInfo then
				WeaponService.reload(player, liveInfo)
			end
		end)
	end
end

function WeaponService.onDowned(player)
	local s = st(player)
	s.reloadId += 1
	local char = player.Character
	if char then
		char:SetAttribute("ReloadUntil", 0)
		char:SetAttribute("Equipped", "")
		char:SetAttribute("EquippedSlot", "none")
		placeModels(player, char, "none")
	end
end

function WeaponService.init(registry)
	Services = registry
end

function WeaponService.start()
	Players.PlayerRemoving:Connect(function(player)
		models[player] = nil
		state[player] = nil
	end)
	Net.onServer("Look", 12, function(player, pitch)
		if type(pitch) ~= "number" or pitch ~= pitch then
			return
		end
		local char = player.Character
		if char then
			char:SetAttribute("AimPitch", math.floor(math.clamp(pitch, -1.3, 1.3) * 100) / 100)
		end
	end)
end

return WeaponService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000033"><Properties><string name="Name">WorkbenchService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The Meridian's workbench, used between encounters (Planning phase) with Salvage found in
-- the run: weapon parts, satchel upgrades, and your character's other perks.
-- Upgrades last for the current crossing only (roguelike), like everything in the satchel.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Characters = require(Shared.Config.Characters)
local Upgrades = require(Shared.Config.Upgrades)
local Net = require(Shared.Net)

local WorkbenchService = {}
local Services

local function toast(player, text)
	Net.notify(player, "Toast", { text = text })
end

local function cost(player, base)
	local discount = Services.PlayerDataService.hasRepair(player, "workshop") and 0.85 or 1
	return math.ceil(base * discount)
end

local function canUse(player)
	local session = Services.CharacterService.getSession(player)
	if not session or not session.runId or not Services.MatchService.isPlanning() then
		toast(player, "The workbench is used between encounters during a crossing")
		return nil
	end
	return session
end

local function pay(player, amount)
	if Services.InventoryService.spendSalvage(player, amount) then
		return true
	end
	toast(player, ("Need %d Salvage"):format(amount))
	return false
end

function WorkbenchService.costFor(player, base)
	return cost(player, base)
end

function WorkbenchService.buyWeapon(player, weaponId, upgradeId)
	local session = canUse(player)
	if not session or type(weaponId) ~= "string" or type(upgradeId) ~= "string" then
		return
	end
	local owns = false
	for _, w in Services.InventoryService.weaponSlots(player) do
		if w.id == weaponId then
			owns = true
		end
	end
	if not owns then
		return
	end
	local upgrade
	for _, u in Upgrades.Weapon[weaponId] or {} do
		if u.id == upgradeId then
			upgrade = u
		end
	end
	session.run.weapons[weaponId] = session.run.weapons[weaponId] or {}
	if not upgrade or session.run.weapons[weaponId][upgradeId] then
		return
	end
	if pay(player, cost(player, upgrade.cost)) then
		session.run.weapons[weaponId][upgradeId] = true
		Services.CharacterService.publishRun(player)
		Services.WeaponService.publishStats(player)
		toast(player, "Fitted: " .. upgrade.name)
	end
end

function WorkbenchService.buyGeneral(player, upgradeId)
	local session = canUse(player)
	if not session or type(upgradeId) ~= "string" then
		return
	end
	for _, u in Upgrades.General do
		if u.id == upgradeId and not session.run.general[upgradeId] then
			if pay(player, cost(player, u.cost)) then
				session.run.general[upgradeId] = true
				Services.CharacterService.publishRun(player)
				Services.InventoryService.publish(player)
				toast(player, "Upgraded: " .. u.name)
			end
			return
		end
	end
end

function WorkbenchService.buyPerk(player, perkId)
	local session = canUse(player)
	if not session or type(perkId) ~= "string" or perkId == session.perkId or session.run.perks[perkId] then
		return
	end
	for _, perk in Characters.List[session.charId].perks do
		if perk.id == perkId then
			if pay(player, cost(player, Upgrades.PerkCost)) then
				session.run.perks[perkId] = true
				Services.CharacterService.refreshMods(player)
				Services.InventoryService.publish(player)
				toast(player, "Learned: " .. perk.name)
			end
			return
		end
	end
end

function WorkbenchService.init(registry)
	Services = registry
end

return WorkbenchService
]]></ProtectedString></Properties></Item>
</Item>
</Item>
</Item>
<Item class="StarterPlayer" referent="RBX00000052"><Properties><string name="Name">StarterPlayer</string><bool name="EnableMouseLockOption">false</bool><bool name="LoadCharacterAppearance">false</bool><float name="CharacterJumpPower">0</float></Properties><Item class="StarterPlayerScripts" referent="RBX00000051"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX00000050"><Properties><string name="Name">Client</string></Properties><Item class="Folder" referent="RBX00000042"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX00000037"><Properties><string name="Name">ActionController</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Input bindings (keyboard/mouse, gamepad, touch buttons) -> intents sent to the server.
--
--   Keyboard/mouse                     Gamepad
--   WASD move, Shift sprint            L-stick, L3 sprint (toggle)
--   C / Ctrl crouch                    B crouch
--   RMB aim, LMB fire                  L2 aim, R2 fire
--   1 long gun, 2 sidearm, 3 holster   D-pad right: cycle weapons
--   R reload (Second Wind if downed)   X: Quieting/shove near a Hushed, else reload
--   F Quieting / shove                 (X, contextual)
--   G throw, Z next throwable          R1 throw, D-pad down next throwable
--   Space dodge (dive when sprinting)  L1 dodge (dive when sprinting)
--   Q ability, H heal, T torch         Y ability, D-pad up heal, D-pad left torch
--   X swap shoulder, Tab satchel       R3 shoulder, View/Back satchel
--   B resupply, P settings             Start/Menu: Roblox menu
local ContextActionService = game:GetService("ContextActionService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local State = require(script.Parent.Parent.State)

local ActionController = {}
local Controllers

local Begin = Enum.UserInputState.Begin
local End = Enum.UserInputState.End
local Sink = Enum.ContextActionResult.Sink
local Pass = Enum.ContextActionResult.Pass

local function act(name, payload)
	Net.event("Action"):FireServer(name, payload)
end

local function isTouch(input)
	return input and input.UserInputType == Enum.UserInputType.Touch
end

local function canAct()
	return State.character ~= nil and not State.uiOpen() and not State.downed
end

local touchLayout = {
	Fire = { title = "Fire", pos = UDim2.new(1, -95, 1, -230) },
	Aim = { title = "Aim", pos = UDim2.new(1, -170, 1, -230) },
	Reload = { title = "Reload", pos = UDim2.new(1, -245, 1, -230) },
	Quiet = { title = "Quiet", pos = UDim2.new(1, -95, 1, -160) },
	Throw = { title = "Throw", pos = UDim2.new(1, -170, 1, -160) },
	Ability = { title = "Skill", pos = UDim2.new(1, -245, 1, -160) },
	Crouch = { title = "Crouch", pos = UDim2.new(1, -95, 1, -300) },
	Sprint = { title = "Sprint", pos = UDim2.new(1, -170, 1, -300) },
	Weapon = { title = "Weapon", pos = UDim2.new(1, -245, 1, -300) },
	Heal = { title = "Heal", pos = UDim2.new(1, -320, 1, -230) },
	Satchel = { title = "Bag", pos = UDim2.new(1, -320, 1, -300) },
	Dodge = { title = "Dodge", pos = UDim2.new(1, -320, 1, -160) },
}

local function bind(name, handler, ...)
	local touch = touchLayout[name] ~= nil
	ContextActionService:BindAction(name, function(_, inputState, input)
		return handler(inputState, input) or Sink
	end, touch, ...)
	if touch then
		ContextActionService:SetTitle(name, touchLayout[name].title)
		ContextActionService:SetPosition(name, touchLayout[name].pos)
	end
end

local function enemyNearby(radius)
	local enemies = Workspace:FindFirstChild("Enemies")
	local root = State.root
	if not enemies or not root then
		return false
	end
	for _, model in enemies:GetChildren() do
		local r = model:FindFirstChild("HumanoidRootPart")
		if r and model:GetAttribute("State") ~= "Dispersed" and (r.Position - root.Position).Magnitude <= radius then
			return true
		end
	end
	return false
end

function ActionController.init(registry)
	Controllers = registry
end

function ActionController.start()
	local Movement = Controllers.MovementController
	local Weapon = Controllers.WeaponController

	bind("Aim", function(state, input)
		if state == End and not isTouch(input) then
			Movement.setAim(false)
			return
		end
		if not canAct() then
			return Pass
		end
		if isTouch(input) then
			if state == Begin then
				Movement.setAim(not State.aiming)
			end
		elseif state == Begin then
			Movement.setAim(true)
		end
	end, Enum.UserInputType.MouseButton2, Enum.KeyCode.ButtonL2)

	bind("Fire", function(state)
		if not canAct() then
			return Pass
		end
		if state == Begin then
			Weapon.fire()
		end
	end, Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2)

	bind("Reload", function(state)
		if state ~= Begin or not State.character then
			return
		end
		if State.downed then
			act("SecondWind")
		elseif canAct() then
			Weapon.reload()
		end
	end, Enum.KeyCode.R)

	bind("Quiet", function(state, input)
		if state ~= Begin or not canAct() then
			return
		end
		local isPad = input and input.KeyCode == Enum.KeyCode.ButtonX
		local _, equipped = Weapon.current()
		if isPad and equipped and not enemyNearby(6) then
			Weapon.reload() -- contextual: no Hushed in reach, so X reloads
		else
			act("Quiet")
		end
	end, Enum.KeyCode.F, Enum.KeyCode.ButtonX)

	bind("Equip1", function(state)
		if state == Begin and canAct() then
			Weapon.equip("long")
		end
	end, Enum.KeyCode.One)
	bind("Equip2", function(state)
		if state == Begin and canAct() then
			Weapon.equip("sidearm")
		end
	end, Enum.KeyCode.Two)
	bind("Holster", function(state)
		if state == Begin and canAct() then
			act("Equip", "none")
		end
	end, Enum.KeyCode.Three)
	bind("Weapon", function(state)
		if state == Begin and canAct() then
			Weapon.cycleWeapon()
		end
	end, Enum.KeyCode.DPadRight)

	bind("Throw", function(state)
		if state == Begin and canAct() then
			Weapon.throw()
		end
	end, Enum.KeyCode.G, Enum.KeyCode.ButtonR1)
	bind("NextThrowable", function(state)
		if state == Begin and State.character then
			Weapon.cycleThrowable()
		end
	end, Enum.KeyCode.Z, Enum.KeyCode.DPadDown)

	bind("Dodge", function(state)
		if state == Begin and canAct() then
			Movement.dodge()
		end
	end, Enum.KeyCode.Space, Enum.KeyCode.ButtonL1)

	bind("Ability", function(state)
		if state == Begin and canAct() then
			act("Ability")
		end
	end, Enum.KeyCode.Q, Enum.KeyCode.ButtonY)
	bind("Heal", function(state)
		if state == Begin and canAct() then
			act("Heal")
		end
	end, Enum.KeyCode.H, Enum.KeyCode.DPadUp)
	bind("Torch", function(state)
		if state == Begin and State.character and not State.downed then
			act("Torch")
		end
	end, Enum.KeyCode.T, Enum.KeyCode.DPadLeft)

	bind("Crouch", function(state)
		if state == Begin and State.character then
			Movement.toggleCrouch()
		end
	end, Enum.KeyCode.C, Enum.KeyCode.LeftControl, Enum.KeyCode.ButtonB)

	bind("Sprint", function(state, input)
		if not State.character then
			return Pass
		end
		local toggle = isTouch(input) or (input and input.KeyCode == Enum.KeyCode.ButtonL3)
		if toggle then
			if state == Begin then
				Movement.setSprint(not State.sprinting, true)
			end
		elseif state == Begin then
			Movement.setSprint(true, false)
		elseif state == End then
			Movement.setSprint(false, false)
		end
	end, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3)

	bind("Shoulder", function(state)
		if state == Begin then
			State.shoulder = -State.shoulder
		end
	end, Enum.KeyCode.X, Enum.KeyCode.ButtonR3)

	bind("Satchel", function(state)
		if state == Begin and State.character then
			Controllers.UIController.toggleSatchel()
		end
	end, Enum.KeyCode.Tab, Enum.KeyCode.ButtonSelect)

	bind("Resupply", function(state)
		if state == Begin and canAct() then
			act("Resupply")
		end
	end, Enum.KeyCode.B)

	bind("Settings", function(state)
		if state == Begin then
			Controllers.UIController.toggleSettings()
		end
	end, Enum.KeyCode.P)
end

function ActionController.sendAction(name, payload)
	act(name, payload)
end

function ActionController.request(kind, a, b)
	Net.event("Request"):FireServer(kind, a, b)
end

return ActionController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000038"><Properties><string name="Name">AnimationController</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Locomotion for custom realistic rigs that don't carry Roblox's default "Animate" script:
-- blends idle / walk / run (and crouch variants) by speed using the animation IDs in
-- Config/Rigs.Animations. Characters with an Animate script (the placeholder mannequin,
-- or rigs you gave one) are left alone.
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Rigs = require(Shared.Config.Rigs)
local State = require(script.Parent.Parent.State)

local AnimationController = {}

local tracks = nil

local function load(animator, id)
	if not id or id == "" then
		return nil
	end
	local anim = Instance.new("Animation")
	anim.AnimationId = id
	local ok, track = pcall(function()
		return animator:LoadAnimation(anim)
	end)
	if ok and track then
		track.Looped = true
		track:Play(0.2, 0.001)
		return track
	end
	return nil
end

function AnimationController.onCharacter(char)
	tracks = nil
	if char:FindFirstChild("Animate") or Rigs.Animations.idle == "" then
		return
	end
	local humanoid = char:WaitForChild("Humanoid")
	local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
	tracks = {}
	for name, id in Rigs.Animations do
		tracks[name] = load(animator, id)
	end
end

local function weight(track, w, dt)
	if track then
		track:AdjustWeight(math.max(0.001, w), math.min(0.2, dt * 4))
	end
end

function AnimationController.start()
	RunService.RenderStepped:Connect(function(dt)
		if not tracks or not State.root then
			return
		end
		local v = State.root.AssemblyLinearVelocity
		local speed = Vector3.new(v.X, 0, v.Z).Magnitude
		local crouch = State.crouched or State.downed
		local moving = math.clamp(speed / 8, 0, 1)
		local running = math.clamp((speed - 12) / 6, 0, 1)
		weight(tracks.idle, crouch and 0 or (1 - moving), dt)
		weight(tracks.walk, crouch and 0 or moving * (1 - running), dt)
		weight(tracks.run, crouch and 0 or running, dt)
		weight(tracks.crouchIdle, crouch and (1 - moving) or 0, dt)
		weight(tracks.crouchWalk, crouch and moving or 0, dt)
		for _, track in tracks do
			if track then
				track:AdjustSpeed(math.clamp(speed / 12, 0.6, 1.6))
			end
		end
	end)
end

return AnimationController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000039"><Properties><string name="Name">CameraController</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Over-the-shoulder camera: spring-smoothed focus and offset, spherecast collision that snaps
-- in and eases out, per-state framing (explore / crouch / sprint / aim / takedown), shoulder
-- swap, and mouse / gamepad / touch look.
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Game = require(Shared.Config.Game)
local Spring = require(Shared.Util.Spring)
local State = require(script.Parent.Parent.State)

local CameraController = {}
local Controllers
local player = Players.LocalPlayer
local recoilYaw = 0
local recoilPitch = 0 -- temporary kick that springs back (most of it)
local fovPunch = 0

local SENS_MOUSE = 0.0028
local SENS_PAD = 3.0
local SENS_TOUCH = 0.0065
local PITCH_MIN, PITCH_MAX = -1.2, 0.95

local yaw, pitch = 0, -0.12
local padLook = Vector2.zero
local touchInput, lastTouchPos = nil, nil

local focusSpring = Spring.new(Vector3.zero, 7)
local offsetSpring = Spring.new(Vector3.new(1.7, 0.5, 6.2), 5)
local fovSpring = Spring.new(70, 4)
local currentDist = 6
local needsSnap = true
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude

function CameraController.getYaw()
	return yaw
end

function CameraController.getPitch()
	return pitch
end

-- Recoil: the view climbs (you pull it back down), with a little sideways jitter.
function CameraController.kick(degrees)
	recoilPitch += math.rad(degrees) * 0.6
	pitch += math.rad(degrees) * 0.08 -- a little permanent climb to manage
	recoilYaw += math.rad(degrees) * (math.random() - 0.5) * 0.35
	fovPunch = math.min(fovPunch + degrees * 0.35, 4)
end

local function sensitivity()
	return player:GetAttribute("Set_sensitivity") or 1
end

-- Direction from the character's head toward whatever is under the screen centre.
function CameraController.aimDirection()
	local camera = Workspace.CurrentCamera
	local origin = camera.CFrame.Position
	local look = camera.CFrame.LookVector * 250
	local hit = Workspace:Raycast(origin, look, params)
	local point = hit and hit.Position or origin + look
	local head = State.character and State.character:FindFirstChild("Head")
	local from = head and head.Position or origin
	local dir = point - from
	if dir.Magnitude < 0.5 then
		return camera.CFrame.LookVector
	end
	return dir.Unit
end

function CameraController.onCharacter(char)
	needsSnap = true
	local root = char:WaitForChild("HumanoidRootPart")
	local _, ry = root.CFrame:ToEulerAnglesYXZ()
	yaw = ry
	pitch = -0.12
end

local function refreshFilter()
	local list = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	local enemies = Workspace:FindFirstChild("Enemies")
	if enemies then
		table.insert(list, enemies)
	end
	params.FilterDescendantsInstances = list
end

local function update(dt)
	local camera = Workspace.CurrentCamera
	if camera.CameraType ~= Enum.CameraType.Scriptable then
		camera.CameraType = Enum.CameraType.Scriptable
	end

	local root = State.root
	if not root or not root.Parent then
		-- No character yet (choosing crew): a slow establishing shot of the Meridian.
		local o = Game.FerryOrigin
		local t = os.clock() * 0.05
		camera.CFrame = CFrame.lookAt(o + Vector3.new(math.cos(t) * 55, 16, math.sin(t) * 55), o + Vector3.new(0, 4, 0))
		camera.FieldOfView = 60
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
		return
	end

	local uiOpen = State.uiOpen()
	if uiOpen then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
	elseif not UserInputService.TouchEnabled or UserInputService.MouseEnabled then
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		UserInputService.MouseIconEnabled = false
	end

	if padLook.Magnitude > 0.15 then
		local aimSlow = State.aiming and 0.55 or 1
		yaw -= padLook.X * SENS_PAD * dt * sensitivity() * aimSlow
		pitch += padLook.Y * SENS_PAD * 0.7 * dt * sensitivity() * aimSlow
	end
	if recoilYaw ~= 0 then
		local step = recoilYaw * math.min(1, dt * 12)
		yaw += step
		recoilYaw -= step
	end
	recoilPitch -= recoilPitch * math.min(1, dt * 9)
	fovPunch -= fovPunch * math.min(1, dt * 10)
	pitch = math.clamp(pitch, PITCH_MIN, PITCH_MAX)
	State.pitch = pitch

	local takedown = os.clock() < State.takedownUntil
	local s = State.shoulder
	local height, offset, fov
	-- over-the-shoulder framing: character on the left third, tight when aiming
	if State.downed then
		height, offset, fov = 0.9, Vector3.new(1.4 * s, 1.3, 6.5), 64
	elseif takedown then
		height, offset, fov = 1.8, Vector3.new(2.3 * s, 0.1, 4.0), 56
	elseif State.aiming then
		local weaponFov = Controllers and Controllers.WeaponController.aimFov()
		local scoped = weaponFov and weaponFov < 40
		height, offset, fov = State.crouched and 1.45 or 2.25, Vector3.new(2.05 * s, 0.35, scoped and 1.9 or 2.7), weaponFov or 50
	elseif State.sprinting then
		height, offset, fov = 2.2, Vector3.new(1.5 * s, 0.55, 6.6), 74
	elseif State.crouched then
		height, offset, fov = 1.35, Vector3.new(1.95 * s, 0.6, 4.9), 64
	else
		height, offset, fov = 2.3, Vector3.new(1.95 * s, 0.5, 5.6), 66
	end

	local focusTarget = root.Position + Vector3.new(0, height, 0)
	if needsSnap or (focusSpring.position - focusTarget).Magnitude > 40 then
		focusSpring:reset(focusTarget)
		offsetSpring:reset(offset)
		currentDist = offset.Magnitude
		needsSnap = false
		refreshFilter()
	end
	focusSpring.target = focusTarget
	offsetSpring.target = offset
	fovSpring.target = fov
	local focus = focusSpring:update(dt)
	local off = offsetSpring:update(dt)
	camera.FieldOfView = fovSpring:update(dt) + fovPunch

	-- subtle breathing sway (scaled down while aiming)
	local t = os.clock()
	local reduce = player:GetAttribute("Set_reduceMotion") == true
	local sway = reduce and 0 or 0.006
	local aimSway = 0
	if State.aiming and not reduce then
		-- breathing sway: steadier crouched, worse while moving
		local v = State.root.AssemblyLinearVelocity
		local moving = math.clamp(Vector3.new(v.X, 0, v.Z).Magnitude / 8, 0, 1)
		aimSway = (State.crouched and 0.0018 or 0.003) * (1 + moving * 1.5)
	end
	local rot = CFrame.fromEulerAnglesYXZ(
		pitch + recoilPitch + math.sin(t * 1.3) * sway + math.sin(t * 0.9) * aimSway,
		yaw + math.sin(t * 0.7) * sway + math.sin(t * 0.45) * aimSway * 1.4,
		0
	)

	local desired = (CFrame.new(focus) * rot * CFrame.new(off)).Position
	local dir = desired - focus
	local dist = dir.Magnitude
	local allowed = dist
	if dist > 0.01 then
		local hit = Workspace:Spherecast(focus, 0.4, dir, params)
		if hit then
			allowed = math.max(hit.Distance - 0.15, 0.35)
		end
	end
	if allowed < currentDist then
		currentDist = allowed -- snap in so walls never block the view
	else
		currentDist += (allowed - currentDist) * math.min(1, dt * 3.5) -- ease back out
	end
	local position = dist > 0.01 and focus + dir.Unit * currentDist or desired
	local shake = Controllers and Controllers.EffectsController.getShake() or 0
	if shake > 0 and player:GetAttribute("Set_reduceMotion") ~= true then
		local k = shake * 0.03
		rot = rot * CFrame.Angles((math.random() - 0.5) * k, (math.random() - 0.5) * k, 0)
	end
	camera.CFrame = CFrame.new(position) * rot
	camera.Focus = CFrame.new(focus)
end

function CameraController.init(registry)
	Controllers = registry
end

function CameraController.start()
	UserInputService.InputChanged:Connect(function(input, processed)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			if not State.uiOpen() and State.root then
				local k = SENS_MOUSE * sensitivity() * (State.aiming and 0.6 or 1)
				yaw -= input.Delta.X * k
				pitch -= input.Delta.Y * k
			end
		elseif input.KeyCode == Enum.KeyCode.Thumbstick2 then
			padLook = Vector2.new(input.Position.X, input.Position.Y)
		end
	end)

	UserInputService.TouchStarted:Connect(function(input, processed)
		if processed or touchInput or State.uiOpen() then
			return
		end
		if input.Position.X > Workspace.CurrentCamera.ViewportSize.X * 0.4 then
			touchInput = input
			lastTouchPos = input.Position
		end
	end)
	UserInputService.TouchMoved:Connect(function(input)
		if input == touchInput and lastTouchPos then
			local delta = input.Position - lastTouchPos
			lastTouchPos = input.Position
			yaw -= delta.X * SENS_TOUCH * sensitivity()
			pitch -= delta.Y * SENS_TOUCH * sensitivity()
		end
	end)
	UserInputService.TouchEnded:Connect(function(input)
		if input == touchInput then
			touchInput = nil
		end
	end)

	Players.PlayerAdded:Connect(function()
		task.wait(2)
		refreshFilter()
	end)
	task.spawn(function()
		while true do
			task.wait(3)
			refreshFilter()
		end
	end)

	RunService:BindToRenderStep("AftertideCamera", Enum.RenderPriority.Camera.Value + 1, update)
end

return CameraController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000003A"><Properties><string name="Name">EffectsController</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Client-only feedback: Tide Sense highlights, knockback, hit flash, low-health grade,
-- takedown framing, Squall lightning, and hiding your own revive prompt.
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Geometry = require(Shared.Util.Geometry)
local State = require(script.Parent.Parent.State)

local EffectsController = {}
local Controllers
local Debris = game:GetService("Debris")
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local player = Players.LocalPlayer
local grade -- our own ColorCorrection layer for health feedback
local hitFlash = 0

local function tideSense(data)
	local enemies = Workspace:FindFirstChild("Enemies")
	local root = State.root
	if not enemies or not root then
		return
	end
	local radius = tonumber(data.radius) or 70
	local duration = tonumber(data.duration) or 4
	for _, model in enemies:GetChildren() do
		local r = model:FindFirstChild("HumanoidRootPart")
		if r and (r.Position - root.Position).Magnitude <= radius then
			local h = Instance.new("Highlight")
			h.FillColor = Color3.fromRGB(170, 215, 215)
			h.FillTransparency = 0.88
			h.OutlineColor = Color3.fromRGB(225, 245, 245)
			h.OutlineTransparency = 0.1
			h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			h.Adornee = model
			h.Parent = model
			task.delay(duration, function()
				if h.Parent then
					local tween = TweenService:Create(h, TweenInfo.new(0.6), { OutlineTransparency = 1, FillTransparency = 1 })
					tween:Play()
					tween.Completed:Wait()
					h:Destroy()
				end
			end)
		end
	end
end

local function localPart(position, size)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Transparency = 1
	p.Size = size or Vector3.new(0.2, 0.2, 0.2)
	p.CFrame = CFrame.new(position)
	p.Parent = Workspace
	return p
end

local function tracer(from, to)
	local length = (to - from).Magnitude
	if length < 0.5 then
		return
	end
	local beam = localPart(from)
	beam.Transparency = 0.35
	beam.Material = Enum.Material.Neon
	beam.Color = Color3.fromRGB(255, 225, 180)
	beam.Size = Vector3.new(0.05, 0.05, length)
	beam.CFrame = CFrame.lookAt(from, to) * CFrame.new(0, 0, -length / 2)
	TweenService:Create(beam, TweenInfo.new(0.08), { Transparency = 1 }):Play()
	Debris:AddItem(beam, 0.1)
end

local function impact(position, kind)
	if kind == "none" then
		return
	end
	if Controllers then
		Controllers.SoundController.impact(position, kind)
	end
	if kind == "world" then
		-- a scorched bullet hole that fades
		local hole = localPart(position, Vector3.new(0.22, 0.22, 0.05))
		hole.Transparency = 0.1
		hole.Color = Color3.fromRGB(20, 18, 16)
		hole.Shape = Enum.PartType.Cylinder
		hole.Size = Vector3.new(0.04, 0.22, 0.22)
		local camPos = Workspace.CurrentCamera.CFrame.Position
		hole.CFrame = CFrame.lookAt(position, camPos) * CFrame.Angles(0, math.rad(90), 0)
		TweenService:Create(hole, TweenInfo.new(12), { Transparency = 1 }):Play()
		Debris:AddItem(hole, 12)
	end
	local holder = localPart(position)
	local puff = Instance.new("ParticleEmitter")
	puff.Texture = SMOKE
	puff.Rate = 0
	puff.Lifetime = NumberRange.new(0.4, 0.9)
	puff.Speed = NumberRange.new(2, 6)
	puff.SpreadAngle = Vector2.new(60, 60)
	puff.Drag = 4
	puff.LightInfluence = 1
	if kind == "enemy" then
		puff.Color = ColorSequence.new(Color3.fromRGB(225, 220, 205)) -- salt, never blood
		puff.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 2) })
	else
		puff.Color = ColorSequence.new(Color3.fromRGB(120, 116, 108))
		puff.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1.4) })
		local sparks = Instance.new("ParticleEmitter")
		sparks.Rate = 0
		sparks.Lifetime = NumberRange.new(0.1, 0.25)
		sparks.Speed = NumberRange.new(8, 16)
		sparks.SpreadAngle = Vector2.new(50, 50)
		sparks.LightEmission = 1
		sparks.Color = ColorSequence.new(Color3.fromRGB(255, 200, 140))
		sparks.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.12), NumberSequenceKeypoint.new(1, 0) })
		sparks.Parent = holder
		sparks:Emit(5)
	end
	puff.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
	puff.Parent = holder
	puff:Emit(kind == "enemy" and 10 or 6)
	Debris:AddItem(holder, 1.5)
end

local function shot(data)
	if typeof(data.from) ~= "Vector3" then
		return
	end
	if data.shooter ~= player.UserId then
		local holder = localPart(data.from)
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 200, 140)
		light.Range = 16
		light.Brightness = 5
		light.Parent = holder
		Debris:AddItem(holder, 0.06)
	end
	for _, hit in data.hits or {} do
		if typeof(hit.position) == "Vector3" then
			tracer(data.from, hit.position)
			impact(hit.position, hit.kind)
		end
	end
end

local shake = 0
local function explosion(data)
	local root = State.root
	if not root or typeof(data.position) ~= "Vector3" then
		return
	end
	local dist = (root.Position - data.position).Magnitude
	shake = math.max(shake, math.clamp(1 - dist / 80, 0, 1))
end

local function humRing(data, color)
	if typeof(data.position) ~= "Vector3" then
		return
	end
	local ring = localPart(data.position + Vector3.new(0, 0.2, 0))
	ring.Shape = Enum.PartType.Cylinder
	ring.Material = Enum.Material.ForceField
	ring.Color = color or Color3.fromRGB(200, 230, 230)
	ring.Transparency = 0.2
	ring.Size = Vector3.new(0.2, 2, 2)
	ring.CFrame = CFrame.new(data.position + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.rad(90))
	local r = (tonumber(data.radius) or 60) * 2
	TweenService:Create(ring, TweenInfo.new(1.2, Enum.EasingStyle.Quad), { Size = Vector3.new(0.2, r, r), Transparency = 1 }):Play()
	Debris:AddItem(ring, 1.3)
end

function EffectsController.getShake()
	return shake
end

local function knockback(data)
	local root = State.root
	if root and Geometry.isSaneVector(data.velocity, 200) then
		root.AssemblyLinearVelocity = data.velocity
	end
end

local function hideOwnRevivePrompt(char)
	local function check(inst)
		if inst:IsA("ProximityPrompt") and inst.Name == "Revive" then
			inst.Enabled = false
		end
	end
	for _, d in char:GetDescendants() do
		check(d)
	end
	char.DescendantAdded:Connect(check)
end

function EffectsController.onCharacter(char)
	hideOwnRevivePrompt(char)
end

local nextLightning = 0
local function lightning()
	local before = Lighting.Brightness
	Lighting.Brightness = before + 3
	task.wait(0.06)
	Lighting.Brightness = before
	task.wait(0.09)
	Lighting.Brightness = before + 2
	task.wait(0.05)
	Lighting.Brightness = before
end

function EffectsController.init(registry)
	Controllers = registry
end

function EffectsController.start()
	grade = Instance.new("ColorCorrectionEffect")
	grade.Name = "AftertideHealth"
	grade.Parent = Lighting

	Net.event("Notify").OnClientEvent:Connect(function(kind, data)
		data = data or {}
		if kind == "TideSense" then
			tideSense(data)
		elseif kind == "Knockback" then
			knockback(data)
		elseif kind == "Hurt" then
			hitFlash = 1
		elseif kind == "Takedown" then
			State.takedownUntil = os.clock() + (tonumber(data.duration) or 0.9)
		elseif kind == "Shot" then
			shot(data)
		elseif kind == "Impact" then
			if typeof(data.position) == "Vector3" then
				impact(data.position, data.kind)
			end
		elseif kind == "Explosion" then
			explosion(data)
		elseif kind == "Hum" then
			humRing(data)
		elseif kind == "NoiseRing" then
			-- how far that sound carried: every Hushed inside this ring heard it
			humRing(data, data.kind == "gunshot" and Color3.fromRGB(232, 168, 92) or Color3.fromRGB(226, 220, 206))
		end
	end)

	RunService.RenderStepped:Connect(function(dt)
		shake = math.max(0, shake - dt * 2.5)
		local char = State.character
		local hp = char and char:GetAttribute("HP") or 100
		local maxHp = char and char:GetAttribute("MaxHP") or 100
		local low = 1 - math.clamp(hp / maxHp, 0, 1)
		hitFlash = math.max(0, hitFlash - dt * 2.5)
		grade.Saturation = -0.5 * low - 0.3 * hitFlash
		grade.TintColor = Color3.new(1, 1 - 0.35 * hitFlash - 0.1 * low, 1 - 0.4 * hitFlash - 0.15 * low)
		grade.Contrast = 0.1 * low
		if State.downed then
			grade.Saturation = -0.8
		end

		if ReplicatedStorage:GetAttribute("ModifierId") == "Squall" and ReplicatedStorage:GetAttribute("MatchState") == "Encounter" then
			local now = os.clock()
			if now > nextLightning then
				nextLightning = now + math.random(8, 20)
				task.spawn(lightning)
			end
		end
	end)
end

return EffectsController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000003B"><Properties><string name="Name">EnemyAnimator</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Procedural animation for the Hushed (no animation assets needed). Drives each enemy's
-- Motor6D skeleton from its replicated velocity, State and Gait:
--   shamble (Drifter)   uneven, dragging steps, arms hanging and swaying
--   rush    (Rusher)    frantic sprint, flailing arms, head jerks
--   feel    (Seeker)    blind: arms raised ahead, head cocked toward sounds, lunges
--   heavy   (Tidewalker) slow stomp, torso rolls, arms swinging like weights
-- Plus: stagger when stunned, knees buckling when Quieted, and a "?" / "!" marker above the
-- head when it hears something or has spotted you.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local State = require(script.Parent.Parent.State)

local EnemyAnimator = {}
local player = Players.LocalPlayer

local rigs = setmetatable({}, { __mode = "k" }) -- [Model] = rig data
local MAX_DISTANCE = 160

local GAITS = {
	shamble = { freq = 1.7, stride = 0.55, armSwing = 0.18, armHang = 0.15, lean = 0.12, twitch = 0.25, limp = 0.35 },
	rush = { freq = 2.9, stride = 0.95, armSwing = 0.9, armHang = 0.25, lean = 0.45, twitch = 0.6, limp = 0.1 },
	feel = { freq = 1.4, stride = 0.45, armSwing = 0.08, armHang = 1.1, lean = 0.05, twitch = 0.45, limp = 0.0 },
	heavy = { freq = 1.0, stride = 0.5, armSwing = 0.35, armHang = 0.25, lean = 0.3, twitch = 0.1, limp = 0.15 },
	soldier = { freq = 1.9, stride = 0.6, armSwing = 0.08, armHang = 0.7, lean = 0.06, twitch = 0, limp = 0 },
	cultist = { freq = 1.8, stride = 0.55, armSwing = 0.3, armHang = 0.15, lean = 0.12, twitch = 0.04, limp = 0 },
}

local function marker(model, head)
	local gui = Instance.new("BillboardGui")
	gui.Name = "StateMarker"
	gui.Size = UDim2.new(0, 40, 0, 40)
	gui.StudsOffset = Vector3.new(0, head.Size.Y * 0.5 + 1.6, 0)
	gui.MaxDistance = 90
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.Adornee = head
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.Oswald
	label.TextScaled = true
	label.TextStrokeTransparency = 0.4
	label.Text = ""
	label.Parent = gui
	gui.Parent = model
	return label
end

local function setup(model)
	local root = model:FindFirstChild("HumanoidRootPart")
	local torso = model:FindFirstChild("Torso")
	local head = model:FindFirstChild("Head")
	if not root or not torso or not head then
		return nil
	end
	local function m(parent, name)
		local p = model:FindFirstChild(parent)
		local j = p and p:FindFirstChild(name)
		return j and j:IsA("Motor6D") and j or nil
	end
	local rig = {
		root = root,
		head = head,
		waist = m("HumanoidRootPart", "Waist"),
		neck = m("Torso", "Neck"),
		ls = m("Torso", "LeftShoulder"),
		rs = m("Torso", "RightShoulder"),
		le = m("LeftUpperArm", "LeftElbow"),
		re = m("RightUpperArm", "RightElbow"),
		lh = m("HumanoidRootPart", "LeftHip"),
		rh = m("HumanoidRootPart", "RightHip"),
		lk = m("LeftUpperLeg", "LeftKnee"),
		rk = m("RightUpperLeg", "RightKnee"),
		phase = math.random() * 6.28,
		seed = math.random() * 100,
		twitchAt = 0,
		twitch = CFrame.new(),
		spasmAt = os.clock() + math.random() * 4,
		spasm = 0,
		maw = head:FindFirstChild("Maw") and nil,
		lastHP = model:GetAttribute("HP") or 1,
		flinch = 0,
	}
	for _, d in model:GetDescendants() do
		if d.Name == "Maw" and d:IsA("BasePart") then
			rig.maw = d
			rig.mawSize = d.Size
		end
	end
	if not rig.waist or not rig.lh then
		return nil
	end
	rig.label = marker(model, head)
	return rig
end

local function set(motor, cf)
	if motor then
		motor.Transform = cf
	end
end

local function animate(model, rig, dt, now)
	local gait = GAITS[model:GetAttribute("Gait") or "shamble"] or GAITS.shamble
	local state = model:GetAttribute("State") or "Patrol"
	local v = rig.root.AssemblyLinearVelocity
	local speed = Vector3.new(v.X, 0, v.Z).Magnitude
	local moving = math.clamp(speed / 6, 0, 1)
	local chasing = state == "Chase"

	rig.phase += dt * gait.freq * math.clamp(speed / 6, 0.3, 2.6) * math.pi
	local p = rig.phase
	local stride = gait.stride * moving * (chasing and 1.15 or 1)
	local sinL, sinR = math.sin(p), math.sin(p + math.pi)
	local limp = 1 - gait.limp * (sinR > 0 and 1 or 0) -- one leg drags

	-- legs
	local lHip = sinL * stride
	local rHip = sinR * stride * limp
	local lKnee = -math.max(0, -sinL) * stride * 1.6 - 0.08
	local rKnee = -math.max(0, -sinR) * stride * 1.6 * limp - 0.08

	-- torso: lean forward when moving or chasing, slow sway when still
	local idle = (1 - moving)
	local sway = math.sin(now * 0.9 + rig.seed) * 0.05 * idle
	local lean = gait.lean * moving + (chasing and 0.15 or 0)
	local roll = math.sin(p) * 0.06 * moving + sway

	-- arms
	local hang = gait.armHang
	local lArm = hang + -sinL * gait.armSwing * moving
	local rArm = hang + -sinR * gait.armSwing * moving
	local elbow = gait == GAITS.feel and 0.5 or 0.25

	-- head twitches (sharper when they've just heard something)
	local heard = now - (model:GetAttribute("Heard") or -100) < 2
	if now > rig.twitchAt then
		local strength = gait.twitch * (heard and 2 or 1)
		rig.twitch = CFrame.Angles((math.random() - 0.5) * strength, (math.random() - 0.5) * strength * 1.5, (math.random() - 0.5) * strength)
		rig.twitchAt = now + (heard and 0.15 or 0.6 + math.random() * 1.8)
	end

	-- spasms: sudden violent jerks of the whole upper body (the Hushed only)
	local human = model:GetAttribute("Human") == true
	if not human and now > rig.spasmAt then
		rig.spasm = 1
		rig.spasmAt = now + (model:GetAttribute("Gait") == "rush" and 1.2 or 2.5) + math.random() * 4
		rig.spasmDir = (math.random() < 0.5) and -1 or 1
	end
	rig.spasm = math.max(0, rig.spasm - dt * 5)
	local sp = rig.spasm ^ 2 * (rig.spasmDir or 1)

	-- flinch when hit
	local hp = model:GetAttribute("HP") or 1
	if hp < rig.lastHP - 0.001 then
		rig.flinch = 1
	end
	rig.lastHP = hp
	rig.flinch = math.max(0, rig.flinch - dt * 4)
	local fl = rig.flinch

	-- the maw gapes when it hunts or screams
	if rig.maw then
		local open = (chasing and 1.6 or 1) + (heard and 0.3 or 0) + math.sin(now * 13) * (chasing and 0.15 or 0)
		rig.maw.Size = Vector3.new(rig.mawSize.X, rig.mawSize.Y * open, rig.mawSize.Z)
	end

	-- states that override the gait
	if state == "Stunned" or state == "Pinned" then
		local wobble = math.sin(now * 9 + rig.seed) * 0.15
		lean, roll = -0.25, wobble
		lArm, rArm = 0.6 + wobble, 0.5 - wobble
		lHip, rHip, lKnee, rKnee = -0.15, 0.2, -0.3, -0.35
	elseif state == "Quieted" or state == "Dispersed" or state == "Down" then
		lean, roll = 0.5, 0.1
		lHip, rHip, lKnee, rKnee = 0.9, 0.85, -1.6, -1.5
		lArm, rArm = 0.1, 0.05
	elseif human then
		if model:GetAttribute("Aiming") then
			lArm, rArm, elbow = 1.45, 1.55, 0.2 -- weapon raised
			lean = 0.02
		end
		local attackAt = model:GetAttribute("AttackAt")
		local since = attackAt and (workspace:GetServerTimeNow() - attackAt) or 99
		if since < 0.45 then
			local k = since / 0.45
			rArm = k < 0.35 and (2.6 * k / 0.35) or (2.6 - (k - 0.35) / 0.65 * 2.4)
			lean = 0.25 * math.sin(k * math.pi)
		end
	elseif chasing then
		-- arms reach toward their prey
		lArm = math.max(lArm, 1.1 + math.sin(p) * 0.25)
		rArm = math.max(rArm, 1.0 + math.sin(p + 1) * 0.25)
	end

	set(rig.waist, CFrame.Angles(-lean + fl * 0.45, math.sin(p * 0.5) * 0.08 * moving + sp * 0.5, roll + sp * 0.3))
	set(rig.neck, CFrame.Angles(lean * 0.6 - fl * 0.5, sp * 0.9, sp * 0.6) * rig.twitch)
	lArm += sp * 0.8
	rArm -= sp * 0.6
	set(rig.lh, CFrame.Angles(lHip, 0, 0))
	set(rig.rh, CFrame.Angles(rHip, 0, 0))
	set(rig.lk, CFrame.Angles(lKnee, 0, 0))
	set(rig.rk, CFrame.Angles(rKnee, 0, 0))
	set(rig.ls, CFrame.Angles(lArm, 0, -0.08))
	set(rig.rs, CFrame.Angles(rArm, 0, 0.08))
	set(rig.le, CFrame.Angles(elbow + (chasing and 0.2 or 0), 0, 0))
	set(rig.re, CFrame.Angles(elbow + (chasing and 0.3 or 0), 0, 0))

	-- "?" heard / searching, "!" chasing you
	local label = rig.label
	if label then
		local hunting = chasing and model:GetAttribute("Target") == player.UserId
		if hunting or chasing then
			label.Text = "!"
			label.TextColor3 = Color3.fromRGB(200, 74, 60)
		elseif state == "Investigate" or state == "Search" or heard then
			label.Text = "?"
			label.TextColor3 = Color3.fromRGB(232, 168, 92)
		else
			label.Text = ""
		end
	end
end

function EnemyAnimator.start()
	RunService.RenderStepped:Connect(function(dt)
		local folder = Workspace:FindFirstChild("Enemies")
		local camera = Workspace.CurrentCamera
		if not folder then
			return
		end
		local now = os.clock()
		local origin = camera.CFrame.Position
		for _, model in folder:GetChildren() do
			local rig = rigs[model]
			if rig == nil then
				rig = setup(model) -- retried next frame until all parts have replicated
				rigs[model] = rig
			end
			if rig and (rig.root.Position - origin).Magnitude < MAX_DISTANCE then
				animate(model, rig, dt, now)
			end
		end
	end)
	assert(State)
end

return EnemyAnimator
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000003C"><Properties><string name="Name">GraphicsController</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Graphics presets. Roblox decides the core render quality per device (from the player's
-- graphics slider); these presets layer extra effects on top and decide how many costly
-- things run:
--   Cinematic   (PC / PlayStation / Xbox): depth of field with aim focus, sun rays, filmic
--               grade, stronger bloom, shadows on every practical light, dense local ground
--               mist, dust motes, heavy rain in a Squall
--   Balanced    lighter mist, no DoF, standard shadows
--   Performance (phones): no extra effects, fewer fog particles, fewer shadow-casting lights
-- "Auto" picks by device and the player's Roblox graphics level.
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local State = require(script.Parent.Parent.State)

local GraphicsController = {}
local Controllers
local player = Players.LocalPlayer

local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local dof, rays, bloom, grade
local mistPart, mist, dust, rainPart, rain
local current = nil

function GraphicsController.resolve(setting)
	if setting and setting ~= "Auto" then
		return setting
	end
	local touchOnly = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local consoleLike = UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled and not UserInputService.TouchEnabled
	if touchOnly then
		return "Performance"
	elseif consoleLike then
		return "Cinematic"
	end
	local ok, level = pcall(function()
		return UserSettings():GetService("UserGameSettings").SavedQualityLevel
	end)
	if not ok or level == Enum.SavedQualitySetting.Automatic then
		return "Cinematic"
	end
	local n = tonumber(tostring(level.Value)) or 10
	if n >= 7 then
		return "Cinematic"
	elseif n >= 4 then
		return "Balanced"
	end
	return "Performance"
end

function GraphicsController.current()
	return current
end

local function setLightShadows(enabled)
	local world = Workspace:FindFirstChild("World")
	if not world then
		return
	end
	for _, d in world:GetDescendants() do
		if d:IsA("PointLight") or d:IsA("SpotLight") then
			if d:GetAttribute("BaseShadows") == nil then
				d:SetAttribute("BaseShadows", d.Shadows)
			end
			d.Shadows = enabled == "all" or (enabled == "base" and d:GetAttribute("BaseShadows"))
		end
	end
end

local function scaleWorldFog(mult)
	local world = Workspace:FindFirstChild("World")
	if not world then
		return
	end
	for _, d in world:GetDescendants() do
		if d:IsA("ParticleEmitter") and d.Texture == SMOKE and d.Parent and d.Parent.Parent and d.Parent.Parent.Name == "CanneryRow" then
			if d:GetAttribute("BaseRate") == nil then
				d:SetAttribute("BaseRate", d.Rate)
			end
			d.Rate = d:GetAttribute("BaseRate") * mult
		end
	end
end

local function apply(mode)
	current = mode
	local cinematic = mode == "Cinematic"
	local performance = mode == "Performance"
	dof.Enabled = cinematic
	rays.Enabled = cinematic
	bloom.Enabled = not performance
	bloom.Intensity = cinematic and 0.5 or 0.25
	grade.Enabled = not performance
	grade.Contrast = cinematic and 0.1 or 0.05
	grade.Saturation = cinematic and -0.04 or 0
	grade.TintColor = cinematic and Color3.fromRGB(255, 246, 236) or Color3.new(1, 1, 1)
	mist.Rate = cinematic and 5 or (performance and 0 or 2)
	dust.Rate = cinematic and 18 or 0
	setLightShadows(cinematic and "all" or (performance and "none" or "base"))
	scaleWorldFog(cinematic and 1.6 or (performance and 0.35 or 1))
	player:SetAttribute("GraphicsMode", mode)
end

function GraphicsController.refresh()
	apply(GraphicsController.resolve(player:GetAttribute("Set_graphics")))
end

local function buildEffects()
	dof = Instance.new("DepthOfFieldEffect")
	dof.Name = "AftertideDoF"
	dof.FarIntensity = 0.18
	dof.NearIntensity = 0
	dof.FocusDistance = 40
	dof.InFocusRadius = 35
	dof.Parent = Lighting

	rays = Instance.new("SunRaysEffect")
	rays.Name = "AftertideRays"
	rays.Intensity = 0.03
	rays.Spread = 0.6
	rays.Parent = Lighting

	bloom = Instance.new("BloomEffect")
	bloom.Name = "AftertideBloomHQ"
	bloom.Size = 32
	bloom.Threshold = 1.2
	bloom.Parent = Lighting

	grade = Instance.new("ColorCorrectionEffect")
	grade.Name = "AftertideFilmic"
	grade.Parent = Lighting

	-- local ground mist and dust that follow the camera (client-only, costs nothing on the server)
	mistPart = Instance.new("Part")
	mistPart.Name = "LocalMist"
	mistPart.Anchored = true
	mistPart.CanCollide = false
	mistPart.CanQuery = false
	mistPart.CanTouch = false
	mistPart.Transparency = 1
	mistPart.Size = Vector3.new(90, 1, 90)
	mistPart.Parent = Workspace

	mist = Instance.new("ParticleEmitter")
	mist.Texture = SMOKE
	mist.Lifetime = NumberRange.new(10, 16)
	mist.Speed = NumberRange.new(0.2, 0.8)
	mist.SpreadAngle = Vector2.new(80, 80)
	mist.Rotation = NumberRange.new(0, 360)
	mist.RotSpeed = NumberRange.new(-3, 3)
	mist.LightInfluence = 1
	mist.Color = ColorSequence.new(Color3.fromRGB(205, 212, 212))
	mist.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 12), NumberSequenceKeypoint.new(1, 22) })
	mist.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.35, 0.9), NumberSequenceKeypoint.new(0.7, 0.92), NumberSequenceKeypoint.new(1, 1) })
	mist.Parent = mistPart

	dust = Instance.new("ParticleEmitter")
	dust.Lifetime = NumberRange.new(4, 7)
	dust.Speed = NumberRange.new(0.1, 0.4)
	dust.SpreadAngle = Vector2.new(180, 180)
	dust.LightInfluence = 1
	dust.Color = ColorSequence.new(Color3.fromRGB(230, 225, 210))
	dust.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.06), NumberSequenceKeypoint.new(1, 0) })
	dust.Parent = mistPart

	rainPart = Instance.new("Part")
	rainPart.Name = "LocalRain"
	rainPart.Anchored = true
	rainPart.CanCollide = false
	rainPart.CanQuery = false
	rainPart.CanTouch = false
	rainPart.Transparency = 1
	rainPart.Size = Vector3.new(80, 1, 80)
	rainPart.Parent = Workspace
	rain = Instance.new("ParticleEmitter")
	rain.Rate = 0
	rain.Lifetime = NumberRange.new(0.8, 1)
	rain.Speed = NumberRange.new(70, 90)
	rain.EmissionDirection = Enum.NormalId.Bottom
	rain.Orientation = Enum.ParticleOrientation.VelocityParallel
	rain.LightInfluence = 1
	rain.Color = ColorSequence.new(Color3.fromRGB(190, 200, 205))
	rain.Transparency = NumberSequence.new(0.55)
	rain.Size = NumberSequence.new(0.08)
	rain.Squash = NumberSequence.new(2.5)
	rain.Parent = rainPart
end

function GraphicsController.init(registry)
	Controllers = registry
end

function GraphicsController.start()
	buildEffects()
	GraphicsController.refresh()
	player:GetAttributeChangedSignal("Set_graphics"):Connect(GraphicsController.refresh)
	-- world lights are built by the server shortly after join; re-apply once they exist
	task.delay(5, GraphicsController.refresh)
	ReplicatedStorage:GetAttributeChangedSignal("MatchState"):Connect(function()
		task.delay(1, GraphicsController.refresh)
	end)

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	RunService.RenderStepped:Connect(function(dt)
		local camera = Workspace.CurrentCamera
		local pos = camera.CFrame.Position
		mistPart.CFrame = CFrame.new(pos.X, math.min(pos.Y, 3) - 1, pos.Z)
		rainPart.CFrame = CFrame.new(pos.X, pos.Y + 28, pos.Z)
		local squall = ReplicatedStorage:GetAttribute("ModifierId") == "Squall" and ReplicatedStorage:GetAttribute("MatchState") == "Encounter"
		rain.Rate = squall and (current == "Cinematic" and 500 or (current == "Balanced" and 220 or 60)) or 0

		-- aim focus: in Cinematic, focus depth of field on what you're aiming at
		if current == "Cinematic" then
			local focusDist, radius, far = 40, 35, 0.18
			if State.aiming then
				params.FilterDescendantsInstances = State.character and { State.character } or {}
				local hit = Workspace:Raycast(pos, camera.CFrame.LookVector * 250, params)
				focusDist = hit and hit.Distance or 200
				radius, far = math.max(6, focusDist * 0.35), 0.4
			end
			dof.FocusDistance += (focusDist - dof.FocusDistance) * math.min(1, dt * 6)
			dof.InFocusRadius += (radius - dof.InFocusRadius) * math.min(1, dt * 6)
			dof.FarIntensity += (far - dof.FarIntensity) * math.min(1, dt * 6)
		end
	end)
end

return GraphicsController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000003D"><Properties><string name="Name">MovementController</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Stances, speed states with acceleration, wading, aim-facing (strafe while aiming), and the
-- dodge / sprint-dive movement. Poses are drawn by PlayerAnimator.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Movement = require(Shared.Config.Movement)
local Stats = require(Shared.Stats)
local Net = require(Shared.Net)
local Geometry = require(Shared.Util.Geometry)
local Sfx = require(Shared.Util.Sfx)
local State = require(script.Parent.Parent.State)

local MovementController = {}
local Controllers

local player = Players.LocalPlayer
local currentSpeed = 0
local stillTime = 0
local lastSent = ""
local lastLookSent, lastLookAt = 0, 0
local dodgeReadyAt = 0

local function send()
	local stance = State.crouched and "Crouch" or "Stand"
	local key = stance .. tostring(State.sprinting) .. tostring(State.aiming)
	if key ~= lastSent then
		lastSent = key
		Net.event("SetMoveState"):FireServer(stance, State.sprinting, State.aiming)
	end
end

function MovementController.toggleCrouch()
	if State.downed then
		return
	end
	State.crouched = not State.crouched
	if State.crouched then
		State.sprinting = false
	end
	send()
end

function MovementController.setSprint(on, toggled)
	if State.downed then
		return
	end
	State.sprinting = on
	State.sprintToggled = on and toggled == true
	if on then
		State.crouched = false
	end
	send()
end

function MovementController.setAim(on)
	State.aiming = on and not State.downed
	if State.aiming then
		State.sprinting = false
	end
	send()
end

-- Quick sidestep in the move direction (backstep if standing still); a dive when sprinting.
function MovementController.dodge()
	local root, humanoid = State.root, State.humanoid
	if not root or not humanoid or State.downed or State.uiOpen() then
		return
	end
	local now = os.clock()
	if now < dodgeReadyAt then
		return
	end
	local dive = State.sprinting
	dodgeReadyAt = now + (dive and 1.3 or 0.85)
	local dir = humanoid.MoveDirection
	if dir.Magnitude < 0.1 then
		dir = -Geometry.flat(root.CFrame.LookVector)
	end
	dir = Geometry.flat(dir).Unit
	Net.event("Action"):FireServer("Dodge", dir)
	Sfx.ui("Dodge", 0.6)

	local attachment = root:FindFirstChild("RootAttachment")
	if attachment then
		local lv = Instance.new("LinearVelocity")
		lv.Attachment0 = attachment
		lv.MaxForce = 1e6
		lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
		lv.PrimaryTangentAxis = Vector3.new(1, 0, 0)
		lv.SecondaryTangentAxis = Vector3.new(0, 0, 1)
		lv.RelativeTo = Enum.ActuatorRelativeTo.World
		local speed = dive and 36 or 30
		lv.PlaneVelocity = Vector2.new(dir.X * speed, dir.Z * speed)
		lv.Parent = root
		task.delay(dive and 0.38 or 0.22, function()
			lv:Destroy()
		end)
	end
	if dive then
		State.sprinting = false
		task.delay(0.5, function()
			State.crouched = true
			send()
		end)
	end
end

function MovementController.onCharacter()
	currentSpeed = 0
	lastSent = ""
	send()
end

local cachedMods, cachedKey = nil, nil
local function getMods()
	local key = tostring(player:GetAttribute("CharId")) .. tostring(player:GetAttribute("PerkId"))
	if key ~= cachedKey then
		cachedKey = key
		cachedMods = Stats.compute(player:GetAttribute("CharId"), player:GetAttribute("PerkId"))
	end
	return cachedMods
end

local function step(dt)
	local char, humanoid, root = State.character, State.humanoid, State.root
	if not char or not humanoid or not root or not root.Parent then
		return
	end
	local wasDowned = State.downed
	State.downed = char:GetAttribute("Downed") == true or char:GetAttribute("Out") == true
	if State.downed and not wasDowned then
		State.aiming, State.sprinting, State.crouched = false, false, false
		send()
	end

	local busy = (char:GetAttribute("BusyUntil") or 0) > Workspace:GetServerTimeNow()
	local moving = humanoid.MoveDirection.Magnitude > 0.05
	local S = Movement.Speeds
	local target
	if char:GetAttribute("Out") then
		target = 0
	elseif State.downed then
		target = S.Downed
	elseif busy then
		target = 1.5
	elseif State.aiming then
		target = State.crouched and S.Crouch * 0.8 or S.Aim
	elseif State.crouched then
		target = S.Crouch
	elseif State.sprinting then
		target = S.Sprint * getMods().sprintSpeedMult
	else
		target = S.Jog
	end
	if Geometry.inTagged(root.Position, "Shallows") then
		target *= Movement.WaterSpeedMult
	end
	if not moving then
		currentSpeed = math.min(currentSpeed, 4)
	end
	if target > currentSpeed then
		currentSpeed = math.min(target, currentSpeed + Movement.Accel * dt)
	else
		currentSpeed = math.max(target, currentSpeed - Movement.Decel * dt)
	end
	humanoid.WalkSpeed = currentSpeed

	-- aiming: the body faces the camera so you strafe around your target
	if State.aiming and not State.downed then
		humanoid.AutoRotate = false
		local yaw = Controllers.CameraController.getYaw()
		local _, current = root.CFrame:ToEulerAnglesYXZ()
		local diff = (yaw - current + math.pi) % (2 * math.pi) - math.pi
		root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, current + diff * math.min(1, dt * 18), 0)
	else
		humanoid.AutoRotate = true
	end

	stillTime = moving and 0 or stillTime + dt
	if State.sprinting and State.sprintToggled and stillTime > 0.6 then
		State.sprinting = false
		State.sprintToggled = false
		send()
	end

	-- replicate aim pitch for other players' upper-body pose
	if State.aiming then
		local now = os.clock()
		if now - lastLookAt > 0.12 and math.abs(State.pitch - lastLookSent) > 0.04 then
			lastLookAt = now
			lastLookSent = State.pitch
			Net.event("Look"):FireServer(State.pitch)
		end
	end
end

function MovementController.init(registry)
	Controllers = registry
end

function MovementController.start()
	RunService:BindToRenderStep("AftertideMovement", Enum.RenderPriority.Input.Value + 1, step)
end

return MovementController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000003E"><Properties><string name="Name">PlayerAnimator</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Procedural full-body animation for every crew character (replaces Roblox's default
-- Animate script, so movement doesn't look like a Roblox avatar). Runs on each client for
-- all characters from replicated velocity + attributes:
--   locomotion  walk / jog / sprint gait with stride, knee lift, ankle roll, hip bob,
--               counter-rotating torso, arm swing; backpedal + strafe while aiming
--   stances     crouch + crouch-walk, downed crawl
--   weapons     carry (ready) and aim poses for long guns / sidearms, aim pitch, reload,
--               draw from back / hip on swap
--   actions     melee combo swings, dodge / dive, throw, takedown, field dressing
--   idle        breathing, weight shift
-- Cues come from server-set character attributes: MeleeAt, MeleeCombo, DodgeAt, DodgeDive,
-- ThrowAt, TakedownAt, HealAt, ReloadUntil, Equipped(Slot), Aim, AimPitch, Stance, Downed.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Movement = require(Shared.Config.Movement)
local State = require(script.Parent.Parent.State)

local PlayerAnimator = {}
local player = Players.LocalPlayer
local rigs = setmetatable({}, { __mode = "k" })

local JOINTS = {
	root = { "LowerTorso", "Root" },
	waist = { "UpperTorso", "Waist" },
	neck = { "Head", "Neck" },
	ls = { "LeftUpperArm", "LeftShoulder" },
	rs = { "RightUpperArm", "RightShoulder" },
	le = { "LeftLowerArm", "LeftElbow" },
	re = { "RightLowerArm", "RightElbow" },
	lw = { "LeftHand", "LeftWrist" },
	rw = { "RightHand", "RightWrist" },
	lh = { "LeftUpperLeg", "LeftHip" },
	rh = { "RightUpperLeg", "RightHip" },
	lk = { "LeftLowerLeg", "LeftKnee" },
	rk = { "RightLowerLeg", "RightKnee" },
	la = { "LeftFoot", "LeftAnkle" },
	ra = { "RightFoot", "RightAnkle" },
}

local function setup(char)
	if not char:GetAttribute("Procedural") then
		return nil
	end
	local rig = { joints = {}, phase = 0, crouch = 0, aim = 0, ready = 0, lastSlot = "none", drawAt = -10, seed = math.random() * 10 }
	for key, path in JOINTS do
		local part = char:FindFirstChild(path[1])
		local motor = part and part:FindFirstChild(path[2])
		if not (motor and motor:IsA("Motor6D")) then
			return nil
		end
		rig.joints[key] = motor
	end
	rig.root = char:FindFirstChild("HumanoidRootPart")
	rig.humanoid = char:FindFirstChildOfClass("Humanoid")
	if not rig.root or not rig.humanoid then
		return nil
	end
	-- stop anything the default Animate script may have started before it was removed
	local animator = rig.humanoid:FindFirstChildOfClass("Animator")
	if animator then
		for _, track in animator:GetPlayingAnimationTracks() do
			track:Stop(0)
		end
	end
	return rig
end

local function ang(x, y, z)
	return CFrame.Angles(x or 0, y or 0, z or 0)
end

local function since(char, attr, serverNow)
	local at = char:GetAttribute(attr)
	return at and (serverNow - at) or math.huge
end

local function approach(current, target, rate, dt)
	return current + (target - current) * math.min(1, dt * rate)
end

local function animate(char, rig, dt, serverNow, isLocal)
	local J = rig.joints
	local root = rig.root
	local v = root.AssemblyLinearVelocity
	local flat = Vector3.new(v.X, 0, v.Z)
	local speed = flat.Magnitude
	local localVel = root.CFrame:VectorToObjectSpace(flat)
	local fwd, side = -localVel.Z, localVel.X

	local downed = char:GetAttribute("Downed") == true or char:GetAttribute("Out") == true
	local crouched = isLocal and State.crouched or char:GetAttribute("Stance") == "Crouch"
	local equipped = char:GetAttribute("Equipped")
	local armed = equipped ~= nil and equipped ~= "" and not downed
	local slot = char:GetAttribute("EquippedSlot") or "none"
	local longGun = slot == "long"
	local aiming = armed and (isLocal and State.aiming or char:GetAttribute("Aim") == true)
	local pitch = isLocal and State.pitch or (char:GetAttribute("AimPitch") or 0)

	if slot ~= rig.lastSlot then
		rig.lastSlot = slot
		rig.drawAt = os.clock()
		rig.drawSlot = slot
	end

	rig.crouch = approach(rig.crouch, (crouched or downed) and 1 or 0, 10, dt)
	rig.aim = approach(rig.aim, aiming and 1 or 0, 14, dt)
	rig.ready = approach(rig.ready, armed and 1 or 0, 10, dt)
	local c, a, r = rig.crouch, rig.aim, rig.ready * (1 - rig.aim)

	-- gait
	local moving = math.clamp(speed / 2.5, 0, 1)
	local run = math.clamp((speed - Movement.Speeds.Walk) / (Movement.Speeds.Sprint - Movement.Speeds.Walk), 0, 1)
	local stride = 2.0 + 2.2 * run
	rig.phase += dt * (speed / stride) * math.pi
	local p = rig.phase
	local back = (fwd < -1 and math.abs(fwd) > math.abs(side)) and -1 or 1
	local strafe = math.abs(side) > math.abs(fwd) * 1.2 and math.clamp(side / 8, -1, 1) or 0
	local amp = (0.34 + 0.42 * run) * moving * (1 - 0.45 * c)
	local sL, sR = math.sin(p), math.sin(p + math.pi)

	local lHip = sL * amp * back * (1 - math.abs(strafe))
	local rHip = sR * amp * back * (1 - math.abs(strafe))
	local hipRollL, hipRollR = sL * amp * strafe * 0.7, sR * amp * strafe * 0.7
	local liftL = math.max(0, math.sin(p + 1.3)) * (0.5 + 1.0 * run) * moving
	local liftR = math.max(0, math.sin(p + math.pi + 1.3)) * (0.5 + 1.0 * run) * moving
	local lKnee, rKnee = -liftL - 0.06, -liftR - 0.06
	local lAnk, rAnk = liftL * 0.35 - lHip * 0.25, liftR * 0.35 - rHip * 0.25
	local bob = -math.abs(math.cos(p)) * (0.05 + 0.1 * run) * moving
	local leanFwd = (0.04 + 0.2 * run) * moving * (back > 0 and 1 or -0.5)
	local twist = math.sin(p) * (0.06 + 0.1 * run) * moving
	local t = os.clock() + rig.seed
	local breathe = math.sin(t * 1.7) * 0.025 * (1 - moving)
	local shift = math.sin(t * 0.35) * 0.04 * (1 - moving)

	-- crouch pose blended in
	lHip += 1.1 * c
	rHip += 1.1 * c
	lKnee -= 1.6 * c
	rKnee -= 1.6 * c
	lAnk += 0.5 * c
	rAnk += 0.5 * c
	local waistLean = -(0.42 * c) - leanFwd * 0.6 + breathe

	-- arms: natural swing (unarmed)
	local swing = (0.35 + 0.55 * run) * moving * (1 - 0.6 * c)
	local lSh, rSh = -sL * swing * back + 0.05, -sR * swing * back + 0.05
	local lEl, rEl = 0.2 + 0.9 * run * moving, 0.2 + 0.9 * run * moving
	local lShZ, rShZ = -0.06, 0.06
	local lShY, rShY = 0, 0

	-- weapon carry / aim (two-handed); aim pitch bends the upper body
	if rig.ready > 0.01 or a > 0.01 then
		local hold = math.max(r, a)
		local pp = pitch * a
		waistLean += pp * 0.45
		local aimR = 1.55 + pp * 0.5
		local readyR = longGun and 0.75 or 0.5
		rSh = rSh * (1 - hold) + (aimR * a + readyR * r)
		rEl = rEl * (1 - hold) + (0.12 * a + (longGun and 1.1 or 0.9) * r)
		rShZ = rShZ * (1 - hold) + (longGun and 0.2 or 0.1) * hold
		if longGun or a > 0.01 then
			local lh = longGun and hold or a
			lSh = lSh * (1 - lh) + ((1.45 + pp * 0.5) * a + 0.85 * r) * (lh > 0 and 1 or 0)
			lEl = lEl * (1 - lh) + ((longGun and 0.6 or 0.4) * a + 1.0 * r)
			lShZ = lShZ * (1 - lh) + (longGun and 0.6 or 0.8) * lh
			lShY = (longGun and -0.3 or -0.2) * lh
		end
	end

	-- reload: left hand works the weapon, gun tilts in
	local reloadUntil = char:GetAttribute("ReloadUntil") or 0
	if reloadUntil > serverNow and armed then
		local cycle = math.sin((serverNow % 0.8) / 0.8 * math.pi * 2)
		lSh = 0.9 + cycle * 0.15
		lEl = 1.3 + cycle * 0.2
		lShZ = 0.7
		rSh = math.min(rSh, 0.8)
		waistLean -= 0.08
	end

	-- draw / holster: reach over the shoulder (long) or down to the hip (sidearm)
	local drawT = os.clock() - rig.drawAt
	if drawT < 0.4 then
		local k = math.sin(drawT / 0.4 * math.pi)
		if rig.drawSlot == "long" or (rig.drawSlot == "none" and longGun) then
			rSh = rSh + (2.7 - rSh) * k
			rEl = rEl + (1.4 - rEl) * k
			rShZ = rShZ + 0.3 * k
		else
			rSh = rSh + (-0.3 - rSh) * k
			rShZ = rShZ + 0.25 * k
		end
	end

	-- one-shot actions (server cues)
	local rootX, rootZ, rootY = -leanFwd, 0, 0
	local rootOffset = Vector3.new(0, bob, 0)

	local melee = since(char, "MeleeAt", serverNow)
	if melee < 0.45 then
		local combo = char:GetAttribute("MeleeCombo") or 1
		local k = melee / 0.45
		local wind = k < 0.3 and (k / 0.3) or (1 - (k - 0.3) / 0.7)
		local dir = combo == 2 and -1 or 1
		if combo == 3 then
			-- overhead finisher with both arms
			rSh, lSh = 2.6 * wind + 0.4, 2.4 * wind + 0.4
			rEl, lEl = 0.6, 0.6
			waistLean += 0.35 * (1 - wind) - 0.2 * wind
		else
			local arm = dir > 0 and "r" or "l"
			local raise, elbow = 1.7 * wind + 0.3, 1.2 * wind + 0.3
			if arm == "r" then
				rSh, rEl, rShZ = raise, elbow, 0.3 + 0.8 * wind
			else
				lSh, lEl, lShZ = raise, elbow, -0.3 - 0.8 * wind
			end
			rootY = dir * (0.5 * wind - 0.4 * (1 - wind))
		end
		rootX -= 0.15
	end

	local dodge = since(char, "DodgeAt", serverNow)
	local dive = char:GetAttribute("DodgeDive") == true
	local dodgeLen = dive and 0.75 or 0.45
	if dodge < dodgeLen then
		local k = math.sin(dodge / dodgeLen * math.pi)
		if dive then
			rootX -= 1.1 * k
			rootOffset += Vector3.new(0, -0.9 * k, 0)
			lSh, rSh = 2.4 * k, 2.4 * k
			lEl, rEl = 0.3, 0.3
			lHip, rHip = -0.2 * k, -0.3 * k
			lKnee, rKnee = -0.4 * k, -0.6 * k
		else
			rootX -= 0.35 * k
			rootZ += (side > 0 and -0.35 or 0.35) * k
			lHip += 0.7 * k
			rHip += 0.7 * k
			lKnee -= 1.1 * k
			rKnee -= 1.1 * k
			rootOffset += Vector3.new(0, -0.45 * k, 0)
		end
	end

	local throw = since(char, "ThrowAt", serverNow)
	if throw < 0.5 then
		local k = throw / 0.5
		if k < 0.35 then
			rSh, rEl, rShZ = -0.6 - (k / 0.35) * 1.2, 1.2, 0.2 -- wind back
		else
			local f = (k - 0.35) / 0.65
			rSh, rEl, rShZ = -1.8 + f * 4.2, 1.2 - f * 1.0, 0.1 -- release overhead
		end
		rootY += 0.25 * math.sin(k * math.pi)
	end

	local takedown = since(char, "TakedownAt", serverNow)
	if takedown < 1.2 then
		local k = math.min(1, takedown / 0.2) * math.max(0, math.min(1, (1.2 - takedown) / 0.3))
		lSh, rSh = lSh + (1.4 - lSh) * k, rSh + (1.5 - rSh) * k
		lEl, rEl = 1.3 * k, 1.1 * k
		lShZ, rShZ = 0.5 * k, -0.4 * k
		waistLean -= 0.3 * k
	end

	local heal = since(char, "HealAt", serverNow)
	if heal < 2.2 then
		local k = math.min(1, heal / 0.25) * math.max(0, math.min(1, (2.2 - heal) / 0.3))
		local work = math.sin(heal * 9) * 0.12
		lSh, rSh = 0.9 * k + lSh * (1 - k), 0.8 * k + rSh * (1 - k)
		lEl, rEl = 1.6 * k + work, 1.5 * k - work
		lShZ, rShZ = 0.6 * k, -0.6 * k
		waistLean -= 0.15 * k
	end

	if downed then
		-- slumped, crawling on one arm
		local crawl = math.sin(p) * 0.4 * moving
		waistLean = -0.9
		rootX = -0.35
		lHip, rHip = 1.4, 1.2
		lKnee, rKnee = -1.9, -1.7
		lSh, rSh = 1.0 + crawl, 0.4 - crawl
		lEl, rEl = 1.2, 0.8
	end

	local neckPitch = pitch * (0.35 + 0.25 * a) - waistLean * 0.5 + shift * 0.3
	J.root.Transform = CFrame.new(rootOffset) * ang(rootX, rootY + shift, rootZ)
	J.waist.Transform = ang(waistLean, -twist + rootY * -0.3, shift * 0.5)
	J.neck.Transform = ang(neckPitch, twist * 0.5, 0)
	J.lh.Transform = ang(lHip, 0, hipRollL)
	J.rh.Transform = ang(rHip, 0, hipRollR)
	J.lk.Transform = ang(lKnee, 0, 0)
	J.rk.Transform = ang(rKnee, 0, 0)
	J.la.Transform = ang(lAnk, 0, 0)
	J.ra.Transform = ang(rAnk, 0, 0)
	J.ls.Transform = ang(lSh, lShY, lShZ)
	J.rs.Transform = ang(rSh, rShY, rShZ)
	J.le.Transform = ang(lEl, 0, 0)
	J.re.Transform = ang(rEl, 0, 0)
	J.lw.Transform = ang(0, 0, 0)
	J.rw.Transform = ang(a * 0.1, 0, 0)

	-- local player's hips physically lower when crouched
	if isLocal and rig.humanoid then
		rig.baseHip = rig.baseHip or rig.humanoid.HipHeight
		rig.humanoid.HipHeight = rig.baseHip * (1 - (1 - Movement.CrouchHipMult) * math.min(c, 1))
	end
end

function PlayerAnimator.start()
	RunService.Stepped:Connect(function(_, dt)
		local serverNow = Workspace:GetServerTimeNow()
		local camPos = Workspace.CurrentCamera.CFrame.Position
		for _, p in Players:GetPlayers() do
			local char = p.Character
			if char then
				local rig = rigs[char]
				if rig == nil then
					rig = setup(char)
					rigs[char] = rig
				end
				if rig and rig.root.Parent and (rig.root.Position - camPos).Magnitude < 220 then
					local ok, err = pcall(animate, char, rig, dt, serverNow, p == player)
					if not ok then
						warn("[PlayerAnimator] " .. tostring(err))
						rigs[char] = false
					end
				end
			end
		end
	end)
end

return PlayerAnimator
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000003F"><Properties><string name="Name">SoundController</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- All client-side audio:
--   ambience     wind + sea + low drone, mixed by where you are (ferry vs encounter)
--   music        a tension loop that swells when Hushed are suspicious of / hunting you,
--                a stinger when you're spotted, a resolve when you clear an encounter
--   body         footsteps for every character (surface-aware, quieter when crouched),
--                heartbeat at low health, hurt, Roblox's default character sounds muted
--   the Hushed   per-enemy breath / grind / groan loops, growls and shrieks on spotting
--   weapons      your gunshots play instantly; other players' play from the Shot event,
--                with distance-based loudness so far shots sound far
-- Uses the IDs in Config/Sounds (empty = silent).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Sfx = require(Shared.Util.Sfx)
local Geometry = require(Shared.Util.Geometry)
local State = require(script.Parent.Parent.State)

local SoundController = {}
local player = Players.LocalPlayer

local amb = {}
local music
local heartbeat
local stepState = setmetatable({}, { __mode = "k" }) -- [character] = distance since last step
local enemyAudio = setmetatable({}, { __mode = "k" }) -- [model] = { loop, lastState }

local DEFAULT_CHARACTER_SOUNDS = {
	Running = true, Jumping = true, Landing = true, FreeFalling = true, GettingUp = true,
	Climbing = true, Swimming = true, Splash = true, Died = true,
}

local function muteDefaultSounds(char)
	local function check(inst)
		if inst:IsA("Sound") and DEFAULT_CHARACTER_SOUNDS[inst.Name] then
			inst.Volume = 0
		end
	end
	for _, d in char:GetDescendants() do
		check(d)
	end
	char.DescendantAdded:Connect(check)
end

local function loop(key, volume)
	local s = Sfx.ui(key, volume, true)
	if s then
		s.Volume = 0
	end
	return s
end

function SoundController.gunshot(weaponId, position, isMine, quiet)
	local key = "Gun_" .. tostring(weaponId)
	local camPos = Workspace.CurrentCamera.CFrame.Position
	local dist = (position - camPos).Magnitude
	local volume = (isMine and 0.9 or 1.0) * (quiet and 0.35 or 1)
	if isMine then
		Sfx.ui(key, volume)
	else
		Sfx.at(position, key, volume, 600, 0.05)
		if dist > 120 then
			Sfx.ui(key, 0.25 * (quiet and 0.3 or 1)) -- distant echo carries across the map
		end
	end
end

function SoundController.impact(position, kind)
	if kind == "enemy" then
		Sfx.at(position, "ImpactSalt", 0.7, 60, 0.1)
	elseif kind == "world" then
		Sfx.at(position, "ImpactWorld", 0.5, 70, 0.12)
	end
end

local function updateFootsteps(dt)
	for _, p in Players:GetPlayers() do
		local char = p.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if root then
			local v = root.AssemblyLinearVelocity
			local speed = Vector3.new(v.X, 0, v.Z).Magnitude
			local crouched = char:GetAttribute("Stance") == "Crouch"
			local stride = speed > 16 and 4.0 or (speed > 10 and 3.3 or 2.4)
			local acc = (stepState[char] or 0) + speed * dt
			if speed > 1.5 and acc >= stride then
				acc = 0
				local water = Geometry.inTagged(root.Position, "Shallows")
				local vol = math.clamp(speed / 20, 0.2, 1) * (crouched and 0.35 or 1) * (p == player and 0.8 or 1)
				Sfx.at(root.Position - Vector3.new(0, 2.5, 0), water and "StepWater" or "Step", vol, 60, 0.12)
			end
			stepState[char] = acc
		end
	end
end

local VOICE = {
	Drifter = "Hushed_Breath",
	Rusher = "Hushed_Breath",
	Bellwether = "Hushed_Breath",
	Seeker = "Seeker_Grind",
	Tidewalker = "Tidewalker_Groan",
}

local function updateEnemies()
	local folder = Workspace:FindFirstChild("Enemies")
	if not folder then
		return 0
	end
	local camPos = Workspace.CurrentCamera.CFrame.Position
	local threat = 0
	local key = "Sus_" .. player.UserId
	for _, model in folder:GetChildren() do
		local torso = model:FindFirstChild("Torso")
		local state = model:GetAttribute("State")
		local typeName = model:GetAttribute("Type") or "Drifter"
		if torso then
			local a = enemyAudio[model]
			if not a then
				a = { loop = Sfx.attach(torso, VOICE[typeName] or "Hushed_Breath", 0.55, 70, true), lastState = state }
				if a.loop then
					a.loop.TimePosition = math.random() * 3
				end
				enemyAudio[model] = a
			end
			if a.loop then
				a.loop.Volume = (state == "Dispersed" and 0 or (state == "Chase" and 0.9 or 0.5))
				a.loop.PlaybackSpeed = state == "Chase" and 1.25 or 1
			end
			if state ~= a.lastState then
				if state == "Chase" then
					Sfx.at(torso.Position, typeName == "Rusher" and "Rusher_Shriek" or "Hushed_Growl", 1, 160, 0.08)
				elseif state == "Investigate" and math.random() < 0.5 then
					Sfx.at(torso.Position, "Hushed_Growl", 0.5, 70, 0.15)
				end
				a.lastState = state
			end
			-- tension: how much the Hushed near you care about you
			if (torso.Position - camPos).Magnitude < 120 then
				local sus = model:GetAttribute(key) or 0
				local hunting = state == "Chase" and model:GetAttribute("Target") == player.UserId
				threat = math.max(threat, hunting and 1 or (sus > 0.35 and 0.55 or sus))
			end
		end
	end
	return threat
end

function SoundController.start()
	amb.wind = loop("Amb_Wind")
	amb.sea = loop("Amb_Sea")
	amb.drone = loop("Amb_Drone")
	music = loop("Music_Tension")
	heartbeat = loop("Heartbeat")

	local function onChar(char)
		muteDefaultSounds(char)
	end
	for _, p in Players:GetPlayers() do
		if p.Character then
			onChar(p.Character)
		end
		p.CharacterAdded:Connect(onChar)
	end
	Players.PlayerAdded:Connect(function(p)
		p.CharacterAdded:Connect(onChar)
	end)

	Net.event("Notify").OnClientEvent:Connect(function(kind, data)
		data = data or {}
		if kind == "Shot" and typeof(data.from) == "Vector3" and data.shooter ~= player.UserId then
			SoundController.gunshot(data.weapon, data.from, false, data.quiet)
		elseif kind == "Spotted" then
			Sfx.ui("Stinger_Spotted", 0.7)
		elseif kind == "Hurt" then
			Sfx.ui("Hurt", 0.8)
		elseif kind == "Results" and data.win then
			Sfx.ui("Stinger_Clear", 0.6)
		end
	end)

	local musicLevel = 0
	RunService.Heartbeat:Connect(function(dt)
		updateFootsteps(dt)
		local threat = updateEnemies()
		local matchState = ReplicatedStorage:GetAttribute("MatchState")
		local inEncounter = matchState == "Encounter" and player:GetAttribute("InCrossing") == true
		local function fade(sound, target, rate)
			if sound then
				sound.Volume += (target - sound.Volume) * math.min(1, dt * (rate or 1.5))
			end
		end
		fade(amb.wind, inEncounter and 0.35 or 0.2)
		fade(amb.sea, inEncounter and 0.12 or 0.35)
		fade(amb.drone, inEncounter and (0.22 + threat * 0.1) or 0.08)
		musicLevel += ((inEncounter and threat or 0) - musicLevel) * math.min(1, dt * (threat > musicLevel and 2.5 or 0.4))
		fade(music, musicLevel * 0.45, 4)
		local char = State.character
		local hp = char and char:GetAttribute("HP") or 100
		local maxHp = char and char:GetAttribute("MaxHP") or 100
		local low = inEncounter and hp > 0 and hp / maxHp < 0.35
		fade(heartbeat, low and 0.6 or 0, 3)
		if heartbeat then
			heartbeat.PlaybackSpeed = low and (1.0 + (0.35 - hp / maxHp)) or 1
		end
	end)
end

return SoundController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000040"><Properties><string name="Name">UIController</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Owns the ScreenGui and routes server notifications to the UI modules.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Sfx = require(Shared.Util.Sfx)
local UI = script.Parent.Parent:WaitForChild("UI")
local HUD = require(UI:WaitForChild("HUD"))
local CharacterSelect = require(UI:WaitForChild("CharacterSelect"))
local Satchel = require(UI:WaitForChild("Satchel"))
local Shop = require(UI:WaitForChild("Shop"))
local Results = require(UI:WaitForChild("Results"))
local Chart = require(UI:WaitForChild("Chart"))
local Workbench = require(UI:WaitForChild("Workbench"))
local Repairs = require(UI:WaitForChild("Repairs"))
local Settings = require(UI:WaitForChild("Settings"))

local UIController = {}
local Controllers
local player = Players.LocalPlayer

function UIController.toggleSatchel()
	Satchel.toggle()
end

function UIController.toggleSettings()
	Settings.toggle()
end

local function closeMenus()
	Chart.close()
	Workbench.close()
	Repairs.close()
	Shop.close()
	Satchel.close()
	CharacterSelect.close()
end

function UIController.init(registry)
	Controllers = registry
end

function UIController.start()
	local gui = Instance.new("ScreenGui")
	gui.Name = "AftertideUI"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")

	local function send(name, payload)
		Controllers.ActionController.sendAction(name, payload)
	end
	local function request(kind, a, b)
		Controllers.ActionController.request(kind, a, b)
	end
	HUD.build(gui, function()
		send("SecondWind")
	end, Controllers.WeaponController)
	CharacterSelect.build(gui)
	Satchel.build(gui, send)
	Shop.build(gui)
	Results.build(gui)
	Chart.build(gui, request)
	Workbench.build(gui, request)
	Repairs.build(gui, request)
	Settings.build(gui, request)

	Net.event("Notify").OnClientEvent:Connect(function(kind, data)
		data = data or {}
		if kind == "Toast" then
			HUD.toast(tostring(data.text or ""))
		elseif kind == "OpenCharacterSelect" then
			CharacterSelect.open()
		elseif kind == "OpenShop" then
			Shop.open()
		elseif kind == "Results" then
			Satchel.close()
			Results.show(data)
		elseif kind == "OpenChart" then
			Sfx.ui("Ui_Confirm", 0.5)
			Chart.open()
		elseif kind == "OpenWorkbench" then
			Sfx.ui("Ui_Tick", 0.5)
			Workbench.open()
		elseif kind == "OpenRepairs" then
			Repairs.open()
		elseif kind == "CloseMenus" then
			closeMenus()
		elseif kind == "Hit" then
			HUD.hit(data)
		elseif kind == "Hurt" then
			HUD.hurt()
		elseif kind == "EncounterStart" then
			closeMenus()
			Results.close()
			HUD.toast(("%s · %s"):format(tostring(data.name), tostring(data.modifierName)))
			HUD.toast(tostring(data.modifierDesc or ""))
			HUD.toast(tostring(data.objective or ""))
		elseif kind == "Spotted" then
			HUD.toast("You've been seen. Break line of sight!")
		elseif kind == "NeedProduct" then
			if not Shop.prompt(data.productKey) then
				HUD.toast("No tokens left. Earn more by finishing crossings.")
			end
		end
	end)

	ReplicatedStorage:GetAttributeChangedSignal("MatchState"):Connect(function()
		local matchState = ReplicatedStorage:GetAttribute("MatchState")
		if matchState == "Ferry" or matchState == "Planning" then
			Results.close()
		end
	end)

	-- First visit: choose a crew member (also covers a missed server notification).
	task.delay(1.5, function()
		if not player:GetAttribute("CharId") then
			CharacterSelect.open()
		end
	end)

	RunService.RenderStepped:Connect(function(dt)
		HUD.update(dt)
		Satchel.refresh()
		Shop.refresh()
	end)
end

return UIController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000041"><Properties><string name="Name">WeaponController</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Client side of the gun system: input -> server intents, plus instant local feedback
-- (muzzle flash, recoil kick, crosshair bloom) so shooting feels responsive. The server
-- decides every hit (WeaponService).
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Items = require(Shared.Config.Items)
local Weapons = require(Shared.Config.Weapons)
local Net = require(Shared.Net)
local State = require(script.Parent.Parent.State)

local WeaponController = {}
local Controllers
local player = Players.LocalPlayer

local nextFireAt = 0
local cachedJson, cachedStats = nil, {}

local function act(name, payload)
	Net.event("Action"):FireServer(name, payload)
end

function WeaponController.stats()
	local json = player:GetAttribute("WeaponStats")
	if json ~= cachedJson then
		cachedJson = json
		local ok, decoded = pcall(function()
			return HttpService:JSONDecode(json or "{}")
		end)
		cachedStats = ok and decoded or {}
	end
	return cachedStats
end

-- slot, weaponId, stats (or nil when holstered)
function WeaponController.current()
	local char = State.character
	if not char then
		return "none", nil, nil
	end
	local slot = char:GetAttribute("EquippedSlot") or "none"
	local id = char:GetAttribute("Equipped")
	if not id or id == "" then
		return "none", nil, nil
	end
	return slot, id, WeaponController.stats()[slot]
end

function WeaponController.isReloading()
	local char = State.character
	return char ~= nil and (char:GetAttribute("ReloadUntil") or 0) > Workspace:GetServerTimeNow()
end

function WeaponController.equip(slot)
	if not State.character or State.downed then
		return
	end
	local current = WeaponController.current()
	if current == slot then
		slot = "none"
	end
	if slot ~= "none" and (player:GetAttribute("W_" .. slot) or "") == "" then
		return
	end
	act("Equip", slot)
end

function WeaponController.cycleWeapon()
	local current = WeaponController.current()
	local order = { "long", "sidearm", "none" }
	local index = table.find(order, current) or 3
	for step = 1, 3 do
		local slot = order[(index + step - 1) % 3 + 1]
		if slot == "none" or (player:GetAttribute("W_" .. slot) or "") ~= "" then
			act("Equip", slot)
			return
		end
	end
end

local function muzzleFlash(slot)
	local char = State.character
	local model = char and char:FindFirstChild("Weapon_" .. slot)
	local grip = model and model.PrimaryPart
	local muzzle = grip and grip:FindFirstChild("Muzzle")
	if not muzzle then
		return
	end
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 200, 140)
	light.Range = 16
	light.Brightness = 5
	light.Shadows = true
	light.Parent = muzzle
	local flash = Instance.new("ParticleEmitter")
	flash.Rate = 0
	flash.Lifetime = NumberRange.new(0.04, 0.07)
	flash.Speed = NumberRange.new(2, 6)
	flash.SpreadAngle = Vector2.new(18, 18)
	flash.EmissionDirection = Enum.NormalId.Front
	flash.LightEmission = 1
	flash.Color = ColorSequence.new(Color3.fromRGB(255, 210, 150))
	flash.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
	flash.Parent = muzzle
	flash:Emit(6)
	task.delay(0.06, function()
		light:Destroy()
	end)
	task.delay(0.3, function()
		flash:Destroy()
	end)
end

function WeaponController.fire()
	if not State.character or State.downed or State.uiOpen() then
		return
	end
	local slot, id, stat = WeaponController.current()
	if not id or not stat then
		return
	end
	local now = os.clock()
	if now < nextFireAt or WeaponController.isReloading() then
		return
	end
	local mag = player:GetAttribute("W_" .. slot .. "Mag") or 0
	if mag <= 0 then
		act("Reload")
		return
	end
	nextFireAt = now + (stat.fireDelay or 0.5)
	act("Fire", { dir = Controllers.CameraController.aimDirection(), aim = State.aiming })
	local def = Weapons.List[id]
	local runUpgrades = player:GetAttribute("RunUpgrades") or ""
	local quiet = id == "revolver" and runUpgrades:find('"baffle":true') ~= nil
	Controllers.SoundController.gunshot(id, State.root.Position, true, quiet)
	if def and not def.projectile then
		muzzleFlash(slot)
		if id ~= "revolver" and id ~= "bow" then
			WeaponController.ejectShell(slot, id == "shotgun")
		end
	end
	Controllers.CameraController.kick(stat.recoil or 3)
	State.bloom = math.min(State.bloom + (stat.recoil or 3) * 0.5, 8)
end

-- a brass (or red shotgun) casing tumbling out of the action
function WeaponController.ejectShell(slot, isShell)
	local char = State.character
	local model = char and char:FindFirstChild("Weapon_" .. slot)
	local grip = model and model.PrimaryPart
	if not grip then
		return
	end
	local casing = Instance.new("Part")
	casing.Size = isShell and Vector3.new(0.18, 0.18, 0.4) or Vector3.new(0.08, 0.08, 0.22)
	casing.Color = isShell and Color3.fromRGB(150, 40, 34) or Color3.fromRGB(196, 160, 70)
	casing.Material = Enum.Material.Metal
	casing.CanQuery = false
	casing.CanTouch = false
	casing.CFrame = grip.CFrame * CFrame.new(0.2, 0.35, -0.3)
	casing.Parent = Workspace
	casing.AssemblyLinearVelocity = grip.CFrame.RightVector * 12 + Vector3.new(0, 8, 0)
	casing.AssemblyAngularVelocity = Vector3.new(math.random(-20, 20), math.random(-20, 20), math.random(-20, 20))
	game:GetService("Debris"):AddItem(casing, 6)
end

function WeaponController.reload()
	local _, id = WeaponController.current()
	if id then
		act("Reload")
	end
end

-- Current spread in degrees (drives the crosshair; mirrors the server formula).
function WeaponController.spread()
	local _, id, stat = WeaponController.current()
	if not id or not stat then
		return 0
	end
	local def = Weapons.List[id]
	local spread = State.aiming and stat.spreadAim or stat.spreadHip
	local root = State.root
	if root then
		local v = root.AssemblyLinearVelocity
		local speed = Vector3.new(v.X, 0, v.Z).Magnitude
		if speed > 2 then
			spread += def.moveSpread * math.clamp(speed / 14, 0, 1.5)
		end
	end
	if State.crouched then
		spread *= 0.8
	end
	return spread + State.bloom
end

function WeaponController.aimFov()
	local _, id, stat = WeaponController.current()
	return id and stat and stat.fov or nil
end

function WeaponController.cycleThrowable()
	local list = Items.Throwables
	local index = table.find(list, State.throwable) or 1
	for step = 1, #list do
		local candidate = list[(index + step - 1) % #list + 1]
		if (player:GetAttribute("Inv_" .. candidate) or 0) > 0 then
			State.throwable = candidate
			return
		end
	end
end

function WeaponController.throw()
	if not State.character or State.downed or State.uiOpen() then
		return
	end
	if (player:GetAttribute("Inv_" .. State.throwable) or 0) < 1 then
		WeaponController.cycleThrowable()
	end
	if (player:GetAttribute("Inv_" .. State.throwable) or 0) < 1 then
		return
	end
	act("Throw", { dir = Controllers.CameraController.aimDirection(), item = State.throwable })
end

function WeaponController.init(registry)
	Controllers = registry
end

function WeaponController.start()
	local lastSlot = nil
	game:GetService("RunService").RenderStepped:Connect(function(dt)
		State.bloom = math.max(0, State.bloom - dt * 6)
		local slot = State.character and State.character:GetAttribute("EquippedSlot")
		if slot ~= lastSlot then
			if lastSlot ~= nil and slot ~= nil then
				require(Shared.Util.Sfx).ui("Equip", 0.6)
				State.weaponSwitchedAt = os.clock()
			end
			lastSlot = slot
		end
	end)
end

return WeaponController
]]></ProtectedString></Properties></Item>
</Item>
<Item class="LocalScript" referent="RBX00000043"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- AFTERTIDE client bootstrap.
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer
local State = require(script.Parent:WaitForChild("State"))
local Controllers = script.Parent:WaitForChild("Controllers")

-- Hide the default Roblox HUD pieces we replace (health bar, backpack). Chat and the player
-- list stay: co-op players need them.
task.spawn(function()
	for _ = 1, 20 do
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.EmotesMenu, false)
		end)
		if ok then
			break
		end
		task.wait(0.5)
	end
end)

local ORDER = { "CameraController", "WeaponController", "MovementController", "ActionController", "EffectsController", "GraphicsController", "AnimationController", "PlayerAnimator", "EnemyAnimator", "SoundController", "UIController" }
local controllers = {}
for _, name in ORDER do
	controllers[name] = require(Controllers:WaitForChild(name))
end
for _, name in ORDER do
	if controllers[name].init then
		controllers[name].init(controllers)
	end
end
for _, name in ORDER do
	if controllers[name].start then
		task.spawn(controllers[name].start)
	end
end

local function bindCharacter(char)
	local humanoid = char:WaitForChild("Humanoid")
	local root = char:WaitForChild("HumanoidRootPart")
	State.character = char
	State.humanoid = humanoid
	State.root = root
	State.baseHipHeight = humanoid.HipHeight
	State.crouched = false
	State.sprinting = false
	State.aiming = false
	State.downed = false
	for _, name in ORDER do
		if controllers[name].onCharacter then
			task.spawn(controllers[name].onCharacter, char)
		end
	end
end

player.CharacterAdded:Connect(bindCharacter)
player.CharacterRemoving:Connect(function(char)
	if State.character == char then
		State.character, State.humanoid, State.root = nil, nil, nil
	end
end)
if player.Character then
	task.spawn(bindCharacter, player.Character)
end
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000044"><Properties><string name="Name">State</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Shared client-side state for controllers and UI.
local State = {
	character = nil,
	humanoid = nil,
	root = nil,
	baseHipHeight = 2,

	crouched = false,
	sprinting = false,
	aiming = false,
	downed = false,
	shoulder = 1, -- 1 = right shoulder, -1 = left

	takedownUntil = 0,
	modals = {},

	throwable = "bottle", -- selected throwable
	bloom = 0, -- extra crosshair spread from recent shots (degrees)
	pitch = 0, -- camera pitch (radians), mirrored for poses
}

function State.setModal(name, open)
	State.modals[name] = open or nil
end

function State.uiOpen()
	return next(State.modals) ~= nil
end

return State
]]></ProtectedString></Properties></Item>
<Item class="Folder" referent="RBX0000004F"><Properties><string name="Name">UI</string></Properties><Item class="ModuleScript" referent="RBX00000045"><Properties><string name="Name">CharacterSelect</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The crew cabins: pick a character and ONE starting perk. Shows ability, loadout, innate perk.
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Characters = require(Shared.Config.Characters)
local Items = require(Shared.Config.Items)
local Weapons = require(Shared.Config.Weapons)
local Net = require(Shared.Net)
local Theme = require(script.Parent.Theme)
local State = require(script.Parent.Parent.State)

local CharacterSelect = {}
local C = Theme.Colors
local player = Players.LocalPlayer
local backdrop, closeButton

local function loadoutText(loadout)
	local guns = {}
	for _, slot in { "long", "sidearm" } do
		local id = loadout.weapons[slot]
		if id and Weapons.List[id] then
			table.insert(guns, Weapons.List[id].name)
		end
	end
	local parts = {}
	for _, itemId in Items.Order do
		local amount = loadout.items[itemId]
		if amount and amount > 0 then
			table.insert(parts, amount .. " " .. Items.Items[itemId].name)
		end
	end
	return table.concat(guns, " + ") .. "\n" .. table.concat(parts, " · ")
end

local function card(parent, charId, order)
	local def = Characters.List[charId]
	local selectedPerk = def.perks[1].id
	if player:GetAttribute("CharId") == charId and player:GetAttribute("PerkId") then
		selectedPerk = player:GetAttribute("PerkId")
	end

	local frame = Theme.panel({ Name = charId, LayoutOrder = order, Size = UDim2.new(0, 258, 0, 520), BackgroundColor3 = C.panelHi, Parent = parent })
	Theme.padding(12).Parent = frame
	Theme.list(Enum.FillDirection.Vertical, 5).Parent = frame

	local swatch = Theme.make("Frame", { LayoutOrder = 0, Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = def.colors.torso, BorderSizePixel = 0, Parent = frame })
	Theme.corner(3).Parent = swatch
	Theme.heading({ LayoutOrder = 1, Text = string.upper(def.name), TextSize = 22, Parent = frame })
	Theme.label({ LayoutOrder = 2, Text = def.role, TextColor3 = C.lantern, Font = Theme.Head, TextSize = 15, Size = UDim2.new(1, 0, 0, 18), Parent = frame })
	Theme.label({ LayoutOrder = 3, Text = def.bio, TextSize = 12, TextColor3 = C.dim, Size = UDim2.new(1, 0, 0, 32), Parent = frame })
	Theme.label({ LayoutOrder = 4, Text = "ABILITY · " .. def.ability.name, Font = Theme.Head, TextSize = 14, TextColor3 = C.salt, Size = UDim2.new(1, 0, 0, 16), Parent = frame })
	Theme.label({ LayoutOrder = 5, Text = def.ability.desc, TextSize = 12, Size = UDim2.new(1, 0, 0, 44), Parent = frame })
	Theme.label({ LayoutOrder = 6, Text = "LOADOUT", Font = Theme.Head, TextSize = 14, TextColor3 = C.salt, Size = UDim2.new(1, 0, 0, 16), Parent = frame })
	Theme.label({ LayoutOrder = 7, Text = loadoutText(def.loadout), TextSize = 12, Size = UDim2.new(1, 0, 0, 44), Parent = frame })
	Theme.label({ LayoutOrder = 8, Text = "INNATE · " .. def.innate.name, Font = Theme.Head, TextSize = 14, TextColor3 = C.salt, Size = UDim2.new(1, 0, 0, 16), Parent = frame })
	Theme.label({ LayoutOrder = 9, Text = def.innate.desc, TextSize = 12, Size = UDim2.new(1, 0, 0, 30), Parent = frame })
	Theme.label({ LayoutOrder = 10, Text = "STARTING PERK (choose one)", Font = Theme.Head, TextSize = 14, TextColor3 = C.salt, Size = UDim2.new(1, 0, 0, 16), Parent = frame })

	local perkRow = Theme.make("Frame", { LayoutOrder = 11, Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, Parent = frame })
	Theme.list(Enum.FillDirection.Horizontal, 4).Parent = perkRow
	local perkDesc = Theme.label({ LayoutOrder = 12, Text = "", TextSize = 12, Size = UDim2.new(1, 0, 0, 30), Parent = frame })
	local buttons = {}
	local function refresh()
		for id, button in buttons do
			local on = id == selectedPerk
			button.BackgroundColor3 = on and C.lantern or C.panel
			button.TextColor3 = on and C.backdrop or C.text
		end
		for _, perk in def.perks do
			if perk.id == selectedPerk then
				perkDesc.Text = perk.desc
			end
		end
	end
	for i, perk in def.perks do
		local b = Theme.button({ LayoutOrder = i, Text = perk.name, TextSize = 12, Size = UDim2.new(1 / 3, -3, 1, 0), Parent = perkRow })
		buttons[perk.id] = b
		b.Activated:Connect(function()
			selectedPerk = perk.id
			refresh()
		end)
	end
	refresh()

	local choose = Theme.button({ LayoutOrder = 13, Text = "CHOOSE " .. string.upper(def.name:match("^(%S+)")), Size = UDim2.new(1, 0, 0, 36), Parent = frame })
	choose.Activated:Connect(function()
		Net.event("SelectCharacter"):FireServer(charId, selectedPerk)
		CharacterSelect.close()
	end)
end

function CharacterSelect.build(gui)
	local panel
	backdrop, panel = Theme.modal(gui, "CharacterSelect", UDim2.new(0.96, 0, 0.92, 0), Vector2.new(1120, 640))
	Theme.heading({ Text = "THE CREW", TextSize = 30, Size = UDim2.new(1, -120, 0, 34), Parent = panel })
	Theme.label({ Text = "Every crew member is free. Each plays differently: own ability, loadout and perks.", Position = UDim2.new(0, 0, 0, 36), Size = UDim2.new(1, 0, 0, 20), TextColor3 = C.dim, TextSize = 13, Parent = panel })
	closeButton = Theme.button({ Text = "CLOSE", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 100, 0, 32), Parent = panel })
	closeButton.Activated:Connect(CharacterSelect.close)

	local scroller = Theme.make("ScrollingFrame", {
		Position = UDim2.new(0, 0, 0, 64),
		Size = UDim2.new(1, 0, 1, -64),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		ScrollingDirection = Enum.ScrollingDirection.XY,
		AutomaticCanvasSize = Enum.AutomaticSize.XY,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		Parent = panel,
	})
	Theme.list(Enum.FillDirection.Horizontal, 10).Parent = scroller
	for i, charId in Characters.Order do
		card(scroller, charId, i)
	end
end

function CharacterSelect.open()
	if not backdrop then
		return
	end
	closeButton.Visible = player:GetAttribute("CharId") ~= nil
	backdrop.Visible = true
	State.setModal("select", true)
end

function CharacterSelect.close()
	if not backdrop then
		return
	end
	backdrop.Visible = false
	State.setModal("select", false)
end

return CharacterSelect
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000046"><Properties><string name="Name">Chart</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The tide chart: choose the next encounter route (type, conditions, bonus).
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Encounters = require(Shared.Config.Encounters)
local Modifiers = require(Shared.Config.Modifiers)
local Theme = require(script.Parent.Theme)
local State = require(script.Parent.Parent.State)

local Chart = {}
local C = Theme.Colors
local backdrop, header, list
local request

local function modifierById(id)
	for _, m in Modifiers.List do
		if m.id == id then
			return m
		end
	end
	return Modifiers.None
end

local function rebuild()
	Theme.clear(list)
	local R = ReplicatedStorage
	header.Text = ("STOP %d OF %d  ·  PALL %d"):format(R:GetAttribute("RunIndex") or 1, R:GetAttribute("RunLength") or 4, R:GetAttribute("Pall") or 1)
	local ok, options = pcall(function()
		return HttpService:JSONDecode(R:GetAttribute("RouteOptions") or "[]")
	end)
	options = ok and options or {}
	local first
	for i, option in options do
		local def = option.type == "Finale" and Encounters.Finale or Encounters.Types[option.type]
		local mod = modifierById(option.modifier)
		local card = Theme.panel({ LayoutOrder = i, Size = UDim2.new(1, 0, 0, 124), BackgroundColor3 = C.panelHi, Parent = list })
		Theme.padding(10).Parent = card
		Theme.heading({ Text = string.upper(option.name), TextSize = 20, Size = UDim2.new(1, -170, 0, 24), Parent = card })
		local desc = def and def.desc or ""
		if option.type == "Salvage" then
			desc = desc:format(def.crates)
		end
		Theme.label({ Text = desc, Position = UDim2.new(0, 0, 0, 26), Size = UDim2.new(1, -170, 0, 34), TextSize = 13, Parent = card })
		Theme.label({
			Text = ("%s  ·  %s\nConditions: %s · %s%s"):format(option.mapName or "", option.factionName or "The Hushed", mod.name, mod.desc, (option.bonus or 0) > 0 and ("  ·  +" .. option.bonus .. " Salvage") or ""),
			Position = UDim2.new(0, 0, 0, 62),
			Size = UDim2.new(1, -170, 0, 44),
			TextSize = 12,
			TextColor3 = C.salt,
			Parent = card,
		})
		local go = Theme.button({ Text = "SET COURSE", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 150, 0, 40), Parent = card })
		go.Activated:Connect(function()
			request("ChooseRoute", i)
			Chart.close()
		end)
		first = first or go
	end
	Theme.focus(first)
end

function Chart.build(gui, requestFn)
	request = requestFn
	local panel
	backdrop, panel = Theme.modal(gui, "Chart", UDim2.new(0.94, 0, 0.9, 0), Vector2.new(720, 560))
	Theme.heading({ Text = "THE TIDE CHART", TextSize = 28, Size = UDim2.new(1, -120, 0, 32), Parent = panel })
	header = Theme.label({ Position = UDim2.new(0, 0, 0, 34), Size = UDim2.new(1, 0, 0, 20), TextColor3 = C.lantern, Font = Theme.Head, Parent = panel })
	local close = Theme.button({ Text = "CLOSE", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 100, 0, 32), Parent = panel })
	close.Activated:Connect(Chart.close)
	list = Theme.make("ScrollingFrame", {
		Position = UDim2.new(0, 0, 0, 64),
		Size = UDim2.new(1, 0, 1, -64),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		Parent = panel,
	})
	Theme.list(Enum.FillDirection.Vertical, 8).Parent = list
	ReplicatedStorage:GetAttributeChangedSignal("RouteOptions"):Connect(function()
		if backdrop.Visible then
			rebuild()
		end
	end)
end

function Chart.open()
	if backdrop then
		backdrop.Visible = true
		State.setModal("chart", true)
		rebuild()
	end
end

function Chart.close()
	if backdrop then
		backdrop.Visible = false
		State.setModal("chart", false)
	end
end

return Chart
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000047"><Properties><string name="Name">HUD</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The HUD, designed to stay out of the way (survival-game minimal, not a Roblox overlay):
--   top        compass bar with objective / teammate markers and distances; one-line objective
--   bottom-right  fading cluster: segmented health, weapon + ammo pips, throwable;
--                 a weapon strip pops up when you switch
--   screen     thin crosshair + hitmarker, red damage vignette, detection arrows, noise ring
-- Everything fades out when you're idle and comes back when it matters.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Characters = require(Shared.Config.Characters)
local Items = require(Shared.Config.Items)
local Movement = require(Shared.Config.Movement)
local Weapons = require(Shared.Config.Weapons)
local Theme = require(script.Parent.Theme)
local State = require(script.Parent.Parent.State)

local HUD = {}
local C = Theme.Colors
local player = Players.LocalPlayer
local Weapon

local root
local compass, compassStrip, compassTicks, compassMarkers, objectiveLine, locationLabel
local cluster, segments, weaponName, magLabel, reserveLabel, pipHolder, pips, throwLabel, abilityLabel
local strip, stripSlots
local ticks, dot, hitmarker
local vignette
local ring, ringLabel
local toastHolder
local downed, downedText, secondWindButton
local indicatorLayer
local indicators = {}
local noiseSmoothed, lastActivity, hitUntil, hurtFlash = 0, 0, 0, 0
local lastSig = ""

local SEGMENTS = 5
local COMPASS_W, COMPASS_FOV = 460, math.rad(150)

local function inv(id)
	return player:GetAttribute("Inv_" .. id) or 0
end

local function clock(seconds)
	seconds = math.max(0, math.floor(seconds))
	return ("%d:%02d"):format(math.floor(seconds / 60), seconds % 60)
end

local function label(props)
	props.TextStrokeTransparency = props.TextStrokeTransparency or 0.75
	return Theme.label(props)
end

function HUD.build(gui, onSecondWind, weaponController)
	Weapon = weaponController
	root = Theme.make("Frame", { Name = "HUD", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = gui })

	-- damage vignette (four soft red edges)
	vignette = {}
	for i, spec in {
		{ UDim2.new(0.18, 0, 1, 0), UDim2.new(0, 0, 0, 0), 0 },
		{ UDim2.new(0.18, 0, 1, 0), UDim2.new(0.82, 0, 0, 0), 180 },
		{ UDim2.new(1, 0, 0.2, 0), UDim2.new(0, 0, 0, 0), 90 },
		{ UDim2.new(1, 0, 0.2, 0), UDim2.new(0, 0, 0.8, 0), 270 },
	} do
		local f = Theme.make("Frame", { Size = spec[1], Position = spec[2], BackgroundColor3 = Color3.fromRGB(120, 10, 8), BorderSizePixel = 0, BackgroundTransparency = 1, Parent = root })
		local g = Instance.new("UIGradient")
		g.Rotation = spec[3]
		g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
		g.Parent = f
		vignette[i] = f
	end

	-- compass
	compass = Theme.make("CanvasGroup", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 18),
		Size = UDim2.new(0, COMPASS_W, 0, 30),
		BackgroundTransparency = 1,
		Parent = root,
	})
	local fade = Instance.new("UIGradient")
	fade.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.15, 0), NumberSequenceKeypoint.new(0.85, 0), NumberSequenceKeypoint.new(1, 1) })
	fade.Parent = compass
	Theme.make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 22), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = C.text, BackgroundTransparency = 0.6, BorderSizePixel = 0, Parent = compass })
	Theme.make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 18), Size = UDim2.new(0, 2, 0, 9), BackgroundColor3 = C.lantern, BorderSizePixel = 0, Parent = compass })
	compassStrip = Theme.make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = compass })
	compassTicks = {}
	for deg = 0, 345, 15 do
		local major = deg % 90 == 0
		local text = ({ [0] = "N", [90] = "E", [180] = "S", [270] = "W" })[deg] or (deg % 45 == 0 and "·" or "")
		local t = label({ Text = text, Font = Theme.Head, TextSize = major and 15 or 12, Size = UDim2.new(0, 24, 0, 18), AnchorPoint = Vector2.new(0.5, 0), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = major and C.text or C.dim, Parent = compassStrip })
		compassTicks[deg] = t
	end
	compassMarkers = {}
	objectiveLine = label({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 50), Size = UDim2.new(0, 520, 0, 18), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 13, TextColor3 = C.text, Font = Theme.Head, Parent = root })
	locationLabel = label({ Position = UDim2.new(0, 22, 0, 18), Size = UDim2.new(0, 360, 0, 40), TextSize = 14, Font = Theme.Head, TextColor3 = C.salt, TextWrapped = true, Parent = root })

	-- bottom-right cluster
	cluster = Theme.make("CanvasGroup", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -34, 1, -30), Size = UDim2.new(0, 260, 0, 120), BackgroundTransparency = 1, Parent = root })
	weaponName = label({ Size = UDim2.new(1, 0, 0, 16), TextXAlignment = Enum.TextXAlignment.Right, Font = Theme.Head, TextSize = 14, TextColor3 = C.dim, Parent = cluster })
	magLabel = label({ Position = UDim2.new(0, 0, 0, 14), Size = UDim2.new(1, -56, 0, 44), TextXAlignment = Enum.TextXAlignment.Right, Font = Theme.Head, TextSize = 44, Parent = cluster })
	reserveLabel = label({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 30), Size = UDim2.new(0, 52, 0, 24), TextXAlignment = Enum.TextXAlignment.Left, Font = Theme.Head, TextSize = 20, TextColor3 = C.dim, Parent = cluster })
	pipHolder = Theme.make("Frame", { Position = UDim2.new(0, 0, 0, 62), Size = UDim2.new(1, 0, 0, 10), BackgroundTransparency = 1, Parent = cluster })
	local pipLayout = Theme.list(Enum.FillDirection.Horizontal, 3)
	pipLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	pipLayout.Parent = pipHolder
	pips = {}
	for i = 1, 12 do
		pips[i] = Theme.make("Frame", { LayoutOrder = i, Size = UDim2.new(0, 4, 0, 10), BackgroundColor3 = C.text, BorderSizePixel = 0, Parent = pipHolder })
	end
	throwLabel = label({ Position = UDim2.new(0, 0, 0, 76), Size = UDim2.new(1, 0, 0, 16), TextXAlignment = Enum.TextXAlignment.Right, Font = Theme.Head, TextSize = 13, Parent = cluster })
	local healthRow = Theme.make("Frame", { Position = UDim2.new(0, 0, 0, 100), Size = UDim2.new(1, 0, 0, 7), BackgroundTransparency = 1, Parent = cluster })
	local hl = Theme.list(Enum.FillDirection.Horizontal, 3)
	hl.HorizontalAlignment = Enum.HorizontalAlignment.Right
	hl.Parent = healthRow
	segments = {}
	for i = 1, SEGMENTS do
		local back = Theme.make("Frame", { LayoutOrder = i, Size = UDim2.new(0, 46, 1, 0), BackgroundColor3 = Color3.fromRGB(40, 40, 38), BackgroundTransparency = 0.3, BorderSizePixel = 0, Parent = healthRow })
		segments[i] = Theme.make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.text, BorderSizePixel = 0, Parent = back })
	end
	abilityLabel = label({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 24, 1, -30), Size = UDim2.new(0, 300, 0, 18), Font = Theme.Head, TextSize = 13, TextColor3 = C.salt, Parent = root })

	-- weapon switch strip
	strip = Theme.make("CanvasGroup", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -34, 1, -158), Size = UDim2.new(0, 360, 0, 34), BackgroundTransparency = 1, GroupTransparency = 1, Parent = root })
	local sl = Theme.list(Enum.FillDirection.Horizontal, 6)
	sl.HorizontalAlignment = Enum.HorizontalAlignment.Right
	sl.Parent = strip
	stripSlots = {}
	for i, slot in { "long", "sidearm", "none" } do
		local f = Theme.make("Frame", { LayoutOrder = i, Size = UDim2.new(0, 112, 1, 0), BackgroundColor3 = C.panel, BackgroundTransparency = 0.25, BorderSizePixel = 0, Parent = strip })
		Theme.make("UIStroke", { Color = C.line, Transparency = 0.4, Parent = f })
		stripSlots[slot] = label({ Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center, Font = Theme.Head, TextSize = 13, Parent = f })
	end

	-- noise ring (small, bottom centre)
	local ringHolder = Theme.make("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -26), Size = UDim2.new(0, 70, 0, 70), BackgroundTransparency = 1, Parent = root })
	ring = Theme.make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.1, 0.1), BackgroundTransparency = 1, Parent = ringHolder })
	Theme.make("UICorner", { CornerRadius = UDim.new(1, 0), Parent = ring })
	Theme.make("UIStroke", { Color = C.text, Thickness = 1.5, Transparency = 0.45, Parent = ring })
	Theme.make("UIAspectRatioConstraint", { Parent = ring })
	ringLabel = label({ Text = "", TextSize = 11, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.new(0, 120, 0, 14), TextXAlignment = Enum.TextXAlignment.Center, Font = Theme.Head, TextColor3 = C.dim, Parent = ringHolder })

	-- crosshair
	ticks = {}
	for i = 1, 4 do
		local horizontal = i <= 2
		ticks[i] = Theme.make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = horizontal and UDim2.new(0, 8, 0, 1) or UDim2.new(0, 1, 0, 8), BackgroundColor3 = C.text, BackgroundTransparency = 0.1, BorderSizePixel = 0, Visible = false, Parent = root })
	end
	dot = Theme.make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 3, 0, 3), BackgroundColor3 = C.text, BorderSizePixel = 0, Visible = false, Parent = root })
	Theme.make("UICorner", { CornerRadius = UDim.new(1, 0), Parent = dot })
	hitmarker = Theme.make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 22, 0, 22), BackgroundTransparency = 1, Visible = false, Parent = root })
	for _, rot in { 45, -45 } do
		Theme.make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, 0, 0, 2), Rotation = rot, BackgroundColor3 = C.text, BorderSizePixel = 0, Parent = hitmarker })
	end

	indicatorLayer = Theme.make("Frame", { Name = "Indicators", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = root })

	toastHolder = Theme.make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 76), Size = UDim2.new(0, 620, 0, 160), BackgroundTransparency = 1, Parent = root })
	Theme.list(Enum.FillDirection.Vertical, 2, Enum.HorizontalAlignment.Center).Parent = toastHolder

	downed = Theme.make("Frame", { Name = "Downed", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.5, Visible = false, Parent = root })
	downedText = Theme.heading({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42), Size = UDim2.new(0.9, 0, 0, 80), TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = true, TextSize = 26, Parent = downed })
	secondWindButton = Theme.button({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.53), Size = UDim2.new(0, 320, 0, 44), Text = "SECOND WIND  [R]", Parent = downed })
	secondWindButton.Activated:Connect(onSecondWind)
end

function HUD.toast(text)
	if not toastHolder or text == "" then
		return
	end
	local l = label({ Text = text, Size = UDim2.new(1, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 14, Font = Theme.Head, TextStrokeTransparency = 0.6, Parent = toastHolder })
	task.delay(3.2, function()
		for i = 1, 10 do
			l.TextTransparency = i / 10
			l.TextStrokeTransparency = 0.6 + i / 25
			task.wait(0.04)
		end
		l:Destroy()
	end)
	local children = toastHolder:GetChildren()
	if #children > 5 then
		for _, child in children do
			if child:IsA("TextLabel") then
				child:Destroy()
				break
			end
		end
	end
end

function HUD.hit(data)
	if not hitmarker then
		return
	end
	hitUntil = os.clock() + (data.kill and 0.35 or 0.15)
	local color = data.kill and C.danger or (data.headshot and C.lantern or C.text)
	hitmarker.Size = UDim2.new(0, data.headshot and 30 or 22, 0, data.headshot and 30 or 22)
	for _, line in hitmarker:GetChildren() do
		if line:IsA("Frame") then
			line.BackgroundColor3 = color
		end
	end
end

function HUD.hurt()
	hurtFlash = 1
	lastActivity = os.clock()
end

-- Compass ------------------------------------------------------------------------------------

local function headingOf(dir)
	return math.atan2(dir.X, -dir.Z) -- 0 = north (-Z)
end

local function compassX(angle, camHeading)
	local rel = (angle - camHeading + math.pi) % (2 * math.pi) - math.pi
	return rel / (COMPASS_FOV / 2) * (COMPASS_W / 2) + COMPASS_W / 2, math.abs(rel) < COMPASS_FOV / 2
end

local function objectiveTargets()
	local list = {}
	local world = Workspace:FindFirstChild("World")
	local encounter = world and world:FindFirstChild("Encounter")
	local R = ReplicatedStorage
	if R:GetAttribute("MatchState") == "Encounter" and player:GetAttribute("InCrossing") then
		if encounter then
			for _, p in encounter:GetChildren() do
				if p.Name == "SupplyCrate" then
					table.insert(list, { pos = p.Position, color = C.lantern, text = "◆" })
				elseif p.Name == "Flare" and R:GetAttribute("ExtractionOpen") then
					table.insert(list, { pos = p.Position, color = C.danger, text = "▼", label = "FLARE" })
				elseif p.Name == "SignalLantern" then
					table.insert(list, { pos = p.Position, color = C.lantern, text = "✦", label = "LANTERN" })
				end
			end
		end
	else
		local ferry = world and world:FindFirstChild("Meridian")
		local chart = ferry and ferry:FindFirstChild("ChartTable")
		local bench = ferry and ferry:FindFirstChild("Workbench")
		if chart then
			table.insert(list, { pos = chart.Position, color = C.lantern, text = "◆", label = "TIDE CHART" })
		end
		if bench and R:GetAttribute("MatchState") == "Planning" then
			table.insert(list, { pos = bench.Position, color = C.salt, text = "◇", label = "WORKBENCH" })
		end
	end
	for _, p in Players:GetPlayers() do
		local char = p ~= player and p.Character
		local r = char and char:FindFirstChild("HumanoidRootPart")
		if r then
			table.insert(list, { pos = r.Position, color = char:GetAttribute("Downed") and C.danger or C.salt, text = "●", label = p.DisplayName })
		end
	end
	return list
end

local function updateCompass(camera)
	local look = camera.CFrame.LookVector
	local heading = headingOf(Vector3.new(look.X, 0, look.Z))
	for deg, t in compassTicks do
		local x, visible = compassX(math.rad(deg), heading)
		t.Visible = visible
		t.Position = UDim2.fromOffset(x, 0)
	end
	local targets = objectiveTargets()
	local origin = State.root and State.root.Position or camera.CFrame.Position
	for i, target in targets do
		local m = compassMarkers[i]
		if not m then
			m = label({ Size = UDim2.new(0, 80, 0, 30), AnchorPoint = Vector2.new(0.5, 0), TextXAlignment = Enum.TextXAlignment.Center, Font = Theme.Head, TextSize = 12, Parent = compassStrip })
			compassMarkers[i] = m
		end
		local d = target.pos - origin
		local x, visible = compassX(headingOf(Vector3.new(d.X, 0, d.Z)), heading)
		m.Visible = true
		m.Position = UDim2.fromOffset(math.clamp(x, 10, COMPASS_W - 10), -2)
		m.TextColor3 = target.color
		local meters = math.floor(d.Magnitude * 0.28 + 0.5)
		m.Text = target.text .. (visible and ("\n" .. meters .. "m") or "")
	end
	for i = #targets + 1, #compassMarkers do
		compassMarkers[i].Visible = false
	end
end

-- Detection arrows ------------------------------------------------------------------------------

local function updateIndicators(camera, active)
	local enemies = Workspace:FindFirstChild("Enemies")
	local seen = {}
	if active and enemies and State.root then
		local key = "Sus_" .. player.UserId
		local viewport = camera.ViewportSize
		local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
		local radius = math.min(viewport.X, viewport.Y) * 0.2
		for _, model in enemies:GetChildren() do
			local r = model:FindFirstChild("HumanoidRootPart")
			local st = model:GetAttribute("State")
			local sus = model:GetAttribute(key) or 0
			local hunting = st == "Chase" and model:GetAttribute("Target") == player.UserId
			if r and st ~= "Dispersed" and (sus > 0.04 or hunting) then
				seen[model] = true
				local l = indicators[model]
				if not l then
					l = label({ Text = "▲", Font = Enum.Font.GothamBold, TextSize = 22, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0, 28, 0, 28), TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center, Parent = indicatorLayer })
					indicators[model] = l
				end
				local rel = camera.CFrame:PointToObjectSpace(r.Position)
				local angle = math.atan2(rel.X, -rel.Z)
				l.Position = UDim2.fromOffset(center.X + math.sin(angle) * radius, center.Y - math.cos(angle) * radius)
				l.Rotation = math.deg(angle)
				local level = hunting and 1 or math.clamp(sus, 0, 1)
				l.TextColor3 = hunting and C.danger or (level >= 0.35 and C.lantern or C.text)
				l.TextTransparency = 0.8 - level * 0.8
				l.TextSize = 16 + level * 12
			end
		end
	end
	for model, l in indicators do
		if not seen[model] then
			l:Destroy()
			indicators[model] = nil
		end
	end
end

-- Frame update ----------------------------------------------------------------------------------

local function objectiveText(matchState, inEncounter)
	local R = ReplicatedStorage
	if matchState == "Encounter" and inEncounter then
		local kind = R:GetAttribute("EncounterType")
		local left = (R:GetAttribute("EndsAt") or 0) - Workspace:GetServerTimeNow()
		local name = string.upper(R:GetAttribute("EncounterName") or "")
		if kind == "Salvage" then
			return R:GetAttribute("ExtractionOpen") and (name .. "  ·  REACH THE FLARE")
				or ("%s  ·  CRATES %d / %d"):format(name, R:GetAttribute("Crates") or 0, R:GetAttribute("CratesRequired") or 0)
		elseif kind == "LanternWatch" then
			local hp, max = R:GetAttribute("LanternHP") or 0, math.max(1, R:GetAttribute("LanternMax") or 1)
			return ("%s  ·  LANTERN %d%%  ·  WAVE %d / %d  ·  %s"):format(name, math.floor(hp / max * 100), R:GetAttribute("Wave") or 0, R:GetAttribute("Waves") or 0, clock(left))
		elseif kind == "Drift" then
			return R:GetAttribute("ExtractionOpen") and (name .. "  ·  REACH THE FLARE") or (name .. "  ·  SURVIVE  " .. clock(left))
		end
	elseif matchState == "Starting" then
		return ("CASTING OFF IN %d"):format(math.max(0, math.ceil((R:GetAttribute("StartsAt") or 0) - Workspace:GetServerTimeNow())))
	elseif matchState == "Planning" then
		return "UPGRADE AT THE WORKBENCH  ·  CHOOSE A ROUTE AT THE TIDE CHART"
	elseif matchState == "Ferry" then
		return "READ THE TIDE CHART TO BEGIN A CROSSING"
	end
	return ""
end

function HUD.update(dt)
	if not root then
		return
	end
	local camera = Workspace.CurrentCamera
	local viewport = camera.ViewportSize
	local char = State.character
	local R = ReplicatedStorage
	local matchState = R:GetAttribute("MatchState")
	local inEncounter = matchState == "Encounter" and char ~= nil and player:GetAttribute("InCrossing") == true
	local now = os.clock()

	updateCompass(camera)
	objectiveLine.Text = objectiveText(matchState, inEncounter)
	if inEncounter then
		locationLabel.Text = ("%s\n%s · PALL %d"):format(string.upper(Workspace:GetAttribute("MapName") or ""), string.upper(R:GetAttribute("ModifierName") or ""), R:GetAttribute("Pall") or 1)
	elseif char then
		locationLabel.Text = R:GetAttribute("RunActive") and player:GetAttribute("InCrossing") and ("THE MERIDIAN\nSTOP %d OF %d · SALVAGE %d"):format(R:GetAttribute("RunIndex") or 1, R:GetAttribute("RunLength") or 4, player:GetAttribute("Salvage") or 0) or ("THE MERIDIAN\nSCRIP %d"):format(player:GetAttribute("Scrip") or 0)
	else
		locationLabel.Text = ""
	end

	-- health segments
	local hp = char and char:GetAttribute("HP") or 0
	local maxHp = char and char:GetAttribute("MaxHP") or 100
	local frac = math.clamp(hp / maxHp, 0, 1)
	for i, seg in segments do
		local segFrac = math.clamp(frac * SEGMENTS - (i - 1), 0, 1)
		seg.Size = UDim2.fromScale(segFrac, 1)
		seg.BackgroundColor3 = frac < 0.35 and C.danger or C.text
	end

	-- weapon
	local slot, id = Weapon.current()
	local def = id and Weapons.List[id]
	local mag = def and (player:GetAttribute("W_" .. slot .. "Mag") or 0) or 0
	if def then
		weaponName.Text = string.upper(def.name) .. (Weapon.isReloading() and "  ·  RELOADING" or "")
		magLabel.Text = tostring(mag)
		magLabel.TextColor3 = mag == 0 and C.danger or C.text
		reserveLabel.Text = "/ " .. inv(def.ammo)
		local stats = Weapon.stats()[slot]
		local size = stats and stats.mag or def.mag
		for i, pip in pips do
			pip.Visible = i <= math.min(size, 12)
			pip.BackgroundTransparency = i <= mag and 0 or 0.75
		end
	else
		weaponName.Text = "UNARMED"
		magLabel.Text = ""
		reserveLabel.Text = ""
		for _, pip in pips do
			pip.Visible = false
		end
	end
	throwLabel.Text = ("%s  %d"):format(string.upper(Items.Items[State.throwable].name), inv(State.throwable))
	local charId = player:GetAttribute("CharId")
	local cdef = charId and Characters.List[charId]
	if cdef and char then
		local remaining = (char:GetAttribute("AbilityReadyAt") or 0) - Workspace:GetServerTimeNow()
		abilityLabel.Text = ("%s  %s"):format(string.upper(cdef.ability.name), remaining > 0 and (math.ceil(remaining) .. "s") or "· READY")
		abilityLabel.TextTransparency = remaining > 0 and 0.5 or 0.1
	else
		abilityLabel.Text = ""
	end

	-- contextual fade: show when aiming, hurt, low, reloading, just changed, or in a fight
	local sig = ("%s|%s|%d|%d|%s|%d"):format(tostring(id), tostring(slot), mag, inv(State.throwable), State.throwable, math.floor(hp))
	if sig ~= lastSig then
		lastSig = sig
		lastActivity = now
	end
	local wanted = State.aiming or frac < 0.5 or Weapon.isReloading() or (now - lastActivity) < 4 or not inEncounter
	cluster.GroupTransparency += ((wanted and 0 or 0.65) - cluster.GroupTransparency) * math.min(1, dt * 4)
	cluster.Visible = char ~= nil

	-- weapon strip after a switch
	local switched = State.weaponSwitchedAt and (now - State.weaponSwitchedAt) < 1.6
	strip.GroupTransparency += ((switched and 0 or 1) - strip.GroupTransparency) * math.min(1, dt * 8)
	for s, l in stripSlots do
		local wid = s ~= "none" and (player:GetAttribute("W_" .. s) or "") or ""
		l.Text = s == "none" and "UNARMED" or (wid ~= "" and Weapons.List[wid] and string.upper(Weapons.List[wid].name) or "—")
		l.TextColor3 = (slot == s) and C.lantern or C.dim
	end

	-- crosshair
	local show = def ~= nil and not State.uiOpen() and not State.downed
	local gap = 0
	if show then
		gap = math.tan(math.rad(Weapon.spread())) * viewport.Y / (2 * math.tan(math.rad(camera.FieldOfView) / 2)) + 3
	end
	local cx, cy = viewport.X / 2, viewport.Y / 2
	local offs = { Vector2.new(-gap - 4, 0), Vector2.new(gap + 4, 0), Vector2.new(0, -gap - 4), Vector2.new(0, gap + 4) }
	for i, t in ticks do
		t.Visible = show and State.aiming
		t.Position = UDim2.fromOffset(cx + offs[i].X, cy + offs[i].Y)
	end
	dot.Visible = show or (State.aiming and not State.uiOpen())
	hitmarker.Visible = now < hitUntil

	-- vignette: hits flash it, low health keeps it
	hurtFlash = math.max(0, hurtFlash - dt * 1.6)
	local vig = math.clamp(math.max(hurtFlash, (inEncounter and frac < 0.35) and (0.45 + math.sin(now * 3) * 0.1) or 0), 0, 1)
	for _, f in vignette do
		f.BackgroundTransparency = 1 - vig * 0.8
	end

	-- noise ring
	local noise = inEncounter and char and char:GetAttribute("Noise") or 0
	noiseSmoothed += (noise - noiseSmoothed) * math.min(1, dt * 8)
	local scale = math.clamp(noiseSmoothed / Movement.Noise.Sprint, 0.1, 1)
	ring.Size = UDim2.fromScale(scale, scale)
	ring.UIStroke.Transparency = inEncounter and 0.45 or 1
	ringLabel.Text = (inEncounter and noise > Movement.Noise.Walk + 2) and "LOUD" or ""
	ringLabel.TextColor3 = noise > Movement.Noise.Jog + 4 and C.danger or C.lantern

	-- downed
	local isDowned = char and char:GetAttribute("Downed") == true
	local isOut = char and char:GetAttribute("Out") == true
	downed.Visible = (isDowned or isOut) and inEncounter or false
	if isOut then
		downedText.Text = "LOST TO THE PALL\nWaiting for your crew…"
		secondWindButton.Visible = false
	elseif isDowned then
		local bleed = math.max(0, math.ceil((char:GetAttribute("BleedOutAt") or 0) - Workspace:GetServerTimeNow()))
		downedText.Text = ("YOU'RE DOWN\nA crewmate can revive you · %ds"):format(bleed)
		secondWindButton.Visible = true
		secondWindButton.Text = ("SECOND WIND  [R]   ·   %d"):format(player:GetAttribute("Tokens_secondWind") or 0)
	end

	updateIndicators(camera, inEncounter)
	assert(CollectionService)
end

return HUD
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000048"><Properties><string name="Name">Repairs</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The Meridian repairs board: permanent homebase upgrades bought with Scrip (earned only by
-- playing), plus the armory once its rack is repaired.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Upgrades = require(Shared.Config.Upgrades)
local Weapons = require(Shared.Config.Weapons)
local Theme = require(script.Parent.Theme)
local State = require(script.Parent.Parent.State)

local Repairs = {}
local C = Theme.Colors
local player = Players.LocalPlayer
local backdrop, list, scripLabel
local request

local function owned()
	local ok, value = pcall(function()
		return HttpService:JSONDecode(player:GetAttribute("Repairs") or "{}")
	end)
	return ok and value or {}
end

local function rebuild()
	Theme.clear(list)
	scripLabel.Text = ("SCRIP %d   ·   earned by clearing encounters"):format(player:GetAttribute("Scrip") or 0)
	local have = owned()
	local first
	for i, r in Upgrades.Repairs do
		local done = have[r.id] == true
		local row = Theme.panel({ LayoutOrder = i, Size = UDim2.new(1, 0, 0, 56), BackgroundColor3 = C.panelHi, Parent = list })
		Theme.padding(8).Parent = row
		Theme.heading({ Text = string.upper(r.name), TextSize = 15, Size = UDim2.new(1, -130, 0, 18), Parent = row })
		Theme.label({ Text = r.desc, Position = UDim2.new(0, 0, 0, 20), Size = UDim2.new(1, -130, 0, 20), TextSize = 12, TextColor3 = C.dim, Parent = row })
		local b = Theme.button({
			Text = done and "REPAIRED" or (r.cost .. " SCRIP"),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0),
			Size = UDim2.new(0, 120, 0, 34),
			TextSize = 14,
			AutoButtonColor = not done,
			Parent = row,
		})
		if done then
			b.TextColor3 = C.ok
		else
			b.Activated:Connect(function()
				request("Repair", r.id)
			end)
			first = first or b
		end
	end
	if have.armory then
		Theme.heading({ LayoutOrder = 50, Text = "ARMORY: LONG GUN FOR YOUR NEXT CROSSING", TextSize = 16, TextColor3 = C.salt, Size = UDim2.new(1, 0, 0, 24), Parent = list })
		local rowFrame = Theme.make("Frame", { LayoutOrder = 51, Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 1, Parent = list })
		Theme.list(Enum.FillDirection.Horizontal, 6).Parent = rowFrame
		local choice = player:GetAttribute("LongGunChoice")
		for i, id in Weapons.LongGuns do
			local b = Theme.button({ LayoutOrder = i, Text = Weapons.List[id].name, TextSize = 13, Size = UDim2.new(0.25, -5, 1, 0), Parent = rowFrame })
			if choice == id then
				b.BackgroundColor3 = C.lantern
				b.TextColor3 = C.backdrop
			end
			b.Activated:Connect(function()
				request("SetLongGun", id)
				task.delay(0.3, rebuild)
			end)
		end
	end
	Theme.focus(first)
end

function Repairs.build(gui, requestFn)
	request = requestFn
	local panel
	backdrop, panel = Theme.modal(gui, "Repairs", UDim2.new(0.94, 0, 0.9, 0), Vector2.new(660, 600))
	Theme.heading({ Text = "REPAIRING THE MERIDIAN", TextSize = 26, Size = UDim2.new(1, -120, 0, 32), Parent = panel })
	scripLabel = Theme.heading({ Position = UDim2.new(0, 0, 0, 34), Size = UDim2.new(1, 0, 0, 22), TextSize = 15, TextColor3 = C.lantern, Parent = panel })
	local close = Theme.button({ Text = "CLOSE", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 100, 0, 32), Parent = panel })
	close.Activated:Connect(Repairs.close)
	list = Theme.make("ScrollingFrame", {
		Position = UDim2.new(0, 0, 0, 64),
		Size = UDim2.new(1, 0, 1, -64),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		Parent = panel,
	})
	Theme.list(Enum.FillDirection.Vertical, 6).Parent = list
	for _, attr in { "Scrip", "Repairs" } do
		player:GetAttributeChangedSignal(attr):Connect(function()
			if backdrop.Visible then
				rebuild()
			end
		end)
	end
end

function Repairs.open()
	if backdrop then
		backdrop.Visible = true
		State.setModal("repairs", true)
		rebuild()
	end
end

function Repairs.close()
	if backdrop then
		backdrop.Visible = false
		State.setModal("repairs", false)
	end
end

return Repairs
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000049"><Properties><string name="Name">Results</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- End-of-encounter debrief.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local Theme = require(script.Parent.Theme)
local State = require(script.Parent.Parent.State)

local Results = {}
local C = Theme.Colors
local backdrop, title, body

function Results.build(gui)
	local panel
	backdrop, panel = Theme.modal(gui, "Results", UDim2.new(0.9, 0, 0.7, 0), Vector2.new(580, 420))
	Theme.list(Enum.FillDirection.Vertical, 10).Parent = panel
	title = Theme.heading({ LayoutOrder = 1, Text = "", TextSize = 32, Size = UDim2.new(1, 0, 0, 38), Parent = panel })
	body = Theme.label({ LayoutOrder = 2, Text = "", TextSize = 15, Size = UDim2.new(1, 0, 0, 170), Parent = panel })
	local back = Theme.button({ LayoutOrder = 3, Text = "RETURN TO THE MERIDIAN", Size = UDim2.new(0, 280, 0, 40), Parent = panel })
	back.Activated:Connect(function()
		Net.event("ReturnToFerry"):FireServer()
		back.Text = "WAITING FOR CREW…"
	end)
	Results.backButton = back
end

function Results.show(data)
	if not backdrop then
		return
	end
	if data.runWon then
		title.Text = "THE BREAKWATER IS LIT"
		title.TextColor3 = C.lantern
	elseif data.win then
		title.Text = string.upper(tostring(data.name or "")) .. " CLEARED"
		title.TextColor3 = C.lantern
	else
		title.Text = "LOST TO THE PALL"
		title.TextColor3 = C.danger
	end
	local seconds = data.seconds or 0
	local lines = {
		("Stop %d  ·  Pall %d  ·  %d:%02d"):format(data.index or 1, data.pall or 1, math.floor(seconds / 60), seconds % 60),
		("Quietings %d  ·  Hushed dispersed %d  ·  Times spotted %d"):format(data.takedowns or 0, data.kills or 0, data.detections or 0),
	}
	if (data.crates or 0) > 0 then
		table.insert(lines, ("Supply crates %d"):format(data.crates))
	end
	if data.rewards and #data.rewards > 0 then
		table.insert(lines, "")
		table.insert(lines, "Earned: " .. table.concat(data.rewards, ", "))
	end
	table.insert(lines, "")
	if data.runOver then
		table.insert(lines, data.runWon and "Crossing complete. Scrip is yours to keep: repair the Meridian." or "The crossing is over. Scrip you earned is kept.")
	else
		table.insert(lines, "Back to the Meridian to upgrade and choose the next route.")
	end
	body.Text = table.concat(lines, "\n")
	Results.backButton.Text = "RETURN TO THE MERIDIAN"
	backdrop.Visible = true
	State.setModal("results", true)
end

function Results.close()
	if backdrop then
		backdrop.Visible = false
		State.setModal("results", false)
	end
end

return Results
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000004A"><Properties><string name="Name">Satchel</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The satchel: everything you carry, throwable selection, field crafting and run aids.
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Items = require(Shared.Config.Items)
local Stats = require(Shared.Stats)
local Theme = require(script.Parent.Theme)
local State = require(script.Parent.Parent.State)

local Satchel = {}
local C = Theme.Colors
local player = Players.LocalPlayer
local backdrop, partsText, ammoText, kitText, tokenText
local throwButtons = {}
local recipeLabels = {}
local firstButton
local sendAction

local function inv(id)
	return player:GetAttribute("Inv_" .. id) or 0
end

local function cap(id)
	return player:GetAttribute("Cap_" .. id) or Items.Items[id].cap
end

local function line(ids)
	local parts = {}
	for _, id in ids do
		table.insert(parts, ("%s %d/%d"):format(Items.Items[id].name, inv(id), cap(id)))
	end
	return table.concat(parts, "   ")
end

local function costText(recipe)
	local parts = {}
	for itemId, amount in recipe.cost do
		local have = inv(itemId)
		table.insert(parts, ("%d %s%s"):format(amount, Items.Items[itemId].name, have < amount and " ✕" or ""))
	end
	local mods = Stats.compute(player:GetAttribute("CharId"), player:GetAttribute("PerkId"))
	local yield = recipe.amount + ((recipe.perkYield and mods.craftYieldBonus) or 0)
	return table.concat(parts, " + ") .. (yield > 1 and ("  →  ×" .. yield) or "")
end

function Satchel.build(gui, actionSender)
	sendAction = actionSender
	local panel
	backdrop, panel = Theme.modal(gui, "Satchel", UDim2.new(0.94, 0, 0.9, 0), Vector2.new(640, 640))
	local scroller = Theme.make("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		Parent = panel,
	})
	Theme.list(Enum.FillDirection.Vertical, 8).Parent = scroller
	Theme.heading({ LayoutOrder = 1, Text = "SATCHEL", TextSize = 28, Size = UDim2.new(1, 0, 0, 32), Parent = scroller })
	partsText = Theme.label({ LayoutOrder = 2, Font = Theme.Head, TextSize = 14, Size = UDim2.new(1, 0, 0, 36), Parent = scroller })
	ammoText = Theme.label({ LayoutOrder = 3, Font = Theme.Head, TextSize = 14, Size = UDim2.new(1, 0, 0, 20), TextColor3 = C.lantern, Parent = scroller })
	kitText = Theme.label({ LayoutOrder = 4, Font = Theme.Head, TextSize = 14, Size = UDim2.new(1, 0, 0, 20), Parent = scroller })

	Theme.heading({ LayoutOrder = 5, Text = "THROWABLE (G to throw)", TextSize = 17, TextColor3 = C.salt, Size = UDim2.new(1, 0, 0, 22), Parent = scroller })
	local row = Theme.make("Frame", { LayoutOrder = 6, Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1, Parent = scroller })
	Theme.list(Enum.FillDirection.Horizontal, 6).Parent = row
	for i, id in Items.Throwables do
		local b = Theme.button({ LayoutOrder = i, Text = Items.Items[id].name, TextSize = 13, Size = UDim2.new(0.25, -5, 1, 0), Parent = row })
		throwButtons[id] = b
		b.Activated:Connect(function()
			State.throwable = id
		end)
		firstButton = firstButton or b
	end

	Theme.heading({ LayoutOrder = 7, Text = "CRAFT", TextSize = 17, TextColor3 = C.salt, Size = UDim2.new(1, 0, 0, 22), Parent = scroller })
	for i, recipeId in Items.RecipeOrder do
		local r = Theme.make("Frame", { LayoutOrder = 7 + i, Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1, Parent = scroller })
		recipeLabels[recipeId] = Theme.label({ Size = UDim2.new(1, -130, 1, 0), TextYAlignment = Enum.TextYAlignment.Center, TextSize = 13, Parent = r })
		local b = Theme.button({ Text = "CRAFT", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 120, 1, 0), Parent = r })
		b.Activated:Connect(function()
			sendAction("Craft", recipeId)
		end)
	end

	Theme.heading({ LayoutOrder = 20, Text = "RUN AIDS", TextSize = 17, TextColor3 = C.salt, Size = UDim2.new(1, 0, 0, 22), Parent = scroller })
	tokenText = Theme.label({ LayoutOrder = 21, TextSize = 12, Size = UDim2.new(1, 0, 0, 48), Parent = scroller })
	local resupply = Theme.button({ LayoutOrder = 22, Text = "USE RESUPPLY  [B]", Size = UDim2.new(0, 220, 0, 36), Parent = scroller })
	resupply.Activated:Connect(function()
		sendAction("Resupply")
	end)
	local close = Theme.button({ LayoutOrder = 23, Text = "CLOSE  [Tab]", Size = UDim2.new(0, 160, 0, 36), Parent = scroller })
	close.Activated:Connect(Satchel.close)
end

function Satchel.refresh()
	if not backdrop or not backdrop.Visible then
		return
	end
	partsText.Text = line({ "cloth", "alcohol", "powder" }) .. "\n" .. line({ "scrap", "tape", "canister" })
	ammoText.Text = line({ "pistolAmmo", "rifleAmmo", "shells", "arrows" })
	kitText.Text = line({ "dressing", "spike" })
	for id, b in throwButtons do
		local on = State.throwable == id
		b.Text = ("%s %d"):format(Items.Items[id].name, inv(id))
		b.BackgroundColor3 = on and C.lantern or C.panelHi
		b.TextColor3 = on and C.backdrop or C.text
	end
	for recipeId, label in recipeLabels do
		local recipe = Items.Recipes[recipeId]
		label.Text = recipe.name .. "  ·  " .. costText(recipe)
	end
	tokenText.Text = ("Second Wind: %d (when downed, once per crossing) · Resupply: %d (once per crossing)\nEarn more free by finishing crossings, or at the Purser's Office."):format(
		player:GetAttribute("Tokens_secondWind") or 0, player:GetAttribute("Tokens_resupply") or 0)
end

function Satchel.toggle()
	if not backdrop then
		return
	end
	if backdrop.Visible then
		Satchel.close()
	else
		backdrop.Visible = true
		State.setModal("satchel", true)
		Satchel.refresh()
		Theme.focus(firstButton)
	end
end

function Satchel.close()
	if backdrop then
		backdrop.Visible = false
		State.setModal("satchel", false)
	end
end

return Satchel
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000004B"><Properties><string name="Name">Settings</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Settings: graphics preset (Auto / Performance / Balanced / Cinematic), look sensitivity,
-- reduce camera motion. Saved to your profile.
local Players = game:GetService("Players")

local Theme = require(script.Parent.Theme)
local State = require(script.Parent.Parent.State)

local Settings = {}
local C = Theme.Colors
local player = Players.LocalPlayer
local backdrop, modeButtons, activeLabel, sensLabel, motionButton
local request
local pending = { graphics = "Auto", sensitivity = 1, reduceMotion = false }

local MODES = { "Auto", "Performance", "Balanced", "Cinematic" }

local function refresh()
	for mode, b in modeButtons do
		local on = pending.graphics == mode
		b.BackgroundColor3 = on and C.lantern or C.panelHi
		b.TextColor3 = on and C.backdrop or C.text
	end
	activeLabel.Text = ("Running: %s. Cinematic adds depth of field with aim focus, sun rays, a filmic grade, denser fog and rain, and shadows on every light. Best on PC and PlayStation."):format(player:GetAttribute("GraphicsMode") or "?")
	sensLabel.Text = ("Look sensitivity  %.1f"):format(pending.sensitivity)
	motionButton.Text = pending.reduceMotion and "REDUCE CAMERA MOTION: ON" or "REDUCE CAMERA MOTION: OFF"
end

local function save()
	request("SaveSettings", pending)
end

function Settings.build(gui, requestFn)
	request = requestFn
	modeButtons = {}
	local panel
	backdrop, panel = Theme.modal(gui, "Settings", UDim2.new(0.92, 0, 0.8, 0), Vector2.new(620, 440))
	Theme.list(Enum.FillDirection.Vertical, 10).Parent = panel
	Theme.heading({ LayoutOrder = 1, Text = "SETTINGS", TextSize = 28, Size = UDim2.new(1, 0, 0, 32), Parent = panel })
	Theme.heading({ LayoutOrder = 2, Text = "GRAPHICS", TextSize = 16, TextColor3 = C.salt, Size = UDim2.new(1, 0, 0, 20), Parent = panel })
	local row = Theme.make("Frame", { LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 1, Parent = panel })
	Theme.list(Enum.FillDirection.Horizontal, 6).Parent = row
	for i, mode in MODES do
		local b = Theme.button({ LayoutOrder = i, Text = string.upper(mode), TextSize = 13, Size = UDim2.new(0.25, -5, 1, 0), Parent = row })
		modeButtons[mode] = b
		b.Activated:Connect(function()
			pending.graphics = mode
			save()
			task.delay(0.3, refresh)
		end)
	end
	activeLabel = Theme.label({ LayoutOrder = 4, TextSize = 12, TextColor3 = C.dim, Size = UDim2.new(1, 0, 0, 48), Parent = panel })
	sensLabel = Theme.heading({ LayoutOrder = 5, TextSize = 16, Size = UDim2.new(1, 0, 0, 20), Parent = panel })
	local sensRow = Theme.make("Frame", { LayoutOrder = 6, Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1, Parent = panel })
	Theme.list(Enum.FillDirection.Horizontal, 6).Parent = sensRow
	for i, delta in { -0.1, 0.1 } do
		local b = Theme.button({ LayoutOrder = i, Text = delta < 0 and "–" or "+", Size = UDim2.new(0, 60, 1, 0), Parent = sensRow })
		b.Activated:Connect(function()
			pending.sensitivity = math.clamp(math.floor((pending.sensitivity + delta) * 10 + 0.5) / 10, 0.2, 3)
			save()
			refresh()
		end)
	end
	motionButton = Theme.button({ LayoutOrder = 7, Size = UDim2.new(0, 320, 0, 36), Parent = panel })
	motionButton.Activated:Connect(function()
		pending.reduceMotion = not pending.reduceMotion
		save()
		refresh()
	end)
	local close = Theme.button({ LayoutOrder = 8, Text = "CLOSE  [P]", Size = UDim2.new(0, 160, 0, 36), Parent = panel })
	close.Activated:Connect(Settings.close)
end

function Settings.toggle()
	if not backdrop then
		return
	end
	if backdrop.Visible then
		Settings.close()
		return
	end
	pending = {
		graphics = player:GetAttribute("Set_graphics") or "Auto",
		sensitivity = player:GetAttribute("Set_sensitivity") or 1,
		reduceMotion = player:GetAttribute("Set_reduceMotion") == true,
	}
	backdrop.Visible = true
	State.setModal("settings", true)
	refresh()
	Theme.focus(modeButtons.Auto)
end

function Settings.close()
	if backdrop then
		backdrop.Visible = false
		State.setModal("settings", false)
	end
end

return Settings
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000004C"><Properties><string name="Name">Shop</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The Purser's Office ledger: the in-world shop. Prices come live from Roblox, contents are
-- fixed and shown in full, and every item says how to earn it for free.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Commerce = require(Shared.Config.Commerce)
local Game = require(Shared.Config.Game)
local Theme = require(script.Parent.Theme)
local State = require(script.Parent.Parent.State)

local Shop = {}
local C = Theme.Colors
local player = Players.LocalPlayer
local backdrop, tokenText

function Shop.prompt(productKey)
	local product = Commerce.Products[productKey]
	if not product or product.productId == 0 then
		return false
	end
	MarketplaceService:PromptProductPurchase(player, product.productId)
	return true
end

function Shop.build(gui)
	local panel
	backdrop, panel = Theme.modal(gui, "Shop", UDim2.new(0.92, 0, 0.86, 0), Vector2.new(640, 600))
	Theme.list(Enum.FillDirection.Vertical, 8).Parent = panel
	Theme.heading({ LayoutOrder = 1, Text = "THE PURSER'S LEDGER", TextSize = 28, Size = UDim2.new(1, 0, 0, 32), Parent = panel })
	Theme.label({ LayoutOrder = 2, Text = "\"Fair trade only. Nothing comes in a sealed box.\"  (Agnes Pell, Purser of the Meridian)", TextColor3 = C.dim, TextSize = 13, Size = UDim2.new(1, 0, 0, 34), Parent = panel })

	for i, key in Commerce.Order do
		local product = Commerce.Products[key]
		local row = Theme.panel({ LayoutOrder = 2 + i, Size = UDim2.new(1, 0, 0, 74), BackgroundColor3 = C.panelHi, Parent = panel })
		Theme.padding(10).Parent = row
		Theme.heading({ Text = string.upper(product.name), TextSize = 17, Size = UDim2.new(1, -150, 0, 20), Parent = row })
		Theme.label({ Text = product.desc, Position = UDim2.new(0, 0, 0, 22), Size = UDim2.new(1, -150, 0, 32), TextSize = 12, Parent = row })
		local configured = product.productId ~= 0
		local buy = Theme.button({
			Text = configured and ("R$ " .. product.price) or "NOT SET UP",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0),
			Size = UDim2.new(0, 136, 0, 38),
			AutoButtonColor = configured,
			Parent = row,
		})
		if configured then
			task.spawn(function()
				local ok, info = pcall(function()
					return MarketplaceService:GetProductInfo(product.productId, Enum.InfoType.Product)
				end)
				if ok and info and info.PriceInRobux then
					buy.Text = "R$ " .. info.PriceInRobux
				end
			end)
			buy.Activated:Connect(function()
				Shop.prompt(key)
			end)
		end
	end

	tokenText = Theme.label({ LayoutOrder = 10, Text = "", TextSize = 13, Size = UDim2.new(1, 0, 0, 70), Parent = panel })
	Theme.label({
		LayoutOrder = 11,
		Text = "Coming soon in this office: crew outfits, lantern skins and cabin décor. Cosmetic only, never random.",
		TextColor3 = C.dim,
		TextSize = 12,
		Size = UDim2.new(1, 0, 0, 32),
		Parent = panel,
	})
	local close = Theme.button({ LayoutOrder = 12, Text = "CLOSE", Size = UDim2.new(0, 140, 0, 36), Parent = panel })
	close.Activated:Connect(Shop.close)
end

function Shop.refresh()
	if not backdrop or not backdrop.Visible then
		return
	end
	local winR = Game.WinReward.resupply or 0
	local dailySW = Game.DailyWinReward.secondWind or 0
	tokenText.Text = ("You hold: %d Second Wind · %d Resupply\nFree: +%d Resupply for every successful crossing, +%d Second Wind for your first successful crossing each day.%s"):format(
		player:GetAttribute("Tokens_secondWind") or 0,
		player:GetAttribute("Tokens_resupply") or 0,
		winR,
		dailySW,
		Game.RunAidsEnabled and "" or "\n(Run aids are switched off on this server.)"
	)
end

function Shop.open()
	if backdrop then
		backdrop.Visible = true
		State.setModal("shop", true)
		Shop.refresh()
	end
end

function Shop.close()
	if backdrop then
		backdrop.Visible = false
		State.setModal("shop", false)
	end
end

return Shop
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000004D"><Properties><string name="Name">Theme</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Visual language for all UI: slate panels, bone text, lantern-warm accents. No default
-- Roblox look: custom panels, Oswald (stencil-like headings) + Merriweather (logbook body).
local Theme = {}

Theme.Colors = {
	backdrop = Color3.fromRGB(6, 8, 10),
	panel = Color3.fromRGB(18, 22, 25),
	panelHi = Color3.fromRGB(30, 35, 38),
	line = Color3.fromRGB(70, 76, 78),
	text = Color3.fromRGB(226, 220, 206),
	dim = Color3.fromRGB(150, 148, 138),
	lantern = Color3.fromRGB(232, 168, 92),
	danger = Color3.fromRGB(200, 74, 60),
	salt = Color3.fromRGB(170, 205, 205),
	ok = Color3.fromRGB(140, 180, 130),
}

Theme.Head = Enum.Font.Oswald
Theme.Body = Enum.Font.Merriweather

local function apply(inst, defaults, props)
	for key, value in defaults do
		if props == nil or props[key] == nil then
			inst[key] = value
		end
	end
	local parent
	for key, value in props or {} do
		if key == "Parent" then
			parent = value
		elseif key ~= "Children" then
			inst[key] = value
		end
	end
	for _, child in (props and props.Children) or {} do
		child.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Theme.make(className, props)
	return apply(Instance.new(className), {}, props)
end

function Theme.corner(radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 4)
	return c
end

function Theme.stroke(color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color or Theme.Colors.line
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0.2
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	return s
end

function Theme.padding(px)
	local p = Instance.new("UIPadding")
	p.PaddingLeft = UDim.new(0, px)
	p.PaddingRight = UDim.new(0, px)
	p.PaddingTop = UDim.new(0, px)
	p.PaddingBottom = UDim.new(0, px)
	return p
end

function Theme.list(direction, gap, align)
	local l = Instance.new("UIListLayout")
	l.FillDirection = direction or Enum.FillDirection.Vertical
	l.Padding = UDim.new(0, gap or 6)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	if align then
		l.HorizontalAlignment = align
	end
	return l
end

function Theme.label(props)
	return apply(Instance.new("TextLabel"), {
		BackgroundTransparency = 1,
		TextColor3 = Theme.Colors.text,
		Font = Theme.Body,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		Size = UDim2.new(1, 0, 0, 20),
	}, props)
end

function Theme.heading(props)
	return apply(Instance.new("TextLabel"), {
		BackgroundTransparency = 1,
		TextColor3 = Theme.Colors.text,
		Font = Theme.Head,
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, 28),
	}, props)
end

function Theme.panel(props)
	local frame = apply(Instance.new("Frame"), {
		BackgroundColor3 = Theme.Colors.panel,
		BackgroundTransparency = 0.08,
		BorderSizePixel = 0,
	}, props)
	Theme.corner(6).Parent = frame
	Theme.stroke().Parent = frame
	return frame
end

function Theme.button(props)
	local button = apply(Instance.new("TextButton"), {
		BackgroundColor3 = Theme.Colors.panelHi,
		BorderSizePixel = 0,
		AutoButtonColor = true,
		TextColor3 = Theme.Colors.text,
		Font = Theme.Head,
		TextSize = 17,
		Size = UDim2.new(0, 160, 0, 36),
	}, props)
	Theme.corner(4).Parent = button
	Theme.stroke(Theme.Colors.lantern, 1, 0.5).Parent = button
	return button
end

-- Gamepad/console: put the selection cursor on a button when a menu opens.
function Theme.focus(button)
	local UserInputService = game:GetService("UserInputService")
	if button and UserInputService.GamepadEnabled then
		game:GetService("GuiService").SelectedObject = button
	end
end

function Theme.clear(frame)
	for _, child in frame:GetChildren() do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") and not child:IsA("UIGridLayout") then
			child:Destroy()
		end
	end
end

-- A full-screen dark backdrop + centred panel for modal screens.
function Theme.modal(parent, name, size, maxSize)
	local backdrop = Theme.make("Frame", {
		Name = name,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Colors.backdrop,
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 20,
		Parent = parent,
	})
	local panel = Theme.panel({
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = size,
		ZIndex = 21,
		Parent = backdrop,
	})
	local constraint = Instance.new("UISizeConstraint")
	constraint.MaxSize = maxSize or Vector2.new(1100, 680)
	constraint.Parent = panel
	Theme.padding(18).Parent = panel
	return backdrop, panel
end

return Theme
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000004E"><Properties><string name="Name">Workbench</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The workbench: spend Salvage (found during the crossing) on weapon parts, satchel upgrades
-- and your character's other perks. Upgrades last for this crossing.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Characters = require(Shared.Config.Characters)
local Upgrades = require(Shared.Config.Upgrades)
local Weapons = require(Shared.Config.Weapons)
local Theme = require(script.Parent.Theme)
local State = require(script.Parent.Parent.State)

local Workbench = {}
local C = Theme.Colors
local player = Players.LocalPlayer
local backdrop, list, salvageLabel
local request

local function decode(attr)
	local ok, value = pcall(function()
		return HttpService:JSONDecode(player:GetAttribute(attr) or "{}")
	end)
	return ok and value or {}
end

local function price(base)
	local repairs = decode("Repairs")
	return math.ceil(base * (repairs.workshop and 0.85 or 1))
end

local function section(order, text)
	Theme.heading({ LayoutOrder = order, Text = text, TextSize = 17, TextColor3 = C.salt, Size = UDim2.new(1, 0, 0, 24), Parent = list })
end

local function row(order, title, desc, owned, cost, onBuy)
	local r = Theme.panel({ LayoutOrder = order, Size = UDim2.new(1, 0, 0, 54), BackgroundColor3 = C.panelHi, Parent = list })
	Theme.padding(8).Parent = r
	Theme.heading({ Text = title, TextSize = 15, Size = UDim2.new(1, -130, 0, 18), Parent = r })
	Theme.label({ Text = desc, Position = UDim2.new(0, 0, 0, 20), Size = UDim2.new(1, -130, 0, 18), TextSize = 12, TextColor3 = C.dim, Parent = r })
	local b = Theme.button({
		Text = owned and "FITTED" or ("%d SALVAGE"):format(cost),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.new(0, 120, 0, 34),
		TextSize = 14,
		AutoButtonColor = not owned,
		Parent = r,
	})
	if owned then
		b.TextColor3 = C.ok
	else
		b.Activated:Connect(onBuy)
	end
	return b
end

local function rebuild()
	Theme.clear(list)
	salvageLabel.Text = ("SALVAGE %d"):format(player:GetAttribute("Salvage") or 0)
	local run = decode("RunUpgrades")
	local owned = run.weapons or {}
	local order, first = 0, nil
	local function nextOrder()
		order += 1
		return order
	end
	if not player:GetAttribute("InCrossing") then
		Theme.label({ LayoutOrder = 1, Text = "The workbench is used between encounters during a crossing. Start one at the tide chart.", TextSize = 14, Size = UDim2.new(1, 0, 0, 40), Parent = list })
		return
	end
	for _, slot in { "long", "sidearm" } do
		local id = player:GetAttribute("W_" .. slot)
		if id and id ~= "" and Upgrades.Weapon[id] then
			section(nextOrder(), string.upper(Weapons.List[id].name))
			for _, upg in Upgrades.Weapon[id] do
				local has = owned[id] and owned[id][upg.id]
				local b = row(nextOrder(), upg.name, upg.desc, has, price(upg.cost), function()
					request("BuyWeaponUpgrade", id, upg.id)
				end)
				first = first or b
			end
		end
	end
	section(nextOrder(), "SATCHEL & GEAR")
	for _, upg in Upgrades.General do
		row(nextOrder(), upg.name, upg.desc, run.general and run.general[upg.id], price(upg.cost), function()
			request("BuyGeneral", upg.id)
		end)
	end
	local charId = player:GetAttribute("CharId")
	local def = charId and Characters.List[charId]
	if def then
		section(nextOrder(), "TRAINING: " .. string.upper(def.name))
		for _, perk in def.perks do
			local has = perk.id == player:GetAttribute("PerkId") or (run.perks and run.perks[perk.id])
			row(nextOrder(), perk.name, perk.desc, has, price(Upgrades.PerkCost), function()
				request("BuyPerk", perk.id)
			end)
		end
	end
	Theme.focus(first)
end

function Workbench.build(gui, requestFn)
	request = requestFn
	local panel
	backdrop, panel = Theme.modal(gui, "Workbench", UDim2.new(0.94, 0, 0.9, 0), Vector2.new(680, 640))
	Theme.heading({ Text = "WORKBENCH", TextSize = 28, Size = UDim2.new(1, -120, 0, 32), Parent = panel })
	salvageLabel = Theme.heading({ Position = UDim2.new(0, 0, 0, 34), Size = UDim2.new(1, 0, 0, 22), TextSize = 17, TextColor3 = C.lantern, Parent = panel })
	local close = Theme.button({ Text = "CLOSE", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 100, 0, 32), Parent = panel })
	close.Activated:Connect(Workbench.close)
	list = Theme.make("ScrollingFrame", {
		Position = UDim2.new(0, 0, 0, 64),
		Size = UDim2.new(1, 0, 1, -64),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		Parent = panel,
	})
	Theme.list(Enum.FillDirection.Vertical, 6).Parent = list
	for _, attr in { "Salvage", "RunUpgrades", "W_long", "W_sidearm" } do
		player:GetAttributeChangedSignal(attr):Connect(function()
			if backdrop.Visible then
				rebuild()
			end
		end)
	end
end

function Workbench.open()
	if backdrop then
		backdrop.Visible = true
		State.setModal("workbench", true)
		rebuild()
	end
end

function Workbench.close()
	if backdrop then
		backdrop.Visible = false
		State.setModal("workbench", false)
	end
end

return Workbench
]]></ProtectedString></Properties></Item>
</Item>
</Item>
</Item>
</Item>
</roblox>
