<Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">Modifiers</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Environmental modifiers. One is rolled per encounter (or none) for replayability.
-- Fields: sightMult, noiseMult (all noise), footstepMult, partsMult, fogDensity, ambientBoost, lightning, night
return {
	None = { id = "None", name = "Still Water", desc = "An ordinary grey evening on the Marrow Coast.", fogDensity = 0.34 },
	List = {
		{ id = "HeavyPall", name = "Heavy Pall", desc = "Thick fog. Everyone sees less.", sightMult = 0.65, fogDensity = 0.55 },
		{ id = "Squall", name = "Squall", desc = "Wind masks your footsteps.", footstepMult = 0.6, sightMult = 0.9, fogDensity = 0.42, lightning = true },
		{ id = "Nightfall", name = "Nightfall", desc = "Full dark. Your torch is the only light, and they see it.", sightMult = 0.8, fogDensity = 0.36, night = true },
		{ id = "Echoing", name = "Echoing", desc = "Every sound carries further.", noiseMult = 1.5, fogDensity = 0.34 },
		{ id = "Moonbreak", name = "Moonbreak", desc = "The fog thins. You see them. They see you.", sightMult = 1.3, fogDensity = 0.18, ambientBoost = 0.35 },
		{ id = "ScavengedOut", name = "Scavenged Out", desc = "Someone got here first. Half the parts.", partsMult = 0.5, fogDensity = 0.34 },
	},
	NoneChance = 0.2,
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">Movement</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Speeds are studs/second. Noise values are the radius (studs) in which Hushed can hear you.
return {
	Speeds = {
		Crouch = 6.5,
		Walk = 9,
		Jog = 14,
		Sprint = 20,
		Aim = 7,
		Downed = 2.5,
	},
	Noise = {
		Crouch = 3,
		Walk = 9,
		Jog = 16,
		Sprint = 30,
	},
	Accel = 38, -- how fast WalkSpeed ramps up (studs/s^2): gives weight to starts
	Decel = 70,
	WaterNoiseMult = 1.6, -- wading is louder...
	WaterSpeedMult = 0.75, -- ...and slower
	CrouchHipMult = 0.66, -- procedural crouch pose lowers hips to this fraction
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">Rigs</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Realistic characters. Three ways to give a crew member a realistic body, best first:
--   1. Custom rig: put an R15-compatible Model named e.g. "Mara" in ServerStorage > Rigs
--      (made in Blender from a MakeHuman/your own mesh, then Studio's Avatar Setup tool).
--      It must contain a Humanoid + HumanoidRootPart. Put a copy of the default "Animate"
--      LocalScript inside it, or set the animation IDs below.
--   2. Body parts: Marketplace body-part asset IDs for a HumanoidDescription (Rthro-style
--      realistic bodies, FACS heads). Set them under BodyParts.
--   3. Neither: the faceless placeholder mannequin (Slice 0 default).
-- See docs/07-characters-and-graphics.md for the free pipeline. Never import models of
-- characters from other games (copyright).
return {
	Custom = {
		mara = "Mara",
		tobias = "Tobias",
		ines = "Ines",
		sefa = "Sefa",
	},
	BodyParts = {
		-- example: mara = { Head = 0, Torso = 0, LeftArm = 0, RightArm = 0, LeftLeg = 0, RightLeg = 0 },
	},
	-- Uploaded animation IDs ("rbxassetid://123"). Used for custom rigs without an Animate script.
	Animations = {
		idle = "",
		walk = "",
		run = "",
		crouchIdle = "",
		crouchWalk = "",
	},
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">Sounds</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Every sound in the game. The audio itself is our own (generated by tools/make_sounds.py
-- into aftertide/audio/*.ogg). Upload those files to Roblox (docs/08-audio.md) and paste
-- each ID here as "rbxassetid://123456". An empty ID is silent; the noise the Hushed hear
-- still happens, because that's gameplay, not audio.
--
-- Shortcut: run tools/fill_sound_ids.py with the IDs Roblox gives you to fill this in.
local IDS = {
	-- weapons
	Gun_revolver = "",
	Gun_carbine = "",
	Gun_rifle = "",
	Gun_shotgun = "",
	Gun_bow = "",
	Reload = "",
	DryFire = "",
	Equip = "",
	-- impacts & world
	ImpactWorld = "",
	ImpactSalt = "",
	BottleBreak = "",
	Explosion = "",
	FireLoop = "",
	FogHiss = "",
	Door = "",
	Search = "",
	Pickup = "",
	-- body
	Step = "",
	StepWater = "",
	Dodge = "",
	Swing = "",
	MeleeHit = "",
	Heartbeat = "",
	Hurt = "",
	Bandage = "",
	Throw = "",
	-- the Hushed
	Hushed_Breath = "",
	Hushed_Growl = "",
	Hushed_Attack = "",
	Rusher_Shriek = "",
	Seeker_Grind = "",
	Tidewalker_Groan = "",
	Hum = "",
	Disperse = "",
	-- factions
	Radio_Callout = "",
	Bell_Strike = "",
	-- ambience & music
	Amb_Wind = "",
	Amb_Sea = "",
	Amb_Drone = "",
	Music_Tension = "",
	Stinger_Spotted = "",
	Stinger_Clear = "",
	-- interface
	Ui_Tick = "",
	Ui_Confirm = "",
}

-- Placeholders that ship inside the Roblox client, used until you upload the pack.
local FALLBACK = {
	Swing = "rbxasset://sounds/swordlunge.wav",
	MeleeHit = "rbxasset://sounds/swordslash.wav",
	Dodge = "rbxasset://sounds/swordlunge.wav",
	BottleBreak = "rbxasset://sounds/impact_water.mp3",
	StepWater = "rbxasset://sounds/impact_water.mp3",
}

-- Older keys used around the code, mapped onto the pack.
local ALIASES = {
	Quieting = "Disperse",
	Shove = "MeleeHit",
	Spotted = "Hushed_Growl",
	Rattle = "Ui_Tick",
	Splash = "StepWater",
}

local VOLUME = {
	Amb_Wind = 0.35, Amb_Sea = 0.3, Amb_Drone = 0.25, Music_Tension = 0.4,
	Step = 0.35, StepWater = 0.45, Hushed_Breath = 0.6, Heartbeat = 0.6,
	Ui_Tick = 0.3, Ui_Confirm = 0.4,
}

local Sounds = {}
for key, id in IDS do
	Sounds[key] = id ~= "" and id or (FALLBACK[key] or "")
end
for alias, target in ALIASES do
	Sounds[alias] = Sounds[target]
end
Sounds.Volume = VOLUME

return Sounds
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">Upgrades</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Two kinds of upgrade:
--   * Workbench (per run, paid with Salvage found in the run): weapon parts, satchel, perks.
--   * Meridian repairs (permanent, paid with Scrip earned by playing): the homebase.
-- Neither can be bought with Robux.
local Upgrades = {}

-- mods: damageMult, reloadMult, noiseMult, recoilMult, spreadMult, aimSpreadMult,
--       fireDelayMult, magBonus (+n), aimFovMult
Upgrades.Weapon = {
	revolver = {
		{ id = "loads", name = "Hand-loaded rounds", desc = "+25% damage", cost = 25, mods = { damageMult = 1.25 } },
		{ id = "loader", name = "Speed loader", desc = "Reload 40% faster", cost = 20, mods = { reloadMult = 0.6 } },
		{ id = "baffle", name = "Baffle", desc = "Shots are 60% quieter", cost = 40, mods = { noiseMult = 0.4 } },
		{ id = "grip", name = "Weighted grip", desc = "-40% recoil, tighter spread", cost = 20, mods = { recoilMult = 0.6, spreadMult = 0.75 } },
	},
	carbine = {
		{ id = "tube", name = "Long tube", desc = "+3 rounds per load", cost = 30, mods = { magBonus = 3 } },
		{ id = "lever", name = "Smoothed lever", desc = "Fires 30% faster", cost = 30, mods = { fireDelayMult = 0.7 } },
		{ id = "sights", name = "Peep sights", desc = "Much tighter aim", cost = 20, mods = { aimSpreadMult = 0.4 } },
		{ id = "pad", name = "Recoil pad", desc = "-45% recoil", cost = 15, mods = { recoilMult = 0.55 } },
	},
	rifle = {
		{ id = "scope", name = "Salvaged scope", desc = "Zoomed, pinpoint aim", cost = 35, mods = { aimSpreadMult = 0.1, aimFovMult = 0.6 } },
		{ id = "bolt", name = "Polished bolt", desc = "Cycles 35% faster", cost = 30, mods = { fireDelayMult = 0.65 } },
		{ id = "mag", name = "Extended magazine", desc = "+2 rounds", cost = 25, mods = { magBonus = 2 } },
		{ id = "pad", name = "Stock pad", desc = "-45% recoil", cost = 15, mods = { recoilMult = 0.55 } },
	},
	shotgun = {
		{ id = "choke", name = "Choke", desc = "30% tighter spread", cost = 25, mods = { spreadMult = 0.7, aimSpreadMult = 0.7 } },
		{ id = "tube", name = "Tube extension", desc = "+2 shells", cost = 30, mods = { magBonus = 2 } },
		{ id = "pump", name = "Quick pump", desc = "Fires 25% faster", cost = 25, mods = { fireDelayMult = 0.75 } },
		{ id = "loads", name = "Heavy shot", desc = "+25% damage", cost = 30, mods = { damageMult = 1.25 } },
	},
	bow = {
		{ id = "draw", name = "Heavier draw", desc = "+30% damage", cost = 30, mods = { damageMult = 1.3 } },
		{ id = "nock", name = "Quick nock", desc = "Fires 35% faster", cost = 20, mods = { fireDelayMult = 0.65, reloadMult = 0.65 } },
		{ id = "stab", name = "Stabiliser", desc = "Much tighter aim", cost = 20, mods = { aimSpreadMult = 0.4, spreadMult = 0.7 } },
	},
}

Upgrades.General = {
	{ id = "satchel", name = "Bigger satchel", desc = "+1 capacity for every part, throwable and consumable", cost = 30 },
	{ id = "ammoPouch", name = "Ammo pouch", desc = "+50% ammo capacity", cost = 30 },
	{ id = "holster", name = "Holster rig", desc = "Swap weapons twice as fast", cost = 15 },
}

Upgrades.PerkCost = 30 -- buy each of your character's other perks during a run

Upgrades.Repairs = {
	{ id = "lights", name = "Deck lights", desc = "String the Meridian with lights again. (Cosmetic)", cost = 40 },
	{ id = "generator", name = "Generator", desc = "Start every crossing with +15 Salvage.", cost = 60 },
	{ id = "sickbay", name = "Sick bay", desc = "Start every crossing with an extra Field Dressing.", cost = 80 },
	{ id = "workshop", name = "Workshop tools", desc = "Workbench upgrades cost 15% less.", cost = 100 },
	{ id = "radio", name = "Radio mast", desc = "The tide chart offers 3 routes instead of 2.", cost = 120 },
	{ id = "armory", name = "Armory rack", desc = "Choose any long gun before a crossing.", cost = 150 },
}

return Upgrades
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">Weapons</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Fictional, stylised weapons (no real brands or real-world specs). Damage is against the
-- Hushed (Drifter = 100 HP). Gunshots are LOUD: every shot is a noise event, so going loud
-- is a choice with consequences. The bow is the quiet option.
-- spread values are degrees; noise is the radius (studs) Hushed hear the shot.
return {
	List = {
		revolver = {
			name = "Service Revolver", slot = "sidearm", ammo = "pistolAmmo",
			mag = 6, damage = 38, headMult = 2.5, pellets = 1,
			fireDelay = 0.42, reload = 2.2, range = 180,
			spreadHip = 4, spreadAim = 0.7, moveSpread = 2.5, recoil = 3.2,
			noise = 75, aimFov = 52,
		},
