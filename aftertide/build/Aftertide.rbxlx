-- Shows which projects are built (any player in the server owns them): rooms or scaffolding.
function MapService.setFerryRepairs(owned)
	local ferry = Workspace:FindFirstChild("World") and Workspace.World:FindFirstChild("Meridian")
	if not ferry then
		return
	end
	for _, d in ferry:GetDescendants() do
		if d:IsA("BasePart") and d.Name == "DeckBulb" then
			-- always lit; the Deck Lights project turns them into coloured festival lights
			local festive = { Color3.fromRGB(255, 120, 110), Color3.fromRGB(255, 210, 90), Color3.fromRGB(120, 220, 160), Color3.fromRGB(120, 180, 255), Color3.fromRGB(230, 140, 255) }
			local i = math.floor((d.Position.X + 100) / 6) % #festive + 1
			d.Color = owned.lights and festive[i] or C.warm
			local light = d:FindFirstChildOfClass("PointLight")
			if light then
				light.Color = d.Color
				light.Brightness = owned.lights and 1.3 or 0.9
			end
		end
	end
	local rooms = ferry:FindFirstChild("Rooms")
	if not rooms then
		return
	end
	rooms:ClearAllChildren()
	local o = Game.FerryOrigin
	-- re-register the static fixtures' boxes, then add rooms and check them all
	local static = {}
	for _, b in layoutBoxes do
		if not b.room then
			table.insert(static, b)
		end
	end
	table.clear(layoutBoxes)
	for _, b in static do
		table.insert(layoutBoxes, b)
	end
	for id, r in ROOMS do
		if r.lo then
			local folder = Instance.new("Folder")
			folder.Name = id
			folder.Parent = rooms
			local before = #layoutBoxes
			if owned[id] then
				r.build(folder, r)
			else
				-- scaffolding where the room will go, with a sign
				local M = Enum.Material
				local h = r.hi.Y - r.lo.Y
				for _, x in { r.lo.X + 0.3, r.hi.X - 0.3 } do
					for _, z in { r.lo.Z + 0.3, r.hi.Z - 0.3 } do
						block(folder, Vector3.new(0.3, h, 0.3), o + Vector3.new(x, r.lo.Y + h / 2, z), Color3.fromRGB(150, 110, 60), M.Metal, { CanCollide = false })
					end
				end
				block(folder, Vector3.new(r.hi.X - r.lo.X, 0.25, r.hi.Z - r.lo.Z), o + Vector3.new((r.lo.X + r.hi.X) / 2, r.hi.Y, (r.lo.Z + r.hi.Z) / 2), Color3.fromRGB(120, 140, 150), M.Fabric, { Transparency = 0.35, CanCollide = false })
				local sign = block(folder, Vector3.new(3, 1.4, 0.2), o + Vector3.new((r.lo.X + r.hi.X) / 2, r.lo.Y + 3, (r.lo.Z + r.hi.Z) / 2), Color3.fromRGB(230, 220, 190), M.SmoothPlastic, { CanCollide = false })
				local gui = Instance.new("SurfaceGui")
				gui.Face = Enum.NormalId.Front
				gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
				gui.PixelsPerStud = 40
				gui.Parent = sign
				local label = Instance.new("TextLabel")
				label.Size = UDim2.fromScale(1, 1)
				label.BackgroundTransparency = 1
				label.Font = Enum.Font.Oswald
				label.TextScaled = true
				label.TextColor3 = Color3.fromRGB(40, 36, 30)
				local p = require(Shared.Config.Projects).get(id)
				label.Text = "PROJECT: " .. (p and string.upper(p.name) or id)
				label.Parent = gui
			end
			if not r.noRegister and #layoutBoxes == before then
				register("Room_" .. id, CFrame.new(o + (r.lo + r.hi) / 2), r.hi - r.lo)
			end
			for i = before + 1, #layoutBoxes do
				layoutBoxes[i].room = true
			end
		end
	end
	MapService.checkLayout("Meridian + rooms")
end

-- Lighting --------------------------------------------------------------------------------

local atmosphere, colorCorrection

local function setupLighting()
	-- Overcast dusk: readable, cold and moody (night is a modifier, not the default)
	Lighting.ClockTime = 17.4
	Lighting.GeographicLatitude = 50
	Lighting.Brightness = 2.2
	Lighting.Ambient = Color3.fromRGB(62, 68, 74)
	Lighting.OutdoorAmbient = Color3.fromRGB(112, 120, 128)
	Lighting.ColorShift_Top = Color3.fromRGB(255, 224, 196)
	-- sky light on every surface: makes normal / roughness maps and wet metal read properly
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.ShadowSoftness = 0.25
	Lighting.GlobalShadows = true
	Lighting.ExposureCompensation = 0.25

	atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Density = 0.34
	atmosphere.Offset = 0.3
	atmosphere.Color = Color3.fromRGB(196, 202, 204)
	atmosphere.Decay = Color3.fromRGB(118, 126, 128)
	atmosphere.Glare = 0
	atmosphere.Haze = 0.3
	atmosphere.Parent = Lighting

	colorCorrection = Instance.new("ColorCorrectionEffect")
	colorCorrection.Name = "AftertideGrade"
	colorCorrection.Saturation = 0.12
	colorCorrection.Contrast = 0.08
	colorCorrection.Brightness = 0.02
	colorCorrection.TintColor = Color3.fromRGB(255, 250, 242)
	colorCorrection.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.5
	bloom.Size = 26
	bloom.Threshold = 1.35
	bloom.Parent = Lighting
end

-- Custom skyboxes (Config/Skies). Each face ID is a Decal upload: the server reads the
-- Decal's underlying image once (InsertService), falling back to the ID itself.
local InsertService = game:GetService("InsertService")
local Skies = require(Shared.Config.Skies)
local skyObject
local textureCache = {}

local function skyTexture(id)
	if textureCache[id] then
		return textureCache[id]
	end
	local texture = "rbxassetid://" .. tostring(id)
	local ok, model = pcall(function()
		return InsertService:LoadAsset(id)
	end)
	if ok and model then
		local decal = model:FindFirstChildWhichIsA("Decal", true)
		if decal and decal.Texture ~= "" then
			texture = decal.Texture
		end
		model:Destroy()
	end
	textureCache[id] = texture
	return texture
end

local currentSky
local function applySky(name)
	local ids = Skies[name or "ferry"] or Skies.ferry
	if not ids or currentSky == name then
		return
	end
	currentSky = name
	if not skyObject then
		skyObject = Lighting:FindFirstChildOfClass("Sky") or Instance.new("Sky")
		skyObject.Name = "AftertideSky"
		skyObject.CelestialBodiesShown = true
		skyObject.SunAngularSize = 14
		skyObject.MoonAngularSize = 9
		skyObject.Parent = Lighting
	end
	task.spawn(function()
		local side = skyTexture(ids.Side)
		local up, dn = skyTexture(ids.Up), skyTexture(ids.Dn)
		if currentSky ~= name then
			return
		end
		skyObject.SkyboxBk, skyObject.SkyboxFt, skyObject.SkyboxLf, skyObject.SkyboxRt = side, side, side, side
		skyObject.SkyboxUp, skyObject.SkyboxDn = up, dn
		skyObject.StarCount = name == "night" and 2500 or 0
	end)
end

-- Test hook: resolve every sky face (used by tests/engine/sky.luau).
function MapService.resolveSkyTextures()
	local out = {}
	for name, ids in Skies do
		out[name] = { Side = skyTexture(ids.Side), Up = skyTexture(ids.Up), Dn = skyTexture(ids.Dn) }
	end
	return out
end

local clouds
local function setupSky()
	clouds = Workspace.Terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
	clouds.Cover = 0.55
	clouds.Density = 0.6
	clouds.Color = Color3.fromRGB(230, 232, 234)
	clouds.Parent = Workspace.Terrain
end

-- sunny harbour afternoon: bright, warm, saturated
local FERRY_LIGHT = { sky = "ferry", clouds = 0.38, cloudDensity = 0.5, cloudColor = { 255, 255, 255 }, wind = { 8, 0, 4 }, clock = 15.2, brightness = 3.1, ambient = { 112, 110, 106 }, outdoor = { 152, 152, 150 }, fog = 0.2, haze = 0.6, fogColor = { 200, 222, 238 }, tint = { 255, 250, 242 }, saturation = 0.14, contrast = 0.08, shift = { 255, 236, 214 } }

local function rgb(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

-- Map lighting preset, adjusted by the route's modifier (Nightfall turns it to night).
local function applyPreset(L, modifier)
	modifier = modifier or {}
	local night = modifier.night == true
	Lighting.ClockTime = night and 0.6 or L.clock
	Lighting.Brightness = night and 1.4 or L.brightness
	Lighting.Ambient = night and Color3.fromRGB(32, 36, 42) or rgb(L.ambient)
	local boost = (modifier.ambientBoost or 0) * 50
	local o = night and { 48, 54, 64 } or L.outdoor
	Lighting.OutdoorAmbient = Color3.fromRGB(math.min(255, o[1] + boost), math.min(255, o[2] + boost), math.min(255, o[3] + boost))
	Lighting.ColorShift_Top = rgb(L.shift)
	if atmosphere then
		-- light haze only: heavy Haze paints over the skybox and gives the stock Roblox look
		local density = L.fog * 0.8 + ((modifier.fogDensity or 0.34) - 0.34)
		TweenService:Create(atmosphere, TweenInfo.new(3), { Density = math.clamp(density, 0.12, 0.6) }):Play()
		atmosphere.Haze = math.min(L.haze, 2) * 0.25
		atmosphere.Glare = 0
		atmosphere.Offset = 0.15
		atmosphere.Color = night and Color3.fromRGB(40, 46, 58) or rgb(L.fogColor)
		atmosphere.Decay = night and Color3.fromRGB(20, 24, 32) or rgb(L.fogColor):Lerp(Color3.new(0.3, 0.32, 0.36), 0.5)
	end
	applySky(night and "night" or (L.sky or "ferry"))
	-- weather: volumetric clouds and wind (moves grass, clouds and particles)
	if clouds then
		local cover = L.clouds or 0.55
		TweenService:Create(clouds, TweenInfo.new(4), {
			Cover = night and math.max(cover, 0.6) or cover,
			Density = L.cloudDensity or 0.6,
			Color = night and Color3.fromRGB(70, 76, 86) or rgb(L.cloudColor or { 232, 234, 236 }),
		}):Play()
	end
	local wind = L.wind or { 6, 0, 3 }
	local gust = modifier.id == "Squall" and 3 or 1
	Workspace.GlobalWind = Vector3.new(wind[1], wind[2], wind[3]) * gust
	if colorCorrection then
		colorCorrection.TintColor = rgb(L.tint)
		colorCorrection.Saturation = L.saturation
		colorCorrection.Contrast = L.contrast
	end
end

function MapService.applyFerryLighting()
	applyPreset(FERRY_LIGHT, nil)
end

function MapService.applyModifier(modifier)
	applyPreset(MapService.currentMap and MapService.currentMap.lighting or FERRY_LIGHT, modifier)
end

-- Builds a map (terrain + geometry) and loads its data. Rebuilt only when it changes.
local mapFolder, currentMapId
function MapService.loadMap(mapId, rng)
	local def = MAP_MODULES[mapId] or MAP_MODULES.CanneryRow
	if currentMapId == def.id and mapFolder and mapFolder.Parent then
		return
	end
	if mapFolder then
		mapFolder:Destroy()
	end
	MapKit.clearTerrain()
	local world = Workspace:FindFirstChild("World")
	mapFolder = Instance.new("Folder")
	mapFolder.Name = "Map_" .. def.id
	mapFolder.Parent = world
	local data = def.build(mapFolder, Random.new(rng:NextInteger(1, 1e6)))
	-- invisible boundary so nobody can walk off the edge of the map
	for _, w in { { Vector3.new(246, 120, 2), Vector3.new(0, 40, -122) }, { Vector3.new(246, 120, 2), Vector3.new(0, 40, 122) }, { Vector3.new(2, 120, 246), Vector3.new(-122, 40, 0) }, { Vector3.new(2, 120, 246), Vector3.new(122, 40, 0) } } do
		block(mapFolder, w[1], w[2], Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, { Name = "Boundary", Transparency = 1, CanQuery = false, CastShadow = false })
	end
	task.wait(0.2) -- terrain writes reach ray casts on the next physics steps (the engine scan showed this)
	local okTidy, removed, lowered, raised = pcall(MapKit.tidy, mapFolder)
	if okTidy then
		print(("[Layout] %s: removed %d lodged props, lowered %d, raised %d"):format(def.id, removed, lowered, raised))
	else
		warn("[Layout] tidy failed: " .. tostring(removed))
	end
	-- snap every gameplay position onto the actual ground (hills, house floors)
	local function snap(v)
		return Vector3.new(v.X, MapKit.ground(v.X, v.Z, { Workspace.Terrain, mapFolder }), v.Z)
	end
	local function snapList(list)
		local out = {}
		for i, v in list do
			out[i] = snap(v)
		end
		return out
	end
	MapService.StartSpawns = snapList(data.StartSpawns)
	MapService.ExtractionPos = snap(data.ExtractionPos)
	MapService.LanternPos = snap(data.LanternPos)
	MapService.SupplyCandidates = snapList(data.SupplyCandidates)
	MapService.LootSpots = snapList(data.LootSpots)
	MapService.EdgeSpawns = snapList(data.EdgeSpawns)
	MapService.PatrolRoutes = {}
	for i, route in data.PatrolRoutes do
		MapService.PatrolRoutes[i] = snapList(route)
	end
	MapService.ContainerSpots = {}
	for i, c in data.ContainerSpots do
		MapService.ContainerSpots[i] = { pos = snap(c.pos), type = c.type, yaw = c.yaw }
	end
	MapService.Doorways = data.Doorways or {}
	MapService.currentMap = def
	currentMapId = def.id
	Workspace:SetAttribute("MapName", def.name)
end

function MapService.mapName(mapId)
	local def = MAP_MODULES[mapId]
	return def and def.name or mapId
end

-- Encounter objects -----------------------------------------------------------------------

local encounterFolder

function MapService.getEncounterFolder()
	return encounterFolder
end
local extraction

local function shuffled(list, rng)
	local copy = table.clone(list)
	for i = #copy, 2, -1 do
		local j = rng:NextInteger(1, i)
		copy[i], copy[j] = copy[j], copy[i]
	end
	return copy
end

local function makePrompt(parent, action, object, hold)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action
	prompt.ObjectText = object
	prompt.HoldDuration = hold or 0
	prompt.MaxActivationDistance = 8
	prompt.RequiresLineOfSight = false
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonA
	prompt.Parent = parent
	return prompt
end

local doors = {}

local function makeDoor(parent, hinge, width, along, closedNow)
	along = Vector3.new(along.X, 0, along.Z).Unit
	local size = Vector3.new(width, 8.6, 0.4)
	local closedCF = CFrame.fromMatrix(hinge + along * (width / 2) + Vector3.new(0, 4.3, 0), along, Vector3.new(0, 1, 0))
	local hingeCF = CFrame.new(hinge + Vector3.new(0, 4.3, 0))
	local openCF = hingeCF * CFrame.Angles(0, math.rad(95), 0) * hingeCF:ToObjectSpace(closedCF)
	local door = block(parent, size, closedNow and closedCF or openCF, Color3.fromRGB(92, 78, 62), Enum.Material.WoodPlanks, { Name = "Door" })
	local modifier = Instance.new("PathfindingModifier")
	modifier.PassThrough = true -- Hushed path through doors; they push them open
	modifier.Parent = door
	local record = { part = door, open = not closedNow, closedCF = closedCF, openCF = openCF }
	local prompt = makePrompt(door, closedNow and "Open" or "Close", "Door", 0)
	prompt.MaxActivationDistance = 7
	record.prompt = prompt
	function record.set(open, byPlayer)
		if record.open == open then
			return
		end
		record.open = open
		prompt.ActionText = open and "Close" or "Open"
		TweenService:Create(door, TweenInfo.new(0.5, Enum.EasingStyle.Quad), { CFrame = open and openCF or closedCF }):Play()
		Sfx.at(door.Position, "Door", 0.6, 60)
		if byPlayer then
			Services.PerceptionService.emitNoise(door.Position, 7, "door", byPlayer)
		end
	end
	prompt.Triggered:Connect(function(player)
		record.set(not record.open, player)
	end)
	table.insert(doors, record)
end

local lantern

function MapService.getLantern()
	return lantern
end

function MapService.resetEncounter(modifier, rng, encounterType, pall, mapId)
	MapService.loadMap(mapId or "CanneryRow", rng)
	encounterFolder:ClearAllChildren()
	table.clear(doors)
	lantern = nil

	-- supply crates (Salvage objective)
	if encounterType == "Salvage" then
		local picks = shuffled(MapService.SupplyCandidates, rng)
		for i = 1, math.min(Encounters.Types.Salvage.crates, #picks) do
			local pos = Services.LootService.settle(picks[i], encounterFolder)
			local crate = block(encounterFolder, Vector3.new(3, 2.4, 2.2), pos + Vector3.new(0, 1.2, 0), C.supply, Enum.Material.WoodPlanks, { Name = "SupplyCrate" })
			block(crate, Vector3.new(3.05, 0.35, 2.25), pos + Vector3.new(0, 1.7, 0), C.bone, Enum.Material.SmoothPlastic, { CanCollide = false, CanQuery = false })
			local glint = Instance.new("PointLight")
			glint.Range = 5
			glint.Brightness = 0.35
			glint.Color = C.warm
			glint.Parent = crate
			local prompt = makePrompt(crate, "Salvage", "Supply crate", 1.2)
			prompt.Triggered:Connect(function(player)
				Services.MatchService.onCrateSalvaged(player, crate)
			end)
		end
	end

	-- Medicine Run: medical caches, mostly indoors
	if encounterType == "Medicine" then
		local picks = shuffled(MapService.LootSpots, rng)
		for i = 1, math.min(Encounters.Types.Medicine.count, #picks) do
			local pos = Services.LootService.settle(picks[i], encounterFolder)
			local case = block(encounterFolder, Vector3.new(2.2, 1.2, 1.5), pos + Vector3.new(0, 0.6, 0), Color3.fromRGB(226, 222, 212), Enum.Material.SmoothPlastic, { Name = "MedCache" })
			block(case, Vector3.new(0.9, 0.25, 0.05), pos + Vector3.new(0, 0.7, -0.78), Color3.fromRGB(180, 30, 30), Enum.Material.SmoothPlastic, { CanCollide = false })
			block(case, Vector3.new(0.25, 0.9, 0.05), pos + Vector3.new(0, 0.7, -0.78), Color3.fromRGB(180, 30, 30), Enum.Material.SmoothPlastic, { CanCollide = false })
			local glint = Instance.new("PointLight")
			glint.Range = 5
			glint.Brightness = 0.4
			glint.Color = Color3.fromRGB(255, 220, 220)
			glint.Parent = case
			makePrompt(case, "Take", "Medical cache", 1).Triggered:Connect(function(player)
				Services.MatchService.onCrateSalvaged(player, case)
			end)
		end
	end

	-- Restore the Signal: radio relays; repairing one is loud
	if encounterType == "Relay" then
		local cfg = Encounters.Types.Relay
		local picks = shuffled(MapService.SupplyCandidates, rng)
		for i = 1, math.min(cfg.count, #picks) do
			local pos = Services.LootService.settle(picks[i], encounterFolder)
			local box = block(encounterFolder, Vector3.new(2, 4, 1.4), pos + Vector3.new(0, 2, 0), Color3.fromRGB(96, 100, 104), Enum.Material.Metal, { Name = "Relay" })
			block(box, Vector3.new(0.15, 6, 0.15), pos + Vector3.new(0.6, 7, 0), C.metal, Enum.Material.Metal, { CanCollide = false })
			local lamp = block(box, Vector3.new(0.4, 0.4, 0.4), pos + Vector3.new(0.6, 10.2, 0), Color3.fromRGB(200, 60, 50), Enum.Material.Neon, { CanCollide = false })
			local p = makePrompt(box, "Repair relay", "Radio relay", cfg.hold)
			local holding = {}
			p.PromptButtonHoldBegan:Connect(function(player)
				holding[player] = true
				task.spawn(function()
					while holding[player] and p.Parent do
						Services.PerceptionService.emitNoise(box.Position, cfg.noise, "repair", player)
						Sfx.at(box.Position, "Search", 0.6, 60)
						task.wait(1.5)
					end
				end)
			end)
			p.PromptButtonHoldEnded:Connect(function(player)
				holding[player] = nil
			end)
			p.Triggered:Connect(function(player)
				holding[player] = nil
				lamp.Color = Color3.fromRGB(90, 230, 120)
				local light = Instance.new("PointLight")
				light.Color = lamp.Color
				light.Range = 10
				light.Parent = lamp
				Services.MatchService.onCrateSalvaged(player, box, true)
			end)
		end
	end

	-- Burn the Nests: salt crystal nests that take damage from guns, melee, fire, explosions
	if encounterType == "Nests" then
		local cfg = Encounters.Types.Nests
		local picks = shuffled(MapService.SupplyCandidates, rng)
		for i = 1, math.min(cfg.count, #picks) do
			local pos = Services.LootService.settle(picks[i], encounterFolder)
			local nest = Instance.new("Model")
			nest.Name = "Nest"
			nest:SetAttribute("NestHP", cfg.hp)
			nest:SetAttribute("NestMax", cfg.hp)
			local core = block(nest, Vector3.new(3.2, 2.2, 3.2), pos + Vector3.new(0, 1.1, 0), Color3.fromRGB(70, 66, 62), Enum.Material.Slate, { Name = "NestCore" })
			for k = 1, 9 do
				local a = k / 9 * math.pi * 2
				local hgt = rng:NextNumber(1.6, 4.2)
				block(nest, Vector3.new(rng:NextNumber(0.5, 0.9), hgt, rng:NextNumber(0.5, 0.9)), CFrame.new(pos + Vector3.new(math.cos(a) * 1.2, hgt / 2 + 0.6, math.sin(a) * 1.2)) * CFrame.Angles(rng:NextNumber(-0.5, 0.5), a, rng:NextNumber(-0.5, 0.5)), Color3.fromRGB(232, 228, 216), Enum.Material.Salt, { Name = "NestCrystal" })
			end
			local glow = Instance.new("PointLight")
			glow.Color = Color3.fromRGB(200, 220, 230)
			glow.Range = 9
			glow.Brightness = 0.6
			glow.Parent = core
			nest.PrimaryPart = core
			nest.Parent = encounterFolder
			CollectionService:AddTag(nest, "SaltNest")
		end
	end

	-- the signal lantern (Lantern Watch / finale)
	if encounterType == "LanternWatch" then
		local base = Services.LootService.settle(MapService.LanternPos, encounterFolder)
		block(encounterFolder, Vector3.new(3, 1, 3), base + Vector3.new(0, 0.5, 0), C.metal, Enum.Material.Metal)
		block(encounterFolder, Vector3.new(0.5, 6, 0.5), base + Vector3.new(0, 4, 0), C.metal, Enum.Material.Metal)
		lantern = block(encounterFolder, Vector3.new(1.6, 2, 1.6), base + Vector3.new(0, 8, 0), C.warm, Enum.Material.Neon, { Name = "SignalLantern" })
		local light = Instance.new("PointLight")
		light.Range = 40
		light.Brightness = 2.5
		light.Color = C.warm
		light.Shadows = true
		light.Parent = lantern
		volume(encounterFolder, Vector3.new(30, 10, 30), base + Vector3.new(0, 5, 0), "LitZone")
	end

	-- doors (some start closed)
	for _, d in MapService.Doorways do
		makeDoor(encounterFolder, d.hinge, d.width, d.dir, rng:NextNumber() < 0.5)
	end

	-- scavenging: containers + loose items
	Services.LootService.populate(encounterFolder, rng, pall or 1, MapService.ContainerSpots, MapService.LootSpots)
	-- torn Logbook pages (lore): two per mission, ones the crew hasn't found yet
	local okPages, pageIds = pcall(Services.RewardsService.pickPages, rng, 2)
	if okPages and #MapService.LootSpots > 2 then
		for i, pageId in pageIds do
			local spot = MapService.LootSpots[rng:NextInteger(1, #MapService.LootSpots)]
			local at = Services.LootService.settle(spot + Vector3.new(rng:NextNumber(-2, 2), 0, rng:NextNumber(-2, 2)), encounterFolder)
			local page = block(encounterFolder, Vector3.new(0.9, 0.05, 1.2), CFrame.new(at + Vector3.new(0, 0.05, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6.28), 0), Color3.fromRGB(246, 236, 206), Enum.Material.SmoothPlastic, { Name = "LogbookPage", CanCollide = false })
			local glow = Instance.new("PointLight")
			glow.Range = 5
			glow.Brightness = 0.6
			glow.Color = Color3.fromRGB(255, 230, 170)
			glow.Parent = page
			local sparkle = Instance.new("Sparkles")
			sparkle.SparkleColor = Color3.fromRGB(255, 230, 160)
			sparkle.Parent = page
			local pr = makePrompt(page, "Read", "Torn logbook page", 0.4)
			pr.Triggered:Connect(function(player)
				Services.RewardsService.findPage(player, pageId)
			end)
			assert(i)
		end
	end
	encounterFolder:SetAttribute("Modifier", modifier.id)

	-- extraction: the Slipway flare (inactive until the quota is met)
	local base = MapService.ExtractionPos
	local ring = block(encounterFolder, Vector3.new(0.2, Game.ExtractionRadius * 2, Game.ExtractionRadius * 2), CFrame.new(base + Vector3.new(0, 0.1, 0)) * CFrame.Angles(0, 0, math.rad(90)), C.flare, Enum.Material.Neon, {
		Name = "ExtractionRing",
		Shape = Enum.PartType.Cylinder,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	})
	local flare = block(encounterFolder, Vector3.new(0.6, 1.4, 0.6), base + Vector3.new(0, 0.7, 0), C.flare, Enum.Material.Neon, {
		Name = "Flare",
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
	})
	local light = Instance.new("PointLight")
	light.Color = C.flare
	light.Range = 32
	light.Brightness = 3
	light.Shadows = true
	light.Enabled = false
	light.Parent = flare
	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = SMOKE
	smoke.Enabled = false
	smoke.Rate = 6
	smoke.Lifetime = NumberRange.new(5, 7)
	smoke.Speed = NumberRange.new(6, 9)
	smoke.SpreadAngle = Vector2.new(8, 8)
	smoke.Color = ColorSequence.new(Color3.fromRGB(255, 120, 100))
	smoke.LightEmission = 0.4
	smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 9) })
	smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 1) })
	smoke.Parent = flare
	extraction = { ring = ring, flare = flare, light = light, smoke = smoke }
end

function MapService.activateExtraction()
	if not extraction then
		return
	end
	extraction.ring.Transparency = 0.8
	extraction.flare.Transparency = 0
	extraction.light.Enabled = true
	extraction.smoke.Enabled = true
end

function MapService.cleanupEncounter()
	if encounterFolder then
		encounterFolder:ClearAllChildren()
	end
	extraction = nil
end

-- Test hook: build the Meridian (with rooms for `owned`) without starting the game loop.
function MapService.buildFerryForTest(owned)
	local world = Workspace:FindFirstChild("World") or Instance.new("Folder")
	world.Name = "World"
	world.Parent = Workspace
	local ferry = Instance.new("Folder")
	ferry.Name = "Meridian"
	ferry.Parent = world
	buildFerry(ferry)
	MapService.setFerryRepairs(owned or {})
	return ferry
end

-- Spawn line in front of the chart table, facing it: the first thing you see is SET SAIL.
function MapService.ferrySpawn(index)
	local o = Game.FerryOrigin
	local pos = o + Vector3.new(-4.5 + ((index - 1) % 4) * 3, 3, 8)
	local look = o + Vector3.new(0, 3, -2)
	return CFrame.lookAt(pos, Vector3.new(look.X, pos.Y, look.Z))
end

function MapService.encounterSpawn(index)
	local pos = MapService.StartSpawns[(index - 1) % #MapService.StartSpawns + 1] + Vector3.new(0, 3, 0)
	local toward = MapService.ExtractionPos - pos
	toward = Vector3.new(toward.X, 0, toward.Z)
	return CFrame.lookAt(pos, pos + (toward.Magnitude > 1 and toward.Unit or Vector3.new(0, 0, -1)))
end

function MapService.init(registry)
	Services = registry
end

function MapService.start()
	local world = Instance.new("Folder")
	world.Name = "World"
	world.Parent = Workspace

	local ferry = Instance.new("Folder")
	ferry.Name = "Meridian"
	ferry.Parent = world
	buildFerry(ferry)

	MapKit.setAssets(Services.AssetService)

	encounterFolder = Instance.new("Folder")
	encounterFolder.Name = "Encounter"
	encounterFolder.Parent = world

	setupLighting()
	setupSky()
	task.spawn(function()
		-- warm the texture cache for every sky so map changes are instant
		for _, ids in Skies do
			skyTexture(ids.Side)
			skyTexture(ids.Up)
			skyTexture(ids.Dn)
		end
	end)
	MapService.applyFerryLighting()
	MapService.setFerryRepairs({})
	MapService.ready = true

	-- Hushed shove closed doors open when they reach them.
	while true do
		task.wait(0.4)
		for _, d in doors do
			if not d.open and d.part.Parent and #Services.EnemyService.findNear(d.part.Position, 5) > 0 then
				d.set(true, nil)
			end
		end
	end
end

return MapService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000003A"><Properties><string name="Name">MatchService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The Crossing director (the roguelike run):
--   Ferry      no crossing; pick crew, shop, repairs. Tide chart -> start a crossing.
--   Planning   at the Meridian mid-crossing: workbench, crafting, choose the next route.
--   Starting   short countdown, then the encounter.
--   Encounter  Salvage / Lantern Watch / Drift, or the finale (The Breakwater).
--   Results    debrief. Then back to Planning (next encounter) or Ferry (crossing over).
-- The satchel, weapons and workbench upgrades carry across a crossing; the Pall (difficulty)
-- rises after every encounter. Losing everyone ends the crossing; Scrip earned is kept.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Characters = require(Shared.Config.Characters)
local Encounters = require(Shared.Config.Encounters)
local Game = require(Shared.Config.Game)
local Modifiers = require(Shared.Config.Modifiers)
local Net = require(Shared.Net)
local Sfx = require(Shared.Util.Sfx)

local MatchService = {}
local Services

MatchService.state = "Ferry"
MatchService.modifier = Modifiers.None

local run = nil -- { id, index, pall, options, participants = { [Player] = true } }
-- mission types where you complete N objectives and then extract
local survivor = nil -- Bring Them Home: { model, humanoid, root, hp, follow }
local COLLECT = { Salvage = true, Medicine = true, Relay = true, Nests = true, Hunt = true, Rescue = true }
local OBJECTIVE_NOUN = { Salvage = "Supply crate", Medicine = "Medical cache", Relay = "Relay", Nests = "Nest", Hunt = "Target", Rescue = "Survivor" }
local enc = nil -- current encounter state
local resultsAcknowledged = {}
local rng = Random.new()

local function now()
	return os.clock()
end

local function setState(newState)
	MatchService.state = newState
	ReplicatedStorage:SetAttribute("MatchState", newState)
end

local function publish()
	ReplicatedStorage:SetAttribute("RunActive", run ~= nil)
	ReplicatedStorage:SetAttribute("RunIndex", run and run.index or 0)
	ReplicatedStorage:SetAttribute("RunLength", Encounters.RunLength + 1)
	ReplicatedStorage:SetAttribute("Pall", run and run.pall or 0)
	ReplicatedStorage:SetAttribute("ModifierName", MatchService.modifier.name)
	ReplicatedStorage:SetAttribute("ModifierDesc", MatchService.modifier.desc)
	ReplicatedStorage:SetAttribute("ModifierId", MatchService.modifier.id)
	ReplicatedStorage:SetAttribute("EncounterType", enc and enc.type or "")
	ReplicatedStorage:SetAttribute("EncounterName", enc and enc.name or "")
	ReplicatedStorage:SetAttribute("Objective", enc and enc.objective or "")
	ReplicatedStorage:SetAttribute("Crates", enc and enc.crates or 0)
	ReplicatedStorage:SetAttribute("CratesRequired", enc and enc.cratesRequired or 0)
	ReplicatedStorage:SetAttribute("ExtractionOpen", enc and enc.extractionOpen or false)
	ReplicatedStorage:SetAttribute("LanternHP", enc and enc.lanternHP or 0)
	ReplicatedStorage:SetAttribute("LanternMax", enc and enc.lanternMax or 0)
	ReplicatedStorage:SetAttribute("Wave", enc and enc.wave or 0)
	ReplicatedStorage:SetAttribute("Waves", enc and enc.waves or 0)
	ReplicatedStorage:SetAttribute("EndsAt", enc and enc.endsAtServer or 0)
	ReplicatedStorage:SetAttribute("RouteOptions", run and HttpService:JSONEncode(run.options or {}) or "[]")
end

-- Queries --------------------------------------------------------------------------------

function MatchService.getActiveInfo(player)
	if MatchService.state ~= "Encounter" or not run or not run.participants[player] then
		return nil
	end
	local session = Services.CharacterService.getSession(player)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not session or not root or session.downed or session.out then
		return nil
	end
	return { player = player, char = char, root = root, session = session }
end

function MatchService.getActivePlayers()
	local list = {}
	if MatchService.state ~= "Encounter" or not run then
		return list
	end
	for player in run.participants do
		local info = MatchService.getActiveInfo(player)
		if info then
			table.insert(list, info)
		end
	end
	return list
end

-- For actions allowed on the Meridian (crafting, equipping).
function MatchService.getFerryInfo(player)
	if MatchService.state == "Encounter" and run and run.participants[player] then
		return nil
	end
	local session = Services.CharacterService.getSession(player)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not session or not session.charId or not root then
		return nil
	end
	return { player = player, char = char, root = root, session = session }
end

function MatchService.getEncounterId()
	return MatchService.encounterId or 0
end

function MatchService.isParticipant(player)
	return run ~= nil and run.participants[player] == true
end

function MatchService.isPlanning()
	return MatchService.state == "Planning"
end

-- Ferry menus -----------------------------------------------------------------------------

function MatchService.openCharacterSelect(player)
	if MatchService.isParticipant(player) then
		Net.notify(player, "Toast", { text = "You can change crew once this crossing ends" })
		return
	end
	Net.notify(player, "OpenCharacterSelect", {})
end

function MatchService.openShop(player, tab)
	Net.notify(player, "OpenShop", { tab = tab })
end

function MatchService.openMenu(player, kind)
	Net.notify(player, kind, {})
end

local function ferrySpawnAll(resetInventory)
	local i = 0
	for _, player in Players:GetPlayers() do
		local session = Services.CharacterService.getSession(player)
		if session and session.charId then
			i += 1
			Services.CharacterService.spawn(player, Services.MapService.ferrySpawn(i), resetInventory and not MatchService.isParticipant(player))
		end
	end
end

local function rollModifier()
	if rng:NextNumber() < Modifiers.NoneChance then
		return Modifiers.None
	end
	return Modifiers.List[rng:NextInteger(1, #Modifiers.List)]
end

local function anyoneHas(repairId)
	for player in run and run.participants or {} do
		if Services.PlayerDataService.hasRepair(player, repairId) then
			return true
		end
	end
	return false
end

local function generateOptions()
	local options = {}
	if run.index > Encounters.RunLength then
		table.insert(options, { type = "Finale", name = Encounters.Finale.name, modifier = rollModifier().id, bonus = 0, map = "CanneryRow", mapName = "Cannery Row", factionName = "The Hushed" })
	else
		-- mission types and maps: the basics plus whatever the crew's Meridian projects unlock
		local Projects = require(Shared.Config.Projects)
		local types = table.clone(Projects.BaseMissions)
		local maps = table.clone(Projects.BaseMaps)
		for _, p in Projects.List do
			if p.unlocks and anyoneHas(p.id) then
				for _, m in p.unlocks.missions or {} do
					table.insert(types, m)
				end
				for _, m in p.unlocks.maps or {} do
					table.insert(maps, m)
				end
			end
		end
		-- never offer the mission type you just played (when there's anything else to offer)
		if run.lastType and #types > 3 then
			local at = table.find(types, run.lastType)
			if at then
				table.remove(types, at)
			end
		end
		for i = #types, 2, -1 do
			local j = rng:NextInteger(1, i)
			types[i], types[j] = types[j], types[i]
		end
		local count = math.min(#types, anyoneHas("radio") and 3 or 2)
		for i = #maps, 2, -1 do
			local j = rng:NextInteger(1, i)
			maps[i], maps[j] = maps[j], maps[i]
		end
		local factionIds = {}
		for id in Encounters.Factions do
			table.insert(factionIds, id)
		end
		table.sort(factionIds)
		for i = 1, count do
			local t = types[i]
			local faction = nil
			if run.index >= 2 and rng:NextNumber() < Encounters.FactionChance and t ~= "LanternWatch" then
				faction = factionIds[rng:NextInteger(1, #factionIds)]
			end
			table.insert(options, {
				type = t,
				name = Encounters.Types[t].name,
				modifier = rollModifier().id,
				bonus = ({ 0, 5, 10 })[rng:NextInteger(1, 3)],
				map = maps[(i - 1) % #maps + 1],
				mapName = Services.MapService.mapName(maps[(i - 1) % #maps + 1]),
				faction = faction,
				factionName = faction and Encounters.Factions[faction].name or "The Hushed",
			})
		end
	end
	run.options = options
	publish()
end

local function addToRun(player)
	if not run or run.participants[player] then
		return
	end
	local count = 0
	for _ in run.participants do
		count += 1
	end
	if count >= Game.MaxPartySize then
		Net.notify(player, "Toast", { text = "This crossing's crew is full. You'll join the next one." })
		return
	end
	if Services.CharacterService.beginRun(player, run.id, Services.HomebaseService.bonusesFor(player)) then
		run.participants[player] = true
		player:SetAttribute("InCrossing", true)
		if player.Character and MatchService.state == "Planning" then
			Services.WeaponService.onSpawn(player, player.Character) -- loadout may have changed
		end
	end
end

local function startRun()
	run = { id = HttpService:GenerateGUID(false), index = 1, pall = 1, participants = {} }
	for _, player in Players:GetPlayers() do
		local session = Services.CharacterService.getSession(player)
		if session and session.charId then
			addToRun(player)
		end
	end
	generateOptions()
	setState("Planning")
	ferrySpawnAll(false)
	Net.notifyAll("Toast", { text = "A crossing begins. Prepare at the workbench, then choose a route on the tide chart." })
end

function MatchService.requestChart(player)
	local session = Services.CharacterService.getSession(player)
	if not session or not session.charId then
		Net.notify(player, "OpenCharacterSelect", {})
		return
	end
	if MatchService.state == "Ferry" then
		startRun()
		Net.notifyAll("OpenChart", {})
	elseif MatchService.state == "Planning" then
		addToRun(player)
		Net.notify(player, "OpenChart", {})
	else
		Net.notify(player, "Toast", { text = "The crossing is already underway" })
	end
end

function MatchService.chooseRoute(player, index)
	if MatchService.state ~= "Planning" or not run or type(index) ~= "number" then
		return
	end
	addToRun(player)
	local option = run.options and run.options[math.floor(index)]
	if not option or not run.participants[player] then
		return
	end
	run.choice = option
	for p in run.participants do
		Services.PlayerDataService.markTutorial(p, "sailed")
	end
	setState("Starting")
	ReplicatedStorage:SetAttribute("StartsAt", Workspace:GetServerTimeNow() + Game.StartCountdown)
	Net.notifyAll("CloseMenus", {})
	Net.notifyAll("Toast", { text = ("%s chose %s. Casting off…"):format(player.DisplayName, option.name) })
	task.delay(Game.StartCountdown, function()
		if MatchService.state == "Starting" then
			local ok, err = pcall(MatchService.beginEncounter, option)
			if not ok then
				-- never leave the server stuck in "Starting" if a map fails to build
				warn("[MatchService] could not start the encounter: " .. tostring(err))
				enc = nil
				Services.EnemyService.clear()
				setState("Planning")
				publish()
				Net.notifyAll("Toast", { text = "The route was impassable. Choose another on the tide chart." })
			end
		end
	end)
end

local function onSelectCharacter(player, charId, perkId)
	if type(charId) ~= "string" or (perkId ~= nil and type(perkId) ~= "string") or not Characters.List[charId] then
		return
	end
	if MatchService.isParticipant(player) then
		Net.notify(player, "Toast", { text = "You can change crew once this crossing ends" })
		return
	end
	if not Services.CharacterService.setCharacter(player, charId, perkId) then
		return
	end
	Services.CharacterService.spawn(player, Services.MapService.ferrySpawn(#Players:GetPlayers()), true)
	if MatchService.state == "Planning" then
		Net.notify(player, "Toast", { text = "A crossing is being planned: use the tide chart to join it." })
	elseif MatchService.state ~= "Ferry" then
		Net.notify(player, "Toast", { text = "A crossing is underway. You'll join at the next stop." })
	end
end

-- Encounters ------------------------------------------------------------------------------

local function participantsCount()
	local n = 0
	for p in run.participants do
		if p.Parent then
			n += 1
		end
	end
	return n
end

local function enemyBudget()
	local players = math.max(1, participantsCount())
	return math.min(Encounters.MaxEnemies, Encounters.BaseEnemies + (run.pall - 1) * Encounters.PerPall + (players - 1) * Encounters.PerExtraPlayer)
end

local function weightsForPall()
	local faction = enc and enc.option and enc.option.faction
	if faction and Encounters.Factions[faction] then
		return Encounters.Factions[faction].weights
	end
	local level = math.clamp(run.pall, 1, 4)
	return Encounters.TypeWeights[level]
end

local function farEdgeSpawn()
	local active = MatchService.getActivePlayers()
	local best, bestDist = nil, -1
	for _, pos in Services.MapService.EdgeSpawns do
		local nearest = math.huge
		for _, info in active do
			nearest = math.min(nearest, (info.root.Position - pos).Magnitude)
		end
		local score = nearest + rng:NextNumber() * 30
		if score > bestDist then
			best, bestDist = pos, score
		end
	end
	return best or Services.MapService.EdgeSpawns[1]
end

local function spawnPatrols(count)
	local routes = Services.MapService.PatrolRoutes
	for i = 1, count do
		local route = routes[(i - 1) % #routes + 1]
		local start = route[rng:NextInteger(1, #route)] + Vector3.new(rng:NextNumber(-3, 3), 0, rng:NextNumber(-3, 3))
		Services.EnemyService.spawn(Services.EnemyService.pickType(weightsForPall()), start, { route = route })
	end
end

function MatchService.beginEncounter(option)
	table.clear(resultsAcknowledged)
	local isFinale = option.type == "Finale"
	local def = isFinale and Encounters.Finale or Encounters.Types[option.type]
	local kind = isFinale and def.type or option.type
	MatchService.modifier = Modifiers.None
	for _, m in Modifiers.List do
		if m.id == option.modifier then
			MatchService.modifier = m
		end
	end

	MatchService.encounterId = (MatchService.encounterId or 0) + 1
	run.lastType = option.type
	survivor = nil
	enc = {
		type = kind,
		finale = isFinale,
		name = def.name,
		option = option,
		startedAt = now(),
		crates = 0,
		cratesRequired = (kind == "Salvage" and def.crates) or (COLLECT[kind] and def.count) or 0,
		extractionOpen = false,
		wave = 0,
		waves = def.waves or 0,
		lanternHP = def.lanternHP or 0,
		lanternMax = def.lanternHP or 0,
		endsAtServer = 0,
		nextHunt = 0,
		nextSpawn = 0,
	}
	if kind == "Salvage" then
		enc.objective = def.desc:format(def.crates)
	elseif COLLECT[kind] then
		enc.objective = def.desc:format(def.count)
	else
		enc.objective = def.desc
	end

	Services.EnemyService.clear()
	Services.PerceptionService.clearFog()
	Services.MapService.resetEncounter(MatchService.modifier, rng, kind, run.pall, option.map)
	Services.MapService.applyModifier(MatchService.modifier)

	local i = 0
	for player in run.participants do
		if player.Parent then
			i += 1
			local session = Services.CharacterService.getSession(player)
			if session then
				session.stats.detectionsThisEncounter = 0
			end
			Services.CharacterService.spawn(player, Services.MapService.encounterSpawn(i), false)
		end
	end

	local budget = enemyBudget()
	if kind == "Hunt" then
		local def2 = Encounters.Types.Hunt
		local pick = def2.elite[option.faction or "Hushed"] or def2.elite.Hushed
		local spots = Services.MapService.SupplyCandidates
		local at = spots[rng:NextInteger(1, #spots)]
		Services.EnemyService.spawn(pick.type, at, { elite = pick.title, hpMult = def2.hpMult, route = { at, at + Vector3.new(10, 0, 0), at + Vector3.new(0, 0, 10) } })
		for k = 1, 2 do -- escorts
			Services.EnemyService.spawn(Services.EnemyService.pickType(weightsForPall()), at + Vector3.new(k * 4, 0, -3), { route = { at } })
		end
		spawnPatrols(math.max(2, budget - 3))
		enc.objective = ("%s: %s"):format(def.name, pick.title)
	elseif kind == "Rescue" then
		Services.MatchService.spawnSurvivor(rng)
		spawnPatrols(budget)
	elseif COLLECT[kind] then
		spawnPatrols(budget)
	elseif kind == "LanternWatch" then
		spawnPatrols(math.ceil(budget * 0.4))
		enc.nextWaveAt = now() + 8
		enc.endsAt = now() + 8 + def.waves * def.waveTime
		enc.endsAtServer = Workspace:GetServerTimeNow() + 8 + def.waves * def.waveTime
	elseif kind == "Drift" then
		spawnPatrols(math.ceil(budget * 0.6))
		enc.endsAt = now() + def.duration
		enc.endsAtServer = Workspace:GetServerTimeNow() + def.duration
		enc.nextHunt = now() + 6
		enc.nextSpawn = now() + def.spawnInterval
	end

	setState("Encounter")
	publish()
	if anyoneHas("lookout") then
		task.delay(1.5, function()
			for player in run.participants do
				Net.notify(player, "TideSense", { radius = 90, duration = 5 })
			end
			Net.notifyAll("Toast", { text = "The lookout calls it: Hushed marked." })
		end)
	end
	Net.notifyAll("EncounterStart", {
		name = def.name .. " · " .. (option.mapName or ""),
		faction = option.factionName,
		objective = enc.objective,
		modifierName = MatchService.modifier.name,
		modifierDesc = MatchService.modifier.desc,
		pall = run.pall,
	})
end


function MatchService.onCrateSalvaged(player, crate, keep)
	if MatchService.state ~= "Encounter" or not enc or not crate.Parent then
		return
	end
	local info = MatchService.getActiveInfo(player)
	if not info or (info.root.Position - crate.Position).Magnitude > 12 then
		return
	end
	if keep then
		for _, d in crate:GetDescendants() do
			if d:IsA("ProximityPrompt") then
				d:Destroy()
			end
		end
	else
		crate:Destroy()
	end
	enc.crates += 1
	info.session.stats.crates += 1
	Services.InventoryService.add(player, "salvage", 4)
	Services.PerceptionService.emitNoise(info.root.Position, 7, "salvage", player)
	if enc.crates >= enc.cratesRequired and not enc.extractionOpen then
		enc.extractionOpen = true
		Services.MapService.activateExtraction()
		Net.notifyAll("Toast", { text = "Quota met. The Slipway flare is lit: get everyone there." })
	else
		Net.notifyAll("Toast", { text = ("%s %d/%d"):format(OBJECTIVE_NOUN[enc.type] or "Objective", enc.crates, enc.cratesRequired) })
	end
	publish()
end

-- Salt nests (Burn the Nests): damaged by guns, melee, explosions and fire.
function MatchService.damageNest(nest, amount, player)
	if MatchService.state ~= "Encounter" or not enc or enc.type ~= "Nests" or not nest.Parent then
		return false
	end
	local hp = (nest:GetAttribute("NestHP") or 0) - amount
	nest:SetAttribute("NestHP", hp)
	local core = nest.PrimaryPart
	if core and amount >= 5 then -- a crack you can hear (fire ticks are too small to count)
		Services.PerceptionService.emitNoise(core.Position, 20, "nest", player)
	end
	if hp > 0 then
		return false
	end
	local at = core and core.Position or Vector3.zero
	nest:Destroy()
	Sfx.at(at, "Disperse", 1, 120)
	Net.notifyAll("Explosion", { position = at, radius = 8 })
	enc.crates += 1
	local session = player and Services.CharacterService.getSession(player)
	if session then
		session.stats.crates += 1
		Services.InventoryService.add(player, "salvage", 6)
	end
	-- the nest's keepers come out
	Services.EnemyService.spawn("Drifter", at + Vector3.new(4, 0, 0), { route = { at }, alertTo = player })
	if enc.crates >= enc.cratesRequired and not enc.extractionOpen then
		enc.extractionOpen = true
		Services.MapService.activateExtraction()
		Net.notifyAll("Toast", { text = "The nests are burned. The Slipway flare is lit: get everyone there." })
	else
		Net.notifyAll("Toast", { text = ("Nest %d/%d destroyed"):format(enc.crates, enc.cratesRequired) })
	end
	publish()
	return true
end

function MatchService.damageNestsNear(position, radius, amount, player)
	for _, nest in game:GetService("CollectionService"):GetTagged("SaltNest") do
		local core = nest.PrimaryPart
		if core and (core.Position - position).Magnitude <= radius then
			MatchService.damageNest(nest, amount, player)
		end
	end
end

-- Bring Them Home: a survivor NPC who follows whoever finds them.
function MatchService.spawnSurvivor(rng)
	local spots = Services.MapService.LootSpots
	local at = spots[rng:NextInteger(1, #spots)]
	local desc = Instance.new("HumanoidDescription")
	local model = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	model.Name = "Survivor"
	local Characters = require(Shared.Config.Characters)
	local kit = "Crew_" .. Characters.Order[rng:NextInteger(1, #Characters.Order)]
	local MeshKit = require(Shared.MeshKit)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if Services.AssetService.hasKit(kit) then
		local meta = Services.AssetService.meta(kit)
		local okFit, hip = pcall(MeshKit.conformSkeleton, model, meta, "r15", 0.88)
		if okFit and hip then
			humanoid.HipHeight = hip
			model:SetAttribute("BaseHipHeight", hip)
		end
		pcall(MeshKit.applyRig, model, meta, Services.AssetService.part, "r15", nil, {
			Jacket = Color3.fromRGB(110, 96, 80), Sleeve = Color3.fromRGB(110, 96, 80), Pants = Color3.fromRGB(70, 66, 60),
		})
	end
	Services.CharacterService.stripAnimator(model)
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.WalkSpeed = 14
	model:SetAttribute("Procedural", true)
	model:SetAttribute("Stance", "Crouch")
	model:PivotTo(CFrame.new(at + Vector3.new(0, 4, 0)))
	model.Parent = Services.MapService.getEncounterFolder()
	game:GetService("CollectionService"):AddTag(model, "Survivor")
	local root = model:FindFirstChild("HumanoidRootPart")
	survivor = { model = model, humanoid = humanoid, root = root, hp = Encounters.Types.Rescue.hp, follow = nil, hurtAt = {} }
	local p = Instance.new("ProximityPrompt")
	p.ActionText = "Lead them out"
	p.ObjectText = "Survivor"
	p.HoldDuration = 0.6
	p.MaxActivationDistance = 8
	p.RequiresLineOfSight = false
	p.Parent = root
	p.Triggered:Connect(function(player)
		if not survivor or survivor.follow then
			return
		end
		survivor.follow = player
		model:SetAttribute("Stance", "Stand")
		p:Destroy()
		enc.crates = 1
		enc.extractionOpen = true
		Services.MapService.activateExtraction()
		Net.notifyAll("Toast", { text = player.DisplayName .. " found the survivor. Get them to the Slipway flare." })
		publish()
	end)
	task.spawn(function() -- walk with their rescuer
		while survivor and survivor.model == model and model.Parent do
			local s = survivor
			if s.follow then
				local info = MatchService.getActiveInfo(s.follow)
				if not info then -- rescuer went down: follow anyone standing
					local others = MatchService.getActivePlayers()
					info = others[1]
					s.follow = info and info.player or s.follow
				end
				if info then
					local d = (info.root.Position - s.root.Position).Magnitude
					if d > 5 then
						s.humanoid.WalkSpeed = d > 16 and 18 or 13
						s.humanoid:MoveTo(info.root.Position - info.root.CFrame.LookVector * 3)
					else
						s.humanoid:MoveTo(s.root.Position)
					end
				end
			end
			task.wait(0.25)
		end
	end)
end

-- The Hushed hurt a survivor they get their hands on.
function MatchService.tickSurvivor()
	local s = survivor
	if not s or not enc or not s.model.Parent then
		return
	end
	local now = os.clock()
	for _, entry in Services.EnemyService.findNear(s.root.Position, 3.6) do
		local e = entry.enemy
		if not e.cfg.human and e.state ~= "Stunned" and e.state ~= "Quieted" and now > (s.hurtAt[e] or 0) then
			s.hurtAt[e] = now + 2
			s.hp -= Encounters.Types.Rescue.grabDamage
			Sfx.at(s.root.Position, "Hurt", 0.8, 60)
			Net.notifyAll("Toast", { text = ("The survivor is hurt! (%d%%)"):format(math.max(0, s.hp)) })
		end
	end
	s.model:SetAttribute("HP", math.max(0, s.hp))
	if s.hp <= 0 then
		enc.survivorDead = true
		s.model:SetAttribute("Downed", true)
	end
end

function MatchService.survivorAtExtraction()
	local s = survivor
	if not s or not s.root.Parent then
		return false
	end
	local x = Services.MapService.ExtractionPos
	return Vector3.new(s.root.Position.X - x.X, 0, s.root.Position.Z - x.Z).Magnitude <= Game.ExtractionRadius + 4
end

function MatchService.onSpotted(player, enemy)
	local session = Services.CharacterService.getSession(player)
	if session then
		session.stats.detections += 1
		session.stats.detectionsThisEncounter = (session.stats.detectionsThisEncounter or 0) + 1
	end
	Net.notify(player, "Spotted", {})
	Sfx.at(enemy.root.Position, "Spotted", 0.25, 40)
end

function MatchService.onEnemyKilled(player, e)
	if e and e.isTarget and enc and enc.type == "Hunt" and not enc.targetDown then
		enc.targetDown = true
		enc.crates = 1
		enc.extractionOpen = true
		Services.MapService.activateExtraction()
		Net.notifyAll("Toast", { text = "The target is down. The Slipway flare is lit: get out." })
		publish()
	end
	if not player or not player.Parent then
		return
	end
	local session = Services.CharacterService.getSession(player)
	if session then
		session.stats.kills += 1
	end
	Services.InventoryService.add(player, "salvage", e.cfg.salvage or 2)
end

function MatchService.onObjectiveAttacked(amount)
	if not enc or enc.type ~= "LanternWatch" or MatchService.state ~= "Encounter" then
		return
	end
	enc.lanternHP = math.max(0, enc.lanternHP - amount)
	ReplicatedStorage:SetAttribute("LanternHP", enc.lanternHP)
end

function MatchService.onPlayerDowned(_player)
	-- the encounter loop checks for a wipe
end

-- Results -----------------------------------------------------------------------------------

local function today()
	return os.date("!%Y-%m-%d")
end

local function grantTokens(player, rewards, list)
	for kind, amount in rewards do
		if Services.PlayerDataService.addTokens(player, kind, amount) then
			table.insert(list, ("+%d %s"):format(amount, ({ secondWind = "Second Wind", resupply = "Resupply", ammo = "Ammo Cache" })[kind] or kind))
		end
	end
end

local function finishRun(win)
	for player in run.participants do
		if player.Parent then
			Services.CharacterService.endRun(player)
			player:SetAttribute("InCrossing", false)
			local data = Services.PlayerDataService.get(player)
			if data then
				data.stats.runs += 1
				if win then
					data.stats.wins += 1
				end
				data.stats.bestPall = math.max(data.stats.bestPall, run.pall)
			end
		end
	end
	run = nil
end

function MatchService.endEncounter(win)
	if MatchService.state ~= "Encounter" or not enc then
		return
	end
	setState("Results")
	MatchService.resultPlayers = {}
	for player in run.participants do
		MatchService.resultPlayers[player] = true
	end
	local elapsed = now() - enc.startedAt
	local runOver = (not win) or enc.finale
	local R = Encounters.Rewards
	for player in run.participants do
		if player.Parent then
			local session = Services.CharacterService.getSession(player)
			local data = Services.PlayerDataService.get(player)
			local rewards = {}
			if session and data then
				data.stats.takedowns += session.stats.takedowns
				if win then
					data.stats.encounters += 1
					local salvage = R.salvagePerEncounter + 5 * run.pall + (enc.option.bonus or 0)
					Services.InventoryService.add(player, "salvage", salvage)
					table.insert(rewards, ("+%d Salvage"):format(salvage))
					local morale = Services.PlayerDataService.hasRepair(player, "lights") and 1.1 or 1 -- Deck Lights
					local scrip = math.floor((R.scripPerEncounter + 10 * run.index + (enc.finale and R.scripRunComplete or 0)) * Services.CosmeticsService.scripMult(player) * morale + 0.5)
					Services.PlayerDataService.addScrip(player, scrip)
					Services.AnalyticsHelper.economy(player, "source", scrip, Enum.AnalyticsEconomyTransactionType.Gameplay.Name, enc.finale and "CrossingComplete" or "Encounter")
					table.insert(rewards, ("+%d Scrip"):format(scrip))
					if enc.finale and Game.RunAidsEnabled then
						grantTokens(player, Game.WinReward, rewards)
						if data.lastDailyWin ~= today() then
							data.lastDailyWin = today()
							grantTokens(player, Game.DailyWinReward, rewards)
						end
					end
				end
				-- Materials for Meridian projects (half for a failed encounter)
				local Projects = require(Shared.Config.Projects)
				local m = Projects.Materials
				local charts = Services.PlayerDataService.hasRepair(player, "chartroom") and 1.15 or 1 -- Chart Room
				local mats = math.floor((m.perWin + m.perPall * run.pall + (enc.finale and m.runComplete or 0)) * (win and 1 or m.lossShare) * charts + 0.5)
				if runOver then
					local leftover = player:GetAttribute("Salvage") or 0
					mats += math.floor(leftover * m.salvageToMaterials)
				end
				Services.PlayerDataService.addMaterials(player, mats)
				table.insert(rewards, ("+%d Materials"):format(mats))
				if win and enc.finale and not data.firstFinaleWin then
					data.firstFinaleWin = true
					Services.PlayerDataService.addTokens(player, "build", 1)
					table.insert(rewards, "+1 Shipwright's Crew token (first Breakwater)")
				end
				pcall(function()
					Services.QuestService.onEncounterEnd(player, session.stats, win, enc, runOver)
				end)
				Services.LeaderboardService.refreshPlayer(player)
				task.spawn(Services.PlayerDataService.save, player)
			end
			Net.notify(player, "Results", {
				win = win,
				runOver = runOver,
				runWon = win and enc.finale,
				name = enc.name,
				index = run.index,
				pall = run.pall,
				seconds = math.floor(elapsed),
				crates = enc.crates,
				takedowns = session and session.stats.takedowns or 0,
				kills = session and session.stats.kills or 0,
				detections = session and session.stats.detections or 0,
				rewards = rewards,
			})
		end
	end
	Services.EnemyService.clear()
	Services.PerceptionService.clearFog()

	if runOver then
		finishRun(win)
	else
		run.index += 1
		run.pall += 1
	end

	local token = {}
	MatchService.resultsToken = token
	task.delay(Game.ResultsDuration, function()
		if MatchService.resultsToken == token then
			MatchService.leaveResults()
		end
	end)
end

function MatchService.leaveResults()
	if MatchService.state ~= "Results" then
		return
	end
	MatchService.resultsToken = nil
	enc = nil
	Services.MapService.cleanupEncounter()
	MatchService.modifier = Modifiers.None
	Services.MapService.applyFerryLighting()
	if run then
		generateOptions()
		setState("Planning")
		publish()
		ferrySpawnAll(false)
		Net.notifyAll("Toast", { text = ("Back aboard. Pall level %d. Upgrade at the workbench, then read the tide chart."):format(run.pall) })
	else
		setState("Ferry")
		publish()
		ferrySpawnAll(true)
	end
end

-- Encounter loop ------------------------------------------------------------------------------

local function allStandingAtExtraction()
	local extraction = Services.MapService.ExtractionPos
	local anyStanding, allIn = false, true
	for player in run.participants do
		local info = MatchService.getActiveInfo(player)
		if info then
			anyStanding = true
			local flat = Vector3.new(info.root.Position.X - extraction.X, 0, info.root.Position.Z - extraction.Z)
			if flat.Magnitude > Game.ExtractionRadius then
				allIn = false
			end
		end
	end
	return anyStanding and allIn
end

local function tickEncounter()
	if MatchService.state ~= "Encounter" or not enc or not run then
		return
	end
	for player in run.participants do
		if not player.Parent then
			run.participants[player] = nil
		end
	end
	local active = MatchService.getActivePlayers()
	if #active == 0 then
		MatchService.endEncounter(false)
		return
	end
	local t = now()
	local def = enc.finale and Encounters.Finale or Encounters.Types[enc.type]

	if enc.type == "Rescue" then
		MatchService.tickSurvivor()
		if enc.survivorDead then
			Net.notifyAll("Toast", { text = "The survivor didn't make it." })
			MatchService.endEncounter(false)
			return
		end
	end
	if COLLECT[enc.type] then
		if enc.extractionOpen and allStandingAtExtraction() and (enc.type ~= "Rescue" or MatchService.survivorAtExtraction()) then
			MatchService.endEncounter(true)
		end
	elseif enc.type == "LanternWatch" then
		if enc.lanternHP <= 0 then
			Net.notifyAll("Toast", { text = "The lantern went dark." })
			MatchService.endEncounter(false)
			return
		end
		if enc.wave < enc.waves and t >= enc.nextWaveAt then
			enc.wave += 1
			enc.nextWaveAt = t + def.waveTime
			local count = def.perWave + (run.pall - 1) + (#active - 1)
			local lanternPos = Services.MapService.LanternPos
			for k = 1, count do
				local typeName = Services.EnemyService.pickType(weightsForPall())
				if enc.finale and enc.wave == enc.waves and k == 1 then
					typeName = def.boss
				end
				local origin = farEdgeSpawn() + Vector3.new(rng:NextNumber(-4, 4), 0, rng:NextNumber(-4, 4))
				Services.EnemyService.spawn(typeName, origin, { objective = lanternPos, objectiveDps = def.dps })
			end
			Net.notifyAll("Toast", { text = ("Wave %d of %d: they're coming for the light."):format(enc.wave, enc.waves) })
			publish()
		end
		if t >= enc.endsAt then
			Net.notifyAll("Toast", { text = "The tide turns. The lantern held." })
			MatchService.endEncounter(true)
		end
	elseif enc.type == "Drift" then
		if t >= enc.nextHunt and not enc.extractionOpen then
			enc.nextHunt = t + def.huntInterval
			Services.EnemyService.huntPulse(active)
		end
		if t >= enc.nextSpawn and not enc.extractionOpen and Services.EnemyService.count() < Encounters.MaxEnemies then
			enc.nextSpawn = t + def.spawnInterval
			for _ = 1, def.perSpawn + math.floor((run.pall - 1) / 2) do
				Services.EnemyService.spawn(Services.EnemyService.pickType(weightsForPall()), farEdgeSpawn(), { hunt = true, route = { farEdgeSpawn() } })
			end
		end
		if not enc.extractionOpen and t >= enc.endsAt then
			enc.extractionOpen = true
			Services.MapService.activateExtraction()
			Net.notifyAll("Toast", { text = "The tide turns. Get to the Slipway flare!" })
			publish()
		end
		if enc.extractionOpen and allStandingAtExtraction() then
			MatchService.endEncounter(true)
		end
	end
end

function MatchService.init(registry)
	Services = registry
end

function MatchService.start()
	setState("Ferry")
	publish()

	Net.onServer("SelectCharacter", 2, onSelectCharacter)
	Net.onServer("ReturnToFerry", 2, function(player)
		if MatchService.state ~= "Results" then
			return
		end
		resultsAcknowledged[player] = true
		for p in MatchService.resultPlayers or {} do
			if p.Parent and not resultsAcknowledged[p] then
				return
			end
		end
		MatchService.leaveResults()
	end)

	local function onJoin(player)
		task.defer(function()
			Net.notify(player, "OpenCharacterSelect", {})
		end)
	end
	Players.PlayerAdded:Connect(onJoin)
	for _, player in Players:GetPlayers() do
		onJoin(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		if run then
			run.participants[player] = nil
		end
		resultsAcknowledged[player] = nil
	end)

	while true do
		task.wait(0.5)
		local ok, err = pcall(tickEncounter)
		if not ok then
			warn("[MatchService] " .. tostring(err))
		end
	end
end

return MatchService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000003B"><Properties><string name="Name">PerceptionService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- How the Hushed sense players.
--   Sight: range + field-of-view cone + line-of-sight raycasts, scaled by stance, cover (reeds),
--          light (lamp pools, your torch), movement and fog.
--   Hearing: every gameplay sound is a server "noise event" {position, radius, kind, player}.
--          Footsteps are generated here from real velocity + stance, 4 times a second.
-- The current footstep noise radius is published as the character attribute "Noise" for the HUD.
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Movement = require(Shared.Config.Movement)
local Geometry = require(Shared.Util.Geometry)
local Net = require(Shared.Net)

local PerceptionService = {}
local Services

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local fogClouds = {} -- { position, radius, untilTime }

function PerceptionService.setEnemyFolder(folder)
	rayParams.FilterDescendantsInstances = { folder }
end

-- Fog Pots: smoke that blocks sight lines through (or into) it.
function PerceptionService.addFogCloud(position, radius, duration)
	table.insert(fogClouds, { position = position, radius = radius, untilTime = os.clock() + duration })
end

function PerceptionService.clearFog()
	table.clear(fogClouds)
end

local function segmentBlocked(a, b)
	local now = os.clock()
	for i = #fogClouds, 1, -1 do
		local cloud = fogClouds[i]
		if now > cloud.untilTime then
			table.remove(fogClouds, i)
		else
			local ab = b - a
			local len = ab.Magnitude
			if len > 0.01 then
				local t = math.clamp((cloud.position - a):Dot(ab) / (len * len), 0, 1)
				local closest = a + ab * t
				if (closest - cloud.position).Magnitude < cloud.radius then
					return true
				end
			end
		end
	end
	return false
end
PerceptionService.segmentBlocked = segmentBlocked

-- Returns 0 (unseen) or a positive visibility factor (higher = noticed faster).
function PerceptionService.sightFactor(enemy, info)
	local cfg = enemy.cfg
	local char, root = info.char, info.root
	local head = char:FindFirstChild("Head")
	if not head then
		return 0
	end
	local modifier = Services.MatchService.modifier or {}
	local eyes = enemy.head.Position
	local toPlayer = root.Position - eyes
	local dist = toPlayer.Magnitude
	if cfg.sightRange <= 0 then
		-- blind (Seekers): only "feel" someone moving right next to them
		local close = (root.Position - enemy.root.Position).Magnitude
		local moving = Geometry.flat(root.AssemblyLinearVelocity).Magnitude > 1
		if close < cfg.closeRange and moving and char:GetAttribute("Stance") == "Stand" then
			return 3
		end
		return 0
	end
	local range = cfg.sightRange * (modifier.sightMult or 1)
	local lit = char:GetAttribute("Torch") == true or Geometry.inTagged(root.Position, "LitZone")
	if lit then
		range *= 1.45
	end
	if dist > range or dist < 0.01 then
		return 0
	end
	if dist > 4.5 and enemy.root.CFrame.LookVector:Dot(toPlayer.Unit) < enemy.fovCos then
		return 0
	end

	if segmentBlocked(eyes, root.Position) then
		return 0
	end
	local visible = false
	for _, target in { head.Position, root.Position } do
		local result = Workspace:Raycast(eyes, target - eyes, rayParams)
		if not result or result.Instance:IsDescendantOf(char) then
			visible = true
			break
		end
	end
	if not visible then
		return 0
	end

	local stance = char:GetAttribute("Stance")
	-- tall grass: crouched or prone in it (light off, not shooting) you can't be seen at all
	-- unless someone is practically standing on you
	local inGrass = Geometry.inTagged(root.Position, "TallGrass")
	if inGrass and stance ~= "Stand" and not lit then
		local shotRecently = (Workspace:GetServerTimeNow() - (char:GetAttribute("ShotAt") or -100)) < 2
		if dist > 3.5 and not shotRecently then
			return 0
		end
	end
	local f = 1 - (dist / range) * 0.75
	if stance == "Crouch" then
		f *= 0.55
	elseif stance == "Prone" then
		f *= 0.3
	end
	if inGrass then
		f *= 0.3 -- standing in tall grass still breaks up your outline
	end
	if lit then
		f *= 1.8
	end
	local speed = Geometry.flat(root.AssemblyLinearVelocity).Magnitude
	if speed < 1 then
		f *= 0.6
	elseif speed > 17 then
		f *= 1.3
	end
	if dist < cfg.closeRange then
		f *= 2.5
	end
	return f
end

-- Any sound in the world that Hushed may react to.
function PerceptionService.emitNoise(position, radius, kind, player)
	local modifier = Services.MatchService.modifier or {}
	radius *= modifier.noiseMult or 1
	if radius <= 0 then
		return
	end
	if kind ~= "footstep" and radius >= 18 then
		-- show everyone how far a loud noise carried (gunshots, bottles, explosions)
		Net.notifyAll("NoiseRing", { position = position, radius = radius, kind = kind })
	end
	Services.EnemyService.onNoise({ position = position, radius = radius, kind = kind, player = player })
end

local function footstepRadius(info, now)
	local char, root, session = info.char, info.root, info.session
	local mods = session.mods
	local speed = Geometry.flat(root.AssemblyLinearVelocity).Magnitude
	if speed < 1 or char:GetAttribute("Downed") then
		return 0
	end
	local radius
	if char:GetAttribute("Stance") == "Prone" then
		radius = Movement.Noise.Prone * mods.crouchNoiseMult
	elseif char:GetAttribute("Stance") == "Crouch" then
		radius = Movement.Noise.Crouch * mods.crouchNoiseMult
	elseif speed < 10.5 then
		radius = Movement.Noise.Walk
	elseif speed < 17 then
		radius = Movement.Noise.Jog
	else
		radius = Movement.Noise.Sprint
	end
	if Geometry.inTagged(root.Position, "Shallows") then
		radius *= 1 + (Movement.WaterNoiseMult - 1) * mods.waterNoiseMult
	end
	local modifier = Services.MatchService.modifier or {}
	radius *= mods.noiseMult * (modifier.footstepMult or 1)
	if (session.calmUntil or 0) > now then
		radius *= 0.5
	end
	return radius
end

function PerceptionService.init(registry)
	Services = registry
end

function PerceptionService.start()
	while true do
		task.wait(0.25)
		if Services.MatchService.state == "Encounter" then
			local now = os.clock()
			for _, info in Services.MatchService.getActivePlayers() do
				local radius = footstepRadius(info, now)
				info.char:SetAttribute("Noise", math.floor(radius + 0.5))
				if radius > 0 then
					PerceptionService.emitNoise(info.root.Position, radius, "footstep", info.player)
				end
			end
		end
	end
end

return PerceptionService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000003C"><Properties><string name="Name">PlayerDataService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Persistent player data (tokens, stats, purchase receipts) in a DataStore.
-- Stage 9 replaces this with ProfileStore (session locking); the API stays the same.
-- In Studio without "Enable Studio Access to API Services", it falls back to memory only.
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Game = require(Shared.Config.Game)

local PlayerDataService = {}

local STORE_NAME = "Aftertide_Player_v1"
local AUTOSAVE_INTERVAL = 120
local MAX_RECEIPTS = 50

local store = nil
local memoryOnly = false
local profiles = {} -- [Player] = { data = table, noSave = bool, loaded = bool }

local function defaultData()
	return {
		version = 1,
		tokens = { secondWind = Game.StartingTokens.secondWind, resupply = Game.StartingTokens.resupply, ammo = Game.StartingTokens.ammo, build = 0, spin = 0 },
		stats = { runs = 0, wins = 0, takedowns = 0, encounters = 0, bestPall = 0 },
		receipts = {},
		receiptOrder = {},
		lastDailyWin = "",
		scrip = 0, -- homebase currency, earned only by playing
		materials = 0, -- Meridian projects; earned from missions
		repairs = {}, -- [repairId] = true
		settings = { graphics = "Auto", sensitivity = 1, reduceMotion = false, camera = "First", uiSize = "Large", fov = 80 },
		outfits = {}, -- [outfitId] = true (bought or unlocked; defaults are implicit)
		equipped = {}, -- [charId] = outfitId
		oneTime = {}, -- [productKey] = true (Starter Pack)
		spent = 0, -- Robux spent (for thank-you messaging only; never affects gameplay)
		quests = {}, -- QuestService state (daily / weekly challenges)
		guns = { revolver = true }, -- unlocked at the Quartermaster
		loadout = { long = "", pack = {} }, -- chosen at the Quartermaster
		kit = {}, -- [kitId] = count, delivered at the start of the next crossing
		firstFinaleWin = false,
		spinDay = "", -- UTC day of the last free Lucky Spin
		lastLoginDay = 0, -- daily streak (RewardsService)
		streak = 0,
		pages = {}, -- [pageId] = true (Logbook)
		tutorial = {}, -- first-time Meridian steps done: { crew, chart, sail }
	}
end

local function reconcile(data)
	local template = defaultData()
	for key, value in template do
		if data[key] == nil then
			data[key] = value
		elseif type(value) == "table" and type(data[key]) == "table" and key ~= "receipts" and key ~= "receiptOrder" and key ~= "repairs" and key ~= "outfits" and key ~= "equipped" and key ~= "oneTime" and key ~= "quests" and key ~= "guns" and key ~= "loadout" and key ~= "kit" and key ~= "tutorial" and key ~= "pages" then
			for k2, v2 in value do
				if data[key][k2] == nil then
					data[key][k2] = v2
				end
			end
		end
	end
	return data
end

local function keyFor(player)
	return "u_" .. player.UserId
end

local function publishTokens(player, data)
	for kind, amount in data.tokens do
		player:SetAttribute("Tokens_" .. kind, amount)
	end
	player:SetAttribute("Scrip", data.scrip)
	player:SetAttribute("Materials", data.materials or 0)
	player:SetAttribute("Repairs", HttpService:JSONEncode(data.repairs))
	player:SetAttribute("Set_graphics", data.settings.graphics)
	player:SetAttribute("Set_sensitivity", data.settings.sensitivity)
	player:SetAttribute("Set_reduceMotion", data.settings.reduceMotion)
	player:SetAttribute("Set_camera", data.settings.camera or "First")
	player:SetAttribute("Set_uiSize", data.settings.uiSize or "Large")
	player:SetAttribute("Set_fov", data.settings.fov or 80)
	player:SetAttribute("Outfits", HttpService:JSONEncode(data.outfits))
	player:SetAttribute("EquippedOutfits", HttpService:JSONEncode(data.equipped))
	player:SetAttribute("OneTime", HttpService:JSONEncode(data.oneTime))
	player:SetAttribute("Guns", HttpService:JSONEncode(data.guns or { revolver = true }))
	player:SetAttribute("Loadout", HttpService:JSONEncode(data.loadout or {}))
	player:SetAttribute("Kit", HttpService:JSONEncode(data.kit or {}))
	player:SetAttribute("NewPlayer", not (data.tutorial and data.tutorial.sailed) and (data.stats.runs or 0) == 0)
end

function PlayerDataService.publish(player)
	local data = PlayerDataService.get(player)
	if data then
		publishTokens(player, data)
	end
end

function PlayerDataService.addScrip(player, amount)
	local data = PlayerDataService.get(player)
	if not data then
		return false
	end
	data.scrip += amount
	publishTokens(player, data)
	return true
end

function PlayerDataService.addMaterials(player, amount)
	local data = PlayerDataService.get(player)
	if not data or amount <= 0 then
		return false
	end
	data.materials = (data.materials or 0) + math.floor(amount)
	publishTokens(player, data)
	return true
end

function PlayerDataService.spendMaterials(player, amount)
	local data = PlayerDataService.get(player)
	if not data or (data.materials or 0) < amount then
		return false
	end
	data.materials -= amount
	publishTokens(player, data)
	return true
end

function PlayerDataService.spendScrip(player, amount)
	local data = PlayerDataService.get(player)
	if not data or data.scrip < amount then
		return false
	end
	data.scrip -= amount
	publishTokens(player, data)
	return true
end

function PlayerDataService.ownOutfit(player, outfitId)
	local data = PlayerDataService.get(player)
	if data then
		data.outfits[outfitId] = true
		publishTokens(player, data)
	end
end

function PlayerDataService.markOneTime(player, key)
	local data = PlayerDataService.get(player)
	if data then
		data.oneTime[key] = true
		publishTokens(player, data)
	end
end

function PlayerDataService.setEquipped(player, charId, outfitId)
	local data = PlayerDataService.get(player)
	if data then
		data.equipped[charId] = outfitId
		publishTokens(player, data)
	end
end

function PlayerDataService.hasRepair(player, repairId)
	local data = PlayerDataService.get(player)
	return data ~= nil and data.repairs[repairId] == true
end

-- First-time help: remembered once you've set sail.
function PlayerDataService.markTutorial(player, step)
	local data = PlayerDataService.get(player)
	if data then
		data.tutorial = data.tutorial or {}
		if not data.tutorial[step] then
			data.tutorial[step] = true
			publishTokens(player, data)
		end
	end
end

function PlayerDataService.addRepair(player, repairId)
	local data = PlayerDataService.get(player)
	if data then
		data.repairs[repairId] = true
		publishTokens(player, data)
	end
end

function PlayerDataService.setSettings(player, settings)
	local data = PlayerDataService.get(player)
	if data then
		data.settings = settings
		publishTokens(player, data)
	end
end

local function load(player)
	if memoryOnly then
		return defaultData(), false
	end
	for attempt = 1, 3 do
		local ok, result = pcall(function()
			return store:GetAsync(keyFor(player))
		end)
		if ok then
			return reconcile(result or defaultData()), false
		end
		warn(("[PlayerData] load attempt %d failed for %s: %s"):format(attempt, player.Name, tostring(result)))
		task.wait(attempt)
	end
	-- Don't overwrite real data with defaults if loading failed.
	return defaultData(), true
end

function PlayerDataService.save(player)
	local profile = profiles[player]
	if not profile or not profile.loaded then
		return false
	end
	if memoryOnly then
		return true
	end
	if profile.noSave then
		return false
	end
	local ok, err = pcall(function()
		store:UpdateAsync(keyFor(player), function()
			return profile.data
		end)
	end)
	if not ok then
		warn(("[PlayerData] save failed for %s: %s"):format(player.Name, tostring(err)))
	end
	return ok
end

function PlayerDataService.isMemoryOnly()
	return memoryOnly
end

function PlayerDataService.get(player)
	local profile = profiles[player]
	return profile and profile.loaded and profile.data or nil
end

function PlayerDataService.waitFor(player, timeout)
	local deadline = os.clock() + (timeout or 15)
	while player.Parent and os.clock() < deadline do
		local data = PlayerDataService.get(player)
		if data then
			return data
		end
		task.wait(0.2)
	end
	return nil
end

function PlayerDataService.addTokens(player, kind, amount)
	local data = PlayerDataService.get(player)
	if not data or data.tokens[kind] == nil then
		return false
	end
	data.tokens[kind] += amount
	publishTokens(player, data)
	return true
end

function PlayerDataService.useToken(player, kind)
	local data = PlayerDataService.get(player)
	if not data or (data.tokens[kind] or 0) < 1 then
		return false
	end
	data.tokens[kind] -= 1
	publishTokens(player, data)
	return true
end

function PlayerDataService.hasReceipt(player, purchaseId)
	local data = PlayerDataService.get(player)
	return data ~= nil and data.receipts[purchaseId] == true
end

function PlayerDataService.recordReceipt(player, purchaseId)
	local data = PlayerDataService.get(player)
	if not data then
		return
	end
	data.receipts[purchaseId] = true
	table.insert(data.receiptOrder, purchaseId)
	while #data.receiptOrder > MAX_RECEIPTS do
		local oldest = table.remove(data.receiptOrder, 1)
		data.receipts[oldest] = nil
	end
end

local function onPlayerAdded(player)
	profiles[player] = { loaded = false }
	local data, noSave = load(player)
	if not player.Parent then
		profiles[player] = nil
		return
	end
	profiles[player] = { data = data, noSave = noSave, loaded = true }
	publishTokens(player, data)
	if noSave then
		warn("[PlayerData] " .. player.Name .. " is in no-save mode (DataStore unavailable)")
	end
end

local function onPlayerRemoving(player)
	PlayerDataService.save(player)
	profiles[player] = nil
end

function PlayerDataService.init()
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
		if RunService:IsStudio() then
			-- Probe once: Studio without API access throws here.
			local probeOk = pcall(function()
				store:GetAsync("probe")
			end)
			if not probeOk then
				memoryOnly = true
			end
		end
	else
		memoryOnly = true
	end
	if memoryOnly then
		warn("[PlayerData] DataStores unavailable: using memory only (enable Studio API access to test saving)")
	end
end

function PlayerDataService.start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	game:BindToClose(function()
		local pending = 0
		for _, player in Players:GetPlayers() do
			pending += 1
			task.spawn(function()
				PlayerDataService.save(player)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)

	while true do
		task.wait(AUTOSAVE_INTERVAL)
		for _, player in Players:GetPlayers() do
			task.spawn(PlayerDataService.save, player)
		end
	end
end

return PlayerDataService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000003D"><Properties><string name="Name">QuestService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Quest board: daily and weekly challenges (Config/Quests). The same picks for everyone that
-- day / week; progress from encounters; rewards (Scrip + Materials) pay out on completion.
-- Published to the client as the JSON attribute "Quests".
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Quests = require(Shared.Config.Quests)
local Net = require(Shared.Net)

local QuestService = {}
local Services

local lastStats = {} -- [Player] = { runId, takedowns, kills, crates } already counted

local function hash(text)
	local h = 0
	for i = 1, #text do
		h = (h * 31 + string.byte(text, i)) % 2147483647
	end
	return h
end

local function pick(pool, count, seedText)
	local rng = Random.new(hash(seedText))
	local ids = {}
	for _, q in pool do
		table.insert(ids, q)
	end
	for i = #ids, 2, -1 do
		local j = rng:NextInteger(1, i)
		ids[i], ids[j] = ids[j], ids[i]
	end
	local out = {}
	for i = 1, math.min(count, #ids) do
		table.insert(out, { id = ids[i].id, p = 0, done = false })
	end
	return out
end

local function keys()
	local now = os.time()
	local day = os.date("!%Y-%m-%d", now)
	local week = "W" .. tostring(math.floor((now / 86400 + 3) / 7)) -- weeks start Monday (UTC)
	return day, week
end

local function find(pool, id)
	for _, q in pool do
		if q.id == id then
			return q
		end
	end
	return nil
end

-- Rolls over to today's / this week's quests when needed. Returns the state table.
local function state(player)
	local data = Services.PlayerDataService.get(player)
	if not data then
		return nil
	end
	data.quests = data.quests or {}
	local q = data.quests
	local day, week = keys()
	if q.day ~= day then
		q.day = day
		q.daily = pick(Quests.Daily, Quests.DailyCount, "daily" .. day)
	end
	if q.week ~= week then
		q.week = week
		q.weekly = pick(Quests.Weekly, Quests.WeeklyCount, "weekly" .. week)
	end
	return q
end

local function publish(player)
	local q = state(player)
	if not q then
		return
	end
	local out = {}
	for _, group in { { "daily", Quests.Daily, q.daily }, { "weekly", Quests.Weekly, q.weekly } } do
		for _, entry in group[3] do
			local def = find(group[2], entry.id)
			if def then
				table.insert(out, {
					kind = group[1],
					name = def.name,
					desc = def.desc:format(def.target),
					p = math.min(entry.p, def.target),
					target = def.target,
					done = entry.done,
					reward = ("%d Scrip · %d Materials"):format(def.scrip, def.materials),
				})
			end
		end
	end
	player:SetAttribute("Quests", HttpService:JSONEncode(out))
end

local function add(player, stat, amount)
	if amount <= 0 then
		return
	end
	local q = state(player)
	if not q then
		return
	end
	for _, group in { { Quests.Daily, q.daily }, { Quests.Weekly, q.weekly } } do
		for _, entry in group[2] do
			local def = find(group[1], entry.id)
			if def and def.stat == stat and not entry.done then
				entry.p += amount
				if entry.p >= def.target then
					entry.done = true
					Services.PlayerDataService.addScrip(player, def.scrip)
					Services.PlayerDataService.addMaterials(player, def.materials)
					Net.notify(player, "Toast", { text = ("Quest complete: %s  (+%d Scrip, +%d Materials)"):format(def.name, def.scrip, def.materials) })
				end
			end
		end
	end
end

-- Called by MatchService at the end of every encounter.
function QuestService.onEncounterEnd(player, stats, win, enc, runOver)
	local session = Services.CharacterService.getSession(player)
	local runId = session and session.runId or "none"
	local last = lastStats[player]
	if not last or last.runId ~= runId then
		last = { runId = runId, takedowns = 0, kills = 0, crates = 0 }
		lastStats[player] = last
	end
	-- run stats accumulate over a crossing: count only what's new since the last encounter
	add(player, "takedowns", (stats.takedowns or 0) - last.takedowns)
	add(player, "kills", (stats.kills or 0) - last.kills)
	add(player, "objectives", (stats.crates or 0) - last.crates)
	last.takedowns, last.kills, last.crates = stats.takedowns or 0, stats.kills or 0, stats.crates or 0
	if win then
		add(player, "wins", 1)
		if (stats.detectionsThisEncounter or 0) == 0 then
			add(player, "unseenWins", 1)
		end
		if enc and enc.finale then
			add(player, "crossings", 1)
			add(player, "breakwater", 1)
		end
	end
	publish(player)
	assert(runOver ~= nil or true)
end

function QuestService.init(registry)
	Services = registry
end

function QuestService.start()
	local function onJoin(player)
		task.spawn(function()
			if Services.PlayerDataService.waitFor(player, 20) then
				publish(player)
			end
		end)
	end
	Players.PlayerAdded:Connect(onJoin)
	for _, p in Players:GetPlayers() do
		onJoin(p)
	end
	Players.PlayerRemoving:Connect(function(p)
		lastStats[p] = nil
	end)
	-- roll over at midnight UTC for anyone still playing
	while true do
		task.wait(300)
		for _, p in Players:GetPlayers() do
			publish(p)
		end
	end
end

return QuestService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000003E"><Properties><string name="Name">RewardsService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Daily login streak (claimed automatically when you join each UTC day) and the Logbook:
-- torn pages placed on missions; reading one keeps it, and every few pages pays out.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Rewards = require(Shared.Config.Rewards)
local Net = require(Shared.Net)

local RewardsService = {}
local Services

local function dayNumber()
	return math.floor(os.time() / 86400)
end

local function grant(player, data, g)
	if g.scrip then
		Services.PlayerDataService.addScrip(player, g.scrip)
	end
	if g.materials then
		Services.PlayerDataService.addMaterials(player, g.materials)
	end
	for kind, n in g.tokens or {} do
		Services.PlayerDataService.addTokens(player, kind, n)
	end
	for kitId, n in g.kit or {} do
		data.kit = data.kit or {}
		data.kit[kitId] = (data.kit[kitId] or 0) + n
	end
	Services.PlayerDataService.publish(player)
end

local function publish(player, data)
	player:SetAttribute("Streak", data.streak or 0)
	player:SetAttribute("Pages", HttpService:JSONEncode(data.pages or {}))
end

function RewardsService.claimDaily(player)
	local data = Services.PlayerDataService.get(player)
	if not data then
		return
	end
	local today = dayNumber()
	if data.lastLoginDay == today then
		publish(player, data)
		return
	end
	local streak = (data.lastLoginDay == today - 1) and ((data.streak or 0) % #Rewards.Streak) + 1 or 1
	data.lastLoginDay = today
	data.streak = streak
	local reward = Rewards.Streak[streak]
	grant(player, data, reward.grant)
	publish(player, data)
	task.spawn(Services.PlayerDataService.save, player)
	Net.notify(player, "DailyReward", { day = streak, text = reward.text })
end

-- A page was picked up on a mission.
function RewardsService.findPage(player, pageId)
	local data = Services.PlayerDataService.get(player)
	local page = Rewards.page(pageId)
	if not data or not page then
		return
	end
	data.pages = data.pages or {}
	if data.pages[pageId] then
		Net.notify(player, "Toast", { text = "You've read this page before: " .. page.title })
		return
	end
	data.pages[pageId] = true
	local count = 0
	for _ in data.pages do
		count += 1
	end
	local text = ("Logbook page found (%d/%d): %s"):format(count, #Rewards.Pages, page.title)
	if count % Rewards.PageReward.every == 0 then
		grant(player, data, { scrip = Rewards.PageReward.scrip, materials = Rewards.PageReward.materials })
		text ..= ("  ·  +%d Scrip, +%d Materials"):format(Rewards.PageReward.scrip, Rewards.PageReward.materials)
	end
	publish(player, data)
	Net.notify(player, "Toast", { text = text })
	Net.notify(player, "PageFound", { id = pageId })
end

-- Which pages to put on the next mission: ones nobody in the crew has yet, if possible.
function RewardsService.pickPages(rng, count)
	local missing = {}
	local owned = {}
	for _, p in Players:GetPlayers() do
		local data = Services.PlayerDataService.get(p)
		for id in (data and data.pages) or {} do
			owned[id] = (owned[id] or 0) + 1
		end
	end
	for _, page in Rewards.Pages do
		table.insert(missing, { id = page.id, have = owned[page.id] or 0, r = rng:NextNumber() })
	end
	table.sort(missing, function(a, b)
		if a.have ~= b.have then
			return a.have < b.have
		end
		return a.r < b.r
	end)
	local out = {}
	for i = 1, math.min(count, #missing) do
		table.insert(out, missing[i].id)
	end
	return out
end

function RewardsService.init(registry)
	Services = registry
end

function RewardsService.start()
	local function onPlayer(player)
		task.spawn(function()
			if Services.PlayerDataService.waitFor(player, 20) then
				task.wait(4) -- let them see the deck first
				if player.Parent then
					RewardsService.claimDaily(player)
				end
			end
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in Players:GetPlayers() do
		onPlayer(p)
	end
end

return RewardsService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000003F"><Properties><string name="Name">SpinService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The Lucky Spin: one free spin per UTC day, extra spins from Spin tokens (Robux or won).
-- The server picks the prize; the client only animates to it. Odds: Config/Spin (shown in UI).
local Players = game:GetService("Players")
local PolicyService = game:GetService("PolicyService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Spin = require(Shared.Config.Spin)
local Quartermaster = require(Shared.Config.Quartermaster)
local Weapons = require(Shared.Config.Weapons)
local Net = require(Shared.Net)

local SpinService = {}
local Services
local rng = Random.new()
local busy = {}

local TOTAL = 0
for _, p in Spin.Prizes do
	TOTAL += p.weight
end

local function today()
	return os.date("!%Y-%m-%d")
end

-- Unix time of the next 00:00 UTC (os.time() is UTC seconds).
local function nextReset()
	local now = os.time()
	return now - now % 86400 + 86400
end

-- Players in regions where paid random items are restricted can't buy spins.
function SpinService.paidRestricted(player)
	local cached = player:GetAttribute("PaidSpinRestricted")
	if cached ~= nil then
		return cached
	end
	local restricted = true -- safest default if the policy can't be read
	local ok, info = pcall(function()
		return PolicyService:GetPolicyInfoForPlayerAsync(player)
	end)
	if ok and info then
		restricted = info.ArePaidRandomItemsRestricted == true
	end
	player:SetAttribute("PaidSpinRestricted", restricted)
	return restricted
end

function SpinService.publish(player)
	local data = Services.PlayerDataService.get(player)
	if not data then
		return
	end
	player:SetAttribute("FreeSpinReady", data.spinDay ~= today())
	player:SetAttribute("NextFreeSpinAt", nextReset())
end

local function pick()
	local roll = rng:NextInteger(1, TOTAL)
	for i, p in Spin.Prizes do
		roll -= p.weight
		if roll <= 0 then
			return i, p
		end
	end
	return 1, Spin.Prizes[1]
end

local function grant(player, data, prize)
	local g = prize.grant
	local detail
	if g.gun then
		-- a real gun: unlock one you don't have yet (Scrip if you own them all)
		data.guns = data.guns or { revolver = true }
		local locked = {}
		for _, gun in Quartermaster.Guns do
			if not data.guns[gun.id] then
				table.insert(locked, gun.id)
			end
		end
		if #locked > 0 then
			local id = locked[rng:NextInteger(1, #locked)]
			data.guns[id] = true
			data.loadout = data.loadout or { long = "", pack = {} }
			if data.loadout.long == "" or data.loadout.long == nil then
				data.loadout.long = id -- holstered and ready for the next crossing
			end
			detail = Weapons.List[id].name .. " unlocked! Choose it at the Quartermaster."
		else
			Services.PlayerDataService.addScrip(player, 300)
			detail = "You own every gun: 300 Scrip instead."
		end
	elseif g.kit then
		detail = "Packed in your kit bag: you get it at the start of your next crossing."
	end
	if g.scrip then
		Services.PlayerDataService.addScrip(player, g.scrip)
	end
	if g.materials then
		Services.PlayerDataService.addMaterials(player, g.materials)
	end
	for kind, n in g.tokens or {} do
		Services.PlayerDataService.addTokens(player, kind, n)
	end
	for kitId, n in g.kit or {} do
		data.kit = data.kit or {}
		local have = data.kit[kitId] or 0
		if have >= Spin.MaxKitStack then
			Services.PlayerDataService.addScrip(player, 30) -- kit bag full: pay it out as Scrip
		else
			data.kit[kitId] = have + n
		end
	end
	Services.PlayerDataService.publish(player)
	return detail
end

function SpinService.spin(player)
	if busy[player] then
		return
	end
	local data = Services.PlayerDataService.get(player)
	if not data then
		return
	end
	local free = data.spinDay ~= today()
	if free then
		data.spinDay = today()
	elseif (data.tokens.spin or 0) > 0 then
		data.tokens.spin -= 1
	else
		if SpinService.paidRestricted(player) then
			Net.notify(player, "Toast", { text = "Your free spin is back at midnight (UTC)." })
		else
			Net.notify(player, "NeedProduct", { productKey = "LuckySpin" })
		end
		return
	end
	busy[player] = true
	local index, prize = pick()
	local detail = grant(player, data, prize)
	SpinService.publish(player)
	Services.AnalyticsHelper.economy(player, "source", 0, Enum.AnalyticsEconomyTransactionType.Gameplay.Name, "Spin_" .. prize.id)
	Net.notify(player, "SpinResult", { index = index, free = free, detail = detail })
	task.spawn(Services.PlayerDataService.save, player)
	task.delay(4, function()
		busy[player] = nil
	end)
end

function SpinService.init(registry)
	Services = registry
end

function SpinService.start()
	local function onPlayer(player)
		task.spawn(function()
			Services.PlayerDataService.waitFor(player, 20)
			SpinService.paidRestricted(player)
			SpinService.publish(player)
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in Players:GetPlayers() do
		onPlayer(p)
	end
	Players.PlayerRemoving:Connect(function(p)
		busy[p] = nil
	end)
	-- the free spin comes back at midnight UTC for players who stay online
	task.spawn(function()
		while true do
			task.wait(30)
			for _, p in Players:GetPlayers() do
				SpinService.publish(p)
			end
		end
	end)
	assert(Workspace)
end

return SpinService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000040"><Properties><string name="Name">WeaponService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Guns and the bow, fully server-authoritative:
--   * equip/holster (long gun on the back, sidearm on the hip; models replicate to everyone)
--   * fire: client sends only aim direction + whether it's aiming; the server applies spread
--     (hip/aim/moving/crouched + upgrades), raycasts, scores headshots, deals damage,
--     emits gunshot NOISE (stealth trade-off) and broadcasts shot FX to all clients
--   * reload from reserve ammo (timed; cancelled by swapping or going down)
--   * bow arrows are simulated projectiles with drop
-- Character attributes: Equipped (weapon id or ""), EquippedSlot, ReloadUntil (server time).
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Weapons = require(Shared.Config.Weapons)
local Upgrades = require(Shared.Config.Upgrades)
local WeaponModels = require(Shared.WeaponModels)
local Net = require(Shared.Net)
local Geometry = require(Shared.Util.Geometry)
local Sfx = require(Shared.Util.Sfx)

local WeaponService = {}
local Services

local rng = Random.new()
local models = {} -- [Player] = { long = Model?, sidearm = Model? }
local state = {} -- [Player] = { nextFireAt, equipReadyAt, reloadId, reloadSlot }

local MOD_DEFAULTS = {
	damageMult = 1, reloadMult = 1, noiseMult = 1, recoilMult = 1, spreadMult = 1,
	aimSpreadMult = 1, fireDelayMult = 1, magBonus = 0, aimFovMult = 1,
}

local function st(player)
	local s = state[player]
	if not s then
		s = { nextFireAt = 0, equipReadyAt = 0, reloadId = 0 }
		state[player] = s
	end
	return s
end

-- Combined modifiers from workbench upgrades for one weapon.
function WeaponService.mods(player, weaponId)
	local result = table.clone(MOD_DEFAULTS)
	local session = Services.CharacterService.getSession(player)
	local owned = session and session.run and session.run.weapons[weaponId]
	if owned then
		for _, upg in Upgrades.Weapon[weaponId] or {} do
			if owned[upg.id] then
				for key, value in upg.mods do
					if key == "magBonus" then
						result[key] += value
					else
						result[key] *= value
					end
				end
			end
		end
	end
	if session and session.mods then
		result.aimSpreadMult *= session.mods.aimSpreadMult
	end
	return result
end

function WeaponService.magSize(player, weaponId)
	local def = Weapons.List[weaponId]
	return def and (def.mag + WeaponService.mods(player, weaponId).magBonus) or 0
end

-- Replicates per-weapon stats the client needs (mag size, fov, recoil) as JSON.
function WeaponService.publishStats(player)
	local out = {}
	for slot, w in Services.InventoryService.weaponSlots(player) do
		local mods = WeaponService.mods(player, w.id)
		local def = Weapons.List[w.id]
		out[slot] = {
			id = w.id,
			mag = WeaponService.magSize(player, w.id),
			fov = def.aimFov * mods.aimFovMult,
			recoil = def.recoil * mods.recoilMult,
			spreadHip = def.spreadHip * mods.spreadMult,
			spreadAim = def.spreadAim * mods.spreadMult * mods.aimSpreadMult,
			fireDelay = def.fireDelay * mods.fireDelayMult,
		}
	end
	player:SetAttribute("WeaponStats", HttpService:JSONEncode(out))
end

-- Models ------------------------------------------------------------------------------------

local function mount(model, part0, offset)
	local grip = model.PrimaryPart
	local weld = grip:FindFirstChild("Mount")
	if not weld then
		weld = Instance.new("Weld")
		weld.Name = "Mount"
		weld.Parent = grip
	end
	weld.Part0 = part0
	weld.Part1 = grip
	weld.C0 = offset
	weld.C1 = CFrame.new()
end

local function placeModels(player, char, equippedSlot)
	local set = models[player]
	if not set then
		return
	end
	local hand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
	local back = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
	local hip = char:FindFirstChild("LowerTorso") or char:FindFirstChild("Torso")
	for slot, model in set do
		if slot == equippedSlot and hand then
			mount(model, hand, WeaponModels.HandOffset)
		elseif slot == "long" and back then
			mount(model, back, WeaponModels.BackOffset)
		elseif hip then
			mount(model, hip, WeaponModels.HipOffset)
		end
	end
end

function WeaponService.onSpawn(player, char)
	if models[player] then
		for _, m in models[player] do
			m:Destroy()
		end
	end
	models[player] = {}
	for slot, w in Services.InventoryService.weaponSlots(player) do
		local kit = "Weapon_" .. w.id
		local run = Services.CharacterService.getSession(player).run
		local skip = (w.id == "rifle" and not (run.weapons.rifle and run.weapons.rifle.scope)) and { Scope = true } or nil
		local model = Services.AssetService.hasKit(kit) and WeaponModels.build(w.id, Services.AssetService.part, Services.AssetService.meta(kit), skip) or WeaponModels.build(w.id)
		if model then
			model.Name = "Weapon_" .. slot
			model:PivotTo(char:GetPivot())
			model.Parent = char
			models[player][slot] = model
		end
	end
	char:SetAttribute("Equipped", "")
	char:SetAttribute("EquippedSlot", "none")
	char:SetAttribute("ReloadUntil", 0)
	placeModels(player, char, "none")
	local s = st(player)
	s.reloadId += 1
	s.nextFireAt = 0
	WeaponService.publishStats(player)
end

function WeaponService.muzzlePosition(player)
	local char = player.Character
	local slot = char and char:GetAttribute("EquippedSlot")
	local model = models[player] and models[player][slot]
	local muzzle = model and model.PrimaryPart and model.PrimaryPart:FindFirstChild("Muzzle")
	return muzzle and muzzle.WorldPosition or nil
end

-- Actions -----------------------------------------------------------------------------------

local function swapTime(player)
	local session = Services.CharacterService.getSession(player)
	local fast = session and session.run and session.run.general.holster
	return Weapons.SwapTime * (fast and 0.5 or 1)
end

function WeaponService.equip(player, slot)
	if slot ~= "long" and slot ~= "sidearm" and slot ~= "none" then
		return
	end
	local char = player.Character
	if not char then
		return
	end
	local session = Services.CharacterService.getSession(player)
	if session and (session.downed or session.out) then
		return
	end
	local weaponId = ""
	if slot ~= "none" then
		local w = Services.InventoryService.weapon(player, slot)
		if not w then
			return
		end
		weaponId = w.id
	end
	if char:GetAttribute("EquippedSlot") == slot then
		return
	end
	local s = st(player)
	s.reloadId += 1 -- cancel reload
	char:SetAttribute("ReloadUntil", 0)
	char:SetAttribute("Reloading", false)
	s.equipReadyAt = os.clock() + swapTime(player)
	char:SetAttribute("Equipped", weaponId)
	char:SetAttribute("EquippedSlot", slot)
	placeModels(player, char, slot)
end

function WeaponService.holster(player)
	WeaponService.equip(player, "none")
end

local function spreadDirection(dir, degrees)
	if degrees <= 0 then
		return dir
	end
	local angle = math.rad(degrees) * math.sqrt(rng:NextNumber())
	local roll = rng:NextNumber() * math.pi * 2
	local up = math.abs(dir.Y) > 0.98 and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0)
	local basis = CFrame.lookAt(Vector3.zero, dir, up)
	return (basis * CFrame.Angles(0, 0, roll) * CFrame.Angles(angle, 0, 0)).LookVector
end

local function excludeList(char)
	local list = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	if not table.find(list, char) then
		table.insert(list, char)
	end
	return list
end

-- Applies damage for a hit. Returns "enemy" | "world" | nil plus hit flags.
-- Damage by body zone (the head uses the weapon's headMult).
local ZONE_MULT = { torso = 1, arm = 0.7, leg = 0.75 }

local function applyHit(player, def, mods, result, distance, direction)
	if not result then
		return nil
	end
	local e = Services.EnemyService.fromInstance(result.Instance)
	if not e then
		local nest = result.Instance:FindFirstAncestor("Nest")
		if nest and nest:GetAttribute("NestHP") then
			local destroyed = Services.MatchService.damageNest(nest, def.damage * mods.damageMult, player)
			return "enemy", false, destroyed
		end
		return "world"
	end
	local zone = Services.EnemyService.zoneOf(result.Instance)
	local headshot = zone == "head"
	local headMult = 1 + (def.headMult - 1) * (e.cfg.headMultScale or 1)
	local damage = def.damage * mods.damageMult * (headshot and headMult or (ZONE_MULT[zone] or 1))
	if def.falloff then
		damage *= math.clamp(1 - (distance / def.range) * 0.6, 0.35, 1)
	end
	local killed = Services.EnemyService.damage(e, damage, player, headshot, {
		zone = zone,
		instance = result.Instance,
		direction = direction,
		position = result.Position,
		force = def.impact or 1,
	})
	return "enemy", headshot, killed
end

local function simulateArrow(player, def, mods, origin, direction, params)
	local position = origin
	local velocity = direction * def.projectile.speed
	local gravity = Vector3.new(0, -Workspace.Gravity * def.projectile.gravityScale, 0)
	local arrow = Instance.new("Part")
	arrow.Name = "Arrow"
	arrow.Anchored = true
	arrow.CanCollide = false
	arrow.CanQuery = false
	arrow.CanTouch = false
	arrow.Size = Vector3.new(0.06, 0.06, 1.6)
	arrow.Color = Color3.fromRGB(214, 206, 188)
	arrow.Material = Enum.Material.Wood
	arrow.CFrame = CFrame.lookAt(position, position + velocity)
	arrow.Parent = Workspace
	local travelled, age = 0, 0
	local conn
	conn = RunService.Heartbeat:Connect(function(dt)
		age += dt
		velocity += gravity * dt
		local step = velocity * dt
		local result = Workspace:Raycast(position, step, params)
		if result or travelled > def.range or age > 3 then
			conn:Disconnect()
			if result then
				arrow.CFrame = CFrame.lookAt(result.Position - step.Unit * 0.6, result.Position)
				local kind, headshot, killed = applyHit(player, def, mods, result, travelled, step.Unit)
				if kind ~= "enemy" then
					Services.PerceptionService.emitNoise(result.Position, 12, "impact", nil) -- arrows make a good distraction
				end
				if kind == "enemy" then
					Net.notify(player, "Hit", { headshot = headshot, kill = killed })
					arrow:Destroy()
				else
					task.delay(8, function()
						arrow:Destroy()
					end)
				end
				Net.notifyAll("Impact", { position = result.Position, kind = kind or "world" })
			else
				arrow:Destroy()
			end
			return
		end
		position += step
		travelled += step.Magnitude
		arrow.CFrame = CFrame.lookAt(position, position + velocity)
	end)
end

function WeaponService.reload(player, info)
	local char = info.char
	local slot = char:GetAttribute("EquippedSlot")
	local w = Services.InventoryService.weapon(player, slot)
	if not w then
		return
	end
	local def = Weapons.List[w.id]
	local size = WeaponService.magSize(player, w.id)
	local s = st(player)
	if w.mag >= size or Services.InventoryService.count(player, def.ammo) < 1 then
		return
	end
	if (char:GetAttribute("ReloadUntil") or 0) > Workspace:GetServerTimeNow() or char:GetAttribute("Reloading") then
		return
	end
	local mods = WeaponService.mods(player, w.id)
	if def.perShell then
		-- one shell at a time; firing (or swapping) stops the reload with what's loaded
		s.reloadId += 1
		local id = s.reloadId
		local shellTime = def.reload / def.mag * mods.reloadMult
		char:SetAttribute("Reloading", true)
		task.spawn(function()
			while s.reloadId == id and char.Parent do
				task.wait(shellTime)
				local session = Services.CharacterService.getSession(player)
				if s.reloadId ~= id or not session or session.downed or session.out or char:GetAttribute("EquippedSlot") ~= slot then
					break
				end
				if w.mag >= size or not Services.InventoryService.take(player, def.ammo, 1) then
					break
				end
				Services.InventoryService.setMag(player, slot, w.mag + 1)
				Sfx.at(info.root.Position, "Reload", 0.3, 25, 0.1)
				if w.mag >= size then
					break
				end
			end
			if s.reloadId == id then
				char:SetAttribute("Reloading", false)
			end
		end)
		return
	end
	local duration = def.reload * mods.reloadMult
	s.reloadId += 1
	local id = s.reloadId
	char:SetAttribute("ReloadUntil", Workspace:GetServerTimeNow() + duration)
	char:SetAttribute("ReloadDur", duration) -- lets every client play the reload in step
	Sfx.at(info.root.Position, "Reload", 0.4, 30)
	task.delay(duration, function()
		if s.reloadId ~= id or not char.Parent then
			return
		end
		char:SetAttribute("ReloadUntil", 0)
		local session = Services.CharacterService.getSession(player)
		if not session or session.downed or session.out or char:GetAttribute("EquippedSlot") ~= slot then
			return
		end
		local need = size - w.mag
		local have = Services.InventoryService.count(player, def.ammo)
		local moved = math.min(need, have)
		if moved > 0 and Services.InventoryService.take(player, def.ammo, moved) then
			Services.InventoryService.setMag(player, slot, w.mag + moved)
		end
	end)
end

function WeaponService.fire(player, info, direction, aiming)
	if not Geometry.isSaneVector(direction, 2) or direction.Magnitude < 0.5 then
		return
	end
	direction = direction.Unit
	local char = info.char
	local slot = char:GetAttribute("EquippedSlot")
	local w = Services.InventoryService.weapon(player, slot)
	if not w then
		return
	end
	local s = st(player)
	local now = os.clock()
	if now < s.nextFireAt or now < s.equipReadyAt then
		return
	end
	char:SetAttribute("ShotAt", Workspace:GetServerTimeNow()) -- muzzle flash gives away a hiding spot
	if (char:GetAttribute("ReloadUntil") or 0) > Workspace:GetServerTimeNow() then
		return
	end
	if os.clock() < info.session.busyUntil then
		return
	end
	local def = Weapons.List[w.id]
	local mods = WeaponService.mods(player, w.id)
	if w.mag < 1 then
		Sfx.at(info.root.Position, "DryFire", 0.4, 20)
		WeaponService.reload(player, info)
		return
	end
	if char:GetAttribute("Reloading") then
		s.reloadId += 1 -- fire interrupts a shell-by-shell reload
		char:SetAttribute("Reloading", false)
	end
	s.nextFireAt = now + def.fireDelay * mods.fireDelayMult * 0.9 -- small latency allowance
	Services.InventoryService.setMag(player, slot, w.mag - 1)

	-- spread
	local spread = (aiming == true) and def.spreadAim * mods.spreadMult * mods.aimSpreadMult or def.spreadHip * mods.spreadMult
	local speed = Geometry.flat(info.root.AssemblyLinearVelocity).Magnitude
	if speed > 2 then
		spread += def.moveSpread * math.clamp(speed / 14, 0, 1.5)
	end
	if char:GetAttribute("Stance") == "Crouch" then
		spread *= 0.8
	end

	local head = char:FindFirstChild("Head")
	local origin = head and head.Position or info.root.Position + Vector3.new(0, 1.5, 0)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = excludeList(char)
	local muzzle = WeaponService.muzzlePosition(player) or origin

	Services.PerceptionService.emitNoise(origin, def.noise * mods.noiseMult, "gunshot", player)
	-- the gunshot sound is played by every client (instantly for the shooter) from the Shot event

	if def.projectile then
		simulateArrow(player, def, mods, origin + direction * 0.8, spreadDirection(direction, spread), params)
		Net.notifyAll("Shot", { shooter = player.UserId, weapon = w.id, from = muzzle, hits = {}, quiet = mods.noiseMult < 1 })
	else
		local hits, anyHead, anyKill, anyEnemy = {}, false, false, false
		local impactNoise = nil
		for _ = 1, def.pellets do
			local dir = spreadDirection(direction, spread)
			local result = Workspace:Raycast(origin, dir * def.range, params)
			local hitPos = result and result.Position or origin + dir * def.range
			local kind, headshot, killed = applyHit(player, def, mods, result, (hitPos - origin).Magnitude, dir)
			table.insert(hits, { position = hitPos, kind = kind or "none" })
			if kind == "world" then
				impactNoise = hitPos -- stray rounds clatter: Hushed near the impact come to look
			end
			if kind == "enemy" then
				anyEnemy = true
				anyHead = anyHead or headshot
				anyKill = anyKill or killed
			end
		end
		if anyEnemy then
			Net.notify(player, "Hit", { headshot = anyHead, kill = anyKill })
		end
		if impactNoise then
			Services.PerceptionService.emitNoise(impactNoise, 14, "impact", nil)
		end
		Net.notifyAll("Shot", { shooter = player.UserId, weapon = w.id, from = muzzle, hits = hits, quiet = mods.noiseMult < 1 })
	end

	if def.autoReload and w.mag <= 0 then
		task.delay(def.fireDelay * mods.fireDelayMult * 0.5, function()
			local liveInfo = Services.MatchService.getActiveInfo(player)
			if liveInfo then
				WeaponService.reload(player, liveInfo)
			end
		end)
	end
end

function WeaponService.onDowned(player)
	local s = st(player)
	s.reloadId += 1
	local char = player.Character
	if char then
		char:SetAttribute("ReloadUntil", 0)
		char:SetAttribute("Equipped", "")
		char:SetAttribute("EquippedSlot", "none")
		placeModels(player, char, "none")
	end
end

function WeaponService.init(registry)
	Services = registry
end

function WeaponService.start()
	Players.PlayerRemoving:Connect(function(player)
		models[player] = nil
		state[player] = nil
	end)
	Net.onServer("Look", 12, function(player, pitch)
		if type(pitch) ~= "number" or pitch ~= pitch then
			return
		end
		local char = player.Character
		if char then
			char:SetAttribute("AimPitch", math.floor(math.clamp(pitch, -1.3, 1.3) * 100) / 100)
		end
	end)
end

return WeaponService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000041"><Properties><string name="Name">WorkbenchService</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The Meridian's workbench, used between encounters (Planning phase) with Salvage found in
-- the run: weapon parts, satchel upgrades, and your character's other perks.
-- Upgrades last for the current crossing only (roguelike), like everything in the satchel.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Characters = require(Shared.Config.Characters)
local Upgrades = require(Shared.Config.Upgrades)
local Net = require(Shared.Net)

local WorkbenchService = {}
local Services

local function toast(player, text)
	Net.notify(player, "Toast", { text = text })
end

local function cost(player, base)
	local discount = Services.PlayerDataService.hasRepair(player, "workshop") and 0.75 or 1
	return math.ceil(base * discount)
end

local function canUse(player)
	local session = Services.CharacterService.getSession(player)
	if not session or not session.runId or not Services.MatchService.isPlanning() then
		toast(player, "The workbench is used between encounters during a crossing")
		return nil
	end
	return session
end

local function pay(player, amount)
	if Services.InventoryService.spendSalvage(player, amount) then
		return true
	end
	toast(player, ("Need %d Salvage"):format(amount))
	return false
end

function WorkbenchService.costFor(player, base)
	return cost(player, base)
end

function WorkbenchService.buyWeapon(player, weaponId, upgradeId)
	local session = canUse(player)
	if not session or type(weaponId) ~= "string" or type(upgradeId) ~= "string" then
		return
	end
	local owns = false
	for _, w in Services.InventoryService.weaponSlots(player) do
		if w.id == weaponId then
			owns = true
		end
	end
	if not owns then
		return
	end
	local upgrade
	for _, u in Upgrades.Weapon[weaponId] or {} do
		if u.id == upgradeId then
			upgrade = u
		end
	end
	session.run.weapons[weaponId] = session.run.weapons[weaponId] or {}
	if not upgrade or session.run.weapons[weaponId][upgradeId] then
		return
	end
	if pay(player, cost(player, upgrade.cost)) then
		session.run.weapons[weaponId][upgradeId] = true
		Services.CharacterService.publishRun(player)
		Services.WeaponService.publishStats(player)
		toast(player, "Fitted: " .. upgrade.name)
	end
end

function WorkbenchService.buyGeneral(player, upgradeId)
	local session = canUse(player)
	if not session or type(upgradeId) ~= "string" then
		return
	end
	for _, u in Upgrades.General do
		if u.id == upgradeId and not session.run.general[upgradeId] then
			if pay(player, cost(player, u.cost)) then
				session.run.general[upgradeId] = true
				Services.CharacterService.publishRun(player)
				Services.InventoryService.publish(player)
				toast(player, "Upgraded: " .. u.name)
			end
			return
		end
	end
end

function WorkbenchService.buyPerk(player, perkId)
	local session = canUse(player)
	if not session or type(perkId) ~= "string" or perkId == session.perkId or session.run.perks[perkId] then
		return
	end
	for _, perk in Characters.List[session.charId].perks do
		if perk.id == perkId then
			if pay(player, cost(player, Upgrades.PerkCost)) then
				session.run.perks[perkId] = true
				Services.CharacterService.refreshMods(player)
				Services.InventoryService.publish(player)
				toast(player, "Learned: " .. perk.name)
			end
			return
		end
	end
end

function WorkbenchService.init(registry)
	Services = registry
end

return WorkbenchService
]]></ProtectedString></Properties></Item>
</Item>
</Item>
</Item>
<Item class="StarterPlayer" referent="RBX00000069"><Properties><string name="Name">StarterPlayer</string><bool name="EnableMouseLockOption">false</bool><bool name="LoadCharacterAppearance">false</bool><float name="CharacterJumpPower">0</float></Properties><Item class="StarterPlayerScripts" referent="RBX00000068"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX00000067"><Properties><string name="Name">Client</string></Properties><Item class="Folder" referent="RBX00000051"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX00000045"><Properties><string name="Name">ActionController</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Input bindings (keyboard/mouse, gamepad, touch buttons) -> intents sent to the server.
--
--   Keyboard/mouse                     Gamepad (Xbox names; PlayStation in brackets)
--   WASD move, Shift sprint            L-stick, L3 sprint (toggle)
--   (Shift / L3 while aiming: hold breath to steady your aim)
--   C / Ctrl crouch (hold: prone)      B [Circle] crouch (hold: prone)
--   RMB aim, LMB fire                  L2 aim, R2 fire (aim assist while aiming)
--   R reload (Second Wind if downed)   R1 reload (Second Wind if downed)
--   F Quieting / grab / melee          X [Square] (reloads when nobody is in reach)
--   Space jump / vault, Alt dodge      A jump / vault (or interact), L1 dodge
--   G throw, Q ability                 Y [Triangle] tap: throw · hold: ability
--   1 long gun, 2 sidearm, 3 holster   D-pad right tap: next weapon · hold: holster
--   Z next throwable, 4 backpack gun   D-pad down tap: next throwable · hold: backpack gun
--   T torch, V ammo cache              D-pad left tap: torch · hold: ammo cache
--   H heal, B resupply                 D-pad up tap: heal · hold: resupply
--   X swap shoulder, Tab / I satchel   R3 shoulder, View [Share/Touchpad] satchel
--   P settings, F1 controls            in the satchel; A interacts, B closes menus
local ContextActionService = game:GetService("ContextActionService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local State = require(script.Parent.Parent.State)

local ActionController = {}
local Controllers

local Begin = Enum.UserInputState.Begin
local End = Enum.UserInputState.End
local Sink = Enum.ContextActionResult.Sink
local Pass = Enum.ContextActionResult.Pass

local function act(name, payload)
	Net.event("Action"):FireServer(name, payload)
end

local function isTouch(input)
	return input and input.UserInputType == Enum.UserInputType.Touch
end

local function canAct()
	return State.character ~= nil and not State.uiOpen() and not State.downed
end

local bindUnsafe
local function noteInput(what)
	State.inputLog = State.inputLog or {}
	table.insert(State.inputLog, ("%s action %s"):format(os.date("%H:%M:%S"), what))
	while #State.inputLog > 12 do
		table.remove(State.inputLog, 1)
	end
end

local touchLayout = {
	Fire = { title = "Fire", pos = UDim2.new(1, -95, 1, -230) },
	Aim = { title = "Aim", pos = UDim2.new(1, -170, 1, -230) },
	Reload = { title = "Reload", pos = UDim2.new(1, -245, 1, -230) },
	Quiet = { title = "Quiet", pos = UDim2.new(1, -95, 1, -160) },
	Throw = { title = "Throw", pos = UDim2.new(1, -170, 1, -160) },
	Ability = { title = "Skill", pos = UDim2.new(1, -245, 1, -160) },
	Crouch = { title = "Crouch", pos = UDim2.new(1, -95, 1, -300) },
	Sprint = { title = "Sprint", pos = UDim2.new(1, -170, 1, -300) },
	Weapon = { title = "Weapon", pos = UDim2.new(1, -245, 1, -300) },
	Heal = { title = "Heal", pos = UDim2.new(1, -320, 1, -230) },
	Satchel = { title = "Bag", pos = UDim2.new(1, -320, 1, -300) },
	Dodge = { title = "Dodge", pos = UDim2.new(1, -320, 1, -160) },
	Jump = { title = "Jump", pos = UDim2.new(1, -395, 1, -230) },
}

local function bind(name, handler, ...)
	local inputs = { ... }
	local ok, err = pcall(function()
		bindUnsafe(name, handler, table.unpack(inputs))
	end)
	if not ok then
		-- one bad binding must never stop the ones after it (satchel, sprint, F1, settings...)
		warn("[ActionController] could not bind " .. name .. ": " .. tostring(err))
	end
end

bindUnsafe = function(name, handler, ...)
	local touch = touchLayout[name] ~= nil
	-- above Roblox's own scripts (default camera input grabs right-click, the player list
	-- grabs Tab), otherwise aiming and the satchel never receive their keys
	ContextActionService:BindActionAtPriority(name, function(_, inputState, input)
		if inputState == Begin then
			noteInput(name .. (input and input.KeyCode ~= Enum.KeyCode.Unknown and (" (" .. input.KeyCode.Name .. ")") or (input and (" (" .. input.UserInputType.Name .. ")") or "")))
		end
		return handler(inputState, input) or Sink
	end, touch, Enum.ContextActionPriority.High.Value + 100, ...)
	if touch then
		ContextActionService:SetTitle(name, touchLayout[name].title)
		ContextActionService:SetPosition(name, touchLayout[name].pos)
	end
end

-- Gamepad buttons with two jobs: tap for one action, hold (0.4 s) for the other.
local function bindPad(name, key, onTap, onHold)
	local pressedAt, press = 0, 0
	bind(name, function(state)
		if state == Begin then
			pressedAt = os.clock()
			press += 1
			local mine = press
			task.delay(0.4, function()
				if mine == press and pressedAt > 0 then
					pressedAt = 0
					onHold()
				end
			end)
		elseif state == End and pressedAt > 0 then
			pressedAt = 0
			onTap()
		end
	end, key)
end

local function enemyNearby(radius)
	local enemies = Workspace:FindFirstChild("Enemies")
	local root = State.root
	if not enemies or not root then
		return false
	end
	for _, model in enemies:GetChildren() do
		local r = model:FindFirstChild("HumanoidRootPart")
		if r and model:GetAttribute("State") ~= "Dispersed" and (r.Position - root.Position).Magnitude <= radius then
			return true
		end
	end
	return false
end

function ActionController.init(registry)
	Controllers = registry
end

function ActionController.start()
	local Movement = Controllers.MovementController
	local Weapon = Controllers.WeaponController

	bind("Aim", function(state, input)
		if state == End and not isTouch(input) then
			Movement.setAim(false)
			return
		end
		if not canAct() then
			return Pass
		end
		if isTouch(input) then
			if state == Begin then
				Movement.setAim(not State.aiming)
			end
		elseif state == Begin then
			Movement.setAim(true)
		end
	end, Enum.UserInputType.MouseButton2, Enum.KeyCode.ButtonL2)

	bind("Fire", function(state)
		if not canAct() then
			return Pass
		end
		if state == Begin then
			Weapon.fire()
		end
	end, Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2)

	bind("Reload", function(state)
		if state ~= Begin or not State.character then
			return
		end
		if State.downed then
			act("SecondWind")
		elseif canAct() then
			Weapon.reload()
		end
	end, Enum.KeyCode.R, Enum.KeyCode.ButtonR1)

	bind("Quiet", function(state, input)
		if state ~= Begin or not canAct() then
			return
		end
		local isPad = input and input.KeyCode == Enum.KeyCode.ButtonX
		local _, equipped = Weapon.current()
		if isPad and equipped and not enemyNearby(6) then
			Weapon.reload() -- contextual: no Hushed in reach, so X reloads
		else
			act("Quiet")
		end
	end, Enum.KeyCode.F, Enum.KeyCode.ButtonX)

	bind("Equip1", function(state)
		if state == Begin and canAct() then
			Weapon.equip("long")
		end
	end, Enum.KeyCode.One)
	bind("Equip2", function(state)
		if state == Begin and canAct() then
			Weapon.equip("sidearm")
		end
	end, Enum.KeyCode.Two)
	bind("Holster", function(state)
		if state == Begin and canAct() then
			act("Equip", "none")
		end
	end, Enum.KeyCode.Three)
	bind("Weapon", function(state)
		if state == Begin and canAct() then
			Weapon.cycleWeapon()
		end
	end)

	bind("Throw", function(state)
		if state == Begin and canAct() then
			Weapon.throw()
		end
	end, Enum.KeyCode.G)
	bind("NextThrowable", function(state)
		if state == Begin and State.character then
			Weapon.cycleThrowable()
		end
	end, Enum.KeyCode.Z)

	bind("Dodge", function(state)
		if state == Begin and canAct() then
			Movement.dodge()
		end
	end, Enum.KeyCode.LeftAlt, Enum.KeyCode.ButtonL1)
	bind("Jump", function(state)
		if state == Begin and canAct() then
			Movement.jumpOrVault()
		end
	end, Enum.KeyCode.Space)

	bind("Ability", function(state)
		if state == Begin and canAct() then
			act("Ability")
		end
	end, Enum.KeyCode.Q)
	bind("Heal", function(state)
		if state == Begin and canAct() then
			act("Heal")
		end
	end, Enum.KeyCode.H)
	bind("Torch", function(state)
		if state == Begin and State.character and not State.downed then
			act("Torch")
		end
	end, Enum.KeyCode.T)

	-- Interact on a controller: Cross / A presses the nearest prompt you can see, whatever else
	-- might be listening to that button (some consoles never delivered it to the prompt).
	local ProximityPromptService = game:GetService("ProximityPromptService")
	local shown = {}
	ProximityPromptService.PromptShown:Connect(function(p)
		shown[p] = true
	end)
	ProximityPromptService.PromptHidden:Connect(function(p)
		shown[p] = nil
	end)
	local holding = nil
	local lastTap = setmetatable({}, { __mode = "k" })
	local function nearestPrompt()
		local root = State.root
		if not root then
			return nil
		end
		local best, bestD = nil, math.huge
		for p in shown do
			local part = p.Parent
			local pos = part and (part:IsA("BasePart") and part.Position or (part:IsA("Attachment") and part.WorldPosition))
			if pos and p.Enabled then
				local d = (pos - root.Position).Magnitude
				if d <= p.MaxActivationDistance + 1 and d < bestD then
					best, bestD = p, d
				end
			end
		end
		return best
	end
	bind("PadInteract", function(state)
		if State.uiOpen() then
			return Pass -- menus: A presses the selected button
		end
		if state == Begin then
			local p = nearestPrompt()
			if not p then
				if canAct() then
					Movement.jumpOrVault() -- A with nothing to interact with: jump / vault
				end
				return Sink
			end
			if p.HoldDuration <= 0 then
				-- a tap prompt: fire it once (never twice in a row: that is how an item
				-- could be taken twice)
				if os.clock() - (lastTap[p] or -1) > 0.4 then
					lastTap[p] = os.clock()
					p:InputHoldBegin()
					task.defer(function()
						p:InputHoldEnd()
					end)
				end
				return Sink
			end
			holding = p
			p:InputHoldBegin()
		elseif state == End and holding then
			holding:InputHoldEnd()
			holding = nil
		end
	end, Enum.KeyCode.ButtonA)

	-- gamepad: buttons with a tap and a hold action
	bindPad("PadY", Enum.KeyCode.ButtonY, function()
		if canAct() then
			Weapon.throw()
		end
	end, function()
		if canAct() then
			act("Ability")
		end
	end)
	bindPad("PadRight", Enum.KeyCode.DPadRight, function()
		if canAct() then
			Weapon.cycleWeapon()
		end
	end, function()
		if canAct() then
			act("Equip", "none")
		end
	end)
	bindPad("PadDown", Enum.KeyCode.DPadDown, function()
		if State.character then
			Weapon.cycleThrowable()
		end
	end, function()
		if State.character and not State.downed and not State.uiOpen() then
			act("SwapPack", 1)
		end
	end)
	bindPad("PadLeft", Enum.KeyCode.DPadLeft, function()
		if State.character and not State.downed then
			act("Torch")
		end
	end, function()
		if canAct() then
			act("AmmoCache")
		end
	end)
	bindPad("PadUp", Enum.KeyCode.DPadUp, function()
		if canAct() then
			act("Heal")
		end
	end, function()
		if canAct() then
			act("Resupply")
		end
	end)

	-- tap: crouch / stand (or up from prone);  hold: go prone
	local crouchPressedAt, crouchPress = 0, 0
	bind("Crouch", function(state, input)
		if not State.character or State.uiOpen() then
			return Pass -- B closes menus while one is open
		end
		if isTouch(input) then
			if state == Begin then
				Movement.toggleCrouch()
			end
			return
		end
		if state == Begin then
			crouchPressedAt = os.clock()
			crouchPress += 1
			local press = crouchPress
			task.delay(0.42, function()
				if press == crouchPress and crouchPressedAt > 0 and not State.prone then
					crouchPressedAt = 0
					Movement.setProne(true)
				end
			end)
		elseif state == End and crouchPressedAt > 0 then
			crouchPressedAt = 0
			Movement.toggleCrouch()
		end
	end, Enum.KeyCode.C, Enum.KeyCode.LeftControl, Enum.KeyCode.ButtonB)


	bind("Sprint", function(state, input)
		if not State.character then
			return Pass
		end
		if State.aiming and not isTouch(input) then
			Controllers.CameraController.holdBreath(state == Begin)
			return
		end
		local toggle = isTouch(input) or (input and input.KeyCode == Enum.KeyCode.ButtonL3)
		if toggle then
			if state == Begin then
				Movement.setSprint(not State.sprinting, true)
			end
		elseif state == Begin then
			Movement.setSprint(true, false)
		elseif state == End then
			Movement.setSprint(false, false)
		end
	end, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3)

	bind("Shoulder", function(state)
		if state == Begin then
			State.shoulder = -State.shoulder
		end
	end, Enum.KeyCode.X)

	-- Listen: hold L (keyboard) or hold R3 (controller; a quick tap still swaps shoulder)
	local Listen = Controllers.ListenController
	bind("Listen", function(state)
		if state == Begin and canAct() then
			Listen.set(true)
		elseif state == End then
			Listen.set(false)
		end
	end, Enum.KeyCode.L)
	local r3Down, r3Press = 0, 0
	bind("PadR3", function(state)
		if state == Begin then
			r3Down = os.clock()
			r3Press += 1
			local mine = r3Press
			task.delay(0.3, function()
				if mine == r3Press and r3Down > 0 and canAct() then
					Listen.set(true)
				end
			end)
		elseif state == End then
			local held = os.clock() - r3Down
			r3Down = 0
			if State.listening then
				Listen.set(false)
			elseif held < 0.3 then
				State.shoulder = -State.shoulder
			end
		end
	end, Enum.KeyCode.ButtonR3)

	bind("Resupply", function(state)
		if state == Begin and canAct() then
			act("Resupply")
		end
	end, Enum.KeyCode.B)

	bind("Backpack", function(state)
		if state == Begin and State.character and not State.downed and not State.uiOpen() then
			act("SwapPack", 1) -- dig the backpack gun out (slow; you can't shoot meanwhile)
		end
	end, Enum.KeyCode.Four)

	bind("AmmoCache", function(state)
		if state == Begin and canAct() then
			act("AmmoCache")
		end
	end, Enum.KeyCode.V)
end

function ActionController.sendAction(name, payload)
	act(name, payload)
end

function ActionController.request(kind, a, b)
	Net.event("Request"):FireServer(kind, a, b)
end

return ActionController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000046"><Properties><string name="Name">AnimationController</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Locomotion for custom realistic rigs that don't carry Roblox's default "Animate" script:
-- blends idle / walk / run (and crouch variants) by speed using the animation IDs in
-- Config/Rigs.Animations. Characters with an Animate script (the placeholder mannequin,
-- or rigs you gave one) are left alone.
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Rigs = require(Shared.Config.Rigs)
local State = require(script.Parent.Parent.State)

local AnimationController = {}

local tracks = nil

local function load(animator, id)
	if not id or id == "" then
		return nil
	end
	local anim = Instance.new("Animation")
	anim.AnimationId = id
	local ok, track = pcall(function()
		return animator:LoadAnimation(anim)
	end)
	if ok and track then
		track.Looped = true
		track:Play(0.2, 0.001)
		return track
	end
	return nil
end

function AnimationController.onCharacter(char)
	tracks = nil
	if char:FindFirstChild("Animate") or Rigs.Animations.idle == "" then
		return
	end
	local humanoid = char:WaitForChild("Humanoid")
	local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
	tracks = {}
	for name, id in Rigs.Animations do
		tracks[name] = load(animator, id)
	end
end

local function weight(track, w, dt)
	if track then
		track:AdjustWeight(math.max(0.001, w), math.min(0.2, dt * 4))
	end
end

function AnimationController.start()
	RunService.RenderStepped:Connect(function(dt)
		if not tracks or not State.root then
			return
		end
		local v = State.root.AssemblyLinearVelocity
		local speed = Vector3.new(v.X, 0, v.Z).Magnitude
		local crouch = State.crouched or State.downed
		local moving = math.clamp(speed / 8, 0, 1)
		local running = math.clamp((speed - 12) / 6, 0, 1)
		weight(tracks.idle, crouch and 0 or (1 - moving), dt)
		weight(tracks.walk, crouch and 0 or moving * (1 - running), dt)
		weight(tracks.run, crouch and 0 or running, dt)
		weight(tracks.crouchIdle, crouch and (1 - moving) or 0, dt)
		weight(tracks.crouchWalk, crouch and moving or 0, dt)
		for _, track in tracks do
			if track then
				track:AdjustSpeed(math.clamp(speed / 12, 0.6, 1.6))
			end
		end
	end)
end

return AnimationController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000047"><Properties><string name="Name">CameraController</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Over-the-shoulder camera: spring-smoothed focus and offset, spherecast collision that snaps
-- in and eases out, per-state framing (explore / crouch / sprint / aim / takedown), shoulder
-- swap, and mouse / gamepad / touch look.
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Game = require(Shared.Config.Game)
local Spring = require(Shared.Util.Spring)
local State = require(script.Parent.Parent.State)

local CameraController = {}
local Controllers
local player = Players.LocalPlayer
local recoilYaw = 0
local recoilPitch = 0 -- temporary kick that springs back (most of it)
local fovPunch = 0

local SENS_MOUSE = 0.0028
local SENS_PAD = 3.0
local SENS_TOUCH = 0.0065
local PITCH_MIN, PITCH_MAX = -1.2, 0.95

local bobPhase, landDip = 0, 0
local fpHidden = false
local fpNext = 0

-- First person hides the head, torso and legs (and anything worn on them) but keeps the arms and
-- the gun, so you see your own hands. Switched back when you leave first person.
local function setFirstPersonVisible(on)
	local char = State.character
	if not char then
		return
	end
	for _, d in char:GetDescendants() do
		if d:IsA("BasePart") then
			local weapon = d:FindFirstAncestorWhichIsA("Model") and d:FindFirstAncestorWhichIsA("Model").Name:sub(1, 7) == "Weapon_"
			local keep = weapon or d.Name:find("Arm") or d.Name:find("Hand")
			d.LocalTransparencyModifier = (on and not keep) and 1 or 0
		end
	end
	fpHidden = on
end

local yaw, pitch = 0, -0.12
local padLook = Vector2.zero
local touchInput, lastTouchPos = nil, nil

local focusSpring = Spring.new(Vector3.zero, 7)
local offsetSpring = Spring.new(Vector3.new(1.7, 0.5, 6.2), 5)
local fovSpring = Spring.new(70, 4)
local currentDist = 6
local needsSnap = true
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude
local aimParams = RaycastParams.new()
aimParams.FilterType = Enum.RaycastFilterType.Exclude

-- Console aim assist (gamepad only, while aiming): the look slows over a target ("friction")
-- and drifts gently onto it while you're moving the stick ("magnetism"). Never snaps.
local lastPad = false
local assistParams = RaycastParams.new()
assistParams.FilterType = Enum.RaycastFilterType.Exclude
local function wrapAngle(a)
	return (a + math.pi) % (2 * math.pi) - math.pi
end
local function aimAssistTarget()
	local enemies = Workspace:FindFirstChild("Enemies")
	local cam = Workspace.CurrentCamera
	if not (enemies and cam) then
		return nil
	end
	local origin = cam.CFrame.Position
	local look = cam.CFrame.LookVector
	local best, bestAngle = nil, math.rad(7)
	for _, model in enemies:GetChildren() do
		local part = model:FindFirstChild("UpperTorso") or model:FindFirstChild("HumanoidRootPart")
		if part and model:GetAttribute("State") ~= "Dispersed" and (model:GetAttribute("HP") or 1) > 0 then
			local to = part.Position - origin
			local dist = to.Magnitude
			if dist < 140 then
				local angle = math.acos(math.clamp(look:Dot(to.Unit), -1, 1))
				-- a wider cone up close
				local cone = math.rad(math.clamp(7 * 25 / math.max(dist, 1), 2.5, 9))
				if angle < cone and angle < bestAngle then
					assistParams.FilterDescendantsInstances = { State.character, model }
					if not Workspace:Raycast(origin, to, assistParams) then
						best, bestAngle = part, angle
					end
				end
			end
		end
	end
	return best
end
function CameraController.usingGamepad()
	return lastPad
end

function CameraController.getYaw()
	return yaw
end

function CameraController.getPitch()
	return pitch
end

-- Recoil: the view climbs (you pull it back down), with a little sideways jitter.
local breath = { holding = false, since = 0, spentUntil = 0 }
local BREATH_HOLD = 4 -- seconds of steady aim before you have to breathe

-- Hold breath while aiming (sprint key): sway stops for a few seconds, then you gasp.
function CameraController.holdBreath(on)
	local now = os.clock()
	if on and State.aiming and now >= breath.spentUntil then
		breath.holding, breath.since = true, now
	elseif not on and breath.holding then
		breath.holding = false
		breath.spentUntil = now + 1
	end
end

function CameraController.isHoldingBreath()
	return breath.holding
end

-- Recoil: the view climbs (you pull it back down); `side` is the gun's pattern step.
-- The kick is ONLY an offset on top of where you are aiming: it springs back to zero, so the
-- view never drifts away from where you put it (the old code added the sideways kick to your
-- aim permanently, which made the screen wander off with every shot).
function CameraController.kick(degrees, side)
	local steady = State.firstPerson and 0.8 or 1
	recoilPitch = math.min(recoilPitch + math.rad(degrees) * 0.45 * steady, math.rad(9))
	recoilYaw = math.clamp(recoilYaw + math.rad(degrees) * ((side or 0) * 0.3 + (math.random() - 0.5) * 0.05) * steady, -math.rad(5), math.rad(5))
	fovPunch = math.min(fovPunch + degrees * 0.25, 3)
end

local function sensitivity()
	return player:GetAttribute("Set_sensitivity") or 1
end

-- Direction from the character's head toward whatever is under the screen centre.
function CameraController.aimDirection()
	local camera = Workspace.CurrentCamera
	local origin = camera.CFrame.Position
	local look = camera.CFrame.LookVector * 250
	-- enemies must stop this ray: the shot leaves from the head, not the camera, so aiming
	-- at the wall behind a target would send the bullet past it
	local hit = Workspace:Raycast(origin, look, aimParams)
	local point = hit and hit.Position or origin + look
	local head = State.character and State.character:FindFirstChild("Head")
	local from = head and head.Position or origin
	local dir = point - from
	if dir.Magnitude < 0.5 then
		return camera.CFrame.LookVector
	end
	return dir.Unit
end

function CameraController.onCharacter(char)
	needsSnap = true
	local root = char:WaitForChild("HumanoidRootPart")
	local _, ry = root.CFrame:ToEulerAnglesYXZ()
	yaw = ry
	pitch = -0.12
end

local function refreshFilter()
	local list = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	aimParams.FilterDescendantsInstances = table.clone(list)
	local enemies = Workspace:FindFirstChild("Enemies")
	if enemies then
		table.insert(list, enemies)
	end
	params.FilterDescendantsInstances = list
end

local function update(dt)
	local camera = Workspace.CurrentCamera
	if camera.CameraType ~= Enum.CameraType.Scriptable then
		camera.CameraType = Enum.CameraType.Scriptable
	end

	local root = State.root
	if not root or not root.Parent then
		-- No character yet (choosing crew): a slow establishing shot of the Meridian.
		local o = Game.FerryOrigin
		local t = os.clock() * 0.05
		camera.CFrame = CFrame.lookAt(o + Vector3.new(math.cos(t) * 55, 16, math.sin(t) * 55), o + Vector3.new(0, 4, 0))
		camera.FieldOfView = 60
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
		return
	end

	local uiOpen = State.uiOpen()
	if uiOpen then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
	elseif not UserInputService.TouchEnabled or UserInputService.MouseEnabled then
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		UserInputService.MouseIconEnabled = false
	end

	local assist = State.aiming and lastPad and player:GetAttribute("Set_aimAssist") ~= false and aimAssistTarget() or nil
	if assist and padLook.Magnitude > 0.15 then
		local d = (assist.Position - Workspace.CurrentCamera.CFrame.Position).Unit
		local wantYaw, wantPitch = math.atan2(-d.X, -d.Z), math.asin(d.Y)
		local k = math.min(1, dt * 2.2)
		yaw += wrapAngle(wantYaw - yaw) * k
		pitch += (wantPitch - pitch) * k * 0.6
	end
	if padLook.Magnitude > 0.15 then
		local aimSlow = (State.aiming and 0.55 or 1) * (assist and 0.6 or 1)
		yaw -= padLook.X * SENS_PAD * dt * sensitivity() * aimSlow
		pitch += padLook.Y * SENS_PAD * 0.7 * dt * sensitivity() * aimSlow
	end
	recoilYaw -= recoilYaw * math.min(1, dt * 8)
	recoilPitch -= recoilPitch * math.min(1, dt * 8)
	fovPunch -= fovPunch * math.min(1, dt * 10)
	pitch = math.clamp(pitch, PITCH_MIN, PITCH_MAX)
	State.pitch = pitch

	local takedown = os.clock() < State.takedownUntil
	State.firstPerson = player:GetAttribute("Set_camera") ~= "Third"
	local firstPerson = State.firstPerson and not State.downed and not takedown
	if firstPerson ~= fpHidden then
		setFirstPersonVisible(firstPerson)
	elseif firstPerson and os.clock() > fpNext then
		fpNext = os.clock() + 0.5
		setFirstPersonVisible(true) -- parts added later (gun swaps) stay correct
	end
	local s = State.shoulder
	local height, offset, fov
	-- over-the-shoulder framing: character on the left third, tight when aiming
	if State.downed then
		height, offset, fov = 0.9, Vector3.new(1.4 * s, 1.3, 6.5), 64
	elseif takedown then
		height, offset, fov = 1.8, Vector3.new(2.3 * s, 0.1, 4.0), 56
	elseif State.prone then
		local weaponFov = State.aiming and Controllers and Controllers.WeaponController.aimFov()
		height, offset, fov = 0.2, Vector3.new(1.4 * s, 0.6, State.aiming and 2.6 or 4.4), weaponFov or 62
	elseif State.aiming then
		local weaponFov = Controllers and Controllers.WeaponController.aimFov()
		local scoped = weaponFov and weaponFov < 40
		height, offset, fov = State.crouched and 1.45 or 2.25, Vector3.new(2.05 * s, 0.35, scoped and 1.9 or 2.7), weaponFov or 50
	elseif State.sprinting then
		height, offset, fov = 2.2, Vector3.new(1.5 * s, 0.55, 6.6), 74
	elseif State.crouched then
		height, offset, fov = 1.35, Vector3.new(1.95 * s, 0.6, 4.9), 64
	else
		height, offset, fov = 2.3, Vector3.new(1.95 * s, 0.5, 5.6), 66
	end

	local focusTarget = root.Position + Vector3.new(0, height, 0)
	if needsSnap or (focusSpring.position - focusTarget).Magnitude > 40 then
		focusSpring:reset(focusTarget)
		offsetSpring:reset(offset)
		currentDist = offset.Magnitude
		needsSnap = false
		refreshFilter()
	end
	focusSpring.target = focusTarget
	offsetSpring.target = offset
	fovSpring.target = fov
	fovSpring.frequency = State.aiming and 14 or 6 -- snap into the sights, ease back out
	local focus = focusSpring:update(dt)
	local off = offsetSpring:update(dt)
	camera.FieldOfView = fovSpring:update(dt) + fovPunch

	-- subtle breathing sway (scaled down while aiming)
	local t = os.clock()
	local reduce = player:GetAttribute("Set_reduceMotion") == true
	-- the view itself must not wander when you're not aiming: only a hair of breathing when
	-- standing completely still, none while moving, none with the sway setting off
	local speed = State.root and Vector3.new(State.root.AssemblyLinearVelocity.X, 0, State.root.AssemblyLinearVelocity.Z).Magnitude or 0
	local sway = (reduce or speed > 0.5) and 0 or 0.0008
	local aimSway = 0
	if State.aiming and not reduce then
		-- breathing sway: steadier crouched, worse while moving
		local v = State.root.AssemblyLinearVelocity
		local moving = math.clamp(Vector3.new(v.X, 0, v.Z).Magnitude / 8, 0, 1)
		aimSway = (State.crouched and 0.0008 or 0.0014) * (1 + moving * 1.2)
		if breath.holding then
			if os.clock() - breath.since > BREATH_HOLD then
				breath.holding = false
				breath.spentUntil = os.clock() + 2.5 -- out of breath: shaky for a moment
			else
				aimSway *= 0.08
			end
		elseif os.clock() < breath.spentUntil then
			aimSway *= 2.2
		end
	elseif breath.holding then
		breath.holding = false
	end
	State.breath = breath.holding and "hold" or (os.clock() < breath.spentUntil and "spent" or "ready")
	local rot = CFrame.fromEulerAnglesYXZ(
		pitch + recoilPitch + math.sin(t * 1.3) * sway + math.sin(t * 0.9) * aimSway,
		yaw + recoilYaw + math.sin(t * 0.7) * sway + math.sin(t * 0.45) * aimSway * 1.4,
		0
	)

	local desired = (CFrame.new(focus) * rot * CFrame.new(off)).Position
	local dir = desired - focus
	local dist = dir.Magnitude
	local allowed = dist
	if dist > 0.01 then
		local hit = Workspace:Spherecast(focus, 0.4, dir, params)
		if hit then
			allowed = math.max(hit.Distance - 0.15, 0.35)
		end
	end
	if allowed < currentDist then
		currentDist = allowed -- snap in so walls never block the view
	else
		currentDist += (allowed - currentDist) * math.min(1, dt * 3.5) -- ease back out
	end
	local position = dist > 0.01 and focus + dir.Unit * currentDist or desired
	local shake = Controllers and Controllers.EffectsController.getShake() or 0
	if shake > 0 and player:GetAttribute("Set_reduceMotion") ~= true then
		local k = shake * 0.03
		rot = rot * CFrame.Angles((math.random() - 0.5) * k, (math.random() - 0.5) * k, 0)
	end
	-- walking weight: a little vertical bob in step with your feet, a dip when you land
	local flatSpeed = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude
	local run = math.clamp(flatSpeed / 20, 0, 1)
	local grounded = State.humanoid and State.humanoid.FloorMaterial ~= Enum.Material.Air
	bobPhase += dt * (5 + flatSpeed * 0.55)
	local bobScale = (reduce or not grounded) and 0 or (State.aiming and 0.2 or 1) * run
	if State.landKick then
		landDip = math.max(landDip, State.landKick)
		State.landKick = nil
	end
	landDip -= landDip * math.min(1, dt * 7)
	local bobY = math.sin(bobPhase) * 0.045 * bobScale - landDip
	local bobX = math.cos(bobPhase * 0.5) * 0.03 * bobScale
	if firstPerson then
		-- eyes: just in front of the head, looking where the camera looks
		local head = State.character and State.character:FindFirstChild("Head")
		if head then
			local eye = head.Position + rot.LookVector * 0.3 + Vector3.new(0, 0.12, 0)
			camera.CFrame = CFrame.new(eye + Vector3.new(bobX, bobY * 1.2, 0)) * rot
			camera.Focus = CFrame.new(eye)
			local weaponFov = State.aiming and Controllers and Controllers.WeaponController.aimFov()
			local baseFov = player:GetAttribute("Set_fov") or 80
			local want = weaponFov and (weaponFov + 6) or (State.sprinting and baseFov + 6 or baseFov)
			camera.FieldOfView += (want - camera.FieldOfView) * math.min(1, dt * 10)
			return
		end
	end
	camera.CFrame = CFrame.new(position + Vector3.new(0, bobY, 0) + rot.RightVector * bobX) * rot
	camera.Focus = CFrame.new(focus)
end

function CameraController.toggleFirstPerson(on)
	if on == nil then
		on = not State.firstPerson
	end
	State.firstPerson = on
	if Controllers and Controllers.UIController then
		Controllers.UIController.setSetting("camera", on and "First" or "Third")
	end
end

function CameraController.init(registry)
	Controllers = registry
end

function CameraController.start()
	UserInputService.InputChanged:Connect(function(input, processed)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			if not State.uiOpen() and State.root then
				local k = SENS_MOUSE * sensitivity() * (State.aiming and 0.6 or 1)
				yaw -= input.Delta.X * k
				pitch -= input.Delta.Y * k
			end
		elseif input.KeyCode == Enum.KeyCode.Thumbstick2 then
			padLook = Vector2.new(input.Position.X, input.Position.Y)
		end
	end)
	UserInputService.LastInputTypeChanged:Connect(function(kind)
		lastPad = kind.Name:sub(1, 7) == "Gamepad"
		State.gamepad = lastPad
	end)
	lastPad = UserInputService:GetLastInputType().Name:sub(1, 7) == "Gamepad"
	State.gamepad = lastPad

	UserInputService.TouchStarted:Connect(function(input, processed)
		if processed or touchInput or State.uiOpen() then
			return
		end
		if input.Position.X > Workspace.CurrentCamera.ViewportSize.X * 0.4 then
			touchInput = input
			lastTouchPos = input.Position
		end
	end)
	UserInputService.TouchMoved:Connect(function(input)
		if input == touchInput and lastTouchPos then
			local delta = input.Position - lastTouchPos
			lastTouchPos = input.Position
			yaw -= delta.X * SENS_TOUCH * sensitivity()
			pitch -= delta.Y * SENS_TOUCH * sensitivity()
		end
	end)
	UserInputService.TouchEnded:Connect(function(input)
		if input == touchInput then
			touchInput = nil
		end
	end)

	Players.PlayerAdded:Connect(function()
		task.wait(2)
		refreshFilter()
	end)
	task.spawn(function()
		while true do
			task.wait(3)
			refreshFilter()
		end
	end)

	RunService:BindToRenderStep("AftertideCamera", Enum.RenderPriority.Camera.Value + 1, update)
end

return CameraController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000048"><Properties><string name="Name">EffectsController</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Client-only feedback: Tide Sense highlights, knockback, hit flash, low-health grade,
-- takedown framing, Squall lightning, and hiding your own revive prompt.
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Geometry = require(Shared.Util.Geometry)
local State = require(script.Parent.Parent.State)

local EffectsController = {}
local Controllers
local Debris = game:GetService("Debris")
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local player = Players.LocalPlayer
local grade -- our own ColorCorrection layer for health feedback
local hitFlash = 0

local function tideSense(data)
	local enemies = Workspace:FindFirstChild("Enemies")
	local root = State.root
	if not enemies or not root then
		return
	end
	local radius = tonumber(data.radius) or 70
	local duration = tonumber(data.duration) or 4
	for _, model in enemies:GetChildren() do
		local r = model:FindFirstChild("HumanoidRootPart")
		if r and (r.Position - root.Position).Magnitude <= radius then
			local h = Instance.new("Highlight")
			h.FillColor = Color3.fromRGB(170, 215, 215)
			h.FillTransparency = 0.88
			h.OutlineColor = Color3.fromRGB(225, 245, 245)
			h.OutlineTransparency = 0.1
			h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			h.Adornee = model
			h.Parent = model
			task.delay(duration, function()
				if h.Parent then
					local tween = TweenService:Create(h, TweenInfo.new(0.6), { OutlineTransparency = 1, FillTransparency = 1 })
					tween:Play()
					tween.Completed:Wait()
					h:Destroy()
				end
			end)
		end
	end
end

local function localPart(position, size)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Transparency = 1
	p.Size = size or Vector3.new(0.2, 0.2, 0.2)
	p.CFrame = CFrame.new(position)
	p.Parent = Workspace
	return p
end

local function tracer(from, to)
	local length = (to - from).Magnitude
	if length < 0.5 then
		return
	end
	local beam = localPart(from)
	beam.Transparency = 0.35
	beam.Material = Enum.Material.Neon
	beam.Color = Color3.fromRGB(255, 225, 180)
	beam.Size = Vector3.new(0.05, 0.05, length)
	beam.CFrame = CFrame.lookAt(from, to) * CFrame.new(0, 0, -length / 2)
	TweenService:Create(beam, TweenInfo.new(0.08), { Transparency = 1 }):Play()
	Debris:AddItem(beam, 0.1)
end

local function impact(position, kind)
	if kind == "none" then
		return
	end
	if Controllers then
		Controllers.SoundController.impact(position, kind)
	end
	if kind == "world" then
		-- a scorched bullet hole that fades
		local hole = localPart(position, Vector3.new(0.22, 0.22, 0.05))
		hole.Transparency = 0.1
		hole.Color = Color3.fromRGB(20, 18, 16)
		hole.Shape = Enum.PartType.Cylinder
		hole.Size = Vector3.new(0.04, 0.22, 0.22)
		local camPos = Workspace.CurrentCamera.CFrame.Position
		hole.CFrame = CFrame.lookAt(position, camPos) * CFrame.Angles(0, math.rad(90), 0)
		TweenService:Create(hole, TweenInfo.new(12), { Transparency = 1 }):Play()
		Debris:AddItem(hole, 12)
	end
	local holder = localPart(position)
	local puff = Instance.new("ParticleEmitter")
	puff.Texture = SMOKE
	puff.Rate = 0
	puff.Lifetime = NumberRange.new(0.4, 0.9)
	puff.Speed = NumberRange.new(2, 6)
	puff.SpreadAngle = Vector2.new(60, 60)
	puff.Drag = 4
	puff.LightInfluence = 1
	if kind == "enemy" then
		puff.Color = ColorSequence.new(Color3.fromRGB(225, 220, 205)) -- salt, never blood
		puff.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 2) })
	else
		puff.Color = ColorSequence.new(Color3.fromRGB(120, 116, 108))
		puff.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1.4) })
		local sparks = Instance.new("ParticleEmitter")
		sparks.Rate = 0
		sparks.Lifetime = NumberRange.new(0.1, 0.25)
		sparks.Speed = NumberRange.new(8, 16)
		sparks.SpreadAngle = Vector2.new(50, 50)
		sparks.LightEmission = 1
		sparks.Color = ColorSequence.new(Color3.fromRGB(255, 200, 140))
		sparks.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.12), NumberSequenceKeypoint.new(1, 0) })
		sparks.Parent = holder
		sparks:Emit(5)
	end
	puff.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
	puff.Parent = holder
	puff:Emit(kind == "enemy" and 10 or 6)
	Debris:AddItem(holder, 1.5)
end

local function shot(data)
	if typeof(data.from) ~= "Vector3" then
		return
	end
	if data.shooter ~= player.UserId then
		local holder = localPart(data.from)
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 200, 140)
		light.Range = 16
		light.Brightness = 5
		light.Parent = holder
		Debris:AddItem(holder, 0.06)
	end
	for _, hit in data.hits or {} do
		if typeof(hit.position) == "Vector3" then
			tracer(data.from, hit.position)
			impact(hit.position, hit.kind)
		end
	end
end

local shake = 0
local function explosion(data)
	local root = State.root
	if not root or typeof(data.position) ~= "Vector3" then
		return
	end
	local dist = (root.Position - data.position).Magnitude
	shake = math.max(shake, math.clamp(1 - dist / 80, 0, 1))
end

local function humRing(data, color)
	if typeof(data.position) ~= "Vector3" then
		return
	end
	local ring = localPart(data.position + Vector3.new(0, 0.2, 0))
	ring.Shape = Enum.PartType.Cylinder
	ring.Material = Enum.Material.ForceField
	ring.Color = color or Color3.fromRGB(200, 230, 230)
	ring.Transparency = 0.2
	ring.Size = Vector3.new(0.2, 2, 2)
	ring.CFrame = CFrame.new(data.position + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.rad(90))
	local r = (tonumber(data.radius) or 60) * 2
	TweenService:Create(ring, TweenInfo.new(1.2, Enum.EasingStyle.Quad), { Size = Vector3.new(0.2, r, r), Transparency = 1 }):Play()
	Debris:AddItem(ring, 1.3)
end

function EffectsController.getShake()
	return shake
end

local function knockback(data)
	local root = State.root
	if root and Geometry.isSaneVector(data.velocity, 200) then
		root.AssemblyLinearVelocity = data.velocity
	end
end

local function hideOwnRevivePrompt(char)
	local function check(inst)
		if inst:IsA("ProximityPrompt") and inst.Name == "Revive" then
			inst.Enabled = false
		end
	end
	for _, d in char:GetDescendants() do
		check(d)
	end
	char.DescendantAdded:Connect(check)
end

function EffectsController.onCharacter(char)
	hideOwnRevivePrompt(char)
end

local nextLightning = 0
local function lightning()
	local before = Lighting.Brightness
	Lighting.Brightness = before + 3
	task.wait(0.06)
	Lighting.Brightness = before
	task.wait(0.09)
	Lighting.Brightness = before + 2
	task.wait(0.05)
	Lighting.Brightness = before
end

function EffectsController.init(registry)
	Controllers = registry
end

function EffectsController.start()
	-- the Lucky Spin wheel on the Meridian turns slowly (client-side, purely visual)
	local CollectionService = game:GetService("CollectionService")
	RunService.RenderStepped:Connect(function(dt)
		for _, wheel in CollectionService:GetTagged("SpinWheel") do
			if wheel:IsA("Model") and wheel.PrimaryPart then
				wheel:PivotTo(wheel:GetPivot() * CFrame.Angles(dt * 0.5, 0, 0))
			end
		end
	end)
	grade = Instance.new("ColorCorrectionEffect")
	grade.Name = "AftertideHealth"
	grade.Parent = Lighting

	Net.event("Notify").OnClientEvent:Connect(function(kind, data)
		data = data or {}
		if kind == "TideSense" then
			tideSense(data)
		elseif kind == "Knockback" then
			knockback(data)
		elseif kind == "Hurt" then
			hitFlash = 1
			shake = math.max(shake, math.clamp((tonumber(data.amount) or 20) / 40, 0.25, 0.8))
		elseif kind == "Takedown" then
			State.takedownUntil = os.clock() + (tonumber(data.duration) or 0.9)
		elseif kind == "Shot" then
			shot(data)
		elseif kind == "Impact" then
			if typeof(data.position) == "Vector3" then
				impact(data.position, data.kind)
			end
		elseif kind == "Explosion" then
			explosion(data)
		elseif kind == "Hum" then
			humRing(data)
		elseif kind == "NoiseRing" then
			-- how far that sound carried: every Hushed inside this ring heard it
			humRing(data, data.kind == "gunshot" and Color3.fromRGB(232, 168, 92) or Color3.fromRGB(226, 220, 206))
		end
	end)

	RunService.RenderStepped:Connect(function(dt)
		shake = math.max(0, shake - dt * 2.5)
		local char = State.character
		local hp = char and char:GetAttribute("HP") or 100
		local maxHp = char and char:GetAttribute("MaxHP") or 100
		local low = 1 - math.clamp(hp / maxHp, 0, 1)
		hitFlash = math.max(0, hitFlash - dt * 2.5)
		grade.Saturation = -0.5 * low - 0.3 * hitFlash
		grade.TintColor = Color3.new(1, 1 - 0.35 * hitFlash - 0.1 * low, 1 - 0.4 * hitFlash - 0.15 * low)
		grade.Contrast = 0.1 * low
		if State.downed then
			grade.Saturation = -0.8
		end

		if ReplicatedStorage:GetAttribute("ModifierId") == "Squall" and ReplicatedStorage:GetAttribute("MatchState") == "Encounter" then
			local now = os.clock()
			if now > nextLightning then
				nextLightning = now + math.random(8, 20)
				task.spawn(lightning)
			end
		end
	end)
end

return EffectsController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000049"><Properties><string name="Name">EnemyAnimator</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Procedural animation for the Hushed (no animation assets needed). Drives each enemy's
-- Motor6D skeleton from its replicated velocity, State and Gait:
--   shamble (Drifter)   uneven, dragging steps, arms hanging and swaying
--   rush    (Rusher)    frantic sprint, flailing arms, head jerks
--   feel    (Seeker)    blind: arms raised ahead, head cocked toward sounds, lunges
--   heavy   (Tidewalker) slow stomp, torso rolls, arms swinging like weights
-- Plus: stagger when stunned, knees buckling when Quieted, and a "?" / "!" marker above the
-- head when it hears something or has spotted you.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local State = require(script.Parent.Parent.State)

local EnemyAnimator = {}
local player = Players.LocalPlayer

local rigs = setmetatable({}, { __mode = "k" }) -- [Model] = rig data
local MAX_DISTANCE = 160

local GAITS = {
	shamble = { freq = 1.7, stride = 0.55, armSwing = 0.18, armHang = 0.15, lean = 0.12, twitch = 0.25, limp = 0.35 },
	rush = { freq = 2.9, stride = 0.95, armSwing = 0.9, armHang = 0.25, lean = 0.45, twitch = 0.6, limp = 0.1 },
	feel = { freq = 1.4, stride = 0.45, armSwing = 0.08, armHang = 1.1, lean = 0.05, twitch = 0.45, limp = 0.0 },
	heavy = { freq = 1.0, stride = 0.5, armSwing = 0.35, armHang = 0.25, lean = 0.3, twitch = 0.1, limp = 0.15 },
	soldier = { freq = 1.9, stride = 0.6, armSwing = 0.08, armHang = 0.7, lean = 0.06, twitch = 0, limp = 0 },
	cultist = { freq = 1.8, stride = 0.55, armSwing = 0.3, armHang = 0.15, lean = 0.12, twitch = 0.04, limp = 0 },
}

local function marker(model, head)
	local gui = Instance.new("BillboardGui")
	gui.Name = "StateMarker"
	gui.Size = UDim2.new(0, 40, 0, 40)
	gui.StudsOffset = Vector3.new(0, head.Size.Y * 0.5 + 1.6, 0)
	gui.MaxDistance = 90
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.Adornee = head
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.Oswald
	label.TextScaled = true
	label.TextStrokeTransparency = 0.4
	label.Text = ""
	label.Parent = gui
	gui.Parent = model
	return label
end

local function setup(model)
	local root = model:FindFirstChild("HumanoidRootPart")
	local torso = model:FindFirstChild("Torso")
	local head = model:FindFirstChild("Head")
	if not root or not torso or not head then
		return nil
	end
	local function m(parent, name)
		local p = model:FindFirstChild(parent)
		local j = p and p:FindFirstChild(name)
		return j and j:IsA("Motor6D") and j or nil
	end
	local rig = {
		root = root,
		head = head,
		waist = m("HumanoidRootPart", "Waist"),
		neck = m("Torso", "Neck"),
		ls = m("Torso", "LeftShoulder"),
		rs = m("Torso", "RightShoulder"),
		le = m("LeftUpperArm", "LeftElbow"),
		re = m("RightUpperArm", "RightElbow"),
		lh = m("HumanoidRootPart", "LeftHip"),
		rh = m("HumanoidRootPart", "RightHip"),
		lk = m("LeftUpperLeg", "LeftKnee"),
		rk = m("RightUpperLeg", "RightKnee"),
		phase = math.random() * 6.28,
		seed = math.random() * 100,
		twitchAt = 0,
		twitch = CFrame.new(),
		spasmAt = os.clock() + math.random() * 4,
		spasm = 0,
		lastHP = model:GetAttribute("HP") or 1,
		flinch = 0,
	}
	for _, d in model:GetDescendants() do
		if d.Name == "Maw" and d:IsA("BasePart") then
			rig.maw = d
			rig.mawSize = d.Size
		end
	end
	if not rig.waist or not rig.lh then
		return nil
	end
	rig.label = marker(model, head)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		for _, child in humanoid:GetChildren() do
			if child:IsA("Animator") then
				child:Destroy() -- it would overwrite the procedural joints every frame
			end
		end
	end
	return rig
end

local function set(motor, cf)
	if motor then
		motor.Transform = cf
	end
end

local function readHit(model, rig)
	local raw = model:GetAttribute("HitReact")
	if raw and raw ~= rig.hitRaw then
		rig.hitRaw = raw
		local zone, side, dx, dy, dz, t = string.match(raw, "^(%a+)|(%a*)|([%-%d%.]+)|([%-%d%.]+)|([%-%d%.]+)|([%d%.]+)$")
		if zone then
			local dir = Vector3.new(tonumber(dx), tonumber(dy), tonumber(dz))
			local localDir = rig.root.CFrame:VectorToObjectSpace(dir)
			rig.hit = { zone = zone, side = side, at = tonumber(t), back = -localDir.Z, across = localDir.X }
		end
	end
end

-- 0..1 envelope for a hit reaction: sharp snap, slower recovery.
local function hitEnvelope(rig)
	local h = rig.hit
	if not h then
		return 0, nil
	end
	local since = Workspace:GetServerTimeNow() - h.at
	local len = h.zone == "leg" and 0.7 or 0.45
	if since < 0 or since > len then
		return 0, h
	end
	local k = since < 0.06 and since / 0.06 or (1 - (since - 0.06) / (len - 0.06)) ^ 2
	return k, h
end

local function animate(model, rig, dt, now)
	local gait = GAITS[model:GetAttribute("Gait") or "shamble"] or GAITS.shamble
	local state = model:GetAttribute("State") or "Patrol"
	if state == "Ragdoll" then
		if rig.label then
			rig.label.Text = ""
		end
		return -- physics owns the body now
	end
	readHit(model, rig)
	local v = rig.root.AssemblyLinearVelocity
	local speed = Vector3.new(v.X, 0, v.Z).Magnitude
	local moving = math.clamp(speed / 6, 0, 1)
	local chasing = state == "Chase"

	rig.phase += dt * gait.freq * math.clamp(speed / 6, 0.3, 2.6) * math.pi
	local p = rig.phase
	local stride = gait.stride * moving * (chasing and 1.15 or 1)
	local sinL, sinR = math.sin(p), math.sin(p + math.pi)
	local limp = 1 - gait.limp * (sinR > 0 and 1 or 0) -- one leg drags

	-- legs
	local lHip = sinL * stride
	local rHip = sinR * stride * limp
	local lKnee = -math.max(0, -sinL) * stride * 1.6 - 0.08
	local rKnee = -math.max(0, -sinR) * stride * 1.6 * limp - 0.08

	-- torso: lean forward when moving or chasing, slow sway when still
	local idle = (1 - moving)
	local sway = math.sin(now * 0.9 + rig.seed) * 0.05 * idle
	local lean = gait.lean * moving + (chasing and 0.15 or 0)
	local roll = math.sin(p) * 0.06 * moving + sway

	-- arms
	local hang = gait.armHang
	local lArm = hang + -sinL * gait.armSwing * moving
	local rArm = hang + -sinR * gait.armSwing * moving
	local elbow = gait == GAITS.feel and 0.5 or 0.25

	-- head twitches (sharper when they've just heard something)
	local heard = Workspace:GetServerTimeNow() - (model:GetAttribute("Heard") or -100) < 2
	if now > rig.twitchAt then
		local strength = gait.twitch * (heard and 2 or 1)
		rig.twitch = CFrame.Angles((math.random() - 0.5) * strength, (math.random() - 0.5) * strength * 1.5, (math.random() - 0.5) * strength)
		rig.twitchAt = now + (heard and 0.15 or 0.6 + math.random() * 1.8)
	end

	-- spasms: sudden violent jerks of the whole upper body (the Hushed only)
	local human = model:GetAttribute("Human") == true
	if not human and now > rig.spasmAt then
		rig.spasm = 1
		rig.spasmAt = now + (model:GetAttribute("Gait") == "rush" and 1.2 or 2.5) + math.random() * 4
		rig.spasmDir = (math.random() < 0.5) and -1 or 1
	end
	rig.spasm = math.max(0, rig.spasm - dt * 5)
	local sp = rig.spasm ^ 2 * (rig.spasmDir or 1)

	-- flinch when hit
	local hp = model:GetAttribute("HP") or 1
	if hp < rig.lastHP - 0.001 then
		rig.flinch = 1
	end
	rig.lastHP = hp
	rig.flinch = math.max(0, rig.flinch - dt * 4)
	local fl = rig.flinch

	-- the maw gapes when it hunts or screams
	if rig.maw then
		local open = (chasing and 1.6 or 1) + (heard and 0.3 or 0) + math.sin(now * 13) * (chasing and 0.15 or 0)
		rig.maw.Size = Vector3.new(rig.mawSize.X, rig.mawSize.Y * open, rig.mawSize.Z)
	end

	-- states that override the gait
	local legStun = Workspace:GetServerTimeNow() - (model:GetAttribute("LegStunAt") or -100)
	if state == "Stunned" and legStun < 1.6 then
		-- shot in the leg: dropped to one knee, a hand down to catch themselves
		lean, roll = 0.35, 0.1
		lHip, rHip, lKnee, rKnee = 1.2, -0.1, -1.6, -2.0
		lArm, rArm = 0.9, 0.3
	elseif state == "Stunned" or state == "Pinned" then
		local wobble = math.sin(now * 9 + rig.seed) * 0.15
		lean, roll = -0.25, wobble
		lArm, rArm = 0.6 + wobble, 0.5 - wobble
		lHip, rHip, lKnee, rKnee = -0.15, 0.2, -0.3, -0.35
	elseif state == "Grabbed" then
		-- held from behind: clawing at the arm round their neck, feet dragging
		local fight = math.sin(now * 11 + rig.seed) * 0.25
		lArm, rArm, elbow = 2.3 + fight, 2.2 - fight, 1.5
		lean, roll = -0.2, fight * 0.3
		lHip, rHip, lKnee, rKnee = 0.2 + fight * 0.4, 0.15 - fight * 0.4, -0.3, -0.35
	elseif state == "Quieted" or state == "Dispersed" or state == "Down" then
		lean, roll = 0.5, 0.1
		lHip, rHip, lKnee, rKnee = 0.9, 0.85, -1.6, -1.5
		lArm, rArm = 0.1, 0.05
	elseif human then
		if model:GetAttribute("Aiming") then
			lArm, rArm, elbow = 1.45, 1.55, 0.2 -- weapon raised
			lean = 0.02
		end
		local attackAt = model:GetAttribute("AttackAt")
		local since = attackAt and (Workspace:GetServerTimeNow() - attackAt) or 99
		if since < 0.45 then
			local k = since / 0.45
			rArm = k < 0.35 and (2.6 * k / 0.35) or (2.6 - (k - 0.35) / 0.65 * 2.4)
			lean = 0.25 * math.sin(k * math.pi)
		end
	elseif chasing then
		-- arms reach toward their prey
		lArm = math.max(lArm, 1.1 + math.sin(p) * 0.25)
		rArm = math.max(rArm, 1.0 + math.sin(p + 1) * 0.25)
	end

	-- directional hit reactions: head snaps, shoulders spin, legs buckle
	local hk, h = hitEnvelope(rig)
	local hWaistX, hWaistY, hNeckX, hNeckY = 0, 0, 0, 0
	if hk > 0 and h then
		local push = math.clamp(h.back, -1, 1) -- +1: shot from the front, body goes back
		local sideSign = h.side == "L" and -1 or (h.side == "R" and 1 or (h.across >= 0 and 1 or -1))
		if h.zone == "head" then
			hNeckX, hNeckY = -0.9 * hk * push, 0.4 * hk * h.across
			hWaistX = -0.25 * hk * push
		elseif h.zone == "torso" then
			hWaistX, hWaistY = -0.45 * hk * push, 0.35 * hk * h.across
		elseif h.zone == "arm" then
			hWaistY = 0.55 * hk * sideSign
			if sideSign > 0 then
				rArm -= 1.2 * hk
			else
				lArm -= 1.2 * hk
			end
		elseif h.zone == "leg" then
			hWaistX = 0.35 * hk
			if sideSign > 0 then
				rHip, rKnee = rHip + 0.5 * hk, rKnee - 1.3 * hk
			else
				lHip, lKnee = lHip + 0.5 * hk, lKnee - 1.3 * hk
			end
		end
	end

	set(rig.waist, CFrame.Angles(-lean + fl * 0.45 + hWaistX, math.sin(p * 0.5) * 0.08 * moving + sp * 0.5 + hWaistY, roll + sp * 0.3))
	set(rig.neck, CFrame.Angles(lean * 0.6 - fl * 0.5 + hNeckX, sp * 0.9 + hNeckY, sp * 0.6) * rig.twitch)
	lArm += sp * 0.8
	rArm -= sp * 0.6
	set(rig.lh, CFrame.Angles(lHip, 0, 0))
	set(rig.rh, CFrame.Angles(rHip, 0, 0))
	set(rig.lk, CFrame.Angles(lKnee, 0, 0))
	set(rig.rk, CFrame.Angles(rKnee, 0, 0))
	set(rig.ls, CFrame.Angles(lArm, 0, -0.08))
	set(rig.rs, CFrame.Angles(rArm, 0, 0.08))
	set(rig.le, CFrame.Angles(elbow + (chasing and 0.2 or 0), 0, 0))
	set(rig.re, CFrame.Angles(elbow + (chasing and 0.3 or 0), 0, 0))

	-- "?" heard / searching, "!" chasing you
	local label = rig.label
	if label then
		local hunting = chasing and model:GetAttribute("Target") == player.UserId
		if hunting or chasing then
			label.Text = "!"
			label.TextColor3 = Color3.fromRGB(200, 74, 60)
		elseif state == "Investigate" or state == "Search" or heard then
			label.Text = "?"
			label.TextColor3 = Color3.fromRGB(232, 168, 92)
		else
			label.Text = ""
		end
	end
end

function EnemyAnimator.start()
	RunService.RenderStepped:Connect(function(dt)
		local folder = Workspace:FindFirstChild("Enemies")
		local camera = Workspace.CurrentCamera
		if not folder then
			return
		end
		local now = os.clock()
		local origin = camera.CFrame.Position
		for _, model in folder:GetChildren() do
			local rig = rigs[model]
			if rig == nil then
				rig = setup(model) -- retried next frame until all parts have replicated
				rigs[model] = rig
			end
			if rig and (rig.root.Position - origin).Magnitude < MAX_DISTANCE then
				animate(model, rig, dt, now)
			end
		end
	end)
	assert(State)
end

return EnemyAnimator
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000004A"><Properties><string name="Name">GraphicsController</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Graphics presets. Roblox decides the core render quality per device (from the player's
-- graphics slider); these presets layer extra effects on top and decide how many costly
-- things run:
--   Cinematic   (PC / PlayStation / Xbox): depth of field with aim focus, sun rays, filmic
--               grade, stronger bloom, shadows on every practical light, dense local ground
--               mist, dust motes, heavy rain in a Squall
--   Balanced    lighter mist, no DoF, standard shadows
--   Performance (phones): no extra effects, fewer fog particles, fewer shadow-casting lights
-- "Auto" picks by device and the player's Roblox graphics level.
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local State = require(script.Parent.Parent.State)

local GraphicsController = {}
local Controllers
local player = Players.LocalPlayer

local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local dof, rays, bloom, grade, vignette
local mistPart, mist, dust, rainPart, rain
local current = nil

function GraphicsController.resolve(setting)
	if setting and setting ~= "Auto" then
		return setting
	end
	local touchOnly = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local consoleLike = UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled and not UserInputService.TouchEnabled
	if touchOnly then
		return "Performance"
	elseif consoleLike then
		return "Cinematic"
	end
	local ok, level = pcall(function()
		return UserSettings():GetService("UserGameSettings").SavedQualityLevel
	end)
	if not ok or level == Enum.SavedQualitySetting.Automatic then
		return "Cinematic"
	end
	local n = tonumber(tostring(level.Value)) or 10
	if n >= 7 then
		return "Cinematic"
	elseif n >= 4 then
		return "Balanced"
	end
	return "Performance"
end

function GraphicsController.current()
	return current
end

local function setLightShadows(enabled)
	local world = Workspace:FindFirstChild("World")
	if not world then
		return
	end
	for _, d in world:GetDescendants() do
		if d:IsA("PointLight") or d:IsA("SpotLight") then
			if d:GetAttribute("BaseShadows") == nil then
				d:SetAttribute("BaseShadows", d.Shadows)
			end
			d.Shadows = enabled == "all" or (enabled == "base" and d:GetAttribute("BaseShadows"))
		end
	end
end

local function scaleWorldFog(mult)
	local world = Workspace:FindFirstChild("World")
	if not world then
		return
	end
	for _, d in world:GetDescendants() do
		if d:IsA("ParticleEmitter") and d.Texture == SMOKE and d.Parent and d.Parent.Parent and d.Parent.Parent.Name:sub(1, 4) == "Map_" then
			if d:GetAttribute("BaseRate") == nil then
				d:SetAttribute("BaseRate", d.Rate)
			end
			d.Rate = d:GetAttribute("BaseRate") * mult
		end
	end
end

local function apply(mode)
	current = mode
	local cinematic = mode == "Cinematic"
	local performance = mode == "Performance"
	dof.Enabled = cinematic
	rays.Enabled = cinematic
	bloom.Enabled = not performance
	bloom.Intensity = cinematic and 0.5 or 0.25
	grade.Enabled = not performance
	grade.Contrast = cinematic and 0.1 or 0.05
	grade.Saturation = cinematic and 0.06 or 0.03
	grade.TintColor = cinematic and Color3.fromRGB(255, 246, 236) or Color3.new(1, 1, 1)
	mist.Rate = cinematic and 5 or (performance and 0 or 2)
	dust.Rate = cinematic and 18 or 0
	for _, f in vignette or {} do
		f.Visible = not performance
		f.BackgroundTransparency = cinematic and 0.62 or 0.8
	end
	-- wind-swayed terrain grass (cheap on PC/console, off on phones)
	pcall(function()
		Workspace.Terrain.Decoration = not performance
	end)
	setLightShadows(cinematic and "all" or (performance and "none" or "base"))
	scaleWorldFog(cinematic and 1.6 or (performance and 0.35 or 1))
	player:SetAttribute("GraphicsMode", mode)
end

function GraphicsController.refresh()
	apply(GraphicsController.resolve(player:GetAttribute("Set_graphics")))
end

local function buildEffects()
	dof = Instance.new("DepthOfFieldEffect")
	dof.Name = "AftertideDoF"
	dof.FarIntensity = 0.18
	dof.NearIntensity = 0
	dof.FocusDistance = 40
	dof.InFocusRadius = 35
	dof.Parent = Lighting

	rays = Instance.new("SunRaysEffect")
	rays.Name = "AftertideRays"
	rays.Intensity = 0.03
	rays.Spread = 0.6
	rays.Parent = Lighting

	bloom = Instance.new("BloomEffect")
	bloom.Name = "AftertideBloomHQ"
	bloom.Size = 32
	bloom.Threshold = 1.2
	bloom.Parent = Lighting

	grade = Instance.new("ColorCorrectionEffect")
	grade.Name = "AftertideFilmic"
	grade.Parent = Lighting

	-- a soft lens vignette (darkened corners), like a film camera
	local gui = Instance.new("ScreenGui")
	gui.Name = "CinematicVignette"
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = -5
	gui.ResetOnSpawn = false
	gui.Parent = player:WaitForChild("PlayerGui")
	vignette = {}
	for i, spec in {
		{ UDim2.new(0.22, 0, 1, 0), UDim2.new(0, 0, 0, 0), 0 },
		{ UDim2.new(0.22, 0, 1, 0), UDim2.new(0.78, 0, 0, 0), 180 },
		{ UDim2.new(1, 0, 0.22, 0), UDim2.new(0, 0, 0, 0), 90 },
		{ UDim2.new(1, 0, 0.22, 0), UDim2.new(0, 0, 0.78, 0), 270 },
	} do
		local f = Instance.new("Frame")
		f.Size, f.Position = spec[1], spec[2]
		f.BackgroundColor3 = Color3.new(0, 0, 0)
		f.BorderSizePixel = 0
		f.BackgroundTransparency = 0.55
		local g = Instance.new("UIGradient")
		g.Rotation = spec[3]
		g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
		g.Parent = f
		f.Parent = gui
		vignette[i] = f
	end

	-- local ground mist and dust that follow the camera (client-only, costs nothing on the server)
	mistPart = Instance.new("Part")
	mistPart.Name = "LocalMist"
	mistPart.Anchored = true
	mistPart.CanCollide = false
	mistPart.CanQuery = false
	mistPart.CanTouch = false
	mistPart.Transparency = 1
	mistPart.Size = Vector3.new(90, 1, 90)
	mistPart.Parent = Workspace

	mist = Instance.new("ParticleEmitter")
	mist.Texture = SMOKE
	mist.Lifetime = NumberRange.new(10, 16)
	mist.Speed = NumberRange.new(0.2, 0.8)
	mist.SpreadAngle = Vector2.new(80, 80)
	mist.Rotation = NumberRange.new(0, 360)
	mist.RotSpeed = NumberRange.new(-3, 3)
	mist.LightInfluence = 1
	mist.Color = ColorSequence.new(Color3.fromRGB(205, 212, 212))
	mist.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 12), NumberSequenceKeypoint.new(1, 22) })
	mist.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.35, 0.9), NumberSequenceKeypoint.new(0.7, 0.92), NumberSequenceKeypoint.new(1, 1) })
	mist.Drag = 0.4
	mist.WindAffectsDrag = true -- fog drifts with the map's wind
	mist.Parent = mistPart

	dust = Instance.new("ParticleEmitter")
	dust.Lifetime = NumberRange.new(4, 7)
	dust.Speed = NumberRange.new(0.1, 0.4)
	dust.SpreadAngle = Vector2.new(180, 180)
	dust.LightInfluence = 1
	dust.Color = ColorSequence.new(Color3.fromRGB(230, 225, 210))
	dust.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.06), NumberSequenceKeypoint.new(1, 0) })
	dust.Parent = mistPart

	rainPart = Instance.new("Part")
	rainPart.Name = "LocalRain"
	rainPart.Anchored = true
	rainPart.CanCollide = false
	rainPart.CanQuery = false
	rainPart.CanTouch = false
	rainPart.Transparency = 1
	rainPart.Size = Vector3.new(80, 1, 80)
	rainPart.Parent = Workspace
	rain = Instance.new("ParticleEmitter")
	rain.Rate = 0
	rain.Lifetime = NumberRange.new(0.8, 1)
	rain.Speed = NumberRange.new(70, 90)
	rain.EmissionDirection = Enum.NormalId.Bottom
	rain.Orientation = Enum.ParticleOrientation.VelocityParallel
	rain.LightInfluence = 1
	rain.Color = ColorSequence.new(Color3.fromRGB(190, 200, 205))
	rain.Transparency = NumberSequence.new(0.55)
	rain.Size = NumberSequence.new(0.08)
	rain.Squash = NumberSequence.new(2.5)
	rain.Parent = rainPart
end

function GraphicsController.init(registry)
	Controllers = registry
end

function GraphicsController.start()
	buildEffects()
	GraphicsController.refresh()
	player:GetAttributeChangedSignal("Set_graphics"):Connect(GraphicsController.refresh)
	-- world lights are built by the server shortly after join; re-apply once they exist
	task.delay(5, GraphicsController.refresh)
	ReplicatedStorage:GetAttributeChangedSignal("MatchState"):Connect(function()
		task.delay(1, GraphicsController.refresh)
	end)

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	RunService.RenderStepped:Connect(function(dt)
		local camera = Workspace.CurrentCamera
		local pos = camera.CFrame.Position
		-- ground mist hugs the ground you stand on (hills, the ferry deck), not sea level
		local feet = State.root and State.root.Parent and (State.root.Position.Y - 3.5) or (pos.Y - 6)
		mistPart.CFrame = CFrame.new(pos.X, feet, pos.Z)
		rainPart.CFrame = CFrame.new(pos.X, pos.Y + 28, pos.Z)
		local squall = ReplicatedStorage:GetAttribute("ModifierId") == "Squall" and ReplicatedStorage:GetAttribute("MatchState") == "Encounter"
		rain.Rate = squall and (current == "Cinematic" and 500 or (current == "Balanced" and 220 or 60)) or 0

		-- aim focus: in Cinematic, focus depth of field on what you're aiming at
		if current == "Cinematic" then
			local focusDist, radius, far = 40, 35, 0.18
			if State.aiming then
				params.FilterDescendantsInstances = State.character and { State.character } or {}
				local hit = Workspace:Raycast(pos, camera.CFrame.LookVector * 250, params)
				focusDist = hit and hit.Distance or 200
				radius, far = math.max(6, focusDist * 0.35), 0.4
			end
			dof.FocusDistance += (focusDist - dof.FocusDistance) * math.min(1, dt * 6)
			dof.InFocusRadius += (radius - dof.InFocusRadius) * math.min(1, dt * 6)
			dof.FarIntensity += (far - dof.FarIntensity) * math.min(1, dt * 6)
		end
	end)
end

return GraphicsController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000004B"><Properties><string name="Name">ListenController</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Listen mode (hold L, or hold R3 on a controller): you stop, crouch low and strain to hear.
-- The world greys out and everything making noise near you shows as a silhouette through
-- walls: pale for the Hushed, amber for people, red when they are hunting you. A soft tick
-- speeds up the closer the nearest one is. You creep while listening and cannot shoot.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Sfx = require(Shared.Util.Sfx)
local State = require(script.Parent.Parent.State)

local ListenController = {}
local Controllers
local player = Players.LocalPlayer

local RADIUS = 46
local MAX_SHOWN = 10
local grade, blur, label, gui
local shown = {} -- [model] = Highlight
local nextPing = 0
local loop

local function ensureEffects()
	if grade then
		return
	end
	grade = Instance.new("ColorCorrectionEffect")
	grade.Name = "AftertideListen"
	grade.Enabled = false
	grade.Parent = Lighting
	blur = Instance.new("BlurEffect")
	blur.Name = "AftertideListenBlur"
	blur.Size = 0
	blur.Parent = Lighting
	gui = Instance.new("ScreenGui")
	gui.Name = "AftertideListenHud"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 5
	gui.Enabled = false
	gui.Parent = player:WaitForChild("PlayerGui")
	label = Instance.new("TextLabel")
	label.AnchorPoint = Vector2.new(0.5, 1)
	label.Position = UDim2.new(0.5, 0, 1, -120)
	label.Size = UDim2.new(0, 360, 0, 26)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.Oswald
	label.TextSize = 22
	label.TextColor3 = Color3.fromRGB(225, 232, 236)
	label.Text = "LISTENING"
	label.Parent = gui
end

local function clearShown()
	for model, hl in shown do
		hl:Destroy()
		shown[model] = nil
	end
end

function ListenController.set(on)
	ensureEffects()
	if on == State.listening then
		return
	end
	if on then
		if State.downed or State.uiOpen() or State.vaulting or not State.character then
			return
		end
		State.listening = true
		if State.aiming then
			Controllers.MovementController.setAim(false)
		end
		Controllers.MovementController.setSprint(false, false)
		grade.Enabled = true
		TweenService:Create(grade, TweenInfo.new(0.35), { Saturation = -0.85, Brightness = -0.06, Contrast = 0.12, TintColor = Color3.fromRGB(210, 224, 240) }):Play()
		TweenService:Create(blur, TweenInfo.new(0.35), { Size = 5 }):Play()
		gui.Enabled = true
		if Sfx.has("Listen_On") then
			Sfx.ui("Listen_On", 0.7)
		else
			Sfx.ui("Ui_Confirm", 0.4)
		end
		if Sfx.has("Listen_Loop") and not loop then
			loop = Sfx.ui("Listen_Loop", 0.5, true)
		end
	else
		State.listening = false
		TweenService:Create(grade, TweenInfo.new(0.3), { Saturation = 0, Brightness = 0, Contrast = 0, TintColor = Color3.new(1, 1, 1) }):Play()
		TweenService:Create(blur, TweenInfo.new(0.3), { Size = 0 }):Play()
		task.delay(0.32, function()
			if not State.listening then
				grade.Enabled = false
			end
		end)
		gui.Enabled = false
		clearShown()
		if Sfx.has("Listen_Off") then
			Sfx.ui("Listen_Off", 0.6)
		end
		if loop then
			loop:Destroy()
			loop = nil
		end
	end
end

local function update(dt)
	if not State.listening then
		return
	end
	if State.downed or State.uiOpen() or not State.root then
		ListenController.set(false)
		return
	end
	local folder = Workspace:FindFirstChild("Enemies")
	local origin = State.root.Position
	local radius = RADIUS * (State.crouched and 1.15 or 1)
	local list = {}
	if folder then
		for _, model in folder:GetChildren() do
			local root = model:FindFirstChild("HumanoidRootPart")
			local st = model:GetAttribute("State")
			if root and st ~= "Dispersed" and st ~= "Down" then
				local d = (root.Position - origin).Magnitude
				if d <= radius then
					table.insert(list, { model = model, dist = d, state = st })
				end
			end
		end
	end
	table.sort(list, function(a, b)
		return a.dist < b.dist
	end)
	local keep = {}
	for i = 1, math.min(#list, MAX_SHOWN) do
		local e = list[i]
		keep[e.model] = true
		local hl = shown[e.model]
		if not hl then
			hl = Instance.new("Highlight")
			hl.Name = "ListenHL"
			hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			hl.Adornee = e.model
			hl.Parent = e.model
			shown[e.model] = hl
		end
		local hunting = e.state == "Chase" and e.model:GetAttribute("Target") == player.UserId
		local human = e.model:GetAttribute("Human") == true
		local color = hunting and Color3.fromRGB(255, 70, 60) or (human and Color3.fromRGB(255, 200, 90) or Color3.fromRGB(190, 225, 255))
		hl.FillColor = color
		hl.OutlineColor = color
		local fade = e.dist / radius
		hl.FillTransparency = 0.45 + 0.5 * fade
		hl.OutlineTransparency = 0.1 + 0.6 * fade
	end
	for model, hl in shown do
		if not keep[model] or not model.Parent then
			hl:Destroy()
			shown[model] = nil
		end
	end
	-- the tick: faster the closer the nearest one is
	local now = os.clock()
	if now >= nextPing then
		if #list > 0 then
			local d = list[1].dist
			nextPing = now + math.clamp(d / radius * 1.3 + 0.3, 0.3, 1.6)
			Sfx.ui(Sfx.has("Listen_Ping") and "Listen_Ping" or "Ui_Tick", math.clamp(1.1 - d / radius, 0.25, 0.9))
		else
			nextPing = now + 1.2
		end
	end
	label.Text = #list == 0 and "LISTENING · quiet" or ("LISTENING · %d nearby · closest %d studs"):format(#list, math.floor(list[1].dist))
end

function ListenController.init(registry)
	Controllers = registry
end

function ListenController.onCharacter()
	State.listening = false
	State.vaulting = false
	if grade then
		grade.Enabled = false
		blur.Size = 0
		gui.Enabled = false
	end
	clearShown()
end

function ListenController.start()
	ensureEffects()
	RunService.RenderStepped:Connect(update)
end

return ListenController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000004C"><Properties><string name="Name">MovementController</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Stances, speed states with acceleration, wading, aim-facing (strafe while aiming), and the
-- dodge / sprint-dive movement. Poses are drawn by PlayerAnimator.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Movement = require(Shared.Config.Movement)
local Stats = require(Shared.Stats)
local Net = require(Shared.Net)
local Geometry = require(Shared.Util.Geometry)
local Sfx = require(Shared.Util.Sfx)
local State = require(script.Parent.Parent.State)

local MovementController = {}
local Controllers

local player = Players.LocalPlayer
local currentSpeed = 0
local stillTime = 0
local lastSent = ""
local lastLookSent, lastLookAt = 0, 0
local dodgeReadyAt = 0
local sprintTime = 0

local function send()
	local stance = State.prone and "Prone" or (State.crouched and "Crouch" or "Stand")
	local key = stance .. tostring(State.sprinting) .. tostring(State.aiming)
	if key ~= lastSent then
		lastSent = key
		Net.event("SetMoveState"):FireServer(stance, State.sprinting, State.aiming)
	end
end

function MovementController.setProne(on)
	if State.downed then
		return
	end
	State.prone = on
	if on then
		State.crouched = false
		State.sprinting = false
	end
	send()
end

function MovementController.toggleCrouch()
	if State.downed then
		return
	end
	if State.prone then -- tap from prone: up to a crouch
		State.prone = false
		State.crouched = true
		send()
		return
	end
	State.crouched = not State.crouched
	if State.crouched then
		State.sprinting = false
	end
	send()
end

function MovementController.setSprint(on, toggled)
	if State.downed then
		return
	end
	State.sprinting = on
	State.sprintToggled = on and toggled == true
	if on then
		State.crouched = false
		State.prone = false
	end
	send()
end

function MovementController.setAim(on)
	local was = State.aiming
	State.aiming = on and not State.downed
	if State.aiming and not was then
		State.aimSince = os.clock()
	end
	if State.aiming then
		State.sprinting = false
	end
	send()
end

-- Quick sidestep in the move direction (backstep if standing still); a dive when sprinting.
function MovementController.dodge()
	local root, humanoid = State.root, State.humanoid
	if not root or not humanoid or State.downed or State.uiOpen() or State.prone then
		return
	end
	local now = os.clock()
	if now < dodgeReadyAt then
		return
	end
	local dive = State.sprinting
	dodgeReadyAt = now + (dive and 1.3 or 0.85)
	local dir = humanoid.MoveDirection
	if dir.Magnitude < 0.1 then
		dir = -Geometry.flat(root.CFrame.LookVector)
	end
	dir = Geometry.flat(dir).Unit
	Net.event("Action"):FireServer("Dodge", dir)
	Sfx.ui("Dodge", 0.6)

	-- never dash into (and through) a wall: shorten the dodge to the space available
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { State.character }
	local room = Workspace:Raycast(root.Position, dir * 9, params)
	local roomScale = room and math.clamp((room.Distance - 1.5) / 9, 0, 1) or 1
	local attachment = root:FindFirstChild("RootAttachment")
	if attachment and roomScale > 0.1 then
		local lv = Instance.new("LinearVelocity")
		lv.Attachment0 = attachment
		lv.MaxForce = 4e4
		lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
		lv.PrimaryTangentAxis = Vector3.new(1, 0, 0)
		lv.SecondaryTangentAxis = Vector3.new(0, 0, 1)
		lv.RelativeTo = Enum.ActuatorRelativeTo.World
		local speed = (dive and 36 or 30) * roomScale
		lv.PlaneVelocity = Vector2.new(dir.X * speed, dir.Z * speed)
		lv.Parent = root
		task.delay(dive and 0.38 or 0.22, function()
			lv:Destroy()
		end)
	end
	if dive then
		State.sprinting = false
		task.delay(0.5, function()
			State.crouched = true
			send()
		end)
	end
end

-- Jump and vault ---------------------------------------------------------------------------------

local probeParams = RaycastParams.new()
probeParams.FilterType = Enum.RaycastFilterType.Exclude
probeParams.IgnoreWater = true
local jumpReadyAt = 0

-- Looks for something waist- to chest-high in front of you that you can go over, and for open
-- ground beyond it. Returns the vault (start, apex, landing) or nil.
local function probeVault(dir)
	local root, humanoid = State.root, State.humanoid
	local enemies = Workspace:FindFirstChild("Enemies")
	probeParams.FilterDescendantsInstances = { State.character, enemies }
	local feet = root.Position.Y - (root.Size.Y / 2 + humanoid.HipHeight)
	local hit
	for _, h in { 1.2, 2.4 } do -- knee and waist
		local r = Workspace:Raycast(Vector3.new(root.Position.X, feet + h, root.Position.Z), dir * 3.6, probeParams)
		if r and r.Instance.CanCollide and r.Instance.Transparency < 1 then
			hit = r
			break
		end
	end
	if not hit then
		return nil, "no obstacle in front"
	end
	local into = hit.Position + dir * 0.7
	local top = Workspace:Raycast(Vector3.new(into.X, feet + 5.4, into.Z), Vector3.new(0, -5.4, 0), probeParams)
	if not top or top.Normal.Y < 0.6 then
		return nil, "no flat top"
	end
	local h = top.Position.Y - feet
	if h < 1.1 or h > 4.6 then
		return nil, "height " .. tostring(h)
	end
	if Workspace:Raycast(Vector3.new(into.X, top.Position.Y + 0.15, into.Z), Vector3.new(0, 3.4, 0), probeParams) then
		return nil, "no headroom"
	end
	local base = Vector3.new(hit.Position.X, top.Position.Y, hit.Position.Z)
	local lastWhy = "none"
	for d = 1.1, 9, 0.8 do
		local pt = base + dir * d
		local floor = Workspace:Raycast(pt + Vector3.new(0, 3.2, 0), Vector3.new(0, -(h + 9), 0), probeParams)
		if not floor then
			lastWhy = ("d=%.1f: no floor"):format(d)
		elseif not (floor.Position.Y < feet + 0.9 and floor.Normal.Y > 0.7) then
			lastWhy = ("d=%.1f: floor at %.2f (%s) feet %.2f"):format(d, floor.Position.Y, floor.Instance.Name, feet)
		else
			local clear = not Workspace:Raycast(base + Vector3.new(0, 1.4, 0), dir * d, probeParams)
			local room = not Workspace:Raycast(Vector3.new(pt.X, floor.Position.Y + 0.6, pt.Z), Vector3.new(0, 4.2, 0), probeParams)
			if not (clear and room) then
				lastWhy = ("d=%.1f: clear=%s room=%s"):format(d, tostring(clear), tostring(room))
			end
			if clear and room then
				local stand = root.Size.Y / 2 + humanoid.HipHeight
				return { top = top.Position.Y, height = h, dir = dir, target = Vector3.new(pt.X, floor.Position.Y + stand, pt.Z), stand = stand }
			end
		end
	end
	return nil, "no landing: " .. lastWhy
end

local function runVault(v)
	local root, humanoid = State.root, State.humanoid
	State.vaulting = true
	State.sprinting = false
	Net.event("Action"):FireServer("Vault", { target = v.target })
	if Sfx.has("Vault") then
		Sfx.at(root.Position, "Vault", 0.8, 60, 0.05)
	end
	local start = root.Position
	local rest = Geometry.flat(v.dir)
	local apexY = math.max(start.Y, v.top + v.stand + 0.5)
	local control = (start + v.target) / 2
	control = Vector3.new(control.X, 2 * apexY - (start.Y + v.target.Y) / 2, control.Z)
	local duration = 0.42 + 0.06 * v.height + 0.025 * (v.target - start).Magnitude
	local t0 = os.clock()
	root.Anchored = true
	local conn
	local function finish()
		if conn then
			conn:Disconnect()
			conn = nil
		end
		if root.Parent then
			root.Anchored = false
			root.AssemblyLinearVelocity = rest * 7
		end
		State.vaulting = false
	end
	conn = RunService.RenderStepped:Connect(function()
		if not root.Parent or State.downed then
			finish()
			return
		end
		local k = math.clamp((os.clock() - t0) / duration, 0, 1)
		local e = k * k * (3 - 2 * k)
		local pos = start * (1 - e) ^ 2 + control * (2 * (1 - e) * e) + v.target * (e * e)
		root.CFrame = CFrame.lookAt(pos, pos + rest)
		root.AssemblyLinearVelocity = Vector3.zero
		if k >= 1 then
			finish()
		end
	end)
	task.delay(duration + 0.5, finish) -- never stay frozen
end

-- Test hook: what would a vault from the current character in direction `dir` do? (engine tests)
function MovementController.debugProbe(dir)
	local v, why = probeVault(Geometry.flat(dir).Unit)
	if not v then
		return { fail = why }
	end
	return { top = v.top, height = v.height, target = { v.target.X, v.target.Y, v.target.Z } }
end

-- Space / A: vault whatever is in front of you if you can; otherwise a short hop.
function MovementController.jumpOrVault()
	local root, humanoid = State.root, State.humanoid
	if not root or not humanoid or State.downed or State.uiOpen() or State.vaulting or State.prone or State.listening then
		return
	end
	local now = os.clock()
	if now < jumpReadyAt then
		return
	end
	local dir = humanoid.MoveDirection
	if dir.Magnitude < 0.1 then
		dir = root.CFrame.LookVector
	end
	dir = Geometry.flat(dir).Unit
	local v = probeVault(dir)
	if v then
		jumpReadyAt = now + 0.9
		if State.crouched then
			State.crouched = false
			send()
		end
		runVault(v)
		return
	end
	if State.aiming or humanoid.FloorMaterial == Enum.Material.Air then
		return
	end
	jumpReadyAt = now + 0.75
	if State.crouched then
		State.crouched = false
		send()
	end
	humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	Net.event("Action"):FireServer("Jump")
	if Sfx.has("Jump") then
		Sfx.at(root.Position, "Jump", 0.6, 50, 0.08)
	end
end

function MovementController.onCharacter()
	currentSpeed = 0
	lastSent = ""
	send()
end

local cachedMods, cachedKey = nil, nil
local function getMods()
	local key = tostring(player:GetAttribute("CharId")) .. tostring(player:GetAttribute("PerkId"))
	if key ~= cachedKey then
		cachedKey = key
		cachedMods = Stats.compute(player:GetAttribute("CharId"), player:GetAttribute("PerkId"))
	end
	return cachedMods
end

local function step(dt)
	local char, humanoid, root = State.character, State.humanoid, State.root
	if not char or not humanoid or not root or not root.Parent then
		return
	end
	local wasDowned = State.downed
	State.downed = char:GetAttribute("Downed") == true or char:GetAttribute("Out") == true
	if State.downed and not wasDowned then
		State.aiming, State.sprinting, State.crouched, State.prone = false, false, false, false
		send()
	end

	-- landing: the dip, the thud, and the noise other things can hear
	local airborne = humanoid.FloorMaterial == Enum.Material.Air
	if airborne then
		State.fallSpeed = math.max(State.fallSpeed or 0, -root.AssemblyLinearVelocity.Y)
	elseif State.wasAirborne then
		local fs = State.fallSpeed or 0
		if fs > 14 and not State.vaulting then
			State.landKick = math.clamp((fs - 10) * 0.012, 0.05, 0.4)
			if Sfx.has("Land") then
				Sfx.at(root.Position - Vector3.new(0, 2.5, 0), "Land", math.clamp(fs / 40, 0.3, 1), 70, 0.1)
			else
				Sfx.at(root.Position - Vector3.new(0, 2.5, 0), "Step", math.clamp(fs / 30, 0.4, 1), 70, 0.2)
			end
			Net.event("Action"):FireServer("Land", fs)
		end
		State.fallSpeed = 0
	end
	State.wasAirborne = airborne

	local busy = (char:GetAttribute("BusyUntil") or 0) > Workspace:GetServerTimeNow()
	local moving = humanoid.MoveDirection.Magnitude > 0.05
	local S = Movement.Speeds
	local target
	if char:GetAttribute("Out") then
		target = 0
	elseif State.downed then
		target = S.Downed
	elseif State.vaulting then
		target = 0
	elseif busy then
		target = 1.5
	elseif char:GetAttribute("Grabbing") then
		target = 5 -- dragging someone
	elseif State.listening then
		target = S.Crouch * 0.7 -- listening: you creep (and you can't shoot)
	elseif State.prone then
		target = State.aiming and S.Prone * 0.5 or S.Prone
	elseif State.aiming then
		target = State.crouched and S.Crouch * 0.8 or S.Aim
	elseif State.crouched then
		target = S.Crouch
	elseif State.sprinting then
		target = S.Sprint * getMods().sprintSpeedMult
	else
		target = S.Jog
	end
	if Geometry.inTagged(root.Position, "Shallows") then
		target *= Movement.WaterSpeedMult
	end
	if not moving then
		currentSpeed = math.min(currentSpeed, 4)
	end
	if target > currentSpeed then
		currentSpeed = math.min(target, currentSpeed + Movement.Accel * dt)
	else
		currentSpeed = math.max(target, currentSpeed - Movement.Decel * dt)
	end
	humanoid.WalkSpeed = currentSpeed

	-- aiming: the body faces the camera so you strafe around your target
	if (State.aiming or State.firstPerson or State.listening) and not State.downed and not State.vaulting then
		humanoid.AutoRotate = false
		local yaw = Controllers.CameraController.getYaw()
		local _, current = root.CFrame:ToEulerAnglesYXZ()
		local diff = (yaw - current + math.pi) % (2 * math.pi) - math.pi
		root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, current + diff * math.min(1, dt * 18), 0)
	else
		humanoid.AutoRotate = true
	end

	-- out of breath after a long sprint
	if State.sprinting then
		sprintTime += dt
	else
		if sprintTime > 4 and Sfx.has("Breath_Heavy") then
			Sfx.ui("Breath_Heavy", 0.45)
		end
		sprintTime = 0
	end

	stillTime = moving and 0 or stillTime + dt
	if State.sprinting and State.sprintToggled and stillTime > 0.6 then
		State.sprinting = false
		State.sprintToggled = false
		send()
	end

	-- replicate aim pitch for other players' upper-body pose
	if State.aiming then
		local now = os.clock()
		if now - lastLookAt > 0.12 and math.abs(State.pitch - lastLookSent) > 0.04 then
			lastLookAt = now
			lastLookSent = State.pitch
			Net.event("Look"):FireServer(State.pitch)
		end
	end
end

function MovementController.init(registry)
	Controllers = registry
end

function MovementController.start()
	RunService:BindToRenderStep("AftertideMovement", Enum.RenderPriority.Input.Value + 1, step)
end

return MovementController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000004D"><Properties><string name="Name">PlayerAnimator</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Procedural full-body animation for every crew character (replaces Roblox's default
-- Animate script, so movement doesn't look like a Roblox avatar). Runs on each client for
-- all characters from replicated velocity + attributes:
--   locomotion  walk / jog / sprint gait with stride, knee lift, ankle roll, hip bob,
--               counter-rotating torso, arm swing; backpedal + strafe while aiming
--   stances     crouch + crouch-walk, downed crawl
--   weapons     carry (ready) and aim poses for long guns / sidearms, aim pitch, reload,
--               draw from back / hip on swap
--   actions     melee combo swings, dodge / dive, throw, takedown, field dressing
--   idle        breathing, weight shift
-- Cues come from server-set character attributes: MeleeAt, MeleeCombo, DodgeAt, DodgeDive,
-- ThrowAt, TakedownAt, HealAt, ReloadUntil, Equipped(Slot), Aim, AimPitch, Stance, Downed.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Movement = require(Shared.Config.Movement)
local WeaponModels = require(Shared.WeaponModels)
local State = require(script.Parent.Parent.State)

local PlayerAnimator = {}
local player = Players.LocalPlayer
local rigs = setmetatable({}, { __mode = "k" })

-- What the animator is doing, for the F2 diagnostics panel.
local diag = { setupFail = "not started", lastError = nil, animatedLastFrame = 0, frames = 0, animatorsRemoved = 0 }
function PlayerAnimator.status()
	return diag
end

local JOINTS = {
	root = { "LowerTorso", "Root" },
	waist = { "UpperTorso", "Waist" },
	neck = { "Head", "Neck" },
	ls = { "LeftUpperArm", "LeftShoulder" },
	rs = { "RightUpperArm", "RightShoulder" },
	le = { "LeftLowerArm", "LeftElbow" },
	re = { "RightLowerArm", "RightElbow" },
	lw = { "LeftHand", "LeftWrist" },
	rw = { "RightHand", "RightWrist" },
	lh = { "LeftUpperLeg", "LeftHip" },
	rh = { "RightUpperLeg", "RightHip" },
	lk = { "LeftLowerLeg", "LeftKnee" },
	rk = { "RightLowerLeg", "RightKnee" },
	la = { "LeftFoot", "LeftAnkle" },
	ra = { "RightFoot", "RightAnkle" },
}

local function setup(char)
	if not char:GetAttribute("Procedural") then
		diag.setupFail = "waiting for the server to mark the character (Procedural attribute)"
		return nil
	end
	local rig = { joints = {}, phase = 0, crouch = 0, aim = 0, ready = 0, lastSlot = "none", drawAt = -10, seed = math.random() * 10 }
	for key, path in JOINTS do
		local part = char:FindFirstChild(path[1])
		local motor = part and part:FindFirstChild(path[2])
		if not (motor and motor:IsA("Motor6D")) then
			diag.setupFail = ("joint missing: %s.%s"):format(path[1], path[2])
			return nil
		end
		rig.joints[key] = motor
	end
	rig.root = char:FindFirstChild("HumanoidRootPart")
	rig.humanoid = char:FindFirstChildOfClass("Humanoid")
	if not rig.root or not rig.humanoid then
		return nil
	end
	-- an Animator overwrites Motor6D.Transform every frame: make sure none survives here
	-- (the server removes it too; this covers one created locally before that replicated)
	local function kill(child)
		if child:IsA("Animator") then
			diag.animatorsRemoved += 1
			pcall(function()
				for _, track in child:GetPlayingAnimationTracks() do
					track:Stop(0)
				end
			end)
			task.defer(function()
				pcall(child.Destroy, child)
			end)
		end
	end
	for _, child in rig.humanoid:GetChildren() do
		kill(child)
	end
	rig.humanoid.ChildAdded:Connect(kill)
	diag.setupFail = nil
	return rig
end

local function ang(x, y, z)
	return CFrame.Angles(x or 0, y or 0, z or 0)
end

local function since(char, attr, serverNow)
	local at = char:GetAttribute(attr)
	return at and (serverNow - at) or math.huge
end

local function approach(current, target, rate, dt)
	return current + (target - current) * math.min(1, dt * rate)
end

-- Two-bone IK: solves the left shoulder + elbow so the left hand lands on `target` (world).
-- Works in the shoulder joint's frame. The elbow is a hinge about the upper arm's X axis
-- (positive = forearm forward), the same convention the procedural poses use.
local POLES = { L = Vector3.new(-0.55, -1, 0.2), R = Vector3.new(0.55, -1, 0.2) } -- elbows down and out

-- This frame's posed CFrames of the torso parts, from the root part through the joints we just
-- set. (The parts' own CFrames still hold last frame's pose until physics runs: using them made
-- the hands miss the gun whenever the body moved quickly, e.g. dropping prone.)
local function posedTorso(J)
	local hrp = J.root.Part0
	local lower = hrp.CFrame * J.root.C0 * J.root.Transform * J.root.C1:Inverse()
	local upper = lower * J.waist.C0 * J.waist.Transform * J.waist.C1:Inverse()
	return upper, lower
end

local function solveArm(J, side, target, torsoCF)
	local shoulder, elbow, wrist = J[side == "L" and "ls" or "rs"], J[side == "L" and "le" or "re"], J[side == "L" and "lw" or "rw"]
	local torso, upper, lower = shoulder.Part0, shoulder.Part1, elbow.Part1
	local hand = wrist.Part1
	if not (torso and upper and lower and hand) then
		return nil
	end
	local a = (elbow.C0.Position - shoulder.C1.Position).Magnitude
	local b = (wrist.C0.Position - elbow.C1.Position).Magnitude + hand.Size.Y * 0.45
	local frame = (torsoCF or torso.CFrame) * shoulder.C0
	local t = frame:PointToObjectSpace(target)
	if t.Magnitude < 1e-3 then
		return nil
	end
	local d = math.clamp(t.Magnitude, math.abs(a - b) + 0.05, a + b - 0.02)
	local cosB = math.clamp((d * d - a * a - b * b) / (2 * a * b), -1, 1)
	local beta = math.acos(cosB) -- elbow flex
	local h = Vector3.new(0, -a - b * math.cos(beta), -b * math.sin(beta))
	local u1 = h.Unit
	local u2 = Vector3.new(1, 0, 0)
	local u3 = u1:Cross(u2)
	local e3 = Vector3.new(0, -a, 0):Dot(u3)
	local w1 = t.Unit
	local pole = POLES[side]
	local q = pole - w1 * pole:Dot(w1)
	if q.Magnitude < 1e-3 then
		return nil
	end
	q = q.Unit
	local w3 = e3 >= 0 and q or -q
	local w2 = w3:Cross(w1)
	local function R(v)
		return w1 * u1:Dot(v) + w2 * u2:Dot(v) + w3 * u3:Dot(v)
	end
	local rot = CFrame.fromMatrix(Vector3.zero, R(Vector3.xAxis), R(Vector3.yAxis), R(Vector3.zAxis))
	return rot, CFrame.Angles(beta, 0, 0)
end

-- Gun poses, as the grip's CFrame in UpperTorso space (barrel along -Z).
local GUN_POSES = {
	long = {
		ready = CFrame.new(0.3, -0.05, -0.95) * CFrame.Angles(-0.55, 0.45, 0.25), -- low ready, across the body
		sprint = CFrame.new(0.25, 0.05, -0.8) * CFrame.Angles(-0.9, 0.9, 0.4),
		aim = CFrame.new(0.36, 0.42, -0.7), -- stock in the shoulder pocket
		reload = CFrame.new(0.15, -0.1, -0.95) * CFrame.Angles(-0.2, 0.55, 0.75), -- rolled toward you
	},
	sidearm = {
		ready = CFrame.new(0.35, -0.25, -0.95) * CFrame.Angles(-0.7, 0.15, 0),
		sprint = CFrame.new(0.45, -0.45, -0.7) * CFrame.Angles(-1.2, 0.1, 0),
		aim = CFrame.new(0.12, 0.42, -1.75), -- arms out, two-handed
		reload = CFrame.new(0.1, 0.05, -1.0) * CFrame.Angles(0.9, 0.2, 0.5), -- muzzle up, cylinder open
	},
}
-- The same, for your own view in first person: the gun sits low and to the right, pointing at
-- the crosshair, and rises to just under it when you aim.
local GUN_POSES_FP = {
	long = {
		ready = CFrame.new(0.3, 0.34, -0.55) * CFrame.Angles(0.04, 0.1, 0),
		sprint = CFrame.new(0.3, 0.05, -0.5) * CFrame.Angles(-0.6, 0.5, 0.2),
		aim = CFrame.new(0.12, 0.5, -0.55),
		reload = CFrame.new(0.2, 0.22, -0.55) * CFrame.Angles(-0.1, 0.45, 0.75),
	},
	sidearm = {
		ready = CFrame.new(0.28, 0.3, -0.6) * CFrame.Angles(0.08, 0.08, 0),
		sprint = CFrame.new(0.3, 0.05, -0.45) * CFrame.Angles(-0.8, 0.1, 0),
		aim = CFrame.new(0.1, 0.46, -0.75),
		reload = CFrame.new(0.15, 0.4, -0.55) * CFrame.Angles(0.9, 0.2, 0.5),
	},
}
-- where the left hand goes while reloading (grip space): magazine / loading gate / cylinder
local RELOAD_HAND = { long = Vector3.new(0, -0.12, -0.45), sidearm = Vector3.new(-0.12, 0.25, -0.15) }

local shotAt = setmetatable({}, { __mode = "k" }) -- [character] = os.clock() of its last shot

function PlayerAnimator.noteShot(char)
	if char then
		shotAt[char] = os.clock()
	end
end

-- Moving parts: a gun layer (forend, cylinder, arrow...) gets a local Weld we can drive.
-- Every client builds its own, so everyone sees the same motion.
local function movePart(model, layer, offset, aboutCentre)
	local grip = model.PrimaryPart
	local mp = model:FindFirstChild("Mesh_" .. layer)
	if not (grip and mp and mp:IsA("BasePart")) then
		return nil
	end
	local w = mp:FindFirstChild("AnimWeld")
	if not w then
		local rest = grip.CFrame:ToObjectSpace(mp.CFrame)
		for _, c in mp:GetChildren() do
			if c:IsA("WeldConstraint") then
				c.Enabled = false
			end
		end
		w = Instance.new("Weld")
		w.Name = "AnimWeld"
		w.Part0, w.Part1, w.C0 = grip, mp, rest
		w:SetAttribute("Rest", rest) -- kept on the weld (a weak Lua table can lose it)
		w.Parent = mp
	end
	local rest = w:GetAttribute("Rest") or w.C0
	if aboutCentre then
		w.C0 = CFrame.new(rest.Position) * offset * CFrame.new(-rest.Position) * rest
	else
		w.C0 = offset * rest
	end
	return mp, rest
end

local function bell(t, a, b)
	if t <= a or t >= b then
		return 0
	end
	return math.sin((t - a) / (b - a) * math.pi)
end
local function ramp(t, a, b)
	local k = math.clamp((t - a) / (b - a), 0, 1)
	return k * k * (3 - 2 * k)
end

-- Per-weapon action after a shot and during a reload. Returns:
--   poseMul  (applied to the gun pose), rightOff / leftAt (grip-space hand targets or nil),
--   leftWorld (a world hand target, e.g. the ammo pouch on the belt), handled (left hand set)
local function weaponAction(char, rig, model, id, since, reloading, rk, a, lowerCF)
	local poseMul, rightOff, leftAt, leftWorld = CFrame.new(), nil, nil, nil
	local now = os.clock()
	local belt = (lowerCF * CFrame.new(-0.42, -0.05, -0.38)).Position -- ammo pouch, left front
	local function loadCycle(rate, target)
		-- left hand: pouch -> port -> pouch, over and over
		local c = (now * rate) % 1
		local k = c < 0.5 and ramp(c, 0, 0.5) or 1 - ramp(c, 0.5, 1)
		return k, target
	end
	if id == "revolver" then
		-- the cylinder turns one chamber per shot; the muzzle flips up
		local stamp = shotAt[char]
		if stamp and rig.lastShotStamp ~= stamp then
			rig.lastShotStamp = stamp
			rig.cylTarget = (rig.cylTarget or 0) + math.pi / 3
		end
		rig.cyl = (rig.cyl or 0) + ((rig.cylTarget or 0) - (rig.cyl or 0)) * 0.35
		poseMul = CFrame.Angles(0.32 * bell(since, 0, 0.32), 0, 0)
		local out = reloading and (ramp(rk, 0, 0.15) * (1 - ramp(rk, 0.85, 1))) or 0
		movePart(model, "Cylinder", CFrame.new(-0.16 * out, -0.03 * out, 0) * CFrame.Angles(0, 0, rig.cyl + out * 0.6), true)
		if reloading then
			if rk < 0.3 then
				leftAt = Vector3.new(-0.12, 0.3, -0.2) -- thumb the ejector
			else
				local k = loadCycle(3, nil)
				leftWorld = { belt, Vector3.new(-0.2, 0.22, -0.16), k }
			end
		end
	elseif id == "shotgun" then
		local pump = bell(since, 0.2, 0.62)
		movePart(model, "Forend", CFrame.new(0, 0, 0.32 * pump))
		leftAt = Vector3.new(0, 0.05, -1.03 + 0.32 * pump)
		if reloading then
			poseMul = CFrame.Angles(0, 0, 1.1) -- loading port up
			local k = loadCycle(1.7, nil)
			leftWorld = { belt, Vector3.new(0, -0.12, -0.38), k }
		end
	elseif id == "carbine" then
		local lever = bell(since, 0.12, 0.5)
		poseMul = CFrame.Angles(0.12 * lever, 0, 0) * CFrame.new(0, -0.04 * lever, 0)
		rightOff = Vector3.new(0, -0.22 * lever, 0.06 * lever)
		if reloading then
			poseMul = CFrame.Angles(0, 0, -0.55) -- gate side towards you
			local k = loadCycle(1.5, nil)
			leftWorld = { belt, Vector3.new(0.12, 0.02, -0.22), k }
		end
	elseif id == "rifle" then
		local reach = bell(since, 0.3, 1.15)
		local pull = bell(since, 0.48, 0.98)
		if reloading then
			reach = ramp(rk, 0, 0.1) * (1 - ramp(rk, 0.9, 1))
			pull = reach
			local k = loadCycle(1.4, nil)
			leftWorld = { belt, Vector3.new(0, 0.24, -0.2), k }
		end
		rightOff = Vector3.new(0.2 * reach, 0.16 * reach, 0.28 * pull)
		poseMul = CFrame.Angles(0, 0, 0.22 * reach)
	elseif id == "bow" then
		-- draw while aiming; the arrow is gone after a shot until the next is nocked
		local nock = ramp(since, 0.55, 0.95)
		local draw = a * nock
		local arrow = movePart(model, "Arrow", CFrame.new(0, 0, 0.38 * draw))
		if arrow then
			arrow.LocalTransparencyModifier = (since < 0.55 or reloading) and 1 or 0
		end
		leftAt = Vector3.new(0, 0.08, 0.05 + 0.36 * draw)
		if reloading or since < 0.55 then
			-- reach back over the shoulder for an arrow
			leftWorld = { (lowerCF * CFrame.new(-0.35, 2.1, 0.55)).Position, Vector3.new(0, 0.08, 0.05), 1 - math.abs(((now * 1.4) % 1) * 2 - 1) }
		end
	end
	return poseMul, rightOff, leftAt, leftWorld
end

-- Places the held gun (client-side, every frame) and IKs both hands onto it.
local function poseGun(char, rig, J, slot, a, sprinting, reloading, drawK, pitch)
	local torso = char:FindFirstChild("UpperTorso")
	local model = char:FindFirstChild("Weapon_" .. slot)
	local grip = model and model.PrimaryPart
	local weld = grip and grip:FindFirstChild("Mount")
	local set = (rig.fp and GUN_POSES_FP[slot]) or GUN_POSES[slot]
	if not (torso and weld and set) then
		return false
	end
	local now = os.clock()
	local pose = set.ready
	if rig.fp and not reloading and a < 0.5 and not sprinting then
		pose = pose * CFrame.Angles(pitch * 0.6, 0, 0) -- the gun follows where you look
	end
	if reloading then
		local wobble = math.sin(now * 6) * 0.04
		pose = set.reload * CFrame.new(0, wobble, 0) * CFrame.Angles(wobble, 0, 0)
	elseif a > 0.01 then
		local aimPose = set.aim * CFrame.Angles(pitch * 0.55, 0, 0)
		pose = (sprinting and set.sprint or set.ready):Lerp(aimPose, a)
	elseif sprinting then
		pose = set.sprint
	end
	local since = now - (shotAt[char] or -10)
	-- living hands: breathing sway at rest, a bob in step with your feet when moving, a lift
	-- as the gun comes up to aim
	local t = now + (rig.seed or 0)
	local moving = rig.moving or 0
	local steady = 1 - 0.75 * a
	local p = rig.phase or 0
	pose = pose
		* CFrame.new(math.sin(p) * 0.025 * moving, -math.abs(math.cos(p)) * 0.035 * moving + math.sin(t * 1.6) * 0.006 * steady, 0)
		* CFrame.Angles(math.sin(t * 1.3) * 0.008 * steady + math.cos(p * 2) * 0.015 * moving, math.sin(t * 0.9) * 0.01 * steady + math.sin(p) * 0.025 * moving, math.sin(p) * 0.02 * moving)
	if a > 0.05 and a < 0.95 then
		pose = pose * CFrame.new(0, 0.1 * math.sin(a * math.pi), 0) * CFrame.Angles(0.12 * math.sin(a * math.pi), 0, 0)
	end
	-- weapon check: standing idle with the gun out, now and then you turn it over and look at it
	if a < 0.05 and moving < 0.1 and not reloading and since > 6 then
		rig.fidgetAt = rig.fidgetAt or (now + 8 + math.random() * 6)
		local f = now - rig.fidgetAt
		if f > 0 and f < 2.6 then
			local k = math.sin(f / 2.6 * math.pi)
			pose = pose * CFrame.new(-0.1 * k, 0.25 * k, 0.15 * k) * CFrame.Angles(0.25 * k, 0.35 * k, 0.95 * k)
		elseif f >= 2.6 then
			rig.fidgetAt = now + 10 + math.random() * 8
		end
	else
		rig.fidgetAt = nil
	end
	-- recoil: a hard kick back into the shoulder and up, settling fast
	local recoilLen = slot == "long" and 0.32 or 0.26
	if since < recoilLen then
		local k = (1 - since / recoilLen) ^ 2
		if slot == "long" then
			pose = pose * CFrame.new(0, 0.06 * k, 0.32 * k) * CFrame.Angles(0.24 * k, 0.03 * k, 0)
		else
			pose = pose * CFrame.new(0, 0.05 * k, 0.2 * k) * CFrame.Angles(0.38 * k, 0, 0.05 * k)
		end
	end
	local upperCF, lowerCF = posedTorso(J)
	-- the gun's own action: lever / pump / bolt / cylinder / bow draw, and per-gun reloads
	local id = char:GetAttribute("Equipped")
	local serverNow = Workspace:GetServerTimeNow()
	local rk = 0
	if reloading then
		local untilT = char:GetAttribute("ReloadUntil") or 0
		if untilT > serverNow then
			rk = math.clamp(1 - (untilT - serverNow) / math.max(char:GetAttribute("ReloadDur") or 2.5, 0.1), 0, 1)
		else
			rk = (now * 0.5) % 1 -- shell by shell: keep cycling
		end
	end
	local okAct, poseMul, rightOff, leftAt, leftWorld = pcall(weaponAction, char, rig, model, id, since, reloading, rk, a, lowerCF)
	if not okAct then
		poseMul, rightOff, leftAt, leftWorld = CFrame.new(), nil, nil, nil
	end
	pose = pose * (poseMul or CFrame.new())
	-- drawing: from where it was holstered into the hands
	if drawK < 1 then
		local holster = slot == "long" and WeaponModels.BackOffset or (upperCF:ToObjectSpace(lowerCF) * WeaponModels.HipOffset)
		pose = holster:Lerp(pose, drawK * drawK * (3 - 2 * drawK))
	end
	local anchor, anchorCF = torso, upperCF
	if (rig.prone or 0) > 0.5 then
		-- prone: the gun rests out in front of you, just off the ground
		local hrp = rig.root
		local standH = (rig.baseHip or rig.humanoid.HipHeight) + hrp.Size.Y / 2
		anchor, anchorCF = hrp, hrp.CFrame
		pose = CFrame.new(slot == "long" and 0.35 or 0.2, -(standH - 0.95), slot == "long" and -1.9 or -2.3) * CFrame.Angles(pitch * 0.4, 0, 0)
	end
	weld.Part0 = anchor
	weld.C0 = pose
	weld.C1 = CFrame.new()
	rig.posedWeld = weld
	-- hands onto the gun
	local gripWorld = anchorCF * pose
	local rightTarget = rightOff and (gripWorld * rightOff) or gripWorld.Position
	local support = grip:FindFirstChild("Support")
	local leftTarget = support and (gripWorld * support.CFrame).Position or nil
	if leftAt then
		leftTarget = gripWorld * leftAt
	end
	if leftWorld then
		-- between the ammo pouch (world) and the gun (grip space)
		leftTarget = leftWorld[1]:Lerp(gripWorld * leftWorld[2], leftWorld[3])
	elseif reloading and not leftAt then
		local cycle = (math.sin(now * 5) * 0.5 + 0.5)
		leftTarget = (gripWorld * CFrame.new(RELOAD_HAND[slot] + Vector3.new(0, -0.25 * cycle, 0.1 * cycle))).Position
	elseif drawK < 0.6 then
		leftTarget = nil -- the off hand joins once the gun is out
	end
	local ok, rs, re = pcall(solveArm, J, "R", rightTarget, upperCF)
	if ok and rs then
		J.rs.Transform, J.re.Transform = rs, re
		J.rw.Transform = CFrame.Angles(-0.2, 0, 0)
	end
	if leftTarget and (slot == "long" or a > 0.3 or reloading) then
		local okL, ls, le = pcall(solveArm, J, "L", leftTarget, upperCF)
		if okL and ls then
			J.ls.Transform, J.le.Transform = ls, le
			J.lw.Transform = CFrame.Angles(0.3, 0, 0)
		end
	end
	return true
end

local function animate(char, rig, dt, serverNow, isLocal)
	local J = rig.joints
	local root = rig.root
	local v = root.AssemblyLinearVelocity
	local flat = Vector3.new(v.X, 0, v.Z)
	local speed = flat.Magnitude
	local localVel = root.CFrame:VectorToObjectSpace(flat)
	local fwd, side = -localVel.Z, localVel.X

	local downed = char:GetAttribute("Downed") == true or char:GetAttribute("Out") == true
	local crouched = (isLocal and State.crouched or char:GetAttribute("Stance") == "Crouch") and not (isLocal and State.prone)
	local equipped = char:GetAttribute("Equipped")
	local armed = equipped ~= nil and equipped ~= "" and not downed
	local slot = char:GetAttribute("EquippedSlot") or "none"
	local longGun = slot == "long"
	local aiming = armed and (isLocal and State.aiming or char:GetAttribute("Aim") == true)
	local pitch = isLocal and State.pitch or (char:GetAttribute("AimPitch") or 0)

	if slot ~= rig.lastSlot then
		rig.lastSlot = slot
		rig.drawAt = os.clock()
		rig.drawSlot = slot
	end

	rig.crouch = approach(rig.crouch, (crouched or downed) and 1 or 0, 10, dt)
	rig.aim = approach(rig.aim, aiming and 1 or 0, 14, dt)
	rig.ready = approach(rig.ready, armed and 1 or 0, 10, dt)
	rig.fp = isLocal and State.firstPerson == true and not downed
	local c, a, r = rig.crouch, rig.aim, rig.ready * (1 - rig.aim)

	-- gait
	local moving = math.clamp(speed / 2.5, 0, 1)
	local run = math.clamp((speed - Movement.Speeds.Walk) / (Movement.Speeds.Sprint - Movement.Speeds.Walk), 0, 1)
	local stride = 2.0 + 2.2 * run
	rig.phase += dt * (speed / stride) * math.pi
	local p = rig.phase
	local back = (fwd < -1 and math.abs(fwd) > math.abs(side)) and -1 or 1
	local strafe = math.abs(side) > math.abs(fwd) * 1.2 and math.clamp(side / 8, -1, 1) or 0
	local amp = (0.34 + 0.42 * run) * moving * (1 - 0.45 * c)
	local sL, sR = math.sin(p), math.sin(p + math.pi)

	local lHip = sL * amp * back * (1 - math.abs(strafe))
	local rHip = sR * amp * back * (1 - math.abs(strafe))
	local hipRollL, hipRollR = sL * amp * strafe * 0.7, sR * amp * strafe * 0.7
	local liftL = math.max(0, math.sin(p + 1.3)) * (0.5 + 1.0 * run) * moving
	local liftR = math.max(0, math.sin(p + math.pi + 1.3)) * (0.5 + 1.0 * run) * moving
	local lKnee, rKnee = -liftL - 0.06, -liftR - 0.06
	local lAnk, rAnk = liftL * 0.35 - lHip * 0.25, liftR * 0.35 - rHip * 0.25
	local bob = -math.abs(math.cos(p)) * (0.05 + 0.1 * run) * moving
	local leanFwd = (0.04 + 0.2 * run) * moving * (back > 0 and 1 or -0.5)
	local twist = math.sin(p) * (0.06 + 0.1 * run) * moving
	local t = os.clock() + rig.seed
	local breathe = math.sin(t * 1.7) * 0.025 * (1 - moving)
	local shift = math.sin(t * 0.35) * 0.04 * (1 - moving)

	-- crouch pose blended in
	lHip += 1.1 * c
	rHip += 1.1 * c
	lKnee -= 1.6 * c
	rKnee -= 1.6 * c
	lAnk += 0.5 * c
	rAnk += 0.5 * c
	local waistLean = -(0.42 * c) - leanFwd * 0.6 + breathe

	-- arms: natural swing (unarmed)
	local swing = (0.35 + 0.55 * run) * moving * (1 - 0.6 * c)
	local lSh, rSh = -sL * swing * back + 0.05, -sR * swing * back + 0.05
	local lEl, rEl = 0.2 + 0.9 * run * moving, 0.2 + 0.9 * run * moving
	local lShZ, rShZ = -0.06, 0.06
	local lShY, rShY = 0, 0

	-- weapon carry / aim (two-handed); aim pitch bends the upper body
	if rig.ready > 0.01 or a > 0.01 then
		local hold = math.max(r, a)
		local pp = pitch * a
		waistLean += pp * 0.45
		local aimR = 1.55 + pp * 0.5
		local readyR = longGun and 0.75 or 0.5
		rSh = rSh * (1 - hold) + (aimR * a + readyR * r)
		rEl = rEl * (1 - hold) + (0.12 * a + (longGun and 1.1 or 0.9) * r)
		rShZ = rShZ * (1 - hold) + (longGun and 0.2 or 0.1) * hold
		if longGun or a > 0.01 then
			local lh = longGun and hold or a
			lSh = lSh * (1 - lh) + ((1.45 + pp * 0.5) * a + 0.85 * r) * (lh > 0 and 1 or 0)
			lEl = lEl * (1 - lh) + ((longGun and 0.6 or 0.4) * a + 1.0 * r)
			lShZ = lShZ * (1 - lh) + (longGun and 0.6 or 0.8) * lh
			lShY = (longGun and -0.3 or -0.2) * lh
		end
	end

	-- reload: left hand works the weapon, gun tilts in
	local reloadUntil = char:GetAttribute("ReloadUntil") or 0
	if (reloadUntil > serverNow or char:GetAttribute("Reloading") == true) and armed then
		local cycle = math.sin((serverNow % 0.8) / 0.8 * math.pi * 2)
		lSh = 0.9 + cycle * 0.15
		lEl = 1.3 + cycle * 0.2
		lShZ = 0.7
		rSh = math.min(rSh, 0.8)
		waistLean -= 0.08
	end

	-- draw / holster: reach over the shoulder (long) or down to the hip (sidearm)
	local drawT = os.clock() - rig.drawAt
	if drawT < 0.4 then
		local k = math.sin(drawT / 0.4 * math.pi)
		if rig.drawSlot == "long" or (rig.drawSlot == "none" and longGun) then
			rSh = rSh + (2.7 - rSh) * k
			rEl = rEl + (1.4 - rEl) * k
			rShZ = rShZ + 0.3 * k
		else
			rSh = rSh + (-0.3 - rSh) * k
			rShZ = rShZ + 0.25 * k
		end
	end

	-- one-shot actions (server cues)
	local rootX, rootZ, rootY = -leanFwd, 0, 0
	local rootOffset = Vector3.new(0, bob, 0)

	local melee = since(char, "MeleeAt", serverNow)
	if melee < 0.45 then
		local combo = char:GetAttribute("MeleeCombo") or 1
		local k = melee / 0.45
		local wind = k < 0.3 and (k / 0.3) or (1 - (k - 0.3) / 0.7)
		local dir = combo == 2 and -1 or 1
		if combo == 3 then
			-- overhead finisher with both arms
			rSh, lSh = 2.6 * wind + 0.4, 2.4 * wind + 0.4
			rEl, lEl = 0.6, 0.6
			waistLean += 0.35 * (1 - wind) - 0.2 * wind
		else
			local arm = dir > 0 and "r" or "l"
			local raise, elbow = 1.7 * wind + 0.3, 1.2 * wind + 0.3
			if arm == "r" then
				rSh, rEl, rShZ = raise, elbow, 0.3 + 0.8 * wind
			else
				lSh, lEl, lShZ = raise, elbow, -0.3 - 0.8 * wind
			end
			rootY = dir * (0.5 * wind - 0.4 * (1 - wind))
		end
		rootX -= 0.15
	end

	local dodge = since(char, "DodgeAt", serverNow)
	local dive = char:GetAttribute("DodgeDive") == true
	local dodgeLen = dive and 0.75 or 0.45
	if dodge < dodgeLen then
		local k = math.sin(dodge / dodgeLen * math.pi)
		if dive then
			rootX -= 1.1 * k
			rootOffset += Vector3.new(0, -0.9 * k, 0)
			lSh, rSh = 2.4 * k, 2.4 * k
			lEl, rEl = 0.3, 0.3
			lHip, rHip = -0.2 * k, -0.3 * k
			lKnee, rKnee = -0.4 * k, -0.6 * k
		else
			rootX -= 0.35 * k
			rootZ += (side > 0 and -0.35 or 0.35) * k
			lHip += 0.7 * k
			rHip += 0.7 * k
			lKnee -= 1.1 * k
			rKnee -= 1.1 * k
			rootOffset += Vector3.new(0, -0.45 * k, 0)
		end
	end

	local throw = since(char, "ThrowAt", serverNow)
	if throw < 0.5 then
		local k = throw / 0.5
		if k < 0.35 then
			rSh, rEl, rShZ = -0.6 - (k / 0.35) * 1.2, 1.2, 0.2 -- wind back
		else
			local f = (k - 0.35) / 0.65
			rSh, rEl, rShZ = -1.8 + f * 4.2, 1.2 - f * 1.0, 0.1 -- release overhead
		end
		rootY += 0.25 * math.sin(k * math.pi)
	end

	local takedown = since(char, "TakedownAt", serverNow)
	if takedown < 1.2 then
		local k = math.min(1, takedown / 0.2) * math.max(0, math.min(1, (1.2 - takedown) / 0.3))
		lSh, rSh = lSh + (1.4 - lSh) * k, rSh + (1.5 - rSh) * k
		lEl, rEl = 1.3 * k, 1.1 * k
		lShZ, rShZ = 0.5 * k, -0.4 * k
		waistLean -= 0.3 * k
	end

	local heal = since(char, "HealAt", serverNow)
	if heal < 2.2 then
		local k = math.min(1, heal / 0.25) * math.max(0, math.min(1, (2.2 - heal) / 0.3))
		-- wrapping a dressing round the forearm, hands in front of the stomach, head down
		local work = math.sin(heal * 9) * 0.12
		lSh, rSh = 0.5 * k + lSh * (1 - k), 0.42 * k + rSh * (1 - k)
		lEl, rEl = 1.55 * k + work, 1.45 * k - work
		lShZ, rShZ = 0.5 * k, -0.5 * k
		lShY, rShY = 0.25 * k, -0.25 * k
		waistLean -= 0.15 * k
	end

	-- digging a gun out of the backpack: down on one knee, both hands behind
	local packT = since(char, "PackAt", serverNow)
	if packT < 2.4 then
		local k = math.min(1, packT / 0.3) * math.max(0, math.min(1, (2.4 - packT) / 0.3))
		lHip, rHip = lHip + 1.4 * k, rHip + 0.3 * k
		lKnee, rKnee = lKnee - 1.7 * k, rKnee - 1.9 * k
		rootOffset += Vector3.new(0, -1.0 * k, 0)
		lSh, rSh = lSh * (1 - k) - 0.8 * k, rSh * (1 - k) - 0.9 * k
		lEl, rEl = 1.4 * k, 1.5 * k
		waistLean -= 0.3 * k
	end

	-- holding someone: left arm round their neck, right arm in front
	if char:GetAttribute("Grabbing") then
		lSh, lEl, lShZ = 1.6, 1.9, 0.6
		if not armed then
			rSh, rEl, rShZ = 1.3, 1.6, -0.4
		end
		waistLean -= 0.05
	end

	if downed then
		-- slumped, crawling on one arm
		local crawl = math.sin(p) * 0.4 * moving
		waistLean = -0.9
		rootX = -0.35
		lHip, rHip = 1.4, 1.2
		lKnee, rKnee = -1.9, -1.7
		lSh, rSh = 1.0 + crawl, 0.4 - crawl
		lEl, rEl = 1.2, 0.8
	end

	-- prone: flat on the belly, head up, crawling on elbows and knees
	local prone = (isLocal and State.prone or char:GetAttribute("Stance") == "Prone") and not downed
	rig.prone = approach(rig.prone or 0, prone and 1 or 0, 7, dt)
	local pk = rig.prone
	if pk > 0.01 then
		local crawl = math.sin(p) * 0.35 * moving
		local standH = (rig.baseHip or rig.humanoid.HipHeight) + root.Size.Y / 2
		local function mix(x, y)
			return x + (y - x) * pk
		end
		rootX = mix(rootX, -1.45)
		rootOffset = rootOffset:Lerp(Vector3.new(0, -(standH - 0.7), 0), pk)
		waistLean = mix(waistLean, 0.12)
		lHip, rHip = mix(lHip, -0.05 + crawl), mix(rHip, -0.05 - crawl)
		lKnee, rKnee = mix(lKnee, -0.15 - math.max(0, crawl) * 1.5), mix(rKnee, -0.15 - math.max(0, -crawl) * 1.5)
		lSh, rSh = mix(lSh, 1.55 + crawl), mix(rSh, 1.55 - crawl)
		lEl, rEl = mix(lEl, 1.3), mix(rEl, 1.3)
		lShZ, rShZ = mix(lShZ, -0.35), mix(rShZ, 0.35)
	end

	-- shooting moves the whole body: shoulders rock back, then settle
	local shotK = 0
	if armed then
		local ss = os.clock() - (shotAt[char] or -10)
		if ss < 0.35 then
			shotK = (1 - ss / 0.35) ^ 2 * (longGun and 1 or 0.6)
			waistLean -= 0.14 * shotK
			rootY -= 0.05 * shotK
		end
	end
	rig.moving = moving

	-- in the air: a hop tucks the legs and lifts the arms; landing is soft in the knees
	local vy = v.Y
	local air = rig.humanoid.FloorMaterial == Enum.Material.Air and math.abs(vy) > 1 and not downed and (rig.prone or 0) < 0.2
	rig.air = approach(rig.air or 0, air and 1 or 0, air and 16 or 10, dt)
	local ak = rig.air
	if ak > 0.01 then
		local up = math.clamp(vy / 22, -1, 1)
		lHip += (0.9 - 0.3 * up) * ak
		rHip += (-0.15 + 0.2 * up) * ak
		lKnee -= (1.1 - 0.3 * up) * ak
		rKnee -= (0.4 + 0.2 * up) * ak
		lAnk += 0.3 * ak
		lSh += (0.45 + 0.2 * up) * ak
		rSh += (0.45 + 0.2 * up) * ak
		waistLean -= 0.08 * ak
	end
	-- vaulting: hands plant on the obstacle, one knee drives over, the body folds forward
	local vaultT = since(char, "VaultAt", serverNow)
	if vaultT < 0.8 then
		local k = math.sin(math.min(1, vaultT / 0.8) * math.pi)
		lSh, rSh = lSh + (1.5 - lSh) * k, rSh + (1.45 - rSh) * k -- reaching forward and down onto the edge
		lEl, rEl = lEl + (0.45 - lEl) * k, rEl + (0.5 - rEl) * k
		lShZ, rShZ = lShZ + (-0.15 - lShZ) * k, rShZ + (0.15 - rShZ) * k
		lHip += 1.5 * k
		lKnee -= 1.7 * k
		rHip += 0.45 * k
		rKnee -= 0.7 * k
		rootX -= 0.55 * k
	end

	-- hit flinch: the body jolts away from the hit and the head snaps, then recovers
	local hurt = since(char, "HurtAt", serverNow)
	local hurtNeck = 0
	if hurt < 0.45 and not downed then
		local k = math.sin(math.min(1, hurt / 0.45) * math.pi) * (1 - hurt / 0.45 * 0.5)
		local from = char:GetAttribute("HurtFrom")
		local sideSign = 1
		if typeof(from) == "Vector3" then
			sideSign = root.CFrame:PointToObjectSpace(from).X > 0 and -1 or 1
		end
		waistLean += 0.28 * k
		rootY += 0.22 * k * sideSign
		rootZ += 0.08 * k * sideSign
		hurtNeck = 0.3 * k
		lSh, rSh = lSh + 0.25 * k, rSh + 0.25 * k
	end

	local neckPitch = pitch * (0.35 + 0.25 * a) - waistLean * 0.5 + shift * 0.3 + 1.15 * pk + hurtNeck
	J.root.Transform = CFrame.new(rootOffset) * ang(rootX, rootY + shift, rootZ)
	J.waist.Transform = ang(waistLean, -twist + rootY * -0.3, shift * 0.5)
	J.neck.Transform = ang(neckPitch, twist * 0.5, 0)
	J.lh.Transform = ang(lHip, 0, hipRollL)
	J.rh.Transform = ang(rHip, 0, hipRollR)
	J.lk.Transform = ang(lKnee, 0, 0)
	J.rk.Transform = ang(rKnee, 0, 0)
	J.la.Transform = ang(lAnk, 0, 0)
	J.ra.Transform = ang(rAnk, 0, 0)
	J.ls.Transform = ang(lSh, lShY, lShZ)
	J.rs.Transform = ang(rSh, rShY, rShZ)
	J.le.Transform = ang(lEl, 0, 0)
	J.re.Transform = ang(rEl, 0, 0)
	J.lw.Transform = ang(0, 0, 0)
	J.rw.Transform = ang(a * 0.1, 0, 0)

	-- the gun in your hands: pose it against the chest and put both hands on it
	local busyHands = melee < 0.45 or throw < 0.5 or takedown < 1.2 or heal < 2.2 or dodge < dodgeLen or vaultT < 0.8
	local reloading = (reloadUntil > serverNow) or char:GetAttribute("Reloading") == true
	local drawK = math.clamp((os.clock() - (rig.drawAt or -10)) / 0.4, 0, 1)
	if armed and not downed and not busyHands and rig.healHolstered then
		rig.healHolstered = nil
		rig.drawAt = os.clock() -- draw it again after healing
		drawK = 0
	end
	if armed and not downed and not busyHands then
		local sprinting = (isLocal and State.sprinting or char:GetAttribute("Sprint") == true) and moving > 0.5
		local okPose, err = pcall(poseGun, char, rig, J, slot, a, sprinting, reloading, drawK, pitch)
		if not okPose and not rig.poseWarned then
			rig.poseWarned = true
			warn("[PlayerAnimator] gun pose: " .. tostring(err))
		end
	elseif armed and not downed and heal < 2.2 then
		-- both hands on the dressing: the gun goes back in its holster, then is drawn again
		local model = char:FindFirstChild("Weapon_" .. slot)
		local w = model and model.PrimaryPart and model.PrimaryPart:FindFirstChild("Mount")
		local holsterPart = char:FindFirstChild(slot == "long" and "UpperTorso" or "LowerTorso")
		if w and holsterPart then
			w.Part0 = holsterPart
			w.C0 = slot == "long" and WeaponModels.BackOffset or WeaponModels.HipOffset
			w.C1 = CFrame.new()
			rig.posedWeld = w
			rig.healHolstered = true
		end
	elseif rig.posedWeld then
		-- hands busy or holstered: give the weld back to the server's mount (hand / back / hip)
		local w = rig.posedWeld
		rig.posedWeld = nil
		local model = w.Parent and w.Parent.Parent
		if model and model.Name == "Weapon_" .. slot and armed then
			local hand = char:FindFirstChild("RightHand")
			if hand then
				w.Part0 = hand
				w.C0 = WeaponModels.HandOffset
			end
		end
	end

	-- local player's hips physically lower when crouched
	if isLocal and rig.humanoid then
		local base = char:GetAttribute("BaseHipHeight")
		if base then
			rig.baseHip = base
			rig.humanoid.HipHeight = base * (1 - (1 - Movement.CrouchHipMult) * math.min(c, 1))
		end
	end
end

-- Test hook: run one animation frame on a rig (used by the engine tests) and report errors.
-- The rig state is kept between calls (like the live loop), so blends settle over frames.
-- `settled` skips the draw-from-holster timer (test frames run faster than real time).
-- Test hook: pretend this character fired `age` seconds ago (engine pose tests).
function PlayerAnimator.debugShotAge(char, age)
	shotAt[char] = os.clock() - age
end

function PlayerAnimator.debugAnimate(char, isLocal, settled)
	local rig = rigs[char] or setup(char)
	if not rig then
		return false, "setup failed: " .. tostring(diag.setupFail)
	end
	rigs[char] = rig
	if settled then
		rig.lastSlot = char:GetAttribute("EquippedSlot") or "none"
		rig.drawAt = -10
	end
	local ok, err = pcall(animate, char, rig, 1 / 60, Workspace:GetServerTimeNow(), isLocal == true)
	return ok, err, rig
end

function PlayerAnimator.start()
	local Net = require(Shared.Net)
	Net.event("Notify").OnClientEvent:Connect(function(kind, data)
		if kind == "Shot" and type(data) == "table" and data.shooter and data.shooter ~= player.UserId then
			local shooter = Players:GetPlayerByUserId(data.shooter)
			PlayerAnimator.noteShot(shooter and shooter.Character)
		end
	end)
	RunService.Stepped:Connect(function(_, dt)
		local serverNow = Workspace:GetServerTimeNow()
		local camPos = Workspace.CurrentCamera.CFrame.Position
		diag.frames += 1
		local animated = 0
		-- players, plus any rescued survivors (same rig, same procedural animation)
		local subjects = {}
		for _, p in Players:GetPlayers() do
			if p.Character then
				table.insert(subjects, { char = p.Character, isLocal = p == player })
			end
		end
		for _, m in game:GetService("CollectionService"):GetTagged("Survivor") do
			table.insert(subjects, { char = m, isLocal = false })
		end
		for _, subject in subjects do
			local char = subject.char
			local p = { } -- kept for the isLocal flag below
			p.isLocal = subject.isLocal
			if char then
				local rig = rigs[char]
				if rig == nil then
					rig = setup(char)
					rigs[char] = rig
				end
				if rig and rig.root.Parent and (rig.root.Position - camPos).Magnitude < 220 then
					local ok, err = pcall(animate, char, rig, dt, serverNow, p.isLocal)
					if ok then
						animated += 1
					else
						diag.lastError = tostring(err)
					end
					if not ok then
						-- report once, fall back to Roblox's own animation, try again shortly
						if not rig.reported then
							rig.reported = true
							warn("[PlayerAnimator] " .. tostring(err))
						end
						rigs[char] = false
						task.delay(2, function()
							if rigs[char] == false then
								rigs[char] = nil
							end
						end)
					end
				end
			end
		end
		diag.animatedLastFrame = animated
	end)
end

return PlayerAnimator
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000004E"><Properties><string name="Name">SoundController</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- All client-side audio:
--   ambience     wind + sea + low drone, mixed by where you are (ferry vs encounter)
--   music        a tension loop that swells when Hushed are suspicious of / hunting you,
--                a stinger when you're spotted, a resolve when you clear an encounter
--   body         footsteps for every character (surface-aware, quieter when crouched),
--                heartbeat at low health, hurt, Roblox's default character sounds muted
--   the Hushed   per-enemy breath / grind / groan loops, growls and shrieks on spotting
--   weapons      your gunshots play instantly; other players' play from the Shot event,
--                with distance-based loudness so far shots sound far
-- Uses the IDs in Config/Sounds (empty = silent).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Sfx = require(Shared.Util.Sfx)
local Geometry = require(Shared.Util.Geometry)
local State = require(script.Parent.Parent.State)

local SoundController = {}
local player = Players.LocalPlayer

local amb = {}
local music
local heartbeat
local stepState = setmetatable({}, { __mode = "k" }) -- [character] = distance since last step
local enemyAudio = setmetatable({}, { __mode = "k" }) -- [model] = { loop, lastState }

local DEFAULT_CHARACTER_SOUNDS = {
	Running = true, Jumping = true, Landing = true, FreeFalling = true, GettingUp = true,
	Climbing = true, Swimming = true, Splash = true, Died = true,
}

local function muteDefaultSounds(char)
	local function check(inst)
		if inst:IsA("Sound") and DEFAULT_CHARACTER_SOUNDS[inst.Name] then
			inst.Volume = 0
		end
	end
	for _, d in char:GetDescendants() do
		check(d)
	end
	char.DescendantAdded:Connect(check)
end

local function loop(key, volume)
	local s = Sfx.ui(key, volume, true)
	if s then
		s.Volume = 0
	end
	return s
end

function SoundController.gunshot(weaponId, position, isMine, quiet)
	local key = "Gun_" .. tostring(weaponId)
	local camPos = Workspace.CurrentCamera.CFrame.Position
	local dist = (position - camPos).Magnitude
	local volume = (isMine and 0.9 or 1.0) * (quiet and 0.35 or 1)
	if isMine then
		Sfx.ui(key, volume)
	else
		Sfx.at(position, key, volume, 600, 0.05)
		if dist > 120 then
			Sfx.ui(key, 0.25 * (quiet and 0.3 or 1)) -- distant echo carries across the map
		end
	end
end

function SoundController.impact(position, kind)
	if kind == "enemy" then
		Sfx.at(position, "ImpactSalt", 0.7, 60, 0.1)
	elseif kind == "world" then
		Sfx.at(position, "ImpactWorld", 0.5, 70, 0.12)
	end
end

local function updateFootsteps(dt)
	for _, p in Players:GetPlayers() do
		local char = p.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if root then
			local v = root.AssemblyLinearVelocity
			local speed = Vector3.new(v.X, 0, v.Z).Magnitude
			local crouched = char:GetAttribute("Stance") == "Crouch"
			local stride = speed > 16 and 4.0 or (speed > 10 and 3.3 or 2.4)
			local acc = (stepState[char] or 0) + speed * dt
			if speed > 1.5 and acc >= stride then
				acc = 0
				local water = Geometry.inTagged(root.Position, "Shallows")
				local vol = math.clamp(speed / 20, 0.2, 1) * (crouched and 0.35 or 1) * (p == player and 0.8 or 1)
				Sfx.at(root.Position - Vector3.new(0, 2.5, 0), water and "StepWater" or "Step", vol, 60, 0.12)
			end
			stepState[char] = acc
		end
	end
end

local VOICE = {
	Drifter = "Hushed_Breath",
	Rusher = "Hushed_Breath",
	Bellwether = "Hushed_Breath",
	Seeker = "Seeker_Grind",
	Tidewalker = "Tidewalker_Groan",
}

local function updateEnemies()
	local folder = Workspace:FindFirstChild("Enemies")
	if not folder then
		return 0
	end
	local camPos = Workspace.CurrentCamera.CFrame.Position
	local threat = 0
	local key = "Sus_" .. player.UserId
	for _, model in folder:GetChildren() do
		local torso = model:FindFirstChild("Torso")
		local state = model:GetAttribute("State")
		local typeName = model:GetAttribute("Type") or "Drifter"
		if torso then
			local a = enemyAudio[model]
			local human = model:GetAttribute("Human") == true -- people don't rasp or growl
			if not a then
				a = { loop = (not human) and Sfx.attach(torso, VOICE[typeName] or "Hushed_Breath", 0.55, 70, true) or nil, lastState = state }
				if a.loop then
					a.loop.TimePosition = math.random() * 3
				end
				enemyAudio[model] = a
			end
			if a.loop then
				a.loop.Volume = ((state == "Dispersed" or state == "Down") and 0 or (state == "Chase" and 0.9 or 0.5))
				a.loop.PlaybackSpeed = state == "Chase" and 1.25 or 1
			end
			if state ~= a.lastState then
				if human then
					-- their callouts (radio / bell) are played by the server
				elseif state == "Chase" then
					Sfx.at(torso.Position, typeName == "Rusher" and "Rusher_Shriek" or "Hushed_Growl", 1, 160, 0.08)
				elseif state == "Investigate" and math.random() < 0.5 then
					Sfx.at(torso.Position, "Hushed_Growl", 0.5, 70, 0.15)
				end
				a.lastState = state
			end
			-- tension: how much the Hushed near you care about you
			if (torso.Position - camPos).Magnitude < 120 then
				local sus = model:GetAttribute(key) or 0
				local hunting = state == "Chase" and model:GetAttribute("Target") == player.UserId
				threat = math.max(threat, hunting and 1 or (sus > 0.35 and 0.55 or sus))
			end
		end
	end
	return threat
end

function SoundController.start()
	amb.wind = loop("Amb_Wind")
	amb.sea = loop("Amb_Sea")
	amb.drone = loop("Amb_Drone")
	amb.birds = loop("Amb_Birds")
	amb.gulls = loop("Amb_Gulls")
	music = loop("Music_Tension")
	heartbeat = loop("Heartbeat")

	local function onChar(char)
		muteDefaultSounds(char)
	end
	for _, p in Players:GetPlayers() do
		if p.Character then
			onChar(p.Character)
		end
		p.CharacterAdded:Connect(onChar)
	end
	Players.PlayerAdded:Connect(function(p)
		p.CharacterAdded:Connect(onChar)
	end)

	-- load every sound up front so nothing is silent the first time it plays
	task.spawn(function()
		pcall(function()
			game:GetService("ContentProvider"):PreloadAsync(Sfx.preloadList())
		end)
	end)

	Net.event("Notify").OnClientEvent:Connect(function(kind, data)
		data = data or {}
		if kind == "Sfx" then
			Sfx.fromServer(data)
		elseif kind == "Shot" and typeof(data.from) == "Vector3" and data.shooter ~= player.UserId then
			SoundController.gunshot(data.weapon, data.from, false, data.quiet)
		elseif kind == "Spotted" then
			Sfx.ui("Stinger_Spotted", 0.7)
		elseif kind == "Hurt" then
			Sfx.ui("Hurt", 0.8)
		elseif kind == "Results" and data.win then
			Sfx.ui("Stinger_Clear", 0.6)
		end
	end)

	local musicLevel = 0
	RunService.Heartbeat:Connect(function(dt)
		updateFootsteps(dt)
		local threat = updateEnemies()
		local matchState = ReplicatedStorage:GetAttribute("MatchState")
		local inEncounter = matchState == "Encounter" and player:GetAttribute("InCrossing") == true
		local function fade(sound, target, rate)
			if sound then
				sound.Volume += (target - sound.Volume) * math.min(1, dt * (rate or 1.5))
			end
		end
		-- ambience sits under everything (and the Ambience group scales it down again)
		fade(amb.wind, inEncounter and 0.45 or 0.3)
		fade(amb.sea, inEncounter and 0.08 or 0.3)
		fade(amb.drone, inEncounter and (0.25 + threat * 0.15) or 0.05)
		-- daytime life: birds in the trees, gulls over the water (quiet when something hunts you)
		local clock = game:GetService("Lighting").ClockTime
		local day = clock > 6 and clock < 18.5
		fade(amb.birds, day and (1 - threat * 0.9) * (inEncounter and 0.5 or 0.25) or 0, 1)
		fade(amb.gulls, day and (inEncounter and 0.18 or 0.45) or 0, 1)
		musicLevel += ((inEncounter and threat or 0) - musicLevel) * math.min(1, dt * (threat > musicLevel and 2.5 or 0.4))
		fade(music, musicLevel * 0.45, 4)
		local char = State.character
		local hp = char and char:GetAttribute("HP") or 100
		local maxHp = char and char:GetAttribute("MaxHP") or 100
		local low = inEncounter and hp > 0 and hp / maxHp < 0.35
		fade(heartbeat, low and 0.6 or 0, 3)
		if heartbeat then
			heartbeat.PlaybackSpeed = low and (1.0 + (0.35 - hp / maxHp)) or 1
		end
	end)
end

return SoundController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000004F"><Properties><string name="Name">UIController</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Owns the ScreenGui and routes server notifications to the UI modules.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Sfx = require(Shared.Util.Sfx)
local UI = script.Parent.Parent:WaitForChild("UI")
local HUD = require(UI:WaitForChild("HUD"))
local Diagnostics = require(UI:WaitForChild("Diagnostics"))
local State = require(script.Parent.Parent.State)
local Theme = require(UI:WaitForChild("Theme"))
local CharacterSelect = require(UI:WaitForChild("CharacterSelect"))
local Satchel = require(UI:WaitForChild("Satchel"))
local Shop = require(UI:WaitForChild("Shop"))
local Results = require(UI:WaitForChild("Results"))
local Chart = require(UI:WaitForChild("Chart"))
local Workbench = require(UI:WaitForChild("Workbench"))
local Repairs = require(UI:WaitForChild("Repairs"))
local Settings = require(UI:WaitForChild("Settings"))
local Quests = require(UI:WaitForChild("Quests"))
local Quartermaster = require(UI:WaitForChild("Quartermaster"))
local Spin = require(UI:WaitForChild("Spin"))
local Guide = require(UI:WaitForChild("Guide"))
local Logbook = require(UI:WaitForChild("Logbook"))
local Callouts = require(UI:WaitForChild("Callouts"))

local UIController = {}
local Controllers
local player = Players.LocalPlayer

function UIController.toggleSatchel()
	Satchel.toggle()
end

-- First time you're in the world: show the controls for a while.
local shownControls = false
function UIController.onCharacter()
	if shownControls then
		return
	end
	shownControls = true
	task.delay(1.5, function()
		HUD.toggleControls(true)
		task.delay(14, function()
			HUD.toggleControls(false)
		end)
	end)
end

function UIController.toggleControls(force)
	HUD.toggleControls(force)
end

function UIController.openSpin()
	Spin.open()
end

function UIController.setSetting(key, value)
	Settings.setValue(key, value)
end

function UIController.toggleSettings()
	Settings.toggle()
end

local function closeMenus()
	Chart.close()
	Workbench.close()
	Repairs.close()
	Shop.close()
	Satchel.close()
	CharacterSelect.close()
	Quests.close()
	Quartermaster.close()
	Spin.close()
	Logbook.close()
end

function UIController.init(registry)
	Controllers = registry
end

function UIController.start()
	local gui = Instance.new("ScreenGui")
	gui.Name = "AftertideUI"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")

	-- Everything is built inside one scaler: text and menus are scaled up together (bigger on big
	-- screens and consoles, and by the "Text and menu size" setting) so nothing is tiny.
	local UserInputService = game:GetService("UserInputService")
	local ui = Instance.new("Frame")
	ui.Name = "Scaler"
	ui.BackgroundTransparency = 1
	ui.BorderSizePixel = 0
	ui.Size = UDim2.fromScale(1, 1)
	ui.Parent = gui
	local uiScale = Instance.new("UIScale")
	uiScale.Parent = ui
	local function applyScale()
		local vh = Workspace.CurrentCamera.ViewportSize.Y
		local mult = ({ Normal = 1, Large = 1.2, Huge = 1.4 })[player:GetAttribute("Set_uiSize") or "Large"] or 1.2
		local scale = math.clamp(vh / 860, 1, 1.5) * mult * (State.gamepad and 1.12 or 1)
		if vh < 520 then
			scale = 1 -- phones: the screen is already small
		end
		scale = math.clamp(scale, 1, 2.1)
		if math.abs(uiScale.Scale - scale) > 0.001 then
			uiScale.Scale = scale
			ui.Size = UDim2.fromScale(1 / scale, 1 / scale)
			Theme.scale = scale
		end
	end
	applyScale()
	player:GetAttributeChangedSignal("Set_uiSize"):Connect(applyScale)
	Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(applyScale)
	task.spawn(function()
		while true do
			task.wait(0.5)
			applyScale() -- picks up a switch between mouse and controller
		end
	end)

	local function send(name, payload)
		Controllers.ActionController.sendAction(name, payload)
	end
	local function request(kind, a, b)
		Controllers.ActionController.request(kind, a, b)
	end
	-- each panel builds on its own: one failing must not leave the rest (satchel, shop...) unbuilt
	local function build(name, fn)
		local ok, err = pcall(fn)
		if not ok then
			warn(("[UI] %s failed to build: %s"):format(name, tostring(err)))
		end
	end
	build("HUD", function()
		HUD.build(ui, function()
			send("SecondWind")
		end, Controllers.WeaponController)
	end)
	build("CharacterSelect", function()
		CharacterSelect.build(ui)
	end)
	build("Satchel", function()
		Satchel.build(ui, send)
	end)
	build("Shop", function()
		Shop.build(ui)
	end)
	build("Results", function()
		Results.build(ui)
	end)
	build("Chart", function()
		Chart.build(ui, request)
	end)
	build("Workbench", function()
		Workbench.build(ui, request)
	end)
	build("Repairs", function()
		Repairs.build(ui, request)
	end)
	build("Settings", function()
		Settings.build(ui, request)
	end)
	build("Quests", function()
		Quests.build(ui)
	end)
	build("Quartermaster", function()
		Quartermaster.build(ui, request)
	end)
	build("Callouts", function()
		Callouts.build(ui)
	end)
	build("Logbook", function()
		Logbook.build(ui)
	end)
	build("Guide", function()
		Guide.build(ui, request)
	end)
	build("Spin", function()
		Spin.build(ui, request, Shop.prompt)
	end)
	build("Diagnostics", function()
		local dgui = Instance.new("ScreenGui")
		dgui.Name = "AftertideDiagnostics"
		dgui.ResetOnSpawn = false
		dgui.DisplayOrder = 100
		dgui.IgnoreGuiInset = true
		dgui.Parent = player:WaitForChild("PlayerGui")
		Diagnostics.build(dgui)
	end)
	Satchel.setMenuHandlers({
		spin = function()
			Spin.open()
		end,
		logbook = function()
			Logbook.open()
		end,
		view = function()
			Controllers.CameraController.toggleFirstPerson()
			HUD.toast(State.firstPerson and "First person" or "Third person")
		end,
		shop = function()
			Shop.open()
		end,
		settings = function()
			UIController.toggleSettings()
		end,
		controls = function()
			HUD.toggleControls(true)
		end,
	})
	Diagnostics.setStatusProvider(function()
		local out = {}
		local anim = Controllers.PlayerAnimator.status()
		table.insert(out, ("animator: %d character(s) animated last frame, %d frames; setup: %s"):format(anim.animatedLastFrame, anim.frames, anim.setupFail or "ok"))
		table.insert(out, "animator last error: " .. tostring(anim.lastError or "none"))
		table.insert(out, ("Roblox Animators removed: %d"):format(anim.animatorsRemoved))
		local char = State.character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		table.insert(out, ("character: %s · procedural=%s · Animator present=%s · HipHeight=%.2f (base %s)"):format(
			char and char.Name or "none", tostring(char and char:GetAttribute("Procedural")), tostring(hum and hum:FindFirstChildOfClass("Animator") ~= nil),
			hum and hum.HipHeight or -1, tostring(char and char:GetAttribute("BaseHipHeight"))))
		local meshes = 0
		if char then
			for _, d in char:GetChildren() do
				if d:IsA("MeshPart") and d.Name:sub(1, 5) == "Mesh_" then
					meshes += 1
				end
			end
		end
		table.insert(out, ("sculpted body pieces on character: %d"):format(meshes))
		table.insert(out, ("stance: %s · crouched=%s prone=%s aiming=%s sprinting=%s downed=%s"):format(
			tostring(char and char:GetAttribute("Stance")), tostring(State.crouched), tostring(State.prone), tostring(State.aiming), tostring(State.sprinting), tostring(State.downed)))
		local open = {}
		for name in State.modals do
			table.insert(open, name)
		end
		table.insert(out, "open menus: " .. (#open > 0 and table.concat(open, ", ") or "none"))
		table.insert(out, ("equipped: %s (%s)"):format(tostring(char and char:GetAttribute("Equipped")), tostring(char and char:GetAttribute("EquippedSlot"))))
		local sky = game:GetService("Lighting"):FindFirstChildOfClass("Sky")
		table.insert(out, "sky: " .. (sky and ("Bk=" .. sky.SkyboxBk .. " Up=" .. sky.SkyboxUp) or "no Sky object"))
		return out
	end)

	-- Menu keys go through a direct input listener. Roblox's own scripts (player list on Tab,
	-- default camera on right-click) can take keys before ContextActionService sees them.
	local UserInputService = game:GetService("UserInputService")
	UserInputService.InputBegan:Connect(function(input)
		if UserInputService:GetFocusedTextBox() then
			return
		end
		local key = input.KeyCode
		if key == Enum.KeyCode.Tab or key == Enum.KeyCode.I or key == Enum.KeyCode.ButtonSelect then
			Diagnostics.noteInput("key " .. key.Name .. " -> satchel")
			if State.character then
				Satchel.toggle()
			end
		elseif key == Enum.KeyCode.ButtonB and State.uiOpen() then
			Diagnostics.noteInput("pad B -> close menus")
			closeMenus()
			Settings.close()
			Results.close()
		elseif key == Enum.KeyCode.K and State.character then
			Controllers.CameraController.toggleFirstPerson()
			HUD.toast(State.firstPerson and "First person" or "Third person")
		elseif key == Enum.KeyCode.F1 then
			Diagnostics.noteInput("key F1 -> controls")
			HUD.toggleControls()
		elseif key == Enum.KeyCode.F2 then
			Diagnostics.toggle()
		elseif key == Enum.KeyCode.P then
			Diagnostics.noteInput("key P -> settings")
			UIController.toggleSettings()
		end
	end)

	Net.event("Notify").OnClientEvent:Connect(function(kind, data)
		data = data or {}
		if kind == "Diag" then
			Diagnostics.serverLine(data.k, data.m)
		elseif kind == "Toast" then
			HUD.toast(tostring(data.text or ""))
		elseif kind == "OpenCharacterSelect" then
			CharacterSelect.open()
		elseif kind == "OpenShop" then
			Shop.open(data and data.tab)
		elseif kind == "Results" then
			Satchel.close()
			Results.show(data)
		elseif kind == "OpenChart" then
			Sfx.ui("Ui_Confirm", 0.5)
			Chart.open()
		elseif kind == "OpenWorkbench" then
			Sfx.ui("Ui_Tick", 0.5)
			Workbench.open()
		elseif kind == "OpenRepairs" then
			Repairs.open()
		elseif kind == "OpenQuests" then
			Quests.open()
		elseif kind == "OpenQuartermaster" then
			Quartermaster.open()
		elseif kind == "Callout" then
			Callouts.show(data)
		elseif kind == "DailyReward" then
			Logbook.showDaily(data.day, data.text)
		elseif kind == "OpenSpin" then
			Spin.open()
		elseif kind == "SpinResult" then
			task.spawn(Spin.result, data)
		elseif kind == "CloseMenus" then
			closeMenus()
		elseif kind == "Hit" then
			HUD.hit(data)
		elseif kind == "Hurt" then
			HUD.hurt()
		elseif kind == "EncounterStart" then
			closeMenus()
			Results.close()
			HUD.toast(("%s · %s"):format(tostring(data.name), tostring(data.modifierName)))
			HUD.toast(tostring(data.modifierDesc or ""))
			HUD.toast(tostring(data.objective or ""))
		elseif kind == "Spotted" then
			HUD.toast("You've been seen. Break line of sight!")
		elseif kind == "NeedProduct" then
			if not Shop.prompt(data.productKey) then
				HUD.toast("No tokens left. Earn more by finishing crossings.")
			end
		end
	end)

	ReplicatedStorage:GetAttributeChangedSignal("MatchState"):Connect(function()
		local matchState = ReplicatedStorage:GetAttribute("MatchState")
		if matchState == "Ferry" or matchState == "Planning" then
			Results.close()
		end
	end)

	-- First visit: choose a crew member (also covers a missed server notification).
	task.delay(1.5, function()
		if not player:GetAttribute("CharId") then
			CharacterSelect.open()
		end
	end)

	local reported = {}
	local function safe(name, fn, ...)
		local ok, err = pcall(fn, ...)
		if not ok and not reported[name] then
			reported[name] = true
			warn(("[UI] %s: %s"):format(name, tostring(err)))
		end
	end
	-- Console: keep the selection cursor inside whatever menu is open; drop it when none is.
	local GuiService = game:GetService("GuiService")
	local function firstButton()
		local best, bestY, bestX
		for _, d in gui:GetDescendants() do
			if d:IsA("GuiButton") and d.Visible and d.Selectable then
				local shown, modal = true, false
				local a = d
				while a and a ~= gui do
					if a:IsA("GuiObject") then
						if not a.Visible then
							shown = false
							break
						end
						if a.ZIndex >= 20 then
							modal = true
						end
					end
					a = a.Parent
				end
				if shown and modal then
					local p = d.AbsolutePosition
					if not best or p.Y < bestY - 4 or (math.abs(p.Y - bestY) <= 4 and p.X < bestX) then
						best, bestY, bestX = d, p.Y, p.X
					end
				end
			end
		end
		return best
	end
	local function manageSelection()
		local sel = GuiService.SelectedObject
		if not State.uiOpen() then
			if sel and sel:IsDescendantOf(gui) then
				GuiService.SelectedObject = nil
			end
		elseif State.gamepad and (sel == nil or not sel.Visible or not sel:IsDescendantOf(gui)) then
			GuiService.SelectedObject = firstButton()
		end
	end
	RunService.RenderStepped:Connect(function(dt)
		safe("Selection", manageSelection)
		safe("HUD", HUD.update, dt)
		safe("Satchel", Satchel.refresh)
		safe("Shop", Shop.refresh)
		safe("Spin", Spin.refresh)
		safe("Guide", Guide.update)
	end)
end

return UIController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000050"><Properties><string name="Name">WeaponController</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Client side of the gun system: input -> server intents, plus instant local feedback
-- (muzzle flash, recoil kick, crosshair bloom) so shooting feels responsive. The server
-- decides every hit (WeaponService).
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Items = require(Shared.Config.Items)
local Weapons = require(Shared.Config.Weapons)
local Net = require(Shared.Net)
local Sfx = require(Shared.Util.Sfx)
local State = require(script.Parent.Parent.State)

local WeaponController = {}
local Controllers
local player = Players.LocalPlayer

local nextFireAt = 0
local shotIndex, lastShotAt = 0, 0
local cachedJson, cachedStats = nil, {}

local function act(name, payload)
	Net.event("Action"):FireServer(name, payload)
end

function WeaponController.stats()
	local json = player:GetAttribute("WeaponStats")
	if json ~= cachedJson then
		cachedJson = json
		local ok, decoded = pcall(function()
			return HttpService:JSONDecode(json or "{}")
		end)
		cachedStats = ok and decoded or {}
	end
	return cachedStats
end

-- slot, weaponId, stats (or nil when holstered)
function WeaponController.current()
	local char = State.character
	if not char then
		return "none", nil, nil
	end
	local slot = char:GetAttribute("EquippedSlot") or "none"
	local id = char:GetAttribute("Equipped")
	if not id or id == "" then
		return "none", nil, nil
	end
	return slot, id, WeaponController.stats()[slot]
end

-- A full (magazine) reload is running: you can't fire.
local function fullReload()
	local char = State.character
	return char ~= nil and (char:GetAttribute("ReloadUntil") or 0) > Workspace:GetServerTimeNow()
end

-- Any reload, including a shell-by-shell one you can fire out of (shown on the HUD).
function WeaponController.isReloading()
	local char = State.character
	return fullReload() or (char ~= nil and char:GetAttribute("Reloading") == true)
end

function WeaponController.equip(slot)
	if not State.character or State.downed then
		return
	end
	local current = WeaponController.current()
	if current == slot then
		slot = "none"
	end
	if slot ~= "none" and (player:GetAttribute("W_" .. slot) or "") == "" then
		return
	end
	act("Equip", slot)
end

function WeaponController.cycleWeapon()
	local current = WeaponController.current()
	local order = { "long", "sidearm", "none" }
	local index = table.find(order, current) or 3
	for step = 1, 3 do
		local slot = order[(index + step - 1) % 3 + 1]
		if slot == "none" or (player:GetAttribute("W_" .. slot) or "") ~= "" then
			act("Equip", slot)
			return
		end
	end
end

local function muzzleFlash(slot)
	local char = State.character
	local model = char and char:FindFirstChild("Weapon_" .. slot)
	local grip = model and model.PrimaryPart
	local muzzle = grip and grip:FindFirstChild("Muzzle")
	if not muzzle then
		return
	end
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 200, 140)
	light.Range = 16
	light.Brightness = 5
	light.Shadows = true
	light.Parent = muzzle
	local flash = Instance.new("ParticleEmitter")
	flash.Rate = 0
	flash.Lifetime = NumberRange.new(0.04, 0.07)
	flash.Speed = NumberRange.new(2, 6)
	flash.SpreadAngle = Vector2.new(18, 18)
	flash.EmissionDirection = Enum.NormalId.Front
	flash.LightEmission = 1
	flash.Color = ColorSequence.new(Color3.fromRGB(255, 210, 150))
	flash.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
	flash.Parent = muzzle
	flash:Emit(6)
	-- a breath of gun smoke that hangs at the muzzle
	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
	smoke.Rate = 0
	smoke.Lifetime = NumberRange.new(0.6, 1.2)
	smoke.Speed = NumberRange.new(1, 3)
	smoke.SpreadAngle = Vector2.new(20, 20)
	smoke.EmissionDirection = Enum.NormalId.Front
	smoke.Drag = 3
	smoke.Acceleration = Vector3.new(0, 1.5, 0)
	smoke.LightInfluence = 1
	smoke.Color = ColorSequence.new(Color3.fromRGB(200, 196, 188))
	smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1.4) })
	smoke.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) })
	smoke.Parent = muzzle
	smoke:Emit(4)
	task.delay(0.06, function()
		light:Destroy()
	end)
	task.delay(1.4, function()
		flash:Destroy()
		smoke:Destroy()
	end)
end

function WeaponController.fire()
	if not State.character or State.downed or State.uiOpen() or State.listening or State.vaulting then
		return
	end
	local slot, id, stat = WeaponController.current()
	if not id or not stat then
		return
	end
	local now = os.clock()
	if now < nextFireAt or fullReload() then
		return
	end
	local mag = player:GetAttribute("W_" .. slot .. "Mag") or 0
	if mag <= 0 then
		act("Reload")
		return
	end
	nextFireAt = now + (stat.fireDelay or 0.5)
	local aimedIn = State.aiming and (os.clock() - (State.aimSince or 0)) >= ((Weapons.List[id] and Weapons.List[id].adsTime) or 0.2)
	act("Fire", { dir = Controllers.CameraController.aimDirection(), aim = aimedIn })
	local def = Weapons.List[id]
	local runUpgrades = player:GetAttribute("RunUpgrades") or ""
	local quiet = id == "revolver" and runUpgrades:find('"baffle":true') ~= nil
	Controllers.SoundController.gunshot(id, State.root.Position, true, quiet)
	Controllers.PlayerAnimator.noteShot(State.character)
	if def and not def.projectile then
		muzzleFlash(slot)
		if id ~= "revolver" and id ~= "bow" then
			WeaponController.ejectShell(slot, id == "shotgun")
		end
	end
	-- learnable recoil: each gun kicks sideways in a fixed, repeating pattern
	if now - lastShotAt > 0.7 then
		shotIndex = 0
	end
	shotIndex += 1
	lastShotAt = now
	local pattern = def and def.recoilPattern or { 0 }
	local side = pattern[(shotIndex - 1) % #pattern + 1]
	local steady = State.aiming and (State.crouched and 0.75 or 1) or 1.25
	Controllers.CameraController.kick((stat.recoil or 3) * steady, side)
	State.bloom = math.min(State.bloom + (stat.recoil or 3) * 0.5, 8)
end

-- a brass (or red shotgun) casing tumbling out of the action
function WeaponController.ejectShell(slot, isShell)
	local char = State.character
	local model = char and char:FindFirstChild("Weapon_" .. slot)
	local grip = model and model.PrimaryPart
	if not grip then
		return
	end
	local casing = Instance.new("Part")
	casing.Size = isShell and Vector3.new(0.18, 0.18, 0.4) or Vector3.new(0.08, 0.08, 0.22)
	casing.Color = isShell and Color3.fromRGB(150, 40, 34) or Color3.fromRGB(196, 160, 70)
	casing.Material = Enum.Material.Metal
	casing.CanQuery = false
	casing.CanTouch = false
	casing.CFrame = grip.CFrame * CFrame.new(0.2, 0.35, -0.3)
	casing.Parent = Workspace
	task.delay(0.35, function()
		if Sfx.has("ShellDrop") then
			Sfx.at(casing.Position, "ShellDrop", isShell and 0.8 or 0.5, 40, 0.1)
		end
	end)
	casing.AssemblyLinearVelocity = grip.CFrame.RightVector * 12 + Vector3.new(0, 8, 0)
	casing.AssemblyAngularVelocity = Vector3.new(math.random(-20, 20), math.random(-20, 20), math.random(-20, 20))
	game:GetService("Debris"):AddItem(casing, 6)
end

function WeaponController.reload()
	local _, id = WeaponController.current()
	if id then
		act("Reload")
	end
end

-- Current spread in degrees (drives the crosshair; mirrors the server formula).
function WeaponController.spread()
	local _, id, stat = WeaponController.current()
	if not id or not stat then
		return 0
	end
	local def = Weapons.List[id]
	local aimedIn = State.aiming and (os.clock() - (State.aimSince or 0)) >= (def.adsTime or 0.2)
	local spread = aimedIn and stat.spreadAim or (State.aiming and (stat.spreadAim + stat.spreadHip) * 0.5 or stat.spreadHip)
	local root = State.root
	if root then
		local v = root.AssemblyLinearVelocity
		local speed = Vector3.new(v.X, 0, v.Z).Magnitude
		if speed > 2 then
			spread += def.moveSpread * math.clamp(speed / 14, 0, 1.5)
		end
	end
	if State.crouched then
		spread *= 0.8
	end
	return spread + State.bloom
end

function WeaponController.aimFov()
	local _, id, stat = WeaponController.current()
	return id and stat and stat.fov or nil
end

function WeaponController.cycleThrowable()
	local list = Items.Throwables
	local index = table.find(list, State.throwable) or 1
	for step = 1, #list do
		local candidate = list[(index + step - 1) % #list + 1]
		if (player:GetAttribute("Inv_" .. candidate) or 0) > 0 then
			State.throwable = candidate
			return
		end
	end
end

function WeaponController.throw()
	if not State.character or State.downed or State.uiOpen() then
		return
	end
	if (player:GetAttribute("Inv_" .. State.throwable) or 0) < 1 then
		WeaponController.cycleThrowable()
	end
	if (player:GetAttribute("Inv_" .. State.throwable) or 0) < 1 then
		return
	end
	act("Throw", { dir = Controllers.CameraController.aimDirection(), item = State.throwable })
end

function WeaponController.init(registry)
	Controllers = registry
end

function WeaponController.start()
	local lastSlot = nil
	game:GetService("RunService").RenderStepped:Connect(function(dt)
		State.bloom = math.max(0, State.bloom - dt * 6)
		local slot = State.character and State.character:GetAttribute("EquippedSlot")
		if slot ~= lastSlot then
			if lastSlot ~= nil and slot ~= nil then
				require(Shared.Util.Sfx).ui("Equip", 0.6)
				State.weaponSwitchedAt = os.clock()
			end
			lastSlot = slot
		end
	end)
end

return WeaponController
]]></ProtectedString></Properties></Item>
</Item>
<Item class="LocalScript" referent="RBX00000052"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- AFTERTIDE client bootstrap.
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer
local State = require(script.Parent:WaitForChild("State"))
local Controllers = script.Parent:WaitForChild("Controllers")

-- Hide the default Roblox HUD pieces we replace (health bar, backpack). Chat and the player
-- list stay: co-op players need them.
task.spawn(function()
	for _ = 1, 20 do
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.EmotesMenu, false)
		end)
		if ok then
			break
		end
		task.wait(0.5)
	end
end)

local ORDER = { "CameraController", "WeaponController", "MovementController", "ListenController", "ActionController", "EffectsController", "GraphicsController", "AnimationController", "PlayerAnimator", "EnemyAnimator", "SoundController", "UIController" }
local controllers = {}
for _, name in ORDER do
	controllers[name] = require(Controllers:WaitForChild(name))
end
for _, name in ORDER do
	if controllers[name].init then
		controllers[name].init(controllers)
	end
end
for _, name in ORDER do
	if controllers[name].start then
		task.spawn(controllers[name].start)
	end
end

local function bindCharacter(char)
	local humanoid = char:WaitForChild("Humanoid")
	local root = char:WaitForChild("HumanoidRootPart")
	State.character = char
	State.humanoid = humanoid
	State.root = root
	State.baseHipHeight = humanoid.HipHeight
	State.crouched = false
	State.sprinting = false
	State.aiming = false
	State.downed = false
	State.vaulting = false
	State.listening = false
	for _, name in ORDER do
		if controllers[name].onCharacter then
			task.spawn(controllers[name].onCharacter, char)
		end
	end
end

player.CharacterAdded:Connect(bindCharacter)
player.CharacterRemoving:Connect(function(char)
	if State.character == char then
		State.character, State.humanoid, State.root = nil, nil, nil
	end
end)
if player.Character then
	task.spawn(bindCharacter, player.Character)
end
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000053"><Properties><string name="Name">State</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Shared client-side state for controllers and UI.
local State = {
	character = nil,
	humanoid = nil,
	root = nil,
	baseHipHeight = 2,

	crouched = false,
	prone = false,
	sprinting = false,
	aiming = false,
	downed = false,
	shoulder = 1, -- 1 = right shoulder, -1 = left

	takedownUntil = 0,
	modals = {},

	throwable = "bottle", -- selected throwable
	bloom = 0, -- extra crosshair spread from recent shots (degrees)
	pitch = 0, -- camera pitch (radians), mirrored for poses
}

function State.setModal(name, open)
	State.modals[name] = open or nil
end

function State.uiOpen()
	return next(State.modals) ~= nil
end

return State
]]></ProtectedString></Properties></Item>
<Item class="Folder" referent="RBX00000066"><Properties><string name="Name">UI</string></Properties><Item class="ModuleScript" referent="RBX00000054"><Properties><string name="Name">Buttons</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Button names for the player's controller: PlayStation symbols on PlayStation, Xbox letters
-- otherwise. Used by the guide, the controls card and hints.
local UserInputService = game:GetService("UserInputService")

local Buttons = {}

local PS = { ButtonA = "✕", ButtonB = "○", ButtonX = "□", ButtonY = "△", ButtonSelect = "Touchpad", ButtonL1 = "L1", ButtonR1 = "R1", ButtonL2 = "L2", ButtonR2 = "R2", ButtonL3 = "L3", ButtonR3 = "R3" }
local XBOX = { ButtonA = "A", ButtonB = "B", ButtonX = "X", ButtonY = "Y", ButtonSelect = "View", ButtonL1 = "LB", ButtonR1 = "RB", ButtonL2 = "LT", ButtonR2 = "RT", ButtonL3 = "LS", ButtonR3 = "RS" }

function Buttons.isPlayStation()
	local ok, s = pcall(function()
		return UserInputService:GetStringForKeyCode(Enum.KeyCode.ButtonA)
	end)
	return ok and type(s) == "string" and s:find("Cross") ~= nil
end

function Buttons.name(keyName)
	local map = Buttons.isPlayStation() and PS or XBOX
	return map[keyName] or keyName
end

return Buttons
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000055"><Properties><string name="Name">Callouts</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- What the Harbour Watch and the Tidebound say: a speech bubble over the speaker (hover above
-- their head, fades out) and a subtitle at the bottom with an arrow showing where it came from.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Theme = require(script.Parent.Theme)

local Callouts = {}
local player = Players.LocalPlayer
local holder
local MAX_LINES = 4

local COLORS = {
	Watch = Color3.fromRGB(255, 206, 110),
	Tidebound = Color3.fromRGB(190, 226, 232),
}

local function arrowFor(position)
	local cam = Workspace.CurrentCamera
	local to = position - cam.CFrame.Position
	local look = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
	to = Vector3.new(to.X, 0, to.Z)
	if look.Magnitude < 0.01 or to.Magnitude < 0.01 then
		return ""
	end
	local angle = math.deg(math.atan2(look.X * to.Z - look.Z * to.X, look.X * to.X + look.Z * to.Z)) -- + = to the right (screen)
	if math.abs(angle) < 35 then
		return "▲ "
	elseif math.abs(angle) > 145 then
		return "▼ behind · "
	elseif angle > 0 then
		return "▶ "
	end
	return "◀ "
end

function Callouts.build(gui)
	holder = Theme.make("Frame", {
		Name = "Subtitles",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -170),
		Size = UDim2.new(0, 640, 0, 120),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	local layout = Theme.list(Enum.FillDirection.Vertical, 3)
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Parent = holder
end

function Callouts.show(data)
	if type(data) ~= "table" or not holder then
		return
	end
	local model, text, name = data.model, tostring(data.text or ""), tostring(data.name or "")
	local color = COLORS[data.faction] or COLORS.Watch
	local head = model and model.Parent and model:FindFirstChild("Head")
	local pos = head and head.Position or (model and model:FindFirstChild("HumanoidRootPart") and model.HumanoidRootPart.Position)
	local cam = Workspace.CurrentCamera
	local dist = pos and (pos - cam.CFrame.Position).Magnitude or math.huge
	if dist > 85 then
		return
	end

	-- the bubble over their head
	if head then
		local old = head:FindFirstChild("CalloutBubble")
		if old then
			old:Destroy()
		end
		local bb = Instance.new("BillboardGui")
		bb.Name = "CalloutBubble"
		bb.Size = UDim2.fromOffset(190, 44)
		bb.StudsOffsetWorldSpace = Vector3.new(0, 2.4, 0)
		bb.MaxDistance = 85
		bb.AlwaysOnTop = true
		bb.LightInfluence = 0
		bb.Parent = head
		local f = Instance.new("Frame")
		f.Size = UDim2.fromScale(1, 1)
		f.BackgroundColor3 = Color3.fromRGB(14, 18, 22)
		f.BackgroundTransparency = 0.2
		f.Parent = bb
		Instance.new("UICorner", f).CornerRadius = UDim.new(0, 8)
		local st = Instance.new("UIStroke")
		st.Color = color
		st.Thickness = 1.5
		st.Parent = f
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.new(1, -10, 1, 0)
		t.Position = UDim2.fromOffset(5, 0)
		t.Font = Enum.Font.GothamMedium
		t.TextSize = 15
		t.TextWrapped = true
		t.TextColor3 = Color3.fromRGB(240, 240, 232)
		t.Text = text
		t.Parent = f
		task.delay(2.8, function()
			if bb.Parent then
				bb:Destroy()
			end
		end)
	end

	-- the subtitle
	local lines = {}
	for _, c in holder:GetChildren() do
		if c:IsA("TextLabel") then
			table.insert(lines, c)
		end
	end
	table.sort(lines, function(x, y)
		return x.LayoutOrder < y.LayoutOrder
	end)
	while #lines >= MAX_LINES do
		table.remove(lines, 1):Destroy()
	end
	local line = Theme.label({
		Text = ("%s%s: %s"):format(pos and arrowFor(pos) or "", string.upper(name), text),
		Font = Enum.Font.GothamMedium,
		TextSize = 18,
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 24),
		LayoutOrder = math.floor(os.clock() * 100),
		Parent = holder,
	})
	line.TextStrokeTransparency = 0.4
	task.delay(3.4, function()
		if line.Parent then
			line:Destroy()
		end
	end)
end

return Callouts
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000056"><Properties><string name="Name">CharacterSelect</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The crew cabins: pick a character and ONE starting perk. Shows ability, loadout, innate perk.
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Characters = require(Shared.Config.Characters)
local Items = require(Shared.Config.Items)
local Weapons = require(Shared.Config.Weapons)
local Net = require(Shared.Net)
local Theme = require(script.Parent.Theme)
local State = require(script.Parent.Parent.State)

local CharacterSelect = {}
local C = Theme.Colors
local player = Players.LocalPlayer
local backdrop, closeButton

local function loadoutText(loadout)
	local guns = {}
	for _, slot in { "long", "sidearm" } do
		local id = loadout.weapons[slot]
		if id and Weapons.List[id] then
			table.insert(guns, Weapons.List[id].name)
		end
	end
	local parts = {}
	for _, itemId in Items.Order do
		local amount = loadout.items[itemId]
		if amount and amount > 0 then
			table.insert(parts, amount .. " " .. Items.Items[itemId].name)
		end
	end
	return table.concat(guns, " + ") .. "\n" .. table.concat(parts, " · ")
end

local function card(parent, charId, order)
	local def = Characters.List[charId]
	local selectedPerk = def.perks[1].id
	if player:GetAttribute("CharId") == charId and player:GetAttribute("PerkId") then
		selectedPerk = player:GetAttribute("PerkId")
	end

	local frame = Theme.panel({ Name = charId, LayoutOrder = order, Size = UDim2.new(0, 258, 0, 520), BackgroundColor3 = C.panelHi, Parent = parent })
	Theme.padding(12).Parent = frame
	Theme.list(Enum.FillDirection.Vertical, 5).Parent = frame

	local swatch = Theme.make("Frame", { LayoutOrder = 0, Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = def.colors.torso, BorderSizePixel = 0, Parent = frame })
	Theme.corner(3).Parent = swatch
	Theme.heading({ LayoutOrder = 1, Text = string.upper(def.name), TextSize = 22, Parent = frame })
	Theme.label({ LayoutOrder = 2, Text = def.role, TextColor3 = C.lantern, Font = Theme.Head, TextSize = 15, Size = UDim2.new(1, 0, 0, 18), Parent = frame })
	Theme.label({ LayoutOrder = 3, Text = def.bio, TextSize = 12, TextColor3 = C.dim, Size = UDim2.new(1, 0, 0, 32), Parent = frame })
	Theme.label({ LayoutOrder = 4, Text = "ABILITY · " .. def.ability.name, Font = Theme.Head, TextSize = 14, TextColor3 = C.salt, Size = UDim2.new(1, 0, 0, 16), Parent = frame })
	Theme.label({ LayoutOrder = 5, Text = def.ability.desc, TextSize = 12, Size = UDim2.new(1, 0, 0, 44), Parent = frame })
	Theme.label({ LayoutOrder = 6, Text = "LOADOUT", Font = Theme.Head, TextSize = 14, TextColor3 = C.salt, Size = UDim2.new(1, 0, 0, 16), Parent = frame })
	Theme.label({ LayoutOrder = 7, Text = loadoutText(def.loadout), TextSize = 12, Size = UDim2.new(1, 0, 0, 44), Parent = frame })
	Theme.label({ LayoutOrder = 8, Text = "INNATE · " .. def.innate.name, Font = Theme.Head, TextSize = 14, TextColor3 = C.salt, Size = UDim2.new(1, 0, 0, 16), Parent = frame })
	Theme.label({ LayoutOrder = 9, Text = def.innate.desc, TextSize = 12, Size = UDim2.new(1, 0, 0, 30), Parent = frame })
	Theme.label({ LayoutOrder = 10, Text = "STARTING PERK (choose one)", Font = Theme.Head, TextSize = 14, TextColor3 = C.salt, Size = UDim2.new(1, 0, 0, 16), Parent = frame })

	local perkRow = Theme.make("Frame", { LayoutOrder = 11, Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, Parent = frame })
	Theme.list(Enum.FillDirection.Horizontal, 4).Parent = perkRow
	local perkDesc = Theme.label({ LayoutOrder = 12, Text = "", TextSize = 12, Size = UDim2.new(1, 0, 0, 30), Parent = frame })
	local buttons = {}
	local function refresh()
		for id, button in buttons do
			local on = id == selectedPerk
			button.BackgroundColor3 = on and C.lantern or C.panel
			button.TextColor3 = on and C.backdrop or C.text
		end
		for _, perk in def.perks do
			if perk.id == selectedPerk then
				perkDesc.Text = perk.desc
			end
		end
	end
	for i, perk in def.perks do
		local b = Theme.button({ LayoutOrder = i, Text = perk.name, TextSize = 12, Size = UDim2.new(1 / 3, -3, 1, 0), Parent = perkRow })
		buttons[perk.id] = b
		b.Activated:Connect(function()
			selectedPerk = perk.id
			refresh()
		end)
	end
	refresh()

	local choose = Theme.button({ LayoutOrder = 13, Text = "CHOOSE " .. string.upper(def.name:match("^(%S+)")), Size = UDim2.new(1, 0, 0, 36), Parent = frame })
	choose.Activated:Connect(function()
		Net.event("SelectCharacter"):FireServer(charId, selectedPerk)
		CharacterSelect.close()
	end)
end

function CharacterSelect.build(gui)
	local panel
	backdrop, panel = Theme.modal(gui, "CharacterSelect", UDim2.new(0.96, 0, 0.92, 0), Vector2.new(1120, 640))
	Theme.heading({ Text = "BRINEWAKE  ·  THE CREW", TextSize = 30, Size = UDim2.new(1, -120, 0, 34), Parent = panel })
	Theme.label({ Text = "Every crew member is free and plays differently (ability and perks). Everyone starts with the Service Revolver and one signature long gun, with few spare rounds: unlock more guns at the Quartermaster.", Position = UDim2.new(0, 0, 0, 36), Size = UDim2.new(1, 0, 0, 20), TextColor3 = C.dim, TextSize = 13, Parent = panel })
	closeButton = Theme.button({ Text = "CLOSE", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 100, 0, 32), Parent = panel })
	closeButton.Activated:Connect(CharacterSelect.close)

	local scroller = Theme.make("ScrollingFrame", {
		Position = UDim2.new(0, 0, 0, 64),
		Size = UDim2.new(1, 0, 1, -64),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		ScrollingDirection = Enum.ScrollingDirection.XY,
		AutomaticCanvasSize = Enum.AutomaticSize.XY,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		Parent = panel,
	})
	Theme.list(Enum.FillDirection.Horizontal, 10).Parent = scroller
	for i, charId in Characters.Order do
		card(scroller, charId, i)
	end
end

function CharacterSelect.open()
	if not backdrop then
		return
	end
	closeButton.Visible = player:GetAttribute("CharId") ~= nil
	backdrop.Visible = true
	State.setModal("select", true)
end

function CharacterSelect.close()
	if not backdrop then
		return
	end
	backdrop.Visible = false
	State.setModal("select", false)
end

return CharacterSelect
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000057"><Properties><string name="Name">Chart</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The tide chart: choose the next encounter route (type, conditions, bonus).
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Encounters = require(Shared.Config.Encounters)
local Modifiers = require(Shared.Config.Modifiers)
local Theme = require(script.Parent.Theme)
local State = require(script.Parent.Parent.State)

local Chart = {}
local C = Theme.Colors
local backdrop, header, list
local request

local function modifierById(id)
	for _, m in Modifiers.List do
		if m.id == id then
			return m
		end
	end
	return Modifiers.None
end

local function rebuild()
	Theme.clear(list)
	local R = ReplicatedStorage
	header.Text = ("STOP %d OF %d  ·  PALL %d"):format(R:GetAttribute("RunIndex") or 1, R:GetAttribute("RunLength") or 4, R:GetAttribute("Pall") or 1)
	local ok, options = pcall(function()
		return HttpService:JSONDecode(R:GetAttribute("RouteOptions") or "[]")
	end)
	options = ok and options or {}
	local first
	for i, option in options do
		local def = option.type == "Finale" and Encounters.Finale or Encounters.Types[option.type]
		local mod = modifierById(option.modifier)
		local card = Theme.panel({ LayoutOrder = i, Size = UDim2.new(1, 0, 0, 150), BackgroundColor3 = C.panelHi, Parent = list })
		Theme.padding(10).Parent = card
		Theme.heading({ Text = string.upper(option.name), TextSize = 20, Size = UDim2.new(1, -170, 0, 24), Parent = card })
		local desc = def and def.desc or ""
		if option.type == "Salvage" then
			desc = desc:format(def.crates)
		end
		Theme.label({ Text = desc, Position = UDim2.new(0, 0, 0, 28), Size = UDim2.new(1, -170, 0, 44), TextSize = 15, TextWrapped = true, Parent = card })
		Theme.label({
			Text = ("%s  ·  %s\nConditions: %s · %s%s"):format(option.mapName or "", option.factionName or "The Hushed", mod.name, mod.desc, (option.bonus or 0) > 0 and ("  ·  +" .. option.bonus .. " Salvage") or ""),
			Position = UDim2.new(0, 0, 0, 76),
			Size = UDim2.new(1, -170, 0, 56),
			TextSize = 14,
			TextWrapped = true,
			TextColor3 = C.salt,
			Parent = card,
		})
		local go = Theme.button({ Text = "SET COURSE", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 150, 0, 40), Parent = card })
		go.Activated:Connect(function()
			request("ChooseRoute", i)
			Chart.close()
		end)
		first = first or go
	end
	Theme.focus(first)
end

function Chart.build(gui, requestFn)
	request = requestFn
	local panel
	backdrop, panel = Theme.modal(gui, "Chart", UDim2.new(0.94, 0, 0.9, 0), Vector2.new(720, 560))
	Theme.heading({ Text = "THE TIDE CHART", TextSize = 28, Size = UDim2.new(1, -120, 0, 32), Parent = panel })
	header = Theme.label({ Position = UDim2.new(0, 0, 0, 34), Size = UDim2.new(1, 0, 0, 20), TextColor3 = C.lantern, Font = Theme.Head, Parent = panel })
	local close = Theme.button({ Text = "CLOSE", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 100, 0, 32), Parent = panel })
	close.Activated:Connect(Chart.close)
	list = Theme.make("ScrollingFrame", {
		Position = UDim2.new(0, 0, 0, 64),
		Size = UDim2.new(1, 0, 1, -64),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		Parent = panel,
	})
	Theme.list(Enum.FillDirection.Vertical, 8).Parent = list
	ReplicatedStorage:GetAttributeChangedSignal("RouteOptions"):Connect(function()
		if backdrop.Visible then
			rebuild()
		end
	end)
end

function Chart.open()
	if backdrop then
		backdrop.Visible = true
		State.setModal("chart", true)
		rebuild()
	end
end

function Chart.close()
	if backdrop then
		backdrop.Visible = false
		State.setModal("chart", false)
	end
end

return Chart
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000058"><Properties><string name="Name">Diagnostics</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- F2 diagnostics: what the game is actually doing on your machine, so problems can be fixed
-- from facts instead of guesses. Shows client + server warnings/errors, the animator's
-- state, the last keys / actions received, open menus, and the asset-fitting report.
-- Everything is in a text box you can select and copy (Ctrl+A, Ctrl+C) to paste in a report.
local LogService = game:GetService("LogService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Theme = require(script.Parent.Theme)
local State = require(script.Parent.Parent.State)

local Diagnostics = {}
local C = Theme.Colors
local player = Players.LocalPlayer
local panel, box, badge
local lines = {} -- recent log lines
local errorCount = 0
local statusFn = nil

local function push(prefix, text)
	table.insert(lines, ("[%s %s] %s"):format(os.date("%H:%M:%S"), prefix, text))
	while #lines > 60 do
		table.remove(lines, 1)
	end
end

function Diagnostics.serverLine(kind, text)
	push("server " .. tostring(kind), tostring(text))
	if kind == "error" or kind == "warning" then
		errorCount += 1
	end
end

-- Notes the last few actions / keys the game received (ActionController / UIController).
function Diagnostics.noteInput(what)
	State.inputLog = State.inputLog or {}
	table.insert(State.inputLog, ("%s %s"):format(os.date("%H:%M:%S"), what))
	while #State.inputLog > 12 do
		table.remove(State.inputLog, 1)
	end
end

function Diagnostics.setStatusProvider(fn)
	statusFn = fn
end

function Diagnostics.build(gui)
	panel = Theme.panel({ Name = "Diagnostics", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 70), Size = UDim2.new(0, 560, 0.8, 0), BackgroundTransparency = 0.08, Visible = false, ZIndex = 50, Parent = gui })
	Theme.padding(10).Parent = panel
	Theme.heading({ Text = "DIAGNOSTICS  (F2)  ·  select all + copy, then paste it in your report", TextSize = 13, Size = UDim2.new(1, 0, 0, 16), ZIndex = 50, Parent = panel })
	local scroll = Instance.new("ScrollingFrame")
	scroll.Position = UDim2.new(0, 0, 0, 22)
	scroll.Size = UDim2.new(1, 0, 1, -22)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.CanvasSize = UDim2.new()
	scroll.ScrollBarThickness = 4
	scroll.ZIndex = 50
	scroll.Parent = panel
	box = Instance.new("TextBox")
	box.Size = UDim2.new(1, -6, 0, 0)
	box.AutomaticSize = Enum.AutomaticSize.Y
	box.BackgroundTransparency = 1
	box.TextColor3 = C.text
	box.Font = Enum.Font.Code
	box.TextSize = 12
	box.TextXAlignment = Enum.TextXAlignment.Left
	box.TextYAlignment = Enum.TextYAlignment.Top
	box.TextWrapped = true
	box.ClearTextOnFocus = false
	box.TextEditable = false
	box.MultiLine = true
	box.ZIndex = 50
	box.Parent = scroll
	badge = Theme.label({ Text = "", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 50), Size = UDim2.new(0, 260, 0, 16), TextXAlignment = Enum.TextXAlignment.Right, Font = Theme.Head, TextSize = 12, TextColor3 = C.danger, ZIndex = 50, Parent = gui })

	LogService.MessageOut:Connect(function(message, messageType)
		if messageType == Enum.MessageType.MessageError then
			errorCount += 1
			push("client error", message)
		elseif messageType == Enum.MessageType.MessageWarning then
			errorCount += 1
			push("client warning", message)
		elseif message:sub(1, 1) == "[" then
			push("client", message)
		end
	end)

	local acc = 0
	RunService.RenderStepped:Connect(function(dt)
		badge.Text = errorCount > 0 and ("F2 · %d warning%s / error%s"):format(errorCount, errorCount == 1 and "" or "s", errorCount == 1 and "" or "s") or ""
		if not panel.Visible then
			return
		end
		acc += dt
		if acc < 0.25 then
			return
		end
		acc = 0
		local out = {}
		local status = statusFn and statusFn() or {}
		table.insert(out, "== STATUS ==")
		for _, line in status do
			table.insert(out, line)
		end
		table.insert(out, "")
		table.insert(out, "== LAST INPUT ==")
		for _, line in State.inputLog or {} do
			table.insert(out, line)
		end
		table.insert(out, "")
		table.insert(out, "== LOG (newest last) ==")
		for _, line in lines do
			table.insert(out, line)
		end
		box.Text = table.concat(out, "\n")
	end)
end

function Diagnostics.toggle()
	if panel then
		panel.Visible = not panel.Visible
	end
end

return Diagnostics
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000059"><Properties><string name="Name">Guide</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- First-time help on the Meridian, so a new player knows exactly how to start:
--   * a small "Captain's orders" card (3 steps) until you've set sail once
--   * a gold guide line on the deck from you to the SET SAIL chart table
--   * for everyone on deck: a SET SAIL button (opens the tide chart from anywhere on the ship)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Game = require(Shared.Config.Game)
local Theme = require(script.Parent.Theme)
local Buttons = require(script.Parent.Buttons)
local Quartermaster = require(Shared.Config.Quartermaster)
local Projects = require(Shared.Config.Projects)
local HttpService = game:GetService("HttpService")
local State = require(script.Parent.Parent.State)

local Guide = {}
local C = Theme.Colors
local player = Players.LocalPlayer
local card, steps, sailButton, spinBadge
local beam, a0
local request

local function onDeck()
	local s = ReplicatedStorage:GetAttribute("MatchState")
	local root = State.root
	return (s == "Ferry" or s == "Planning") and root ~= nil and (root.Position - Game.FerryOrigin).Magnitude < 140
end

local function stationTarget(name)
	local world = Workspace:FindFirstChild("World")
	local ferry = world and world:FindFirstChild("Meridian")
	local part = ferry and ferry:FindFirstChild(name)
	if not part then
		return nil, nil
	end
	local a = part:FindFirstChild("GuideTarget")
	if not a then
		a = Instance.new("Attachment")
		a.Name = "GuideTarget"
		a.Parent = part
	end
	return a, part
end
local function chartTarget()
	return stationTarget("ChartTable")
end

local function decode(attr)
	local ok, v = pcall(function()
		return HttpService:JSONDecode(player:GetAttribute(attr) or "{}")
	end)
	return ok and type(v) == "table" and v or {}
end

-- What can you do with what you've earned? Returns tip text and the station to point at.
local dismissed = {}
local function upgradeTip()
	local scrip = player:GetAttribute("Scrip") or 0
	local materials = player:GetAttribute("Materials") or 0
	local guns, repairs = decode("Guns"), decode("Repairs")
	local armory = repairs.armory == true
	for _, g in Quartermaster.Guns do
		local price = math.floor(g.price * (armory and 0.85 or 1) + 0.5)
		if not guns[g.id] and scrip >= price and not dismissed["gun" .. g.id] then
			return ("You have %d Scrip: buy the %s at the QUARTERMASTER."):format(scrip, (require(Shared.Config.Weapons).List[g.id] or {}).name or g.id), "Quartermaster", "gun" .. g.id
		end
	end
	for _, p in Projects.List do
		if not repairs[p.id] and (not p.requires or repairs[p.requires]) and materials >= p.materials and not dismissed["proj" .. p.id] then
			return ("You have %d Materials: build the %s at the PROJECTS board. %s"):format(materials, p.name, p.desc), "ProjectsBoard", "proj" .. p.id
		end
	end
	if player:GetAttribute("FreeSpinReady") == true and not dismissed.spin then
		return "Your free Lucky Spin is ready at the wheel.", "SpinWheelStand", "spin"
	end
	return nil
end

function Guide.build(gui, requestFn)
	request = requestFn
	card = Theme.panel({ Name = "Guide", AnchorPoint = Vector2.new(0, 0), Position = UDim2.new(0, 22, 0, 90), Size = UDim2.new(0, 360, 0, 140), BackgroundTransparency = 0.12, Visible = false, Parent = gui })
	Theme.padding(12).Parent = card
	Theme.heading({ Text = "CAPTAIN'S ORDERS", TextSize = 18, TextColor3 = Color3.fromRGB(255, 200, 90), Size = UDim2.new(1, 0, 0, 22), Parent = card })
	local gotIt = Theme.button({ Name = "GotIt", Text = "GOT IT", TextSize = 13, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 70, 0, 22), Visible = false, Parent = card })
	gotIt.Activated:Connect(function()
		if card:GetAttribute("TipKey") then
			dismissed[card:GetAttribute("TipKey")] = true
		end
	end)
	steps = {}
	for i = 1, 3 do
		steps[i] = Theme.label({ Position = UDim2.new(0, 0, 0, 4 + i * 30), Size = UDim2.new(1, 0, 0, 28), TextWrapped = true, TextSize = 13, Parent = card })
	end
	sailButton = Theme.button({ Name = "SetSail", Text = "⚓  SET SAIL", TextSize = 20, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -24, 1, -150), Size = UDim2.new(0, 190, 0, 48), BackgroundColor3 = Color3.fromRGB(214, 150, 50), TextColor3 = Color3.fromRGB(30, 20, 8), Visible = false, Parent = gui })
	sailButton.Activated:Connect(function()
		request("OpenChart")
	end)
	spinBadge = Theme.button({ Name = "SpinBadge", Text = "🎡  FREE SPIN!", TextSize = 16, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -24, 1, -206), Size = UDim2.new(0, 190, 0, 38), BackgroundColor3 = Color3.fromRGB(120, 80, 200), Visible = false, Parent = gui })
	spinBadge.Activated:Connect(function()
		request("OpenSpin")
	end)
end

local function setBeam(show, target)
	target = target or chartTarget()
	if show and target and State.root then
		if not beam then
			a0 = Instance.new("Attachment")
			a0.Name = "GuideFrom"
			beam = Instance.new("Beam")
			beam.Name = "SetSailGuide"
			beam.Color = ColorSequence.new(Color3.fromRGB(255, 210, 100))
			beam.LightEmission = 1
			beam.LightInfluence = 0
			beam.Width0, beam.Width1 = 0.6, 0.6
			beam.FaceCamera = true
			beam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
			beam.TextureMode = Enum.TextureMode.Wrap
			beam.TextureLength = 2
			beam.TextureSpeed = 1.5
			beam.Transparency = NumberSequence.new(0.25)
			beam.Segments = 12
			beam.CurveSize0, beam.CurveSize1 = 2, -2
		end
		a0.Position = Vector3.new(0, -2.2, 0) -- along the deck, from your feet
		a0.Parent = State.root
		beam.Attachment0, beam.Attachment1 = a0, target
		beam.Parent = State.root
		beam.Enabled = true
	elseif beam then
		beam.Enabled = false
	end
end

function Guide.update()
	if not card then
		return
	end
	local deck = onDeck()
	local newPlayer = player:GetAttribute("NewPlayer") == true
	local menus = State.uiOpen()
	sailButton.Visible = deck and not menus and ReplicatedStorage:GetAttribute("MatchState") ~= "Starting"
	spinBadge.Visible = deck and not menus and player:GetAttribute("FreeSpinReady") == true
	local showGuide = deck and newPlayer and not menus
	local tip, station, key
	if deck and not newPlayer and not menus then
		tip, station, key = upgradeTip()
	end
	card.Visible = showGuide or tip ~= nil
	card.GotIt.Visible = tip ~= nil
	card:SetAttribute("TipKey", key)
	if tip then
		local target = stationTarget(station)
		setBeam(true, target)
		card:FindFirstChildWhichIsA("TextLabel").Text = "NEXT STEP"
		steps[1].Text = tip
		steps[1].Size = UDim2.new(1, 0, 0, 58)
		steps[1].TextColor3 = C.text
		steps[2].Text = "Follow the gold line. Scrip = guns & kits (Quartermaster) · Materials = ship upgrades (Projects) · Salvage = gun parts (Workbench)"
		steps[2].Position = UDim2.new(0, 0, 0, 92)
		steps[2].TextSize = 11
		steps[2].TextColor3 = C.dim
		steps[3].Text = ""
		return
	end
	steps[1].Size = UDim2.new(1, 0, 0, 28)
	steps[2].Position = UDim2.new(0, 0, 0, 64)
	steps[2].TextSize = 13
	card:FindFirstChildWhichIsA("TextLabel").Text = "CAPTAIN'S ORDERS"
	setBeam(showGuide)
	if showGuide then
		local hasCrew = player:GetAttribute("CharId") ~= nil
		local _, chart = chartTarget()
		local dist = chart and State.root and math.floor((chart.Position - State.root.Position).Magnitude) or 0
		local near = dist < 12
		local tick = "✔  "
		steps[1].Text = (hasCrew and tick or "1  ") .. "Choose your crew member"
		steps[1].TextColor3 = hasCrew and C.ok or C.text
		steps[2].Text = (near and tick or "2  ") .. ("Follow the gold light to the SET SAIL table%s"):format(near and "" or ("  (" .. dist .. " studs)"))
		steps[2].TextColor3 = near and C.ok or C.text
		steps[3].Text = "3  " .. (State.gamepad and ("Hold " .. Buttons.name("ButtonA") .. " at the table") or "Hold E at the table (or click SET SAIL)") .. ", then pick a mission"
	end
end

return Guide
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000005A"><Properties><string name="Name">HUD</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The HUD, designed to stay out of the way (survival-game minimal, not a Roblox overlay):
--   top        compass bar with objective / teammate markers and distances; one-line objective
--   bottom-right  fading cluster: segmented health, weapon + ammo pips, throwable;
--                 a weapon strip pops up when you switch
--   screen     thin crosshair + hitmarker, red damage vignette, detection arrows, noise ring
-- Everything fades out when you're idle and comes back when it matters.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Characters = require(Shared.Config.Characters)
local Items = require(Shared.Config.Items)
local Movement = require(Shared.Config.Movement)
local Weapons = require(Shared.Config.Weapons)
local Theme = require(script.Parent.Theme)
local State = require(script.Parent.Parent.State)

local HUD = {}
local C = Theme.Colors
local player = Players.LocalPlayer
local Weapon

local root
local compass, compassStrip, compassTicks, compassMarkers, objectiveLine, locationLabel
local cluster, segments, weaponName, magLabel, reserveLabel, pipHolder, pips, throwLabel, abilityLabel
local strip, stripSlots
local ticks, dot, hitmarker, breathLabel
local vignette
local ring, ringLabel
local toastHolder
local downed, downedText, secondWindButton
local indicatorLayer
local indicators = {}
local controlsPanel, controlsHint

local CONTROLS = {
	{ "MOVE", "WASD", "Left stick" },
	{ "SPRINT", "Shift (hold)", "L3" },
	{ "CROUCH · PRONE", "C tap · C hold", "B tap · B hold" },
	{ "JUMP · VAULT", "Space (face a ledge or low wall)", "A" },
	{ "DODGE · DIVE", "Left Alt (dive while sprinting)", "L1" },
	{ "LISTEN (hear enemies)", "Hold L", "Hold R3" },
	{ "FIRST PERSON", "K", "Satchel > View" },
	{ "AIM", "Right mouse", "L2 (aim assist)" },
	{ "HOLD BREATH", "Shift while aiming", "L3 while aiming" },
	{ "FIRE", "Left mouse", "R2" },
	{ "RELOAD", "R", "R1" },
	{ "WEAPONS", "1 long gun · 2 revolver · 3 holster", "D-right · hold: holster" },
	{ "BACKPACK GUN (slow)", "4", "hold D-down" },
	{ "QUIETING · GRAB · MELEE", "F (from behind: Quiet / grab)", "X" },
	{ "THROW · NEXT ITEM", "G · Z", "Y · D-down" },
	{ "ABILITY", "Q", "hold Y" },
	{ "HEAL · RESUPPLY", "H · B", "D-up · hold D-up" },
	{ "FLASHLIGHT · AMMO CACHE", "T · V", "D-left · hold D-left" },
	{ "SATCHEL", "I or Tab", "View" },
	{ "SWAP SHOULDER", "X", "tap R3" },
	{ "SETTINGS · CONTROLS", "P · F1", "in the satchel" },
	{ "DIAGNOSTICS", "F2", "" },
	{ "INTERACT · CLOSE MENU", "E (hold) · click", "A · B" },
}

function HUD.toggleControls(force)
	if not controlsPanel then
		return
	end
	if force == nil then
		controlsPanel.Visible = not controlsPanel.Visible
	else
		controlsPanel.Visible = force
	end
end
local noiseSmoothed, lastActivity, hitUntil, hurtFlash = 0, 0, 0, 0
local lastSig = ""

local SEGMENTS = 5
local COMPASS_W, COMPASS_FOV = 460, math.rad(150)

local function inv(id)
	return player:GetAttribute("Inv_" .. id) or 0
end

local function clock(seconds)
	seconds = math.max(0, math.floor(seconds))
	return ("%d:%02d"):format(math.floor(seconds / 60), seconds % 60)
end

local function label(props)
	props.TextStrokeTransparency = props.TextStrokeTransparency or 0.75
	return Theme.label(props)
end

function HUD.build(gui, onSecondWind, weaponController)
	Weapon = weaponController
	root = Theme.make("Frame", { Name = "HUD", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = gui })

	-- damage vignette (four soft red edges)
	vignette = {}
	for i, spec in {
		{ UDim2.new(0.18, 0, 1, 0), UDim2.new(0, 0, 0, 0), 0 },
		{ UDim2.new(0.18, 0, 1, 0), UDim2.new(0.82, 0, 0, 0), 180 },
		{ UDim2.new(1, 0, 0.2, 0), UDim2.new(0, 0, 0, 0), 90 },
		{ UDim2.new(1, 0, 0.2, 0), UDim2.new(0, 0, 0.8, 0), 270 },
	} do
		local f = Theme.make("Frame", { Size = spec[1], Position = spec[2], BackgroundColor3 = Color3.fromRGB(120, 10, 8), BorderSizePixel = 0, BackgroundTransparency = 1, Parent = root })
		local g = Instance.new("UIGradient")
		g.Rotation = spec[3]
		g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
		g.Parent = f
		vignette[i] = f
	end

	-- compass
	compass = Theme.make("CanvasGroup", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 18),
		Size = UDim2.new(0, COMPASS_W, 0, 30),
		BackgroundTransparency = 1,
		Parent = root,
	})
	local fade = Instance.new("UIGradient")
	fade.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.15, 0), NumberSequenceKeypoint.new(0.85, 0), NumberSequenceKeypoint.new(1, 1) })
	fade.Parent = compass
	Theme.make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 22), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = C.text, BackgroundTransparency = 0.6, BorderSizePixel = 0, Parent = compass })
	Theme.make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 18), Size = UDim2.new(0, 2, 0, 9), BackgroundColor3 = C.lantern, BorderSizePixel = 0, Parent = compass })
	compassStrip = Theme.make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = compass })
	compassTicks = {}
	for deg = 0, 345, 15 do
		local major = deg % 90 == 0
		local text = ({ [0] = "N", [90] = "E", [180] = "S", [270] = "W" })[deg] or (deg % 45 == 0 and "·" or "")
		local t = label({ Text = text, Font = Theme.Head, TextSize = major and 15 or 12, Size = UDim2.new(0, 24, 0, 18), AnchorPoint = Vector2.new(0.5, 0), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = major and C.text or C.dim, Parent = compassStrip })
		compassTicks[deg] = t
	end
	compassMarkers = {}
	objectiveLine = label({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 54), Size = UDim2.new(0, 640, 0, 26), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 20, TextStrokeTransparency = 0.45, TextColor3 = C.text, Font = Theme.Head, Parent = root })
	locationLabel = label({ Position = UDim2.new(0, 22, 0, 18), Size = UDim2.new(0, 420, 0, 48), TextSize = 16, Font = Theme.Head, TextColor3 = C.salt, TextWrapped = true, Parent = root })

	-- bottom-right cluster
	cluster = Theme.make("CanvasGroup", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -34, 1, -30), Size = UDim2.new(0, 260, 0, 120), BackgroundTransparency = 1, Parent = root })
	weaponName = label({ Size = UDim2.new(1, 0, 0, 16), TextXAlignment = Enum.TextXAlignment.Right, Font = Theme.Head, TextSize = 14, TextColor3 = C.dim, Parent = cluster })
	magLabel = label({ Position = UDim2.new(0, 0, 0, 14), Size = UDim2.new(1, -56, 0, 44), TextXAlignment = Enum.TextXAlignment.Right, Font = Theme.Head, TextSize = 44, Parent = cluster })
	reserveLabel = label({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 30), Size = UDim2.new(0, 52, 0, 24), TextXAlignment = Enum.TextXAlignment.Left, Font = Theme.Head, TextSize = 20, TextColor3 = C.dim, Parent = cluster })
	pipHolder = Theme.make("Frame", { Position = UDim2.new(0, 0, 0, 62), Size = UDim2.new(1, 0, 0, 10), BackgroundTransparency = 1, Parent = cluster })
	local pipLayout = Theme.list(Enum.FillDirection.Horizontal, 3)
	pipLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	pipLayout.Parent = pipHolder
	pips = {}
	for i = 1, 12 do
		pips[i] = Theme.make("Frame", { LayoutOrder = i, Size = UDim2.new(0, 4, 0, 10), BackgroundColor3 = C.text, BorderSizePixel = 0, Parent = pipHolder })
	end
	throwLabel = label({ Position = UDim2.new(0, 0, 0, 76), Size = UDim2.new(1, 0, 0, 16), TextXAlignment = Enum.TextXAlignment.Right, Font = Theme.Head, TextSize = 13, Parent = cluster })
	local healthRow = Theme.make("Frame", { Position = UDim2.new(0, 0, 0, 100), Size = UDim2.new(1, 0, 0, 7), BackgroundTransparency = 1, Parent = cluster })
	local hl = Theme.list(Enum.FillDirection.Horizontal, 3)
	hl.HorizontalAlignment = Enum.HorizontalAlignment.Right
	hl.Parent = healthRow
	segments = {}
	for i = 1, SEGMENTS do
		local back = Theme.make("Frame", { LayoutOrder = i, Size = UDim2.new(0, 46, 1, 0), BackgroundColor3 = Color3.fromRGB(40, 40, 38), BackgroundTransparency = 0.3, BorderSizePixel = 0, Parent = healthRow })
		segments[i] = Theme.make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.text, BorderSizePixel = 0, Parent = back })
	end
	abilityLabel = label({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 24, 1, -30), Size = UDim2.new(0, 300, 0, 18), Font = Theme.Head, TextSize = 13, TextColor3 = C.salt, Parent = root })

	-- weapon switch strip
	strip = Theme.make("CanvasGroup", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -34, 1, -158), Size = UDim2.new(0, 360, 0, 34), BackgroundTransparency = 1, GroupTransparency = 1, Parent = root })
	local sl = Theme.list(Enum.FillDirection.Horizontal, 6)
	sl.HorizontalAlignment = Enum.HorizontalAlignment.Right
	sl.Parent = strip
	stripSlots = {}
	for i, slot in { "long", "sidearm", "none" } do
		local f = Theme.make("Frame", { LayoutOrder = i, Size = UDim2.new(0, 112, 1, 0), BackgroundColor3 = C.panel, BackgroundTransparency = 0.25, BorderSizePixel = 0, Parent = strip })
		Theme.make("UIStroke", { Color = C.line, Transparency = 0.4, Parent = f })
		stripSlots[slot] = label({ Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center, Font = Theme.Head, TextSize = 13, Parent = f })
	end

	-- noise ring (small, bottom centre)
	local ringHolder = Theme.make("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -26), Size = UDim2.new(0, 70, 0, 70), BackgroundTransparency = 1, Parent = root })
	ring = Theme.make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.1, 0.1), BackgroundTransparency = 1, Parent = ringHolder })
	Theme.make("UICorner", { CornerRadius = UDim.new(1, 0), Parent = ring })
	Theme.make("UIStroke", { Color = C.text, Thickness = 1.5, Transparency = 0.45, Parent = ring })
	Theme.make("UIAspectRatioConstraint", { Parent = ring })
	ringLabel = label({ Text = "", TextSize = 11, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.new(0, 120, 0, 14), TextXAlignment = Enum.TextXAlignment.Center, Font = Theme.Head, TextColor3 = C.dim, Parent = ringHolder })

	-- crosshair
	ticks = {}
	for i = 1, 4 do
		local horizontal = i <= 2
		ticks[i] = Theme.make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = horizontal and UDim2.new(0, 8, 0, 1) or UDim2.new(0, 1, 0, 8), BackgroundColor3 = C.text, BackgroundTransparency = 0.1, BorderSizePixel = 0, Visible = false, Parent = root })
	end
	dot = Theme.make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 3, 0, 3), BackgroundColor3 = C.text, BorderSizePixel = 0, Visible = false, Parent = root })
	Theme.make("UICorner", { CornerRadius = UDim.new(1, 0), Parent = dot })
	hitmarker = Theme.make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 22, 0, 22), BackgroundTransparency = 1, Visible = false, Parent = root })
	for _, rot in { 45, -45 } do
		Theme.make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, 0, 0, 2), Rotation = rot, BackgroundColor3 = C.text, BorderSizePixel = 0, Parent = hitmarker })
	end

	breathLabel = label({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.5, 34), Size = UDim2.new(0, 220, 0, 14), TextXAlignment = Enum.TextXAlignment.Center, Font = Theme.Head, TextSize = 11, TextColor3 = C.dim, Text = "", Parent = root })

	-- controls card (F1)
	controlsPanel = Theme.panel({ Name = "Controls", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 22, 0.5, 0), Size = UDim2.new(0, 470, 0, 30 + #CONTROLS * 19), BackgroundTransparency = 0.18, Visible = false, ZIndex = 5, Parent = root })
	Theme.padding(12).Parent = controlsPanel
	Theme.heading({ Text = "CONTROLS", TextSize = 16, Size = UDim2.new(1, 0, 0, 18), ZIndex = 5, Parent = controlsPanel })
	for i, row in CONTROLS do
		local y = 22 + (i - 1) * 19
		label({ Text = row[1], Position = UDim2.new(0, 0, 0, y), Size = UDim2.new(0.36, 0, 0, 18), Font = Theme.Head, TextSize = 12, TextColor3 = C.dim, ZIndex = 5, Parent = controlsPanel })
		label({ Text = row[2], Position = UDim2.new(0.36, 0, 0, y), Size = UDim2.new(0.4, 0, 0, 18), TextSize = 12, ZIndex = 5, Parent = controlsPanel })
		local pad = row[3]
		if require(script.Parent.Buttons).isPlayStation() then
			-- PlayStation symbols instead of Xbox letters
			pad = (" " .. pad .. " "):gsub("([%s%-])A([%s%p])", "%1✕%2"):gsub("([%s%-])B([%s%p])", "%1○%2"):gsub("([%s%-])X([%s%p])", "%1□%2"):gsub("([%s%-])Y([%s%p])", "%1△%2"):gsub("View", "Touchpad")
			pad = pad:sub(2, -2)
		end
		label({ Text = pad, Position = UDim2.new(0.76, 0, 0, y), Size = UDim2.new(0.24, 0, 0, 18), TextSize = 11, TextColor3 = C.dim, ZIndex = 5, Parent = controlsPanel })
	end
	controlsHint = label({ Text = "F1  CONTROLS", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 24, 1, -52), Size = UDim2.new(0, 200, 0, 14), Font = Theme.Head, TextSize = 11, TextColor3 = C.dim, Parent = root })

	indicatorLayer = Theme.make("Frame", { Name = "Indicators", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = root })

	toastHolder = Theme.make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 76), Size = UDim2.new(0, 620, 0, 160), BackgroundTransparency = 1, Parent = root })
	Theme.list(Enum.FillDirection.Vertical, 2, Enum.HorizontalAlignment.Center).Parent = toastHolder

	downed = Theme.make("Frame", { Name = "Downed", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.5, Visible = false, Parent = root })
	downedText = Theme.heading({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42), Size = UDim2.new(0.9, 0, 0, 80), TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = true, TextSize = 26, Parent = downed })
	secondWindButton = Theme.button({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.53), Size = UDim2.new(0, 320, 0, 44), Text = "SECOND WIND  [R]", Parent = downed })
	secondWindButton.Activated:Connect(onSecondWind)
end

function HUD.toast(text)
	if not toastHolder or text == "" then
		return
	end
	local l = label({ Text = text, Size = UDim2.new(1, 0, 0, 20), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 14, Font = Theme.Head, TextStrokeTransparency = 0.6, Parent = toastHolder })
	task.delay(3.2, function()
		for i = 1, 10 do
			l.TextTransparency = i / 10
			l.TextStrokeTransparency = 0.6 + i / 25
			task.wait(0.04)
		end
		l:Destroy()
	end)
	local children = toastHolder:GetChildren()
	if #children > 5 then
		for _, child in children do
			if child:IsA("TextLabel") then
				child:Destroy()
				break
			end
		end
	end
end

function HUD.hit(data)
	if not hitmarker then
		return
	end
	hitUntil = os.clock() + (data.kill and 0.35 or 0.15)
	local color = data.kill and C.danger or (data.headshot and C.lantern or C.text)
	hitmarker.Size = UDim2.new(0, data.headshot and 30 or 22, 0, data.headshot and 30 or 22)
	for _, line in hitmarker:GetChildren() do
		if line:IsA("Frame") then
			line.BackgroundColor3 = color
		end
	end
end

function HUD.hurt()
	hurtFlash = 1
	lastActivity = os.clock()
end

-- Compass ------------------------------------------------------------------------------------

local function headingOf(dir)
	return math.atan2(dir.X, -dir.Z) -- 0 = north (-Z)
end

local function compassX(angle, camHeading)
	local rel = (angle - camHeading + math.pi) % (2 * math.pi) - math.pi
	return rel / (COMPASS_FOV / 2) * (COMPASS_W / 2) + COMPASS_W / 2, math.abs(rel) < COMPASS_FOV / 2
end

local function objectiveTargets()
	local list = {}
	local world = Workspace:FindFirstChild("World")
	local encounter = world and world:FindFirstChild("Encounter")
	local R = ReplicatedStorage
	if R:GetAttribute("MatchState") == "Encounter" and player:GetAttribute("InCrossing") then
		if encounter then
			for _, p in encounter:GetChildren() do
				if p.Name == "SupplyCrate" or p.Name == "MedCache" or (p.Name == "Relay" and p:FindFirstChildWhichIsA("ProximityPrompt", true)) then
					table.insert(list, { pos = p.Position, color = C.lantern, text = "◆" })
				elseif p.Name == "Nest" and p:IsA("Model") and p.PrimaryPart then
					table.insert(list, { pos = p.PrimaryPart.Position, color = C.danger, text = "✕" })
				elseif p.Name == "Survivor" and p:IsA("Model") and p:FindFirstChild("HumanoidRootPart") then
					table.insert(list, { pos = p.HumanoidRootPart.Position, color = C.ok, text = "✚", label = "SURVIVOR" })
				elseif p.Name == "Flare" and R:GetAttribute("ExtractionOpen") then
					table.insert(list, { pos = p.Position, color = C.danger, text = "▼", label = "FLARE" })
				elseif p.Name == "SignalLantern" then
					table.insert(list, { pos = p.Position, color = C.lantern, text = "✦", label = "LANTERN" })
				end
			end
		end
	else
		local ferry = world and world:FindFirstChild("Meridian")
		local chart = ferry and ferry:FindFirstChild("ChartTable")
		local bench = ferry and ferry:FindFirstChild("Workbench")
		if chart then
			table.insert(list, { pos = chart.Position, color = C.lantern, text = "◆", label = "TIDE CHART" })
		end
		if bench and R:GetAttribute("MatchState") == "Planning" then
			table.insert(list, { pos = bench.Position, color = C.salt, text = "◇", label = "WORKBENCH" })
		end
	end
	-- a hunt target is marked once you know who you're after
	local enemies = Workspace:FindFirstChild("Enemies")
	if enemies and R:GetAttribute("MatchState") == "Encounter" then
		for _, m in enemies:GetChildren() do
			local r = m:FindFirstChild("HumanoidRootPart")
			if r and m:GetAttribute("Elite") then
				table.insert(list, { pos = r.Position, color = C.danger, text = "☠", label = string.upper(tostring(m:GetAttribute("Elite"))) })
			end
		end
	end
	for _, p in Players:GetPlayers() do
		local char = p ~= player and p.Character
		local r = char and char:FindFirstChild("HumanoidRootPart")
		if r then
			table.insert(list, { pos = r.Position, color = char:GetAttribute("Downed") and C.danger or C.salt, text = "●", label = p.DisplayName })
		end
	end
	return list
end

local function updateCompass(camera)
	local look = camera.CFrame.LookVector
	local heading = headingOf(Vector3.new(look.X, 0, look.Z))
	for deg, t in compassTicks do
		local x, visible = compassX(math.rad(deg), heading)
		t.Visible = visible
		t.Position = UDim2.fromOffset(x, 0)
	end
	local targets = objectiveTargets()
	local origin = State.root and State.root.Position or camera.CFrame.Position
	for i, target in targets do
		local m = compassMarkers[i]
		if not m then
			m = label({ Size = UDim2.new(0, 80, 0, 30), AnchorPoint = Vector2.new(0.5, 0), TextXAlignment = Enum.TextXAlignment.Center, Font = Theme.Head, TextSize = 12, Parent = compassStrip })
			compassMarkers[i] = m
		end
		local d = target.pos - origin
		local x, visible = compassX(headingOf(Vector3.new(d.X, 0, d.Z)), heading)
		m.Visible = true
		m.Position = UDim2.fromOffset(math.clamp(x, 10, COMPASS_W - 10), -2)
		m.TextColor3 = target.color
		local meters = math.floor(d.Magnitude * 0.28 + 0.5)
		m.Text = target.text .. (visible and ("\n" .. meters .. "m") or "")
	end
	for i = #targets + 1, #compassMarkers do
		compassMarkers[i].Visible = false
	end
end

-- Detection arrows ------------------------------------------------------------------------------

local function updateIndicators(camera, active)
	local enemies = Workspace:FindFirstChild("Enemies")
	local seen = {}
	if active and enemies and State.root then
		local key = "Sus_" .. player.UserId
		local viewport = camera.ViewportSize / Theme.scale
		local center = Vector2.new(viewport.X / 2, viewport.Y / 2)
		local radius = math.min(viewport.X, viewport.Y) * 0.2
		for _, model in enemies:GetChildren() do
			local r = model:FindFirstChild("HumanoidRootPart")
			local st = model:GetAttribute("State")
			local sus = model:GetAttribute(key) or 0
			local hunting = st == "Chase" and model:GetAttribute("Target") == player.UserId
			if r and st ~= "Dispersed" and (sus > 0.04 or hunting) then
				seen[model] = true
				local l = indicators[model]
				if not l then
					l = label({ Text = "▲", Font = Enum.Font.GothamBold, TextSize = 22, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0, 28, 0, 28), TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center, Parent = indicatorLayer })
					indicators[model] = l
				end
				local rel = camera.CFrame:PointToObjectSpace(r.Position)
				local angle = math.atan2(rel.X, -rel.Z)
				l.Position = UDim2.fromOffset(center.X + math.sin(angle) * radius, center.Y - math.cos(angle) * radius)
				l.Rotation = math.deg(angle)
				local level = hunting and 1 or math.clamp(sus, 0, 1)
				l.TextColor3 = hunting and C.danger or (level >= 0.35 and C.lantern or C.text)
				l.TextTransparency = 0.8 - level * 0.8
				l.TextSize = 16 + level * 12
			end
		end
	end
	for model, l in indicators do
		if not seen[model] then
			l:Destroy()
			indicators[model] = nil
		end
	end
end

-- Frame update ----------------------------------------------------------------------------------

local function objectiveText(matchState, inEncounter)
	local R = ReplicatedStorage
	if matchState == "Encounter" and inEncounter then
		local kind = R:GetAttribute("EncounterType")
		local left = (R:GetAttribute("EndsAt") or 0) - Workspace:GetServerTimeNow()
		local name = string.upper(R:GetAttribute("EncounterName") or "")
		local noun = ({ Salvage = "CRATES", Medicine = "CACHES", Relay = "RELAYS", Nests = "NESTS", Hunt = "TARGET", Rescue = "SURVIVOR" })[kind]
		if noun then
			return R:GetAttribute("ExtractionOpen") and (name .. "  ·  REACH THE FLARE")
				or ("%s  ·  %s %d / %d"):format(name, noun, R:GetAttribute("Crates") or 0, R:GetAttribute("CratesRequired") or 0)
		elseif kind == "LanternWatch" then
			local hp, max = R:GetAttribute("LanternHP") or 0, math.max(1, R:GetAttribute("LanternMax") or 1)
			return ("%s  ·  LANTERN %d%%  ·  WAVE %d / %d  ·  %s"):format(name, math.floor(hp / max * 100), R:GetAttribute("Wave") or 0, R:GetAttribute("Waves") or 0, clock(left))
		elseif kind == "Drift" then
			return R:GetAttribute("ExtractionOpen") and (name .. "  ·  REACH THE FLARE") or (name .. "  ·  SURVIVE  " .. clock(left))
		end
	elseif matchState == "Starting" then
		return ("CASTING OFF IN %d"):format(math.max(0, math.ceil((R:GetAttribute("StartsAt") or 0) - Workspace:GetServerTimeNow())))
	elseif matchState == "Planning" then
		return "UPGRADE AT THE WORKBENCH  ·  CHOOSE A ROUTE AT THE TIDE CHART"
	elseif matchState == "Ferry" then
		return "READ THE TIDE CHART TO BEGIN A CROSSING"
	end
	return ""
end

function HUD.update(dt)
	if controlsHint then
		controlsHint.Text = State.gamepad and (require(script.Parent.Buttons).name("ButtonSelect"):upper() .. "  SATCHEL · SETTINGS · CONTROLS") or "F1  CONTROLS"
	end
	if not root then
		return
	end
	local camera = Workspace.CurrentCamera
	local viewport = camera.ViewportSize / Theme.scale
	local char = State.character
	local R = ReplicatedStorage
	local matchState = R:GetAttribute("MatchState")
	local inEncounter = matchState == "Encounter" and char ~= nil and player:GetAttribute("InCrossing") == true
	local now = os.clock()

	updateCompass(camera)
	objectiveLine.Text = objectiveText(matchState, inEncounter)
	if inEncounter then
		locationLabel.Text = ("%s\n%s · PALL %d"):format(string.upper(Workspace:GetAttribute("MapName") or ""), string.upper(R:GetAttribute("ModifierName") or ""), R:GetAttribute("Pall") or 1)
	elseif char then
		locationLabel.Text = R:GetAttribute("RunActive") and player:GetAttribute("InCrossing") and ("THE MERIDIAN\nSTOP %d OF %d · SALVAGE %d · MATERIALS %d"):format(R:GetAttribute("RunIndex") or 1, R:GetAttribute("RunLength") or 4, player:GetAttribute("Salvage") or 0, player:GetAttribute("Materials") or 0) or ("THE MERIDIAN\nSCRIP %d · MATERIALS %d"):format(player:GetAttribute("Scrip") or 0, player:GetAttribute("Materials") or 0)
	else
		locationLabel.Text = ""
	end

	-- health segments
	local hp = char and char:GetAttribute("HP") or 0
	local maxHp = char and char:GetAttribute("MaxHP") or 100
	local frac = math.clamp(hp / maxHp, 0, 1)
	for i, seg in segments do
		local segFrac = math.clamp(frac * SEGMENTS - (i - 1), 0, 1)
		seg.Size = UDim2.fromScale(segFrac, 1)
		seg.BackgroundColor3 = frac < 0.35 and C.danger or C.text
	end

	-- weapon
	local slot, id = Weapon.current()
	local def = id and Weapons.List[id]
	local mag = def and (player:GetAttribute("W_" .. slot .. "Mag") or 0) or 0
	if def then
		weaponName.Text = string.upper(def.name) .. (Weapon.isReloading() and "  ·  RELOADING" or "")
		magLabel.Text = tostring(mag)
		magLabel.TextColor3 = mag == 0 and C.danger or C.text
		reserveLabel.Text = "/ " .. inv(def.ammo)
		local stats = Weapon.stats()[slot]
		local size = stats and stats.mag or def.mag
		for i, pip in pips do
			pip.Visible = i <= math.min(size, 12)
			pip.BackgroundTransparency = i <= mag and 0 or 0.75
		end
	else
		weaponName.Text = "UNARMED"
		magLabel.Text = ""
		reserveLabel.Text = ""
		for _, pip in pips do
			pip.Visible = false
		end
	end
	local packText = ""
	local pack = player:GetAttribute("Pack") or ""
	if pack ~= "" then
		local first = pack:match("^([^:,]+)")
		packText = first and Weapons.List[first] and ("   ·   BACKPACK: %s [4]"):format(string.upper(Weapons.List[first].name)) or ""
	end
	throwLabel.Text = ("%s  %d%s"):format(string.upper(Items.Items[State.throwable].name), inv(State.throwable), packText)
	local charId = player:GetAttribute("CharId")
	local cdef = charId and Characters.List[charId]
	if cdef and char then
		local remaining = (char:GetAttribute("AbilityReadyAt") or 0) - Workspace:GetServerTimeNow()
		abilityLabel.Text = ("%s  %s"):format(string.upper(cdef.ability.name), remaining > 0 and (math.ceil(remaining) .. "s") or "· READY")
		abilityLabel.TextTransparency = remaining > 0 and 0.5 or 0.1
	else
		abilityLabel.Text = ""
	end

	-- contextual fade: show when aiming, hurt, low, reloading, just changed, or in a fight
	local sig = ("%s|%s|%d|%d|%s|%d"):format(tostring(id), tostring(slot), mag, inv(State.throwable), State.throwable, math.floor(hp))
	if sig ~= lastSig then
		lastSig = sig
		lastActivity = now
	end
	local wanted = State.aiming or frac < 0.5 or Weapon.isReloading() or (now - lastActivity) < 4 or not inEncounter
	cluster.GroupTransparency += ((wanted and 0 or 0.65) - cluster.GroupTransparency) * math.min(1, dt * 4)
	cluster.Visible = char ~= nil

	-- weapon strip after a switch
	local switched = State.weaponSwitchedAt and (now - State.weaponSwitchedAt) < 1.6
	strip.GroupTransparency += ((switched and 0 or 1) - strip.GroupTransparency) * math.min(1, dt * 8)
	for s, l in stripSlots do
		local wid = s ~= "none" and (player:GetAttribute("W_" .. s) or "") or ""
		l.Text = s == "none" and "UNARMED" or (wid ~= "" and Weapons.List[wid] and string.upper(Weapons.List[wid].name) or "—")
		l.TextColor3 = (slot == s) and C.lantern or C.dim
	end

	-- crosshair
	local show = def ~= nil and not State.uiOpen() and not State.downed
	local gap = 0
	if show then
		gap = math.tan(math.rad(Weapon.spread())) * viewport.Y / (2 * math.tan(math.rad(camera.FieldOfView) / 2)) + 3
	end
	local cx, cy = viewport.X / 2, viewport.Y / 2
	local offs = { Vector2.new(-gap - 4, 0), Vector2.new(gap + 4, 0), Vector2.new(0, -gap - 4), Vector2.new(0, gap + 4) }
	for i, t in ticks do
		t.Visible = show and State.aiming
		t.Position = UDim2.fromOffset(cx + offs[i].X, cy + offs[i].Y)
	end
	dot.Visible = show or (State.aiming and not State.uiOpen())
	hitmarker.Visible = now < hitUntil
	if show and State.aiming then
		breathLabel.Text = State.breath == "hold" and "STEADY" or (State.breath == "spent" and "CATCHING BREATH" or "SHIFT  HOLD BREATH")
		breathLabel.TextColor3 = State.breath == "hold" and C.salt or (State.breath == "spent" and C.danger or C.dim)
	else
		breathLabel.Text = ""
	end

	-- vignette: hits flash it, low health keeps it
	hurtFlash = math.max(0, hurtFlash - dt * 1.6)
	local vig = math.clamp(math.max(hurtFlash, (inEncounter and frac < 0.35) and (0.45 + math.sin(now * 3) * 0.1) or 0), 0, 1)
	for _, f in vignette do
		f.BackgroundTransparency = 1 - vig * 0.8
	end

	-- noise ring
	local noise = inEncounter and char and char:GetAttribute("Noise") or 0
	noiseSmoothed += (noise - noiseSmoothed) * math.min(1, dt * 8)
	local scale = math.clamp(noiseSmoothed / Movement.Noise.Sprint, 0.1, 1)
	ring.Size = UDim2.fromScale(scale, scale)
	ring.UIStroke.Transparency = inEncounter and 0.45 or 1
	ringLabel.Text = (inEncounter and noise > Movement.Noise.Walk + 2) and "LOUD" or ""
	ringLabel.TextColor3 = noise > Movement.Noise.Jog + 4 and C.danger or C.lantern

	-- downed
	local isDowned = char and char:GetAttribute("Downed") == true
	local isOut = char and char:GetAttribute("Out") == true
	downed.Visible = (isDowned or isOut) and inEncounter or false
	if isOut then
		downedText.Text = "LOST TO THE PALL\nWaiting for your crew…"
		secondWindButton.Visible = false
	elseif isDowned then
		local bleed = math.max(0, math.ceil((char:GetAttribute("BleedOutAt") or 0) - Workspace:GetServerTimeNow()))
		downedText.Text = ("YOU'RE DOWN\nA crewmate can revive you · %ds"):format(bleed)
		secondWindButton.Visible = true
		secondWindButton.Text = ("SECOND WIND  [R]   ·   %d"):format(player:GetAttribute("Tokens_secondWind") or 0)
	end

	updateIndicators(camera, inEncounter)
	assert(CollectionService)
end

return HUD
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000005B"><Properties><string name="Name">Logbook</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The Logbook: torn pages found on missions (lore), and the daily streak calendar.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Rewards = require(Shared.Config.Rewards)
local Theme = require(script.Parent.Theme)
local State = require(script.Parent.Parent.State)

local Logbook = {}
local C = Theme.Colors
local player = Players.LocalPlayer
local backdrop, list, reader, readerTitle, readerText, streakCard

local function found()
	local ok, v = pcall(function()
		return HttpService:JSONDecode(player:GetAttribute("Pages") or "{}")
	end)
	return ok and type(v) == "table" and v or {}
end

local function rebuild()
	Theme.clear(list)
	local have = found()
	local n = 0
	for _ in have do
		n += 1
	end
	Theme.heading({ LayoutOrder = 0, Text = ("PAGES FOUND  %d / %d   ·   every %d pages: +%d Scrip, +%d Materials"):format(n, #Rewards.Pages, Rewards.PageReward.every, Rewards.PageReward.scrip, Rewards.PageReward.materials), TextSize = 14, TextColor3 = C.salt, Size = UDim2.new(1, 0, 0, 20), Parent = list })
	for i, page in Rewards.Pages do
		local got = have[page.id] == true
		local b = Theme.button({ LayoutOrder = i, Text = got and page.title or "? ? ?   (find it on a mission)", TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -8, 0, 32), AutoButtonColor = got, TextColor3 = got and C.text or C.dim, Parent = list })
		Theme.padding(8).Parent = b
		b.Activated:Connect(function()
			if got then
				readerTitle.Text = page.title
				readerText.Text = page.text
			end
		end)
	end
end

function Logbook.build(gui)
	local panel
	backdrop, panel = Theme.modal(gui, "Logbook", UDim2.new(0.92, 0, 0.85, 0), Vector2.new(980, 600))
	Theme.heading({ Text = "LOGBOOK", TextSize = 28, Size = UDim2.new(1, -120, 0, 34), Parent = panel })
	Theme.label({ Position = UDim2.new(0, 0, 0, 34), Text = "Torn pages lie somewhere on every mission (look for the glint). Pick one to read it.", TextSize = 12, TextColor3 = C.dim, Size = UDim2.new(1, -120, 0, 18), Parent = panel })
	local close = Theme.button({ Text = "CLOSE", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 100, 0, 32), Parent = panel })
	close.Activated:Connect(Logbook.close)
	list = Theme.make("ScrollingFrame", { Position = UDim2.new(0, 0, 0, 60), Size = UDim2.new(0.45, 0, 1, -60), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Parent = panel })
	Theme.list(Enum.FillDirection.Vertical, 4).Parent = list
	reader = Theme.panel({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 60), Size = UDim2.new(0.53, 0, 1, -60), BackgroundColor3 = Color3.fromRGB(236, 226, 196), Parent = panel })
	Theme.padding(18).Parent = reader
	readerTitle = Theme.heading({ Text = "", TextSize = 20, TextColor3 = Color3.fromRGB(60, 44, 30), TextWrapped = true, Size = UDim2.new(1, 0, 0, 52), Parent = reader })
	readerText = Theme.label({ Text = "Pick a page you've found.", Font = Enum.Font.Merriweather, TextSize = 16, TextColor3 = Color3.fromRGB(50, 40, 30), TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Position = UDim2.new(0, 0, 0, 58), Size = UDim2.new(1, 0, 1, -58), Parent = reader })

	-- daily streak card (shown when the day's reward lands)
	streakCard = Theme.panel({ Name = "Streak", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 120), Size = UDim2.new(0, 640, 0, 150), Visible = false, ZIndex = 30, Parent = gui })
	Theme.padding(12).Parent = streakCard
	Theme.heading({ Name = "Title", Text = "DAILY REWARD", TextSize = 20, TextColor3 = Color3.fromRGB(255, 200, 90), Size = UDim2.new(1, -90, 0, 24), ZIndex = 31, Parent = streakCard })
	local ok = Theme.button({ Text = "NICE", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 80, 0, 26), ZIndex = 31, Parent = streakCard })
	ok.Activated:Connect(function()
		streakCard.Visible = false
	end)
	local row = Theme.make("Frame", { Name = "Days", Position = UDim2.new(0, 0, 0, 32), Size = UDim2.new(1, 0, 0, 90), BackgroundTransparency = 1, ZIndex = 31, Parent = streakCard })
	Theme.list(Enum.FillDirection.Horizontal, 6).Parent = row
	for i, d in Rewards.Streak do
		local cell = Theme.panel({ Name = "Day" .. i, LayoutOrder = i, Size = UDim2.new(1 / 7, -6, 1, 0), BackgroundColor3 = C.panelHi, ZIndex = 31, Parent = row })
		Theme.label({ Text = "DAY " .. i, Font = Theme.Head, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 18), ZIndex = 32, Parent = cell })
		Theme.label({ Text = d.text, TextSize = 11, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.new(0, 2, 0, 20), Size = UDim2.new(1, -4, 1, -22), ZIndex = 32, Parent = cell })
	end
	player:GetAttributeChangedSignal("Pages"):Connect(function()
		if backdrop.Visible then
			rebuild()
		end
	end)
end

function Logbook.showDaily(day, text)
	if not streakCard then
		return
	end
	streakCard.Title.Text = ("DAILY REWARD  ·  DAY %d: %s  ·  come back tomorrow for day %d"):format(day, tostring(text), day % #Rewards.Streak + 1)
	for i = 1, #Rewards.Streak do
		local cell = streakCard.Days:FindFirstChild("Day" .. i)
		if cell then
			cell.BackgroundColor3 = i == day and Color3.fromRGB(214, 150, 50) or (i < day and Color3.fromRGB(70, 110, 80) or C.panelHi)
		end
	end
	streakCard.Visible = true
	task.delay(12, function()
		streakCard.Visible = false
	end)
end

function Logbook.open()
	if backdrop then
		backdrop.Visible = true
		State.setModal("logbook", true)
		rebuild()
	end
end

function Logbook.close()
	if backdrop then
		backdrop.Visible = false
		State.setModal("logbook", false)
	end
end

return Logbook
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000005C"><Properties><string name="Name">Quartermaster</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The Quartermaster (Meridian store, Scrip): unlock guns, set your holster / backpack loadout,
-- and buy kits for your next crossing. Everyone starts with the revolver and a signature long gun.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Quartermaster = require(Shared.Config.Quartermaster)
local Weapons = require(Shared.Config.Weapons)
local Theme = require(script.Parent.Theme)
local State = require(script.Parent.Parent.State)

local QM = {}
local C = Theme.Colors
local player = Players.LocalPlayer
local backdrop, list, header
local request

local function decode(attr, default)
	local ok, v = pcall(function()
		return HttpService:JSONDecode(player:GetAttribute(attr) or "")
	end)
	return ok and v or default
end

local function hasArmory()
	local repairs = decode("Repairs", {})
	return repairs.armory == true
end

local function price(p)
	return math.floor(p * (hasArmory() and 0.85 or 1) + 0.5)
end

local function section(order, text)
	Theme.heading({ LayoutOrder = order, Text = text, TextSize = 16, TextColor3 = C.salt, Size = UDim2.new(1, -8, 0, 22), Parent = list })
end

local function row(order, title, desc)
	local r = Theme.panel({ LayoutOrder = order, Size = UDim2.new(1, -8, 0, 58), BackgroundColor3 = C.panelHi, Parent = list })
	Theme.padding(8).Parent = r
	Theme.heading({ Text = string.upper(title), TextSize = 14, Size = UDim2.new(1, -280, 0, 18), Parent = r })
	Theme.label({ Text = desc, Position = UDim2.new(0, 0, 0, 20), Size = UDim2.new(1, -280, 0, 28), TextSize = 11, TextWrapped = true, Parent = r })
	local holder = Theme.make("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 272, 0, 32), BackgroundTransparency = 1, Parent = r })
	local l = Theme.list(Enum.FillDirection.Horizontal, 6)
	l.HorizontalAlignment = Enum.HorizontalAlignment.Right
	l.Parent = holder
	return holder
end

local function button(parent, text, enabled, accent, onClick)
	local b = Theme.button({ Text = text, Size = UDim2.new(0, 130, 1, 0), TextSize = 12, AutoButtonColor = enabled, Parent = parent })
	if not enabled then
		b.TextTransparency = 0.5
	elseif accent then
		b.BackgroundColor3 = C.lantern
		b.TextColor3 = C.panel
	end
	if enabled then
		b.Activated:Connect(onClick)
	end
	return b
end

local function rebuild()
	Theme.clear(list)
	local scrip = player:GetAttribute("Scrip") or 0
	header.Text = ("SCRIP %d%s   ·   every crew member starts with a revolver and one signature gun"):format(scrip, hasArmory() and "   ·   ARMORY: 15% OFF" or "")
	local guns = decode("Guns", { revolver = true })
	local loadout = decode("Loadout", { long = "", pack = {} })
	loadout.pack = loadout.pack or {}
	local slots = Quartermaster.BackpackSlots + (hasArmory() and 1 or 0)
	local order = 0

	section(1, "GUNS")
	order = 1
	for _, g in Quartermaster.Guns do
		order += 1
		local holder = row(order, Weapons.List[g.id].name, g.desc)
		if guns[g.id] then
			local inHolster = loadout.long == g.id
			local inPack = table.find(loadout.pack, g.id) ~= nil
			button(holder, inHolster and "HOLSTERED" or "HOLSTER", not inHolster, false, function()
				local pack = {}
				for _, id in loadout.pack do
					if id ~= g.id then
						table.insert(pack, id)
					end
				end
				if loadout.long ~= "" and loadout.long ~= g.id then
					table.insert(pack, 1, loadout.long)
				end
				request("SetLoadout", g.id, pack)
			end)
			button(holder, inPack and "IN BACKPACK ✓" or "BACKPACK", not inHolster and (inPack or #loadout.pack < slots), false, function()
				local pack = table.clone(loadout.pack)
				local at = table.find(pack, g.id)
				if at then
					table.remove(pack, at)
				else
					table.insert(pack, g.id)
				end
				request("SetLoadout", loadout.long, pack)
			end)
		else
			local cost = price(g.price)
			button(holder, ("UNLOCK  %d SCRIP"):format(cost), scrip >= cost, true, function()
				request("UnlockGun", g.id)
			end)
		end
	end
	order += 1
	Theme.label({ LayoutOrder = order, Text = ("Holster: one long gun, quick to draw (1). Backpack: %d more gun%s, but digging one out (4) takes a few seconds and you can't shoot meanwhile."):format(slots, slots == 1 and "" or "s"), TextSize = 12, TextWrapped = true, TextColor3 = C.dim, Size = UDim2.new(1, -8, 0, 32), Parent = list })

	order += 1
	section(order, "KITS FOR YOUR NEXT CROSSING")
	local kit = decode("Kit", {})
	for _, k in Quartermaster.Kits do
		if k.robux then
			continue -- Ammo Crates are in the Purser's Office (Robux)
		end
		order += 1
		local have = kit[k.id] or 0
		local holder = row(order, k.name .. (have > 0 and ("  ·  PACKED x" .. have) or ""), k.desc)
		local cost = price(k.price)
		button(holder, ("BUY  %d SCRIP"):format(cost), scrip >= cost and have < Quartermaster.MaxKitsEach, true, function()
			request("BuyKit", k.id)
		end)
	end
end

function QM.build(gui, requestFn)
	request = requestFn
	local panel
	backdrop, panel = Theme.modal(gui, "Quartermaster", UDim2.new(0.94, 0, 0.9, 0), Vector2.new(760, 640))
	Theme.heading({ Text = "THE QUARTERMASTER", TextSize = 26, Size = UDim2.new(1, -120, 0, 32), Parent = panel })
	header = Theme.label({ Position = UDim2.new(0, 0, 0, 34), Size = UDim2.new(1, -120, 0, 18), TextSize = 12, TextColor3 = C.lantern, Parent = panel })
	local close = Theme.button({ Text = "CLOSE", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 100, 0, 32), Parent = panel })
	close.Activated:Connect(QM.close)
	list = Theme.make("ScrollingFrame", {
		Position = UDim2.new(0, 0, 0, 60),
		Size = UDim2.new(1, 0, 1, -60),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = panel,
	})
	Theme.list(Enum.FillDirection.Vertical, 6).Parent = list
	for _, attr in { "Scrip", "Guns", "Loadout", "Kit", "Repairs" } do
		player:GetAttributeChangedSignal(attr):Connect(function()
			if backdrop.Visible then
				rebuild()
			end
		end)
	end
end

function QM.open()
	if backdrop then
		backdrop.Visible = true
		State.setModal("quartermaster", true)
		rebuild()
	end
end

function QM.close()
	if backdrop then
		backdrop.Visible = false
		State.setModal("quartermaster", false)
	end
end

return QM
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000005D"><Properties><string name="Name">Quests</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The quest board: today's three challenges and this week's two, with progress.
-- Data comes from the server as the JSON attribute "Quests" (QuestService).
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local Theme = require(script.Parent.Theme)
local State = require(script.Parent.Parent.State)

local Quests = {}
local C = Theme.Colors
local player = Players.LocalPlayer
local backdrop, list

local function rebuild()
	Theme.clear(list)
	local ok, entries = pcall(function()
		return HttpService:JSONDecode(player:GetAttribute("Quests") or "[]")
	end)
	entries = ok and entries or {}
	local order = 0
	for _, kind in { "daily", "weekly" } do
		order += 1
		Theme.heading({ LayoutOrder = order, Text = kind == "daily" and "TODAY" or "THIS WEEK", TextSize = 16, TextColor3 = C.salt, Size = UDim2.new(1, 0, 0, 22), Parent = list })
		for _, q in entries do
			if q.kind == kind then
				order += 1
				local row = Theme.panel({ LayoutOrder = order, Size = UDim2.new(1, -8, 0, 64), BackgroundColor3 = C.panelHi, Parent = list })
				Theme.padding(8).Parent = row
				Theme.heading({ Text = string.upper(q.name), TextSize = 14, Size = UDim2.new(1, -150, 0, 18), Parent = row })
				Theme.label({ Text = q.desc, Position = UDim2.new(0, 0, 0, 20), Size = UDim2.new(1, -150, 0, 16), TextSize = 12, Parent = row })
				local bar = Theme.make("Frame", { Position = UDim2.new(0, 0, 0, 40), Size = UDim2.new(1, -150, 0, 6), BackgroundColor3 = Color3.fromRGB(40, 40, 38), BorderSizePixel = 0, Parent = row })
				Theme.make("Frame", { Size = UDim2.fromScale(math.clamp(q.p / math.max(1, q.target), 0, 1), 1), BackgroundColor3 = q.done and C.ok or C.lantern, BorderSizePixel = 0, Parent = bar })
				Theme.label({ Text = q.done and "DONE" or ("%d / %d"):format(q.p, q.target), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 140, 0, 18), TextXAlignment = Enum.TextXAlignment.Right, Font = Theme.Head, TextSize = 14, TextColor3 = q.done and C.ok or C.text, Parent = row })
				Theme.label({ Text = q.reward, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 22), Size = UDim2.new(0, 140, 0, 30), TextXAlignment = Enum.TextXAlignment.Right, TextWrapped = true, TextSize = 11, TextColor3 = C.dim, Parent = row })
			end
		end
	end
	if #entries == 0 then
		Theme.label({ LayoutOrder = 99, Text = "The board is being written up. Check back in a moment.", TextSize = 13, Size = UDim2.new(1, 0, 0, 20), Parent = list })
	end
end

function Quests.build(gui)
	local panel
	backdrop, panel = Theme.modal(gui, "Quests", UDim2.new(0.9, 0, 0.82, 0), Vector2.new(620, 560))
	Theme.heading({ Text = "QUEST BOARD", TextSize = 26, Size = UDim2.new(1, -120, 0, 32), Parent = panel })
	Theme.label({ Position = UDim2.new(0, 0, 0, 32), Text = "New challenges every day and every week. Rewards pay out the moment you finish.", TextSize = 12, TextColor3 = C.dim, Size = UDim2.new(1, -120, 0, 18), Parent = panel })
	local close = Theme.button({ Text = "CLOSE", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 100, 0, 32), Parent = panel })
	close.Activated:Connect(Quests.close)
	list = Theme.make("ScrollingFrame", {
		Position = UDim2.new(0, 0, 0, 58),
		Size = UDim2.new(1, 0, 1, -58),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = panel,
	})
	Theme.list(Enum.FillDirection.Vertical, 6).Parent = list
	player:GetAttributeChangedSignal("Quests"):Connect(function()
		if backdrop.Visible then
			rebuild()
		end
	end)
end

function Quests.open()
	if backdrop then
		backdrop.Visible = true
		State.setModal("quests", true)
		rebuild()
	end
end

function Quests.close()
	if backdrop then
		backdrop.Visible = false
		State.setModal("quests", false)
	end
end

return Quests
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000005E"><Properties><string name="Name">Repairs</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The Meridian projects board: permanent homebase upgrades built with Scrip + Materials (both
-- earned from missions) or a Shipwright's Crew token, plus the armory once it's built.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Projects = require(Shared.Config.Projects)
local Commerce = require(Shared.Config.Commerce)
local MarketplaceService = game:GetService("MarketplaceService")
local Weapons = require(Shared.Config.Weapons)
local Theme = require(script.Parent.Theme)
local State = require(script.Parent.Parent.State)

local Repairs = {}
local C = Theme.Colors
local player = Players.LocalPlayer
local backdrop, list, scripLabel
local request

local function owned()
	local ok, value = pcall(function()
		return HttpService:JSONDecode(player:GetAttribute("Repairs") or "{}")
	end)
	return ok and value or {}
end

local function rebuild()
	Theme.clear(list)
	scripLabel.Text = ("SCRIP %d   ·   MATERIALS %d   ·   SHIPWRIGHT TOKENS %d"):format(player:GetAttribute("Scrip") or 0, player:GetAttribute("Materials") or 0, player:GetAttribute("Tokens_build") or 0)
	local have = owned()
	local first
	for i, r in Projects.List do
		local done = have[r.id] == true
		local locked = r.requires and not have[r.requires]
		local row = Theme.panel({ LayoutOrder = i, Size = UDim2.new(1, -8, 0, 70), BackgroundColor3 = C.panelHi, Parent = list })
		Theme.padding(8).Parent = row
		Theme.heading({ Text = string.upper(r.name), TextSize = 15, Size = UDim2.new(1, -270, 0, 18), Parent = row })
		local note = r.desc
		if locked then
			note = ("Needs the %s first. "):format(Projects.get(r.requires).name) .. note
		end
		Theme.label({ Text = note, Position = UDim2.new(0, 0, 0, 20), Size = UDim2.new(1, -270, 0, 34), TextSize = 12, TextWrapped = true, TextColor3 = locked and C.dim or C.text, Parent = row })
		local buttons = Theme.make("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 262, 0, 34), BackgroundTransparency = 1, Parent = row })
		local l = Theme.list(Enum.FillDirection.Horizontal, 6)
		l.HorizontalAlignment = Enum.HorizontalAlignment.Right
		l.Parent = buttons
		if done then
			local b = Theme.button({ Text = "BUILT", Size = UDim2.new(0, 120, 1, 0), TextSize = 13, AutoButtonColor = false, Parent = buttons })
			b.TextColor3 = C.ok
		else
			local afford = (player:GetAttribute("Scrip") or 0) >= r.scrip and (player:GetAttribute("Materials") or 0) >= r.materials
			local build = Theme.button({ LayoutOrder = 1, Text = ("%d MATERIALS"):format(r.materials), Size = UDim2.new(0, 128, 1, 0), TextSize = 13, AutoButtonColor = afford and not locked, Parent = buttons })
			if not afford or locked then
				build.TextTransparency = 0.45
			end
			build.Activated:Connect(function()
				request("Repair", r.id, false)
			end)
			local tokens = player:GetAttribute("Tokens_build") or 0
			local skip = Theme.button({ LayoutOrder = 2, Text = tokens > 0 and "USE CREW TOKEN" or ("BUILD NOW  R$" .. Commerce.Products.ShipwrightCrew.price), Size = UDim2.new(0, 128, 1, 0), TextSize = 12, Parent = buttons })
			skip.BackgroundColor3 = C.lantern
			skip.TextColor3 = C.panel
			skip.Activated:Connect(function()
				if (player:GetAttribute("Tokens_build") or 0) > 0 then
					request("Repair", r.id, true)
				elseif Commerce.Products.ShipwrightCrew.productId ~= 0 then
					MarketplaceService:PromptProductPurchase(player, Commerce.Products.ShipwrightCrew.productId)
				end
			end)
			first = first or build
		end
	end
	Theme.focus(first)
end

function Repairs.build(gui, requestFn)
	request = requestFn
	local panel
	backdrop, panel = Theme.modal(gui, "Repairs", UDim2.new(0.94, 0, 0.9, 0), Vector2.new(660, 600))
	Theme.heading({ Text = "MERIDIAN PROJECTS", TextSize = 26, Size = UDim2.new(1, -120, 0, 32), Parent = panel })
	scripLabel = Theme.heading({ Position = UDim2.new(0, 0, 0, 34), Size = UDim2.new(1, 0, 0, 22), TextSize = 15, TextColor3 = C.lantern, Parent = panel })
	local close = Theme.button({ Text = "CLOSE", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 100, 0, 32), Parent = panel })
	close.Activated:Connect(Repairs.close)
	list = Theme.make("ScrollingFrame", {
		Position = UDim2.new(0, 0, 0, 64),
		Size = UDim2.new(1, 0, 1, -64),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		Parent = panel,
	})
	Theme.list(Enum.FillDirection.Vertical, 6).Parent = list
	for _, attr in { "Scrip", "Repairs", "Materials", "Tokens_build" } do
		player:GetAttributeChangedSignal(attr):Connect(function()
			if backdrop.Visible then
				rebuild()
			end
		end)
	end
end

function Repairs.open()
	if backdrop then
		backdrop.Visible = true
		State.setModal("repairs", true)
		rebuild()
	end
end

function Repairs.close()
	if backdrop then
		backdrop.Visible = false
		State.setModal("repairs", false)
	end
end

return Repairs
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000005F"><Properties><string name="Name">Results</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- End-of-encounter debrief.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local Theme = require(script.Parent.Theme)
local State = require(script.Parent.Parent.State)

local Results = {}
local C = Theme.Colors
local backdrop, title, body

function Results.build(gui)
	local panel
	backdrop, panel = Theme.modal(gui, "Results", UDim2.new(0.9, 0, 0.7, 0), Vector2.new(580, 420))
	Theme.list(Enum.FillDirection.Vertical, 10).Parent = panel
	title = Theme.heading({ LayoutOrder = 1, Text = "", TextSize = 32, Size = UDim2.new(1, 0, 0, 38), Parent = panel })
	body = Theme.label({ LayoutOrder = 2, Text = "", TextSize = 15, Size = UDim2.new(1, 0, 0, 170), Parent = panel })
	local back = Theme.button({ LayoutOrder = 3, Text = "RETURN TO THE MERIDIAN", Size = UDim2.new(0, 280, 0, 40), Parent = panel })
	back.Activated:Connect(function()
		Net.event("ReturnToFerry"):FireServer()
		back.Text = "WAITING FOR CREW…"
	end)
	Results.backButton = back
end

function Results.show(data)
	if not backdrop then
		return
	end
	if data.runWon then
		title.Text = "THE BREAKWATER IS LIT"
		title.TextColor3 = C.lantern
	elseif data.win then
		title.Text = string.upper(tostring(data.name or "")) .. " CLEARED"
		title.TextColor3 = C.lantern
	else
		title.Text = "LOST TO THE PALL"
		title.TextColor3 = C.danger
	end
	local seconds = data.seconds or 0
	local lines = {
		("Stop %d  ·  Pall %d  ·  %d:%02d"):format(data.index or 1, data.pall or 1, math.floor(seconds / 60), seconds % 60),
		("Quietings %d  ·  Hushed dispersed %d  ·  Times spotted %d"):format(data.takedowns or 0, data.kills or 0, data.detections or 0),
	}
	if (data.crates or 0) > 0 then
		table.insert(lines, ("Supply crates %d"):format(data.crates))
	end
	if data.rewards and #data.rewards > 0 then
		table.insert(lines, "")
		table.insert(lines, "Earned: " .. table.concat(data.rewards, ", "))
	end
	table.insert(lines, "")
	if data.runOver then
		table.insert(lines, data.runWon and "Crossing complete. Scrip is yours to keep: repair the Meridian." or "The crossing is over. Scrip you earned is kept.")
	else
		table.insert(lines, "Back to the Meridian to upgrade and choose the next route.")
	end
	body.Text = table.concat(lines, "\n")
	Results.backButton.Text = "RETURN TO THE MERIDIAN"
	backdrop.Visible = true
	State.setModal("results", true)
end

function Results.close()
	if backdrop then
		backdrop.Visible = false
		State.setModal("results", false)
	end
end

return Results
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000060"><Properties><string name="Name">Satchel</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The satchel: everything you carry, throwable selection, field crafting and run aids.
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Items = require(Shared.Config.Items)
local Stats = require(Shared.Stats)
local Theme = require(script.Parent.Theme)
local State = require(script.Parent.Parent.State)

local Satchel = {}
local C = Theme.Colors
local player = Players.LocalPlayer
local backdrop, partsText, ammoText, kitText, tokenText
local throwButtons = {}
local recipeLabels = {}
local firstButton
local sendAction

local function inv(id)
	return player:GetAttribute("Inv_" .. id) or 0
end

local function cap(id)
	return player:GetAttribute("Cap_" .. id) or Items.Items[id].cap
end

local function line(ids)
	local parts = {}
	for _, id in ids do
		table.insert(parts, ("%s %d/%d"):format(Items.Items[id].name, inv(id), cap(id)))
	end
	return table.concat(parts, "   ")
end

local function costText(recipe)
	local parts = {}
	for itemId, amount in recipe.cost do
		local have = inv(itemId)
		table.insert(parts, ("%d %s%s"):format(amount, Items.Items[itemId].name, have < amount and " ✕" or ""))
	end
	local mods = Stats.compute(player:GetAttribute("CharId"), player:GetAttribute("PerkId"))
	local workshop = (player:GetAttribute("Repairs") or ""):find('"workshop":true') ~= nil
	local yield = recipe.amount + ((recipe.perkYield and mods.craftYieldBonus) or 0) + ((recipe.perkYield and workshop) and 1 or 0)
	local space = cap(recipe.output) - inv(recipe.output)
	local text = table.concat(parts, " + ") .. (yield > 1 and ("  →  ×" .. yield) or "")
	if space < yield then
		text ..= space <= 0 and "  (full)" or ("  (room for %d: use some first)"):format(space)
	end
	return text
end

local menuHandlers = {}

function Satchel.build(gui, actionSender)
	sendAction = actionSender
	local panel
	backdrop, panel = Theme.modal(gui, "Satchel", UDim2.new(0.94, 0, 0.9, 0), Vector2.new(640, 640))
	local scroller = Theme.make("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		Parent = panel,
	})
	Theme.list(Enum.FillDirection.Vertical, 8).Parent = scroller
	Theme.heading({ LayoutOrder = 1, Text = "SATCHEL", TextSize = 28, Size = UDim2.new(1, 0, 0, 32), Parent = scroller })
	partsText = Theme.label({ LayoutOrder = 2, Font = Theme.Head, TextSize = 14, Size = UDim2.new(1, 0, 0, 36), Parent = scroller })
	ammoText = Theme.label({ LayoutOrder = 3, Font = Theme.Head, TextSize = 14, Size = UDim2.new(1, 0, 0, 20), TextColor3 = C.lantern, Parent = scroller })
	kitText = Theme.label({ LayoutOrder = 4, Font = Theme.Head, TextSize = 14, Size = UDim2.new(1, 0, 0, 20), Parent = scroller })

	Theme.heading({ LayoutOrder = 5, Text = "THROWABLE (G to throw)", TextSize = 17, TextColor3 = C.salt, Size = UDim2.new(1, 0, 0, 22), Parent = scroller })
	local row = Theme.make("Frame", { LayoutOrder = 6, Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1, Parent = scroller })
	Theme.list(Enum.FillDirection.Horizontal, 6).Parent = row
	for i, id in Items.Throwables do
		local b = Theme.button({ LayoutOrder = i, Text = Items.Items[id].name, TextSize = 13, Size = UDim2.new(0.25, -5, 1, 0), Parent = row })
		throwButtons[id] = b
		b.Activated:Connect(function()
			State.throwable = id
		end)
		firstButton = firstButton or b
	end

	Theme.heading({ LayoutOrder = 7, Text = "CRAFT", TextSize = 17, TextColor3 = C.salt, Size = UDim2.new(1, 0, 0, 22), Parent = scroller })
	for i, recipeId in Items.RecipeOrder do
		local r = Theme.make("Frame", { LayoutOrder = 7 + i, Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1, Parent = scroller })
		recipeLabels[recipeId] = Theme.label({ Size = UDim2.new(1, -130, 1, 0), TextYAlignment = Enum.TextYAlignment.Center, TextSize = 13, Parent = r })
		local b = Theme.button({ Text = "CRAFT", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 120, 1, 0), Parent = r })
		b.Activated:Connect(function()
			sendAction("Craft", recipeId)
		end)
	end

	Theme.heading({ LayoutOrder = 20, Text = "RUN AIDS", TextSize = 17, TextColor3 = C.salt, Size = UDim2.new(1, 0, 0, 22), Parent = scroller })
	tokenText = Theme.label({ LayoutOrder = 21, TextSize = 12, Size = UDim2.new(1, 0, 0, 48), Parent = scroller })
	local resupply = Theme.button({ LayoutOrder = 22, Text = "USE RESUPPLY  [B]", Size = UDim2.new(0, 220, 0, 36), Parent = scroller })
	resupply.Activated:Connect(function()
		sendAction("Resupply")
	end)
	-- menus that have no key on a controller (and are handy with a mouse too)
	Theme.heading({ LayoutOrder = 24, Text = "MENU", TextSize = 17, TextColor3 = C.salt, Size = UDim2.new(1, 0, 0, 22), Parent = scroller })
	local menuRow = Theme.make("Frame", { LayoutOrder = 25, Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1, Parent = scroller })
	Theme.list(Enum.FillDirection.Horizontal, 6).Parent = menuRow
	for i, entry in { { "LUCKY SPIN", "spin" }, { "LOGBOOK", "logbook" }, { "SHOP", "shop" }, { "FIRST/THIRD PERSON", "view" }, { "SETTINGS", "settings" }, { "CONTROLS", "controls" } } do
		local b = Theme.button({ LayoutOrder = i, Text = entry[1], TextSize = 12, Size = UDim2.new(1 / 7, -5, 1, 0), Parent = menuRow })
		b.Activated:Connect(function()
			local fn = menuHandlers[entry[2]]
			if fn then
				Satchel.close()
				fn()
			end
		end)
	end
	local close = Theme.button({ LayoutOrder = 30, Text = "CLOSE  [Tab / B]", Size = UDim2.new(0, 180, 0, 36), Parent = scroller })
	close.Activated:Connect(Satchel.close)
end

function Satchel.setMenuHandlers(handlers)
	menuHandlers = handlers
end

function Satchel.refresh()
	if not backdrop or not backdrop.Visible then
		return
	end
	partsText.Text = line({ "cloth", "alcohol", "powder" }) .. "\n" .. line({ "scrap", "tape", "canister" })
	ammoText.Text = line({ "pistolAmmo", "rifleAmmo", "shells", "arrows" })
	kitText.Text = line({ "dressing", "spike" })
	for id, b in throwButtons do
		local on = State.throwable == id
		b.Text = ("%s %d"):format(Items.Items[id].name, inv(id))
		b.BackgroundColor3 = on and C.lantern or C.panelHi
		b.TextColor3 = on and C.backdrop or C.text
	end
	for recipeId, label in recipeLabels do
		local recipe = Items.Recipes[recipeId]
		label.Text = recipe.name .. "  ·  " .. costText(recipe)
	end
	tokenText.Text = ("Second Wind: %d (when downed, once per crossing) · Resupply: %d (once per crossing)\nEarn more free by finishing crossings, or at the Purser's Office."):format(
		player:GetAttribute("Tokens_secondWind") or 0, player:GetAttribute("Tokens_resupply") or 0)
end

function Satchel.toggle()
	if not backdrop then
		return
	end
	if backdrop.Visible then
		Satchel.close()
	else
		backdrop.Visible = true
		State.setModal("satchel", true)
		Satchel.refresh()
		Theme.focus(firstButton)
	end
end

function Satchel.close()
	if backdrop then
		backdrop.Visible = false
		State.setModal("satchel", false)
	end
end

return Satchel
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000061"><Properties><string name="Name">Settings</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Settings: view (first / third person, field of view), text and menu size, graphics preset,
-- look sensitivity, reduce camera motion. Saved to your profile.
local Players = game:GetService("Players")

local Theme = require(script.Parent.Theme)
local State = require(script.Parent.Parent.State)

local Settings = {}
local C = Theme.Colors
local player = Players.LocalPlayer
local backdrop, modeButtons, activeLabel, sensLabel, motionButton
local request
local pending = { graphics = "Auto", sensitivity = 1, reduceMotion = false, camera = "First", uiSize = "Large", fov = 80 }
local camButtons, sizeButtons, fovLabel

local MODES = { "Auto", "Performance", "Balanced", "Cinematic" }

local function refresh()
	for mode, b in modeButtons do
		local on = pending.graphics == mode
		b.BackgroundColor3 = on and C.lantern or C.panelHi
		b.TextColor3 = on and C.backdrop or C.text
	end
	activeLabel.Text = ("Running: %s. Cinematic adds depth of field with aim focus, sun rays, a filmic grade, denser fog and rain, and shadows on every light. Best on PC and PlayStation."):format(player:GetAttribute("GraphicsMode") or "?")
	sensLabel.Text = ("Look sensitivity  %.1f"):format(pending.sensitivity)
	motionButton.Text = pending.reduceMotion and "REDUCE CAMERA MOTION: ON" or "REDUCE CAMERA MOTION: OFF"
	for mode, b in camButtons do
		local on = pending.camera == mode
		b.BackgroundColor3 = on and C.lantern or C.panelHi
		b.TextColor3 = on and C.backdrop or C.text
	end
	for mode, b in sizeButtons do
		local on = pending.uiSize == mode
		b.BackgroundColor3 = on and C.lantern or C.panelHi
		b.TextColor3 = on and C.backdrop or C.text
	end
	fovLabel.Text = ("Field of view  %d"):format(pending.fov)
end

local function save()
	request("SaveSettings", pending)
end

function Settings.build(gui, requestFn)
	request = requestFn
	modeButtons, camButtons, sizeButtons = {}, {}, {}
	local panel
	backdrop, panel = Theme.modal(gui, "Settings", UDim2.new(0.92, 0, 0.9, 0), Vector2.new(720, 700))
	panel = Theme.make("ScrollingFrame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 6, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Parent = panel })
	Theme.list(Enum.FillDirection.Vertical, 10).Parent = panel
	Theme.heading({ LayoutOrder = 1, Text = "SETTINGS", TextSize = 28, Size = UDim2.new(1, 0, 0, 32), Parent = panel })
	-- the view: Brinewake is played in first person; third person is an option here
	Theme.heading({ LayoutOrder = 10, Text = "VIEW", TextSize = 16, TextColor3 = C.salt, Size = UDim2.new(1, 0, 0, 20), Parent = panel })
	local camRow = Theme.make("Frame", { LayoutOrder = 11, Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 1, Parent = panel })
	Theme.list(Enum.FillDirection.Horizontal, 6).Parent = camRow
	for i, entry in { { "First", "FIRST PERSON (recommended)" }, { "Third", "THIRD PERSON" } } do
		local b = Theme.button({ LayoutOrder = i, Text = entry[2], TextSize = 14, Size = UDim2.new(0.5, -3, 1, 0), Parent = camRow })
		camButtons[entry[1]] = b
		b.Activated:Connect(function()
			pending.camera = entry[1]
			save()
			refresh()
		end)
	end
	fovLabel = Theme.heading({ LayoutOrder = 12, TextSize = 16, Size = UDim2.new(1, 0, 0, 20), Parent = panel })
	local fovRow = Theme.make("Frame", { LayoutOrder = 13, Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1, Parent = panel })
	Theme.list(Enum.FillDirection.Horizontal, 6).Parent = fovRow
	for i, delta in { -5, 5 } do
		local b = Theme.button({ LayoutOrder = i, Text = delta < 0 and "–" or "+", Size = UDim2.new(0, 60, 1, 0), Parent = fovRow })
		b.Activated:Connect(function()
			pending.fov = math.clamp(pending.fov + delta, 60, 110)
			save()
			refresh()
		end)
	end
	Theme.heading({ LayoutOrder = 14, Text = "TEXT AND MENU SIZE", TextSize = 16, TextColor3 = C.salt, Size = UDim2.new(1, 0, 0, 20), Parent = panel })
	local sizeRow = Theme.make("Frame", { LayoutOrder = 15, Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 1, Parent = panel })
	Theme.list(Enum.FillDirection.Horizontal, 6).Parent = sizeRow
	for i, mode in { "Normal", "Large", "Huge" } do
		local b = Theme.button({ LayoutOrder = i, Text = string.upper(mode), TextSize = 14, Size = UDim2.new(1 / 3, -4, 1, 0), Parent = sizeRow })
		sizeButtons[mode] = b
		b.Activated:Connect(function()
			pending.uiSize = mode
			save()
			refresh()
		end)
	end
	Theme.heading({ LayoutOrder = 2, Text = "GRAPHICS", TextSize = 16, TextColor3 = C.salt, Size = UDim2.new(1, 0, 0, 20), Parent = panel })
	local row = Theme.make("Frame", { LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 1, Parent = panel })
	Theme.list(Enum.FillDirection.Horizontal, 6).Parent = row
	for i, mode in MODES do
		local b = Theme.button({ LayoutOrder = i, Text = string.upper(mode), TextSize = 13, Size = UDim2.new(0.25, -5, 1, 0), Parent = row })
		modeButtons[mode] = b
		b.Activated:Connect(function()
			pending.graphics = mode
			save()
			task.delay(0.3, refresh)
		end)
	end
	activeLabel = Theme.label({ LayoutOrder = 4, TextSize = 12, TextColor3 = C.dim, Size = UDim2.new(1, 0, 0, 48), Parent = panel })
	sensLabel = Theme.heading({ LayoutOrder = 5, TextSize = 16, Size = UDim2.new(1, 0, 0, 20), Parent = panel })
	local sensRow = Theme.make("Frame", { LayoutOrder = 6, Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1, Parent = panel })
	Theme.list(Enum.FillDirection.Horizontal, 6).Parent = sensRow
	for i, delta in { -0.1, 0.1 } do
		local b = Theme.button({ LayoutOrder = i, Text = delta < 0 and "–" or "+", Size = UDim2.new(0, 60, 1, 0), Parent = sensRow })
		b.Activated:Connect(function()
			pending.sensitivity = math.clamp(math.floor((pending.sensitivity + delta) * 10 + 0.5) / 10, 0.2, 3)
			save()
			refresh()
		end)
	end
	motionButton = Theme.button({ LayoutOrder = 7, Size = UDim2.new(0, 320, 0, 36), Parent = panel })
	motionButton.Activated:Connect(function()
		pending.reduceMotion = not pending.reduceMotion
		save()
		refresh()
	end)
	local close = Theme.button({ LayoutOrder = 20, Text = "CLOSE  [P]", Size = UDim2.new(0, 160, 0, 36), Parent = panel })
	close.Activated:Connect(Settings.close)
end

-- Change one setting from anywhere (the camera key): builds the full set from what is saved now.
function Settings.setValue(key, value)
	local current = {
		graphics = player:GetAttribute("Set_graphics") or "Auto",
		sensitivity = player:GetAttribute("Set_sensitivity") or 1,
		reduceMotion = player:GetAttribute("Set_reduceMotion") == true,
		camera = player:GetAttribute("Set_camera") or "First",
		uiSize = player:GetAttribute("Set_uiSize") or "Large",
		fov = player:GetAttribute("Set_fov") or 80,
	}
	current[key] = value
	player:SetAttribute("Set_" .. key, value) -- immediate; the server confirms and saves
	if request then
		request("SaveSettings", current)
	end
end

function Settings.toggle()
	if not backdrop then
		return
	end
	if backdrop.Visible then
		Settings.close()
		return
	end
	pending = {
		graphics = player:GetAttribute("Set_graphics") or "Auto",
		sensitivity = player:GetAttribute("Set_sensitivity") or 1,
		reduceMotion = player:GetAttribute("Set_reduceMotion") == true,
		camera = player:GetAttribute("Set_camera") or "First",
		uiSize = player:GetAttribute("Set_uiSize") or "Large",
		fov = player:GetAttribute("Set_fov") or 80,
	}
	backdrop.Visible = true
	State.setModal("settings", true)
	refresh()
	Theme.focus(modeButtons.Auto)
end

function Settings.close()
	if backdrop then
		backdrop.Visible = false
		State.setModal("settings", false)
	end
end

return Settings
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000062"><Properties><string name="Name">Shop</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The Purser's Office ledger: the in-world shop, in three tabs.
--   SUPPLIES   run aids (tokens) and the one-time Starter Pack. Fixed contents, never random.
--   WARDROBE   outfits for each crew member: equip, buy with Scrip, or buy with Robux.
--   SUPPORTER  the Supporter game pass.
-- Prices come live from Roblox; every run aid says how to earn it for free.
local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Characters = require(Shared.Config.Characters)
local Commerce = require(Shared.Config.Commerce)
local Cosmetics = require(Shared.Config.Cosmetics)
local Game = require(Shared.Config.Game)
local Net = require(Shared.Net)
local Theme = require(script.Parent.Theme)
local State = require(script.Parent.Parent.State)

local Shop = {}
local C = Theme.Colors
local player = Players.LocalPlayer
local backdrop, body, tokenText, scripText
local tabButtons = {}
local currentTab = "Supplies"
local wardrobeChar = nil
local lastSig = ""
local livePrices = {}

local function decode(attr)
	local ok, t = pcall(function()
		return HttpService:JSONDecode(player:GetAttribute(attr) or "{}")
	end)
	return ok and t or {}
end

local function request(kind, a)
	Net.event("Request"):FireServer(kind, a)
end

function Shop.prompt(productKey)
	local product = Commerce.Products[productKey]
	if not product or product.productId == 0 then
		return false
	end
	if product.randomItem and player:GetAttribute("PaidSpinRestricted") ~= false then
		return false -- paid random items aren't offered where they're restricted (or unknown)
	end
	MarketplaceService:PromptProductPurchase(player, product.productId)
	return true
end

local function promptPass(key)
	local pass = Commerce.Passes[key]
	if pass and pass.passId ~= 0 then
		MarketplaceService:PromptGamePassPurchase(player, pass.passId)
	end
end

local function priceLabel(productKey)
	local product = Commerce.Products[productKey]
	if not product or product.productId == 0 then
		return "NOT SET UP"
	end
	if livePrices[productKey] == nil then
		livePrices[productKey] = product.price
		task.spawn(function()
			local ok, info = pcall(function()
				return MarketplaceService:GetProductInfo(product.productId, Enum.InfoType.Product)
			end)
			if ok and info and info.PriceInRobux then
				livePrices[productKey] = info.PriceInRobux
				lastSig = "" -- redraw with the live price
			end
		end)
	end
	return "R$ " .. tostring(livePrices[productKey])
end

local function row(order, title, desc, height)
	local r = Theme.panel({ LayoutOrder = order, Size = UDim2.new(1, -8, 0, height or 74), BackgroundColor3 = C.panelHi, Parent = body })
	Theme.padding(10).Parent = r
	Theme.heading({ Text = string.upper(title), TextSize = 17, Size = UDim2.new(1, -300, 0, 20), Parent = r })
	Theme.label({ Text = desc, Position = UDim2.new(0, 0, 0, 22), Size = UDim2.new(1, -300, 1, -22), TextSize = 12, TextWrapped = true, Parent = r })
	local buttons = Theme.make("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 290, 0, 38), BackgroundTransparency = 1, Parent = r })
	local l = Theme.list(Enum.FillDirection.Horizontal, 6)
	l.HorizontalAlignment = Enum.HorizontalAlignment.Right
	l.Parent = buttons
	return r, buttons
end

local function button(parent, text, enabled, onClick, accent)
	local b = Theme.button({ Text = text, Size = UDim2.new(0, 136, 1, 0), AutoButtonColor = enabled, Parent = parent })
	if not enabled then
		b.TextTransparency = 0.5
		b.BackgroundTransparency = 0.5
	elseif accent then
		b.BackgroundColor3 = C.lantern
		b.TextColor3 = C.panel
	end
	if enabled and onClick then
		b.Activated:Connect(onClick)
	end
	return b
end

-- Tabs ---------------------------------------------------------------------------------------

local function drawSupplies()
	local oneTime = decode("OneTime")
	local order = 0
	for _, key in Commerce.Order do
		local product = Commerce.Products[key]
		if not (product.grant.oneTime and oneTime[key]) then
			order += 1
			local _, buttons = row(order, product.name, product.desc)
			button(buttons, priceLabel(key), product.productId ~= 0, function()
				Shop.prompt(key)
			end, key == "StarterPack")
		end
	end
	tokenText = Theme.label({ LayoutOrder = 50, Text = "", TextSize = 13, Size = UDim2.new(1, -8, 0, 74), TextWrapped = true, Parent = body })
end

local function unlockText(outfit)
	if outfit.unlock == "default" then
		return "Included"
	elseif outfit.unlock == "scrip" then
		return ("Earn it: %d Scrip"):format(outfit.scrip)
	elseif outfit.unlock == "product" then
		return ("Robux, or earn it with %d Scrip"):format(outfit.scrip or 0)
	elseif outfit.unlock == "pack" then
		return "Comes with the Deckhand Starter Pack"
	elseif outfit.unlock == "supporter" then
		return "Meridian Supporter pass"
	end
	return ""
end

local function drawWardrobe()
	local owned = decode("Outfits")
	local equipped = decode("EquippedOutfits")
	local supporter = player:GetAttribute("Supporter") == true
	wardrobeChar = wardrobeChar or player:GetAttribute("CharId") or Characters.Order[1]

	local picker = Theme.make("Frame", { LayoutOrder = 1, Size = UDim2.new(1, -8, 0, 34), BackgroundTransparency = 1, Parent = body })
	Theme.list(Enum.FillDirection.Horizontal, 6).Parent = picker
	for i, charId in Characters.Order do
		local b = Theme.button({ LayoutOrder = i, Text = string.upper(Characters.List[charId].name:match("^(%S+)")), Size = UDim2.new(0, 120, 1, 0), Parent = picker })
		if charId == wardrobeChar then
			b.BackgroundColor3 = C.lantern
			b.TextColor3 = C.panel
		end
		b.Activated:Connect(function()
			wardrobeChar = charId
			lastSig = ""
		end)
	end

	for i, id in Cosmetics.Order[wardrobeChar] or {} do
		local outfit = Cosmetics.Outfits[id]
		local has = outfit.unlock == "default" or owned[id] == true or (outfit.unlock == "supporter" and supporter)
		local isOn = (equipped[wardrobeChar] or Cosmetics.defaultFor(wardrobeChar)) == id
		local r, buttons = row(1 + i, outfit.name, unlockText(outfit), 64)
		-- colour swatches
		local sw = Theme.make("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -300, 0, 2), Size = UDim2.new(0, 100, 0, 16), BackgroundTransparency = 1, Parent = r })
		Theme.list(Enum.FillDirection.Horizontal, 3).Parent = sw
		for j, slot in { "top", "pants", "hat", "pack", "scarf" } do
			local color = outfit.colors[slot]
			if color then
				Theme.make("Frame", { LayoutOrder = j, Size = UDim2.new(0, 16, 0, 16), BackgroundColor3 = color, BorderSizePixel = 0, Parent = sw })
			end
		end
		if has then
			button(buttons, isOn and "WEARING" or "WEAR", not isOn, function()
				request("EquipOutfit", id)
			end)
		else
			if outfit.unlock == "product" and outfit.product then
				button(buttons, priceLabel(outfit.product), Commerce.Products[outfit.product].productId ~= 0, function()
					Shop.prompt(outfit.product)
				end, true)
			end
			if outfit.scrip and outfit.scrip > 0 then
				local afford = (player:GetAttribute("Scrip") or 0) >= outfit.scrip
				button(buttons, ("%d SCRIP"):format(outfit.scrip), afford, function()
					request("BuyOutfit", id)
				end)
			elseif outfit.unlock == "pack" then
				button(buttons, "STARTER PACK", not decode("OneTime").StarterPack, function()
					currentTab = "Supplies"
					lastSig = ""
				end)
			elseif outfit.unlock == "supporter" then
				button(buttons, "SUPPORTER", true, function()
					currentTab = "Supporter"
					lastSig = ""
				end)
			end
		end
	end
	Theme.label({ LayoutOrder = 50, Text = "Outfits are cosmetic only. Your look changes straight away aboard the Meridian.", TextColor3 = C.dim, TextSize = 12, Size = UDim2.new(1, -8, 0, 30), TextWrapped = true, Parent = body })
end

local function drawSupporter()
	local pass = Commerce.Passes.Supporter
	local has = player:GetAttribute("Supporter") == true
	Theme.heading({ LayoutOrder = 1, Text = string.upper(pass.name), TextSize = 22, Size = UDim2.new(1, -8, 0, 28), Parent = body })
	Theme.label({ LayoutOrder = 2, Text = pass.desc, TextSize = 14, Size = UDim2.new(1, -8, 0, 70), TextWrapped = true, Parent = body })
	local holder = Theme.make("Frame", { LayoutOrder = 3, Size = UDim2.new(1, -8, 0, 40), BackgroundTransparency = 1, Parent = body })
	if has then
		Theme.label({ Text = "You're a Supporter. Thank you.", TextColor3 = C.ok, TextSize = 16, Size = UDim2.fromScale(1, 1), Parent = holder })
	else
		local b = button(holder, pass.passId ~= 0 and ("R$ " .. pass.price) or "NOT SET UP", pass.passId ~= 0, function()
			promptPass("Supporter")
		end, true)
		b.Size = UDim2.new(0, 200, 1, 0)
	end
end

local DRAW = { Supplies = drawSupplies, Wardrobe = drawWardrobe, Supporter = drawSupporter }

local function redraw()
	Theme.clear(body)
	tokenText = nil
	for name, b in tabButtons do
		b.BackgroundColor3 = name == currentTab and C.lantern or C.panelHi
		b.TextColor3 = name == currentTab and C.panel or C.text
	end
	DRAW[currentTab]()
end

function Shop.build(gui)
	local panel
	backdrop, panel = Theme.modal(gui, "Shop", UDim2.new(0.92, 0, 0.88, 0), Vector2.new(820, 640))
	Theme.list(Enum.FillDirection.Vertical, 8).Parent = panel
	Theme.heading({ LayoutOrder = 1, Text = "THE PURSER'S LEDGER", TextSize = 28, Size = UDim2.new(1, 0, 0, 32), Parent = panel })
	Theme.label({ LayoutOrder = 2, Text = "\"Fair trade only. Nothing comes in a sealed box.\"  (Agnes Pell, Purser of the Meridian)", TextColor3 = C.dim, TextSize = 13, Size = UDim2.new(1, 0, 0, 20), Parent = panel })

	local tabs = Theme.make("Frame", { LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, Parent = panel })
	Theme.list(Enum.FillDirection.Horizontal, 6).Parent = tabs
	for i, name in { "Supplies", "Wardrobe", "Supporter" } do
		local b = Theme.button({ LayoutOrder = i, Text = string.upper(name), Size = UDim2.new(0, 150, 1, 0), Parent = tabs })
		b.Activated:Connect(function()
			currentTab = name
			lastSig = ""
		end)
		tabButtons[name] = b
	end
	scripText = Theme.label({ LayoutOrder = 4, Text = "", TextSize = 13, TextColor3 = C.salt, Size = UDim2.new(1, 0, 0, 18), Parent = panel })

	body = Theme.make("ScrollingFrame", {
		LayoutOrder = 5,
		Size = UDim2.new(1, 0, 1, -170),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = panel,
	})
	Theme.list(Enum.FillDirection.Vertical, 6).Parent = body

	local close = Theme.button({ LayoutOrder = 6, Text = "CLOSE", Size = UDim2.new(0, 140, 0, 36), Parent = panel })
	close.Activated:Connect(Shop.close)
end

function Shop.refresh()
	if not backdrop or not backdrop.Visible then
		return
	end
	-- redraw only when something the shop shows has changed
	local sig = table.concat({
		currentTab, tostring(wardrobeChar), tostring(player:GetAttribute("Outfits")), tostring(player:GetAttribute("EquippedOutfits")),
		tostring(player:GetAttribute("OneTime")), tostring(player:GetAttribute("Supporter")), tostring(player:GetAttribute("Scrip")),
	}, "|")
	if sig ~= lastSig then
		lastSig = sig
		redraw()
	end
	scripText.Text = ("SCRIP %d%s"):format(player:GetAttribute("Scrip") or 0, player:GetAttribute("Supporter") and "   ·   SUPPORTER +10%" or "")
	if tokenText then
		local winR, winA = Game.WinReward.resupply or 0, Game.WinReward.ammo or 0
		local dailySW = Game.DailyWinReward.secondWind or 0
		tokenText.Text = ("You hold: %d Second Wind · %d Resupply · %d Ammo Cache   (use: R when downed · B · V)\nFree: +%d Resupply and +%d Ammo Cache for every successful crossing, +%d Second Wind for your first successful crossing each day.%s"):format(
			player:GetAttribute("Tokens_secondWind") or 0,
			player:GetAttribute("Tokens_resupply") or 0,
			player:GetAttribute("Tokens_ammo") or 0,
			winR,
			winA,
			dailySW,
			Game.RunAidsEnabled and "" or "\n(Run aids are switched off on this server.)"
		)
	end
end

function Shop.open(tab)
	if backdrop then
		currentTab = tab or currentTab
		wardrobeChar = player:GetAttribute("CharId") or wardrobeChar
		lastSig = ""
		backdrop.Visible = true
		State.setModal("shop", true)
		Shop.refresh()
	end
end

function Shop.close()
	if backdrop then
		backdrop.Visible = false
		State.setModal("shop", false)
	end
end

return Shop
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000063"><Properties><string name="Name">Spin</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The Lucky Spin screen: a prize reel that rolls to the prize the server picked.
-- One free spin a day (00:00 UTC reset); extra spins are Spin tokens (won, or R$10 each).
-- Every prize's odds are listed on this screen before you spin or buy (paid random items
-- policy); spins aren't sold where paid random items are restricted.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local SpinConfig = require(Shared.Config.Spin)
local Commerce = require(Shared.Config.Commerce)
local Sfx = require(Shared.Util.Sfx)
local Theme = require(script.Parent.Theme)
local State = require(script.Parent.Parent.State)

local Spin = {}
local C = Theme.Colors
local player = Players.LocalPlayer
local backdrop, reel, strip, spinButton, buyOne, buyFive, status, wonLabel
local request, promptProduct
local spinning, rolling = false, false

local TILE, GAP = 118, 8
local TOTAL = 0
for _, p in SpinConfig.Prizes do
	TOTAL += p.weight
end

local function rgb(t)
	return Color3.fromRGB(t[1], t[2], t[3])
end

local function weightedIndex(rng)
	local roll = rng:NextInteger(1, TOTAL)
	for i, p in SpinConfig.Prizes do
		roll -= p.weight
		if roll <= 0 then
			return i
		end
	end
	return 1
end

local function tile(parent, prize, x)
	local t = Theme.make("Frame", {
		Position = UDim2.new(0, x, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.new(0, TILE, 0, 110),
		BackgroundColor3 = rgb(prize.color):Lerp(Color3.fromRGB(20, 22, 26), 0.55),
		BorderSizePixel = 0,
		Parent = parent,
	})
	Theme.corner(8).Parent = t
	Theme.stroke(rgb(prize.color), 2, 0.1).Parent = t
	Theme.make("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0.35) }),
		Parent = t,
	})
	Theme.label({ Text = prize.short, Font = Theme.Head, TextSize = 30, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = rgb(prize.color), Position = UDim2.new(0, 0, 0, 14), Size = UDim2.new(1, 0, 0, 40), Parent = t })
	Theme.label({ Text = prize.name, TextWrapped = true, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.new(0, 6, 0, 58), Size = UDim2.new(1, -12, 0, 44), Parent = t })
	return t
end

local function fillStrip(winIndex, winSlot)
	Theme.clear(strip)
	local rng = Random.new()
	for slot = 1, winSlot + 4 do
		local index = slot == winSlot and winIndex or weightedIndex(rng)
		tile(strip, SpinConfig.Prizes[index], (slot - 1) * (TILE + GAP))
	end
end

local function fmtTime(seconds)
	seconds = math.max(0, math.floor(seconds))
	return ("%02d:%02d:%02d"):format(seconds // 3600, (seconds % 3600) // 60, seconds % 60)
end

local function restricted()
	return player:GetAttribute("PaidSpinRestricted") ~= false
end

function Spin.refresh()
	if not (backdrop and backdrop.Visible) then
		return
	end
	local free = player:GetAttribute("FreeSpinReady") == true
	local tokens = player:GetAttribute("Tokens_spin") or 0
	local wait = (player:GetAttribute("NextFreeSpinAt") or 0) - Workspace:GetServerTimeNow()
	if spinning then
		spinButton.Text = "SPINNING…"
	elseif free then
		spinButton.Text = "SPIN  ·  FREE TODAY"
	elseif tokens > 0 then
		spinButton.Text = ("SPIN  ·  %d SPIN%s LEFT"):format(tokens, tokens == 1 and "" or "S")
	elseif restricted() then
		spinButton.Text = "NEXT FREE SPIN " .. fmtTime(wait)
	else
		spinButton.Text = ("SPIN  ·  R$%d"):format(Commerce.Products.LuckySpin.price)
	end
	spinButton.AutoButtonColor = not spinning
	status.Text = free and "Your free spin for today is ready." or ("Next free spin in %s (resets 00:00 UTC)."):format(fmtTime(wait))
	buyOne.Visible = not restricted()
	buyFive.Visible = not restricted()
	local three = buyFive.Parent:FindFirstChild("BuyThree")
	if three then
		three.Visible = not restricted()
	end
end

local function doSpin()
	if spinning then
		return
	end
	local free = player:GetAttribute("FreeSpinReady") == true
	local tokens = player:GetAttribute("Tokens_spin") or 0
	if not free and tokens <= 0 then
		if not restricted() then
			promptProduct("LuckySpin")
		end
		return
	end
	spinning = true
	wonLabel.Text = ""
	Sfx.ui("Ui_Confirm", 0.5)
	request("Spin")
	task.delay(6, function()
		if spinning and not rolling then
			spinning = false -- no answer from the server
		end
	end)
end

-- The server's pick arrives: roll the reel onto it.
function Spin.result(data)
	if not backdrop then
		return
	end
	local index = tonumber(data and data.index) or 1
	local prize = SpinConfig.Prizes[index] or SpinConfig.Prizes[1]
	if not backdrop.Visible then
		Spin.open()
	end
	spinning, rolling = true, true
	local winSlot = 34
	fillStrip(index, winSlot)
	strip.Position = UDim2.new(0, 0, 0, 0)
	local center = reel.AbsoluteSize.X / 2 / Theme.scale
	local jitter = Random.new():NextNumber(-TILE * 0.32, TILE * 0.32)
	local target = -((winSlot - 1) * (TILE + GAP) + TILE / 2 - center + jitter)
	local duration = 4.2
	local tween = TweenService:Create(strip, TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Position = UDim2.new(0, target, 0, 0) })
	tween:Play()
	-- a tick each time a tile passes the marker
	task.spawn(function()
		local last = 0
		while tween.PlaybackState == Enum.PlaybackState.Playing do
			local passed = math.floor((-strip.Position.X.Offset + center) / (TILE + GAP))
			if passed ~= last then
				last = passed
				Sfx.ui("Ui_Tick", 0.35)
			end
			task.wait()
		end
	end)
	tween.Completed:Wait()
	Sfx.ui("Ui_Confirm", 0.9)
	wonLabel.TextColor3 = rgb(prize.color)
	wonLabel.Text = "YOU WON:  " .. string.upper(prize.name) .. (data and data.detail and ("\n" .. data.detail) or "")
	spinning, rolling = false, false
end

function Spin.build(gui, requestFn, promptFn)
	request, promptProduct = requestFn, promptFn
	local panel
	backdrop, panel = Theme.modal(gui, "Spin", UDim2.new(0.94, 0, 0.88, 0), Vector2.new(820, 600))
	Theme.heading({ Text = "LUCKY SPIN", TextSize = 28, Size = UDim2.new(1, -120, 0, 34), Parent = panel })
	Theme.label({ Position = UDim2.new(0, 0, 0, 34), Text = "One free spin every day. Prizes go straight to you (kits are packed for your next crossing).", TextSize = 12, TextColor3 = C.dim, Size = UDim2.new(1, -120, 0, 18), Parent = panel })
	local close = Theme.button({ Text = "CLOSE", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 100, 0, 32), Parent = panel })
	close.Activated:Connect(Spin.close)

	reel = Theme.make("Frame", { Position = UDim2.new(0, 0, 0, 62), Size = UDim2.new(1, 0, 0, 132), BackgroundColor3 = Color3.fromRGB(10, 12, 14), BorderSizePixel = 0, ClipsDescendants = true, Parent = panel })
	Theme.corner(8).Parent = reel
	strip = Theme.make("Frame", { Size = UDim2.new(0, 10, 1, 0), BackgroundTransparency = 1, Parent = reel })
	-- the marker
	Theme.make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 0), Size = UDim2.new(0, 4, 1, 0), BackgroundColor3 = C.lantern, BorderSizePixel = 0, ZIndex = 30, Parent = reel })
	for _, side in { 0, 1 } do
		Theme.make("Frame", {
			AnchorPoint = Vector2.new(side, 0),
			Position = UDim2.new(side, 0, 0, 0),
			Size = UDim2.new(0.18, 0, 1, 0),
			BackgroundColor3 = Color3.fromRGB(10, 12, 14),
			BorderSizePixel = 0,
			ZIndex = 25,
			Parent = reel,
		}):SetAttribute("Fade", side)
	end
	for _, f in reel:GetChildren() do
		if f:GetAttribute("Fade") ~= nil then
			Theme.make("UIGradient", {
				Transparency = f:GetAttribute("Fade") == 0 and NumberSequence.new(0, 1) or NumberSequence.new(1, 0),
				Parent = f,
			})
		end
	end
	fillStrip(#SpinConfig.Prizes, 4)

	wonLabel = Theme.heading({ Text = "", TextSize = 20, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.new(0, 0, 0, 196), Size = UDim2.new(1, 0, 0, 42), Parent = panel })

	-- left: buttons
	local left = Theme.make("Frame", { Position = UDim2.new(0, 0, 0, 240), Size = UDim2.new(0.48, 0, 1, -240), BackgroundTransparency = 1, Parent = panel })
	spinButton = Theme.button({ Text = "SPIN", TextSize = 22, Size = UDim2.new(1, 0, 0, 56), BackgroundColor3 = Color3.fromRGB(150, 96, 40), Parent = left })
	spinButton.Activated:Connect(doSpin)
	status = Theme.label({ Text = "", TextSize = 12, TextColor3 = C.dim, TextWrapped = true, Position = UDim2.new(0, 0, 0, 62), Size = UDim2.new(1, 0, 0, 32), Parent = left })
	buyOne = Theme.button({ Text = ("BUY 1 SPIN  ·  R$%d"):format(Commerce.Products.LuckySpin.price), Position = UDim2.new(0, 0, 0, 100), Size = UDim2.new(1, 0, 0, 36), Parent = left })
	buyOne.Activated:Connect(function()
		promptProduct("LuckySpin")
	end)
	local buyThree = Theme.button({ Name = "BuyThree", Text = ("BUY 3 SPINS  ·  R$%d"):format(Commerce.Products.LuckySpin3.price), Position = UDim2.new(0, 0, 0, 142), Size = UDim2.new(1, 0, 0, 36), Parent = left })
	buyThree.Activated:Connect(function()
		promptProduct("LuckySpin3")
	end)
	buyFive = Theme.button({ Text = ("BUY 5 SPINS  ·  R$%d"):format(Commerce.Products.LuckySpin5.price), Position = UDim2.new(0, 0, 0, 184), Size = UDim2.new(1, 0, 0, 36), Parent = left })
	buyFive.Activated:Connect(function()
		promptProduct("LuckySpin5")
	end)

	-- right: the odds, always visible
	local right = Theme.panel({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 240), Size = UDim2.new(0.5, 0, 1, -240), BackgroundColor3 = C.panelHi, Parent = panel })
	Theme.padding(10).Parent = right
	Theme.heading({ Text = "ODDS PER SPIN", TextSize = 15, TextColor3 = C.salt, Size = UDim2.new(1, 0, 0, 20), Parent = right })
	local list = Theme.make("ScrollingFrame", { Position = UDim2.new(0, 0, 0, 24), Size = UDim2.new(1, 0, 1, -24), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Parent = right })
	Theme.list(Enum.FillDirection.Vertical, 2).Parent = list
	for i, p in SpinConfig.Prizes do
		local row = Theme.make("Frame", { LayoutOrder = i, Size = UDim2.new(1, -6, 0, 18), BackgroundTransparency = 1, Parent = list })
		Theme.make("Frame", { Size = UDim2.new(0, 10, 0, 10), Position = UDim2.new(0, 0, 0.5, -5), BackgroundColor3 = rgb(p.color), BorderSizePixel = 0, Parent = row })
		Theme.label({ Text = p.name, TextSize = 12, Position = UDim2.new(0, 16, 0, 0), Size = UDim2.new(1, -76, 1, 0), Parent = row })
		Theme.label({ Text = ("%.1f%%"):format(p.weight / TOTAL * 100), TextSize = 12, Font = Theme.Head, TextXAlignment = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 60, 1, 0), Parent = row })
	end
end

function Spin.open()
	if backdrop then
		backdrop.Visible = true
		State.setModal("spin", true)
		Spin.refresh()
		Theme.focus(spinButton)
	end
end

function Spin.close()
	if backdrop and not spinning then
		backdrop.Visible = false
		State.setModal("spin", false)
	end
end

function Spin.toggle()
	if backdrop and backdrop.Visible then
		Spin.close()
	else
		Spin.open()
	end
end

return Spin
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000064"><Properties><string name="Name">Theme</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Visual language for all UI: slate panels, bone text, lantern-warm accents. No default
-- Roblox look: custom panels, Oswald (stencil-like headings) + Merriweather (logbook body).
local Theme = {}

Theme.Colors = {
	backdrop = Color3.fromRGB(6, 8, 10),
	panel = Color3.fromRGB(18, 22, 25),
	panelHi = Color3.fromRGB(30, 35, 38),
	line = Color3.fromRGB(70, 76, 78),
	text = Color3.fromRGB(226, 220, 206),
	dim = Color3.fromRGB(150, 148, 138),
	lantern = Color3.fromRGB(232, 168, 92),
	danger = Color3.fromRGB(200, 74, 60),
	salt = Color3.fromRGB(170, 205, 205),
	ok = Color3.fromRGB(140, 180, 130),
}

Theme.minText = 14
Theme.scale = 1 -- the UI scaler's current scale (UIController); pixel maths in the HUD divides by it
Theme.Head = Enum.Font.Oswald
Theme.Body = Enum.Font.Merriweather

local function apply(inst, defaults, props)
	for key, value in defaults do
		if props == nil or props[key] == nil then
			inst[key] = value
		end
	end
	local parent
	for key, value in props or {} do
		if key == "Parent" then
			parent = value
		elseif key ~= "Children" then
			inst[key] = value
		end
	end
	for _, child in (props and props.Children) or {} do
		child.Parent = inst
	end
	-- nothing on screen is allowed to be tiny: small text is lifted to a readable minimum
	if (inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox")) and not inst.TextScaled and inst.TextSize < Theme.minText then
		inst.TextSize = Theme.minText
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function Theme.make(className, props)
	return apply(Instance.new(className), {}, props)
end

function Theme.corner(radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 4)
	return c
end

function Theme.stroke(color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color or Theme.Colors.line
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0.2
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	return s
end

function Theme.padding(px)
	local p = Instance.new("UIPadding")
	p.PaddingLeft = UDim.new(0, px)
	p.PaddingRight = UDim.new(0, px)
	p.PaddingTop = UDim.new(0, px)
	p.PaddingBottom = UDim.new(0, px)
	return p
end

function Theme.list(direction, gap, align)
	local l = Instance.new("UIListLayout")
	l.FillDirection = direction or Enum.FillDirection.Vertical
	l.Padding = UDim.new(0, gap or 6)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	if align then
		l.HorizontalAlignment = align
	end
	return l
end

function Theme.label(props)
	return apply(Instance.new("TextLabel"), {
		BackgroundTransparency = 1,
		TextColor3 = Theme.Colors.text,
		Font = Theme.Body,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		Size = UDim2.new(1, 0, 0, 20),
	}, props)
end

function Theme.heading(props)
	return apply(Instance.new("TextLabel"), {
		BackgroundTransparency = 1,
		TextColor3 = Theme.Colors.text,
		Font = Theme.Head,
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, 28),
	}, props)
end

function Theme.panel(props)
	local frame = apply(Instance.new("Frame"), {
		BackgroundColor3 = Theme.Colors.panel,
		BackgroundTransparency = 0.08,
		BorderSizePixel = 0,
	}, props)
	Theme.corner(6).Parent = frame
	Theme.stroke().Parent = frame
	return frame
end

function Theme.button(props)
	local button = apply(Instance.new("TextButton"), {
		BackgroundColor3 = Theme.Colors.panelHi,
		BorderSizePixel = 0,
		AutoButtonColor = true,
		TextColor3 = Theme.Colors.text,
		Font = Theme.Head,
		TextSize = 17,
		Size = UDim2.new(0, 160, 0, 36),
	}, props)
	Theme.corner(4).Parent = button
	Theme.stroke(Theme.Colors.lantern, 1, 0.5).Parent = button
	return button
end

-- Gamepad/console: put the selection cursor on a button when a menu opens.
function Theme.focus(button)
	local UserInputService = game:GetService("UserInputService")
	if button and UserInputService.GamepadEnabled then
		game:GetService("GuiService").SelectedObject = button
	end
end

function Theme.clear(frame)
	for _, child in frame:GetChildren() do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") and not child:IsA("UIGridLayout") then
			child:Destroy()
		end
	end
end

-- A full-screen dark backdrop + centred panel for modal screens.
function Theme.modal(parent, name, size, maxSize)
	local backdrop = Theme.make("Frame", {
		Name = name,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Colors.backdrop,
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 20,
		Parent = parent,
	})
	local panel = Theme.panel({
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = size,
		ZIndex = 21,
		Parent = backdrop,
	})
	local constraint = Instance.new("UISizeConstraint")
	constraint.MaxSize = maxSize or Vector2.new(1100, 680)
	constraint.Parent = panel
	Theme.padding(18).Parent = panel
	return backdrop, panel
end

return Theme
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000065"><Properties><string name="Name">Workbench</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The workbench: spend Salvage (found during the crossing) on weapon parts, satchel upgrades
-- and your character's other perks. Upgrades last for this crossing.
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Characters = require(Shared.Config.Characters)
local Upgrades = require(Shared.Config.Upgrades)
local Weapons = require(Shared.Config.Weapons)
local Theme = require(script.Parent.Theme)
local State = require(script.Parent.Parent.State)

local Workbench = {}
local C = Theme.Colors
local player = Players.LocalPlayer
local backdrop, list, salvageLabel
local request

local function decode(attr)
	local ok, value = pcall(function()
		return HttpService:JSONDecode(player:GetAttribute(attr) or "{}")
	end)
	return ok and value or {}
end

local function price(base)
	local repairs = decode("Repairs")
	return math.ceil(base * (repairs.workshop and 0.85 or 1))
end

local function section(order, text)
	Theme.heading({ LayoutOrder = order, Text = text, TextSize = 17, TextColor3 = C.salt, Size = UDim2.new(1, 0, 0, 24), Parent = list })
end

local function row(order, title, desc, owned, cost, onBuy)
	local r = Theme.panel({ LayoutOrder = order, Size = UDim2.new(1, 0, 0, 54), BackgroundColor3 = C.panelHi, Parent = list })
	Theme.padding(8).Parent = r
	Theme.heading({ Text = title, TextSize = 15, Size = UDim2.new(1, -130, 0, 18), Parent = r })
	Theme.label({ Text = desc, Position = UDim2.new(0, 0, 0, 20), Size = UDim2.new(1, -130, 0, 18), TextSize = 12, TextColor3 = C.dim, Parent = r })
	local b = Theme.button({
		Text = owned and "FITTED" or ("%d SALVAGE"):format(cost),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.new(0, 120, 0, 34),
		TextSize = 14,
		AutoButtonColor = not owned,
		Parent = r,
	})
	if owned then
		b.TextColor3 = C.ok
	else
		b.Activated:Connect(onBuy)
	end
	return b
end

local function rebuild()
	Theme.clear(list)
	salvageLabel.Text = ("SALVAGE %d"):format(player:GetAttribute("Salvage") or 0)
	local run = decode("RunUpgrades")
	local owned = run.weapons or {}
	local order, first = 0, nil
	local function nextOrder()
		order += 1
		return order
	end
	if not player:GetAttribute("InCrossing") then
		Theme.label({ LayoutOrder = 1, Text = "The workbench is used between encounters during a crossing. Start one at the tide chart.", TextSize = 14, Size = UDim2.new(1, 0, 0, 40), Parent = list })
		return
	end
	for _, slot in { "long", "sidearm" } do
		local id = player:GetAttribute("W_" .. slot)
		if id and id ~= "" and Upgrades.Weapon[id] then
			section(nextOrder(), string.upper(Weapons.List[id].name))
			for _, upg in Upgrades.Weapon[id] do
				local has = owned[id] and owned[id][upg.id]
				local b = row(nextOrder(), upg.name, upg.desc, has, price(upg.cost), function()
					request("BuyWeaponUpgrade", id, upg.id)
				end)
				first = first or b
			end
		end
	end
	section(nextOrder(), "SATCHEL & GEAR")
	for _, upg in Upgrades.General do
		row(nextOrder(), upg.name, upg.desc, run.general and run.general[upg.id], price(upg.cost), function()
			request("BuyGeneral", upg.id)
		end)
	end
	local charId = player:GetAttribute("CharId")
	local def = charId and Characters.List[charId]
	if def then
		section(nextOrder(), "TRAINING: " .. string.upper(def.name))
		for _, perk in def.perks do
			local has = perk.id == player:GetAttribute("PerkId") or (run.perks and run.perks[perk.id])
			row(nextOrder(), perk.name, perk.desc, has, price(Upgrades.PerkCost), function()
				request("BuyPerk", perk.id)
			end)
		end
	end
	Theme.focus(first)
end

function Workbench.build(gui, requestFn)
	request = requestFn
	local panel
	backdrop, panel = Theme.modal(gui, "Workbench", UDim2.new(0.94, 0, 0.9, 0), Vector2.new(680, 640))
	Theme.heading({ Text = "WORKBENCH", TextSize = 28, Size = UDim2.new(1, -120, 0, 32), Parent = panel })
	salvageLabel = Theme.heading({ Position = UDim2.new(0, 0, 0, 34), Size = UDim2.new(1, 0, 0, 22), TextSize = 17, TextColor3 = C.lantern, Parent = panel })
	local close = Theme.button({ Text = "CLOSE", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 100, 0, 32), Parent = panel })
	close.Activated:Connect(Workbench.close)
	list = Theme.make("ScrollingFrame", {
		Position = UDim2.new(0, 0, 0, 64),
		Size = UDim2.new(1, 0, 1, -64),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		Parent = panel,
	})
	Theme.list(Enum.FillDirection.Vertical, 6).Parent = list
	for _, attr in { "Salvage", "RunUpgrades", "W_long", "W_sidearm" } do
		player:GetAttributeChangedSignal(attr):Connect(function()
			if backdrop.Visible then
				rebuild()
			end
		end)
	end
end

function Workbench.open()
	if backdrop then
		backdrop.Visible = true
		State.setModal("workbench", true)
		rebuild()
	end
end

function Workbench.close()
	if backdrop then
		backdrop.Visible = false
		State.setModal("workbench", false)
	end
end

return Workbench
]]></ProtectedString></Properties></Item>
</Item>
</Item>
</Item>
</Item>
