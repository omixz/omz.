<Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">Modifiers</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Environmental modifiers. One is rolled per encounter (or none) for replayability.
-- Fields: sightMult, noiseMult (all noise), footstepMult, partsMult, fogDensity, ambientBoost, lightning, night
return {
	None = { id = "None", name = "Still Water", desc = "An ordinary grey evening on the Marrow Coast.", fogDensity = 0.34 },
	List = {
		{ id = "HeavyPall", name = "Heavy Pall", desc = "Thick fog. Everyone sees less.", sightMult = 0.65, fogDensity = 0.55 },
		{ id = "Squall", name = "Squall", desc = "Wind masks your footsteps.", footstepMult = 0.6, sightMult = 0.9, fogDensity = 0.42, lightning = true },
		{ id = "Nightfall", name = "Nightfall", desc = "Full dark. Your torch is the only light, and they see it.", sightMult = 0.8, fogDensity = 0.36, night = true },
		{ id = "Echoing", name = "Echoing", desc = "Every sound carries further.", noiseMult = 1.5, fogDensity = 0.34 },
		{ id = "Moonbreak", name = "Moonbreak", desc = "The fog thins. You see them. They see you.", sightMult = 1.3, fogDensity = 0.18, ambientBoost = 0.35 },
		{ id = "ScavengedOut", name = "Scavenged Out", desc = "Someone got here first. Half the parts.", partsMult = 0.5, fogDensity = 0.34 },
	},
	NoneChance = 0.2,
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">Movement</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Speeds are studs/second. Noise values are the radius (studs) in which Hushed can hear you.
return {
	Speeds = {
		Crouch = 6.5,
		Prone = 3.2,
		Walk = 9,
		Jog = 14,
		Sprint = 20,
		Aim = 7,
		Downed = 2.5,
	},
	Noise = {
		Crouch = 3,
		Prone = 1.5,
		Walk = 9,
		Jog = 16,
		Sprint = 30,
	},
	Accel = 38, -- how fast WalkSpeed ramps up (studs/s^2): gives weight to starts
	Decel = 70,
	WaterNoiseMult = 1.6, -- wading is louder...
	WaterSpeedMult = 0.75, -- ...and slower
	CrouchHipMult = 0.66, -- procedural crouch pose lowers hips to this fraction
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">Projects</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Meridian projects: permanent upgrades to the homebase, paid with Materials (earned at the end
-- of every mission; Scrip is for the Quartermaster store). Each one physically adds a room or fitting to the ferry,
-- and many unlock new mission types or maps. A Shipwright's Crew token (earned, or bought with
-- Robux) completes one project instantly without the materials.
--
-- Kept compatible with old saves: owned projects are stored with the old repair ids.
-- Bonuses are applied in HomebaseService.bonusesFor; unlocks in MatchService.
local Projects = {}

Projects.List = {
	{ id = "lights", name = "Deck Lights", desc = "Crew morale: +10% Scrip from every mission.", scrip = 0, materials = 20 },
	{ id = "generator", name = "Generator Room", desc = "Start every crossing with +20 Salvage for the workbench.", scrip = 0, materials = 45 },
	{ id = "workshop", name = "Workshop", desc = "Workbench upgrades 25% cheaper; +1 from every arrow, spike and salt bomb you craft.", scrip = 0, materials = 70, requires = "generator" },
	{ id = "sickbay", name = "Infirmary", desc = "+15 max health and an extra Field Dressing every crossing. Unlocks Medicine Run missions.", scrip = 0, materials = 90, unlocks = { missions = { "Medicine" } } },
	{ id = "radio", name = "Radio Room", desc = "The tide chart offers 3 routes. Unlocks Restore the Signal missions.", scrip = 0, materials = 110, requires = "generator", unlocks = { missions = { "Relay" } } },
	{ id = "armory", name = "Armory", desc = "+1 backpack gun slot and 15% off at the Quartermaster. Unlocks Burn the Nests missions.", scrip = 0, materials = 140, requires = "workshop", unlocks = { missions = { "Nests" } } },
	{ id = "chartroom", name = "Chart Room", desc = "Unlocks Hollow Pines and +15% Materials from every mission.", scrip = 0, materials = 170, requires = "radio", unlocks = { maps = { "HollowPines" } } },
	{ id = "lookout", name = "Lookout Tower", desc = "Every encounter opens with a Tide Sense pulse for the whole crew: you see the Hushed through walls.", scrip = 0, materials = 220, requires = "chartroom" },
}


-- Mission types / maps available without any project.
Projects.BaseMissions = { "Salvage", "LanternWatch", "Drift", "Hunt", "Rescue" }
Projects.BaseMaps = { "CanneryRow", "LarkspurStreet" }

-- How Materials are earned (MatchService).
Projects.Materials = {
	perWin = 8, -- + perPall per Pall level
	perPall = 4,
	runComplete = 30,
	lossShare = 0.5, -- a failed encounter still pays half
	salvageToMaterials = 0.5, -- leftover Salvage at the end of a crossing
}

function Projects.get(id)
	for _, p in Projects.List do
		if p.id == id then
			return p
		end
	end
	return nil
end

return Projects
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">Quartermaster</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The Quartermaster: the Meridian's store, paid with Scrip (earned at the end of every mission).
-- Separate from Meridian projects (Materials). Nothing here is sold for Robux.
--   Guns: permanent unlocks. Everyone starts with the revolver plus a signature long gun (Mara carbine, Tobias bow, Ines shotgun, Sefa rifle).
--   Kits: supplies delivered at the start of your NEXT crossing (up to 2 of each).
-- The Armory project takes 15% off.
return {
	Guns = {
		{ id = "carbine", price = 150, desc = "Lever carbine: steady, mid-range, 6 rounds." },
		{ id = "bow", price = 180, desc = "Recurve bow: silent; arrows can be recovered and crafted." },
		{ id = "shotgun", price = 220, desc = "Pump shotgun: devastating up close, 4 shells, reload shell by shell." },
		{ id = "rifle", price = 300, desc = "Bolt rifle: long range and powerful, 4 rounds; takes a scope at the workbench." },
	},
	Kits = {
		{ id = "rounds", name = "Spare rounds", desc = "+4 revolver rounds", price = 20, items = { pistolAmmo = 4 } },
		{ id = "longrounds", name = "Long-gun ammunition", desc = "+3 rifle rounds, +2 shells, +3 arrows", price = 35, items = { rifleAmmo = 3, shells = 2, arrows = 3 } },
		{ id = "medkit", name = "Field kit", desc = "+1 Field Dressing, +1 Cloth", price = 30, items = { dressing = 1, cloth = 1 } },
		-- Robux only (Ammo Crate products); not listed at the Quartermaster
		{ id = "ammocrate", robux = true, name = "Ammo Crate", desc = "+8 revolver rounds, +4 rifle rounds, +4 shells, +6 arrows", price = 0, items = { pistolAmmo = 8, rifleAmmo = 4, shells = 4, arrows = 6 } },
		{ id = "pocketrounds", robux = true, name = "Pocket Rounds", desc = "+5 revolver rounds", price = 0, items = { pistolAmmo = 5 } },
		{ id = "bandage", robux = true, name = "Bandage Roll", desc = "+1 Field Dressing", price = 0, items = { dressing = 1 } },
		{ id = "throwables", name = "Throwables", desc = "+1 Bottle, +1 Flare Pot", price = 35, items = { bottle = 1, flarePot = 1 } },
	},
	MaxKitsEach = 2,
	BackpackSlots = 1, -- +1 with the Armory project
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">Quests</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Quest board challenges on the Meridian. Three dailies and two weeklies, picked the same for
-- everyone each day / week. Progress counts from encounters; rewards pay out automatically.
-- stat: takedowns | kills | objectives | wins | unseenWins | crossings | breakwater
return {
	Daily = {
		{ id = "d_quiet", name = "Quiet Hands", desc = "Quiet %d Hushed.", stat = "takedowns", target = 5, scrip = 30, materials = 10 },
		{ id = "d_kills", name = "Clear the Way", desc = "Put down %d enemies.", stat = "kills", target = 15, scrip = 30, materials = 10 },
		{ id = "d_objectives", name = "Get It Done", desc = "Complete %d mission objectives (crates, caches, relays, nests).", stat = "objectives", target = 6, scrip = 35, materials = 12 },
		{ id = "d_wins", name = "Back Aboard", desc = "Win %d encounters.", stat = "wins", target = 2, scrip = 40, materials = 15 },
		{ id = "d_unseen", name = "Like Fog", desc = "Win %d encounter without being spotted.", stat = "unseenWins", target = 1, scrip = 50, materials = 20 },
		{ id = "d_crossing", name = "The Long Way", desc = "Finish %d crossing.", stat = "crossings", target = 1, scrip = 60, materials = 25 },
	},
	Weekly = {
		{ id = "w_wins", name = "Tide-Turner", desc = "Win %d encounters this week.", stat = "wins", target = 15, scrip = 200, materials = 80 },
		{ id = "w_quiet", name = "Silent Week", desc = "Quiet %d Hushed this week.", stat = "takedowns", target = 40, scrip = 180, materials = 70 },
		{ id = "w_breakwater", name = "Hold the Breakwater", desc = "Win %d finale (The Breakwater).", stat = "breakwater", target = 1, scrip = 250, materials = 100 },
		{ id = "w_objectives", name = "Salvager", desc = "Complete %d mission objectives this week.", stat = "objectives", target = 40, scrip = 200, materials = 80 },
	},
	DailyCount = 3,
	WeeklyCount = 2,
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">Rewards</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Daily login streak and the Logbook (lore pages found on missions).
local Rewards = {}

-- Come back on consecutive days (UTC); miss a day and it starts again from day 1.
-- grant: scrip / materials / tokens = { kind = n } / kit = { kitId = n }
Rewards.Streak = {
	{ day = 1, text = "40 Scrip", grant = { scrip = 40 } },
	{ day = 2, text = "20 Materials", grant = { materials = 20 } },
	{ day = 3, text = "Pocket Rounds (next crossing)", grant = { kit = { pocketrounds = 1 } } },
	{ day = 4, text = "80 Scrip", grant = { scrip = 80 } },
	{ day = 5, text = "1 Lucky Spin", grant = { tokens = { spin = 1 } } },
	{ day = 6, text = "40 Materials", grant = { materials = 40 } },
	{ day = 7, text = "150 Scrip + Ammo Cache", grant = { scrip = 150, tokens = { ammo = 1 } } },
}

-- Torn logbook pages: one or two lie somewhere on every mission. Every 4 found pays out.
Rewards.PageReward = { every = 4, scrip = 100, materials = 25 }
Rewards.Pages = {
	{ id = "p01", title = "Harbourmaster's log, day 1", text = "Fog bank off the breakwater at dawn. Thick as wool and it doesn't move with the wind. Told the boats to stay in." },
	{ id = "p02", title = "Harbourmaster's log, day 4", text = "Three men walked out of the fog at the fish market. Didn't speak. Didn't blink. Salt crust on their lips. The constable called them hushed, and the name stuck." },
	{ id = "p03", title = "Notice, pinned to a door", text = "THE PALL IS IN THE WATER. BOIL EVERYTHING. DO NOT SLEEP BY AN OPEN WINDOW. - Larkspur Residents' Committee" },
	{ id = "p04", title = "A child's drawing", text = "A ferry with a smiling sun. Under it, in crayon: 'the boat that does not sink'. Someone has written MERIDIAN next to it in pencil." },
	{ id = "p05", title = "Harbour Watch orders", text = "All civilians to the cannery. Anyone carrying salt goes to the front of the line. Anyone who won't speak goes nowhere." },
	{ id = "p06", title = "Tidebound tract", text = "The Pall is not a sickness. It is the sea taking back its breath. Kneel at the tide line and be still, and you will be still forever." },
	{ id = "p07", title = "Tobias, engine room", text = "Generator's held eleven years on scrap and swearing. If anyone else reads this: the third valve sticks. Hit it with the wrench. Gently. Then not gently." },
	{ id = "p08", title = "Ines, sick bay notes", text = "The Hushed don't hear you breathe if you're behind glass. They hear footsteps through the deck. Crawl past the infirmary windows." },
	{ id = "p09", title = "Mara, tide chart margin", text = "Fog thins at the turn of the tide. Twenty minutes, maybe thirty. Enough to cross Cannery Row if nobody runs." },
	{ id = "p10", title = "Sefa, dive log", text = "Went under the Larkspur bridge. Cars on the bottom with their headlights still on. Didn't go back down." },
	{ id = "p11", title = "Ranger station radio transcript", text = "...repeat, the pines are clear above the ridge. The Pall sits in the low ground like water. Stay high, stay dry, stay quiet..." },
	{ id = "p12", title = "Watch captain's letter", text = "Mother, we hold the cannery. We are doing terrible things to keep it. If the ferry comes, let them pass. Tell no one I said so." },
	{ id = "p13", title = "Shopping list", text = "Bread. Batteries. Salt (lots). Tape. Something for the dog. Tell Dad the boat leaves Tuesday." },
	{ id = "p14", title = "Tidebound hymn", text = "Down where the bells ring under the waves, down where the quiet keeps, we will all be hushed in the end, we will all be held in the deep." },
	{ id = "p15", title = "The Breakwater", text = "Beyond the breakwater the fog ends. Everyone says so. Nobody has come back to say it twice." },
	{ id = "p16", title = "Unsigned", text = "If you found this, you are still talking. Keep talking. The Hushed stop talking first." },
}

function Rewards.page(id)
	for _, p in Rewards.Pages do
		if p.id == id then
			return p
		end
	end
	return nil
end

return Rewards
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">Rigs</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Realistic characters. Three ways to give a crew member a realistic body, best first:
--   1. Custom rig: put an R15-compatible Model named e.g. "Mara" in ServerStorage > Rigs
--      (made in Blender from a MakeHuman/your own mesh, then Studio's Avatar Setup tool).
--      It must contain a Humanoid + HumanoidRootPart. Put a copy of the default "Animate"
--      LocalScript inside it, or set the animation IDs below.
--   2. Body parts: Marketplace body-part asset IDs for a HumanoidDescription (Rthro-style
--      realistic bodies, FACS heads). Set them under BodyParts.
--   3. Neither: the faceless placeholder mannequin (Slice 0 default).
-- See docs/07-characters-and-graphics.md for the free pipeline. Never import models of
-- characters from other games (copyright).
return {
	Custom = {
		mara = "Mara",
		tobias = "Tobias",
		ines = "Ines",
		sefa = "Sefa",
	},
	BodyParts = {
		-- example: mara = { Head = 0, Torso = 0, LeftArm = 0, RightArm = 0, LeftLeg = 0, RightLeg = 0 },
	},
	-- Uploaded animation IDs ("rbxassetid://123"). Used for custom rigs without an Animate script.
	Animations = {
		idle = "",
		walk = "",
		run = "",
		crouchIdle = "",
		crouchWalk = "",
	},
}
]]></ProtectedString></Properties></Item>
