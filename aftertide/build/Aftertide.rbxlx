<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
<Item class="Workspace" referent="RBX00000001"><Properties><string name="Name">Workspace</string><bool name="StreamingEnabled">false</bool></Properties></Item>
<Item class="Lighting" referent="RBX00000002"><Properties><string name="Name">Lighting</string><token name="Technology">4</token></Properties></Item>
<Item class="Players" referent="RBX00000003"><Properties><string name="Name">Players</string><bool name="CharacterAutoLoads">false</bool></Properties></Item>
<Item class="ReplicatedStorage" referent="RBX0000001E"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX0000001D"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">BodyBuilder</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Builds a sculpted, clothed body over the (hidden) R15 skeleton so the crew don't look like
-- Roblox avatars: tapered limbs, shaped torso, jacket, trousers, boots, backpack, a hat or
-- hood, and a fog mask over the lower face (everyone wears one against the Pall).
-- Every piece is welded to an R15 part, so animation, weapons and gameplay keep working.
-- When you make real meshes (docs/07-characters-and-graphics.md), custom rigs replace this.
local BodyBuilder = {}

local SKIN_MAT = Enum.Material.SmoothPlastic
local CLOTH = Enum.Material.Fabric
local LEATHER = Enum.Material.Leather

local function piece(char, attachTo, name, size, offset, color, material, shape, mesh)
	local p = Instance.new("Part")
	p.Name = "Body_" .. name
	p.Size = size
	p.Color = color
	p.Material = material or CLOTH
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		p.Shape = shape
	end
	if mesh then
		local m = Instance.new("SpecialMesh")
		m.MeshType = mesh
		m.Parent = p
	end
	p.CFrame = attachTo.CFrame * offset
	local w = Instance.new("Weld")
	w.Part0 = attachTo
	w.Part1 = p
	w.C0 = offset
	w.Parent = p
	p.Parent = char
	return p
end

-- vertical capsule-ish limb: cylinder along the part's Y axis + rounded end
local function limb(char, part, name, lengthMul, dia, color, material, yOffset)
	local len = part.Size.Y * lengthMul
	piece(char, part, name, Vector3.new(len, dia, dia), CFrame.new(0, yOffset or 0, 0) * CFrame.Angles(0, 0, math.rad(90)), color, material, Enum.PartType.Cylinder)
	piece(char, part, name .. "End", Vector3.new(dia, dia, dia), CFrame.new(0, (yOffset or 0) - len / 2, 0), color, material, Enum.PartType.Ball)
end

local function ellipsoid(char, part, name, size, offset, color, material)
	return piece(char, part, name, size, offset, color, material, nil, Enum.MeshType.Sphere)
end

function BodyBuilder.build(char, def)
	local c = def.colors
	local o = def.outfit or {}
	local skin, jacket, trousers = c.skin, c.torso, c.legs
	local boots = o.boots or Color3.fromRGB(40, 34, 30)
	local get = function(n)
		return char:FindFirstChild(n)
	end
	local head, ut, lt = get("Head"), get("UpperTorso"), get("LowerTorso")
	if not head or not ut or not lt then
		return false
	end

	-- hide the Roblox body (keep it for joints, physics and hit detection)
	for _, d in char:GetDescendants() do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and not d.Name:match("^Body_") and not d:FindFirstAncestorWhichIsA("Model").Name:match("^Weapon_") then
			d.Transparency = 1
		elseif d:IsA("Decal") then
			d.Transparency = 1
		end
	end

	-- head: skull, ears, eyes, hair / hat, fog mask
	local H = head.Size
	local hw = math.min(H.X, H.Z)
	ellipsoid(char, head, "Skull", Vector3.new(hw * 0.74, H.Y * 0.98, hw * 0.84), CFrame.new(0, 0.02, 0), skin, SKIN_MAT)
	for _, sx in { -1, 1 } do
		ellipsoid(char, head, "Ear", Vector3.new(0.08, hw * 0.2, hw * 0.13), CFrame.new(sx * hw * 0.37, 0, 0.02), skin, SKIN_MAT)
		ellipsoid(char, head, "Eye", Vector3.new(hw * 0.09, hw * 0.05, 0.04), CFrame.new(sx * hw * 0.14, H.Y * 0.06, -hw * 0.41), Color3.fromRGB(26, 22, 20), SKIN_MAT)
		ellipsoid(char, head, "Brow", Vector3.new(hw * 0.14, hw * 0.035, 0.05), CFrame.new(sx * hw * 0.14, H.Y * 0.14, -hw * 0.395) * CFrame.Angles(0, 0, sx * -0.12), o.hair or Color3.fromRGB(40, 30, 24), SKIN_MAT)
	end
	ellipsoid(char, head, "Mask", Vector3.new(hw * 0.8, H.Y * 0.5, hw * 0.74), CFrame.new(0, -H.Y * 0.2, -hw * 0.1), o.mask or Color3.fromRGB(110, 104, 94), CLOTH)
	local hat = o.hat
	if hat == "beanie" then
		ellipsoid(char, head, "Beanie", Vector3.new(hw * 0.82, H.Y * 0.6, hw * 0.9), CFrame.new(0, H.Y * 0.26, 0.02), o.hatColor, CLOTH)
		piece(char, head, "BeanieCuff", Vector3.new(0.18, hw * 0.86, hw * 0.86), CFrame.new(0, H.Y * 0.08, 0.02) * CFrame.Angles(0, 0, math.rad(90)), o.hatColor, CLOTH, Enum.PartType.Cylinder)
	elseif hat == "cap" then
		ellipsoid(char, head, "Cap", Vector3.new(hw * 0.8, H.Y * 0.5, hw * 0.88), CFrame.new(0, H.Y * 0.25, 0.02), o.hatColor, CLOTH)
		piece(char, head, "Brim", Vector3.new(hw * 0.6, 0.06, hw * 0.45), CFrame.new(0, H.Y * 0.16, -hw * 0.5) * CFrame.Angles(math.rad(-8), 0, 0), o.hatColor, CLOTH)
		ellipsoid(char, head, "HairBack", Vector3.new(hw * 0.72, H.Y * 0.45, hw * 0.4), CFrame.new(0, H.Y * 0.02, hw * 0.28), o.hair, CLOTH)
	elseif hat == "bun" then
		ellipsoid(char, head, "Hair", Vector3.new(hw * 0.8, H.Y * 0.62, hw * 0.9), CFrame.new(0, H.Y * 0.22, 0.04), o.hair, CLOTH)
		ellipsoid(char, head, "Bun", Vector3.new(hw * 0.36, hw * 0.36, hw * 0.36), CFrame.new(0, H.Y * 0.3, hw * 0.44), o.hair, CLOTH)
	elseif hat == "hood" then
		ellipsoid(char, head, "Hood", Vector3.new(hw * 0.98, H.Y * 1.08, hw * 1.02), CFrame.new(0, H.Y * 0.08, 0.1), o.hatColor, CLOTH)
	end

	-- torso: shaped chest, shoulders, collar, zip, pockets
	local T = ut.Size
	piece(char, ut, "Chest", Vector3.new(T.X * 0.74, T.Y * 0.96, T.Z * 0.66), CFrame.new(0, 0, 0), jacket, CLOTH)
	ellipsoid(char, ut, "ChestFront", Vector3.new(T.X * 0.72, T.Y * 0.7, T.Z * 0.3), CFrame.new(0, T.Y * 0.08, -T.Z * 0.3), jacket, CLOTH)
	for _, sx in { -1, 1 } do
		piece(char, ut, "Shoulder", Vector3.new(T.Y * 0.44, T.Y * 0.44, T.Y * 0.44), CFrame.new(sx * T.X * 0.36, T.Y * 0.28, 0), jacket, CLOTH, Enum.PartType.Ball)
		piece(char, ut, "Pocket", Vector3.new(T.X * 0.18, T.Y * 0.16, 0.06), CFrame.new(sx * T.X * 0.18, -T.Y * 0.24, -T.Z * 0.34), Color3.new(jacket.R * 0.85, jacket.G * 0.85, jacket.B * 0.85), CLOTH)
		-- backpack straps over the shoulders
		piece(char, ut, "Strap", Vector3.new(0.12, T.Y * 0.9, 0.08), CFrame.new(sx * T.X * 0.2, 0.02, -T.Z * 0.35), Color3.fromRGB(42, 36, 30), LEATHER)
	end
	piece(char, ut, "Collar", Vector3.new(0.3, hw * 0.62, hw * 0.62), CFrame.new(0, T.Y * 0.5, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.new(jacket.R * 0.9, jacket.G * 0.9, jacket.B * 0.9), CLOTH, Enum.PartType.Cylinder)
	piece(char, ut, "Neck", Vector3.new(0.45, hw * 0.36, hw * 0.36), CFrame.new(0, T.Y * 0.6, 0) * CFrame.Angles(0, 0, math.rad(90)), skin, SKIN_MAT, Enum.PartType.Cylinder)
	piece(char, ut, "Zip", Vector3.new(0.05, T.Y * 0.9, 0.04), CFrame.new(0, 0, -T.Z * 0.45), Color3.fromRGB(30, 30, 30), Enum.Material.Metal)
	if o.scarf then
		piece(char, ut, "Scarf", Vector3.new(0.36, hw * 0.75, hw * 0.75), CFrame.new(0, T.Y * 0.46, -0.02) * CFrame.Angles(0, 0, math.rad(90)), o.scarf, CLOTH, Enum.PartType.Cylinder)
		piece(char, ut, "ScarfTail", Vector3.new(0.22, T.Y * 0.6, 0.08), CFrame.new(T.X * 0.12, T.Y * 0.05, -T.Z * 0.42) * CFrame.Angles(0, 0, math.rad(-6)), o.scarf, CLOTH)
	end
	if o.medic then
		piece(char, ut, "MedicBand", Vector3.new(0.26, hw * 0.5, hw * 0.5), CFrame.new(-T.X * 0.42, T.Y * 0.05, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(220, 214, 200), CLOTH, Enum.PartType.Cylinder)
	end

	-- backpack with bedroll
	local pack = o.pack or Color3.fromRGB(80, 76, 60)
	piece(char, ut, "Pack", Vector3.new(T.X * 0.6, T.Y * 0.78, 0.48), CFrame.new(0, -T.Y * 0.04, T.Z * 0.33 + 0.24), pack, CLOTH)
	piece(char, ut, "PackPocket", Vector3.new(T.X * 0.4, T.Y * 0.3, 0.16), CFrame.new(0, -T.Y * 0.18, T.Z * 0.33 + 0.55), Color3.new(pack.R * 0.85, pack.G * 0.85, pack.B * 0.85), CLOTH)
	piece(char, ut, "Bedroll", Vector3.new(T.X * 0.78, 0.4, 0.4), CFrame.new(0, T.Y * 0.42, T.Z * 0.33 + 0.24), Color3.fromRGB(110, 96, 74), CLOTH, Enum.PartType.Cylinder)

	-- hips, belt
	local L = lt.Size
	piece(char, lt, "Hips", Vector3.new(L.X * 0.74, L.Y * 1.9, T.Z * 0.62), CFrame.new(0, -L.Y * 0.2, 0), trousers, CLOTH)
	piece(char, lt, "Belt", Vector3.new(L.X * 0.77, 0.14, T.Z * 0.65), CFrame.new(0, L.Y * 0.4, 0), Color3.fromRGB(42, 34, 28), LEATHER)
	piece(char, lt, "Buckle", Vector3.new(0.16, 0.12, 0.05), CFrame.new(0, L.Y * 0.4, -T.Z * 0.33), Color3.fromRGB(150, 140, 110), Enum.Material.Metal)
	if o.toolbelt then
		for i, x in { -0.3, 0.32 } do
			piece(char, lt, "Tool" .. i, Vector3.new(0.18, 0.4, 0.22), CFrame.new(x * L.X, 0, -T.Z * 0.3), Color3.fromRGB(70, 56, 40), LEATHER)
		end
	end

	-- arms & hands
	for _, side in { "Left", "Right" } do
		local ua, la, hand = get(side .. "UpperArm"), get(side .. "LowerArm"), get(side .. "Hand")
		if ua then
			limb(char, ua, side .. "Sleeve", 1.0, math.min(ua.Size.X, ua.Size.Z) * 0.56, jacket, CLOTH)
		end
		if la then
			limb(char, la, side .. "Forearm", 1.0, math.min(la.Size.X, la.Size.Z) * 0.5, jacket, CLOTH)
			piece(char, la, side .. "Cuff", Vector3.new(0.16, math.min(la.Size.X, la.Size.Z) * 0.56, math.min(la.Size.X, la.Size.Z) * 0.56), CFrame.new(0, -la.Size.Y * 0.45, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.new(jacket.R * 0.8, jacket.G * 0.8, jacket.B * 0.8), CLOTH, Enum.PartType.Cylinder)
		end
		if hand then
			local w = math.min(hand.Size.X, hand.Size.Z)
			piece(char, hand, side .. "Palm", Vector3.new(w * 0.36, hand.Size.Y * 1.5, w * 0.5), CFrame.new(0, -hand.Size.Y * 0.2, 0), skin, SKIN_MAT)
			ellipsoid(char, hand, side .. "Fingers", Vector3.new(w * 0.34, hand.Size.Y * 0.9, w * 0.46), CFrame.new(0, -hand.Size.Y * 0.95, -0.02), skin, SKIN_MAT)
			ellipsoid(char, hand, side .. "Thumb", Vector3.new(0.12, hand.Size.Y * 0.8, 0.12), CFrame.new(0, -hand.Size.Y * 0.3, -w * 0.28), skin, SKIN_MAT)
		end
	end

	-- legs & boots
	for _, side in { "Left", "Right" } do
		local ul, ll, foot = get(side .. "UpperLeg"), get(side .. "LowerLeg"), get(side .. "Foot")
		if ul then
			limb(char, ul, side .. "Thigh", 1.02, math.min(ul.Size.X, ul.Size.Z) * 0.66, trousers, CLOTH)
		end
		if ll then
			local d = math.min(ll.Size.X, ll.Size.Z)
			limb(char, ll, side .. "Shin", 1.0, d * 0.54, trousers, CLOTH)
			piece(char, ll, side .. "BootShaft", Vector3.new(ll.Size.Y * 0.42, d * 0.6, d * 0.6), CFrame.new(0, -ll.Size.Y * 0.32, 0) * CFrame.Angles(0, 0, math.rad(90)), boots, LEATHER, Enum.PartType.Cylinder)
		end
		if foot then
			local F = foot.Size
			piece(char, foot, side .. "Boot", Vector3.new(F.X * 0.56, F.Y * 1.3, F.Z * 0.95), CFrame.new(0, -F.Y * 0.1, -F.Z * 0.06), boots, LEATHER)
			ellipsoid(char, foot, side .. "Toe", Vector3.new(F.X * 0.56, F.Y * 1.25, F.Z * 0.5), CFrame.new(0, -F.Y * 0.12, -F.Z * 0.48), boots, LEATHER)
			piece(char, foot, side .. "Sole", Vector3.new(F.X * 0.6, 0.08, F.Z * 1.1), CFrame.new(0, -F.Y * 0.72, -F.Z * 0.12), Color3.fromRGB(24, 22, 20), Enum.Material.Rubber)
		end
	end
	return true
end

return BodyBuilder
]]></ProtectedString></Properties></Item>
<Item class="Folder" referent="RBX00000014"><Properties><string name="Name">Config</string></Properties><Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">AssetIds</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Roblox asset IDs of the uploaded 3D packs (aftertide/assets/*.glb). Filled in by
-- tools/upload_assets.py (Open Cloud) or by hand after importing them in Studio.
-- 0 = not uploaded yet: the game falls back to its built-in part models.
--
-- Alternative to IDs: import a pack in Studio (File > Import 3D) and put the resulting
-- Model in ServerStorage > Assets, named exactly like the pack (e.g. "Crew").
return {
	Packs = {
		Crew = 0,
		Factions = 0,
		Hushed = 0,
		Weapons = 0,
		Nature = 0,
		Props = 0,
	},
	-- If imported meshes face backwards, set this to 180.
	YawFix = 0,
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">Characters</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The crew. Each character has a signature ability, a starting loadout, an innate perk and a
-- choice of ONE starting perk. All characters are free to play (docs/03-monetisation.md).
--
-- Perk modifier keys (see Shared/Stats.luau for defaults):
--   noiseMult, crouchNoiseMult, waterNoiseMult, takedownTimeMult, shoveCooldownMult, healMult,
--   throwCapBonus (+n), damageTakenMult, abilityCooldownMult, abilityRadiusMult,
--   abilityDurationMult, sprintSpeedMult, reviveHPBonus (+n), bleedOutBonus (+s),
--   throwNoiseMult, craftTimeMult, craftYieldBonus (+n on traps/spikes/arrows),
--   ammoBonus (+n starting revolver rounds), aimSpreadMult
-- loadout.weapons = { long = <Weapons id>, sidearm = <Weapons id> }; loadout.items = reserve ammo + items.

local Characters = {}

Characters.Order = { "mara", "tobias", "ines", "sefa" }

Characters.List = {
	mara = {
		outfit = { hat = "beanie", hatColor = Color3.fromRGB(70, 56, 48), hair = Color3.fromRGB(58, 40, 30), mask = Color3.fromRGB(120, 110, 94), scarf = Color3.fromRGB(138, 70, 52), boots = Color3.fromRGB(46, 36, 30), pack = Color3.fromRGB(92, 84, 64) },
		name = "Mara Kell",
		role = "Stealth & scouting",
		bio = "Former harbour pilot. Reads the fog like a tide chart.",
		height = 1.02,
		colors = {
			skin = Color3.fromRGB(198, 160, 130),
			torso = Color3.fromRGB(58, 76, 84), -- oilskin teal
			arms = Color3.fromRGB(58, 76, 84),
			legs = Color3.fromRGB(48, 46, 42),
		},
		ability = {
			id = "TideSense",
			name = "Tide Sense",
			desc = "Salt glints reveal every Hushed nearby, through walls, for a few seconds.",
			cooldown = 25,
			radius = 70,
			duration = 4,
		},
		loadout = {
			weapons = { long = "bow", sidearm = "revolver" },
			items = { arrows = 6, pistolAmmo = 6, bottle = 2, dressing = 1, cloth = 1 },
		},
		innate = {
			id = "ShallowStep",
			name = "Shallow Step",
			desc = "Wading makes no extra noise.",
			mods = { waterNoiseMult = 0 },
		},
		perks = {
			{ id = "QuietHands", name = "Quiet Hands", desc = "Quietings are 40% faster.", mods = { takedownTimeMult = 0.6 } },
			{ id = "LongSense", name = "Long Sense", desc = "Tide Sense reaches 50% further.", mods = { abilityRadiusMult = 1.5 } },
			{ id = "LightFoot", name = "Light Foot", desc = "Crouched movement is 30% quieter.", mods = { crouchNoiseMult = 0.7 } },
		},
	},

	tobias = {
		outfit = { hat = "cap", hatColor = Color3.fromRGB(52, 58, 54), hair = Color3.fromRGB(30, 24, 20), mask = Color3.fromRGB(86, 82, 74), boots = Color3.fromRGB(40, 32, 26), pack = Color3.fromRGB(70, 74, 60), toolbelt = true },
		name = "Tobias Ruane",
		role = "Traps & distraction",
		bio = "Ferry engineer. Kept the Meridian's generator alive for eleven years.",
		height = 1.05,
		colors = {
			skin = Color3.fromRGB(150, 108, 82),
			torso = Color3.fromRGB(112, 74, 44), -- canvas work jacket
			arms = Color3.fromRGB(112, 74, 44),
			legs = Color3.fromRGB(52, 58, 66),
		},
		ability = {
			id = "RattleBox",
			name = "Rattle Box",
			desc = "Set down a clockwork noisemaker that pulls Hushed to it.",
			cooldown = 30,
			radius = 36,
			duration = 9,
		},
		loadout = {
			weapons = { long = "shotgun", sidearm = "revolver" },
			items = { shells = 4, pistolAmmo = 6, scrap = 2, tape = 1, saltBomb = 1, bottle = 1 },
		},
		innate = {
			id = "Tinkerer",
			name = "Tinkerer",
			desc = "Crafts twice as fast. Salt Bombs, Tide Spikes and arrows craft +1.",
			mods = { craftTimeMult = 0.5, craftYieldBonus = 1 },
		},
		perks = {
			{ id = "LoudDecoy", name = "Loud Decoy", desc = "Rattle Box is heard 40% further away.", mods = { abilityRadiusMult = 1.4 } },
			{ id = "ThickSkin", name = "Thick Skin", desc = "Take 15% less damage.", mods = { damageTakenMult = 0.85 } },
			{ id = "SpareRounds", name = "Spare Rounds", desc = "Start with 6 extra revolver rounds.", mods = { ammoBonus = 6 } },
		},
	},

	ines = {
		outfit = { hat = "bun", hatColor = Color3.fromRGB(26, 20, 18), hair = Color3.fromRGB(26, 20, 18), mask = Color3.fromRGB(200, 196, 186), boots = Color3.fromRGB(34, 30, 30), pack = Color3.fromRGB(150, 140, 120), medic = true },
		name = "Ines Okafor-Hale",
		role = "Sustain & co-op support",
		bio = "Paramedic. Runs the Meridian's sick bay out of a car deck.",
		height = 0.98,
		colors = {
			skin = Color3.fromRGB(110, 76, 58),
			torso = Color3.fromRGB(122, 40, 38), -- faded medic red
			arms = Color3.fromRGB(122, 40, 38),
			legs = Color3.fromRGB(40, 44, 50),
		},
		ability = {
			id = "SteadyHands",
			name = "Steady Hands",
			desc = "Heal yourself and nearby crew, and breathe quietly for a few seconds.",
			cooldown = 35,
			radius = 15,
			duration = 6,
		},
		loadout = {
			weapons = { long = "rifle", sidearm = "revolver" },
			items = { rifleAmmo = 4, pistolAmmo = 6, dressing = 2, cloth = 1, alcohol = 1 },
		},
		innate = {
			id = "FieldMedic",
			name = "Field Medic",
			desc = "Healing +25%. Crew you revive get up with +30 HP.",
			mods = { healMult = 1.25, reviveHPBonus = 30 },
		},
		perks = {
			{ id = "Marksman", name = "Marksman", desc = "Aimed shots are 40% steadier.", mods = { aimSpreadMult = 0.6 } },
			{ id = "SecondOpinion", name = "Second Opinion", desc = "You bleed out 15 seconds slower.", mods = { bleedOutBonus = 15 } },
			{ id = "Triage", name = "Triage", desc = "Steady Hands recharges 25% faster.", mods = { abilityCooldownMult = 0.75 } },
		},
	},

	sefa = {
		outfit = { hat = "hood", hatColor = Color3.fromRGB(130, 102, 46), hair = Color3.fromRGB(24, 20, 18), mask = Color3.fromRGB(64, 78, 84), boots = Color3.fromRGB(30, 40, 44), pack = Color3.fromRGB(58, 70, 66) },
		name = "Sefa Talataina",
		role = "Control & escapes",
		bio = "Fisher and net-maker. Has never once lost a catch.",
		height = 1.0,
		colors = {
			skin = Color3.fromRGB(134, 94, 66),
			torso = Color3.fromRGB(150, 118, 52), -- mustard fishing smock
			arms = Color3.fromRGB(150, 118, 52),
			legs = Color3.fromRGB(56, 62, 58),
		},
		ability = {
			id = "ThrowNet",
			name = "Throw Net",
			desc = "Pin the Hushed in front of you for a few seconds. Pinned Hushed can be Quieted from any side.",
			cooldown = 28,
			radius = 25,
			duration = 5,
		},
		loadout = {
			weapons = { long = "carbine", sidearm = "revolver" },
			items = { rifleAmmo = 7, pistolAmmo = 6, bottle = 3, fogPot = 1, dressing = 1 },
		},
		innate = {
			id = "DeepPockets",
			name = "Deep Pockets",
			desc = "Carry one extra of every throwable.",
			mods = { throwCapBonus = 1 },
		},
		perks = {
			{ id = "StrongArm", name = "Strong Arm", desc = "Thrown bottles are heard 30% further away.", mods = { throwNoiseMult = 1.3 } },
			{ id = "HeavyNet", name = "Heavy Net", desc = "Throw Net pins 50% longer.", mods = { abilityDurationMult = 1.5 } },
			{ id = "SeaLegs", name = "Sea Legs", desc = "Sprint 8% faster.", mods = { sprintSpeedMult = 1.08 } },
		},
	},
}

return Characters
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">Commerce</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Developer products. Create each one in Creator Hub > your experience > Monetization >
-- Developer Products, then paste its ID below (docs/06-publishing.md, step 5).
-- An ID of 0 means "not configured": the shop shows the item but will not prompt a purchase.
--
-- `price` is only a fallback label: the shop always shows the live price Roblox reports.
-- Rules (docs/03-monetisation.md): fixed contents, never random; Second Wind max once per
-- crossing; every aid can also be earned free by playing.
return {
	Products = {
		SecondWind = {
			productId = 0,
			name = "Second Wind",
			price = 49,
			desc = "Get back up once when you're downed. Max one per crossing.",
			grant = { secondWind = 1 },
		},
		SecondWind3 = {
			productId = 0,
			name = "Second Wind x3",
			price = 129,
			desc = "Three Second Wind tokens. Same limit: one per crossing.",
			grant = { secondWind = 3 },
		},
		Resupply = {
			productId = 0,
			name = "Resupply Satchel",
			price = 29,
			desc = "+6 revolver rounds, +1 Field Dressing, +1 Bottle. Once per crossing.",
			grant = { resupply = 1 },
		},
	},
	Order = { "SecondWind", "SecondWind3", "Resupply" },
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">Encounters</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The run ("crossing"): RunLength encounters chosen on the tide chart, each followed by a
-- return to the Meridian, then the finale. The Pall rises after every encounter.
return {
	RunLength = 3, -- encounters before the finale
	Types = {
		Salvage = {
			name = "Salvage",
			desc = "Salvage %d supply crates, then reach the Slipway flare.",
			crates = 4,
		},
		LanternWatch = {
			name = "Lantern Watch",
			desc = "Keep the signal lantern lit until the tide turns.",
			waves = 3, waveTime = 40, perWave = 4, lanternHP = 400, dps = 18,
		},
		Drift = {
			name = "Drift",
			desc = "They know you're here. Survive until the tide turns, then reach the flare.",
			duration = 150, huntInterval = 14, spawnInterval = 22, perSpawn = 2,
		},
	},
	Finale = {
		name = "The Breakwater",
		desc = "Keep the lantern lit through the last tide. Something big is coming.",
		type = "LanternWatch", waves = 4, waveTime = 45, perWave = 5, lanternHP = 600, dps = 18,
		boss = "Tidewalker",
	},
	-- Base enemies on the map, plus per-Pall and per-extra-player scaling.
	BaseEnemies = 5,
	PerPall = 1,
	PerExtraPlayer = 2,
	MaxEnemies = 16,
	-- Who holds the ground on a route. Factions appear from the second stop.
	Factions = {
		Watch = { name = "Harbour Watch", desc = "Armed militia patrols with flashlights and radios.", weights = { WatchRifleman = 3, WatchScout = 2, Drifter = 1 } },
		Tidebound = { name = "The Tidebound", desc = "Cultists with silent bows and hooks. Listen for the bell.", weights = { TideboundHook = 3, TideboundArcher = 2, Drifter = 1 } },
	},
	FactionChance = 0.45,
	-- Enemy type unlocks by Pall level (weights).
	TypeWeights = {
		[1] = { Drifter = 4, Rusher = 2 },
		[2] = { Drifter = 4, Rusher = 2, Seeker = 1.5, Bellwether = 1 },
		[3] = { Drifter = 3, Rusher = 2, Seeker = 2, Bellwether = 1, Tidewalker = 0.5 },
		[4] = { Drifter = 3, Rusher = 3, Seeker = 2, Bellwether = 1, Tidewalker = 1 },
	},
	Rewards = {
		salvagePerEncounter = 15, -- +5 per Pall
		scripPerEncounter = 10, -- +5 per encounter index
		scripRunComplete = 50,
	},
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">Enemies</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The Hushed: people taken by the Pall, in stages. Original designs (salt-crusted, faceless,
-- never gory: they burst into salt). Bodies are built in code from jointed parts and
-- animated procedurally on clients (EnemyService builds, EnemyAnimator animates).
--
-- Senses: sightRange 0 = blind. hearingMult scales how far they hear every noise
-- (footsteps, gunshots, thrown bottles, explosions, doors). `rushToNoise` = sprints at sounds.
local Drifter = {
	hp = 100, scale = 1, color = Color3.fromRGB(52, 47, 44),
	patrolSpeed = 5.5, investigateSpeed = 9, chaseSpeed = 16.5,
	sightRange = 70, fovDeg = 110, closeRange = 9, hearingMult = 1,
	suspicionGain = 1.1, suspicionDecay = 0.18,
	noticeThreshold = 0.15, investigateThreshold = 0.35, alertThreshold = 1,
	loseSightTime = 4, searchTime = 10,
	grabRange = 3.6, grabDamage = 34, grabRecover = 2.2,
	staggerTime = 0.3, shoveable = true, quietable = true, headMultScale = 1,
	salvage = 2,
	-- body: proportions + look (see EnemyService.buildModel)
	body = { torso = 1, arms = 1.08, legs = 1, hunch = 12, head = "round", crust = 7, rags = 3, spines = 3, maw = true },
	gait = "shamble",
}

local function variant(overrides)
	local t = table.clone(Drifter)
	for k, v in overrides do
		t[k] = v
	end
	return t
end

return {
	TickRate = 10,
	Types = {
		-- Stage 1: freshly taken. Fast, twitchy, still sees well. Comes in groups.
		Rusher = variant({
			hp = 70, scale = 0.95, color = Color3.fromRGB(78, 64, 58),
			patrolSpeed = 7, investigateSpeed = 15, chaseSpeed = 19, rushToNoise = true,
			sightRange = 80, suspicionGain = 1.6, hearingMult = 1.2,
			grabDamage = 26, grabRecover = 1.8, salvage = 2,
			body = { torso = 0.88, arms = 1.1, legs = 1.05, hunch = 22, head = "half", crust = 4, rags = 5, spines = 1, maw = true },
			gait = "rush",
		}),
		-- Stage 2: the drifting majority. Slow, half-blind in fog.
		Drifter = Drifter,
		-- Stage 3: sealed in salt, completely blind. Hears everything. Deadly up close.
		Seeker = variant({
			hp = 130, scale = 1.05, color = Color3.fromRGB(44, 42, 40),
			patrolSpeed = 4, investigateSpeed = 13, chaseSpeed = 15, rushToNoise = true,
			sightRange = 0, closeRange = 3, hearingMult = 1.9,
			grabRange = 3.4, grabDamage = 65, grabRecover = 2.6,
			shoveable = false, headMultScale = 0.8, salvage = 5,
			body = { torso = 1, arms = 1.25, legs = 1, hunch = 6, head = "shell", crust = 12, rags = 1, spines = 6, maw = false },
			gait = "feel",
		}),
		-- Calls the others: a low hum that alerts every Hushed in range.
		Bellwether = variant({
			hp = 120, scale = 1.08, color = Color3.fromRGB(58, 60, 62),
			hum = { radius = 85, cooldown = 8 }, chaseSpeed = 15, salvage = 4,
			body = { torso = 1, arms = 1.15, legs = 1.05, hunch = 4, head = "disc", crust = 8, rags = 2, spines = 4, maw = true },
		}),
		-- THE HARBOUR WATCH: ex-port-authority militia. Rifles, flashlights, radios.
		WatchRifleman = variant({
			hp = 110, scale = 1, color = Color3.fromRGB(70, 78, 82), human = true, faction = "Watch",
			patrolSpeed = 6, investigateSpeed = 10, chaseSpeed = 13.5, sightRange = 95, fovDeg = 100,
			suspicionGain = 1.0, hearingMult = 1.0, flashlight = true, callout = "Radio_Callout",
			attack = { kind = "ranged", weapon = "rifle", range = 85, damage = 18, fireDelay = 1.7, accuracy = 0.55, noise = 100 },
			headMultScale = 1.3, salvage = 7, grabDamage = 0,
			body = { torso = 1, arms = 1, legs = 1, hunch = 0, head = "round", crust = 0, rags = 0, spines = 0, maw = false },
			gait = "soldier",
		}),
		WatchScout = variant({
			hp = 85, scale = 0.97, color = Color3.fromRGB(78, 84, 80), human = true, faction = "Watch",
			patrolSpeed = 7, investigateSpeed = 11, chaseSpeed = 15, sightRange = 85, fovDeg = 110,
			flashlight = true, callout = "Radio_Callout",
			attack = { kind = "ranged", weapon = "revolver", range = 55, damage = 12, fireDelay = 0.9, accuracy = 0.5, noise = 75 },
			headMultScale = 1.3, salvage = 5, grabDamage = 0,
			body = { torso = 0.95, arms = 1, legs = 1, hunch = 0, head = "round", crust = 0, rags = 0, spines = 0, maw = false },
			gait = "soldier",
		}),
		-- THE TIDEBOUND: a cult that worships the Pall. Silent bows, hooks, a struck bell.
		TideboundArcher = variant({
			hp = 80, scale = 0.97, color = Color3.fromRGB(214, 206, 188), human = true, faction = "Tidebound",
			patrolSpeed = 6, investigateSpeed = 10, chaseSpeed = 14, sightRange = 90, fovDeg = 105, hearingMult = 1.2,
			callout = "Bell_Strike",
			attack = { kind = "ranged", weapon = "bow", range = 75, damage = 24, fireDelay = 2.3, accuracy = 0.6, noise = 6 },
			headMultScale = 1.3, salvage = 5, grabDamage = 0,
			body = { torso = 0.95, arms = 1, legs = 1, hunch = 4, head = "round", crust = 0, rags = 0, spines = 0, maw = false },
			gait = "cultist",
		}),
		TideboundHook = variant({
			hp = 100, scale = 1.03, color = Color3.fromRGB(196, 188, 170), human = true, faction = "Tidebound",
			patrolSpeed = 6.5, investigateSpeed = 12, chaseSpeed = 17.5, sightRange = 80, fovDeg = 110, hearingMult = 1.2,
			callout = "Bell_Strike",
			attack = { kind = "melee", range = 4.2, damage = 22, fireDelay = 1.15 },
			headMultScale = 1.3, salvage = 5, grabDamage = 0,
			body = { torso = 1.05, arms = 1, legs = 1, hunch = 8, head = "round", crust = 0, rags = 0, spines = 0, maw = false },
			gait = "cultist",
		}),
		-- The last stage: a walking salt reef. Can't be shoved or Quieted.
		Tidewalker = variant({
			hp = 700, scale = 1.45, color = Color3.fromRGB(38, 36, 34),
			patrolSpeed = 4.5, investigateSpeed = 7, chaseSpeed = 12.5,
			sightRange = 55, grabRange = 5, grabDamage = 60, grabRecover = 2.8, hearingMult = 1.3,
			staggerTime = 0.08, shoveable = false, quietable = false, headMultScale = 0.6,
			salvage = 25,
			body = { torso = 1.45, arms = 1.3, legs = 1.1, hunch = 24, head = "sunk", crust = 22, rags = 0, spines = 12, maw = true },
			gait = "heavy",
		}),
	},
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">Game</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Global tuning for a Crossing. Everything a designer may want to change lives in Config/.
local Game = {
	MaxPartySize = 4, -- per server; also set "Server size" to this in Creator Hub (docs/06-publishing.md)
	StartCountdown = 6,
	ResultsDuration = 12,
	MaxHP = 100,
	BleedOutTime = 30,
	ReviveTime = 2.5, -- seconds a teammate holds the revive prompt
	ReviveHP = 40,
	ExtractionRadius = 12,

	-- Paid / earnable run aids (Second Wind, Resupply). Set false to make the game cosmetics-only.
	RunAidsEnabled = true,
	SecondWindHP = 60,
	StartingTokens = { secondWind = 1, resupply = 1 }, -- new players
	WinReward = { resupply = 1 }, -- every successful crossing
	DailyWinReward = { secondWind = 1 }, -- first successful crossing each UTC day

	FerryOrigin = Vector3.new(0, 0, 700),
}

return Game
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">Items</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Everything that can live in the satchel. Scarcity is the point: several recipes compete
-- for the same parts, so every craft is a decision. Satchel capacity is NEVER sold;
-- it is upgraded at the workbench with Salvage earned in the run.
return {
	Items = {
		-- crafting parts
		cloth = { name = "Cloth", kind = "part", cap = 3 },
		alcohol = { name = "Alcohol", kind = "part", cap = 3 },
		powder = { name = "Black Salt", kind = "part", cap = 3 },
		scrap = { name = "Scrap", kind = "part", cap = 3 },
		tape = { name = "Tape", kind = "part", cap = 3 },
		canister = { name = "Canister", kind = "part", cap = 3 },
		-- ammunition (reserve; magazines live on the weapon)
		pistolAmmo = { name = "Revolver rounds", kind = "ammo", cap = 18 },
		rifleAmmo = { name = "Rifle rounds", kind = "ammo", cap = 12 },
		shells = { name = "Shells", kind = "ammo", cap = 8 },
		arrows = { name = "Arrows", kind = "ammo", cap = 10 },
		-- consumables, throwables, tools
		dressing = { name = "Field Dressing", kind = "consumable", cap = 2 },
		bottle = { name = "Bottle", kind = "throwable", cap = 3 },
		flarePot = { name = "Flare Pot", kind = "throwable", cap = 2 },
		fogPot = { name = "Fog Pot", kind = "throwable", cap = 2 },
		saltBomb = { name = "Salt Bomb", kind = "throwable", cap = 2 },
		spike = { name = "Tide Spike", kind = "tool", cap = 2 },
	},
	Order = {
		"cloth", "alcohol", "powder", "scrap", "tape", "canister",
		"pistolAmmo", "rifleAmmo", "shells", "arrows",
		"dressing", "bottle", "flarePot", "fogPot", "saltBomb", "spike",
	},
	Parts = { "cloth", "alcohol", "powder", "scrap", "tape", "canister" },
	Throwables = { "bottle", "flarePot", "fogPot", "saltBomb" },

	Recipes = {
		dressing = { name = "Field Dressing", output = "dressing", amount = 1, cost = { cloth = 1, alcohol = 1 }, time = 2 },
		flarePot = { name = "Flare Pot", output = "flarePot", amount = 1, cost = { alcohol = 1, cloth = 1 }, time = 1.5 },
		fogPot = { name = "Fog Pot", output = "fogPot", amount = 1, cost = { powder = 1, canister = 1 }, time = 1.5 },
		saltBomb = { name = "Salt Bomb", output = "saltBomb", amount = 1, cost = { powder = 1, scrap = 1 }, time = 2, perkYield = true },
		spike = { name = "Tide Spike", output = "spike", amount = 1, cost = { scrap = 1, tape = 1 }, time = 1.2, perkYield = true },
		arrows = { name = "Arrows x2", output = "arrows", amount = 2, cost = { scrap = 1 }, time = 1, perkYield = true },
	},
	RecipeOrder = { "dressing", "flarePot", "fogPot", "saltBomb", "spike", "arrows" },

	Dressing = { heal = 60, channel = 2.2 },
	Throw = {
		speed = 75,
		lift = 16,
		bottle = { noise = 45 },
		flarePot = { radius = 7, duration = 7, dps = 32, noise = 30 },
		fogPot = { radius = 10, duration = 10, stun = 2.5, noise = 14 },
		saltBomb = { radius = 9, damage = 150, armTime = 0.8, triggerRadius = 5, noise = 90, lifetime = 90 },
	},
	Quieting = { range = 4.5, time = 0.9, noise = 6, salvage = 3 },
	Shove = { range = 5.5, cooldown = 4, stun = 2.2, noise = 12 },

	-- What one Resupply token gives (fixed, never random).
	Resupply = { pistolAmmo = 6, dressing = 1, bottle = 1 },

	-- Satchel upgrades (workbench) raise these.
	CapBonus = { satchel = 1, ammoPouch = 0.5 },
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">Loot</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Searchable containers and loose items. Loot rolls are free and random (never paid).
-- entry = { item, weight, min, max }; item "salvage" is the run currency.
return {
