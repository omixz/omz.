	cannery = { Side = 137631688346498, Up = 79183483786484, Dn = 94124006618010 },
	larkspur = { Side = 87124666839160, Up = 87577397247601, Dn = 103600431959158 },
	pines = { Side = 140174747538106, Up = 135204908625709, Dn = 95667927105583 },
	night = { Side = 113770266487869, Up = 122006218340804, Dn = 133935145366936 },
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">Sounds</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Every sound in the game. The audio itself is our own (generated by tools/make_sounds.py
-- into aftertide/audio/*.ogg). Upload those files to Roblox (docs/08-audio.md) and paste
-- each ID here as "rbxassetid://123456". An empty ID is silent; the noise the Hushed hear
-- still happens, because that's gameplay, not audio.
--
-- Shortcut: run tools/fill_sound_ids.py with the IDs Roblox gives you to fill this in.
local IDS = {
	-- weapons
	Gun_revolver = "rbxassetid://107203008261977",
	Gun_carbine = "rbxassetid://106246782951640",
	Gun_rifle = "rbxassetid://107413186530597",
	Gun_shotgun = "rbxassetid://83853882538111",
	Gun_bow = "rbxassetid://138144855055355",
	Reload = "rbxassetid://127981477399191",
	DryFire = "rbxassetid://119587358536236",
	Equip = "rbxassetid://126546332747472",
	-- impacts & world
	ImpactWorld = "rbxassetid://79248946547928",
	ImpactSalt = "rbxassetid://84763584372745",
	BottleBreak = "rbxassetid://72011235975599",
	Explosion = "rbxassetid://125903814325445",
	FireLoop = "rbxassetid://127381433269535",
	FogHiss = "rbxassetid://100453096251107",
	Door = "rbxassetid://136549724119766",
	Search = "rbxassetid://106759634937184",
	Pickup = "rbxassetid://122887575301165",
	-- body
	Step = "rbxassetid://73812653613871",
	StepWater = "rbxassetid://104706538460409",
	Dodge = "rbxassetid://72502613219569",
	Swing = "rbxassetid://139526386779157",
	MeleeHit = "rbxassetid://76888463032588",
	Heartbeat = "rbxassetid://99201312232281",
	Hurt = "rbxassetid://84183406339641",
	Bandage = "rbxassetid://71518393354878",
	Throw = "rbxassetid://73449279120963",
	-- the Hushed
	Hushed_Breath = "rbxassetid://129411707716573",
	Hushed_Growl = "rbxassetid://134511350713330",
	Hushed_Attack = "rbxassetid://102182607715724",
	Rusher_Shriek = "rbxassetid://95762607504069",
	Seeker_Grind = "rbxassetid://129766260822197",
	Tidewalker_Groan = "rbxassetid://92624708447179",
	Hum = "rbxassetid://111452920845337",
	Disperse = "rbxassetid://126029610283901",
	-- factions
	Radio_Callout = "rbxassetid://72819860728390",
	Bell_Strike = "rbxassetid://75163935051143",
	-- ambience & music
	Amb_Wind = "rbxassetid://75615777859334",
	Amb_Sea = "rbxassetid://140489121917944",
	Amb_Drone = "rbxassetid://76696979578820",
	Music_Tension = "rbxassetid://124082186264097",
	Stinger_Spotted = "rbxassetid://120754538435575",
	Stinger_Clear = "rbxassetid://121168486280613",
	-- round 4: voices, movement, listening, ambience
	Voice_A = "rbxassetid://93992041891670",
	Voice_B = "rbxassetid://121975714721496",
	Voice_C = "rbxassetid://119244749168715",
	Land = "rbxassetid://92798889873778",
	Vault = "rbxassetid://130582866628980",
	Jump = "rbxassetid://86695053997612",
	Listen_On = "rbxassetid://121575637405085",
	Listen_Off = "rbxassetid://73042838451574",
	Listen_Loop = "rbxassetid://111352797348693",
	Listen_Ping = "rbxassetid://124282827676070",
	Amb_Birds = "rbxassetid://81453256883344",
	Amb_Gulls = "rbxassetid://101380433515222",
	ShellDrop = "rbxassetid://132563956846175",
	Breath_Heavy = "rbxassetid://129405311830441",
	Cloth = "rbxassetid://114522137736035",
	-- interface
	Ui_Tick = "rbxassetid://97844955766987",
	Ui_Confirm = "rbxassetid://125630457998944",
}

-- Placeholders that ship inside the Roblox client, used until you upload the pack.
local FALLBACK = {
	Swing = "rbxasset://sounds/swordlunge.wav",
	MeleeHit = "rbxasset://sounds/swordslash.wav",
	Dodge = "rbxasset://sounds/swordlunge.wav",
	BottleBreak = "rbxasset://sounds/impact_water.mp3",
	StepWater = "rbxasset://sounds/impact_water.mp3",
}

-- Older keys used around the code, mapped onto the pack.
local ALIASES = {
	Quieting = "Disperse",
	Shove = "MeleeHit",
	Spotted = "Hushed_Growl",
	Rattle = "Ui_Tick",
	Splash = "StepWater",
}

local VOLUME = {
	Amb_Wind = 0.7, Amb_Sea = 0.45, Amb_Drone = 0.6, Music_Tension = 0.8,
	Step = 0.35, StepWater = 0.45, Hushed_Breath = 0.6, Heartbeat = 0.6,
	Ui_Tick = 0.3, Ui_Confirm = 0.4,
	Voice_A = 0.9, Voice_B = 0.9, Voice_C = 0.9, Land = 0.8, Vault = 0.7, Jump = 0.5,
	Amb_Birds = 0.8, Amb_Gulls = 0.7, ShellDrop = 0.5, Breath_Heavy = 0.7, Listen_Loop = 0.5,
}

local Sounds = {}
for key, id in IDS do
	Sounds[key] = id ~= "" and id or (FALLBACK[key] or "")
end
for alias, target in ALIASES do
	Sounds[alias] = Sounds[target]
end
Sounds.Volume = VOLUME

return Sounds
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000019"><Properties><string name="Name">Spin</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The Lucky Spin (Meridian deck and the HUD).
--   * One FREE spin every day (resets at 00:00 UTC).
--   * Extra spins are Spin tokens: bought for Robux (LuckySpin products) or won on the wheel.
--   * The odds below are shown to players in the Spin screen BEFORE they spin or buy, as
--     Roblox's paid random items policy requires. Where PolicyService says paid random items
--     are restricted for a player, spin tokens are not sold to them (the free daily spin stays).
-- weights add up to 1000, so the odds read as exact percentages with one decimal.
return {
	Prizes = {
		{ id = "scrip40", name = "40 Scrip", short = "40", icon = "S", weight = 250, color = { 214, 176, 92 }, grant = { scrip = 40 } },
		{ id = "mat25", name = "25 Materials", short = "25", icon = "M", weight = 160, color = { 120, 170, 210 }, grant = { materials = 25 } },
		{ id = "rounds", name = "Revolver ammo (next crossing)", short = "AMMO", icon = "A", weight = 140, color = { 230, 120, 80 }, grant = { kit = { rounds = 1 } } },
		{ id = "scrip100", name = "100 Scrip", short = "100", icon = "S", weight = 130, color = { 240, 200, 90 }, grant = { scrip = 100 } },
		{ id = "longrounds", name = "Rifle, shell & arrow ammo (next crossing)", short = "AMMO+", icon = "A", weight = 90, color = { 240, 140, 70 }, grant = { kit = { longrounds = 1 } } },
		{ id = "mat60", name = "60 Materials", short = "60", icon = "M", weight = 70, color = { 100, 190, 240 }, grant = { materials = 60 } },
		{ id = "ammo", name = "Ammo Cache token", short = "CACHE", icon = "C", weight = 60, color = { 250, 110, 90 }, grant = { tokens = { ammo = 1 } } },
		{ id = "spin", name = "Free re-spin", short = "AGAIN", icon = "R", weight = 40, color = { 170, 130, 240 }, grant = { tokens = { spin = 1 } } },
		{ id = "secondWind", name = "Second Wind token", short = "LIFE", icon = "W", weight = 30, color = { 120, 220, 140 }, grant = { tokens = { secondWind = 1 } } },
		{ id = "build", name = "Shipwright's Crew token", short = "BUILD", icon = "B", weight = 15, color = { 90, 210, 200 }, grant = { tokens = { build = 1 } } },
		{ id = "gun", name = "A new gun (unlocks a locked long gun)", short = "GUN!", icon = "G", weight = 10, color = { 255, 120, 60 }, grant = { gun = true } },
		{ id = "jackpot", name = "JACKPOT: 500 Scrip", short = "500!", icon = "J", weight = 5, color = { 255, 214, 60 }, grant = { scrip = 500 } },
	},
	-- products in Config/Commerce: LuckySpin (1 spin), LuckySpin5 (5 spins)
	MaxKitStack = 4, -- kits won on the wheel stack up to this many per kit type
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000001A"><Properties><string name="Name">Upgrades</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Two kinds of upgrade:
--   * Workbench (per run, paid with Salvage found in the run): weapon parts, satchel, perks.
--   * Meridian repairs (permanent, paid with Scrip earned by playing): the homebase.
-- Neither can be bought with Robux.
local Upgrades = {}

-- mods: damageMult, reloadMult, noiseMult, recoilMult, spreadMult, aimSpreadMult,
--       fireDelayMult, magBonus (+n), aimFovMult
Upgrades.Weapon = {
	revolver = {
		{ id = "loads", name = "Hand-loaded rounds", desc = "+25% damage", cost = 25, mods = { damageMult = 1.25 } },
		{ id = "loader", name = "Speed loader", desc = "Reload 40% faster", cost = 20, mods = { reloadMult = 0.6 } },
		{ id = "baffle", name = "Baffle", desc = "Shots are 60% quieter", cost = 40, mods = { noiseMult = 0.4 } },
		{ id = "grip", name = "Weighted grip", desc = "-40% recoil, tighter spread", cost = 20, mods = { recoilMult = 0.6, spreadMult = 0.75 } },
	},
	carbine = {
		{ id = "tube", name = "Long tube", desc = "+3 rounds per load", cost = 30, mods = { magBonus = 3 } },
		{ id = "lever", name = "Smoothed lever", desc = "Fires 30% faster", cost = 30, mods = { fireDelayMult = 0.7 } },
		{ id = "sights", name = "Peep sights", desc = "Much tighter aim", cost = 20, mods = { aimSpreadMult = 0.4 } },
		{ id = "pad", name = "Recoil pad", desc = "-45% recoil", cost = 15, mods = { recoilMult = 0.55 } },
	},
	rifle = {
		{ id = "scope", name = "Salvaged scope", desc = "Zoomed, pinpoint aim", cost = 35, mods = { aimSpreadMult = 0.1, aimFovMult = 0.6 } },
		{ id = "bolt", name = "Polished bolt", desc = "Cycles 35% faster", cost = 30, mods = { fireDelayMult = 0.65 } },
		{ id = "mag", name = "Extended magazine", desc = "+2 rounds", cost = 25, mods = { magBonus = 2 } },
		{ id = "pad", name = "Stock pad", desc = "-45% recoil", cost = 15, mods = { recoilMult = 0.55 } },
	},
	shotgun = {
		{ id = "choke", name = "Choke", desc = "30% tighter spread", cost = 25, mods = { spreadMult = 0.7, aimSpreadMult = 0.7 } },
		{ id = "tube", name = "Tube extension", desc = "+2 shells", cost = 30, mods = { magBonus = 2 } },
		{ id = "pump", name = "Quick pump", desc = "Fires 25% faster", cost = 25, mods = { fireDelayMult = 0.75 } },
		{ id = "loads", name = "Heavy shot", desc = "+25% damage", cost = 30, mods = { damageMult = 1.25 } },
	},
	bow = {
		{ id = "draw", name = "Heavier draw", desc = "+30% damage", cost = 30, mods = { damageMult = 1.3 } },
		{ id = "nock", name = "Quick nock", desc = "Fires 35% faster", cost = 20, mods = { fireDelayMult = 0.65, reloadMult = 0.65 } },
		{ id = "stab", name = "Stabiliser", desc = "Much tighter aim", cost = 20, mods = { aimSpreadMult = 0.4, spreadMult = 0.7 } },
	},
}

Upgrades.General = {
	{ id = "satchel", name = "Bigger satchel", desc = "+1 capacity for every part, throwable and consumable", cost = 30 },
	{ id = "ammoPouch", name = "Ammo pouch", desc = "+50% ammo capacity", cost = 30 },
	{ id = "holster", name = "Holster rig", desc = "Swap weapons twice as fast", cost = 15 },
}

Upgrades.PerkCost = 30 -- buy each of your character's other perks during a run

-- Meridian repairs are now Projects (Config/Projects.luau).
Upgrades.Repairs = require(script.Parent.Projects).List

return Upgrades
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000001B"><Properties><string name="Name">Weapons</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Fictional, stylised weapons (no real brands or real-world specs). Damage is against the
-- Hushed (Drifter = 100 HP). Gunshots are LOUD: every shot is a noise event, so going loud
-- is a choice with consequences. The bow is the quiet option.
-- spread values are degrees; noise is the radius (studs) Hushed hear the shot.
-- impact = how hard a hit shoves / staggers (and throws a ragdoll); recoilPattern = sideways
-- kick per shot in a repeating pattern (learnable, not random); adsTime = seconds to aim in;
-- perShell = reload one shell at a time (you can fire mid-reload).
return {
	List = {
		revolver = {
			name = "Service Revolver", slot = "sidearm", ammo = "pistolAmmo",
			mag = 6, damage = 38, headMult = 2.5, pellets = 1,
			fireDelay = 0.42, reload = 2.5, range = 180,
			spreadHip = 5.2, spreadAim = 0.7, moveSpread = 3.4, recoil = 3.7,
			impact = 1.2, recoilPattern = { 0.15, -0.2, 0.25, -0.1, 0.2, -0.25 }, adsTime = 0.24,
			noise = 75, aimFov = 52,
		},
		rifle = {
			name = "Bolt Rifle", slot = "long", ammo = "rifleAmmo",
			mag = 4, damage = 95, headMult = 2.2, pellets = 1,
			fireDelay = 1.25, reload = 3.4, range = 320,
			spreadHip = 9.1, spreadAim = 0.12, moveSpread = 5.4, recoil = 8.0,
			impact = 2.2, recoilPattern = { 0.1 }, adsTime = 0.38,
			noise = 115, aimFov = 42,
		},
		carbine = {
			name = "Lever Carbine", slot = "long", ammo = "rifleAmmo",
			mag = 6, damage = 55, headMult = 2.0, pellets = 1,
			fireDelay = 0.55, reload = 3.6, range = 240,
			spreadHip = 6.5, spreadAim = 0.4, moveSpread = 4.1, recoil = 5.2,
			impact = 1.4, recoilPattern = { 0.2, 0.3, -0.1, 0.35, 0.1, -0.2, 0.3 }, adsTime = 0.3,
			noise = 95, aimFov = 48,
		},
		shotgun = {
			name = "Pump Shotgun", slot = "long", ammo = "shells",
			mag = 4, damage = 16, headMult = 1.5, pellets = 9, falloff = true, perShell = true,
			fireDelay = 0.95, reload = 3.6, range = 55,
			spreadHip = 9.8, spreadAim = 5, moveSpread = 2.7, recoil = 9.2,
			impact = 2.6, recoilPattern = { -0.25, 0.3, -0.2, 0.25 }, adsTime = 0.32,
			noise = 100, aimFov = 56,
		},
		bow = {
			name = "Recurve Bow", slot = "long", ammo = "arrows",
			mag = 1, damage = 70, headMult = 2.2, pellets = 1, autoReload = true,
			fireDelay = 0.85, reload = 0.7, range = 220,
			spreadHip = 3.9, spreadAim = 0.35, moveSpread = 2.0, recoil = 1.7,
			impact = 1.6, recoilPattern = { 0 }, adsTime = 0.34,
			noise = 5, aimFov = 50, projectile = { speed = 170, gravityScale = 0.35 },
		},
	},
	Order = { "revolver", "carbine", "rifle", "shotgun", "bow" },
	LongGuns = { "carbine", "rifle", "shotgun", "bow" },
	SwapTime = 0.6, -- holster <-> hands
	PackSwapTime = 2.4, -- digging a gun out of the backpack (TLOU-style holster system)
	HeadshotNoiseMult = 1,
}
]]></ProtectedString></Properties></Item>
