<Item class="Lighting" referent="RBX00000002"><Properties><string name="Name">Lighting</string><token name="Technology">4</token></Properties></Item>
<Item class="Players" referent="RBX00000003"><Properties><string name="Name">Players</string><bool name="CharacterAutoLoads">false</bool></Properties></Item>
<Item class="ReplicatedStorage" referent="RBX0000001A"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000019"><Properties><string name="Name">Shared</string></Properties><Item class="Folder" referent="RBX00000011"><Properties><string name="Name">Config</string></Properties><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">Characters</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The crew. Each character has a signature ability, a starting loadout, an innate perk and a
-- choice of ONE starting perk. All characters are free to play (docs/03-monetisation.md).
--
-- Perk modifier keys (see Shared/Stats.luau for defaults):
--   noiseMult, crouchNoiseMult, waterNoiseMult, takedownTimeMult, shoveCooldownMult, healMult,
--   throwCapBonus (+n), damageTakenMult, abilityCooldownMult, abilityRadiusMult,
--   abilityDurationMult, sprintSpeedMult, reviveHPBonus (+n), bleedOutBonus (+s),
--   throwNoiseMult, craftTimeMult, craftYieldBonus (+n on traps/spikes/arrows),
--   ammoBonus (+n starting revolver rounds), aimSpreadMult
-- loadout.weapons = { long = <Weapons id>, sidearm = <Weapons id> }; loadout.items = reserve ammo + items.

local Characters = {}

Characters.Order = { "mara", "tobias", "ines", "sefa" }

Characters.List = {
	mara = {
		name = "Mara Kell",
		role = "Stealth & scouting",
		bio = "Former harbour pilot. Reads the fog like a tide chart.",
		height = 1.02,
		colors = {
			skin = Color3.fromRGB(198, 160, 130),
			torso = Color3.fromRGB(58, 76, 84), -- oilskin teal
			arms = Color3.fromRGB(58, 76, 84),
			legs = Color3.fromRGB(48, 46, 42),
		},
		ability = {
			id = "TideSense",
			name = "Tide Sense",
			desc = "Salt glints reveal every Hushed nearby, through walls, for a few seconds.",
			cooldown = 25,
			radius = 70,
			duration = 4,
		},
		loadout = {
			weapons = { long = "bow", sidearm = "revolver" },
			items = { arrows = 6, pistolAmmo = 6, bottle = 2, dressing = 1, cloth = 1 },
		},
		innate = {
			id = "ShallowStep",
			name = "Shallow Step",
			desc = "Wading makes no extra noise.",
			mods = { waterNoiseMult = 0 },
		},
		perks = {
			{ id = "QuietHands", name = "Quiet Hands", desc = "Quietings are 40% faster.", mods = { takedownTimeMult = 0.6 } },
			{ id = "LongSense", name = "Long Sense", desc = "Tide Sense reaches 50% further.", mods = { abilityRadiusMult = 1.5 } },
			{ id = "LightFoot", name = "Light Foot", desc = "Crouched movement is 30% quieter.", mods = { crouchNoiseMult = 0.7 } },
		},
	},

	tobias = {
		name = "Tobias Ruane",
		role = "Traps & distraction",
		bio = "Ferry engineer. Kept the Meridian's generator alive for eleven years.",
		height = 1.05,
		colors = {
			skin = Color3.fromRGB(150, 108, 82),
			torso = Color3.fromRGB(112, 74, 44), -- canvas work jacket
			arms = Color3.fromRGB(112, 74, 44),
			legs = Color3.fromRGB(52, 58, 66),
		},
		ability = {
			id = "RattleBox",
			name = "Rattle Box",
			desc = "Set down a clockwork noisemaker that pulls Hushed to it.",
			cooldown = 30,
			radius = 36,
			duration = 9,
		},
		loadout = {
			weapons = { long = "shotgun", sidearm = "revolver" },
			items = { shells = 4, pistolAmmo = 6, scrap = 2, tape = 1, saltBomb = 1, bottle = 1 },
		},
		innate = {
			id = "Tinkerer",
			name = "Tinkerer",
			desc = "Crafts twice as fast. Salt Bombs, Tide Spikes and arrows craft +1.",
			mods = { craftTimeMult = 0.5, craftYieldBonus = 1 },
		},
		perks = {
			{ id = "LoudDecoy", name = "Loud Decoy", desc = "Rattle Box is heard 40% further away.", mods = { abilityRadiusMult = 1.4 } },
			{ id = "ThickSkin", name = "Thick Skin", desc = "Take 15% less damage.", mods = { damageTakenMult = 0.85 } },
			{ id = "SpareRounds", name = "Spare Rounds", desc = "Start with 6 extra revolver rounds.", mods = { ammoBonus = 6 } },
		},
	},

	ines = {
		name = "Ines Okafor-Hale",
		role = "Sustain & co-op support",
		bio = "Paramedic. Runs the Meridian's sick bay out of a car deck.",
		height = 0.98,
		colors = {
			skin = Color3.fromRGB(110, 76, 58),
			torso = Color3.fromRGB(122, 40, 38), -- faded medic red
			arms = Color3.fromRGB(122, 40, 38),
			legs = Color3.fromRGB(40, 44, 50),
		},
		ability = {
			id = "SteadyHands",
			name = "Steady Hands",
			desc = "Heal yourself and nearby crew, and breathe quietly for a few seconds.",
			cooldown = 35,
			radius = 15,
			duration = 6,
		},
		loadout = {
			weapons = { long = "rifle", sidearm = "revolver" },
			items = { rifleAmmo = 4, pistolAmmo = 6, dressing = 2, cloth = 1, alcohol = 1 },
		},
		innate = {
			id = "FieldMedic",
			name = "Field Medic",
			desc = "Healing +25%. Crew you revive get up with +30 HP.",
			mods = { healMult = 1.25, reviveHPBonus = 30 },
		},
		perks = {
			{ id = "Marksman", name = "Marksman", desc = "Aimed shots are 40% steadier.", mods = { aimSpreadMult = 0.6 } },
			{ id = "SecondOpinion", name = "Second Opinion", desc = "You bleed out 15 seconds slower.", mods = { bleedOutBonus = 15 } },
			{ id = "Triage", name = "Triage", desc = "Steady Hands recharges 25% faster.", mods = { abilityCooldownMult = 0.75 } },
		},
	},

	sefa = {
		name = "Sefa Talataina",
		role = "Control & escapes",
		bio = "Fisher and net-maker. Has never once lost a catch.",
		height = 1.0,
		colors = {
			skin = Color3.fromRGB(134, 94, 66),
			torso = Color3.fromRGB(150, 118, 52), -- mustard fishing smock
			arms = Color3.fromRGB(150, 118, 52),
			legs = Color3.fromRGB(56, 62, 58),
		},
		ability = {
			id = "ThrowNet",
			name = "Throw Net",
			desc = "Pin the Hushed in front of you for a few seconds. Pinned Hushed can be Quieted from any side.",
			cooldown = 28,
			radius = 25,
			duration = 5,
		},
		loadout = {
			weapons = { long = "carbine", sidearm = "revolver" },
			items = { rifleAmmo = 7, pistolAmmo = 6, bottle = 3, fogPot = 1, dressing = 1 },
		},
		innate = {
			id = "DeepPockets",
			name = "Deep Pockets",
			desc = "Carry one extra of every throwable.",
			mods = { throwCapBonus = 1 },
		},
		perks = {
			{ id = "StrongArm", name = "Strong Arm", desc = "Thrown bottles are heard 30% further away.", mods = { throwNoiseMult = 1.3 } },
			{ id = "HeavyNet", name = "Heavy Net", desc = "Throw Net pins 50% longer.", mods = { abilityDurationMult = 1.5 } },
			{ id = "SeaLegs", name = "Sea Legs", desc = "Sprint 8% faster.", mods = { sprintSpeedMult = 1.08 } },
		},
	},
}

return Characters
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">Commerce</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Developer products. Create each one in Creator Hub > your experience > Monetization >
-- Developer Products, then paste its ID below (docs/06-publishing.md, step 5).
-- An ID of 0 means "not configured": the shop shows the item but will not prompt a purchase.
--
-- `price` is only a fallback label: the shop always shows the live price Roblox reports.
-- Rules (docs/03-monetisation.md): fixed contents, never random; Second Wind max once per
-- crossing; every aid can also be earned free by playing.
return {
	Products = {
		SecondWind = {
			productId = 0,
			name = "Second Wind",
			price = 49,
			desc = "Get back up once when you're downed. Max one per crossing.",
			grant = { secondWind = 1 },
		},
		SecondWind3 = {
			productId = 0,
			name = "Second Wind x3",
			price = 129,
			desc = "Three Second Wind tokens. Same limit: one per crossing.",
			grant = { secondWind = 3 },
		},
		Resupply = {
			productId = 0,
			name = "Resupply Satchel",
			price = 29,
			desc = "+6 revolver rounds, +1 Field Dressing, +1 Bottle. Once per crossing.",
			grant = { resupply = 1 },
		},
	},
	Order = { "SecondWind", "SecondWind3", "Resupply" },
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">Encounters</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The run ("crossing"): RunLength encounters chosen on the tide chart, each followed by a
-- return to the Meridian, then the finale. The Pall rises after every encounter.
return {
	RunLength = 3, -- encounters before the finale
	Types = {
		Salvage = {
			name = "Salvage",
			desc = "Salvage %d supply crates, then reach the Slipway flare.",
			crates = 4,
		},
		LanternWatch = {
			name = "Lantern Watch",
			desc = "Keep the signal lantern lit until the tide turns.",
			waves = 3, waveTime = 40, perWave = 4, lanternHP = 400, dps = 18,
		},
		Drift = {
			name = "Drift",
			desc = "They know you're here. Survive until the tide turns, then reach the flare.",
			duration = 150, huntInterval = 14, spawnInterval = 22, perSpawn = 2,
		},
	},
	Finale = {
		name = "The Breakwater",
		desc = "Keep the lantern lit through the last tide. Something big is coming.",
		type = "LanternWatch", waves = 4, waveTime = 45, perWave = 5, lanternHP = 600, dps = 18,
		boss = "Tidewalker",
	},
	-- Base enemies on the map, plus per-Pall and per-extra-player scaling.
	BaseEnemies = 5,
	PerPall = 1,
	PerExtraPlayer = 2,
	MaxEnemies = 16,
	-- Enemy type unlocks by Pall level (weights).
	TypeWeights = {
		[1] = { Drifter = 4, Rusher = 2 },
		[2] = { Drifter = 4, Rusher = 2, Seeker = 1.5, Bellwether = 1 },
		[3] = { Drifter = 3, Rusher = 2, Seeker = 2, Bellwether = 1, Tidewalker = 0.5 },
		[4] = { Drifter = 3, Rusher = 3, Seeker = 2, Bellwether = 1, Tidewalker = 1 },
	},
	Rewards = {
		salvagePerEncounter = 15, -- +5 per Pall
		scripPerEncounter = 10, -- +5 per encounter index
		scripRunComplete = 50,
	},
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">Enemies</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The Hushed: people taken by the Pall, in stages. Original designs (salt-crusted, faceless,
-- never gory: they burst into salt). Bodies are built in code from jointed parts and
-- animated procedurally on clients (EnemyService builds, EnemyAnimator animates).
--
-- Senses: sightRange 0 = blind. hearingMult scales how far they hear every noise
-- (footsteps, gunshots, thrown bottles, explosions, doors). `rushToNoise` = sprints at sounds.
local Drifter = {
	hp = 100, scale = 1, color = Color3.fromRGB(206, 201, 189),
	patrolSpeed = 5.5, investigateSpeed = 9, chaseSpeed = 16.5,
	sightRange = 70, fovDeg = 110, closeRange = 9, hearingMult = 1,
	suspicionGain = 1.1, suspicionDecay = 0.18,
	noticeThreshold = 0.15, investigateThreshold = 0.35, alertThreshold = 1,
	loseSightTime = 4, searchTime = 10,
	grabRange = 3.6, grabDamage = 34, grabRecover = 2.2,
	staggerTime = 0.3, shoveable = true, quietable = true, headMultScale = 1,
	salvage = 2,
	-- body: proportions + look (see EnemyService.buildModel)
	body = { torso = 1, arms = 1, legs = 1, hunch = 8, head = "round", crust = 5, rags = 3 },
	gait = "shamble",
}

local function variant(overrides)
	local t = table.clone(Drifter)
	for k, v in overrides do
		t[k] = v
	end
	return t
end

return {
	TickRate = 10,
	Types = {
		-- Stage 1: freshly taken. Fast, twitchy, still sees well. Comes in groups.
		Rusher = variant({
			hp = 70, scale = 0.95, color = Color3.fromRGB(176, 160, 146),
			patrolSpeed = 7, investigateSpeed = 15, chaseSpeed = 19, rushToNoise = true,
			sightRange = 80, suspicionGain = 1.6, hearingMult = 1.2,
			grabDamage = 26, grabRecover = 1.8, salvage = 2,
			body = { torso = 0.9, arms = 1, legs = 1.05, hunch = 18, head = "half", crust = 2, rags = 5 },
			gait = "rush",
		}),
		-- Stage 2: the drifting majority. Slow, half-blind in fog.
		Drifter = Drifter,
		-- Stage 3: sealed in salt, completely blind. Hears everything. Deadly up close.
		Seeker = variant({
			hp = 130, scale = 1.05, color = Color3.fromRGB(222, 218, 206),
			patrolSpeed = 4, investigateSpeed = 13, chaseSpeed = 15, rushToNoise = true,
			sightRange = 0, closeRange = 3, hearingMult = 1.9,
			grabRange = 3.4, grabDamage = 65, grabRecover = 2.6,
			shoveable = false, headMultScale = 0.8, salvage = 5,
			body = { torso = 1, arms = 1.2, legs = 1, hunch = 4, head = "shell", crust = 9, rags = 1 },
			gait = "feel",
		}),
		-- Calls the others: a low hum that alerts every Hushed in range.
		Bellwether = variant({
			hp = 120, scale = 1.08, color = Color3.fromRGB(176, 182, 178),
			hum = { radius = 85, cooldown = 8 }, chaseSpeed = 15, salvage = 4,
			body = { torso = 1, arms = 1.1, legs = 1.05, hunch = 2, head = "disc", crust = 6, rags = 2 },
		}),
		-- The last stage: a walking salt reef. Can't be shoved or Quieted.
		Tidewalker = variant({
			hp = 700, scale = 1.45, color = Color3.fromRGB(150, 146, 136),
			patrolSpeed = 4.5, investigateSpeed = 7, chaseSpeed = 12.5,
			sightRange = 55, grabRange = 5, grabDamage = 60, grabRecover = 2.8, hearingMult = 1.3,
			staggerTime = 0.08, shoveable = false, quietable = false, headMultScale = 0.6,
			salvage = 25,
			body = { torso = 1.45, arms = 1.25, legs = 1.1, hunch = 20, head = "sunk", crust = 16, rags = 0 },
			gait = "heavy",
		}),
	},
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">Game</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Global tuning for a Crossing. Everything a designer may want to change lives in Config/.
local Game = {
	MaxPartySize = 4, -- per server; also set "Server size" to this in Creator Hub (docs/06-publishing.md)
	StartCountdown = 6,
	ResultsDuration = 12,
	MaxHP = 100,
	BleedOutTime = 30,
	ReviveTime = 2.5, -- seconds a teammate holds the revive prompt
	ReviveHP = 40,
	ExtractionRadius = 12,

	-- Paid / earnable run aids (Second Wind, Resupply). Set false to make the game cosmetics-only.
	RunAidsEnabled = true,
	SecondWindHP = 60,
	StartingTokens = { secondWind = 1, resupply = 1 }, -- new players
	WinReward = { resupply = 1 }, -- every successful crossing
	DailyWinReward = { secondWind = 1 }, -- first successful crossing each UTC day

	FerryOrigin = Vector3.new(0, 0, 700),
}

return Game
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">Items</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Everything that can live in the satchel. Scarcity is the point: several recipes compete
-- for the same parts, so every craft is a decision. Satchel capacity is NEVER sold;
-- it is upgraded at the workbench with Salvage earned in the run.
return {
	Items = {
		-- crafting parts
		cloth = { name = "Cloth", kind = "part", cap = 3 },
		alcohol = { name = "Alcohol", kind = "part", cap = 3 },
		powder = { name = "Black Salt", kind = "part", cap = 3 },
		scrap = { name = "Scrap", kind = "part", cap = 3 },
		tape = { name = "Tape", kind = "part", cap = 3 },
		canister = { name = "Canister", kind = "part", cap = 3 },
		-- ammunition (reserve; magazines live on the weapon)
		pistolAmmo = { name = "Revolver rounds", kind = "ammo", cap = 18 },
		rifleAmmo = { name = "Rifle rounds", kind = "ammo", cap = 12 },
		shells = { name = "Shells", kind = "ammo", cap = 8 },
		arrows = { name = "Arrows", kind = "ammo", cap = 10 },
		-- consumables, throwables, tools
		dressing = { name = "Field Dressing", kind = "consumable", cap = 2 },
		bottle = { name = "Bottle", kind = "throwable", cap = 3 },
		flarePot = { name = "Flare Pot", kind = "throwable", cap = 2 },
		fogPot = { name = "Fog Pot", kind = "throwable", cap = 2 },
		saltBomb = { name = "Salt Bomb", kind = "throwable", cap = 2 },
		spike = { name = "Tide Spike", kind = "tool", cap = 2 },
	},
	Order = {
		"cloth", "alcohol", "powder", "scrap", "tape", "canister",
		"pistolAmmo", "rifleAmmo", "shells", "arrows",
		"dressing", "bottle", "flarePot", "fogPot", "saltBomb", "spike",
	},
	Parts = { "cloth", "alcohol", "powder", "scrap", "tape", "canister" },
	Throwables = { "bottle", "flarePot", "fogPot", "saltBomb" },

	Recipes = {
		dressing = { name = "Field Dressing", output = "dressing", amount = 1, cost = { cloth = 1, alcohol = 1 }, time = 2 },
		flarePot = { name = "Flare Pot", output = "flarePot", amount = 1, cost = { alcohol = 1, cloth = 1 }, time = 1.5 },
		fogPot = { name = "Fog Pot", output = "fogPot", amount = 1, cost = { powder = 1, canister = 1 }, time = 1.5 },
		saltBomb = { name = "Salt Bomb", output = "saltBomb", amount = 1, cost = { powder = 1, scrap = 1 }, time = 2, perkYield = true },
		spike = { name = "Tide Spike", output = "spike", amount = 1, cost = { scrap = 1, tape = 1 }, time = 1.2, perkYield = true },
		arrows = { name = "Arrows x2", output = "arrows", amount = 2, cost = { scrap = 1 }, time = 1, perkYield = true },
	},
	RecipeOrder = { "dressing", "flarePot", "fogPot", "saltBomb", "spike", "arrows" },

	Dressing = { heal = 60, channel = 2.2 },
	Throw = {
		speed = 75,
		lift = 16,
		bottle = { noise = 45 },
		flarePot = { radius = 7, duration = 7, dps = 32, noise = 30 },
		fogPot = { radius = 10, duration = 10, stun = 2.5, noise = 14 },
		saltBomb = { radius = 9, damage = 150, armTime = 0.8, triggerRadius = 5, noise = 90, lifetime = 90 },
	},
	Quieting = { range = 4.5, time = 0.9, noise = 6, salvage = 3 },
	Shove = { range = 5.5, cooldown = 4, stun = 2.2, noise = 12 },

	-- What one Resupply token gives (fixed, never random).
	Resupply = { pistolAmmo = 6, dressing = 1, bottle = 1 },

	-- Satchel upgrades (workbench) raise these.
	CapBonus = { satchel = 1, ammoPouch = 0.5 },
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">Loot</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Searchable containers and loose items. Loot rolls are free and random (never paid).
-- entry = { item, weight, min, max }; item "salvage" is the run currency.
return {
	Containers = {
		Drawer = { rolls = 1, table = "household", hold = 0.9 },
		Locker = { rolls = 2, table = "household", hold = 1.2 },
		Toolbox = { rolls = 2, table = "workshop", hold = 1.0 },
		AmmoCrate = { rolls = 2, table = "ammo", hold = 1.4 },
	},
	Tables = {
		household = {
			{ "cloth", 30, 1, 1 }, { "alcohol", 26, 1, 1 }, { "tape", 14, 1, 1 }, { "canister", 10, 1, 1 },
			{ "dressing", 4, 1, 1 }, { "bottle", 12, 1, 1 }, { "salvage", 22, 4, 9 }, { "pistolAmmo", 10, 2, 4 },
		},
		workshop = {
			{ "scrap", 30, 1, 1 }, { "tape", 22, 1, 1 }, { "powder", 18, 1, 1 }, { "canister", 14, 1, 1 },
			{ "salvage", 26, 6, 12 }, { "arrows", 8, 2, 3 },
		},
		ammo = {
			{ "pistolAmmo", 30, 3, 6 }, { "rifleAmmo", 18, 2, 3 }, { "shells", 16, 2, 3 }, { "arrows", 14, 2, 4 },
			{ "powder", 10, 1, 1 }, { "salvage", 12, 5, 10 },
		},
		loose = {
			{ "cloth", 18, 1, 1 }, { "alcohol", 16, 1, 1 }, { "scrap", 18, 1, 1 }, { "tape", 10, 1, 1 },
			{ "powder", 8, 1, 1 }, { "canister", 8, 1, 1 }, { "bottle", 14, 1, 1 }, { "pistolAmmo", 10, 2, 3 },
			{ "salvage", 12, 3, 6 },
		},
	},
	LooseItems = 14, -- per encounter
	PallBonusRolls = 0.15, -- extra roll chance per Pall level
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">Modifiers</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Environmental modifiers. One is rolled per encounter (or none) for replayability.
-- Fields: sightMult, noiseMult (all noise), footstepMult, partsMult, fogDensity, ambientBoost, lightning
return {
	None = { id = "None", name = "Still Water", desc = "An ordinary night on the Marrow Coast.", fogDensity = 0.45 },
	List = {
		{ id = "HeavyPall", name = "Heavy Pall", desc = "Thick fog. Everyone sees less.", sightMult = 0.65, fogDensity = 0.62 },
		{ id = "Squall", name = "Squall", desc = "Wind masks your footsteps.", footstepMult = 0.6, sightMult = 0.9, fogDensity = 0.5, lightning = true },
		{ id = "Echoing", name = "Echoing", desc = "Every sound carries further.", noiseMult = 1.5, fogDensity = 0.42 },
		{ id = "Moonbreak", name = "Moonbreak", desc = "The fog thins. You see them. They see you.", sightMult = 1.3, fogDensity = 0.24, ambientBoost = 0.35 },
		{ id = "ScavengedOut", name = "Scavenged Out", desc = "Someone got here first. Half the parts.", partsMult = 0.5, fogDensity = 0.45 },
	},
	NoneChance = 0.2,
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">Movement</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Speeds are studs/second. Noise values are the radius (studs) in which Hushed can hear you.
return {
	Speeds = {
		Crouch = 6.5,
		Walk = 9,
		Jog = 14,
		Sprint = 20,
		Aim = 7,
		Downed = 2.5,
	},
	Noise = {
		Crouch = 3,
		Walk = 9,
		Jog = 16,
		Sprint = 30,
	},
	Accel = 38, -- how fast WalkSpeed ramps up (studs/s^2): gives weight to starts
	Decel = 70,
	WaterNoiseMult = 1.6, -- wading is louder...
	WaterSpeedMult = 0.75, -- ...and slower
	CrouchHipMult = 0.66, -- procedural crouch pose lowers hips to this fraction
}
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">Rigs</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Realistic characters. Three ways to give a crew member a realistic body, best first:
--   1. Custom rig: put an R15-compatible Model named e.g. "Mara" in ServerStorage > Rigs
--      (made in Blender from a MakeHuman/your own mesh, then Studio's Avatar Setup tool).
--      It must contain a Humanoid + HumanoidRootPart. Put a copy of the default "Animate"
--      LocalScript inside it, or set the animation IDs below.
--   2. Body parts: Marketplace body-part asset IDs for a HumanoidDescription (Rthro-style
--      realistic bodies, FACS heads). Set them under BodyParts.
--   3. Neither: the faceless placeholder mannequin (Slice 0 default).
-- See docs/07-characters-and-graphics.md for the free pipeline. Never import models of
-- characters from other games (copyright).
return {
	Custom = {
		mara = "Mara",
		tobias = "Tobias",
		ines = "Ines",
		sefa = "Sefa",
	},
	BodyParts = {
		-- example: mara = { Head = 0, Torso = 0, LeftArm = 0, RightArm = 0, LeftLeg = 0, RightLeg = 0 },
	},
	-- Uploaded animation IDs ("rbxassetid://123"). Used for custom rigs without an Animate script.
	Animations = {
		idle = "",
		walk = "",
		run = "",
		crouchIdle = "",
		crouchWalk = "",
	},
}
]]></ProtectedString></Properties></Item>
