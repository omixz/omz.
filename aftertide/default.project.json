{
  "name": "Aftertide",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },
    "StarterPlayer": {
      "$properties": {
        "EnableMouseLockOption": false,
        "LoadCharacterAppearance": false,
        "CharacterJumpPower": 0
      },
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" }
      }
    },
    "Players": {
      "$properties": { "CharacterAutoLoads": false }
    },
    "Workspace": {
      "$properties": { "StreamingEnabled": false }
    },
    "Lighting": {
      "$properties": { "Technology": "Future" }
    }
  }
}
