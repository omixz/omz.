# Copy to .env and fill in.  (Never commit .env: it holds your passwords and stream key.)
TIKTOK_USERNAME=yourtiktokname
ADMIN_KEY=pick-a-long-password

# What the stream shows: /minecraft (hero vs viewers) or /game (Castle Clash)
GAME_PATH=/minecraft

# ---- Minecraft (real game) ----
# Turns on the Minecraft server. Remove this line if you only want Castle Clash.
COMPOSE_PROFILES=minecraft
# Running a Minecraft server means agreeing to Mojang's EULA: https://aka.ms/MinecraftEULA
# Change to TRUE once you've read and accepted it.
MINECRAFT_EULA=FALSE
MC_HOST=minecraft
RCON_PASSWORD=pick-another-long-password
# MC_BOT_NAME=LiveHero
# MINECRAFT_MEMORY=4G

# ---- Streaming (optional here: you can paste these in the dashboard instead) ----
# From TikTok LIVE Producer (livecenter.tiktok.com/producer): "Server URL" and "Stream key"
# STREAM_URL=rtmp://push-rtmp-xx.tiktokcdn.com/game/
# STREAM_KEY=
# STREAM_BITRATE=2500k
# SIGN_API_KEY=
