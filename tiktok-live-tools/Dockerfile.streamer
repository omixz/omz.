# Hands-free 24/7 image: app server + game in a virtual screen + RTMP stream to TikTok.
# Works on x86 and ARM (e.g. Oracle Cloud "Always Free" Ampere VMs).
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      chromium ffmpeg xvfb pulseaudio curl ca-certificates \
      fonts-noto-core fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY . .
RUN useradd -m app && mkdir -p /app/data && chown -R app /app
USER app
ENV NODE_ENV=production CHROME_BIN=/usr/bin/chromium PORT=3000
EXPOSE 3000
CMD ["bash", "stream.sh"]
