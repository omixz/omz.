# Hands-free 24/7 image: app server + game in a virtual screen + RTMP stream to TikTok,
# plus the Minecraft bridge (hero bot, 3D camera, RCON) when MC_HOST is set.
# Works on x86 and ARM (e.g. Oracle Cloud "Always Free" Ampere VMs).
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      chromium ffmpeg xvfb xdotool pulseaudio curl ca-certificates \
      fonts-noto-core fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY minecraft/package.json minecraft/package-lock.json ./minecraft/
# node-canvas normally downloads a prebuilt binary; build it from source if that's unavailable
RUN cd minecraft && (npm ci --omit=dev || (apt-get update && apt-get install -y --no-install-recommends \
      python3 make g++ libcairo2-dev libpango1.0-dev libjpeg62-turbo-dev libgif-dev librsvg2-dev \
      && npm ci --omit=dev --build-from-source && rm -rf /var/lib/apt/lists/*))
COPY . .
RUN useradd -m app && mkdir -p /app/data && chown -R app /app
USER app
ENV NODE_ENV=production CHROME_BIN=/usr/bin/chromium PORT=3000
EXPOSE 3000 3007
CMD ["bash", "stream.sh"]
